def selected_moves_read_adapter():
    candidates = [
        STATE_DIR / "selected-moves.json",
        STATE_DIR / "autoswitch-selected-moves.json",
        REPO_ROOT / "docs/track7/control-plane/e12-evidence/current-selected-moves-local-state-copy.json",
        REPO_ROOT / "docs/track7/control-plane/e11_18-evidence/current-selected-moves-local-state-copy.json",
    ]
    for path in candidates:
        data = read_json(path, None)
        if not isinstance(data, dict):
            continue
        summary = data.get("summary") or {}
        selected = data.get("selected_moves")
        if selected is None:
            selected = summary.get("selected_moves")
        try:
            count = len(selected) if isinstance(selected, list) else int(selected or 0)
        except (TypeError, ValueError):
            count = 0
        return {
            "status": "PASS" if count == 0 else "FAIL",
            "reason": f"selected_moves={count}",
            "source": str(path),
            "count": count,
            "selected_moves": selected if isinstance(selected, list) else [],
            "freshness": freshness_model(path.stat().st_mtime if path.exists() else None, 3600),
        }
    return {"status": "REVIEW_REQUIRED", "reason": "selected_moves source missing", "source": "missing", "count": 0, "selected_moves": []}


def restore_settle_read_adapter():
    path = STATE_DIR / "autoswitch-restore-barrier.json"
    data = read_json(path, None)
    if not isinstance(data, dict):
        return {"status": "REVIEW_REQUIRED", "reason": "restore barrier source missing", "source": str(path), "detail": {}}
    active = bool(data.get("active", False))
    expired = bool(data.get("expired", False))
    cleared = bool(data.get("cleared", False))
    if active and not expired:
        status = "REVIEW_REQUIRED"
        reason = "restore barrier active"
    elif expired and not cleared:
        status = "FAIL"
        reason = "restore barrier expired and uncleared"
    else:
        status = "PASS"
        reason = "restore barrier is settled"
    return {"status": status, "reason": reason, "source": str(path), "detail": redact(data)}


def hidden_movers_read_adapter(selected=None):
    selected = selected or selected_moves_read_adapter()
    switch_path = EVENT_DIR / "switch-history.jsonl"
    rows = read_jsonl_records(switch_path, limit=80)
    recent_cutoff = time.time() - 300
    recent = []
    for row in rows:
        ts = ts_epoch(row.get("ts") or row.get("time") or row.get("created_at"))
        if ts and ts >= recent_cutoff:
            recent.append(row)
    if selected.get("count", 0) > 0:
        return {"status": "FAIL", "reason": "selected moves are present", "source": selected.get("source", ""), "recent_switch_events": len(recent)}
    if recent:
        return {"status": "REVIEW_REQUIRED", "reason": f"recent switch-history events={len(recent)}", "source": str(switch_path), "recent_switch_events": len(recent)}
    if switch_path.exists():
        return {"status": "PASS", "reason": "no selected moves and no recent switch-history events", "source": str(switch_path), "recent_switch_events": 0}
    return {"status": "REVIEW_REQUIRED", "reason": "switch-history source missing", "source": str(switch_path), "recent_switch_events": 0}


