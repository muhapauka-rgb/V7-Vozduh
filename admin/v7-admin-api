      const readiness = (overview.egress_runtime_readiness || {})[id] || {};
      const notStarted = String(readiness.reason || '').includes('interface is not currently up');
      if (disabled) return {group:'disabled', tone:'muted', issue: role.includes('reserve') ? 'резерв' : 'выключен'};
      if ((notStarted && egressUserCount(id) > 0) || (matrix.total && matrix.okCount === 0) || /FULL|HARD|OVER/i.test(String(load || ''))) {
        return {group:'problem', tone:'bad', issue: notStarted ? 'не запущен' : (matrix.total && matrix.okCount === 0 ? 'сервисы не проходят' : 'лимит ёмкости')};
      }
      if (lifecycle.tone !== 'ok' || (matrix.total && matrix.okCount < matrix.total) || /WARN|SOFT|LIMIT/i.test(String(load || ''))) {
        return {group:'check', tone:'info', issue: lifecycle.tone !== 'ok' ? lifecycle.text : (matrix.total && matrix.okCount < matrix.total ? 'часть сервисов' : loadLabel)};
