      }
      if (source.external_ip && !source.external_ip.ok) {
        return 'Проверьте Endpoint, ключи, AllowedIPs и доступность сервера VPN. Если этот же конфиг работает на телефоне, чаще всего отличается DNS/маршрутизация или сервер не отвечает с VPS.';
      }
      if (source.service_matrix && source.service_matrix.status !== 'PASS') {
        return 'Канал поднялся, но нужные сайты через него не открылись. Проверьте, подходит ли этот VPN для выбранной роли канала, или выберите другую роль/другой сервер.';
      }
      if (source.blockers && source.blockers.length) {
        return `Закройте блокеры: ${source.blockers.map(operatorText).join(', ')}. После этого нажмите “Добавить канал” ещё раз.`;
      }
      if (stepId === 'pool') return 'Проверьте, не конфликтует ли имя канала с существующим пулом. Автомастер не переносит пользователей и не перезаписывает существующие каналы.';
      return 'Исправьте указанную причину и снова нажмите “Добавить канал”. Мастер продолжит безопасную цепочку заново.';
    }
