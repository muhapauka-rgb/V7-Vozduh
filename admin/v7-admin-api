            "branch": branch or "unknown",
            "head": head or "unknown",
            "working_tree_changes": dirty_count,
            "certification_state": certification_state,
            "rollback_available": rollback_available,
            "release_matches_runtime": runtime_ok and status == "RELEASE_OK",
            "reports_found": len(reports),
        },
        "lineage": {
            "reports": reports[:12],
            "runtime_trust": {
                "runtime_status": runtime.get("runtime_status"),
                "operator_status_text": runtime.get("operator_status_text"),
            },
        },
        "rollback_lineage": {
            "available": rollback_available,
            "method": "git_head_or_backup_preview",
            "backups_count": len(backups_rows),
            "latest_backups": [
                {"name": row.get("name") or row.get("path") or "", "created": row.get("created") or row.get("mtime") or ""}
