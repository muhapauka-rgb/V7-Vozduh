def connect_idempotency_key(data, phone, handler=None):
    raw = clean_identity_text(data.get("idempotency_key") or data.get("idempotency") or "", 160)
    if raw and re.match(r"^[A-Za-z0-9_.:-]{8,160}$", raw):
        return raw
    bucket = int(time.time() // 600)
    parts = [
        normalize_phone(phone),
        clean_identity_text(data.get("organization", ""), 160).lower(),
        safe_connect_client(data.get("vpn_client", "karing")),
        clean_identity_text(data.get("device_type", "phone"), 60).lower(),
        safe_smart_mode(data.get("mode", "RU_LOCAL")) or "RU_LOCAL",
        identity_request_ip(handler),
        str(bucket),
    ]
    return "connect_" + hashlib.sha256("|".join(parts).encode("utf-8")).hexdigest()[:32]


