CLOSURE_STATES = {"OPEN", "VERIFIED", "CLOSED", "EXPIRED"}
FRESHNESS_STATES = {"FRESH", "STALE", "EXPIRED", "UNKNOWN"}


def query_value(params, *names, default=""):
