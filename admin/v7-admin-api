def egress_organization_scope_from_data(data=None):
    data = data or {}
    raw = data.get("organization_scope", data.get("organizations", ["global"]))
    if isinstance(raw, str):
        raw_items = raw.split(",")
    elif isinstance(raw, (list, tuple, set)):
        raw_items = raw
    else:
        raw_items = ["global"]
    items = []
    for item in raw_items:
        value = re.sub(r"[^A-Za-z0-9_.:@ -]+", "", str(item or "").strip())[:80]
        if value and value not in items:
            items.append(value)
    return items or ["global"]


