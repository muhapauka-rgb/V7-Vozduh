def safe_csv_tokens(value, allowed=None, max_items=20, uppercase=False):
    if isinstance(value, list):
        raw = value
    else:
        raw = re.split(r"[\s,]+", str(value or ""))
    allowed_set = {str(item).upper() if uppercase else str(item).lower() for item in allowed} if allowed else None
    cleaned = []
    for item in raw:
        token = str(item or "").strip()
        token = token.upper() if uppercase else token.lower()
        if not token or not re.match(r"^[A-Za-z0-9_.:-]{1,64}$", token):
            continue
        if allowed_set is not None and token not in allowed_set:
            continue
        if token not in cleaned:
            cleaned.append(token)
        if len(cleaned) >= max_items:
            break
    return cleaned


def bounded_int_value(value, default, low, high):
    try:
        number = int(str(value).strip())
    except (TypeError, ValueError):
        number = default
    return max(low, min(high, number))


def bool_flag_value(value, default="0"):
