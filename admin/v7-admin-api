def proposal_matches_object(proposal, object_type, object_id):
    object_type = safe_evidence_token(object_type, "").lower()
    object_id = safe_evidence_token(object_id, "")
    if not object_type or not object_id:
        return False
    if object_type == "proposal" and proposal.get("proposal_id") == object_id:
        return True
    if object_type == "user" and object_id in (proposal.get("affected_users") or []):
        return True
    if object_type == "channel" and object_id in (proposal.get("current_target"), proposal.get("proposed_target")):
        return True
    for link in proposal.get("object_links") or []:
        if isinstance(link, dict) and str(link.get("object_type", "")).lower() == object_type and str(link.get("object_id", "")) == object_id:
            return True
    evidence_id = proposal.get("evidence_bundle_id", "")
    bundle = evidence_bundle_by_id(evidence_id) if evidence_id else None
    return evidence_matches_object(bundle or {}, object_type, object_id) if bundle else False


