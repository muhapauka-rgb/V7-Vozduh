def identity_device_revoke_apply(device_id, actor, confirm):
    if confirm != "REVOKE_DEVICE":
        return None, {"error": "device_revoke_requires_confirm_REVOKE_DEVICE"}
    preview, error = identity_device_revoke_preview(device_id, actor)
    if error:
        return None, error
    device = preview["device"]
    ip = safe_user_ip(device.get("assigned_vpn_ip", ""))
    result = run_action(["v7-user-disable", ip], actor, timeout=35)
    if result["rc"] != 0:
        return {"device": device, "result": result}, {"error": "runtime_device_revoke_failed"}
    now = now_iso()
    with identity_conn() as conn:
        conn.execute(
            "UPDATE devices SET status='revoked', revoked_at=?, updated_at=? WHERE id=?",
            (now, now, device["id"]),
        )
        conn.execute(
            "UPDATE identity_users SET updated_at=? WHERE id=?",
            (now, device["user_id"]),
        )
        conn.commit()
        updated = dict(conn.execute("SELECT * FROM devices WHERE id=?", (device["id"],)).fetchone())
    revoked_deliveries = revoke_profile_deliveries_for_ip(ip, actor)
    audit_admin(actor, "admin_action_identity_device_revoke", f"device_id={device['id']} ip={ip} revoked_deliveries={len(revoked_deliveries)}", object_type="identity_device", object_id=device["id"], result="OK")
    return {"device": updated, "result": result, "revoked_deliveries": revoked_deliveries}, None


def connect_onboard(data, handler=None):
    if admin_safe_mode_enabled():
        return None, {"error": "safe_mode_enabled", "message": "Подключение временно отключено администратором."}, 423
    identity_init_db()
    entered_name = clean_identity_text(data.get("name", ""), 160)
    phone = normalize_phone(data.get("phone", ""))
    org_input = clean_identity_text(data.get("organization", ""), 160)
    password = str(data.get("password", ""))
    vpn_client = safe_connect_client(data.get("vpn_client", "karing"))
    device_type = clean_identity_text(data.get("device_type", "phone"), 60) or "phone"
    mode = safe_smart_mode(data.get("mode", "RU_LOCAL")) or "RU_LOCAL"
    client_meta = CONNECT_CLIENTS.get(vpn_client, CONNECT_CLIENTS["karing"])
    adapter = safe_smart_adapter(client_meta.get("adapter") or "karing")
    if not entered_name or not phone or not org_input or not password:
        identity_log_attempt(phone, entered_name, org_input, "FAIL", "missing_required_fields", handler)
        return None, {"error": "missing_required_fields", "message": "Заполните имя, телефон, организацию и пароль."}, 400
    if identity_rate_limited(phone, handler=handler):
        identity_log_attempt(phone, entered_name, org_input, "FAIL", "rate_limited", handler)
        return None, {"error": "rate_limited", "message": "Слишком много неудачных попыток. Попробуйте позже или обратитесь к администратору."}, 429
    if not connect_client_supported(vpn_client):
        identity_log_attempt(phone, entered_name, org_input, "FAIL", "unsupported_vpn_client", handler)
        client = CONNECT_CLIENTS.get(vpn_client, CONNECT_CLIENTS["karing"])
        return None, {
            "error": "unsupported_vpn_client",
            "message": "Это приложение ещё не подключено к автоматической выдаче.",
            "client": client.get("label", vpn_client),
            "hint": "Сейчас автоматическая выдача работает для Karing и Hiddify. Для остальных клиентов профиль выдаёт оператор или нужен отдельный адаптер.",
        }, 400
    if not identity_verify_connection_password(password):
        identity_log_attempt(phone, entered_name, org_input, "FAIL", "password_invalid", handler)
        return None, {"error": "password_invalid", "message": "Неверный пароль подключения."}, 403
    organization = identity_find_organization(org_input)
    if not organization:
        identity_log_attempt(phone, entered_name, org_input, "FAIL", "organization_not_found", handler)
        return None, {"error": "organization_not_found", "message": "Организация не найдена. Выберите организацию из списка администратора."}, 404
    allowed = identity_find_allowed_phone(phone)
    allowed_for_user = allowed if isinstance(allowed, dict) else {}
    if not allowed:
        identity_log_attempt(phone, entered_name, org_input, "OK", "phone_not_in_whitelist_confirmation_required", handler)
        allowed_for_user = {}
    elif not int(allowed.get("is_active") or 0):
        identity_log_attempt(phone, entered_name, org_input, "FAIL", "phone_not_active", handler)
        return None, {"error": "phone_not_active", "message": "Телефон сейчас не активен в списке разрешённых. Обратитесь к администратору."}, 403
    elif allowed.get("organization_id") and allowed.get("organization_id") != organization.get("id"):
        identity_log_attempt(phone, entered_name, org_input, "OK", "phone_whitelist_organization_mismatch_confirmation_required", handler)
        allowed_for_user = {}
    session, job_id, session_state = identity_begin_connect_session(data, phone, entered_name, org_input, handler)
    if session_state.get("in_progress"):
        return {
            "session_id": session.get("id"),
            "status": "running",
            "message": "Профиль уже создаётся. Подождите несколько секунд и обновите страницу.",
        }, None, 202
    if session_state.get("duplicate"):
        try:
            cached = json.loads(session.get("result_json") or "{}")
        except json.JSONDecodeError:
            cached = {}
        if session.get("status") == "completed" and cached:
            cached["session_id"] = session.get("id")
            cached["idempotent_replay"] = True
            return cached, None, 200
        return None, {"error": session.get("reason") or "connect_session_duplicate_failed", "message": "Эта попытка уже завершилась ошибкой. Повторите подключение через несколько минут."}, 409
    session_id = session.get("id", "")
    def fail(status_code, reason, error_payload):
        identity_finish_connect_session(session_id, job_id, "failed", reason, result={"error": error_payload}, error=reason)
        return None, error_payload, status_code
    mode, mode_context = identity_effective_smart_mode(mode, allowed_for_user, organization)
    user, error = identity_get_or_create_user(
        phone,
        entered_name,
        allowed_for_user,
        organization,
        require_phone_verification=True,
        onboarding_source="/connect",
        connect_session_id=session_id,
    )
    if error:
        identity_log_attempt(phone, entered_name, org_input, "FAIL", error.get("error", "user_error"), handler)
        return fail(400, error.get("error", "user_error"), error)
    if user.get("status") in ("blocked", "disabled") or user.get("phone_verification_status") == "rejected":
        identity_log_attempt(phone, entered_name, org_input, "FAIL", f"user_{user.get('status')}", handler)
        return fail(403, "user_blocked", {"error": "user_blocked", "message": "Пользователь заблокирован или отключен."})
    active_devices = identity_active_device_count(user["id"])
    max_devices = int(user.get("max_devices") or 3)
    if active_devices >= max_devices:
        identity_log_attempt(phone, entered_name, org_input, "FAIL", "device_limit_reached", handler)
        return fail(409, "device_limit_reached", {"error": "device_limit_reached", "message": "Для этого пользователя достигнут лимит устройств.", "active_devices": active_devices, "max_devices": max_devices})
    client_name = onboarding_client_name(user, device_type)
    egress = default_egress_id()
    dry = run_action(["v7-user-create", client_name, "--egress", egress, "--dry-run"], "connect", timeout=20)
    if dry["rc"] != 0:
        identity_log_attempt(phone, entered_name, org_input, "FAIL", "provisioning_preflight_failed", handler)
        return fail(500, "provisioning_preflight_failed", {"error": "provisioning_preflight_failed", "detail": dry})
    created = run_action(["v7-user-create", client_name, "--egress", egress], "connect", timeout=45)
    parsed = parse_command_kv(created.get("output", ""))
    if created["rc"] != 0 or not safe_user_ip(parsed.get("ip", "")):
        identity_log_attempt(phone, entered_name, org_input, "FAIL", "device_create_failed", handler)
        return fail(500, "device_create_failed", {"error": "device_create_failed", "detail": created})
    conf = wg_conf_for_user_ip(parsed["ip"])
    output = smart_client_profile_path(client_name, adapter, mode)
    proxy_identity = {"rc": 0, "output": "not_required"}
    if adapter == "happ":
        proxy_identity = run_action([
            "v7-proxy-identity-bind",
            "--inbound-id", "happ-test",
            "--user-ip", parsed["ip"],
            "--client", "happ",
            "--label", client_name,
            "--apply",
            "--confirm", "CREATE_PROXY_IDENTITY_BINDING",
        ], "connect", timeout=25)
        if proxy_identity["rc"] != 0:
            identity_log_attempt(phone, entered_name, org_input, "FAIL", "proxy_identity_bind_failed", handler)
            return fail(500, "proxy_identity_bind_failed", {"error": "proxy_identity_bind_failed", "detail": proxy_identity})
    if adapter_uses_karing_vless(adapter):
        proxy_identity, generated = generate_karing_vless_profile(parsed["ip"], client_name, mode, output, "connect")
        if proxy_identity.get("rc") != 0:
            identity_log_attempt(phone, entered_name, org_input, "FAIL", "proxy_identity_bind_failed", handler)
            return fail(500, "proxy_identity_bind_failed", {"error": "proxy_identity_bind_failed", "detail": proxy_identity})
    elif adapter_uses_karing_wg(adapter):
        generated = generate_karing_wg_endpoint_profile(parsed["ip"], client_name, mode, output, conf, "connect")
    else:
        generated = run_action([
            "v7-smart-client-profile-generate",
            "--adapter", adapter,
            "--mode", mode,
            "--wg-conf", str(conf),
            "--name", client_name,
            "--output", str(output),
