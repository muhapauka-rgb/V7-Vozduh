    return redact({
        "updated": now_iso(),
        "filters": {"actor": actor, "action": action, "result": result, "severity": severity, "object_type": object_type, "limit": limit},
        "summary": summary,
        "events": rows,
    })


def security_audit_csv(data):
    def cell(value):
        text = str(value if value is not None else "")
