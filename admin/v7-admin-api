        f"    private-key: {yaml_single_quote(parsed.get('private_key', ''))}",
        f"    public-key: {yaml_single_quote(parsed.get('peer_public_key', ''))}",
        "    allowed-ips:",
        "      - 0.0.0.0/0",
        "    udp: true",
        "    mtu: 1368",
        f"    persistent-keepalive: {keepalive}",
        "    remote-dns-resolve: true",
        "    dns:",
        "      - 1.1.1.1",
        "      - 8.8.8.8",
    ]
    if ipv6:
        lines.append(f"    ipv6: {yaml_single_quote(ipv6)}")
    if parsed.get("preshared_key"):
