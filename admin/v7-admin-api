def egress_draft_helper_result_from_files(draft_id, requested_mode, since=0):
    draft_id = safe_draft_id(draft_id or "")
    requested_mode = str(requested_mode or "runtime")
    if not draft_id:
        return {}, {}
    draft_dir = egress_draft_path(draft_id)
    metadata = read_json(draft_dir / "metadata.json", {}) if draft_dir else {}
    run_id_keys = ["last_runtime_run_id"]
    if requested_mode == "quarantine":
        run_id_keys.insert(0, "last_quarantine_run_id")
    for key in run_id_keys:
        run_id = safe_run_id(metadata.get(key, ""))
        result_path = EGRESS_DRAFT_TESTS_DIR / run_id / "result.json" if run_id else None
        if since and (not result_path or not result_path.exists() or result_path.stat().st_mtime < since - 2):
            continue
        result = read_json(result_path, {}) if result_path else {}
        if isinstance(result, dict) and result.get("draft_id") == draft_id:
            return result, metadata
    candidates = []
    patterns = [f"{draft_id}-runtime-*/result.json", f"{draft_id}-{requested_mode}-*/result.json"]
    for pattern in patterns:
        try:
            candidates.extend(EGRESS_DRAFT_TESTS_DIR.glob(pattern))
        except OSError:
            continue
    for result_path in sorted(set(candidates), key=lambda p: p.stat().st_mtime if p.exists() else 0, reverse=True):
        result = read_json(result_path, {})
        if not isinstance(result, dict) or result.get("draft_id") != draft_id:
            continue
        if since and result_path.stat().st_mtime < since - 2:
            continue
        if requested_mode == "quarantine" and result.get("requested_mode") != "quarantine":
            continue
        return result, metadata
    return {}, metadata


def egress_draft_pool_evidence_state():
    evidence = {}
    if not EGRESS_DRAFTS_DIR.exists():
        return {"items": {}}
    for meta in sorted(EGRESS_DRAFTS_DIR.glob("*/metadata.json"), key=lambda p: p.stat().st_mtime, reverse=True):
        row = read_json(meta, {})
        draft_id = safe_draft_id(row.get("id", ""))
        egress_id = safe_egress_id(row.get("pool_egress_id", ""))
        if not draft_id or not egress_id:
            continue
        quarantine = egress_draft_result_by_run_id(row.get("last_quarantine_run_id", ""))
        matrix = quarantine.get("service_matrix") if isinstance(quarantine, dict) else {}
        if isinstance(matrix, dict) and matrix.get("services"):
            matrix = dict(matrix)
            matrix.setdefault("route_class_fitness", service_matrix_route_fitness(matrix))
            matrix.setdefault("source", "egress_draft_quarantine")
            matrix.setdefault("draft_id", draft_id)
            matrix.setdefault("egress", egress_id)
        else:
            matrix = {}
        ready = (
            row.get("pool_action") == "enabled"
            and row.get("last_preflight_status") == "PASS"
            and row.get("last_runtime_status") == "PASS"
            and row.get("last_quarantine_status") == "PASS"
            and row.get("runtime_profile_status") == "READY"
        )
        interface_live = True
        registry = egress_registry_map().get(egress_id, {})
        if registry.get("type") == "interface":
            interface_live = egress_interface_live(registry.get("interface", ""))
            ready = ready and interface_live
        item = {
            "draft_id": draft_id,
            "egress": egress_id,
            "label": row.get("label", draft_id),
            "protocol": row.get("protocol", ""),
            "role": row.get("role") or (row.get("usage_policy") or {}).get("role", ""),
            "ready": ready,
            "status": "OK" if ready else "CHECK",
            "reason": "" if ready else ("рабочий интерфейс не поднят" if not interface_live else "pipeline не завершён"),
            "source": "egress_draft_master",
            "pool_action": row.get("pool_action", ""),
            "last_preflight_status": row.get("last_preflight_status", ""),
            "last_runtime_status": row.get("last_runtime_status", ""),
            "last_quarantine_status": row.get("last_quarantine_status", ""),
            "runtime_profile_status": row.get("runtime_profile_status", ""),
            "last_service_matrix_status": row.get("last_service_matrix_status", ""),
            "last_runtime_at": row.get("last_runtime_at", ""),
            "last_quarantine_at": row.get("last_quarantine_at", ""),
            "pool_enabled_at": row.get("pool_enabled_at", ""),
            "service_matrix": matrix,
        }
        current = evidence.get(egress_id)
        if not current or (item["ready"] and not current.get("ready")):
            evidence[egress_id] = item
    return redact({"items": evidence})


def service_matrix_with_draft_evidence(matrix, draft_evidence):
    merged = json.loads(json.dumps(matrix if isinstance(matrix, dict) else {"items": {}}))
    merged.setdefault("items", {})
    for egress_id, evidence in ((draft_evidence or {}).get("items") or {}).items():
        if not evidence.get("ready"):
            continue
        draft_matrix = evidence.get("service_matrix") or {}
        if not isinstance(draft_matrix, dict):
            continue
        total = int(draft_matrix.get("total") or draft_matrix.get("count") or len(draft_matrix.get("services") or {}) or 0)
        if total <= 0:
            continue
        existing = merged["items"].get(egress_id) or {}
        existing_total = int(existing.get("total") or existing.get("count") or len(existing.get("services") or {}) or 0)
        existing_status = str(existing.get("status") or existing.get("result") or "").upper()
        if existing_total > 0 and existing_status in {"PASS", "OK"}:
            continue
        seeded = normalize_service_matrix_row(dict(draft_matrix))
        seeded.setdefault("status", evidence.get("last_service_matrix_status") or "PASS")
        seeded.setdefault("source", "egress_draft_quarantine")
        seeded.setdefault("draft_id", evidence.get("draft_id", ""))
        seeded.setdefault("updated_at", evidence.get("last_quarantine_at", ""))
        merged["items"][egress_id] = seeded
    return merged


def egress_draft_delete(draft_id, actor):
    draft_id = safe_draft_id(draft_id)
    draft_dir = egress_draft_path(draft_id)
    if not draft_dir:
        return None, {"error": "invalid_draft_id"}
    metadata_path = draft_dir / "metadata.json"
    metadata = read_json(metadata_path, {})
    if not metadata or not metadata_path.exists():
        return None, {"error": "draft_not_found"}
    if metadata.get("pool_action") in {"added_disabled", "enabled"} or metadata.get("pool_egress_id"):
        return None, {
            "error": "draft_delete_blocked_after_pool_add",
            "pool_action": metadata.get("pool_action", ""),
            "pool_egress_id": metadata.get("pool_egress_id", ""),
            "message": "Remove or disable the pool channel first; draft metadata is tied to an active registry entry.",
        }
    deleted_root = EGRESS_DRAFTS_DIR / ".deleted"
    deleted_root.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(deleted_root, 0o700)
    except OSError:
        pass
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    target = deleted_root / f"{draft_id}.{stamp}"
    if target.exists():
        target = deleted_root / f"{draft_id}.{stamp}.{secrets.token_hex(3)}"
    metadata.update({
        "status": "deleted",
        "deleted_at": now_iso(),
        "deleted_by": actor or "admin",
        "deleted_archive_path": str(target),
    })
    write_json_atomic(metadata_path, metadata)
    shutil.move(str(draft_dir), str(target))
    return {
        "draft_id": draft_id,
        "status": "DELETED",
        "archive_path": str(target),
        "pool_action": "not_added",
        "users_moved": False,
        "routes_changed": False,
        "services_restarted": False,
        "next_step": "draft_removed_from_visible_list",
    }, None


