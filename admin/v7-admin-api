    if not isinstance(state, dict):
        state = {"updated": now_iso(), "users": {}}
    state["updated"] = now_iso()
    user = state.setdefault("users", {}).setdefault(ip, {"latest": {}, "history": []})
    user.setdefault("latest", {})["v7"] = sample
    history = user.setdefault("history", [])
    history.append(sample)
    user["history"] = history[-80:]
    write_json_atomic(CLIENT_SPEED_FILE, state)

    path_payload = {
        "user_ip": ip,
        "ingress_type": sample["ingress_type"],
        "egress_id": current,
        "mbps": sample["mbps"],
        "bytes": bytes_count,
        "duration_ms": duration_ms,
        "target_url": sample["target_url"],
        "client_transport": str(row.get("client_transport", ""))[:80],
        "path_profile": str(row.get("path_profile", "public-speed-link"))[:80],
        "command_id": sample["command_id"],
        "source": "v7-admin-public-speed",
    }
    path_sample = ingest_client_path_sample(path_payload)
    return {"saved": sample, "path_sample": path_sample}, None


