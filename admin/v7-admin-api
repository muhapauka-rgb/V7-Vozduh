def parse_wg_client_conf(path_obj):
    text = read_text(path_obj, "")
    sections = {}
    current = ""
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or line.startswith(";"):
            continue
        if line.startswith("[") and line.endswith("]"):
            current = line.strip("[]").strip().lower()
            sections.setdefault(current, {})
            continue
        if "=" not in line or not current:
            continue
        key, value = line.split("=", 1)
        sections.setdefault(current, {})[key.strip().lower()] = value.strip()
    interface = sections.get("interface") or {}
    peer = sections.get("peer") or {}
    endpoint = peer.get("endpoint", "")
    host, port = "", ""
    if endpoint.startswith("[") and "]:" in endpoint:
        host, port = endpoint[1:].split("]:", 1)
    elif ":" in endpoint:
        host, port = endpoint.rsplit(":", 1)
    try:
        port_int = int(port)
    except (TypeError, ValueError):
        port_int = 0
    return {
        "private_key": interface.get("privatekey", ""),
        "address": interface.get("address", ""),
        "dns": interface.get("dns", ""),
        "peer_public_key": peer.get("publickey", ""),
        "preshared_key": peer.get("presharedkey", ""),
        "endpoint_host": host,
        "endpoint_port": port_int,
        "allowed_ips": [item.strip() for item in peer.get("allowedips", "").split(",") if item.strip()],
        "persistent_keepalive": peer.get("persistentkeepalive", "25"),
    }


