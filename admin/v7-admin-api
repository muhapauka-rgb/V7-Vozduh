            "v7-smart-client-profile-generate",
            "--adapter", adapter,
            "--mode", mode,
            "--user-ip", ip,
            "--name", artifact_name,
            "--output", str(output),
        ]
        if conf:
            cmd.extend(["--wg-conf", str(conf)])
        generated = run_action(cmd, actor, timeout=35)
    if generated["rc"] != 0:
        check = {"rc": 0, "output": "пропущено"}
    elif adapter == "happ":
        check = {"rc": 0, "output": "подписка VLESS создана"}
    elif adapter_uses_karing_wg(adapter):
        check = {"rc": 0, "output": "Karing WG Clash YAML profile generated"}
    else:
        check = run_action(["sing-box", "check", "-c", str(output)], actor, timeout=20)
    check = normalize_smart_profile_check(check, adapter)
    if generated["rc"] != 0 or check["rc"] != 0:
        audit_admin(actor, "admin_action_identity_device_issue", f"user_id={user['id']} ip={ip} client={vpn_client} profile=fail", object_type="identity_user", object_id=user["id"], result="FAIL")
        return {"planned": planned, "preflight": preflight, "created": created, "parsed": parsed, "generated": generated, "check": check}, {"error": "smart_profile_failed"}, 500
    delivery, delivery_error = create_profile_delivery(ip, adapter, mode, actor)
