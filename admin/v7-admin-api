def egress_openvpn_parse_inline_blocks(text):
    blocks = {}
    in_block = ""
    block_lines = []
    for raw in str(text or "").splitlines():
        line = raw.strip()
        if in_block:
            if line.lower() == f"</{in_block}>":
                blocks.setdefault(in_block, []).append("\n".join(block_lines).strip("\n"))
                in_block = ""
                block_lines = []
            else:
                block_lines.append(raw)
            continue
        if line.startswith("<") and line.endswith(">") and not line.startswith("</"):
            in_block = line[1:-1].strip().lower()
            block_lines = []
    return blocks


def egress_openvpn_auth_block(text):
    blocks = egress_openvpn_parse_inline_blocks(text)
    values = blocks.get("auth-user-pass") or []
    if not values:
        return ""
    lines = [line.strip() for line in values[0].splitlines() if line.strip()]
    return "\n".join(lines[:2]) + "\n" if len(lines) >= 2 else ""


def egress_openvpn_config_fingerprint(text):
    fields = _egress_preview_openvpn_fields(text or "")
    blocks = egress_openvpn_parse_inline_blocks(text or "")

    def block_hash(name):
        body = "\n".join(blocks.get(name, []))
        return hashlib.sha256(body.encode("utf-8")).hexdigest() if body else ""

    return {
        "remote": str(fields.get("remote") or "").lower(),
        "proto": str(fields.get("proto") or "udp").lower(),
        "ca": block_hash("ca"),
        "cert": block_hash("cert"),
        "key": block_hash("key"),
        "tls_auth": block_hash("tls-auth") or block_hash("tls-crypt") or block_hash("tls-crypt-v2"),
        "auth_user_pass": hashlib.sha256(egress_openvpn_auth_block(text).encode("utf-8")).hexdigest() if egress_openvpn_auth_block(text) else "",
    }


def egress_draft_duplicate_openvpn_egress(text, proposed_id=""):
    fingerprint = egress_openvpn_config_fingerprint(text)
    if not fingerprint.get("remote"):
        return {}
    proposed_id = safe_egress_id(proposed_id or "")
    for row in egress_registry_rows(enabled_only=False):
        egress_id = safe_egress_id(row.get("id", ""))
        if not egress_id or egress_id == proposed_id:
            continue
        if str(row.get("type", "")) != "interface" or str(row.get("protocol", "")) != "openvpn":
            continue
        for path in egress_runtime_profile_candidates(egress_id, row):
            if not path.exists():
                continue
            other = egress_openvpn_config_fingerprint(read_text(path, ""))
            keys = ["remote", "proto"]
            if fingerprint.get("cert") or other.get("cert"):
                keys.append("cert")
            if fingerprint.get("key") or other.get("key"):
                keys.append("key")
            if all(other.get(key) == fingerprint.get(key) for key in keys):
                return {
                    "egress": egress_id,
                    "interface": row.get("interface", ""),
                    "config": str(path),
                    "enabled": row.get("enabled", ""),
                }
    return {}


def egress_openvpn_normalize_runtime_config(text, ifname, auth_path=None, redact_output=False):
    fields = _egress_preview_openvpn_fields(text)
    ifname = str(ifname or "").strip()
    if not re.match(r"^[A-Za-z0-9_.-]{1,15}$", ifname):
        return None, None, {"error": "invalid_openvpn_interface", "interface": ifname}

    blocks = egress_openvpn_parse_inline_blocks(text)
    auth_inline = egress_openvpn_auth_block(text)
    errors = []
    normalized = [
        "client",
        f"dev {ifname}",
        "dev-type tun",
        "route-nopull",
        "script-security 0",
        'pull-filter ignore "redirect-gateway"',
        'pull-filter ignore "route "',
        'pull-filter ignore "dhcp-option DNS"',
    ]
    blocked = []
    review = []
    in_block = ""
    block_lines = []
    copied_blocks = set()
    auth_file_content = ""

    if not fields.get("remote"):
        errors.append("remote is missing")
    if not fields.get("dev"):
        errors.append("dev is missing")
    elif str(fields.get("dev", "")).lower().startswith("tap"):
        errors.append("OpenVPN TAP/bridge profiles are not supported as V7 egress; use a TUN client profile")
    if not (fields.get("auth_user_pass") or (fields.get("cert") and fields.get("key"))):
        errors.append("auth material is missing")

    def append_block(name, body):
        copied_blocks.add(name)
        if redact_output and name in OPENVPN_SECRET_BLOCKS:
            normalized.append(f"<{name}>")
            normalized.append("[REDACTED]")
            normalized.append(f"</{name}>")
            return
        normalized.append(f"<{name}>")
        normalized.extend(str(body or "").splitlines())
        normalized.append(f"</{name}>")

    for raw in str(text or "").splitlines():
        line = raw.strip()
        if in_block:
            if line.lower() == f"</{in_block}>":
                body = "\n".join(block_lines).strip("\n")
                if in_block == "auth-user-pass":
                    auth_file_content = egress_openvpn_auth_block(f"<auth-user-pass>\n{body}\n</auth-user-pass>")
                    if auth_file_content and auth_path:
                        normalized.append(f"auth-user-pass {auth_path}")
                    elif auth_file_content:
                        normalized.append("auth-user-pass [V7_AUTH_FILE]")
                    else:
                        errors.append("auth-user-pass inline block must contain username and password")
                    copied_blocks.add(in_block)
                elif in_block in {"ca", "cert", "key", "tls-auth", "tls-crypt", "tls-crypt-v2"}:
                    append_block(in_block, body)
                else:
                    review.append({"directive": f"<{in_block}>", "reason": "unknown inline block requires adapter support"})
                in_block = ""
                block_lines = []
            else:
                block_lines.append(raw)
            continue
        if not line or line.startswith(("#", ";")):
            continue
        if line.startswith("<") and line.endswith(">") and not line.startswith("</"):
            in_block = line[1:-1].strip().lower()
            block_lines = []
            continue
        parts = line.split()
        key = parts[0].lower()
        value = " ".join(parts[1:]).strip()
        if key == "client":
            continue
        if key == "dev":
            continue
        if key == "auth-user-pass":
            if auth_inline:
                continue
            if value:
                blocked.append({"line": line[:180], "directive": key, "reason": "external credential file from uploaded config is not available to V7"})
            else:
                blocked.append({"line": line[:180], "directive": key, "reason": "interactive OpenVPN credentials are not supported; paste inline credentials or use certificate auth"})
            continue
        if key in OPENVPN_SCRIPT_DIRECTIVES:
            blocked.append({"line": line[:180], "directive": key, "reason": "scripts/hooks are not allowed in managed V7 runtime"})
            continue
        if key in OPENVPN_ROUTE_DIRECTIVES or key in OPENVPN_DNS_DIRECTIVES:
            continue
        if key in OPENVPN_V7_MANAGED_DIRECTIVES:
            continue
        if key in {"user", "group"}:
            continue
        if key in OPENVPN_SAFE_DIRECTIVES:
            normalized.append(redact(line) if redact_output else line)
            continue
        review.append({"line": line[:180], "directive": key, "reason": "directive is not in the safe OpenVPN allowlist yet"})

    if in_block:
        review.append({"directive": f"<{in_block}>", "reason": "inline block was not closed"})

    for name in ("ca", "cert", "key", "tls-auth", "tls-crypt", "tls-crypt-v2"):
        if name in copied_blocks:
            continue
        values = blocks.get(name) or []
        if values:
            append_block(name, values[0])

    if errors or blocked or review:
        return None, auth_file_content, {
            "error": "openvpn_normalize_failed",
            "details": errors,
            "blocked_directives": blocked,
            "manual_review": review,
        }
    return "\n".join(normalized).rstrip() + "\n", auth_file_content, None


def egress_openvpn_normalize_preview_text(text):
    fields = _egress_preview_openvpn_fields(text)
    normalized_text, auth_file_content, normalize_error = egress_openvpn_normalize_runtime_config(
        text,
        "v7ovpnpreview",
        auth_path="/etc/v7/egress-openvpn/v7ovpnpreview.auth",
        redact_output=True,
    )
    kept = []
    blocked = []
    review = []
    secret_blocks = []
    in_block = ""
    block_lines = []

    def finish_block(name, lines):
        block_name = str(name or "").lower()
        if block_name in OPENVPN_SECRET_BLOCKS:
            secret_blocks.append(block_name)
            kept.append(f"<{block_name}>[REDACTED]</{block_name}>")
        elif block_name in {"ca", "cert"}:
            kept.append(f"<{block_name}>")
            kept.extend(["  [CERTIFICATE DATA REDACTED]"])
            kept.append(f"</{block_name}>")
        else:
            review.append({"directive": f"<{block_name}>", "reason": "unknown inline block requires manual review"})

    for raw in text.splitlines():
        line = raw.strip()
        if in_block:
            block_lines.append(raw)
            if line.lower() == f"</{in_block}>":
                finish_block(in_block, block_lines)
                in_block = ""
                block_lines = []
            continue
        if not line or line.startswith(("#", ";")):
            continue
        if line.startswith("<") and line.endswith(">") and not line.startswith("</"):
            in_block = line[1:-1].strip().lower()
            block_lines = [raw]
            continue
        parts = line.split()
        key = parts[0].lower()
        if key in OPENVPN_SCRIPT_DIRECTIVES:
            blocked.append({"line": line[:180], "directive": key, "reason": "scripts/hooks are not allowed in managed V7 runtime"})
        elif key in OPENVPN_ROUTE_DIRECTIVES or key in OPENVPN_DNS_DIRECTIVES:
            kept.append(f"# V7 will ignore/normalize: {redact(line)}")
        elif key in OPENVPN_SAFE_DIRECTIVES:
            kept.append(redact(line))
        else:
            review.append({"line": line[:180], "directive": key, "reason": "directive is not in the safe allowlist yet"})

    if in_block:
        review.append({"directive": f"<{in_block}>", "reason": "inline block was not closed"})

    required = {
        "client": fields["client"],
        "remote": bool(fields["remote"]),
        "dev": bool(fields["dev"]),
        "auth_material": bool(fields["auth_user_pass"] or (fields["cert"] and fields["key"])),
    }
    checks = [
        {"id": "openvpn_detected", "status": "OK", "detail": "OpenVPN client profile detected"},
        {"id": "required_fields", "status": "OK" if all(required.values()) else "FAIL", "detail": ", ".join(k for k, v in required.items() if not v) or "all required fields present"},
        {"id": "scripts_hooks_absent", "status": "OK" if not fields["scripts"] else "FAIL", "detail": "none" if not fields["scripts"] else "; ".join(fields["scripts"][:4])},
        {"id": "v7_route_control", "status": "OK", "detail": "V7 forces route-nopull and owns routes/DNS"},
        {"id": "openvpn_runtime_adapter", "status": "OK" if not normalize_error else "BLOCKED", "detail": "runtime adapter can build a managed profile" if not normalize_error else "normalization has blockers"},
    ]
    if normalize_error:
        blocked.extend(normalize_error.get("blocked_directives", []))
        review.extend(normalize_error.get("manual_review", []))
    status = "BLOCKED" if blocked or review or not all(required.values()) or normalize_error else "READY"
    return {
        "status": status,
        "protocol": "openvpn",
        "runtime_mode": "interface",
        "mode": "preview_only_no_files_changed",
        "validation": "openvpn_normalize_preview",
        "detected_fields": {
            "remote": fields["remote"],
            "proto": fields["proto"] or "default",
            "dev": fields["dev"],
            "auth_user_pass": "present" if fields["auth_user_pass"] else "missing",
            "cert_key": "present" if fields["cert"] and fields["key"] else "missing",
            "secret_blocks": sorted(set(secret_blocks)),
        },
        "checks": checks,
        "blocked_directives": blocked,
        "manual_review": review,
        "normalized_preview_redacted": normalized_text or "\n".join(kept[:120]),
        "kept_directive_count": len(kept),
        "blocked_count": len(blocked),
        "manual_review_count": len(review),
        "would_write_files": False,
        "would_start_runtime": False,
        "would_change_routes": False,
        "would_change_killswitch": False,
        "next_step": "fix_openvpn_blockers" if status == "BLOCKED" else "run_openvpn_pipeline",
    }


def _clash_scalar(value):
    value = str(value or "").strip().rstrip(",")
    if (value.startswith('"') and value.endswith('"')) or (value.startswith("'") and value.endswith("'")):
        value = value[1:-1]
    return value.strip()


def _parse_clash_inline_map(value):
    value = str(value or "").strip()
    if not (value.startswith("{") and value.endswith("}")):
        return {}
    body = value[1:-1].strip()
    result = {}
    parts = re.split(r",\s*(?=[A-Za-z0-9_-]+\s*:)", body)
    for part in parts:
        if ":" not in part:
            continue
        key, val = part.split(":", 1)
        result[key.strip()] = _clash_scalar(val)
    return result


def _clash_parse_proxies(text):
    proxies = []
    current = None
    in_proxies = False
    for raw in text.splitlines():
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        if re.match(r"^proxies\s*:\s*$", raw):
            in_proxies = True
            continue
        if in_proxies and re.match(r"^[A-Za-z0-9_-]+\s*:", raw) and not raw.startswith((" ", "\t", "-")):
            break
        if not in_proxies:
            continue
        stripped = raw.strip()
        if stripped.startswith("- "):
            if current:
                proxies.append(current)
            current = {}
            item = stripped[2:].strip()
            if item.startswith("{"):
                current.update(_parse_clash_inline_map(item))
            elif ":" in item:
                key, val = item.split(":", 1)
                current[key.strip()] = _clash_scalar(val)
            continue
        if current is not None and ":" in stripped:
            key, val = stripped.split(":", 1)
            current[key.strip()] = _clash_scalar(val)
    if current:
        proxies.append(current)
    return proxies


def _clash_proxy_to_outbound(proxy, index=1, redact_secrets=True):
    supported_types = {"ss": "shadowsocks", "shadowsocks": "shadowsocks", "vless": "vless", "vmess": "vmess", "trojan": "trojan"}
    ptype = str(proxy.get("type") or "").lower()
    target_type = supported_types.get(ptype)
    name = str(proxy.get("name") or f"proxy-{index}")[:64]
    if not target_type:
        return {
            "index": index,
            "name": name,
            "type": ptype or "missing",
            "target": "",
            "status": "UNSUPPORTED",
            "missing": [],
            "reason": "proxy type is not supported by preview converter yet",
        }
    try:
        port = int(str(proxy.get("port") or "0"))
    except ValueError:
        port = 0
    required = {
        "server": bool(proxy.get("server")),
        "port": bool(port),
    }
    outbound = {
        "tag": safe_client_name(re.sub(r"[^A-Za-z0-9_.-]+", "-", name).strip("-").lower()) or f"proxy-{index}",
        "type": target_type,
        "server": str(proxy.get("server") or ""),
        "server_port": port,
    }
    if target_type == "shadowsocks":
        method = proxy.get("cipher") or proxy.get("method")
        required["method"] = bool(method)
        required["password"] = bool(proxy.get("password"))
        outbound["method"] = str(method or "")
        outbound["password"] = "[REDACTED]" if (redact_secrets and proxy.get("password")) else str(proxy.get("password") or "")
    elif target_type in ("vless", "vmess"):
        required["uuid"] = bool(proxy.get("uuid"))
        outbound["uuid"] = "[REDACTED]" if (redact_secrets and proxy.get("uuid")) else str(proxy.get("uuid") or "")
        if str(proxy.get("tls", "")).lower() in {"true", "1", "yes"} or proxy.get("servername") or proxy.get("sni"):
            outbound["tls"] = {"enabled": True}
            sni = proxy.get("servername") or proxy.get("sni")
            if sni:
                outbound["tls"]["server_name"] = str(sni)
        if proxy.get("network"):
            outbound["transport"] = {"type": str(proxy.get("network"))}
    elif target_type == "trojan":
        required["password"] = bool(proxy.get("password"))
        outbound["password"] = "[REDACTED]" if (redact_secrets and proxy.get("password")) else str(proxy.get("password") or "")
        if str(proxy.get("tls", "")).lower() in {"true", "1", "yes"} or proxy.get("servername") or proxy.get("sni"):
            outbound["tls"] = {"enabled": True}
            sni = proxy.get("servername") or proxy.get("sni")
            if sni:
                outbound["tls"]["server_name"] = str(sni)
    missing = [key for key, ok in required.items() if not ok]
    return {
        "index": index,
        "name": name,
        "type": ptype,
        "target": "sing-box",
        "status": "READY" if not missing else "BLOCKED",
        "missing": missing,
        "outbound_preview": outbound,
        "outbound": outbound,
    }


def egress_clash_convert_preview_text(text):
    proxies = _clash_parse_proxies(text)
    converted = []
    unsupported = []
    for index, proxy in enumerate(proxies, 1):
        row = _clash_proxy_to_outbound(proxy, index=index, redact_secrets=True)
        if row.get("status") == "UNSUPPORTED":
            unsupported.append({"index": row.get("index"), "name": row.get("name"), "type": row.get("type"), "reason": row.get("reason")})
            continue
        row.pop("outbound", None)
        converted.append(row)

    ready_count = sum(1 for row in converted if row.get("status") == "READY")
    status = "READY_FOR_ADAPTER" if ready_count else "BLOCKED"
    return {
        "status": status,
        "protocol": "clash_yaml",
        "runtime_mode": "proxy_or_tun",
        "mode": "preview_only_no_files_changed",
        "validation": "clash_convert_preview",
        "detected_fields": {
            "proxies": len(proxies),
            "convertible": ready_count,
            "unsupported": len(unsupported),
        },
        "checks": [
            {"id": "clash_proxies_found", "status": "OK" if proxies else "FAIL", "detail": f"{len(proxies)} proxies"},
            {"id": "convertible_proxies", "status": "OK" if ready_count else "FAIL", "detail": f"{ready_count}/{len(proxies)} ready"},
            {"id": "clash_runtime_adapter", "status": "BLOCKED", "detail": "preview only; converter does not write runtime profile yet"},
        ],
        "converted_outbounds": converted,
        "unsupported_proxies": unsupported,
        "would_write_files": False,
        "would_start_runtime": False,
        "would_change_routes": False,
        "would_change_killswitch": False,
        "secret_redaction": "proxy secrets are shown only as [REDACTED]",
        "next_step": "select_one_proxy_for_draft_runtime_conversion" if ready_count else "fix_clash_proxy_fields_or_use_manual_input",
    }
def _first_query_value(query, *names):
    for name in names:
        values = query.get(name)
        if values:
            return values[0]
    return ""


def _decode_unpadded_base64(value):
    value = str(value or "").strip()
    padding = "=" * (-len(value) % 4)
    return base64.urlsafe_b64decode((value + padding).encode("ascii", errors="ignore")).decode("utf-8", errors="replace")


def _query_bool(query, *names):
    value = _first_query_value(query, *names).strip().lower()
    return value in {"1", "true", "yes", "on"}


def _parsed_host_port(parsed):
    try:
        port = parsed.port or 0
    except ValueError:
        port = 0
    return parsed.hostname or "", port


def _tls_from_query(query, default_enabled=False):
    sni = _first_query_value(query, "sni", "peer", "servername", "serverName")
    insecure = _query_bool(query, "insecure", "allowInsecure", "allow_insecure", "skip-cert-verify", "skip_cert_verify")
    alpn = _first_query_value(query, "alpn")
    tls_enabled = default_enabled or bool(sni) or insecure or bool(alpn)
    if not tls_enabled:
        return None
    tls = {"enabled": True}
    if sni:
        tls["server_name"] = sni
    if insecure:
        tls["insecure"] = True
    if alpn:
        tls["alpn"] = [item.strip() for item in alpn.split(",") if item.strip()]
    return tls


def _multi_link_lines(raw):
    links = []
    for line in str(raw or "").splitlines():
        item = line.strip()
        if item and "://" in item and not item.startswith(("#", "//")):
            links.append(item)
    return links


def _xray_int(value):
    try:
        return int(value or 0)
    except (TypeError, ValueError):
        return 0


def _xray_bool(value):
    if isinstance(value, bool):
        return value
    return str(value or "").strip().lower() in {"1", "true", "yes", "on"}


def _xray_stream_tls(stream):
    stream = stream if isinstance(stream, dict) else {}
    security = str(stream.get("security") or "").lower()
    tls_settings = stream.get("tlsSettings") if isinstance(stream.get("tlsSettings"), dict) else {}
    reality_settings = stream.get("realitySettings") if isinstance(stream.get("realitySettings"), dict) else {}
    if security not in {"tls", "reality"} and not tls_settings and not reality_settings:
        return None

    source = reality_settings if security == "reality" else tls_settings
    tls = {"enabled": True}
    server_name = source.get("serverName") or source.get("server_name")
    if server_name:
        tls["server_name"] = str(server_name)
    if source.get("allowInsecure") is not None:
        tls["insecure"] = _xray_bool(source.get("allowInsecure"))
    alpn = source.get("alpn")
    if isinstance(alpn, list):
        tls["alpn"] = [str(item) for item in alpn if str(item).strip()]
    elif isinstance(alpn, str) and alpn.strip():
        tls["alpn"] = [item.strip() for item in alpn.split(",") if item.strip()]

    fingerprint = source.get("fingerprint") or source.get("fingerPrint")
    if fingerprint:
        tls["utls"] = {"enabled": True, "fingerprint": str(fingerprint)}
    if security == "reality" or reality_settings:
        public_key = reality_settings.get("publicKey") or reality_settings.get("public_key")
        short_id = reality_settings.get("shortId") or reality_settings.get("short_id")
        tls["reality"] = {"enabled": True}
        if public_key:
            tls["reality"]["public_key"] = str(public_key)
        if short_id:
            if isinstance(short_id, list):
                short_id = short_id[0] if short_id else ""
            tls["reality"]["short_id"] = str(short_id)
    return tls


def _xray_stream_transport(stream):
    stream = stream if isinstance(stream, dict) else {}
    network = str(stream.get("network") or "tcp").lower()
    if network in {"tcp", "raw"}:
        tcp_settings = stream.get("tcpSettings") if isinstance(stream.get("tcpSettings"), dict) else {}
        header = tcp_settings.get("header") if isinstance(tcp_settings.get("header"), dict) else {}
        if str(header.get("type") or "").lower() != "http":
            return None
        request = header.get("request") if isinstance(header.get("request"), dict) else {}
        transport = {"type": "http"}
        path = request.get("path")
        if isinstance(path, list):
            transport["path"] = str(path[0]) if path else "/"
        elif path:
            transport["path"] = str(path)
        headers = request.get("headers") if isinstance(request.get("headers"), dict) else {}
        host = headers.get("Host") or headers.get("host")
        if isinstance(host, list):
            host = host[0] if host else ""
        if host:
            transport["host"] = [str(host)]
        return transport
    if network == "ws":
        ws = stream.get("wsSettings") if isinstance(stream.get("wsSettings"), dict) else {}
        transport = {"type": "ws"}
        if ws.get("path"):
            transport["path"] = str(ws.get("path"))
        headers = ws.get("headers") if isinstance(ws.get("headers"), dict) else {}
        host = headers.get("Host") or headers.get("host")
        if host:
            transport["headers"] = {"Host": str(host)}
        return transport
    if network in {"http", "h2"}:
        http_settings = stream.get("httpSettings") if isinstance(stream.get("httpSettings"), dict) else {}
        transport = {"type": "http"}
        hosts = http_settings.get("host")
        if isinstance(hosts, list):
            transport["host"] = [str(item) for item in hosts if str(item).strip()]
        elif hosts:
            transport["host"] = [str(hosts)]
        if http_settings.get("path"):
            transport["path"] = str(http_settings.get("path"))
        return transport
    if network == "grpc":
        grpc = stream.get("grpcSettings") if isinstance(stream.get("grpcSettings"), dict) else {}
        transport = {"type": "grpc"}
        service_name = grpc.get("serviceName") or grpc.get("service_name")
        if service_name:
            transport["service_name"] = str(service_name)
        return transport
    if network == "httpupgrade":
        settings = stream.get("httpupgradeSettings") if isinstance(stream.get("httpupgradeSettings"), dict) else {}
        transport = {"type": "httpupgrade"}
        if settings.get("path"):
            transport["path"] = str(settings.get("path"))
        host = settings.get("host")
        if host:
            transport["host"] = str(host)
        return transport
    if network == "quic":
        return {"type": "quic"}
    return {"type": network} if network else None


def _xray_apply_stream(outbound, stream):
    tls = _xray_stream_tls(stream)
    if tls:
        outbound["tls"] = tls
    transport = _xray_stream_transport(stream)
    if transport:
        outbound["transport"] = transport
    return outbound


def _xray_endpoint_name(outbound, index, suffix=""):
    tag = clean_identity_text(outbound.get("tag", ""), 64)
    if suffix:
        suffix = clean_identity_text(suffix, 48)
    if tag and suffix:
        return f"{tag}-{suffix}"[:80]
    return tag or suffix or f"xray-{index}"


def _xray_outbound_to_endpoint_rows(outbound, start_index=1):
    outbound = outbound if isinstance(outbound, dict) else {}
    protocol = str(outbound.get("protocol") or "").lower()
    settings = outbound.get("settings") if isinstance(outbound.get("settings"), dict) else {}
    stream = outbound.get("streamSettings") if isinstance(outbound.get("streamSettings"), dict) else {}
    tag = str(outbound.get("tag") or protocol or "xray")
    rows = []

    def append_row(sb_outbound, suffix=""):
        sb_outbound = dict(sb_outbound)
        sb_outbound["tag"] = safe_client_name(re.sub(r"[^A-Za-z0-9_.-]+", "-", str(sb_outbound.get("tag") or tag).strip()).strip("-").lower()) or "egress"
        _xray_apply_stream(sb_outbound, stream)
        rows.append(egress_endpoint_from_outbound(
            sb_outbound,
            start_index + len(rows),
            source="xray_json",
            name=_xray_endpoint_name(outbound, start_index + len(rows), suffix),
        ))

    if protocol in {"vless", "vmess"}:
        for server in settings.get("vnext", []) if isinstance(settings.get("vnext"), list) else []:
            if not isinstance(server, dict):
                continue
            address = str(server.get("address") or "")
            port = _xray_int(server.get("port"))
            users = server.get("users") if isinstance(server.get("users"), list) else [{}]
            if not users:
                users = [{}]
            for user_index, user in enumerate(users, 1):
                user = user if isinstance(user, dict) else {}
                sb = {
                    "type": protocol,
                    "tag": tag,
                    "server": address,
                    "server_port": port,
                    "uuid": str(user.get("id") or ""),
                }
                if protocol == "vless" and user.get("flow"):
                    sb["flow"] = str(user.get("flow"))
                if protocol == "vmess":
                    sb["security"] = str(user.get("security") or "auto")
                    alter_id = _xray_int(user.get("alterId") or user.get("alter_id"))
                    if alter_id:
                        sb["alter_id"] = alter_id
                append_row(sb, f"{address}-{user_index}")
        return rows

    if protocol in {"trojan", "shadowsocks", "socks", "http"}:
        servers = settings.get("servers") if isinstance(settings.get("servers"), list) else []
        for server_index, server in enumerate(servers, 1):
            if not isinstance(server, dict):
                continue
            address = str(server.get("address") or "")
            port = _xray_int(server.get("port"))
            sb = {
                "type": "shadowsocks" if protocol == "shadowsocks" else protocol,
                "tag": tag,
                "server": address,
                "server_port": port,
            }
            if protocol == "trojan":
                sb["password"] = str(server.get("password") or "")
            elif protocol == "shadowsocks":
                sb["method"] = str(server.get("method") or server.get("cipher") or "")
                sb["password"] = str(server.get("password") or "")
            elif protocol in {"socks", "http"}:
                users = server.get("users") if isinstance(server.get("users"), list) else []
                if users and isinstance(users[0], dict):
                    sb["username"] = str(users[0].get("user") or users[0].get("username") or "")
                    sb["password"] = str(users[0].get("pass") or users[0].get("password") or "")
            append_row(sb, f"{address}-{server_index}")
        return rows

    if protocol in {"freedom", "blackhole", "dns"}:
        return []
    if protocol:
        rows.append({
            "index": start_index,
            "name": clean_identity_text(tag, 80) or f"xray-{start_index}",
            "source": "xray_json",
            "protocol": protocol,
            "target": "",
            "status": "UNSUPPORTED",
            "missing": [],
            "reason": "xray outbound protocol is not supported by converter yet",
        })
    return rows


def egress_xray_endpoint_rows(parsed, start_index=1):
    endpoints = []
    outbounds = parsed.get("outbounds", []) if isinstance(parsed, dict) else []
    for outbound in outbounds:
        if not isinstance(outbound, dict) or not outbound.get("protocol"):
            continue
        rows = _xray_outbound_to_endpoint_rows(outbound, start_index + len(endpoints))
        endpoints.extend(rows)
    return endpoints


def _outline_split_endpoint(value):
    endpoint = str(value or "").strip()
    if not endpoint:
        return "", 0
    if endpoint.startswith("[") and "]:" in endpoint:
        host, port_raw = endpoint.rsplit("]:", 1)
        return host.lstrip("["), int(port_raw) if port_raw.isdigit() else 0
    if ":" in endpoint:
        host, port_raw = endpoint.rsplit(":", 1)
        return host.strip("[]"), int(port_raw) if port_raw.isdigit() else 0
    return endpoint, 0


def _outline_shadowsocks_row(server, port, method, password, index=1, name="outline", prefix=""):
    outbound = {
        "type": "shadowsocks",
        "tag": safe_client_name(name) or f"outline-{index}",
        "server": str(server or ""),
        "server_port": _xray_int(port),
        "method": str(method or ""),
        "password": str(password or ""),
    }
    row = egress_endpoint_from_outbound(outbound, index, source="outline_config", name=name or f"outline-{index}")
    if prefix:
        row["status"] = "BLOCKED"
        row["missing"] = sorted(set((row.get("missing") or []) + ["outline_prefix_support"]))
        row["reason"] = "Outline prefix disguise is present; sing-box Shadowsocks prefix support must be confirmed before runtime use"
    return row


def _outline_legacy_json_rows(parsed, start_index=1):
    if not isinstance(parsed, dict):
        return []
    if parsed.get("error"):
        return [{
            "index": start_index,
            "name": "outline-error",
            "source": "outline_config",
            "protocol": "shadowsocks_or_outline",
            "target": "",
            "status": "BLOCKED",
            "missing": ["usable_outline_transport"],
            "reason": clean_identity_text((parsed.get("error") or {}).get("message") if isinstance(parsed.get("error"), dict) else parsed.get("error"), 160) or "Outline config returned an error",
        }]
    server = parsed.get("server")
    port = parsed.get("server_port") or parsed.get("serverPort")
    method = parsed.get("method") or parsed.get("cipher")
    password = parsed.get("password") or parsed.get("secret")
    if server or port or method or password:
        return [_outline_shadowsocks_row(server, port, method, password, start_index, "outline-json", parsed.get("prefix", ""))]
    return []


def _outline_simple_yaml_fields(text):
    fields = {}
    for raw in str(text or "").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or ":" not in line:
            continue
        key, value = line.split(":", 1)
        key = key.strip()
        value = _clash_scalar(value)
        if key in {"server", "server_port", "serverPort", "method", "cipher", "password", "secret", "endpoint", "prefix", "$type"}:
            fields.setdefault(key, value)
    return fields


def egress_outline_endpoint_rows(text, start_index=1):
    raw = str(text or "").strip()
    if not raw:
        return []
    if raw.startswith("{"):
        try:
            return _outline_legacy_json_rows(json.loads(raw), start_index=start_index)
        except json.JSONDecodeError:
            return []
    fields = _outline_simple_yaml_fields(raw)
    if not fields:
        return []
    config_type = str(fields.get("$type") or "").lower()
    if config_type and config_type not in {"shadowsocks", "tcpudp"}:
        return []
    server = fields.get("server")
    port = fields.get("server_port") or fields.get("serverPort")
    if fields.get("endpoint"):
        endpoint_host, endpoint_port = _outline_split_endpoint(fields.get("endpoint"))
        server = server or endpoint_host
        port = port or endpoint_port
    method = fields.get("method") or fields.get("cipher")
    password = fields.get("password") or fields.get("secret")
    if not (server or port or method or password):
        return []
    return [_outline_shadowsocks_row(server, port, method, password, start_index, "outline-yaml", fields.get("prefix", ""))]


def _subscription_fetch_candidates(url):
    parsed = urlparse(str(url or "").strip())
    if parsed.scheme != "ssconf":
        return [str(url).strip()]
    suffix = parsed.netloc + parsed.path
    if parsed.query:
        suffix += f"?{parsed.query}"
    if parsed.fragment:
        suffix += f"#{parsed.fragment}"
    return [f"https://{suffix}", f"http://{suffix}"]


IMPORT_WRAPPER_SCHEMES = {
    "clash", "fair", "happ", "hiddify", "karing", "kidd", "nekobox", "nekoray",
    "sing-box", "singbox", "streisand", "v2raytun", "v2rayng", "v2box",
}
IMPORT_WRAPPER_QUERY_KEYS = (
    "url", "uri", "link", "links", "config", "sub", "subscription",
    "subscription_url", "target", "profile", "content",
)
IMPORT_WRAPPER_DIRECT_PREFIXES = (
    "http://", "https://", "ssconf://", "vless://", "vmess://", "trojan://",
    "ss://", "hysteria://", "hysteria2://", "hy2://", "tuic://", "anytls://",
    "socks://", "socks5://", "socks4://", "wireguard://",
)


def _egress_unwrap_query_blobs(parsed):
    blobs = []
    if parsed.query:
        blobs.append(parsed.query)
    for value in (parsed.fragment, parsed.path):
        if not value:
            continue
        if "?" in value:
            blobs.append(value.split("?", 1)[1])
        elif "=" in value and "&" in value:
            blobs.append(value.lstrip("#?"))
    return blobs


def _egress_wrapper_payload_candidate(parsed):
    for blob in _egress_unwrap_query_blobs(parsed):
        params = parse_qs(blob, keep_blank_values=False)
        for key in IMPORT_WRAPPER_QUERY_KEYS:
            for value in params.get(key, []):
                candidate = unquote(str(value or "")).strip()
                if candidate:
                    return key, candidate
    path_candidates = []
    if parsed.netloc or parsed.path:
        path_candidates.append(f"{parsed.netloc}{parsed.path}".strip("/"))
    if parsed.path:
        path_candidates.append(parsed.path.strip("/"))
    for candidate in path_candidates:
        candidate = unquote(candidate or "").strip()
        if candidate.lower().startswith(IMPORT_WRAPPER_DIRECT_PREFIXES):
            return "path", candidate
    return "", ""


def egress_unwrap_import_uri(raw):
    current = str(raw or "").strip()
    wrappers = []
    for _ in range(4):
        parsed = urlparse(current)
        scheme = parsed.scheme.lower()
        if scheme not in IMPORT_WRAPPER_SCHEMES:
            break
        key, candidate = _egress_wrapper_payload_candidate(parsed)
        if not candidate or candidate == current:
            break
        wrappers.append({"scheme": scheme, "key": key})
        current = candidate.strip()
    return {"text": current, "wrappers": wrappers, "unwrapped": bool(wrappers)}


def egress_parse_subscription_url(raw):
    parsed = urlparse(str(raw or "").strip())
    scheme = parsed.scheme.lower()
    if scheme not in {"http", "https", "ssconf"} or not parsed.hostname:
        return None
    if parsed.username or parsed.password:
        return None
    return {
        "protocol": "subscription_url",
        "runtime_mode": "subscription",
        "required": {"url": True, "scheme": True, "host": True},
        "detected_fields": {
            "url": "present",
            "scheme": scheme,
            "host": parsed.hostname,
            "path": parsed.path or "/",
        },
    }


def egress_parse_proxy_share(raw):
    raw = str(raw or "").strip()
    lowered = raw.lower()
    if lowered.startswith("vless://"):
        parsed = urlparse(raw)
        query = parse_qs(parsed.query)
        uuid = unquote(parsed.username or "")
        server = parsed.hostname or ""
        port = parsed.port or 0
        outbound = {
            "type": "vless",
            "tag": "egress",
            "server": server,
            "server_port": port,
            "uuid": uuid,
        }
        flow = _first_query_value(query, "flow")
        if flow:
            outbound["flow"] = flow
        security = _first_query_value(query, "security")
        sni = _first_query_value(query, "sni", "servername", "serverName")
        fp = _first_query_value(query, "fp", "fingerprint") or "chrome"
        public_key = _first_query_value(query, "pbk", "publicKey", "public_key")
        short_id = _first_query_value(query, "sid", "shortId", "short_id")
        if security in ("tls", "reality") or sni or public_key:
            tls = {"enabled": True}
            if sni:
                tls["server_name"] = sni
            if fp:
                tls["utls"] = {"enabled": True, "fingerprint": fp}
            if security == "reality" or public_key:
                tls["reality"] = {"enabled": True, "public_key": public_key}
                if short_id:
                    tls["reality"]["short_id"] = short_id
            outbound["tls"] = tls
        network = _first_query_value(query, "type", "network")
        if network in ("ws", "grpc", "http", "httpupgrade"):
            outbound["transport"] = {"type": network}
            if network == "ws":
                path = _first_query_value(query, "path")
                host = _first_query_value(query, "host")
                if path:
                    outbound["transport"]["path"] = path
                if host:
                    outbound["transport"]["headers"] = {"Host": host}
            if network == "grpc":
                service_name = _first_query_value(query, "serviceName", "service_name")
                if service_name:
                    outbound["transport"]["service_name"] = service_name
        required = {
            "server": bool(server),
            "port": bool(port),
            "uuid": bool(uuid),
        }
        if security == "reality" or public_key:
            required["reality_public_key"] = bool(public_key)
            required["sni"] = bool(sni)
        return {"protocol": "vless", "outbound": outbound, "required": required}, None

    if lowered.startswith("trojan://"):
        parsed = urlparse(raw)
        query = parse_qs(parsed.query)
        password = unquote(parsed.username or "")
        server = parsed.hostname or ""
        port = parsed.port or 0
        sni = _first_query_value(query, "sni", "peer", "servername", "serverName")
        outbound = {
            "type": "trojan",
            "tag": "egress",
            "server": server,
            "server_port": port,
            "password": password,
        }
        if sni or _first_query_value(query, "security") == "tls":
            outbound["tls"] = {"enabled": True}
            if sni:
                outbound["tls"]["server_name"] = sni
        return {
            "protocol": "trojan",
            "outbound": outbound,
            "required": {"server": bool(server), "port": bool(port), "password": bool(password)},
        }, None

    if lowered.startswith("ss://"):
        parsed = urlparse(raw)
        server = parsed.hostname or ""
        port = parsed.port or 0
        userinfo = unquote(parsed.username or "")
        if not server:
            body = raw[5:].split("#", 1)[0].split("?", 1)[0]
            decoded = _decode_unpadded_base64(body)
            parsed = urlparse("ss://" + decoded)
            server = parsed.hostname or ""
            port = parsed.port or 0
            userinfo = unquote(parsed.username or "")
        if ":" in userinfo:
            method, password = userinfo.split(":", 1)
        else:
            decoded_userinfo = _decode_unpadded_base64(userinfo) if userinfo else ""
            method, password = decoded_userinfo.split(":", 1) if ":" in decoded_userinfo else ("", "")
        outbound = {
            "type": "shadowsocks",
            "tag": "egress",
            "server": server,
            "server_port": port,
            "method": method,
            "password": password,
        }
        return {
            "protocol": "shadowsocks_or_outline",
            "outbound": outbound,
            "required": {"server": bool(server), "port": bool(port), "method": bool(method), "password": bool(password)},
        }, None

    if lowered.startswith("vmess://"):
        body = raw.split("://", 1)[1].split("#", 1)[0].strip()
        try:
            payload = json.loads(_decode_unpadded_base64(body))
        except Exception as exc:
            return None, {"error": "invalid_vmess_share", "detail": str(exc)}
        server = str(payload.get("add") or "")
        try:
            port = int(payload.get("port") or 0)
        except ValueError:
            port = 0
        uuid = str(payload.get("id") or "")
        outbound = {
            "type": "vmess",
            "tag": "egress",
            "server": server,
            "server_port": port,
            "uuid": uuid,
            "security": str(payload.get("scy") or "auto"),
        }
        if str(payload.get("tls") or ""):
            outbound["tls"] = {"enabled": True}
            sni = str(payload.get("sni") or payload.get("host") or "")
            if sni:
                outbound["tls"]["server_name"] = sni
        return {
            "protocol": "vmess",
            "outbound": outbound,
            "required": {"server": bool(server), "port": bool(port), "uuid": bool(uuid)},
        }, None

    if lowered.startswith(("hysteria2://", "hy2://")):
        parsed = urlparse(raw)
        query = parse_qs(parsed.query)
        server, port = _parsed_host_port(parsed)
        password = unquote(parsed.username or "") or _first_query_value(query, "auth", "password")
        outbound = {
            "type": "hysteria2",
            "tag": "egress",
            "server": server,
            "server_port": port,
            "password": password,
        }
        tls = _tls_from_query(query, default_enabled=True)
        if tls:
            outbound["tls"] = tls
        obfs_type = _first_query_value(query, "obfs", "obfs-type", "obfs_type")
        obfs_password = _first_query_value(query, "obfs-password", "obfs_password", "obfsParam", "obfs-param")
        if obfs_type or obfs_password:
            outbound["obfs"] = {"type": obfs_type or "salamander"}
            if obfs_password:
                outbound["obfs"]["password"] = obfs_password
        up = _first_query_value(query, "upmbps", "up_mbps", "up")
        down = _first_query_value(query, "downmbps", "down_mbps", "down")
        if up:
            outbound["up_mbps"] = int(up) if str(up).isdigit() else up
        if down:
            outbound["down_mbps"] = int(down) if str(down).isdigit() else down
        return {
            "protocol": "hysteria2",
            "outbound": outbound,
            "required": {"server": bool(server), "port": bool(port), "password": bool(password)},
        }, None

    if lowered.startswith("hysteria://"):
        parsed = urlparse(raw)
        query = parse_qs(parsed.query)
        server, port = _parsed_host_port(parsed)
        auth = _first_query_value(query, "auth", "auth_str", "password") or unquote(parsed.username or "")
        outbound = {
            "type": "hysteria",
            "tag": "egress",
            "server": server,
            "server_port": port,
            "auth_str": auth,
        }
        protocol = _first_query_value(query, "protocol")
        if protocol:
            outbound["protocol"] = protocol
        tls = _tls_from_query(query, default_enabled=True)
        if tls:
            outbound["tls"] = tls
        return {
            "protocol": "hysteria",
            "outbound": outbound,
            "required": {"server": bool(server), "port": bool(port), "auth": bool(auth)},
        }, None

    if lowered.startswith("tuic://"):
        parsed = urlparse(raw)
        query = parse_qs(parsed.query)
        server, port = _parsed_host_port(parsed)
        username = unquote(parsed.username or "")
        password = unquote(parsed.password or "")
        outbound = {
            "type": "tuic",
            "tag": "egress",
            "server": server,
            "server_port": port,
            "uuid": username,
            "password": password,
        }
        congestion = _first_query_value(query, "congestion_control", "congestion-control")
        udp_mode = _first_query_value(query, "udp_relay_mode", "udp-relay-mode")
        if congestion:
            outbound["congestion_control"] = congestion
        if udp_mode:
            outbound["udp_relay_mode"] = udp_mode
        tls = _tls_from_query(query, default_enabled=True)
        if tls:
            outbound["tls"] = tls
        return {
            "protocol": "tuic",
            "outbound": outbound,
            "required": {"server": bool(server), "port": bool(port), "uuid": bool(username), "password": bool(password)},
        }, None

    if lowered.startswith("anytls://"):
        parsed = urlparse(raw)
        query = parse_qs(parsed.query)
        server, port = _parsed_host_port(parsed)
        password = unquote(parsed.username or "") or _first_query_value(query, "password")
        outbound = {
            "type": "anytls",
            "tag": "egress",
            "server": server,
            "server_port": port,
            "password": password,
        }
        tls = _tls_from_query(query, default_enabled=True)
        if tls:
            outbound["tls"] = tls
        return {
            "protocol": "anytls",
            "outbound": outbound,
            "required": {"server": bool(server), "port": bool(port), "password": bool(password)},
        }, None

    if lowered.startswith(("socks://", "socks5://", "socks4://", "http://", "https://")):
        parsed = urlparse(raw)
        scheme = parsed.scheme.lower()
        query = parse_qs(parsed.query)
        server, port = _parsed_host_port(parsed)
        if scheme in {"http", "https"} and not port and not parsed.username and not parsed.password:
            return None, {"error": "subscription_url_not_proxy_share"}
        outbound_type = "socks" if scheme.startswith("socks") else "http"
        outbound = {
            "type": outbound_type,
            "tag": "egress",
            "server": server,
            "server_port": port,
        }
        username = unquote(parsed.username or "")
        password = unquote(parsed.password or "")
        if username:
            outbound["username"] = username
        if password:
            outbound["password"] = password
        if scheme == "https" or _query_bool(query, "tls"):
            outbound["tls"] = _tls_from_query(query, default_enabled=True) or {"enabled": True}
        return {
            "protocol": outbound_type,
            "outbound": outbound,
            "required": {"server": bool(server), "port": bool(port)},
        }, None

    if lowered.startswith("wireguard://"):
        parsed = urlparse(raw)
        query = parse_qs(parsed.query)
        server, port = _parsed_host_port(parsed)
        private_key = _first_query_value(query, "private_key", "privateKey", "privatekey", "secretKey")
        public_key = _first_query_value(query, "public_key", "publicKey", "peerPublicKey", "publickey")
        address = _first_query_value(query, "address", "local_address", "localAddress")
        if not server and _first_query_value(query, "endpoint"):
            endpoint = _first_query_value(query, "endpoint")
            if ":" in endpoint:
                server, port_raw = endpoint.rsplit(":", 1)
                port = int(port_raw) if port_raw.isdigit() else 0
            else:
                server = endpoint
        outbound = {
            "type": "wireguard",
            "tag": "egress",
            "server": server,
            "server_port": port,
            "private_key": private_key,
            "peer_public_key": public_key,
            "local_address": [item.strip() for item in address.split(",") if item.strip()],
        }
        return {
            "protocol": "wireguard_uri",
            "outbound": outbound,
            "required": {
                "server": bool(server),
                "port": bool(port),
                "private_key": bool(private_key),
                "peer_public_key": bool(public_key),
                "local_address": bool(address),
            },
        }, None

    return None, {"error": "unsupported_proxy_share"}


def egress_sing_box_profile_from_outbound(outbound, listen_port):
    return {
        "log": {"level": "warn"},
        "inbounds": [
            {
                "type": "socks",
                "tag": "socks-in",
                "listen": "127.0.0.1",
                "listen_port": int(listen_port),
            }
        ],
        "outbounds": [
            outbound,
            {"type": "direct", "tag": "direct"},
            {"type": "block", "tag": "block"},
        ],
        "route": {"final": outbound.get("tag", "egress")},
    }


CONCRETE_SING_BOX_OUTBOUNDS = {
    "vless", "vmess", "trojan", "shadowsocks", "hysteria", "hysteria2",
    "tuic", "anytls", "socks", "http", "wireguard",
}


def egress_url_is_public(url):
    parsed = urlparse(str(url or "").strip())
    if parsed.scheme not in {"http", "https"} or not parsed.hostname:
        return False, "invalid_subscription_url"
    host = parsed.hostname
    if host.lower() in {"localhost", "localhost.localdomain"}:
        return False, "localhost_blocked"
    try:
        infos = socket.getaddrinfo(host, parsed.port or (443 if parsed.scheme == "https" else 80), type=socket.SOCK_STREAM)
    except OSError as exc:
        return False, f"dns_failed:{exc}"
    for info in infos:
        address = info[4][0]
        try:
            ip = ipaddress.ip_address(address)
        except ValueError:
            return False, "invalid_resolved_ip"
        if ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_multicast or ip.is_reserved or ip.is_unspecified:
            return False, f"non_public_ip_blocked:{ip}"
    return True, "OK"


def egress_fetch_subscription_text(url, timeout=10, max_bytes=262144):
    last_error = None
    for candidate in _subscription_fetch_candidates(url):
        safe, reason = egress_url_is_public(candidate)
        if not safe:
            last_error = {"error": "subscription_url_not_allowed", "url": candidate, "reason": reason}
            continue
        req = Request(
            candidate,
            headers={
                "User-Agent": "V7-Egress-Importer/1.0",
                "Accept": "text/plain, application/json, application/yaml, */*",
            },
            method="GET",
        )
        try:
            with urlopen(req, timeout=timeout) as response:
                content_length = response.headers.get("Content-Length")
                if content_length and int(content_length) > max_bytes:
                    return None, {"error": "subscription_too_large", "max_bytes": max_bytes}
                blob = response.read(max_bytes + 1)
        except Exception as exc:
            last_error = {"error": "subscription_fetch_failed", "url": candidate, "detail": str(exc)}
            continue
        if len(blob) > max_bytes:
            return None, {"error": "subscription_too_large", "max_bytes": max_bytes}
        return blob.decode("utf-8", errors="replace"), None
    return None, last_error or {"error": "subscription_fetch_failed"}


def egress_decode_subscription_body(text):
    raw = str(text or "").strip()
    if not raw:
        return raw
    if "://" in raw or re.search(r"(?im)^\s*(proxies|outbounds|transport|server|endpoint)\s*:", raw) or raw.startswith(("{", "[")):
        return raw
    compact = re.sub(r"\s+", "", raw)
    if not compact or not re.match(r"^[A-Za-z0-9_+/=-]+$", compact):
        return raw
    try:
        decoded = _decode_unpadded_base64(compact)
    except Exception:
        return raw
    if "://" in decoded or re.search(r"(?im)^\s*(proxies|outbounds|transport|server|endpoint)\s*:", decoded) or decoded.strip().startswith(("{", "[")):
        return decoded
    return raw


def egress_outbound_protocol(outbound):
    otype = str((outbound or {}).get("type", "")).lower()
    if otype == "shadowsocks":
        return "shadowsocks_or_outline"
    if otype == "wireguard":
        return "wireguard_uri"
    return otype or "unknown"


def egress_endpoint_required(outbound):
    otype = str((outbound or {}).get("type", "")).lower()
    required = {
        "server": bool((outbound or {}).get("server")),
        "port": bool((outbound or {}).get("server_port")),
    }
    if otype in {"vless", "vmess", "wireguard"}:
        required["uuid" if otype != "wireguard" else "peer_public_key"] = bool((outbound or {}).get("uuid") or (outbound or {}).get("peer_public_key"))
    if otype in {"trojan", "hysteria2", "tuic", "anytls"}:
        required["password"] = bool((outbound or {}).get("password"))
    if otype == "hysteria":
        required["auth"] = bool((outbound or {}).get("auth_str"))
    if otype == "shadowsocks":
        required["method"] = bool((outbound or {}).get("method"))
        required["password"] = bool((outbound or {}).get("password"))
    return required


def egress_endpoint_from_outbound(outbound, index, source="outbound", name=""):
    outbound = dict(outbound or {})
    protocol = egress_outbound_protocol(outbound)
    required = egress_endpoint_required(outbound)
    missing = [key for key, ok in required.items() if not ok]
    status = "READY" if protocol in {
        "vless", "vmess", "trojan", "shadowsocks_or_outline", "hysteria",
        "hysteria2", "tuic", "anytls", "socks", "http", "wireguard_uri",
    } and not missing else "BLOCKED"
    endpoint_name = clean_identity_text(name or outbound.get("tag") or f"endpoint-{index}", 80)
    return {
        "index": index,
        "name": endpoint_name or f"endpoint-{index}",
        "source": source,
        "protocol": protocol,
        "target": "sing-box",
        "status": status,
        "missing": missing,
        "server": outbound.get("server", ""),
        "server_port": outbound.get("server_port", 0),
        "tls": "present" if outbound.get("tls") else "not_configured",
        "outbound_preview": redact(outbound),
        "outbound": outbound,
    }


def egress_csv_value(value):
    if isinstance(value, list):
        return ",".join(str(item) for item in value if str(item).strip())
    return str(value or "")


def egress_share_endpoint(raw, index=1):
    parsed_share, error = egress_parse_proxy_share(raw)
    if error:
        return None, error
    name = unquote(urlparse(str(raw)).fragment or "") or f"{parsed_share.get('protocol', 'endpoint')}-{index}"
    row = egress_endpoint_from_outbound(parsed_share.get("outbound", {}), index, source="share_uri", name=name)
    row["raw_uri_present"] = True
    return row, None


def egress_sing_box_endpoint_rows(parsed, start_index=1):
    endpoints = []
    outbounds = parsed.get("outbounds", []) if isinstance(parsed, dict) else []
    for item in outbounds:
        if not isinstance(item, dict):
            continue
        otype = str(item.get("type", "")).lower()
        if otype not in CONCRETE_SING_BOX_OUTBOUNDS:
            continue
        endpoints.append(egress_endpoint_from_outbound(item, start_index + len(endpoints), source="sing_box_json", name=item.get("tag", "")))
    return endpoints


def egress_clash_endpoint_rows(text, start_index=1):
    endpoints = []
    for offset, proxy in enumerate(_clash_parse_proxies(text), start_index):
        converted = _clash_proxy_to_outbound(proxy, index=offset, redact_secrets=False)
        if converted.get("status") == "UNSUPPORTED":
            endpoints.append({
                "index": offset,
                "name": converted.get("name", f"proxy-{offset}"),
                "source": "clash_yaml",
                "protocol": converted.get("type", "unknown"),
                "target": "",
                "status": "UNSUPPORTED",
                "missing": [],
                "reason": converted.get("reason", "unsupported proxy type"),
            })
            continue
        row = egress_endpoint_from_outbound(converted.get("outbound", {}), offset, source="clash_yaml", name=converted.get("name", ""))
        row["status"] = "READY" if converted.get("status") == "READY" and not row.get("missing") else "BLOCKED"
        row["missing"] = converted.get("missing") or row.get("missing", [])
        endpoints.append(row)
    return endpoints


def egress_expand_endpoints_from_text(text, allow_fetch=False):
    raw = str(text or "").strip()
    if not raw:
        return None, {"error": "empty_config"}
    source = {"kind": "config_text", "fetched": False, "decoded_base64": False}
    unwrap = egress_unwrap_import_uri(raw)
    if unwrap["unwrapped"]:
        raw = unwrap["text"]
        source["wrapper"] = unwrap["wrappers"]
    sub = egress_parse_subscription_url(raw)
    if sub and allow_fetch:
        fetched, error = egress_fetch_subscription_text(raw)
        if error:
            return None, error
        raw = fetched or ""
        source = {"kind": "subscription_url", "url": sub["detected_fields"]["host"], "fetched": True, "decoded_base64": False}
    decoded = egress_decode_subscription_body(raw)
    if decoded != raw:
        source["decoded_base64"] = True
        raw = decoded

    endpoints = []
    links = _multi_link_lines(raw)
    if links:
        for link in links[:200]:
            row, error = egress_share_endpoint(link, len(endpoints) + 1)
            if error:
                endpoints.append({
                    "index": len(endpoints) + 1,
                    "name": link.split(":", 1)[0].lower() or "endpoint",
                    "source": "share_uri",
                    "protocol": link.split(":", 1)[0].lower() or "unknown",
                    "status": "UNSUPPORTED",
                    "missing": [],
                    "reason": error.get("error", "unsupported_share_uri"),
                })
            else:
                endpoints.append(row)
    elif raw.startswith("{"):
        try:
            parsed = json.loads(raw)
        except json.JSONDecodeError as exc:
            return None, {"error": "invalid_json_config", "detail": str(exc)}
        endpoints.extend(egress_sing_box_endpoint_rows(parsed))
        if not endpoints and isinstance(parsed, dict) and any(isinstance(item, dict) and item.get("protocol") for item in parsed.get("outbounds", [])):
            endpoints.extend(egress_xray_endpoint_rows(parsed))
        if not endpoints:
            endpoints.extend(egress_outline_endpoint_rows(raw))
        if not endpoints and isinstance(parsed, dict) and any(isinstance(item, dict) and item.get("protocol") for item in parsed.get("outbounds", [])):
            endpoints.append({
                "index": 1,
                "name": "xray-json",
                "source": "xray_json",
                "protocol": "xray_json",
                "status": "BLOCKED",
                "missing": ["convertible_xray_outbound"],
                "reason": "Xray/V2Ray JSON was recognized, but no convertible outbound was found",
            })
    elif re.search(r"(?im)^\s*proxies\s*:", raw):
        endpoints.extend(egress_clash_endpoint_rows(raw))
    elif re.search(r"(?im)^\s*(transport|server|endpoint)\s*:", raw):
        endpoints.extend(egress_outline_endpoint_rows(raw))
    else:
        row, error = egress_share_endpoint(raw, 1)
        if not error:
            endpoints.append(row)

    ready = sum(1 for row in endpoints if row.get("status") == "READY")
    response_rows = []
    for row in endpoints:
        safe_row = dict(row)
        safe_row.pop("outbound", None)
        safe_row["outbound_preview"] = redact(safe_row.get("outbound_preview", {}))
        response_rows.append(safe_row)
    return {
        "status": "READY_FOR_SELECTION" if ready else "BLOCKED",
        "source": source,
        "count": len(endpoints),
        "ready": ready,
        "blocked": len(endpoints) - ready,
        "endpoints": response_rows,
        "_internal_endpoints": endpoints,
        "secret_redaction": "endpoint secrets are redacted in API responses",
        "next_step": "select_endpoint_create_managed_draft" if ready else "fix_source_or_add_adapter",
    }, None


def egress_config_preview(data):
    text = str(data.get("config", "") or "")
    if len(text) > 65536:
        return None, {"error": "config_too_large", "max_bytes": 65536}
    label = clean_identity_text(data.get("label", ""), 80)
    raw = text.strip()
    if not raw:
        return None, {"error": "empty_config"}

    preview = {
        "label": label,
        "protocol": "unknown",
        "runtime_mode": "unknown",
        "detected_fields": {},
        "required": {},
        "missing": [],
        "sensitive_material": "yes",
        "pool_action": "draft_only_not_added",
        "next_step": "create_isolated_profile_then_test_before_pool",
    }
    unwrap = egress_unwrap_import_uri(raw)
    if unwrap["unwrapped"]:
        raw = unwrap["text"]
        preview["source_wrapper"] = unwrap["wrappers"]

    share_prefixes = (
        "vless://", "vmess://", "trojan://", "ss://", "hysteria://",
        "hysteria2://", "hy2://", "tuic://", "anytls://", "socks://",
        "socks5://", "socks4://",
    )
    lowered = raw.lower()
    links = _multi_link_lines(raw)
    if len(links) > 1:
        recognized = []
        unsupported = []
        for link in links[:200]:
            item, item_error = egress_parse_proxy_share(link)
            if item_error:
                sub = egress_parse_subscription_url(link)
                if sub:
                    recognized.append(sub.get("protocol", "subscription_url"))
                else:
                    unsupported.append(link.split(":", 1)[0].lower())
            else:
                recognized.append(item.get("protocol", "unknown"))
        preview.update({"protocol": "subscription_list", "runtime_mode": "subscription"})
        preview["detected_fields"] = {
            "links": len(links),
            "recognized": len(recognized),
            "protocols": ", ".join(sorted(set(recognized))) or "none",
            "unsupported_schemes": ", ".join(sorted(set(unsupported))) or "none",
        }
        preview["required"] = {"recognized_links": "present" if recognized else "missing"}
        preview["missing"] = [] if recognized else ["recognized_links"]
        preview["warnings"] = ["Subscription/list import is recognized, but V7 must expand it into one managed egress draft per selected endpoint before runtime use."]
    elif lowered.startswith(share_prefixes):
        parsed_share, share_error = egress_parse_proxy_share(raw)
        if share_error:
            return None, share_error
        outbound = parsed_share.get("outbound", {})
        required = parsed_share.get("required", {})
        preview.update({"protocol": parsed_share.get("protocol", "unknown"), "runtime_mode": "proxy_or_tun"})
        preview["detected_fields"] = {
            "share_uri": "present",
            "server": "present" if outbound.get("server") else "missing",
            "server_port": "present" if outbound.get("server_port") else "missing",
            "tls": "present" if outbound.get("tls") else "not_configured",
            "transport": (outbound.get("transport") or {}).get("type", "default"),
            "core": "sing-box",
        }
        preview["required"] = {key: "present" if value else "missing" for key, value in required.items()}
        preview["missing"] = [key for key, value in required.items() if not value]
    elif lowered.startswith("wireguard://"):
        parsed_share, share_error = egress_parse_proxy_share(raw)
        if share_error:
            return None, share_error
        outbound = parsed_share.get("outbound", {})
        required = parsed_share.get("required", {})
        preview.update({"protocol": "wireguard_uri", "runtime_mode": "proxy_or_tun"})
        preview["detected_fields"] = {
            "share_uri": "present",
            "server": "present" if outbound.get("server") else "missing",
            "server_port": "present" if outbound.get("server_port") else "missing",
            "local_address": "present" if outbound.get("local_address") else "missing",
            "core": "sing-box",
        }
        preview["required"] = {key: "present" if value else "missing" for key, value in required.items()}
        preview["missing"] = [key for key, value in required.items() if not value]
        preview["warnings"] = ["wireguard:// is a client-share URI, not a wg-quick file. V7 can classify it, but interface runtime still prefers a full [Interface]/[Peer] config with Table = off."]
    elif lowered.startswith(("http://", "https://", "ssconf://")):
        sub = egress_parse_subscription_url(raw)
        if not sub:
            parsed_share, share_error = egress_parse_proxy_share(raw)
            if share_error:
                return None, share_error
            outbound = parsed_share.get("outbound", {})
            required = parsed_share.get("required", {})
            preview.update({"protocol": parsed_share.get("protocol", "unknown"), "runtime_mode": "proxy_or_tun"})
            preview["detected_fields"] = {
                "share_uri": "present",
                "server": "present" if outbound.get("server") else "missing",
                "server_port": "present" if outbound.get("server_port") else "missing",
                "tls": "present" if outbound.get("tls") else "not_configured",
                "core": "sing-box",
            }
            preview["required"] = {key: "present" if value else "missing" for key, value in required.items()}
            preview["missing"] = [key for key, value in required.items() if not value]
        else:
            preview.update({"protocol": sub["protocol"], "runtime_mode": sub["runtime_mode"]})
            preview["detected_fields"] = sub["detected_fields"]
            preview["required"] = {key: "present" if value else "missing" for key, value in sub["required"].items()}
            preview["missing"] = [key for key, value in sub["required"].items() if not value]
            preview["warnings"] = ["Subscription URL is recognized. Runtime use is blocked until V7 fetches, validates, and lets the operator choose concrete endpoints."]
    elif raw.startswith("{"):
        try:
            parsed = json.loads(raw)
        except json.JSONDecodeError as exc:
            return None, {"error": "invalid_json_config", "detail": str(exc)}
        outline_rows = egress_outline_endpoint_rows(raw)
        if outline_rows:
            ready = sum(1 for row in outline_rows if row.get("status") == "READY")
            row = outline_rows[0]
            preview.update({"protocol": "shadowsocks_or_outline", "runtime_mode": "proxy_or_tun"})
            preview["detected_fields"] = {
                "json": "valid",
                "outline": "present",
                "server": "present" if row.get("server") else "missing",
                "server_port": "present" if row.get("server_port") else "missing",
                "method": "present" if not row.get("missing") or "method" not in row.get("missing", []) else "missing",
                "prefix": "blocked" if "outline_prefix_support" in row.get("missing", []) else "absent_or_not_required",
            }
            preview["required"] = {"outline_endpoint": "present" if ready else "missing"}
            preview["missing"] = [] if ready else row.get("missing", ["outline_endpoint"])
            if row.get("reason"):
                preview["warnings"] = [row.get("reason")]
            if not preview.get("missing"):
                preview["validation"] = "detected_required_fields"
            elif preview.get("protocol") == "unknown":
                preview["validation"] = "draft_unknown"
            else:
                preview["validation"] = "needs_operator_fix"
            usage_policy = egress_usage_policy_from_data(data)
            preview["role"] = usage_policy["role"]
            preview["usage_policy"] = usage_policy
            return preview, None
        outbounds = parsed.get("outbounds", []) if isinstance(parsed, dict) else []
        inbound_count = len(parsed.get("inbounds", [])) if isinstance(parsed, dict) and isinstance(parsed.get("inbounds"), list) else 0
        outbound_types = sorted(set(str(item.get("type", "")) for item in outbounds if isinstance(item, dict) and item.get("type")))
        concrete_outbound_types = sorted(set(str(item.get("type", "")) for item in outbounds if isinstance(item, dict) and str(item.get("type", "")).lower() in CONCRETE_SING_BOX_OUTBOUNDS))
        xray_outbound_protocols = sorted(set(str(item.get("protocol", "")) for item in outbounds if isinstance(item, dict) and item.get("protocol")))
        xray_endpoint_rows = egress_xray_endpoint_rows(parsed) if xray_outbound_protocols and not concrete_outbound_types else []
        xray_ready = sum(1 for row in xray_endpoint_rows if row.get("status") == "READY")
        protocol = "sing-box"
        if "vless" in concrete_outbound_types:
            protocol = "vless"
        elif "shadowsocks" in concrete_outbound_types:
            protocol = "shadowsocks_or_outline"
        elif concrete_outbound_types:
            protocol = concrete_outbound_types[0] if len(concrete_outbound_types) == 1 else "sing-box"
        elif xray_outbound_protocols:
            protocol = "xray_json"
        preview.update({"protocol": protocol, "runtime_mode": "sing_box" if concrete_outbound_types else "xray_json"})
        preview["detected_fields"] = {
            "json": "valid",
            "inbounds": inbound_count,
            "outbound_types": ", ".join(outbound_types) or "none",
            "concrete_outbound_types": ", ".join(concrete_outbound_types) or "none",
            "xray_outbound_protocols": ", ".join(xray_outbound_protocols) or "none",
            "xray_convertible_endpoints": str(xray_ready) if xray_outbound_protocols else "none",
        }
        preview["required"] = {"outbounds": "present" if (concrete_outbound_types or xray_outbound_protocols) else "missing"}
        if not concrete_outbound_types and not xray_outbound_protocols:
            preview["missing"].append("outbounds")
        if xray_outbound_protocols and not concrete_outbound_types:
            if xray_ready:
                preview["warnings"] = ["Xray/V2Ray JSON is recognized. Use endpoint preview to select one outbound and create a managed sing-box draft before runtime use."]
            else:
                preview["warnings"] = ["Xray/V2Ray JSON is recognized, but no convertible outbound was found. Supported Xray outbounds: vless, vmess, trojan, shadowsocks, socks, http."]
    elif re.search(r"(?im)^\s*(transport|server|endpoint)\s*:", raw):
        outline_rows = egress_outline_endpoint_rows(raw)
        if outline_rows:
            ready = sum(1 for row in outline_rows if row.get("status") == "READY")
            row = outline_rows[0]
            preview.update({"protocol": "shadowsocks_or_outline", "runtime_mode": "proxy_or_tun"})
            preview["detected_fields"] = {
                "yaml": "present",
                "outline": "present",
                "server": "present" if row.get("server") else "missing",
                "server_port": "present" if row.get("server_port") else "missing",
                "prefix": "blocked" if "outline_prefix_support" in row.get("missing", []) else "absent_or_not_required",
            }
            preview["required"] = {"outline_endpoint": "present" if ready else "missing"}
            preview["missing"] = [] if ready else row.get("missing", ["outline_endpoint"])
            if row.get("reason"):
                preview["warnings"] = [row.get("reason")]
        else:
            preview["missing"].append("known_protocol_signature")
    elif re.search(r"(?im)^\s*client\s*$", raw) and re.search(r"(?im)^\s*remote\s+\S+", raw):
        fields = _egress_preview_openvpn_fields(raw)
        preview.update({"protocol": "openvpn", "runtime_mode": "interface"})
        preview["detected_fields"] = {
            "client": "present" if fields["client"] else "missing",
            "remote": fields["remote"] or "missing",
            "proto": fields["proto"] or "default",
            "dev": fields["dev"] or "missing",
            "auth_material": "present" if (fields["auth_user_pass"] or (fields["cert"] and fields["key"])) else "missing",
            "redirect_gateway": "present" if fields["redirect_gateway"] else "not_configured",
            "pull_filter": "present" if fields["pull_filter"] else "not_configured",
            "scripts": "present" if fields["scripts"] else "absent",
        }
        required = {
            "client": fields["client"],
            "remote": bool(fields["remote"]),
            "dev": bool(fields["dev"]),
            "auth_material": bool(fields["auth_user_pass"] or (fields["cert"] and fields["key"])),
        }
        preview["required"] = {key: "present" if value else "missing" for key, value in required.items()}
        preview["missing"] = [key for key, value in required.items() if not value]
        preview["warnings"] = ["OpenVPN распознан. V7 запустит его только как управляемый канал: маршруты, DNS и скрипты будут нормализованы перед временной проверкой."]
        if fields["scripts"]:
            preview.setdefault("warnings", []).append("OpenVPN scripts/hooks were detected and must be reviewed manually before any runtime use.")
    elif re.search(r"(?im)^\s*proxies\s*:", raw) and re.search(r"(?im)^\s*proxy-groups\s*:", raw):
        preview.update({"protocol": "clash_yaml", "runtime_mode": "proxy_or_tun"})
        proxy_count = len(re.findall(r"(?m)^\s*-\s+name\s*:", raw))
        preview["detected_fields"] = {
            "yaml": "present",
            "proxies": "present",
            "proxy_groups": "present",
            "proxy_count_hint": proxy_count,
        }
        preview["required"] = {"proxies": "present", "proxy_groups": "present"}
        preview["warnings"] = ["Clash YAML can be inspected with the read-only Convert preview. Runtime and pool actions stay blocked until a single proxy is converted into a V7-managed sing-box draft."]
    else:
        sections = _egress_preview_ini_sections(raw)
        interface = sections.get("Interface", {})
        peer = sections.get("Peer", {})
        if interface and peer:
            awg_keys = {"Jc", "Jmin", "Jmax", "S1", "S2", "S3", "S4", "H1", "H2", "H3", "H4"}
            protocol = "amneziawg" if any(key in interface for key in awg_keys) else "wireguard"
            preview.update({"protocol": protocol, "runtime_mode": "interface"})
            preview["detected_fields"] = {
                "interface": "present",
                "peer": "present",
                "address": "present" if interface.get("Address") else "missing",
                "endpoint_host": (peer.get("Endpoint", "").rsplit(":", 1)[0] if peer.get("Endpoint") else ""),
                "table": interface.get("Table", ""),
            }
            required = {
                "Interface.PrivateMaterial": interface.get("PrivateKey"),
                "Interface.Address": interface.get("Address"),
                "Peer.PublicKey": peer.get("PublicKey"),
                "Peer.Endpoint": peer.get("Endpoint"),
            }
            preview["required"] = {key: "present" if value else "missing" for key, value in required.items()}
            preview["missing"] = [key for key, value in required.items() if not value]
            if protocol in ("wireguard", "amneziawg") and interface.get("Table", "").lower() != "off":
                preview["warnings"] = ["V7 will normalize this interface to Table = off in the isolated runtime copy because V7 owns routing."]
        else:
            preview["missing"].append("known_protocol_signature")

    if not preview.get("missing"):
        preview["validation"] = "detected_required_fields"
    elif preview.get("protocol") == "unknown":
        preview["validation"] = "draft_unknown"
    else:
        preview["validation"] = "needs_operator_fix"
    usage_policy = egress_usage_policy_from_data(data)
    preview["role"] = usage_policy["role"]
    preview["usage_policy"] = usage_policy
    return preview, None


def egress_qr_format_hint(text):
    raw = str(text or "").strip()
    unwrap = egress_unwrap_import_uri(raw)
    parsed = urlparse(raw)
    scheme = parsed.scheme.lower() if parsed.scheme else ""
    effective = unwrap["text"] if unwrap["unwrapped"] else raw
    effective_scheme = urlparse(effective).scheme.lower() if "://" in effective else ""
    if unwrap["unwrapped"] and effective_scheme:
        return f"{scheme}->{effective_scheme}"
    if scheme:
        return scheme
    if effective.startswith("{"):
        return "json"
    if re.search(r"(?im)^\s*client\s*$", effective):
        return "openvpn"
    if re.search(r"(?im)^\s*\[Interface\]\s*$", effective):
        return "wireguard"
    return "config_text"


def egress_qr_candidate_score(preview, error):
    if error or not isinstance(preview, dict):
        return -1000
    score = 0
    protocol = str(preview.get("protocol", "unknown"))
    runtime_mode = str(preview.get("runtime_mode", "unknown"))
    validation = str(preview.get("validation", ""))
    if validation == "detected_required_fields":
        score += 100
    if protocol != "unknown":
        score += 35
    if protocol in {"subscription_url", "subscription_list"}:
        score += 45
    if protocol in {
        "vless", "vmess", "trojan", "shadowsocks_or_outline", "wireguard",
        "amneziawg", "wireguard_uri", "openvpn", "sing-box", "xray_json",
        "clash_yaml",
    }:
        score += 45
    if runtime_mode in {"subscription", "proxy_or_tun", "sing_box", "interface"}:
        score += 15
    score -= len(preview.get("missing", []) or []) * 15
    return score


def egress_qr_preview_from_text_candidates(label, texts, data):
    candidates = []
    best = None
    best_score = -10000
    base = {
        "label": label,
        "role": data.get("role", "GLOBAL_FAST"),
        "priority": data.get("priority", ""),
        "weight": data.get("weight", ""),
        "soft_limit": data.get("soft_limit", ""),
        "hard_limit": data.get("hard_limit", ""),
        "service_tags": data.get("service_tags", ""),
        "exclude_route_classes": data.get("exclude_route_classes", ""),
        "manual_only": data.get("manual_only", ""),
        "reserve_only": data.get("reserve_only", ""),
    }
    seen = set()
    for raw_index, text in enumerate(texts):
        text = str(text or "").strip()
        if not text or text in seen:
            continue
        seen.add(text)
        unwrap = egress_unwrap_import_uri(text)
        effective_text = unwrap["text"]
        preview, error = egress_config_preview({**base, "config": effective_text})
        score = egress_qr_candidate_score(preview, error)
        candidate = {
            "index": raw_index,
            "length": len(text),
            "format_hint": egress_qr_format_hint(text),
            "status": "OK" if not error else "ERROR",
            "protocol": (preview or {}).get("protocol", ""),
            "runtime_mode": (preview or {}).get("runtime_mode", ""),
            "validation": (preview or {}).get("validation", ""),
            "wrappers": unwrap["wrappers"],
        }
        if error:
            candidate["error"] = error.get("error", "preview_failed")
        candidates.append(candidate)
        if score > best_score:
            best_score = score
            best = {
                "raw_index": raw_index,
                "text": effective_text,
                "preview": preview,
                "error": error,
                "candidate": candidate,
            }
    if not candidates:
        return None, {"error": "qr_decode_empty"}
    if not best or best.get("error") or best_score < 0:
        return None, {
            "error": "qr_payload_not_supported",
            "message": "QR decoded, but V7 did not find a supported VPN config or subscription payload.",
            "decoded": {
                "status": "UNSUPPORTED",
                "candidates": candidates,
                "secret_redaction": "decoded QR text is intentionally not returned",
            },
        }
    preview = dict(best["preview"])
    selected_text = best["text"]
    preview["source"] = "qr_upload"
    preview["decoded"] = {
        "status": "OK",
        "candidates": len(candidates),
        "selected_index": best["raw_index"],
        "length": len(selected_text),
        "format_hint": egress_qr_format_hint(selected_text),
        "secret_redaction": "decoded QR text is returned only as base64 for the admin form",
    }
    preview["qr_candidates"] = candidates
    preview["decoded_config_b64"] = base64.b64encode(selected_text.encode("utf-8")).decode("ascii")
    preview["pool_action"] = "preview_only_not_added"
    return preview, None


def egress_qr_preview(data):
    label = clean_identity_text(data.get("label", ""), 80) or "qr-egress"
    raw = str(data.get("image_b64", "") or "").strip()
    if not raw:
        return None, {"error": "qr_image_missing"}
    if "," in raw and raw.split(",", 1)[0].lower().startswith("data:image/"):
        raw = raw.split(",", 1)[1]
    try:
        blob = base64.b64decode(raw, validate=True)
    except Exception:
        return None, {"error": "invalid_qr_image_base64"}
    if len(blob) > 4 * 1024 * 1024:
        return None, {"error": "qr_image_too_large", "max_bytes": 4 * 1024 * 1024}
    decoder = shutil.which("zbarimg")
    if not decoder:
        return {
            "label": label,
            "status": "DECODER_MISSING",
            "message": "QR upload is ready in the UI, but the server has no local QR decoder installed yet.",
            "required_tool": "zbarimg",
            "pool_action": "preview_only_not_added",
            "next_step": "install_qr_decoder_or_paste_uri_manually",
        }, None
    suffix = ".png"
    fd, tmp_name = tempfile.mkstemp(prefix="v7-egress-qr-", suffix=suffix)
    tmp_path = Path(tmp_name)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(blob)
        os.chmod(tmp_path, 0o600)
        decoded = run_readonly([decoder, "--quiet", "--raw", str(tmp_path)], timeout=12)
    finally:
        try:
            tmp_path.unlink()
        except OSError:
            pass
    if decoded["rc"] != 0:
        return None, {"error": "qr_decode_failed", "detail": decoded.get("output", "")[-500:]}
    lines = [line.strip() for line in str(decoded.get("output", "")).splitlines() if line.strip()]
    if not lines:
        return None, {"error": "qr_decode_empty"}
    return egress_qr_preview_from_text_candidates(label, lines, data)


def egress_draft_id(label):
    base = safe_client_name(re.sub(r"[^A-Za-z0-9_.-]+", "-", str(label or "").lower()).strip("-")[:36]) or "egress-draft"
    return f"{base}-{int(time.time())}-{secrets.token_hex(3)}"


def egress_draft_lifecycle(metadata):
    metadata = metadata or {}
    validation = str(metadata.get("validation", ""))
    protocol = str(metadata.get("protocol", ""))
    pool_action = str(metadata.get("pool_action", "not_added"))
    runtime_profile_status = str(metadata.get("runtime_profile_status", ""))
    preflight_pass = metadata.get("last_preflight_status") == "PASS"
    runtime_pass = metadata.get("last_runtime_status") == "PASS"
    quarantine_pass = metadata.get("last_quarantine_status") == "PASS"
    pool_added = pool_action in {"added_disabled", "enabled"}
    profile_ready = runtime_profile_status == "READY"
    enabled_done = pool_action == "enabled"

    draft_step_label = "Внутренняя запись" if metadata.get("internal_import") or metadata.get("user_visible") is False else "Черновик"
    steps = [
        {"id": "detect", "label": "Распознавание", "status": "DONE" if validation else "ACTIVE", "detail": validation or "waiting for source"},
        {"id": "draft", "label": draft_step_label, "status": "DONE", "detail": metadata.get("status", "draft")},
        {"id": "preflight", "label": "Проверка без запуска", "status": "DONE" if preflight_pass else "WAITING", "detail": metadata.get("last_preflight_status", "")},
        {"id": "runtime", "label": "Временный тест", "status": "DONE" if runtime_pass else "WAITING", "detail": metadata.get("last_runtime_status", "")},
        {"id": "quarantine", "label": "Изолированная проверка", "status": "DONE" if quarantine_pass else "WAITING", "detail": metadata.get("last_quarantine_status", "")},
        {"id": "add_disabled", "label": "Добавить выключенным", "status": "DONE" if pool_added else "WAITING", "detail": pool_action},
        {"id": "provision", "label": "Рабочий профиль", "status": "DONE" if profile_ready else "WAITING", "detail": runtime_profile_status},
        {"id": "enable", "label": "Включение", "status": "DONE" if enabled_done else "WAITING", "detail": "enabled" if enabled_done else "separate guarded action"},
    ]

    blockers = []
    next_action = "run_preflight"
    next_label = "Запустить проверку без запуска"
    if validation == "draft_unknown" or protocol == "unknown":
        next_action = "fix_or_replace_config"
        next_label = "Исправить конфиг"
        blockers.append("protocol_unknown")
    elif validation == "needs_operator_fix":
        next_action = "fix_required_fields"
        next_label = "Заполнить обязательные поля"
        blockers.append("required_fields_missing")
    elif protocol == "openvpn" and validation == "detected_required_fields" and not preflight_pass:
        next_action = "run_preflight"
        next_label = "Запустить проверку без запуска"
    elif protocol == "clash_yaml":
        next_action = "clash_convert_preview"
        next_label = "Подготовить прокси из Clash"
        blockers.append("clash_yaml_must_create_child_proxy_draft")
    elif protocol in ("subscription_url", "subscription_list", "xray_json"):
        next_action = "expand_or_convert_config"
        next_label = "Развернуть в управляемый черновик"
        blockers.append(f"{protocol}_adapter_required")
    elif not preflight_pass:
        next_action = "run_preflight"
        next_label = "Запустить проверку без запуска"
    elif not runtime_pass:
        next_action = "run_runtime"
        next_label = "Запустить временный тест"
    elif not quarantine_pass:
        next_action = "run_quarantine"
        next_label = "Запустить карантин"
    elif not pool_added:
        next_action = "add_disabled"
        next_label = "Добавить выключенным"
    elif not profile_ready:
        next_action = "provision_runtime_profile"
        next_label = "Подготовить рабочий профиль"
    elif not enabled_done:
        next_action = "enable_ready"
        next_label = "Готов к защищённому включению"
    else:
        next_action = "enabled_complete"
        next_label = "Включён"

    active_seen = False
    for step in steps:
        if step["status"] == "WAITING" and not active_seen:
            step["status"] = "ACTIVE" if not blockers else "BLOCKED"
            active_seen = True
        elif blockers and step["status"] == "WAITING":
            step["status"] = "BLOCKED"

    return {
        "current": next_action,
        "next_action": next_action,
        "next_label": next_label,
        "blockers": blockers,
        "complete": profile_ready,
        "steps": steps,
    }


def egress_draft_path(draft_id):
    draft_id = safe_draft_id(draft_id)
    if not draft_id:
        return None
    path_obj = (EGRESS_DRAFTS_DIR / draft_id).resolve()
    root_resolved = EGRESS_DRAFTS_DIR.resolve()
    if root_resolved not in path_obj.parents:
        return None
    return path_obj


def egress_draft_create(data, actor):
    text = str(data.get("config", "") or "")
    preview, error = egress_config_preview(data)
    if error:
        return None, error
    validation = preview.get("validation", "")
    draft_id = egress_draft_id(preview.get("label") or preview.get("protocol") or "egress")
    draft_dir = egress_draft_path(draft_id)
    if not draft_dir:
        return None, {"error": "invalid_draft_path"}
    EGRESS_DRAFTS_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(EGRESS_DRAFTS_DIR, 0o700)
    draft_dir.mkdir(parents=True, exist_ok=False)
    os.chmod(draft_dir, 0o700)
    config_path = draft_dir / "config.input"
    metadata_path = draft_dir / "metadata.json"
    config_hash = hashlib.sha256(text.encode("utf-8")).hexdigest()
    usage_policy = egress_usage_policy_from_data(data, preview.get("usage_policy", {}))
    organization_scope = egress_organization_scope_from_data(data)
    write_text_atomic(config_path, text if text.endswith("\n") else text + "\n", mode=0o600)
    metadata = {
        "id": draft_id,
        "label": preview.get("label") or draft_id,
        "status": "draft_unknown" if validation == "draft_unknown" else "draft_incomplete" if validation != "detected_required_fields" else "draft",
        "created_at": now_iso(),
        "created_by": actor or "admin",
        "protocol": preview.get("protocol", "unknown"),
        "runtime_mode": preview.get("runtime_mode", "unknown"),
        "validation": validation,
        "missing": preview.get("missing", []),
        "warnings": preview.get("warnings", []),
        "detected_fields": preview.get("detected_fields", {}),
        "config_sha256": config_hash,
        "config_path": str(config_path),
        "role": usage_policy["role"],
        "priority": usage_policy["priority"],
        "weight": usage_policy["weight"],
        "soft_limit": usage_policy["soft_limit"],
        "hard_limit": usage_policy["hard_limit"],
        "manual_only": usage_policy["manual_only"],
        "reserve_only": usage_policy["reserve_only"],
        "service_tags": usage_policy["service_tags"],
