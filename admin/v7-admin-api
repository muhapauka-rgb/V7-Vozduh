            "person_exists": bool(user),
            "phone_allowed": bool(allowed),
            "organization_exists": bool(organization),
        }
        preflight = run_action(["v7-user-create-from-ipam", "--name", client_name, "--device", device_type, "--egress", egress], actor, timeout=30)
        result = "OK" if preflight.get("rc") == 0 else "FAIL"
        audit_admin(
            actor,
            "admin_action_identity_config_issue_quick_preview",
            f"phone={phone} client={vpn_client} mode={mode} preflight={result.lower()}",
            object_type="identity_user",
            object_id=user.get("id", ""),
            result=result,
        )
        if preflight.get("rc") != 0:
            return {"action": "identity_config_issue_quick_preview", "planned": planned, "preflight": preflight}, {"error": "provisioning_preflight_failed"}, 500
        return {
            "action": "identity_config_issue_quick_preview",
            "planned": planned,
            "preflight": preflight,
            "profile": {
                "adapter": adapter,
                "mode": mode,
                "ready": False,
                "download_url": None,
                "delivery_url": None,
            },
            "quick_issue": {
                "phone": phone,
                "display_name": display_name or phone,
                "organization_name": organization_name,
                "identity_user_id": user.get("id", ""),
                "dedupe_key": "phone_normalized",
                "existing_person_reused": bool(user),
                "operator_status": operator_status,
            },
            "identity": identity_state(),
        }, None, 200
    org_id = ""
    organization = {}
    with identity_conn() as conn:
        conn.executescript(IDENTITY_SCHEMA)
        org_id = identity_ensure_organization(conn, organization_name) if organization_name else ""
        if org_id:
            organization = dict(conn.execute("SELECT * FROM organizations WHERE id=?", (org_id,)).fetchone())
        conn.commit()
    allowed, allowed_error = identity_upsert_allowed_phone({
        "phone": phone,
        "expected_name": display_name,
        "organization_id": org_id,
        "note": clean_identity_text(data.get("note") or "Выдано оператором из раздела пользователей", 500),
        "is_active": 1,
    })
    if allowed_error:
        return None, allowed_error, 400
    user, user_error = identity_get_or_create_user(phone, display_name, allowed or {}, organization or {})
    if user_error:
        return None, user_error, 400
    with identity_conn() as conn:
        conn.executescript(IDENTITY_SCHEMA)
        identity_migrate_db(conn)
        current = conn.execute("SELECT operator_status FROM identity_users WHERE id=?", (user.get("id"),)).fetchone()
        current_status = (current["operator_status"] if current else "") or ""
        next_operator_status = operator_status or current_status
        if display_name and current_status == "no_data":
            next_operator_status = ""
        if next_operator_status != current_status:
            conn.execute(
                "UPDATE identity_users SET operator_status=?, updated_at=? WHERE id=?",
                (next_operator_status, now_iso(), user.get("id")),
            )
            conn.commit()
            user = dict(conn.execute("SELECT * FROM identity_users WHERE id=?", (user.get("id"),)).fetchone())
    payload, error, status = identity_issue_device({
        "user_id": user.get("id"),
        "vpn_client": vpn_client,
        "device_type": device_type,
        "mode": mode,
        "egress": egress,
        "dry_run": dry_run,
    }, actor)
    if error:
        return payload, error, status
    payload = payload or {}
    payload["quick_issue"] = {
        "phone": phone,
        "display_name": display_name or phone,
        "organization_name": organization_name,
        "identity_user_id": user.get("id"),
        "dedupe_key": "phone_normalized",
        "existing_person_reused": bool(user.get("created_at") and user.get("created_at") != user.get("updated_at")),
        "operator_status": user.get("operator_status") or operator_status,
    }
    audit_admin(
        actor,
        "admin_action_identity_config_issue_quick",
        f"user_id={user.get('id')} phone={phone} client={vpn_client} mode={mode} dry_run={str(dry_run).lower()}",
        object_type="identity_user",
        object_id=user.get("id", ""),
        result="OK",
    )
    return payload, None, status


def pending_profile_public_key(client_name):
    name = safe_client_name(client_name)
    if not name:
        return ""
    path = CLIENT_ROOT / name / "public.key"
    try:
        return path.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return ""


def pending_profile_row_by_ref(conn, data):
    pending_id = safe_identity_id(data.get("pending_id") or data.get("id") or "")
    ip = safe_user_ip(data.get("ip") or data.get("reserved_ip") or "")
    row = None
    if pending_id:
        row = conn.execute("SELECT * FROM pending_profiles WHERE id=?", (pending_id,)).fetchone()
    if not row and ip:
        row = conn.execute("SELECT * FROM pending_profiles WHERE reserved_ip=?", (ip,)).fetchone()
    return dict(row) if row else None


def pending_profile_create(data, actor):
    if admin_safe_mode_enabled():
        return None, {"error": "safe_mode_enabled", "message": "Safe mode allows diagnostics only."}, 423
    identity_init_db()
    dry_run = bool(data.get("dry_run", False))
    device_type = clean_identity_text(data.get("device_type") or data.get("device") or "iphone", 60) or "iphone"
    device_slug = re.sub(r"[^a-z0-9_.-]+", "-", device_type.lower()).strip("-") or "device"
    vpn_client = safe_connect_client(data.get("vpn_client") or data.get("client") or "karing")
    if not vpn_client or not connect_client_supported(vpn_client):
        return None, {"error": "unsupported_vpn_client", "supported": sorted(SUPPORTED_CONNECT_CLIENTS)}, 400
    client_meta = CONNECT_CLIENTS.get(vpn_client, CONNECT_CLIENTS["karing"])
    adapter = safe_smart_adapter(client_meta.get("adapter") or vpn_client)
    mode = safe_smart_mode(data.get("mode") or "RU_LOCAL") or "RU_LOCAL"
    egress = safe_egress_id(data.get("egress", "")) or default_egress_id()
    if not adapter:
        return None, {"error": "invalid_smart_adapter", "supported": sorted(SUPPORTED_SMART_ADAPTERS)}, 400
    if not mode:
        return None, {"error": "invalid_smart_mode", "supported": sorted(SUPPORTED_SMART_MODES)}, 400
    if not egress_exists(egress, enabled_only=True):
        return None, {"error": "invalid_egress"}, 400
    client_name = safe_client_name(data.get("client_name", "")) or safe_client_name(f"quick-{secrets.token_hex(4)}-{device_slug}") or f"quick-{secrets.token_hex(3)}"
    planned = {
        "client_name": client_name,
        "vpn_client": vpn_client,
        "adapter": adapter,
        "mode": mode,
        "device_type": device_type,
        "egress": egress,
        "ttl_seconds": PENDING_PROFILE_TTL_SECONDS,
        "dedupe": "после первого подключения можно привязать к человеку, до подключения это временный код",
    }
    preflight = run_action(["v7-user-create-from-ipam", "--name", client_name, "--device", device_type, "--egress", egress], actor, timeout=30)
    if preflight.get("rc") != 0:
        audit_admin(actor, "admin_action_pending_profile_preview", f"client={vpn_client} mode={mode} preflight=fail", object_type="pending_profile", object_id="", result="FAIL")
        return {"action": "pending_profile_preview", "planned": planned, "preflight": preflight}, {"error": "provisioning_preflight_failed"}, 500
    if dry_run:
        audit_admin(actor, "admin_action_pending_profile_preview", f"client={vpn_client} mode={mode}", object_type="pending_profile", object_id="", result="OK")
        return {"action": "pending_profile_preview", "planned": planned, "preflight": preflight, "identity": identity_state()}, None, 200

    created = run_action([
        "v7-user-create-from-ipam",
        "--name", client_name,
        "--device", device_type,
        "--egress", egress,
        "--apply",
        "--confirm", "CREATE_IPAM_USER",
    ], actor, timeout=70)
    parsed = parse_command_kv(created.get("output", ""))
    ip = safe_user_ip(parsed.get("ip", ""))
    if created.get("rc") != 0 or not ip:
        audit_admin(actor, "admin_action_pending_profile_create", f"client={vpn_client} mode={mode} create=fail", object_type="pending_profile", object_id="", result="FAIL")
        return {"planned": planned, "preflight": preflight, "created": created, "parsed": parsed}, {"error": "pending_profile_create_failed"}, 500

    artifact_name = safe_client_name(parsed.get("name", "")) or client_name
    conf = wg_conf_for_user_ip(ip)
    output = smart_client_profile_path(artifact_name, adapter, mode)
    proxy_identity = {"rc": 0, "output": "not_required"}
    cleanup_error = None
    def rollback_created_slot(reason):
        rollback, rollback_error = user_delete_apply(ip, actor, "DELETE_USER")
        audit_admin(
            actor,
            "admin_action_pending_profile_create",
            f"ip={ip} reason={reason} rollback_error={rollback_error.get('error') if isinstance(rollback_error, dict) else ''}",
            object_type="pending_profile",
            object_id=ip,
            result="FAIL",
        )
        return {"rollback": rollback, "rollback_error": rollback_error}
    try:
        if adapter == "happ":
            proxy_identity = run_action([
                "v7-proxy-identity-bind",
                "--inbound-id", "happ-test",
                "--user-ip", ip,
                "--client", "happ",
                "--label", artifact_name,
                "--apply",
                "--confirm", "CREATE_PROXY_IDENTITY_BINDING",
            ], actor, timeout=25)
            if proxy_identity.get("rc") != 0:
                rollback = rollback_created_slot("proxy_identity_bind_failed")
                return {"planned": planned, "preflight": preflight, "created": created, "parsed": parsed, "proxy_identity": proxy_identity, **rollback}, {"error": "proxy_identity_bind_failed"}, 500

        if adapter_uses_karing_vless(adapter):
            proxy_identity, generated = generate_karing_vless_profile(ip, artifact_name, mode, output, actor)
            if proxy_identity.get("rc") != 0:
                rollback = rollback_created_slot("proxy_identity_bind_failed")
                return {"planned": planned, "preflight": preflight, "created": created, "parsed": parsed, "proxy_identity": proxy_identity, **rollback}, {"error": "proxy_identity_bind_failed"}, 500
        elif adapter_uses_karing_wg(adapter):
            generated = generate_karing_wg_endpoint_profile(ip, artifact_name, mode, output, conf, actor)
        else:
            cmd = [
                "v7-smart-client-profile-generate",
                "--adapter", adapter,
                "--mode", mode,
                "--user-ip", ip,
                "--name", artifact_name,
                "--output", str(output),
            ]
            if conf:
                cmd.extend(["--wg-conf", str(conf)])
            generated = run_action(cmd, actor, timeout=35)
        if generated.get("rc") != 0:
            rollback = rollback_created_slot("smart_profile_failed")
            return {"planned": planned, "preflight": preflight, "created": created, "parsed": parsed, "generated": generated, **rollback}, {"error": "smart_profile_failed"}, 500
        if adapter == "happ":
            check = {"rc": 0, "output": "подписка VLESS создана"}
        else:
            check = run_action(["sing-box", "check", "-c", str(output)], actor, timeout=20)
        check = normalize_smart_profile_check(check, adapter)
        if check.get("rc") != 0:
            rollback = rollback_created_slot("smart_profile_validation_failed")
            return {"planned": planned, "preflight": preflight, "created": created, "parsed": parsed, "generated": generated, "check": check, **rollback}, {"error": "smart_profile_validation_failed"}, 500

        delivery, delivery_error = create_profile_delivery(ip, adapter, mode, actor, ttl_seconds=PENDING_PROFILE_TTL_SECONDS)
        if delivery_error:
            rollback = rollback_created_slot("profile_delivery_failed")
            return {"planned": planned, "preflight": preflight, "created": created, "parsed": parsed, "generated": generated, "check": check, **rollback}, delivery_error, 500
        now = now_iso()
        pending_id = identity_id("pp")
        expires_epoch = float(delivery.get("expires_at_epoch") or (time.time() + PENDING_PROFILE_TTL_SECONDS))
        expires_at = datetime.fromtimestamp(expires_epoch, timezone.utc).isoformat()
        table = int(parsed.get("table") or 0)
        still_reserved_status = ""
        with identity_conn() as conn:
            identity_refresh_pending_profiles(conn)
            conn.execute(
                "DELETE FROM pending_profiles WHERE reserved_ip=? AND status IN ('expired','failed','revoked')",
                (ip,),
            )
            still_reserved = conn.execute(
                "SELECT id, status FROM pending_profiles WHERE reserved_ip=?",
                (ip,),
            ).fetchone()
            if still_reserved:
                still_reserved_status = still_reserved["status"]
                conn.commit()
        if still_reserved_status:
            rollback = rollback_created_slot("pending_profile_ip_still_reserved")
            return {
                "planned": planned,
                "preflight": preflight,
                "created": created,
                "parsed": parsed,
                **rollback,
            }, {"error": "pending_profile_ip_still_reserved", "status": still_reserved_status}, 409
        with identity_conn() as conn:
            conn.execute(
                """
                INSERT INTO pending_profiles
                  (id, public_key, reserved_ip, route_table, client_name, device_type, vpn_client, adapter, route_mode, egress,
                   delivery_id, status, created_at, updated_at, expires_at, expires_at_epoch, created_by, note)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', ?, ?, ?, ?, ?, ?)
                """,
                (
                    pending_id,
                    pending_profile_public_key(artifact_name),
                    ip,
                    table,
                    artifact_name,
                    device_type,
                    vpn_client,
                    adapter,
                    mode,
                    parsed.get("egress") or egress,
                    delivery.get("delivery_id", ""),
                    now,
                    now,
                    expires_at,
                    expires_epoch,
                    actor or "admin",
                    clean_identity_text(data.get("note") or "Быстрый код без анкеты. Станет полноценным после первого подключения.", 500),
                ),
            )
            conn.commit()
            pending = dict(conn.execute("SELECT * FROM pending_profiles WHERE id=?", (pending_id,)).fetchone())
        audit_admin(actor, "admin_action_pending_profile_create", f"id={pending_id} ip={ip} client={vpn_client} mode={mode}", object_type="pending_profile", object_id=pending_id, result="OK")
        return {
            "action": "pending_profile_create",
            "planned": planned,
            "preflight": preflight,
            "created": created,
            "parsed": parsed,
            "generated": generated,
            "check": check,
            "proxy_identity": proxy_identity,
            "pending_profile": pending,
            "profile": {
                "client": artifact_name,
                "adapter": adapter,
                "mode": mode,
                "ready": output.exists(),
                "validation": smart_profile_validation(output, adapter, mode) if output.exists() else {"status": "MISSING"},
                "download_url": f"/api/smart-client-profile?ip={ip}&adapter={adapter}&mode={mode}" if output.exists() else None,
                "wireguard_artifacts": client_artifacts_for_ip(ip),
                "delivery_url": delivery.get("url"),
                "qr_url": delivery.get("qr_url"),
                "import_url": delivery.get("import_url"),
                "import_qr_url": delivery.get("import_qr_url"),
                "download_qr_url": delivery.get("download_qr_url"),
                "ttl_seconds": delivery.get("ttl_seconds"),
                "expires_at_epoch": delivery.get("expires_at_epoch"),
                "proxy_identity_ready": proxy_identity.get("rc") == 0,
                "proxy_runtime_refresh_required": adapter == "happ",
            },
            "identity": identity_state(),
        }, None, 200
    finally:
        if "generated" not in locals() or (isinstance(locals().get("generated"), dict) and locals().get("generated", {}).get("rc") != 0):
            pass
        if cleanup_error:
            pass


def pending_profile_activate_check(data, actor):
    identity_init_db()
    with identity_conn() as conn:
        row = pending_profile_row_by_ref(conn, data)
        if not row:
            return None, {"error": "pending_profile_not_found"}, 404
        if row.get("status") == "activated":
            return {"action": "pending_profile_activate_check", "activated": True, "pending_profile": row, "identity": identity_state()}, None, 200
        if row.get("status") != "pending":
            return {"action": "pending_profile_activate_check", "activated": False, "pending_profile": row}, {"error": f"pending_profile_{row.get('status')}"}, 409
        handshake = wg_handshake_state(row.get("reserved_ip", ""))
        if handshake.get("recent"):
            now = now_iso()
            conn.execute(
                "UPDATE pending_profiles SET status='activated', activated_at=?, updated_at=? WHERE id=?",
                (now, now, row["id"]),
            )
            conn.execute(
                """
                INSERT INTO user_metadata (ip, display_name, phone_normalized, organization_name, device_name, notes, created_at, updated_at)
                VALUES (?, ?, '', '', ?, ?, ?, ?)
                ON CONFLICT(ip) DO UPDATE SET
                  display_name=excluded.display_name,
                  device_name=excluded.device_name,
                  notes=excluded.notes,
                  updated_at=excluded.updated_at
                """,
                (
                    row.get("reserved_ip", ""),
                    row.get("client_name") or row.get("reserved_ip", ""),
                    row.get("device_type", ""),
                    "Активирован быстрый код без анкеты. Данные можно заполнить в карточке пользователя.",
                    now,
                    now,
                ),
            )
            conn.commit()
            row = dict(conn.execute("SELECT * FROM pending_profiles WHERE id=?", (row["id"],)).fetchone())
            audit_admin(actor, "admin_action_pending_profile_activate", f"id={row['id']} ip={row.get('reserved_ip')}", object_type="pending_profile", object_id=row["id"], result="OK")
            return {"action": "pending_profile_activate_check", "activated": True, "handshake": handshake, "pending_profile": row, "identity": identity_state()}, None, 200
    return {"action": "pending_profile_activate_check", "activated": False, "handshake": handshake, "pending_profile": row, "message": "Первого подключения ещё не было."}, None, 200


def pending_profile_expire(data, actor):
    if admin_safe_mode_enabled():
        return None, {"error": "safe_mode_enabled", "message": "Safe mode allows diagnostics only."}, 423
    identity_init_db()
    with identity_conn() as conn:
        row = pending_profile_row_by_ref(conn, data)
        if not row:
            return None, {"error": "pending_profile_not_found"}, 404
        if row.get("status") == "activated":
            return {"pending_profile": row}, {"error": "pending_profile_already_activated", "message": "Код уже стал реальным пользователем. Удаляйте его из карточки пользователя."}, 409
        ip = safe_user_ip(row.get("reserved_ip", ""))
    deleted, delete_error = user_delete_apply(ip, actor, "DELETE_USER")
    if delete_error and delete_error.get("error") != "user_ip_already_free":
        return {"pending_profile": row, "delete": deleted}, delete_error, 500
    now = now_iso()
    with identity_conn() as conn:
        conn.execute(
            "UPDATE pending_profiles SET status='expired', expired_at=?, updated_at=? WHERE id=?",
            (now, now, row["id"]),
        )
        conn.commit()
        row = dict(conn.execute("SELECT * FROM pending_profiles WHERE id=?", (row["id"],)).fetchone())
    audit_admin(actor, "admin_action_pending_profile_expire", f"id={row['id']} ip={ip}", object_type="pending_profile", object_id=row["id"], result="OK", severity="warning")
    return {"action": "pending_profile_expire", "pending_profile": row, "delete": deleted, "identity": identity_state()}, None, 200


def identity_update_user(data, actor):
    identity_init_db()
    user_id = safe_identity_id(data.get("user_id", ""))
    if not user_id:
        return None, {"error": "invalid_identity_user_id"}
    allowed_statuses = {"active", "blocked", "pending", "disabled"}
    with identity_conn() as conn:
        row = conn.execute("SELECT * FROM identity_users WHERE id=?", (user_id,)).fetchone()
        if not row:
            return None, {"error": "identity_user_not_found"}
        user = dict(row)
        active_devices = int(conn.execute(
            "SELECT count(*) FROM devices WHERE user_id=? AND status='active'",
            (user_id,),
        ).fetchone()[0])
        updates = {}
        if "max_devices" in data:
            try:
                max_devices = int(data.get("max_devices"))
            except (TypeError, ValueError):
                return None, {"error": "invalid_max_devices"}
            if max_devices < 0 or max_devices > 1000:
                return None, {"error": "invalid_max_devices_range"}
            if max_devices < active_devices and data.get("confirm") != "LOWER_DEVICE_LIMIT":
                return None, {
                    "error": "lower_device_limit_requires_confirm",
                    "message": "User already has more active devices than the new limit. Existing devices will not be removed automatically.",
                    "active_devices": active_devices,
                    "requested_max_devices": max_devices,
                    "confirm": "LOWER_DEVICE_LIMIT",
                }
            updates["max_devices"] = max_devices
        if "status" in data:
            status = clean_identity_text(data.get("status", ""), 20).lower()
            if status not in allowed_statuses:
                return None, {"error": "invalid_user_status", "allowed": sorted(allowed_statuses)}
            updates["status"] = status
        if "notes" in data:
            updates["notes"] = clean_identity_text(data.get("notes", ""), 800)
        if not updates:
            return user, None
        updates["updated_at"] = now_iso()
        assignments = ", ".join(f"{key}=?" for key in updates)
        conn.execute(
            f"UPDATE identity_users SET {assignments} WHERE id=?",
            (*updates.values(), user_id),
        )
        conn.commit()
