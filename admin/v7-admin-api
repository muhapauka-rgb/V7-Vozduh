            """,
            (session_id, idem, normalize_phone(phone), clean_identity_text(entered_name, 160), clean_identity_text(org_input, 160), job_id, ip_address, user_agent, now, now),
        )
        conn.execute(
            """
            INSERT INTO provisioning_jobs
              (id, session_id, status, action, result_json, error, created_at, updated_at)
            VALUES (?, ?, 'queued', 'public_connect_onboard', '{}', '', ?, ?)
            """,
            (job_id, session_id, now, now),
