    if state not in CLOSURE_STATES:
        return None, {"error": "invalid_closure_state", "allowed": sorted(CLOSURE_STATES)}, 400
    if state in {"CLOSED", "VERIFIED", "EXPIRED"} and not reason:
        return None, {"error": "closure_reason_required"}, 400
    row = {
        "object_type": object_type,
        "object_id": object_id,
        "closure_state": state,
        "closure_reason": reason,
        "closure_actor": safe_admin_username(actor) or "admin",
