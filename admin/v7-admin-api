def egress_free_local_port():
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.bind(("127.0.0.1", 0))
        return int(sock.getsockname()[1])


def egress_draft_proxy_runtime_text(raw, listen_port):
    if str(raw or "").strip().startswith("{"):
        try:
            parsed_config = json.loads(raw)
        except json.JSONDecodeError as exc:
            return None, {"error": "invalid_json_config", "detail": str(exc)}
        outbounds = parsed_config.get("outbounds", []) if isinstance(parsed_config, dict) else []
        outbound = next((
            item for item in outbounds
            if isinstance(item, dict) and str(item.get("type", "")).lower() in CONCRETE_SING_BOX_OUTBOUNDS
        ), None)
        if not outbound:
            outline_rows = egress_outline_endpoint_rows(raw)
            ready = next((row for row in outline_rows if row.get("status") == "READY" and row.get("outbound")), None)
            outbound = ready.get("outbound") if ready else None
        if not outbound:
            return None, {"error": "sing_box_outbound_not_found"}
        outbound = dict(outbound)
        outbound["tag"] = "egress"
    elif re.search(r"(?im)^\s*(transport|server|endpoint)\s*:", str(raw or "")):
        outline_rows = egress_outline_endpoint_rows(raw)
        ready = next((row for row in outline_rows if row.get("status") == "READY" and row.get("outbound")), None)
        if not ready:
            blocked = outline_rows[0] if outline_rows else {}
            return None, {"error": "outline_config_not_ready", "missing": blocked.get("missing", []), "reason": blocked.get("reason", "")}
        outbound = dict(ready.get("outbound") or {})
        outbound["tag"] = "egress"
    else:
        parsed_share, share_error = egress_parse_proxy_share(raw)
        if share_error:
            return None, share_error
        outbound = dict(parsed_share.get("outbound") or {})
        outbound["tag"] = "egress"
    return json.dumps(egress_sing_box_profile_from_outbound(outbound, listen_port), ensure_ascii=True, indent=2), None


def egress_draft_parse_curl_http_metrics(output):
    text = str(output or "").strip()
    matches = re.findall(r"(?m)(?:^|\s)((?:[0-9]{3}|000))\s+([0-9.]+)\s+([0-9.]+)\s*$", text)
    if not matches:
        parts = text.split()
        return (parts[0] if parts else "", parts[1] if len(parts) > 1 else "", parts[2] if len(parts) > 2 else "")
    return matches[-1]


def egress_draft_service_check_row(service_id, meta, url, curl_result, started):
    output = str(curl_result.get("output", "") or "").strip()
    http_code, first_byte, total = egress_draft_parse_curl_http_metrics(output)
    limited = http_code in HTTP_REACHABLE_CODES
    ok = curl_result.get("rc") == 0 and (http_code.startswith(("2", "3")) or http_code == "000")
    reachable = ok or limited
    reason = ""
    if limited:
        reason = f"HTTP {http_code}: сервис достигнут, но вернул ограничение приложения/CDN"
    elif not reachable:
        reason = output[-500:]
    return {
        "label": meta.get("label", service_id),
        "url": url,
        "ok": reachable,
        "status": "HTTP_LIMITED" if limited else ("OK" if ok else "FAIL"),
        "severity": "WARN" if limited else ("OK" if ok else "FAIL"),
        "http_reachable": reachable,
        "limited": limited,
        "http_code": http_code,
        "first_byte_sec": first_byte,
        "total_sec": total,
        "rc": curl_result.get("rc"),
        "elapsed_sec": round(time.time() - started, 3),
        "error": reason,
        "reason": reason,
    }


def egress_draft_proxy_service_matrix(listen_port, role, duration):
    role = safe_egress_role(role or "GLOBAL_FAST")
    service_ids = ROUTE_CLASS_SERVICE_MAP.get(role) or ROUTE_CLASS_SERVICE_MAP.get("GLOBAL_FAST", ())
    services = {}
    timeout = max(4, min(int(duration or 8), 12))
    for service_id in service_ids:
        meta = SERVICE_CATALOG.get(service_id, {})
        url = meta.get("url")
        if not url:
            continue
        started = time.time()
        curl_result = run_readonly([
            "curl",
            "--socks5-hostname", f"127.0.0.1:{listen_port}",
            "-A", HTTP_USER_AGENT,
            "-L",
            "-o", "/dev/null",
            "-w", "%{http_code} %{time_starttransfer} %{time_total}",
            "--max-time", str(timeout),
            "-fsS",
            url,
        ], timeout=timeout + 4)
        services[service_id] = egress_draft_service_check_row(service_id, meta, url, curl_result, started)
    ok_count = sum(1 for row in services.values() if row.get("ok"))
    total_count = len(services)
    status = "PASS" if total_count and ok_count == total_count else ("WARN" if ok_count else "FAIL")
    return {
        "status": status,
        "role": role,
        "ok_count": ok_count,
        "total": total_count,
        "services": services,
        "mode": "temporary_proxy_service_matrix",
    }


