def execution_store_consistency():
    contracts = execution_contracts()
    events = execution_events()
    ids = [item.get("contract_id") for item in contracts if item.get("contract_id")]
    duplicates = sorted({item for item in ids if ids.count(item) > 1})
    contract_ids = set(ids)
    orphan_events = [event for event in events if event.get("contract_id") and event.get("contract_id") not in contract_ids]
    invalid_contracts = []
    for contract in contracts:
        issues = []
        if not contract.get("contract_id"):
            issues.append("missing_contract_id")
        if not contract.get("rollback_manifest"):
            issues.append("rollback_manifest_missing")
        if contract.get("movement_budget", 0) < len(contract.get("affected_users") or []):
            issues.append("movement_budget_lt_user_count")
        if contract.get("blast_radius", 0) < len(contract.get("affected_users") or []):
            issues.append("blast_radius_lt_user_count")
        if issues:
            invalid_contracts.append({"contract_id": contract.get("contract_id", ""), "issues": issues})
    if invalid_contracts or duplicates:
        status = "FAILED_CLOSED"
    elif orphan_events:
        status = "WARN"
    elif contracts or events:
        status = "OK"
    else:
        status = "EMPTY"
    return {
        "status": status,
        "contracts_count": len(contracts),
        "events_count": len(events),
        "duplicate_contract_ids": duplicates,
        "orphan_events_count": len(orphan_events),
        "orphan_events": orphan_events[:20],
        "invalid_contracts": invalid_contracts[:20],
        "store_exists": EXECUTION_CONTRACTS_FILE.exists(),
        "event_store_exists": EXECUTION_EVENTS_FILE.exists(),
        "fail_closed": status == "FAILED_CLOSED",
        "read_only": True,
    }


