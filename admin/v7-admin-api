def direct_routing_full(domains=None, user_ip=""):
    users = parse_registry(STATE_DIR / "users.registry")
    user_ip = safe_user_ip(user_ip) or default_active_user_ip(users)
    cleaned = direct_routing_sample_domains(domains)
    freshness = direct_routing_freshness(cleaned, user_ip=user_ip)
    freshness_by_domain = {item.get("domain"): item for item in freshness.get("items", [])}

    items = []
    for domain in cleaned[:12]:
        result = run_readonly(["v7-safe-run", "v7-direct-diagnose-domain", domain, user_ip], timeout=14)
        parsed = parse_command_kv(result.get("output", ""))
        route_ok = parsed.get("DIRECT_ROUTE") == "OK"
        https = parsed.get("SERVER_HTTPS", "")
        outcome = parsed.get("V7_DIRECT_DOMAIN_RESULT", "")
        fresh = freshness_by_domain.get(domain, {})
        freshness_status = fresh.get("status", "")
        if freshness_status in ("STALE_SET", "ROUTE_MISMATCH"):
            level = "bad"
        elif outcome == "OK":
            level = "ok"
        elif route_ok and https in ("TIMEOUT", "FAIL"):
            level = "warning"
        else:
            level = "bad"
        items.append({
            "domain": domain,
            "level": level,
            "route_ok": route_ok,
            "server_https": https,
            "result": outcome,
            "freshness": fresh,
            "freshness_status": freshness_status,
            "plain": fresh.get("plain") or ("категория готова идти напрямую" if level == "ok" else "нужна проверка прямого маршрута"),
            "parsed": parsed,
            "check": result,
        })
    return {
        "updated": now_iso(),
        "user_ip": user_ip,
        "domains": cleaned,
        "items": items,
        "freshness": freshness,
        "stale_count": freshness.get("stale_count", 0),
        "stale_domains": freshness.get("stale_domains", []),
        "ok_count": sum(1 for item in items if item["level"] == "ok"),
        "warning_count": sum(1 for item in items if item["level"] == "warning"),
        "bad_count": sum(1 for item in items if item["level"] == "bad"),
    }


