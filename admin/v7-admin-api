    function decodedConfigB64ToText(decoded='') {
      if (!decoded) return '';
      try {
        const bytes = Uint8Array.from(atob(decoded), ch => ch.charCodeAt(0));
        return new TextDecoder('utf-8').decode(bytes);
      } catch (_) {
        return '';
      }
    }
    async function readV2EgressDraftQrDataUrl() {
      const input = document.getElementById('v2EgressDraftQr');
      const file = input?.files?.[0];
      if (!file) return '';
      return await new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result || ''));
        reader.onerror = () => reject(reader.error);
        reader.readAsDataURL(file);
      });
    }
    async function loadV2EgressDraftQr(options={}) {
      const dataUrl = await readV2EgressDraftQrDataUrl();
      if (!dataUrl) return null;
      setV2DraftResultText(options.silent ? 'Распознаю QR перед добавлением...' : 'Распознаю QR...');
      const d = await postJson('/api/actions/egress-qr-preview', {label: document.getElementById('v2EgressDraftLabel').value.trim(), image_b64: dataUrl, ...v2DraftPolicy()});
      const decoded = d?.preview?.decoded_config_b64;
      if (decoded) {
        const text = decodedConfigB64ToText(decoded);
        if (text) document.getElementById('v2EgressDraftConfig').value = text;
      }
      if (!options.silent) renderV2EgressDraftResult(d);
      return d;
    }
