    if not user:
        return []
    readiness = (state.get("user_readiness") or {}).get(ip, {}) if isinstance(state.get("user_readiness"), dict) else {}
    enabled = str(user.get("enabled", "1")) == "1"
    status = str(readiness.get("status") or readiness.get("plain") or ("OK" if enabled else "DISABLED"))
