def closure_for(object_type, object_id, default_state="OPEN"):
    row = closure_lookup().get(closure_object_key(object_type, object_id), {})
    state = str(row.get("closure_state") or default_state or "OPEN").upper()
    if state not in CLOSURE_STATES:
        state = default_state if default_state in CLOSURE_STATES else "OPEN"
    return {
        "closure_state": state,
        "closure_reason": str(row.get("closure_reason") or ""),
        "closure_actor": str(row.get("closure_actor") or ""),
        "closure_timestamp": str(row.get("closure_timestamp") or ""),
        "closure_history_count": len([r for r in closure_records() if closure_object_key(r.get("object_type", ""), r.get("object_id", "")) == closure_object_key(object_type, object_id)]),
    }


def operational_timestamp(record, *fields):
    for field in fields or ("updated_at", "created_at", "ts", "detected_at"):
        value = record.get(field) if isinstance(record, dict) else ""
        if value and parse_ts(value):
            return value
    return ""


def attach_operational_metadata(record, object_type, object_id, ttl_seconds, *, ts_fields=("updated_at", "created_at", "ts", "detected_at")):
    item = dict(record or {})
    ts_value = operational_timestamp(item, *ts_fields)
    default_closure = str(item.get("closure_state") or "OPEN").upper()
    if default_closure not in CLOSURE_STATES:
        default_closure = "OPEN"
    item.update(freshness_model(ts_value, ttl_seconds))
    item.update(retention_model(ts_value))
    item.update(closure_for(object_type, object_id, default_state=default_closure))
    item["operation_metadata"] = {
        "freshness_state": item.get("freshness_state"),
        "retention_state": item.get("retention_state"),
        "closure_state": item.get("closure_state"),
        "read_only": True,
        "advanced_details_role": "admin",
    }
    return item


def parse_timeframe_seconds(value):
    value = str(value or "").strip().lower()
    if not value:
        return None
    aliases = {"today": 86400, "24h": 86400, "7d": 7 * 86400, "30d": 30 * 86400, "90d": 90 * 86400}
    if value in aliases:
        return aliases[value]
    match = re.match(r"^([1-9][0-9]{0,3})([hdw])$", value)
    if not match:
        return None
    amount = int(match.group(1))
    unit = match.group(2)
    return amount * {"h": 3600, "d": 86400, "w": 7 * 86400}[unit]


def record_matches_user(record, user):
    if not user:
        return True
    needle = str(user)
    if record.get("object_type") == "user" and record.get("object_id") == needle:
        return True
    if needle in [str(x) for x in record.get("affected_users") or []]:
        return True
    return needle in json.dumps(record, ensure_ascii=False)


def record_matches_channel(record, channel):
    if not channel:
        return True
    needle = str(channel)
    if record.get("object_type") == "channel" and record.get("object_id") == needle:
        return True
    for key in ("current_target", "proposed_target", "target", "egress", "source"):
        if str(record.get(key, "")) == needle:
            return True
    return needle in json.dumps(record, ensure_ascii=False)


def apply_operational_filters(records, params, *, ts_fields=("updated_at", "created_at", "ts", "detected_at")):
    params = params or {}
    user = safe_user_ip(query_value(params, "user", "ip", "user_ip"))
    channel = safe_egress_id(query_value(params, "channel", "egress", "target"))
    status = query_value(params, "status").upper()
    severity = query_value(params, "severity").lower()
    freshness = query_value(params, "freshness").upper()
    closure_state = query_value(params, "closure_state", "closure").upper()
    search = query_value(params, "q", "search").strip().lower()
    since = query_value(params, "since", "from")
    until = query_value(params, "until", "to")
    timeframe = parse_timeframe_seconds(query_value(params, "timeframe"))
    now_epoch = time.time()
    since_epoch = ts_epoch(since)
    until_epoch = ts_epoch(until)
    filtered = []
    for record in records:
        if status and str(record.get("status") or record.get("runtime_status") or record.get("release_status") or "").upper() != status:
            continue
        if severity and str(record.get("severity", "")).lower() != severity:
            continue
        if freshness and freshness in FRESHNESS_STATES and str(record.get("freshness_state", "")).upper() != freshness:
            continue
        if closure_state and closure_state in CLOSURE_STATES and str(record.get("closure_state", "")).upper() != closure_state:
            continue
        if not record_matches_user(record, user):
            continue
        if not record_matches_channel(record, channel):
            continue
        record_ts = operational_timestamp(record, *ts_fields)
        record_epoch = ts_epoch(record_ts)
        if timeframe is not None and record_epoch is not None and record_epoch < now_epoch - timeframe:
            continue
        if since_epoch is not None and record_epoch is not None and record_epoch < since_epoch:
            continue
        if until_epoch is not None and record_epoch is not None and record_epoch > until_epoch:
            continue
        if search and search not in json.dumps(record, ensure_ascii=False).lower():
            continue
        filtered.append(record)
    return filtered


