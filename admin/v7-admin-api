def login_throttle_state(username, client_ip):
    now = time.time()
    key = login_failure_key(username, client_ip)
    state = LOGIN_FAILURES.get(key) or {"attempts": [], "locked_until": 0}
    attempts = [item for item in state.get("attempts", []) if now - item <= LOGIN_FAILURE_WINDOW_SECONDS]
    locked_until = float(state.get("locked_until") or 0)
    state = {"attempts": attempts, "locked_until": locked_until}
    LOGIN_FAILURES[key] = state
    if locked_until > now:
        return True, int(locked_until - now)
    return False, 0


def record_login_failure(username, client_ip):
    now = time.time()
    key = login_failure_key(username, client_ip)
    state = LOGIN_FAILURES.get(key) or {"attempts": [], "locked_until": 0}
    attempts = [item for item in state.get("attempts", []) if now - item <= LOGIN_FAILURE_WINDOW_SECONDS]
    attempts.append(now)
    locked_until = float(state.get("locked_until") or 0)
    if len(attempts) >= LOGIN_FAILURE_LIMIT:
        locked_until = now + LOGIN_LOCK_SECONDS
    LOGIN_FAILURES[key] = {"attempts": attempts, "locked_until": locked_until}
    return int(max(0, locked_until - now))


def clear_login_failures(username, client_ip):
    LOGIN_FAILURES.pop(login_failure_key(username, client_ip), None)


def parse_session(header):
    if not header:
        return None
    jar = cookies.SimpleCookie()
    try:
        jar.load(header)
    except cookies.CookieError:
        return None
    morsel = jar.get(SESSION_COOKIE)
    if not morsel:
        return None
    token = morsel.value
    try:
        payload_b64, sig = token.split(".", 1)
    except ValueError:
        return None
    data = auth_config()
    expected = sign_payload(payload_b64, data.get("session_secret", ""))
    if not hmac.compare_digest(sig, expected):
        return None
    try:
        payload = json.loads(b64d(payload_b64).decode("utf-8"))
    except Exception:
        return None
    if int(payload.get("exp", 0)) < int(time.time()):
        return None
    account = auth_accounts(data).get(str(payload.get("sub") or ""))
    if not account or not account.get("enabled", True):
        return None
    payload["role"] = auth_role(payload.get("sub"))
    return payload


