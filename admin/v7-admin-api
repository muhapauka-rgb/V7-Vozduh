        "source": "admin_hardening",
        "read_only_runtime": True,
    }
    append_jsonl(CLOSURE_STORE_FILE, row)
    audit_admin(actor, "admin_action_closure_set", f"object_type={object_type} object_id={object_id} state={state}", object_type=object_type, object_id=object_id, result="OK")
    return {"action": "closure_set", "closure": row, "read_only_runtime": True}, None, 200


