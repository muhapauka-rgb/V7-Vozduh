def capacity_read_adapter(target, user_count):
    capacity = execution_preview_target_capacity(target)
    hard = int(capacity.get("hard_limit") or 0)
    current = int(capacity.get("current_users") or 0)
    if not target:
        return {"status": "REVIEW_REQUIRED", "reason": "no target selected", "source": "draft", "detail": capacity}
    if not capacity.get("exists"):
        return {"status": "FAIL", "reason": "target missing", "source": "egress.registry", "detail": capacity}
    if hard and current + int(user_count or 0) > hard:
        return {"status": "FAIL", "reason": f"capacity exceeded: current={current} budget={user_count} hard={hard}", "source": "egress.registry", "detail": capacity}
    if not hard:
        return {"status": "REVIEW_REQUIRED", "reason": "hard_limit missing or zero", "source": "egress.registry", "detail": capacity}
    return {"status": "PASS", "reason": f"capacity ok: current={current} budget={user_count} hard={hard}", "source": "egress.registry", "detail": capacity}


def required_services_read_adapter(draft):
    services = draft.get("preview_metadata", {}).get("required_services") or []
    target = draft.get("target", "")
    if not services:
        return {"status": "REVIEW_REQUIRED", "reason": "proposal has no required services", "source": "proposal", "detail": {"required_services": []}}
    matrix = service_matrix_state().get("items", {}).get(target, {})
    matrix_services = matrix.get("services") or matrix.get("items") or {}
    missing = []
    failing = []
    for service in services:
        row = matrix_services.get(service) or {}
        if not row:
            missing.append(service)
        elif not service_matrix_item_ok(row):
            failing.append(service)
    if failing:
        status = "FAIL"
        reason = f"required services failing: {', '.join(failing)}"
    elif missing:
        status = "REVIEW_REQUIRED"
        reason = f"required services missing in matrix: {', '.join(missing)}"
    else:
        status = "PASS"
        reason = "required services are healthy on target"
    return {"status": status, "reason": reason, "source": "service_matrix", "detail": {"required_services": services, "target": target, "missing": missing, "failing": failing}}


def service_matrix_item_ok(row):
    if not isinstance(row, dict):
        return False
    status = str(row.get("status") or row.get("result") or row.get("state") or "").upper()
    if status in {"OK", "PASS", "PASSED", "WORKS", "GOOD"}:
        return True
    if row.get("ok") is True:
        return True
    code = str(row.get("http_code") or row.get("code") or "")
    return code.startswith("2") or code.startswith("3")


