def execution_readiness_response(query=None):
    drafts = execution_preview_drafts_from_query(query)
    validation = [execution_validation_preview_for_draft(d) for d in drafts]
    verification = [execution_verification_preview_for_draft(d) for d in drafts]
    rollback = [execution_rollback_preview_for_draft(d) for d in drafts]
    consistency = execution_preview_consistency()
    gate_rows = execution_gate_catalog_for_drafts(drafts)
    unknown_gates = [row.get("gate_id") for row in gate_rows if row.get("status") == "UNKNOWN"]
    review_gates = [row.get("gate_id") for row in gate_rows if row.get("status") == "REVIEW_REQUIRED"]
    failed_gates = [row.get("gate_id") for row in gate_rows if row.get("status") == "FAIL"]
    ready = [item for item in validation if item.get("status") == "PASS"]
    review = [item for item in validation if item.get("status") in {"REVIEW_REQUIRED", "UNKNOWN"}]
    failed = [item for item in validation if item.get("status") == "FAIL"]
    if not drafts:
        status = "UNKNOWN"
        reason = "No proposal-derived execution drafts are available."
    elif failed or failed_gates or consistency.get("status") == "FAIL":
        status = "NOT_READY"
        reason = "One or more validation gates failed closed."
    elif review or review_gates or unknown_gates:
        status = "READY_WITH_REVIEW"
        reason = "No fail-closed gate, but some gates require operator review."
    else:
        status = "READY"
        reason = "All preview validation gates passed."
    return {
        "status": status,
        "draft_contracts": len(drafts),
        "validation_pass": len(ready),
        "validation_review_required": len(review),
        "validation_fail": len(failed),
        "verification_previews": len(verification),
        "rollback_previews": len(rollback),
        "unknown_gates": unknown_gates,
