    async function autoV2EgressDraftLaunch(draftId, options={}) {
      if (v2DraftAutoRunning) return;
      v2DraftAutoRunning = true;
      const allowDuplicate = options && options.allowDuplicate === true;
      const prepareOnly = options && options.prepareOnly === true;
      const stages = v2DraftAutoStages({prepareOnly}).map(step => ({...step, status:'WAITING', detail:''}));
      const mark = (id, status, detail='') => {
        const step = stages.find(item => item.id === id);
        if (step) {
          step.status = status;
          step.detail = detail;
        }
        renderV2DraftAutoProgress(draftId, stages, detail);
      };
      const fail = (id, response, detail='') => {
        const step = stages.find(item => item.id === id);
        if (step) {
          step.status = 'BLOCKED';
          step.detail = detail || v2DraftAutoShortDetail(response, step.label);
        }
        renderV2DraftAutoVerdict({draftId, ok:false, stages, response, failedStage:step, prepareOnly});
      };
      try {
        const state = await api('/api/egress-drafts');
        let row = (state.items || []).find(item => item.id === draftId) || {};
        const blocker = v2DraftAutoBlockedReason(row);
        if (blocker) {
          fail('preflight', {error:'auto_launch_blocked', message:blocker}, blocker);
          return;
        }

        if (row.last_preflight_status === 'PASS') {
          mark('preflight', 'SKIP', 'уже пройдено');
        } else {
          mark('preflight', 'RUNNING', 'проверяю поля и безопасные директивы');
          const preflight = await postJson('/api/actions/egress-draft-preflight-run', {draft_id: draftId, confirm: 'RUN_PREFLIGHT'});
          if (preflight.error || String((preflight.result || {}).status || '').toUpperCase() !== 'PASS') {
            fail('preflight', preflight);
            return;
          }
          mark('preflight', 'PASS', 'поля проверены');
        }

        if (row.last_runtime_status === 'PASS') {
          mark('runtime', 'SKIP', 'уже пройдено');
        } else {
          mark('runtime', 'RUNNING', 'поднимаю временный изолированный туннель');
          const runtime = await postJson('/api/actions/egress-draft-runtime-run', {draft_id: draftId, confirm: 'RUN_RUNTIME_TEST', duration: 8});
          if (runtime.error || String((runtime.result || {}).status || '').toUpperCase() !== 'PASS') {
            fail('runtime', runtime);
            return;
          }
          mark('runtime', 'PASS', 'временный туннель работает');
        }

        if (row.last_quarantine_status === 'PASS') {
          mark('quarantine', 'SKIP', 'уже пройдено');
        } else {
          mark('quarantine', 'RUNNING', 'временно поднимаю канал, проверяю внешний IP и внешние сервисы, затем гашу');
          const quarantine = await postJson('/api/actions/egress-draft-quarantine-run', {draft_id: draftId, confirm: 'RUN_QUARANTINE_TEST', duration: 10});
          if (quarantine.error || String((quarantine.result || {}).quarantine_status || '').toUpperCase() !== 'PASS') {
            const recovered = await api('/api/egress-drafts');
            row = (recovered.items || []).find(item => item.id === draftId) || row;
            if (row.last_quarantine_status === 'PASS') {
              mark('quarantine', 'PASS', 'изолированная проверка пройдена');
            } else {
            fail('quarantine', quarantine);
            return;
            }
          } else {
            const matrix = (quarantine.result || {}).service_matrix || {};
            mark('quarantine', 'PASS', matrix.total ? `сервисы: ${matrix.ok_count || 0}/${matrix.total}` : 'карантин пройден');
          }
        }

        if (['added_disabled','enabled'].includes(String(row.pool_action || ''))) {
          mark('pool', 'SKIP', row.pool_action === 'enabled' ? 'уже включён' : 'уже добавлен выключенным');
        } else {
          mark('pool', 'RUNNING', 'проверяю добавление в пул');
          const poolPreview = await postJson('/api/actions/egress-draft-pool-preview', {draft_id: draftId, allow_duplicate: allowDuplicate ? '1' : '0'});
          if (poolPreview.error || !poolPreview.preview || poolPreview.preview.ready !== true) {
            fail('pool', poolPreview);
            return;
          }
          mark('pool', 'RUNNING', allowDuplicate ? 'создаю осознанный дубль выключенным' : 'добавляю в пул выключенным');
          const poolApply = await postJson('/api/actions/egress-draft-pool-apply', {draft_id: draftId, confirm: 'ADD_DISABLED_EGRESS', allow_duplicate: allowDuplicate ? '1' : '0'});
          if (poolApply.error) {
            fail('pool', poolApply);
            return;
          }
          mark('pool', 'PASS', 'добавлен выключенным');
        }

        const afterPool = await api('/api/egress-drafts');
        row = (afterPool.items || []).find(item => item.id === draftId) || row;
        if (row.runtime_profile_status === 'READY') {
          mark('provision', 'SKIP', 'рабочий профиль уже готов');
        } else {
          mark('provision', 'RUNNING', 'готовлю рабочий профиль');
          const provision = await postJson('/api/actions/egress-draft-runtime-provision', {draft_id: draftId, confirm: 'PROVISION_RUNTIME_PROFILE'});
          if (provision.error || String((provision.result || {}).status || '').toUpperCase() !== 'READY') {
            fail('provision', provision);
            return;
          }
          mark('provision', 'PASS', 'рабочий профиль готов');
        }

        const afterProvision = await api('/api/egress-drafts');
        row = (afterProvision.items || []).find(item => item.id === draftId) || row;
        if (prepareOnly) {
          await loadV2EgressDrafts();
          await load();
          const preparedEgress = row.pool_egress_id || row.egress || draftId;
          renderV2DraftAutoVerdict({draftId, ok:true, stages, response:{result:{egress:preparedEgress}}, prepareOnly:true});
          showChannelWorkspace('overview');
          openCompactDrawer(channelDisplayName(preparedEgress), 'channel', drawerSection('Канал добавлен', `
            <p>Канал прошёл проверки, подготовлен и добавлен в список выключенным.</p>
            <p class="muted">Чтобы начать использовать его, нажмите Play в строке канала.</p>
            <div class="detail-actions"><button class="primary" onclick="startV2ChannelFromList('${esc(preparedEgress)}')">Запустить канал</button><button class="ghost" onclick="openChannelDrawer('${esc(preparedEgress)}')">Открыть карточку</button></div>`), {replace:true});
          return;
        }
        if (row.pool_action === 'enabled') {
          mark('enable', 'SKIP', 'уже включён');
        } else {
          mark('enable', 'RUNNING', 'проверяю включение');
          const enablePreview = await postJson('/api/actions/egress-draft-enable-preview', {draft_id: draftId});
          if (enablePreview.error || !enablePreview.preview || enablePreview.preview.ready !== true) {
            fail('enable', enablePreview);
            return;
          }
          mark('enable', 'RUNNING', 'включаю канал');
          const enable = await postJson('/api/actions/egress-draft-enable-apply', {draft_id: draftId, confirm: 'ENABLE_DRAFT_EGRESS'});
          if (enable.error || String((enable.result || {}).status || '').toUpperCase() !== 'ENABLED') {
            fail('enable', enable);
            return;
          }
          mark('enable', 'PASS', 'канал включён');
        }

        mark('post_enable', 'RUNNING', 'проверяю состояние после включения');
        const validation = await postJson('/api/actions/egress-draft-post-enable-validation', {draft_id: draftId});
        if (validation.error) {
          fail('post_enable', validation);
          return;
        }
        mark('post_enable', 'PASS', 'финальная проверка выполнена');
        const enabledEgress = (validation.result || {}).egress || row.pool_egress_id || '';
        if (enabledEgress) {
          mark('speed', 'RUNNING', 'замеряю скорость канала');
          try {
            const speed = await postJson('/api/actions/egress-speedtest', {egress: enabledEgress});
            if (speed.overview) overview = speed.overview;
            const mbps = egressSpeedMbpsFromResult(speed, enabledEgress);
            if (speed.error || Number(speed.result?.rc ?? 0) !== 0) {
              mark('speed', 'WARN', 'канал включён, скорость не замерилась');
            } else {
              mark('speed', 'PASS', mbps ? `скорость ${mbps.toFixed(1)} Mbps` : 'замер выполнен');
            }
          } catch (speedErr) {
            mark('speed', 'WARN', 'канал включён, скорость можно замерить позже');
          }
        } else {
          mark('speed', 'WARN', 'канал включён, id для замера не найден');
        }
        await loadV2EgressDrafts();
        await load();
        renderV2DraftAutoVerdict({draftId, ok:true, stages, response:validation, prepareOnly:false});
      } catch (err) {
        fail('preflight', {error:'browser_or_network_error', message:err.message || String(err)}, err.message || String(err));
      } finally {
        v2DraftAutoRunning = false;
      }
    }
