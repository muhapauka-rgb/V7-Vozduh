    async function copyIssueConfigFromUrl(url='', button=null) {
      const target = String(url || '');
      if (!target) return;
      try {
        if (button) {
          button.disabled = true;
          button.dataset.originalText = button.textContent || 'Скопировать конфиг';
          button.textContent = 'Копирую...';
        }
        const response = await fetch(target, {cache:'no-store', credentials:'same-origin'});
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const text = await response.text();
        await copyIssueText(text, button, 'Скопировать конфиг');
        if (button) button.textContent = 'Скопировано';
      } catch (err) {
        alert('Не удалось скопировать конфиг. Откройте ссылку скачивания и скопируйте вручную.');
        if (button) button.textContent = button.dataset.originalText || 'Скопировать конфиг';
      } finally {
        if (button) {
          setTimeout(() => {
            button.disabled = false;
            button.textContent = button.dataset.originalText || 'Скопировать конфиг';
          }, 1200);
        }
      }
    }
    async function copyIssueText(text='', button=null, resetTitle='Скопировать') {
      const value = String(text || '');
      if (!value) return;
      const fallbackCopy = () => {
        const input = button?.closest('.issue-link-row')?.querySelector('input');
        if (input) {
          input.focus();
          input.select();
          input.setSelectionRange?.(0, input.value.length);
        }
        const area = document.createElement('textarea');
        area.value = value;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.left = '-9999px';
        area.style.top = '0';
        document.body.appendChild(area);
        area.focus();
        area.select();
        const ok = document.execCommand('copy');
        area.remove();
        if (!ok) throw new Error('copy_failed');
      };
      try {
        if (navigator.clipboard?.writeText) {
          try {
            await navigator.clipboard.writeText(value);
          } catch (err) {
            fallbackCopy();
          }
        } else {
          fallbackCopy();
        }
        if (button) {
          button.classList.add('is-copied');
          button.title = 'Скопировано';
          button.setAttribute('aria-label', 'Скопировано');
          setTimeout(() => {
            button.classList.remove('is-copied');
            button.title = resetTitle;
            button.setAttribute('aria-label', resetTitle);
          }, 1200);
        }
      } catch (err) {
        alert('Не удалось скопировать. Выделите поле и скопируйте вручную.');
      }
    }
