def execution_service_impact_for_draft(draft):
    target = draft.get("target", "")
    required = normalize_services((draft.get("preview_metadata") or {}).get("required_services") or [])
    matrix = service_matrix_state().get("items", {}).get(target, {})
    matrix_services = matrix.get("services") if isinstance(matrix, dict) else {}
    if not isinstance(matrix_services, dict):
        matrix_services = {}
    items = []
    for service in execution_simulation_service_ids(draft):
        row = matrix_services.get(service) or {}
        known = bool(row)
        ok = service_matrix_item_ok(row) if known else False
        if known and ok:
            expected = "available"
            risk = "low"
            confidence = "medium"
        elif known:
            expected = "degraded_or_unavailable"
            risk = "high" if service in required else "medium"
            confidence = "medium"
        else:
            expected = "unknown"
            risk = "review_required" if service in required else "unknown"
            confidence = "low"
        items.append({
            "service": service,
            "required": service in required,
            "expected_impact": expected,
            "potential_risk": risk,
            "confidence": confidence,
            "evidence_source": "service_matrix" if known else "missing_service_matrix_row",
            "read_only": True,
            "preview_only": True,
        })
    required_missing_or_bad = [item.get("service") for item in items if item.get("required") and item.get("expected_impact") != "available"]
    status = "FAIL" if required_missing_or_bad else ("REVIEW_REQUIRED" if any(item.get("expected_impact") == "unknown" for item in items) else "PASS")
    return {
        "contract_id": draft.get("contract_id", ""),
        "draft_id": draft.get("draft_id", ""),
        "target": target,
        "status": status,
        "required_services": required,
        "items": items,
        "unknown_services": [item.get("service") for item in items if item.get("expected_impact") == "unknown"],
        "at_risk_services": [item.get("service") for item in items if item.get("potential_risk") in {"high", "medium", "review_required"}],
        "summary": "Required services need review." if required_missing_or_bad else "Service impact is preview-only and derived from service matrix.",
        "read_only": True,
        "non_authoritative": True,
        "preview_only": True,
        "execution_allowed_now": False,
    }


def execution_blast_radius_for_draft(draft):
    affected_users = draft.get("affected_users") or []
    target = draft.get("target", "")
    current_target = draft.get("current_target", "")
    registry = users_registry_map()
    user_rows = [registry.get(ip, {"ip": ip}) for ip in affected_users]
    groups = sorted({str(row.get("group") or row.get("organization") or row.get("org") or "default") for row in user_rows if row})
    capacity = execution_preview_target_capacity(target)
    service_impact = execution_service_impact_for_draft(draft)
    policy_domains = sorted({service for service in service_impact.get("required_services", [])})
    risk_categories = []
    if not affected_users:
        risk_categories.append("no_users")
    if capacity.get("hard_limit") and int(capacity.get("current_users") or 0) + len(affected_users) > int(capacity.get("hard_limit") or 0):
        risk_categories.append("capacity_exceeded")
    if service_impact.get("status") != "PASS":
        risk_categories.append("service_review")
    if not target:
        risk_categories.append("target_missing")
    return {
        "contract_id": draft.get("contract_id", ""),
        "draft_id": draft.get("draft_id", ""),
        "status": "FAIL" if "capacity_exceeded" in risk_categories or "target_missing" in risk_categories else ("REVIEW_REQUIRED" if risk_categories else "PASS"),
        "users_affected": len(affected_users),
        "affected_users": affected_users,
        "groups_affected": groups,
        "channels_affected": sorted({item for item in [current_target, target] if item}),
        "source_channel": current_target,
        "target_channel": target,
        "services_affected": service_impact.get("at_risk_services", []) + [s for s in service_impact.get("required_services", []) if s not in service_impact.get("at_risk_services", [])],
        "capacity_affected": {
            "target": target,
            "current_users": capacity.get("current_users", 0),
            "incoming_users": len(affected_users),
            "hard_limit": capacity.get("hard_limit", 0),
            "soft_limit": capacity.get("soft_limit", 0),
            "would_be_users": int(capacity.get("current_users") or 0) + len(affected_users),
        },
        "policy_affected": bool(policy_domains),
        "routing_domains_affected": policy_domains,
        "risk_categories": risk_categories,
        "read_only": True,
        "non_authoritative": True,
        "preview_only": True,
        "execution_allowed_now": False,
    }


