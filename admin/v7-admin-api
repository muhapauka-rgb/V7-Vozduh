    egress_registry = parse_registry(STATE_DIR / "egress.registry")
    audit_tail = tail_jsonl(AUDIT_FILE, 16)
    switch_tail = tail_jsonl(EVENT_DIR / "switch-history.jsonl", 16)
    route_rows = route_status(active_users[:80]) if active_users else []
    bundles = []

    state_age = file_age(STATE_DIR / "v7-state.json")
    state_fresh = state_age is not None and state_age <= 180
    bundles.append(evidence_bundle(
        "evidence-check-state-freshness",
        "check",
        "diagnostics",
        "VERIFIED" if state_fresh else "OPEN",
        "ok" if state_fresh else "warn",
        f"Возраст снимка состояния V7: {state_age}s." if state_age is not None else "Снимок состояния V7 не найден.",
        timeline=evidence_event_timeline(audit_tail, 4),
        evidence_items=[
            {"kind": "file", "label": "v7-state.json", "status": "OK" if state_fresh else "WARN", "summary": f"age_sec={state_age}"},
            {"kind": "log", "label": "audit tail", "status": "OBSERVED", "summary": f"свежих записей аудита: {len(audit_tail)}"},
        ],
        recommendation="Запустите диагностику, если снимок состояния устарел." if not state_fresh else "Продолжать наблюдение.",
        verification_state="VERIFIED" if state_fresh else "NEEDS_REVIEW",
        closure_state="CLOSED" if state_fresh else "OPEN",
        links=[evidence_link("check", "state_freshness"), evidence_link("system", "overview"), evidence_link("log", "latest-audit")],
    ))

    leak_rows = [r for r in route_rows if r.get("leak_risk")]
    mismatch_rows = [r for r in route_rows if not r.get("ok")]
    route_status_ok = not leak_rows and not mismatch_rows
    route_links = [evidence_link("route", "reality"), evidence_link("alert", "route_reality")]
    route_links.extend(evidence_link("user", r.get("ip", "")) for r in mismatch_rows[:8] if r.get("ip"))
    bundles.append(evidence_bundle(
        "evidence-route-reality",
        "route",
        "reality",
        "VERIFIED" if route_status_ok else "OPEN",
        "ok" if route_status_ok else ("bad" if leak_rows else "warn"),
        f"Факт маршрутов: {sum(1 for r in route_rows if r.get('ok'))}/{len(route_rows)} активных пользователей соответствуют ожидаемому маршруту.",
        timeline=evidence_event_timeline(switch_tail or audit_tail, 5),
        evidence_items=[
            {"kind": "route_check", "label": "route_status", "status": "OK" if route_status_ok else "WARN", "summary": f"mismatches={len(mismatch_rows)} leak_risks={len(leak_rows)}"},
        ],
        recommendation="Проверьте затронутых пользователей перед любым movement." if not route_status_ok else "Маршруты согласованы.",
        verification_state="VERIFIED" if route_status_ok else "NEEDS_REVIEW",
        closure_state="CLOSED" if route_status_ok else "OPEN",
        links=route_links,
    ))

    user_route_by_ip = {r.get("ip"): r for r in route_rows if r.get("ip")}
    highlighted_users = [u for u in active_users if not user_route_by_ip.get(u.get("ip"), {}).get("ok", True)]
    if len(highlighted_users) < 6:
        highlighted_users.extend([u for u in active_users if u not in highlighted_users][: 6 - len(highlighted_users)])
    for user in highlighted_users[:10]:
        ip = user.get("ip", "")
        route = user_route_by_ip.get(ip, {})
        ok = bool(route.get("ok", True)) and not bool(route.get("leak_risk"))
        bundles.append(evidence_bundle(
            evidence_hash("evidence-user", ip, user.get("current"), route.get("ok"), route.get("leak_risk")),
            "user",
            ip,
            "VERIFIED" if ok else "OPEN",
            "ok" if ok else ("bad" if route.get("leak_risk") else "warn"),
            f"Пользователь {ip}: канал {user.get('current') or 'неизвестно'}, таблица {user.get('table') or 'неизвестно'}.",
            timeline=evidence_event_timeline([e for e in audit_tail if e.get("user_ip") == ip or e.get("object_id") == ip], 4),
            evidence_items=[
                {"kind": "registry", "label": "users.registry", "status": "OBSERVED", "summary": f"current={user.get('current','')} table={user.get('table','')} enabled={user.get('enabled','1')}"},
                {"kind": "route", "label": "route reality", "status": "OK" if ok else "WARN", "summary": route.get("reason") or route.get("detail") or ("маршрутная готовность подтверждена" if ok else "маршрутная готовность неполная")},
            ],
            recommendation="Откройте карточку пользователя и сверьте доказательства маршрута." if not ok else "Срочное действие не требуется.",
            verification_state="VERIFIED" if ok else "NEEDS_REVIEW",
            closure_state="CLOSED" if ok else "OPEN",
            links=[evidence_link("route", "reality"), evidence_link("log", "latest-audit")],
        ))

    matrix = service_matrix_state()
    matrix_items = matrix.get("items") or {}
    for row in egress_registry[:16]:
        egress_id = row.get("id", "")
        st = egress_state.get(egress_id, {}) if isinstance(egress_state, dict) else {}
        mx = matrix_items.get(egress_id, {}) if isinstance(matrix_items, dict) else {}
        code_ok = str(st.get("code", "")) == "200" or str(st.get("diagnose_severity", "")).upper() in ("OK", "")
        total = int(mx.get("total") or mx.get("count") or 0) if isinstance(mx, dict) else 0
        ok_count = int(mx.get("ok_count") or 0) if isinstance(mx, dict) else 0
        matrix_ok = not total or ok_count >= total
        ok = code_ok and matrix_ok
        bundles.append(evidence_bundle(
            evidence_hash("evidence-channel", egress_id, st.get("code"), ok_count, total),
            "channel",
            egress_id,
            "VERIFIED" if ok else "OPEN",
            "ok" if ok else "warn",
            f"Канал {egress_id}: состояние {'OK' if code_ok else 'не подтверждено'}; сервисы {ok_count}/{total or 0}.",
            timeline=evidence_event_timeline([e for e in audit_tail if e.get("object_id") == egress_id or e.get("component") == "egress"], 4),
            evidence_items=[
                {"kind": "diagnose", "label": "egress health", "status": "OK" if code_ok else "WARN", "summary": st.get("diagnose_reason") or st.get("diagnose_detail") or st.get("status") or "состояние диагностики зафиксировано"},
                {"kind": "service_matrix", "label": "services", "status": "OK" if matrix_ok else "WARN", "summary": f"сервисов OK: {ok_count}/{total or 0}"},
            ],
            recommendation="Откройте карточку канала и посмотрите сервисы или диагностику, если канал выбран для работы." if not ok else "Канал выглядит здоровым.",
            verification_state="VERIFIED" if ok else "NEEDS_REVIEW",
            closure_state="CLOSED" if ok else "OPEN",
            links=[evidence_link("log", "latest-audit")],
        ))

    if audit_tail:
        bundles.append(evidence_bundle(
            "evidence-log-latest-audit",
            "log",
            "latest-audit",
            "OBSERVING",
            "info",
            f"Аудит содержит {len(audit_tail)} свежих записей для операторской проверки.",
            timeline=evidence_event_timeline(audit_tail, 8),
            evidence_items=[{"kind": "audit", "label": "audit.jsonl tail", "status": "OBSERVED", "summary": f"загружено записей: {len(audit_tail)}"}],
            recommendation="При расследовании открывайте связанные объекты из событий лога.",
            verification_state="OBSERVED",
            closure_state="OPEN",
            links=[evidence_link("system", "overview")],
        ))

    return bundles[:limit]


def generated_user_evidence_bundles(ip):
