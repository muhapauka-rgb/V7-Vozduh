def identity_update_user_metadata(data, actor):
    identity_init_db()
    ip = safe_user_ip(data.get("ip", ""))
    if not ip:
        return None, {"error": "invalid_user_ip"}
    registry_rows = parse_registry(STATE_DIR / "users.registry")
    if not any(row.get("ip") == ip for row in registry_rows):
        return None, {"error": "user_not_found", "ip": ip}
    display_name = clean_identity_text(data.get("display_name") or data.get("name", ""), 160)
    phone_input = clean_identity_text(data.get("phone", ""), 40)
    phone = normalize_phone(phone_input) if phone_input else ""
    if phone_input and not phone:
        return None, {"error": "invalid_phone"}
    organization_name = clean_identity_text(data.get("organization_name") or data.get("company", ""), 160)
    device_name = clean_identity_text(data.get("device_name") or data.get("device", ""), 120)
    notes = clean_identity_text(data.get("notes", ""), 800)
    now = now_iso()
    changed = ["user_metadata"]
    with identity_conn() as conn:
        conn.executescript(IDENTITY_SCHEMA)
        device = conn.execute(
            "SELECT * FROM devices WHERE assigned_vpn_ip=? AND status='active' ORDER BY updated_at DESC LIMIT 1",
            (ip,),
        ).fetchone()
        identity_user = None
        if device:
            identity_user = conn.execute("SELECT * FROM identity_users WHERE id=?", (device["user_id"],)).fetchone()
        org_id = ""
        if organization_name:
            org_id = identity_ensure_organization(conn, organization_name)
            changed.append("organization")
        if identity_user:
            updates = {}
            if display_name:
                updates["display_name"] = display_name
                updates["entered_name"] = display_name
            if phone:
                same_phone = conn.execute(
                    "SELECT id FROM identity_users WHERE phone_normalized=? AND id<>?",
                    (phone, identity_user["id"]),
                ).fetchone()
                if same_phone:
                    return None, {"error": "phone_already_used", "phone": phone}
                updates["phone_normalized"] = phone
            if org_id:
                updates["organization_id"] = org_id
            if notes or "notes" in data:
                updates["notes"] = notes
            if updates:
                updates["updated_at"] = now
                assignments = ", ".join(f"{key}=?" for key in updates)
                conn.execute(
                    f"UPDATE identity_users SET {assignments} WHERE id=?",
                    (*updates.values(), identity_user["id"]),
                )
                changed.append("identity_user")
            if device_name:
                conn.execute(
                    "UPDATE devices SET device_name=?, updated_at=? WHERE id=?",
                    (device_name, now, device["id"]),
                )
                changed.append("device")
            if phone:
                existing_allowed = conn.execute("SELECT * FROM allowed_users WHERE phone_normalized=?", (phone,)).fetchone()
                if existing_allowed:
                    conn.execute(
                        """
                        UPDATE allowed_users
                        SET expected_name=COALESCE(NULLIF(?, ''), expected_name),
                            organization_id=COALESCE(NULLIF(?, ''), organization_id),
                            note=COALESCE(NULLIF(?, ''), note),
                            updated_at=?
                        WHERE phone_normalized=?
                        """,
                        (display_name, org_id, notes, now, phone),
                    )
                    changed.append("allowed_user")
        conn.execute(
            """
            INSERT INTO user_metadata (ip, display_name, phone_normalized, organization_name, device_name, notes, created_at, updated_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            ON CONFLICT(ip) DO UPDATE SET
              display_name=excluded.display_name,
              phone_normalized=excluded.phone_normalized,
              organization_name=excluded.organization_name,
              device_name=excluded.device_name,
              notes=excluded.notes,
              updated_at=excluded.updated_at
            """,
            (ip, display_name, phone, organization_name, device_name, notes, now, now),
        )
        conn.commit()
        row = dict(conn.execute("SELECT * FROM user_metadata WHERE ip=?", (ip,)).fetchone())
    audit_admin(actor, "admin_action_user_metadata_update", f"ip={ip} fields={','.join(sorted(set(changed)))}", object_type="user", object_id=ip, result="OK")
    return {"metadata": row, "changed": sorted(set(changed))}, None


