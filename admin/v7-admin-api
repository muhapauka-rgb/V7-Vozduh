    lines.extend([
        "proxy-groups:",
        "  - name: V7",
        "    type: select",
        "    proxies:",
        f"      - {yaml_single_quote(wg_name)}",
        "      - DIRECT",
    ])
    if mode == "AUTO_TRAVEL":
