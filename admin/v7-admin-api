def onboarding_client_name(user, device_type):
    suffix = secrets.token_hex(3)
    phone = re.sub(r"\D+", "", user.get("phone_normalized", ""))[-6:] or "client"
    device_type = clean_identity_text(device_type or "device", 40).lower()
    device_type = re.sub(r"[^a-z0-9_.-]+", "-", device_type).strip("-") or "device"
    return safe_client_name(f"u{phone}-{device_type}-{suffix}") or f"u{phone}-{suffix}"


