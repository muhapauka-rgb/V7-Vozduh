    severity = str((params.get("severity") or [""])[0] or "").lower()
    status = str((params.get("status") or [""])[0] or "").upper()
    if severity:
        records = [row for row in records if str(row.get("severity", "")).lower() == severity]
    if status:
        records = [row for row in records if str(row.get("status", "")).upper() == status]
    records = apply_operational_filters(records, params, ts_fields=("detected_at", "ts"))
    limit, offset = pagination_from_query(params)
    page = records[offset: offset + limit]
    return {
        "items": page,
        "count": len(page),
        "total": len(records),
        "next_cursor": str(offset + limit) if offset + limit < len(records) else "",
        "read_only": True,
        "non_authoritative": True,
