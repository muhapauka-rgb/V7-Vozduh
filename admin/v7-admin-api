def desired_state_map():
    result = {}
    check = run_readonly(["v7-user-desired-state"], timeout=8)
    for line in str(check.get("output", "")).splitlines():
        if not line.startswith("user="):
            continue
        row = {}
        for part in line.split():
            if "=" not in part:
                continue
            key, value = part.split("=", 1)
            if re.match(r"^[A-Za-z0-9_]+$", key):
                row[key] = value
        ip = safe_user_ip(row.get("user", ""))
        if not ip:
            continue
        row["_output"] = line
        result[ip] = row
    return result


def desired_state_row(ip):
    return desired_state_map().get(ip, {})


def empty_handshake():
    return {
        "present": False,
        "latest_handshake_epoch": 0,
        "latest_handshake_age_sec": None,
        "recent": False,
        "transfer_rx_bytes": 0,
        "transfer_tx_bytes": 0,
    }


def desired_state_effective_ok(user, desired):
    if (desired or {}).get("status") == "OK":
        return True, ""
    current = str((desired or {}).get("current") or (desired or {}).get("assign") or (user or {}).get("current") or "").strip().lower()
    reasons = {
        item.strip()
        for item in str((desired or {}).get("reasons") or "").split(",")
        if item.strip()
    }
    if current == "vless" and reasons and reasons.issubset({"ip_rule_missing"}):
        return True, "vless_kernel_ip_rule_not_required"
    return False, ""


def user_readiness(ip, user, route, artifacts, speed_row, agent_row, handshake=None, desired=None, vless_activity=None, proxy_route=None):
    handshake = handshake if handshake is not None else wg_handshake_state(ip)
    desired = desired if desired is not None else desired_state_row(ip)
    vless_activity = vless_activity if vless_activity is not None else vless_activity_state(ip)
    proxy_route = proxy_route if isinstance(proxy_route, dict) else proxy_runtime_user_routes(PROXY_INBOUND_ID).get(ip, {})
    profile_connection = proxy_profile_connection_state(ip, proxy_route, vless_activity)
    enabled = str(user.get("enabled", "1")) == "1"
    artifacts_ready = any(row.get("config_ready") for row in artifacts)
    smart_profiles = smart_client_profiles_for_ip(ip) if enabled else {"available": False, "items": []}
    universal_profile = next(
        (
            row for row in smart_profiles.get("items", [])
            if row.get("adapter") == "karing" and row.get("mode") == "ABROAD_RU_VIA_V7"
        ),
        {},
    )
    universal_validation = universal_profile.get("validation") or {}
    universal_ready = bool(universal_profile.get("ready")) and universal_validation.get("status") == "OK"
    ru_local_profile = next(
        (
            row for row in smart_profiles.get("items", [])
            if row.get("adapter") == "karing" and row.get("mode") == "RU_LOCAL"
        ),
        {},
    )
    ru_local_validation = ru_local_profile.get("validation") or {}
    ru_local_ready = bool(ru_local_profile.get("ready")) and ru_local_validation.get("status") == "OK"
    smart_profile_ready = bool(universal_ready or ru_local_ready)
    route_ok = bool((route or {}).get("ok")) and not bool((route or {}).get("leak_risk"))
    desired_ok, desired_note = desired_state_effective_ok(user, desired)
    agent_online = bool((agent_row or {}).get("online") or (speed_row or {}).get("agent_online"))
    vless_online = bool(vless_activity.get("present") or vless_activity.get("seen"))
    connected = bool(handshake.get("recent") or agent_online or vless_online)
    connection_source = ""
    if handshake.get("recent"):
        connection_source = "wireguard_handshake"
    elif agent_online:
        connection_source = "client_agent"
    elif vless_online:
        connection_source = "vless_inbound_log" if vless_activity.get("recent") else "vless_seen"
    blockers = []
    warnings = []
    if not enabled:
        blockers.append("user_disabled")
    if not artifacts_ready:
        blockers.append("client_config_missing")
    if enabled and artifacts_ready and not smart_profile_ready:
        blockers.append("ru_local_smart_profile_missing_or_invalid")
    blockers.extend(profile_connection.get("blockers") or [])
    if not desired_ok:
        warnings.append("desired_state_needs_check")
    if not route_ok:
        blockers.append("route_or_leak_check_failed")
    if not connected:
        warnings.append("waiting_for_first_client_connection")
    for warning in profile_connection.get("warnings") or []:
        if warning == "vless_connection_seen_not_recent":
            continue
        if warning not in warnings:
            warnings.append(warning)
    if blockers:
        status = "BLOCKED"
    elif warnings:
        status = "WAITING"
    else:
        status = "READY"
    next_action = user_next_action(
        enabled=enabled,
        artifacts_ready=artifacts_ready,
        ru_local_ready=smart_profile_ready,
        route_ok=route_ok,
        leak_risk=bool((route or {}).get("leak_risk")),
        desired_ok=desired_ok,
        connected=connected,
    )
    if "multiple_vless_profiles_for_user" in blockers:
        next_action = {
            "code": "revoke_old_vless_profiles",
            "label": "Убрать старые VLESS-профили",
            "plain": "У пользователя найдено несколько VLESS-идентичностей. Оставьте один актуальный профиль и удалите старые записи из runtime.",
            "primary": "identity",
        }
    elif "active_vless_profile_not_in_runtime" in blockers:
        next_action = {
            "code": "refresh_vless_runtime_profile",
            "label": "Обновить VLESS runtime",
            "plain": "Телефон подключается профилем, которого нет в актуальном runtime. Перевыпустите профиль или обновите runtime.",
            "primary": "generate_karing_universal",
        }
    return {
        "status": status,
        "enabled": enabled,
        "artifacts_ready": artifacts_ready,
        "ru_local_profile_ready": smart_profile_ready,
        "universal_profile_ready": universal_ready,
        "universal_profile": {
            "adapter": "karing",
            "mode": "ABROAD_RU_VIA_V7",
            "ready": bool(universal_profile.get("ready")),
            "validation": universal_validation,
            "download_url": universal_profile.get("download_url", ""),
        },
        "ru_local_profile": {
            "adapter": "karing",
            "mode": "RU_LOCAL",
            "ready": bool(ru_local_profile.get("ready")),
            "validation": ru_local_validation,
            "download_url": ru_local_profile.get("download_url", ""),
        },
        "connected": connected,
        "connection_source": connection_source,
        "handshake": handshake,
        "vless_activity": vless_activity,
        "profile_connection": profile_connection,
        "agent_online": agent_online,
        "route_ok": route_ok,
        "leak_risk": bool((route or {}).get("leak_risk")),
        "desired_state": desired,
        "desired_ok": desired_ok,
        "desired_note": desired_note,
        "blockers": blockers,
        "warnings": warnings,
        "next_action": next_action,
        "plain": {
            "READY": "Профиль выдан, маршрут правильный, недавнее подключение видно.",
            "WAITING": "Профиль и маршрут готовы. Ждём подключение или обновление клиента.",
            "BLOCKED": "Клиент не готов. Сначала закройте блокеры в карточке пользователя.",
        }.get(status, "Состояние готовности неизвестно."),
    }


def user_next_action(enabled, artifacts_ready, ru_local_ready, route_ok, leak_risk, desired_ok, connected):
    if not enabled:
        return {
            "code": "enable_user_if_expected",
            "label": "Включить, если это ожидаемо",
            "plain": "Пользователь отключён, поэтому V7 не считает это устройство активным.",
            "primary": "enable_preview",
        }
    if not artifacts_ready:
        return {
            "code": "issue_wireguard_config",
            "label": "Выдать базовый профиль",
            "plain": "Сначала создайте базовый профиль клиента. После этого сгенерируйте стандартный профиль или профиль для поездки.",
            "primary": "issue_profile",
        }
    if not ru_local_ready:
        return {
            "code": "generate_karing_universal",
            "label": "Выдать профиль Karing",
            "plain": "Сгенерируйте профиль Karing: стандартный для обычного использования или поездку для RU через V7.",
            "primary": "generate_karing_universal",
        }
    if leak_risk or not route_ok:
        return {
            "code": "check_route_reality",
            "label": "Проверить маршрут и утечку",
            "plain": "Профиль клиента есть, но фактический маршрут нужно проверить перед статусом “готов”.",
            "primary": "check_user",
        }
    if not connected:
        return {
            "code": "wait_for_client_connection",
            "label": "Ждать подключение клиента",
            "plain": "Всё выдано. Попросите пользователя импортировать профиль и подключиться.",
            "primary": "delivery_history",
        }
    if not desired_ok:
        return {
            "code": "refresh_desired_state",
            "label": "Обновить ожидаемое состояние",
            "plain": "Маршрут выглядит нормально, но служебное ожидаемое состояние нужно обновить.",
            "primary": "check_user",
        }
    return {
        "code": "watch",
        "label": "Готов",
        "plain": "Профиль, маршрут и подключение пользователя выглядят готовыми.",
        "primary": "none",
    }


def user_onboarding_stage(ip, user, readiness, delivery_summary=None):
    readiness = readiness or {}
    delivery_summary = delivery_summary or profile_delivery_summary_for_ip(ip)
    rows = delivery_summary.get("items") or []
    counts = delivery_summary.get("counts") or {}
    latest = profile_delivery_latest(rows)
    active_delivery = int(counts.get("active") or 0)
    downloaded_delivery = int(counts.get("downloaded") or 0)
    enabled = str((user or {}).get("enabled", "1")) == "1"
    artifacts_ready = bool(readiness.get("artifacts_ready"))
    ru_local_ready = bool(readiness.get("ru_local_profile_ready"))
    connected = bool(readiness.get("connected"))
    profile_connection = readiness.get("profile_connection") or {}
    route_ok = bool(readiness.get("route_ok")) and not bool(readiness.get("leak_risk"))

    if not enabled:
        stage = ("disabled", "Отключён", "bad", "Пользователь отключён в реестре.", "Включайте только если это устройство должно быть активным.")
    elif not artifacts_ready:
        stage = ("needs_base_config", "Нужен базовый профиль", "bad", "Базовый профиль клиента отсутствует.", "Выдайте или перевыпустите базовый профиль.")
    elif not ru_local_ready:
        stage = ("needs_smart_profile", "Нужен smart-профиль", "bad", "Клиентский профиль отсутствует или невалиден.", "Сгенерируйте профиль Karing.")
    elif connected and not route_ok:
        stage = ("route_check", "Проверить маршрут", "bad", "Клиент виден, но маршрут или утечку нужно проверить.", "Запустите проверку маршрута пользователя.")
    elif profile_connection.get("status") == "BLOCKED":
        stage = ("profile_conflict", "Конфликт профилей", "bad", profile_connection.get("message") or "Для пользователя найден конфликт VLESS-профилей.", "Отзовите старые профили и выдайте один актуальный профиль.")
    elif ru_local_ready and profile_connection.get("auth_user_count") and not profile_connection.get("recent"):
        stage = ("profile_not_live", "Профиль не виден", "warn", "V7 не видит живое подключение актуального VLESS-профиля.", "Попросите пользователя выбрать свежий профиль Karing или перевыпустите ссылку.")
    elif readiness.get("status") == "READY":
        stage = ("ready", "Готов", "ok", "Профиль, маршрут и недавнее подключение выглядят готовыми.", "Действие не требуется.")
    elif downloaded_delivery and not connected:
        stage = ("downloaded_waiting_connection", "Скачан, ждём", "info", "Пользователь скачал профиль, но V7 ещё не видел подключение.", "Попросите пользователя подключить импортированный профиль.")
    elif active_delivery and not connected:
        stage = ("link_sent", "Ссылка выдана", "info", "Одноразовая ссылка активна и ждёт пользователя.", "Ждите скачивания или перевыпустите ссылку при необходимости.")
    elif not connected:
        stage = ("ready_to_deliver", "Готов к выдаче", "warn", "Профиль готов, но активной или скачанной выдачи не видно.", "Создайте одноразовую ссылку или скачайте профиль.")
    else:
        stage = ("connected_watch", "Подключён", "ok", "Клиент подключён; блокирующих действий нет.", "Наблюдайте обычные показатели здоровья.")

    steps = [
        {"id": "base_config", "label": "Базовый профиль", "ok": artifacts_ready},
        {"id": "smart_profile", "label": "Профиль Karing", "ok": ru_local_ready},
        {"id": "delivery_link", "label": "Ссылка выдачи", "ok": bool(active_delivery or downloaded_delivery)},
        {"id": "downloaded", "label": "Скачан", "ok": bool(downloaded_delivery)},
        {"id": "connected", "label": "Подключён", "ok": connected},
        {"id": "route_ok", "label": "Маршрут OK", "ok": route_ok},
    ]
    return {
        "ip": ip,
        "stage": stage[0],
        "label": stage[1],
        "tone": stage[2],
        "detail": stage[3],
        "next": stage[4],
        "delivery_counts": counts,
        "latest_delivery": latest,
        "steps": steps,
    }


def user_readiness_map(users, route_rows, speed_rows, agents):
    routes = {row.get("ip"): row for row in route_rows or []}
    artifact_rows = client_artifacts_map(users)
    handshakes = wg_handshake_map()
    vless_activities = vless_activity_map()
    proxy_routes = proxy_runtime_user_routes(PROXY_INBOUND_ID)
    desired_rows = desired_state_map()
    agent_rows = (agents.get("agents") or {}) if isinstance(agents, dict) else {}
    result = {}
    for user in users:
        ip = user.get("ip", "")
        if not ip:
            continue
        result[ip] = user_readiness(
            ip,
            user,
            routes.get(ip),
            artifact_rows.get(ip, []),
            (speed_rows or {}).get(ip, {}),
            agent_rows.get(ip),
            handshake=handshakes.get(ip, empty_handshake()),
            desired=desired_rows.get(ip, {}),
            vless_activity=vless_activities.get(ip, empty_vless_activity()),
            proxy_route=proxy_routes.get(ip, {}),
        )
    return result


def user_onboarding_map(users, readiness_map=None):
    readiness_map = readiness_map or {}
    result = {}
    for user in users:
        ip = user.get("ip", "")
        if not ip:
            continue
        result[ip] = user_onboarding_stage(ip, user, readiness_map.get(ip, {}))
    return result


def smart_client_profile_path(client_name, adapter, mode):
    name = safe_client_name(client_name)
    adapter = safe_smart_adapter(adapter)
    mode = safe_smart_mode(mode)
    if not name or not adapter or not mode:
        return None
    suffix = "txt" if adapter == "happ" else ("yaml" if adapter == "karing_wg" else "json")
    path_obj = (SMART_CLIENT_ROOT / name / f"{adapter}-{mode.lower()}.{suffix}").resolve()
    root_resolved = SMART_CLIENT_ROOT.resolve()
    if root_resolved not in path_obj.parents:
        return None
    return path_obj


def domain_matches_suffix(domain, suffixes):
    domain = str(domain or "").lower().strip(".")
    for suffix in suffixes or []:
        suffix = str(suffix or "").lower().strip(".")
        if suffix and (domain == suffix or domain.endswith("." + suffix)):
            return True
    return False


def smart_profile_rule_suffixes(profile, outbound):
    suffixes = []
    for rule in (((profile or {}).get("route") or {}).get("rules") or []):
        if not isinstance(rule, dict) or rule.get("outbound") != outbound:
            continue
        for key in ("domain_suffix", "domain"):
            value = rule.get(key)
            if isinstance(value, str):
                suffixes.append(value.lower().strip("."))
            elif isinstance(value, list):
                suffixes.extend(str(item).lower().strip(".") for item in value if item)
    return sorted(set(item for item in suffixes if item))


def smart_profile_rule_categories(profile, outbound):
    categories = []
    for rule in (((profile or {}).get("route") or {}).get("rules") or []):
        if not isinstance(rule, dict) or rule.get("outbound") != outbound:
            continue
        value = rule.get("geosite")
        if isinstance(value, str):
            categories.append(value.lower().strip())
        elif isinstance(value, list):
            categories.extend(str(item).lower().strip() for item in value if item)
    return sorted(set(item for item in categories if item))


def smart_profile_has_ru_category(profile, outbound):
    suffixes = smart_profile_rule_suffixes(profile, outbound)
    categories = smart_profile_rule_categories(profile, outbound)
    return "ru" in categories or "geosite:ru" in categories or "ru" in suffixes or "xn--p1ai" in suffixes


def smart_profile_domains_match(profile, outbound, domains):
    suffixes = smart_profile_rule_suffixes(profile, outbound)
    domains = [str(item or "").lower().strip(".") for item in domains if item]
    matched = [domain for domain in domains if domain_matches_suffix(domain, suffixes)]
    missing = [domain for domain in domains if domain not in matched]
    return {
        "outbound": outbound,
        "suffixes_count": len(suffixes),
        "samples": domains[:8],
        "matched": matched[:8],
        "missing": missing[:8],
        "ok": bool(domains) and not missing,
    }


def smart_profile_validation(path_obj, adapter, mode):
    adapter = safe_smart_adapter(adapter)
    mode = safe_smart_mode(mode)
    if not path_obj or not Path(path_obj).exists():
        return {
            "status": "MISSING",
            "plain": "Сначала сгенерируйте профиль, потом проверяйте клиентскую маршрутизацию.",
            "checks": [],
        }
    if adapter == "happ":
        return {
            "status": "PROXY_ONLY",
            "plain": "happ subscription is a proxy profile. Domain selectors must be handled by the client or a future happ adapter layer.",
            "checks": [{"id": "profile_format", "status": "WARN", "detail": "VLESS subscription text has no embedded domain rules"}],
        }
    if adapter == "karing_wg" and Path(path_obj).suffix.lower() in {".yaml", ".yml"}:
        try:
            text = Path(path_obj).read_text(encoding="utf-8", errors="replace")
        except OSError:
            text = ""
        checks = [
            {"id": "profile_format", "status": "OK" if "type: wireguard" in text else "BLOCKED", "detail": "Clash YAML с WireGuard-узлом"},
            {"id": "karing_wg_transport_layout", "status": "OK" if "server:" in text and "public-key:" in text and "private-key:" in text else "BLOCKED", "detail": "Karing видит WireGuard как Clash/Mihomo сервер"},
            {"id": "ru_category_client_direct", "status": "OK" if "DOMAIN-SUFFIX,ru,DIRECT" in text and "DOMAIN-SUFFIX,xn--p1ai,DIRECT" in text else "BLOCKED", "detail": "RU-категория идёт напрямую с устройства"},
            {"id": "final_global_route", "status": "OK" if "MATCH,V7 WG" in text or "MATCH,V7" in text or "MATCH,Global mode" in text else "BLOCKED", "detail": "остальной трафик идёт через V7 WG"},
        ]
        status = "OK" if all(row.get("status") == "OK" for row in checks) else "BLOCKED"
        return {
            "status": status,
            "plain": "Karing WG Clash-профиль готов." if status == "OK" else "Karing WG Clash-профиль требует проверки.",
            "mode": mode,
            "adapter": adapter,
            "path": str(path_obj),
            "checks": checks,
            "matches": {
                "ru_direct_category": "DOMAIN-SUFFIX,ru,DIRECT" in text,
                "ru_v7_category": False,
                "ru_selector_category": "RU mode" in text,
            },
        }
    profile = read_json(path_obj, {})
    rules = (((profile or {}).get("route") or {}).get("rules") or [])
    outbound_rows = [(item or {}) for item in ((profile or {}).get("outbounds") or []) if isinstance(item, dict)]
    outbounds = {(item or {}).get("tag") for item in outbound_rows if isinstance(item, dict)}
    endpoints = {(item or {}).get("tag") for item in ((profile or {}).get("endpoints") or []) if isinstance(item, dict)}
    wireguard_outbounds = {
        (item or {}).get("tag")
        for item in outbound_rows
        if isinstance(item, dict) and item.get("type") == "wireguard"
    }
    karing_wg_outbound = next((
        item for item in outbound_rows
        if isinstance(item, dict) and item.get("type") == "wireguard" and item.get("tag") == "v7-wg"
    ), {})
    karing_wg_peers = karing_wg_outbound.get("peers") if isinstance(karing_wg_outbound, dict) else []
    karing_wg_peer_ok = any(
        isinstance(peer, dict) and "0.0.0.0/0" in [str(item) for item in (peer.get("allowed_ips") or [])]
        for peer in (karing_wg_peers or [])
    )
    karing_wg_outbound_ok = bool(
        karing_wg_outbound.get("local_address")
        and karing_wg_outbound.get("private_key")
        and (
            (
                karing_wg_outbound.get("server")
                and karing_wg_outbound.get("server_port")
                and karing_wg_outbound.get("peer_public_key")
            )
            or any(
                isinstance(peer, dict)
                and (peer.get("server") or peer.get("address"))
                and (peer.get("server_port") or peer.get("port"))
                and peer.get("public_key")
                for peer in (karing_wg_peers or [])
            )
        )
        and (not karing_wg_peers or karing_wg_peer_ok)
    )
    karing_wg_endpoint = next((
        item for item in ((profile or {}).get("endpoints") or [])
        if isinstance(item, dict) and item.get("type") == "wireguard" and item.get("tag") == "v7-wg"
    ), {})
    karing_wg_endpoint_peers = karing_wg_endpoint.get("peers") if isinstance(karing_wg_endpoint, dict) else []
    karing_wg_endpoint_ok = bool(
        karing_wg_endpoint.get("address")
        and karing_wg_endpoint.get("private_key")
        and any(
            isinstance(peer, dict)
            and peer.get("address")
            and peer.get("port")
            and peer.get("public_key")
            and "0.0.0.0/0" in [str(item) for item in (peer.get("allowed_ips") or [])]
            for peer in (karing_wg_endpoint_peers or [])
        )
    )
    karing_vless_outbound = next((
        item for item in outbound_rows
        if isinstance(item, dict) and item.get("type") == "vless" and str(item.get("tag") or "").startswith("v7-vless")
    ), {})
    karing_vless_ok = bool(
        karing_vless_outbound.get("tag")
        and karing_vless_outbound.get("server")
        and karing_vless_outbound.get("server_port")
        and valid_uuid(karing_vless_outbound.get("uuid"))
    )
    v7_outbound_tag = karing_vless_outbound.get("tag") if karing_vless_ok else "v7-wg"
    has_v7_endpoint = "v7-wg" in endpoints
    has_v7_outbound = "v7-wg" in outbounds or bool(karing_vless_ok)
    has_deprecated_geosite = any(isinstance(rule, dict) and "geosite" in rule for rule in rules)
    direct_ru_category = smart_profile_has_ru_category(profile, "direct")
    v7_ru_category = smart_profile_has_ru_category(profile, v7_outbound_tag)
    final_route = (((profile or {}).get("route") or {}).get("final") or "")
    dns_final = (((profile or {}).get("dns") or {}).get("final") or "")
    expected_final = "direct" if mode == "ABROAD_RU_VIA_V7" else ("global-mode" if mode == "AUTO_TRAVEL" else v7_outbound_tag)
    checks = [
        {"id": "json_profile", "status": "OK" if isinstance(profile, dict) and bool(profile) else "BLOCKED", "detail": "профиль sing-box загружен"},
        {"id": "v7_endpoint", "status": "OK" if has_v7_endpoint or has_v7_outbound else "BLOCKED", "detail": f"сервер V7: {v7_outbound_tag if karing_vless_ok else 'v7-wg'}"},
        {"id": "direct_outbound", "status": "OK" if "direct" in outbounds else "BLOCKED", "detail": "есть прямой выход с устройства"},
        {"id": "final_global_route", "status": "OK" if final_route == expected_final else "BLOCKED", "detail": f"финальный маршрут={final_route or 'не найден'}"},
        {"id": "rule_count", "status": "OK" if len(rules) >= 3 else "WARN", "detail": f"правил маршрутизации: {len(rules)}"},
        {"id": "no_deprecated_geosite", "status": "OK" if not has_deprecated_geosite else "BLOCKED", "detail": "без geosite: совместимо с sing-box 1.12+" if not has_deprecated_geosite else "geosite удалён в новых sing-box и ломает импорт/проверку"},
    ]
    if adapter == "karing":
        checks.append({
            "id": "karing_transport_layout",
            "status": "OK" if karing_vless_ok or karing_wg_endpoint_ok or karing_wg_outbound_ok else "BLOCKED",
            "detail": "Karing получает VLESS outbound V7" if karing_vless_ok else ("Karing получает современный WireGuard endpoint V7" if karing_wg_endpoint_ok else ("Karing видит WireGuard как сервер в outbounds" if karing_wg_outbound_ok else "Karing должен получить VLESS outbound или WireGuard outbound/endpoint")),
        })
    if adapter == "karing_wg":
        checks.append({
            "id": "karing_wg_transport_layout",
            "status": "OK" if karing_wg_endpoint_ok or karing_wg_outbound_ok else "BLOCKED",
            "detail": "Karing получает совместимый WireGuard outbound V7" if karing_wg_outbound_ok else ("Karing получает современный WireGuard endpoint V7" if karing_wg_endpoint_ok else "Нужен outbounds[].type=wireguard или endpoints[].type=wireguard"),
        })
    if mode == "RU_LOCAL":
        checks.extend([
            {"id": "ru_category_client_direct", "status": "OK" if direct_ru_category else "BLOCKED", "detail": "RU-категория идёт напрямую с устройства"},
            {"id": "dns_route_ready", "status": "OK" if dns_final in ("local", "v7-dns") else "WARN", "detail": f"DNS={dns_final or 'не найден'}"},
        ])
    elif mode == "ABROAD_RU_VIA_V7":
        checks.extend([
            {"id": "ru_category_sent_to_v7", "status": "OK" if v7_ru_category else "BLOCKED", "detail": "RU-категория идёт через V7"},
            {"id": "global_direct_final", "status": "OK" if final_route == "direct" else "BLOCKED", "detail": f"остальной интернет={final_route or 'не найден'}"},
            {"id": "dns_local_first", "status": "OK" if dns_final == "local" else "WARN", "detail": f"DNS={dns_final or 'не найден'}"},
        ])
    elif mode == "STRICT_V7":
        checks.append({"id": "all_traffic_sent_to_v7", "status": "WARN" if final_route == v7_outbound_tag else "BLOCKED", "detail": "весь трафик идёт через V7"})
    elif mode == "AUTO_TRAVEL":
        selector_tags = {item.get("tag") for item in ((profile or {}).get("outbounds") or []) if isinstance(item, dict) and item.get("type") == "selector"}
        ru_selector_ready = smart_profile_has_ru_category(profile, "ru-mode")
        checks.extend([
            {"id": "travel_selectors", "status": "OK" if {"ru-mode", "global-mode"}.issubset(selector_tags) else "BLOCKED", "detail": "есть переключатели: RU и остальной интернет"},
            {"id": "ru_selector_category", "status": "OK" if ru_selector_ready else "BLOCKED", "detail": "RU-категория идёт в переключатель RU"},
            {"id": "global_selector_default", "status": "OK" if final_route == "global-mode" else "BLOCKED", "detail": "остальной интернет идёт в переключатель глобального трафика"},
        ])
    blocked = [row for row in checks if row.get("status") == "BLOCKED"]
    warn = [row for row in checks if row.get("status") == "WARN"]
    status = "BLOCKED" if blocked else ("WARN" if warn else "OK")
    if status == "OK" and mode == "RU_LOCAL":
        plain = "Профиль отправляет RU, Госуслуги и банки напрямую с устройства, а глобальный и видео-трафик ведёт через V7."
    elif mode in ("ABROAD_RU_VIA_V7", "STRICT_V7") and status != "BLOCKED":
        plain = "Профиль “Поездка” отправляет RU через V7, а всё не-RU выпускает напрямую через сеть пользователя."
    elif mode == "AUTO_TRAVEL" and status != "BLOCKED":
        plain = "Универсальный профиль готов: в клиенте можно выбрать режим для России или поездки без перевыпуска профиля."
    else:
        plain = "Профиль требует проверки перед тем, как считать клиентскую маршрутизацию готовой."
    return {
        "status": status,
        "plain": plain,
        "mode": mode,
        "adapter": adapter,
        "path": str(path_obj),
        "checks": checks,
        "matches": {
            "ru_direct_category": direct_ru_category,
            "ru_v7_category": v7_ru_category,
            "ru_selector_category": smart_profile_has_ru_category(profile, "ru-mode"),
        },
    }


