def normalize_path_ingress_type(value):
    text = str(value or "").strip().lower()
    if text == "wg":
        return "wireguard"
    if text == "awg":
        return "amneziawg"
    return text if text in {"vless", "wireguard", "amneziawg", "unknown"} else ""


def infer_client_speed_ingress(ip):
    ip = safe_user_ip(ip)
    pref = smart_client_preference_for_ip(ip) if ip else {}
    adapter = safe_smart_adapter((pref or {}).get("adapter", ""))
    proxy_route = proxy_runtime_user_routes(PROXY_INBOUND_ID).get(ip, {}) if ip else {}
    if proxy_route.get("primary_egress") or proxy_route.get("auth_users"):
        return "vless", adapter or "karing"
    if adapter in ("happ", "hiddify"):
        return "vless", adapter
    if adapter == "karing" and adapter_uses_karing_vless("karing"):
        return "vless", adapter
    if adapter == "karing_wg":
        return "wireguard", adapter
    if ip.startswith("10.7."):
        return "amneziawg", adapter or "awg"
    if ip.startswith("10.0."):
        return "wireguard", adapter or "wg"
    return "unknown", adapter


