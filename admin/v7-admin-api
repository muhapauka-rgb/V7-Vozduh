    for row in rows:
        user = conn.execute(
            "SELECT display_name, phone_normalized, max_devices FROM identity_users WHERE id=?",
            (row.get("user_id", ""),),
        ).fetchone()
        if user:
            row["user_display_name"] = user["display_name"]
            row["phone_normalized"] = user["phone_normalized"]
            row["user_max_devices"] = user["max_devices"]
    return rows


def identity_refresh_pending_profiles(conn):
    now_epoch = time.time()
    now = now_iso()
    conn.execute(
        """
        UPDATE pending_profiles
        SET status='expired', expired_at=?, updated_at=?
        WHERE status='pending' AND expires_at_epoch > 0 AND expires_at_epoch < ?
        """,
        (now, now, now_epoch),
    )


def identity_pending_profiles(conn, limit=200):
    identity_refresh_pending_profiles(conn)
    rows = identity_rows(
        conn,
        """
        SELECT * FROM pending_profiles
        ORDER BY
          CASE status WHEN 'pending' THEN 0 WHEN 'activated' THEN 1 ELSE 2 END,
          expires_at_epoch DESC
        LIMIT ?
        """,
        (max(1, min(int(limit or 200), 500)),),
    )
    now_epoch = time.time()
    for row in rows:
        expires_at = float(row.get("expires_at_epoch") or 0)
        row["expires_in_sec"] = max(0, int(expires_at - now_epoch)) if row.get("status") == "pending" and expires_at else 0
        row["is_active_pending"] = row.get("status") == "pending"
    return rows


