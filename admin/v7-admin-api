      const dyn = plan.dynamic_load || {};
      const safety = plan.safety?.anti_flap || {};
      const decisions = (plan.decisions || []).slice(0, 18);
      const rows = decisions.map(d => {
        const exp = d.explanation || {};
        const why = (exp.why || d.reason || []).slice(0, 5).join('; ');
        const rejected = (exp.rejected || []).slice(0, 4).map(r => `${r.egress}: ${r.reason}`).join('; ');
        return `<tr><td><strong>${esc(d.user_ip || '')}</strong><br><span class="muted">${esc(d.group || 'default')}</span></td><td>${esc(d.current_egress || '')}</td><td>${esc(d.recommended_egress || '')}<br>${pill(exp.confidence || d.move_type || 'check', exp.confidence === 'high' ? 'ok' : 'info')}</td><td>${esc(why || 'нет объяснения')}</td><td>${esc(rejected || 'нет блокировок')}</td></tr>`;
      });
      return [
        drawerSection('Сводка', kvRows({
          'Статус': plan.enabled === false ? 'выключен' : (plan.mode || 'guarded'),
          'Пользователи': summary.users_total ?? 0,
          'Каналы': `${summary.healthy_egress_total ?? dyn.healthy_channels ?? 0}/${summary.egress_total ?? dyn.total_channels ?? 0}`,
