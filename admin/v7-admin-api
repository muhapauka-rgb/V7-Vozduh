def runtime_drift_records(limit=120):
    state = read_json(STATE_DIR / "v7-state.json", {})
    users = state.get("users") or parse_registry(STATE_DIR / "users.registry")
    active_users = [u for u in users if str(u.get("enabled", "1")) == "1"]
    records = []
    state_age = file_age(STATE_DIR / "v7-state.json")
    if state_age is None:
        records.append({
            "drift_id": "runtime-state-missing",
            "severity": "bad",
            "status": "RUNTIME_UNKNOWN",
            "summary": "Runtime snapshot отсутствует.",
            "next_action": "Запустить диагностику и проверить сервисы состояния.",
            "source": "v7-state.json",
            "detected_at": now_iso(),
        })
    elif state_age > 180:
        records.append({
            "drift_id": "runtime-state-stale",
            "severity": "warn",
            "status": "RUNTIME_WARNING",
            "summary": f"Runtime snapshot устарел: {state_age}s.",
            "next_action": "Обновить диагностику перед принятием решений.",
            "source": "v7-state.json",
            "detected_at": now_iso(),
        })

    route_rows = route_status(active_users[:80]) if active_users else []
    mismatches = [row for row in route_rows if not row.get("ok")]
    leaks = [row for row in route_rows if row.get("leak_risk")]
    if leaks:
        records.append({
            "drift_id": "route-leak-risk",
            "severity": "bad",
            "status": "RUNTIME_BLOCKING",
            "summary": f"Обнаружен риск прямой утечки маршрута: {len(leaks)} пользователей.",
            "next_action": "Открыть Проверки → Защита от утечки и не выполнять movement.",
            "source": "route_get",
            "affected_users": [row.get("ip") for row in leaks if row.get("ip")],
            "detected_at": now_iso(),
        })
    elif mismatches:
        records.append({
            "drift_id": "route-reality-mismatch",
            "severity": "warn",
            "status": "RUNTIME_DRIFT",
            "summary": f"Route reality расходится с registry: {len(mismatches)} пользователей.",
            "next_action": "Открыть Маршруты и сверить доказательства перед proposal.",
            "source": "route_get",
            "affected_users": [row.get("ip") for row in mismatches[:20] if row.get("ip")],
            "detected_at": now_iso(),
        })

    killswitch = run_readonly(["v7-killswitch-check"], timeout=8)
    kill_state = killswitch_summary(killswitch)
    if not kill_state.get("ok"):
        records.append({
            "drift_id": "killswitch-not-ok",
            "severity": "bad",
            "status": "RUNTIME_BLOCKING",
            "summary": "Защита от утечки не подтверждает нормальное состояние.",
            "next_action": "Проверить Безопасность и не выполнять routing changes.",
            "source": "v7-killswitch-check",
            "detected_at": now_iso(),
        })

    egress_registry = parse_registry(STATE_DIR / "egress.registry")
    readiness_rows = []
    for row in egress_registry[:80]:
        egress_id = row.get("id", "")
        if not egress_id:
            continue
        rd = egress_runtime_readiness(egress_id, row)
        if str(rd.get("status", "")).upper() in ("BLOCKED", "WARN", "WARNING"):
            readiness_rows.append({"id": egress_id, "status": rd.get("status"), "reason": rd.get("reason") or rd.get("plain") or ""})
    if readiness_rows:
        records.append({
            "drift_id": "egress-runtime-readiness",
            "severity": "warn",
            "status": "RUNTIME_WARNING",
            "summary": f"У {len(readiness_rows)} каналов есть runtime readiness предупреждения.",
            "next_action": "Открыть Каналы или Проверки перед выбором target.",
            "source": "egress_runtime_readiness",
            "items": readiness_rows[:12],
            "detected_at": now_iso(),
        })

    proxy_runtime = proxy_runtime_state()
    if proxy_runtime.get("needs_refresh"):
        records.append({
            "drift_id": "proxy-runtime-needs-refresh",
            "severity": "warn",
            "status": "RUNTIME_WARNING",
            "summary": "Proxy runtime требует refresh по данным read-only проверки.",
            "next_action": "Открыть Проверки и сверить inbound runtime перед изменениями.",
            "source": "proxy_runtime",
            "detected_at": now_iso(),
        })
    return records[:limit]


def runtime_status_from_drift(records, fingerprint_status="OK"):
    severities = {str(row.get("severity", "")).lower() for row in records}
    statuses = {str(row.get("status", "")).upper() for row in records}
    if fingerprint_status == "UNKNOWN" or "RUNTIME_UNKNOWN" in statuses:
        return "RUNTIME_UNKNOWN"
    if "bad" in severities or "RUNTIME_BLOCKING" in statuses:
        return "RUNTIME_BLOCKING"
    if "RUNTIME_DRIFT" in statuses:
        return "RUNTIME_DRIFT"
    if records or fingerprint_status == "STALE":
        return "RUNTIME_WARNING"
    return "RUNTIME_OK"


def runtime_convergence_response(query=None, include_advanced=False):
    fingerprint = runtime_fingerprint_response(include_advanced=include_advanced)
    drift = [
        attach_operational_metadata(row, "runtime", row.get("drift_id", ""), RUNTIME_TRUST_FRESH_TTL_SECONDS, ts_fields=("detected_at", "ts"))
        for row in runtime_drift_records()
    ]
    drift = apply_operational_filters(drift, query or {}, ts_fields=("detected_at", "ts"))
    runtime_status = runtime_status_from_drift(drift, fingerprint.get("status", "OK"))
    history = read_jsonl_records(RUNTIME_TRUST_STORE_FILE, limit=80)
    current = {
        "ts": now_iso(),
        "status": runtime_status,
        "summary": RUNTIME_TRUST_LABELS.get(runtime_status, "Состояние runtime неизвестно"),
        "drift_count": len(drift),
        "source": "generated_runtime_trust",
    }
    current = attach_operational_metadata(current, "runtime", "current", RUNTIME_TRUST_FRESH_TTL_SECONDS, ts_fields=("ts",))
    verification_history = [current] + list(reversed(history[-20:]))
    payload = {
        "runtime_status": runtime_status,
        "operator_status_text": RUNTIME_TRUST_LABELS.get(runtime_status, "Состояние runtime неизвестно"),
        "fingerprint_summary": fingerprint.get("summary", {}),
        "fingerprint_components": fingerprint.get("components", []),
        "drift_records": drift,
        "drift_count": len(drift),
        "verification_history": verification_history,
        "lineage_references": [
            evidence_link("system", "overview", "Runtime overview"),
            evidence_link("check", "diagnostics", "Diagnostics evidence"),
            evidence_link("release", "current", "Release trust"),
        ],
        "read_only": True,
        "non_authoritative": True,
        "execution_allowed": False,
        "storage_backend": "jsonl",
        "storage_path": str(RUNTIME_TRUST_STORE_FILE),
        "generated_sources": ["registries", "route_get", "checks", "runtime_readiness", "overview_data"],
        "freshness_model": {"ttl_seconds": RUNTIME_TRUST_FRESH_TTL_SECONDS, "states": sorted(FRESHNESS_STATES)},
        "retention_model": {"retention_days": HARDENING_RETENTION_DAYS, "state": "visible"},
        "closure_model": {"enabled": True, "states": sorted(CLOSURE_STATES), "store": str(CLOSURE_STORE_FILE)},
    }
    payload.update(closure_for("runtime", "current", default_state="OPEN"))
    payload.update(freshness_model(current.get("ts"), RUNTIME_TRUST_FRESH_TTL_SECONDS))
    payload.update(retention_model(current.get("ts")))
    return payload


