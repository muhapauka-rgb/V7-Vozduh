    function channelOperatorStatus(d={}) {
      const reg = d.registry || {};
      const st = d.state || {};
      const rd = d.runtime_readiness || {};
      const matrix = d.service_matrix || {};
      const serverSpeed = d.server_speed || {};
      const clientSpeed = d.client_speed || {};
      const assigned = d.assigned_users || [];
      const enabled = String(reg.enabled ?? (d.pool_state === 'enabled' ? '1' : '0')) !== '0';
      const healthOk = String(st.code || '') === '200' || String(st.diagnose_severity || '').toUpperCase() === 'OK' || String(st.status || '').toUpperCase() === 'OK';
      const matrixTotal = Number(matrix.total || matrix.count || Object.keys(matrix.services || matrix.items || {}).length || 0);
      const matrixOk = Number(matrix.ok_count || 0);
      const matrixReady = matrixTotal > 0 && matrixOk >= Math.max(1, matrixTotal);
      const speedOk = !!(serverSpeed.server_v7_mbps || serverSpeed.download_mbps || clientSpeed.client_v7_avg_mbps);
      const runtimeReady = !!rd.enable_ready || String(rd.status || '').toUpperCase() === 'READY';
      const usersCount = assigned.length;
      let verdict = 'Нет свежих данных';
      let tone = 'warn';
      if (!enabled) { verdict = 'Выключен'; tone = 'warn'; }
      else if (!healthOk) { verdict = 'Есть проблема'; tone = 'bad'; }
      else if (healthOk && (matrixReady || !matrixTotal) && runtimeReady) { verdict = 'Готов к работе'; tone = 'ok'; }
      else if (healthOk) { verdict = 'Работает, но не всё проверено'; tone = 'warn'; }
      return {enabled, healthOk, matrixTotal, matrixOk, matrixReady, speedOk, runtimeReady, usersCount, verdict, tone};
    }
