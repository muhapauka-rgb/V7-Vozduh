def create_profile_delivery(ip, adapter, mode, actor, ttl_seconds=None):
    conf = wg_conf_for_user_ip(ip)
    if not conf and adapter != "happ" and not adapter_uses_karing_vless(adapter):
        return None, {"error": "wireguard_client_config_not_found", "ip": ip}
    name = smart_client_name_for_ip(ip, adapter)
    path_obj = smart_client_profile_path(name, adapter, mode)
    if not path_obj or not path_obj.exists():
        return None, {"error": "smart_profile_not_found", "message": "Сначала сгенерируйте профиль, затем создавайте ссылку выдачи."}
    token = b64e(secrets.token_bytes(32))
    created_epoch = time.time()
    try:
        ttl = int(ttl_seconds or PROFILE_DELIVERY_TTL_SECONDS)
    except (TypeError, ValueError):
        ttl = PROFILE_DELIVERY_TTL_SECONDS
    ttl = max(60, min(ttl, 86400 * 7))
    expires_epoch = created_epoch + ttl
    data = profile_delivery_prune()
    delivery_id = profile_delivery_id(token)
    data.setdefault("tokens", {})[token] = {
        "delivery_id": delivery_id,
        "ip": ip,
        "client": name,
        "adapter": adapter,
        "mode": mode,
        "profile_path": str(path_obj),
        "created_at": now_iso(),
        "created_at_epoch": created_epoch,
        "expires_at_epoch": expires_epoch,
        "ttl_seconds": ttl,
        "created_by": actor or "admin",
        "downloaded_at": "",
    }
    data["updated"] = now_iso()
    write_json_atomic(PROFILE_DELIVERY_FILE, data)
    return profile_delivery_result(token, data["tokens"][token]), None


def consume_profile_delivery(token):
    token = safe_delivery_token(token)
    if not token:
        return None, {"error": "invalid_delivery_token"}
    data = profile_delivery_prune()
    row = (data.get("tokens") or {}).get(token)
    if not isinstance(row, dict) or row.get("expired"):
        return None, {"error": "delivery_token_not_found_or_expired"}
    if float(row.get("expires_at_epoch") or 0) < time.time():
        row["expired"] = True
        row.pop("profile_path", None)
        data["updated"] = now_iso()
        write_json_atomic(PROFILE_DELIVERY_FILE, data)
        return None, {"error": "delivery_token_expired"}
    path_obj = Path(row.get("profile_path", "")).resolve()
    root_resolved = SMART_CLIENT_ROOT.resolve()
    if root_resolved not in path_obj.parents or not path_obj.exists():
        return None, {"error": "delivery_profile_missing"}
    row["downloaded_at"] = row.get("downloaded_at") or now_iso()
    row["last_downloaded_at"] = now_iso()
    row["download_count"] = int(row.get("download_count") or 0) + 1
    data["updated"] = now_iso()
    write_json_atomic(PROFILE_DELIVERY_FILE, data)
    return {"row": row, "path": path_obj}, None


def profile_delivery_qr_svg(handler, token, target="import"):
    row, error = profile_delivery_active_row(token)
    if error:
        return None, error
    qrencode = shutil.which("qrencode")
    if not qrencode:
        return None, {
            "error": "qr_generator_not_installed",
            "message": "На сервере не установлен qrencode. Установите пакет qrencode и повторите генерацию QR.",
        }
    delivery_url = profile_delivery_qr_payload(token, row, target=target)
    try:
        result = subprocess.run(
            [qrencode, "-t", "SVG", "-o", "-", delivery_url],
            check=False,
            capture_output=True,
            text=True,
            timeout=8,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        return None, {"error": "qr_generator_failed", "message": str(exc)}
    if result.returncode != 0 or not result.stdout.strip():
        return None, {
            "error": "qr_generator_failed",
            "message": result.stderr.strip() or "qrencode did not return SVG",
        }
    return result.stdout.encode("utf-8"), None


