def execution_preview_consistency():
    drafts = execution_contract_drafts()
    validation = [execution_validation_preview_for_draft(d) for d in drafts]
    verification = [execution_verification_preview_for_draft(d) for d in drafts]
    rollback = [execution_rollback_preview_for_draft(d) for d in drafts]
    issues = []
    for draft in drafts:
        if not draft.get("proposal_references"):
            issues.append({"draft_id": draft.get("draft_id", ""), "issue": "proposal_reference_missing"})
        if not draft.get("evidence_references"):
            issues.append({"draft_id": draft.get("draft_id", ""), "issue": "evidence_reference_missing"})
        if draft.get("action_type") != "OBSERVE" and not draft.get("target"):
            issues.append({"draft_id": draft.get("draft_id", ""), "issue": "target_missing"})
        if draft.get("movement_budget", 0) != len(draft.get("affected_users") or []):
            issues.append({"draft_id": draft.get("draft_id", ""), "issue": "movement_budget_mismatch"})
    status = "FAIL" if any((item.get("status") == "FAIL") for item in validation + verification + rollback) or issues else ("REVIEW_REQUIRED" if any((item.get("status") in {"UNKNOWN", "REVIEW_REQUIRED"}) for item in validation) else "PASS")
    return {
        "status": status,
        "drafts_count": len(drafts),
        "issues": issues,
        "proposal_to_contract": not any(i.get("issue") == "proposal_reference_missing" for i in issues),
        "authority_to_contract": True,
        "evaluator_to_validation": True,
        "conflict_resolver_to_validation": True,
        "contract_to_verification": True,
        "contract_to_rollback": True,
        "fail_closed": status == "FAIL",
        "read_only": True,
        "preview_only": True,
    }


