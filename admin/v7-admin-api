PROPOSAL_OBJECT_TYPES = {"user", "channel", "route", "alert", "proposal", "release", "backup", "restore", "check", "log", "system"}
PROPOSAL_TYPES = {"MOVEMENT_PROPOSAL", "EVACUATION_PROPOSAL", "REBALANCE_PROPOSAL", "OBSERVATION"}
PROPOSAL_STATUS_VALUES = {"DRAFT", "OBSERVED", "ACTIVE", "REVIEW_REQUIRED", "EXPIRED", "SUPERSEDED", "CLOSED"}
PROPOSAL_CONFIDENCE_VALUES = {"LOW", "MEDIUM", "HIGH", "VERY_HIGH"}
PROPOSAL_SEVERITY_VALUES = {"info", "warn", "bad", "ok"}
PROPOSAL_GOVERNANCE_PATH = [
    {"step": "Batch", "status": "future_gate", "summary": "Будущий batch задаёт границы действия."},
    {"step": "Policy", "status": "future_gate", "summary": "Policy допускает или отклоняет proposal."},
    {"step": "Capacity", "status": "future_gate", "summary": "Capacity ограничивает размер batch и target."},
    {"step": "Concurrency", "status": "future_gate", "summary": "Locks/резервы исключают гонки."},
    {"step": "Scheduling", "status": "future_gate", "summary": "Scheduler выбирает окно выполнения."},
    {"step": "Execution", "status": "not_allowed", "summary": "Proposal сам ничего не выполняет."},
]


def proposal_record(proposal_id, proposal_type, status, confidence, severity, reason, *, affected_users=None, current_target="", proposed_target="", required_services=None, evidence_bundle_id="", expected_benefit="", rollback_hint="", object_links=None, timeline=None, source="generated", created_at=None, updated_at=None):
    evidence_bundle_id = safe_evidence_token(evidence_bundle_id, "")
    if not evidence_bundle_id:
        return None
    proposal_type = str(proposal_type or "OBSERVATION").upper()
    status = str(status or "OBSERVED").upper()
    confidence = str(confidence or "MEDIUM").upper()
    severity = str(severity or "info").lower()
    record = {
        "proposal_id": safe_evidence_token(proposal_id, evidence_hash("proposal", proposal_type, evidence_bundle_id, reason)),
        "proposal_type": proposal_type if proposal_type in PROPOSAL_TYPES else "OBSERVATION",
        "status": status if status in PROPOSAL_STATUS_VALUES else "OBSERVED",
        "confidence": confidence if confidence in PROPOSAL_CONFIDENCE_VALUES else "MEDIUM",
        "severity": severity if severity in PROPOSAL_SEVERITY_VALUES else "info",
        "reason": redact(str(reason or "")),
        "affected_users": [safe_evidence_token(user, "") for user in (affected_users or []) if safe_evidence_token(user, "")],
        "current_target": safe_evidence_token(current_target, ""),
        "proposed_target": safe_evidence_token(proposed_target, ""),
        "required_services": [safe_evidence_token(service, "") for service in (required_services or []) if safe_evidence_token(service, "")],
        "evidence_bundle_id": evidence_bundle_id,
        "expected_benefit": redact(str(expected_benefit or "")),
        "rollback_hint": redact(str(rollback_hint or "")),
        "created_at": created_at or now_iso(),
        "updated_at": updated_at or created_at or now_iso(),
        "source": str(source or "generated"),
        "object_links": object_links if isinstance(object_links, list) else [],
        "timeline": timeline if isinstance(timeline, list) else [],
        "governance_path": PROPOSAL_GOVERNANCE_PATH,
        "read_only": True,
        "non_authoritative": True,
        "execution_allowed": False,
    }
    existing = {(l.get("object_type"), l.get("object_id")) for l in record["object_links"] if isinstance(l, dict)}
    evidence_link_row = {"object_type": "evidence", "object_id": evidence_bundle_id, "label": "evidence_bundle"}
    if ("evidence", evidence_bundle_id) not in existing:
        record["object_links"].insert(0, evidence_link_row)
    proposal_link_row = {"object_type": "proposal", "object_id": record["proposal_id"], "label": "proposal"}
    if ("proposal", record["proposal_id"]) not in {(l.get("object_type"), l.get("object_id")) for l in record["object_links"] if isinstance(l, dict)}:
        record["object_links"].insert(0, proposal_link_row)
    return redact(record)


def normalize_proposal_record(row):
    if not isinstance(row, dict):
        return None
    return proposal_record(
        row.get("proposal_id") or row.get("id") or evidence_hash("proposal", row.get("proposal_type"), row.get("evidence_bundle_id"), row.get("reason")),
        row.get("proposal_type") or "OBSERVATION",
        row.get("status") or "OBSERVED",
        row.get("confidence") or "MEDIUM",
        row.get("severity") or "info",
        row.get("reason") or "",
        affected_users=row.get("affected_users") or [],
        current_target=row.get("current_target") or "",
        proposed_target=row.get("proposed_target") or "",
        required_services=row.get("required_services") or [],
        evidence_bundle_id=row.get("evidence_bundle_id") or "",
        expected_benefit=row.get("expected_benefit") or "",
        rollback_hint=row.get("rollback_hint") or "",
        object_links=row.get("object_links") or row.get("links") or [],
        timeline=row.get("timeline") or [],
        source=row.get("source") or "store",
        created_at=row.get("created_at") or now_iso(),
        updated_at=row.get("updated_at") or row.get("created_at") or now_iso(),
    )


def proposal_store_records():
    if not PROPOSAL_STORE_FILE.exists():
        return []
    records = []
    try:
        for line in PROPOSAL_STORE_FILE.read_text(encoding="utf-8", errors="replace").splitlines():
            if not line.strip():
                continue
            try:
                item = normalize_proposal_record(json.loads(line))
                if item:
                    records.append(item)
            except (TypeError, ValueError, json.JSONDecodeError):
                continue
    except OSError:
        return []
    return records


def evidence_bundle_by_id(bundle_id):
    safe_id = safe_evidence_token(bundle_id, "")
    for bundle in all_evidence_bundles():
        if bundle.get("bundle_id") == safe_id:
            return bundle
    return None


def evidence_id_for_object(object_type, object_id, fallback=""):
    object_type = safe_evidence_token(object_type, "").lower()
    object_id = safe_evidence_token(object_id, "")
    for bundle in all_evidence_bundles():
        if str(bundle.get("object_type", "")).lower() == object_type and str(bundle.get("object_id", "")) == object_id:
            return bundle.get("bundle_id", "")
    for bundle in all_evidence_bundles():
        if evidence_matches_object(bundle, object_type, object_id):
            return bundle.get("bundle_id", "")
    return safe_evidence_token(fallback, "")


def proposal_timeline_from_evidence(evidence_id, status="OBSERVED", summary=""):
    bundle = evidence_bundle_by_id(evidence_id) or {}
    timeline = []
    if bundle.get("updated_at"):
        timeline.append({
            "ts": bundle.get("updated_at"),
            "title": "Доказательство собрано",
            "status": bundle.get("status") or "OBSERVED",
            "summary": bundle.get("summary") or "",
            "source": bundle.get("source") or "evidence",
        })
    timeline.append({
        "ts": now_iso(),
        "title": "Proposal сформирован",
        "status": status,
        "summary": summary or "Рекомендация доступна только для чтения.",
        "source": "proposal_generator",
    })
    return timeline


def generated_proposals(limit=160):
    state = read_json(STATE_DIR / "v7-state.json", {})
    users = state.get("users") or parse_registry(STATE_DIR / "users.registry")
    active_users = [u for u in users if str(u.get("enabled", "1")) == "1"]
    users_by_ip = {u.get("ip", ""): u for u in active_users if u.get("ip")}
    egress_registry = parse_registry(STATE_DIR / "egress.registry")
    egress_by_id = {row.get("id", ""): row for row in egress_registry if row.get("id")}
    egress_state = state.get("egress", {}) if isinstance(state.get("egress"), dict) else {}
    matrix = service_matrix_state()
    prefs = service_preferences_state()
    recommendations = service_recommendations(active_users, matrix, prefs)
    route_rows = route_status(active_users[:80]) if active_users else []
    route_by_ip = {row.get("ip", ""): row for row in route_rows if row.get("ip")}
    assigned = {}
    for user in active_users:
        assigned.setdefault(user.get("current", ""), []).append(user.get("ip", ""))

    proposals = []
    route_evidence_id = evidence_id_for_object("route", "reality", "evidence-route-reality")
    service_rows = recommendations.get("user_required_routes") or []
    for row in service_rows:
        ip = row.get("ip", "")
        if not ip or ip not in users_by_ip:
            continue
        status = row.get("recommendation_status") or ""
        evidence_id = evidence_id_for_object("user", ip, route_evidence_id)
        required = row.get("required_services") or []
        if status == "SWITCH_AVAILABLE" and row.get("recommended_egress"):
            proposals.append(proposal_record(
                evidence_hash("proposal-move", ip, row.get("current_egress"), row.get("recommended_egress"), evidence_id),
                "MOVEMENT_PROPOSAL",
                "REVIEW_REQUIRED",
                "HIGH",
                "warn",
                f"Для обязательных сервисов пользователя {ip} найден более подходящий канал.",
                affected_users=[ip],
                current_target=row.get("current_egress") or users_by_ip[ip].get("current", ""),
                proposed_target=row.get("recommended_egress") or "",
                required_services=required,
                evidence_bundle_id=evidence_id,
                expected_benefit="Повысить вероятность доступа к выбранным в админке обязательным сервисам без автоматического movement.",
                rollback_hint=f"{ip} возвращается на {row.get('current_egress') or users_by_ip[ip].get('current', '')} через governance rollback.",
                object_links=[evidence_link("user", ip), evidence_link("route", "reality"), evidence_link("channel", row.get("recommended_egress") or "")],
                timeline=proposal_timeline_from_evidence(evidence_id, "REVIEW_REQUIRED", "Найден target-кандидат по service matrix."),
            ))
        elif status == "NO_EGRESS_MATCHES_REQUIRED_SERVICES":
            proposals.append(proposal_record(
                evidence_hash("proposal-observe-services", ip, ",".join(required), evidence_id),
                "OBSERVATION",
                "ACTIVE",
                "MEDIUM",
                "warn",
                f"Для обязательных сервисов пользователя {ip} не найден полностью подходящий канал.",
                affected_users=[ip],
                current_target=row.get("current_egress") or users_by_ip[ip].get("current", ""),
                proposed_target="",
                required_services=required,
                evidence_bundle_id=evidence_id,
                expected_benefit="Показать оператору, что перед movement нужны свежие данные service matrix или отдельный канал.",
                rollback_hint="Movement не предлагается; rollback не требуется.",
                object_links=[evidence_link("user", ip), evidence_link("route", "reality")],
                timeline=proposal_timeline_from_evidence(evidence_id, "ACTIVE", "Service matrix не даёт безопасного кандидата."),
            ))

    route_mismatches = [row for row in route_rows if not row.get("ok") or row.get("leak_risk")]
    if route_mismatches:
        affected = [row.get("ip", "") for row in route_mismatches[:20] if row.get("ip")]
        proposals.append(proposal_record(
            evidence_hash("proposal-route-review", ",".join(affected), route_evidence_id),
            "MOVEMENT_PROPOSAL",
            "REVIEW_REQUIRED",
            "MEDIUM",
            "bad" if any(row.get("leak_risk") for row in route_mismatches) else "warn",
            "Факт маршрутов расходится с ожидаемым состоянием; нужен операторский review перед любым movement.",
            affected_users=affected,
            current_target="mixed",
            proposed_target="governance-selected-target",
            required_services=[],
            evidence_bundle_id=route_evidence_id,
            expected_benefit="Свести route reality к ожидаемому состоянию через bounded governance, не запуская автоматическое действие.",
            rollback_hint="Откат каждого пользователя только на его исходный channel из users.registry.",
            object_links=[evidence_link("route", "reality"), *[evidence_link("user", ip) for ip in affected[:8]]],
            timeline=proposal_timeline_from_evidence(route_evidence_id, "REVIEW_REQUIRED", "Route reality ждёт review."),
        ))

    for egress_id, registry in egress_by_id.items():
        evidence_id = evidence_id_for_object("channel", egress_id, "")
        if not evidence_id:
            continue
        st = egress_state.get(egress_id, {}) if isinstance(egress_state, dict) else {}
        users_on_channel = assigned.get(egress_id, [])
        try:
            hard_limit = int(registry.get("hard_limit") or 0)
        except (TypeError, ValueError):
            hard_limit = 0
        code_ok = str(st.get("code", "")) == "200" or str(st.get("diagnose_severity", "")).upper() in ("OK", "")
        if hard_limit and len(users_on_channel) > hard_limit:
            proposals.append(proposal_record(
                evidence_hash("proposal-rebalance", egress_id, len(users_on_channel), hard_limit, evidence_id),
                "REBALANCE_PROPOSAL",
                "REVIEW_REQUIRED",
                "MEDIUM",
                "warn",
                f"Канал {egress_id} выше hard limit: {len(users_on_channel)}/{hard_limit}.",
                affected_users=users_on_channel[:30],
                current_target=egress_id,
                proposed_target="capacity-safe-target",
                required_services=[],
                evidence_bundle_id=evidence_id,
                expected_benefit="Снизить риск превышения лимита назначений через будущий bounded batch.",
                rollback_hint="Каждый movement должен иметь индивидуальный rollback на исходный канал.",
                object_links=[evidence_link("channel", egress_id), *[evidence_link("user", ip) for ip in users_on_channel[:8]]],
                timeline=proposal_timeline_from_evidence(evidence_id, "REVIEW_REQUIRED", "Capacity limit превышен."),
            ))
        elif not code_ok and users_on_channel:
            proposals.append(proposal_record(
                evidence_hash("proposal-evacuate", egress_id, ",".join(users_on_channel[:8]), evidence_id),
                "EVACUATION_PROPOSAL",
                "REVIEW_REQUIRED",
                "MEDIUM",
                "bad",
                f"У канала {egress_id} нет свежего подтверждения состояния; на нём есть пользователи.",
                affected_users=users_on_channel[:30],
                current_target=egress_id,
                proposed_target="healthy-channel-after-policy",
                required_services=[],
                evidence_bundle_id=evidence_id,
                expected_benefit="Подготовить безопасный план эвакуации, если health останется плохим.",
                rollback_hint="Rollback возвращает каждого пользователя на исходный канал только после execution-time recheck.",
                object_links=[evidence_link("channel", egress_id), *[evidence_link("user", ip) for ip in users_on_channel[:8]]],
                timeline=proposal_timeline_from_evidence(evidence_id, "REVIEW_REQUIRED", "Состояние канала ждёт review."),
            ))
        else:
            proposals.append(proposal_record(
                evidence_hash("proposal-channel-observe", egress_id, evidence_id),
                "OBSERVATION",
                "OBSERVED",
                "HIGH" if code_ok else "MEDIUM",
                "info" if code_ok else "warn",
                f"Канал {egress_id} добавлен в наблюдение proposal layer.",
                affected_users=users_on_channel[:30],
                current_target=egress_id,
                proposed_target=egress_id,
                required_services=[],
                evidence_bundle_id=evidence_id,
                expected_benefit="Дать оператору быстрый путь от канала к evidence и будущему governance path.",
                rollback_hint="Movement не предлагается; rollback не требуется.",
                object_links=[evidence_link("channel", egress_id), *[evidence_link("user", ip) for ip in users_on_channel[:8]]],
                timeline=proposal_timeline_from_evidence(evidence_id, "OBSERVED", "Канал наблюдается без runtime-действий."),
            ))

    state_evidence_id = evidence_id_for_object("check", "diagnostics", "evidence-check-state-freshness")
    state_bundle = evidence_bundle_by_id(state_evidence_id) or {}
    if state_bundle:
        proposals.append(proposal_record(
            evidence_hash("proposal-state-observation", state_bundle.get("status"), state_evidence_id),
            "OBSERVATION",
            "ACTIVE" if state_bundle.get("status") != "VERIFIED" else "OBSERVED",
            "HIGH",
            state_bundle.get("severity") or "info",
            "Снимок состояния V7 используется как базовое наблюдение proposal layer.",
            affected_users=[],
            current_target="system",
            proposed_target="system",
            required_services=[],
            evidence_bundle_id=state_evidence_id,
            expected_benefit="Показать, можно ли доверять текущей runtime-картине перед будущими решениями.",
            rollback_hint="Наблюдение не меняет runtime.",
            object_links=[evidence_link("check", "diagnostics"), evidence_link("system", "overview")],
            timeline=proposal_timeline_from_evidence(state_evidence_id, state_bundle.get("status") or "OBSERVED", "System evidence подключён к proposal layer."),
        ))

    return [p for p in proposals if p][:limit]


