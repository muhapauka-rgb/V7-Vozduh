</head>
	<body>
	  <main>
	    <h1>Подключиться</h1>
	    <p class="muted">Введите данные, которые разрешил администратор. VPN-профиль будет выдан отдельным ключом доступа.</p>
	    <div id="connectAsyncResult">{error_html}{result_html}</div>
	    <form method="post" action="/connect" id="connectForm">
      <label>Имя</label>
      <input name="name" required autocomplete="name" value="{name_value}">
      <label>Телефон</label>
      <input name="phone" required inputmode="tel" autocomplete="tel" placeholder="+7 999 123-45-67" value="{phone_value}">
      <label>Организация</label>
      <input name="organization" required autocomplete="organization" list="connectOrganizations" value="{org_value}">
      {org_options}
      <label>Пароль подключения</label>
      <input name="password" type="password" required autocomplete="one-time-code">
      <label>Приложение</label>
      <select name="vpn_client">
        {client_options}
      </select>
      {client_status}
      <input type="hidden" name="mode" value="RU_LOCAL">
	      <button type="submit" id="connectSubmit">Подключиться</button>
	    </form>
	  </main>
	  <script>
	    const form = document.getElementById('connectForm');
	    const submit = document.getElementById('connectSubmit');
	    const target = document.getElementById('connectAsyncResult');
	    const esc = (value) => String(value ?? '').replace(/[&<>"']/g, ch => ({{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}}[ch]));
	    function showWait(message) {{
	      target.innerHTML = `<div class="notice wait"><strong>Создаём профиль</strong><p>${{esc(message || 'Профиль поставлен в очередь. Можно не нажимать кнопку повторно.')}}</p></div>`;
	    }}
	    function showError(error) {{
	      const msg = error?.message || error?.error || 'Не удалось создать профиль.';
	      const code = error?.error || 'connect_error';
	      target.innerHTML = `<div class="notice bad"><strong>${{esc(msg)}}</strong><p>Проверьте данные или обратитесь к администратору.</p><small>Код: ${{esc(code)}}</small></div>`;
	      if (submit) {{ submit.disabled = false; submit.textContent = 'Подключиться'; }}
	    }}
	    function successHtml(result) {{
	      const profile = result?.profile || {{}};
	      const user = result?.user || {{}};
	      const device = result?.device || {{}};
	      const ttl = Number(profile.ttl_seconds || 0);
	      const ttlText = ttl >= 60 ? `${{Math.floor(ttl / 60)}} мин.` : `${{ttl}} сек.`;
	      const qr = profile.qr_url ? `<div class="qr-public"><img src="${{esc(profile.qr_url)}}" alt="QR для импорта профиля"><span>QR сканируется в приложении. Кнопка скачивает профиль вручную.</span></div>` : '';
	      return `<section class="result">
	        <div class="notice ok"><strong>Профиль готов</strong><p>Устройство создано. Скачайте профиль, импортируйте его в приложение и включите VPN.</p></div>
	        <div class="summary">
	          <div><span>Пользователь</span><strong>${{esc(user.display_name || '')}}</strong></div>
	          <div><span>Организация</span><strong>${{esc(user.organization || '')}}</strong></div>
	          <div><span>VPN IP</span><strong>${{esc(device.assigned_vpn_ip || '')}}</strong></div>
	          <div><span>Приложение</span><strong>${{esc(device.vpn_client || '')}}</strong></div>
	          <div><span>Профиль</span><strong>${{esc(profile.mode || '')}}</strong></div>
	          <div><span>Ссылка</span><strong>одноразовая, ${{esc(ttlText)}}</strong></div>
	        </div>
	        <a class="primary" href="${{esc(profile.delivery_url || '#')}}">Получить профиль</a>
	        ${{qr}}
	        <div class="notice wait"><strong>После импорта</strong><p>Включите VPN в приложении. Оператор увидит первое подключение и маршрут в админке.</p></div>
	      </section>`;
	    }}
	    async function pollStatus(url) {{
	      for (let i = 0; i < 90; i++) {{
	        await new Promise(resolve => setTimeout(resolve, i < 5 ? 1200 : 2500));
	        const response = await fetch(url, {{headers: {{'Accept':'application/json'}}}});
	        const payload = await response.json();
	        if (payload.error) throw payload.error;
	        const row = payload.result || {{}};
	        if (row.status === 'completed') return row.result;
	        if (row.status === 'failed') throw (row.error || {{error: row.reason || 'connect_failed'}});
	        showWait(row.status === 'running' ? 'Профиль создаётся. Это нормально, если занимает несколько секунд.' : 'Заявка в очереди на выдачу профиля.');
	      }}
	      throw {{error:'connect_timeout', message:'Профиль создаётся дольше обычного. Обновите страницу статуса позже или обратитесь к администратору.'}};
	    }}
	    form?.addEventListener('submit', async (event) => {{
	      event.preventDefault();
	      if (submit) {{ submit.disabled = true; submit.textContent = 'Создаём'; }}
	      showWait('Заявка принята. V7 готовит отдельный ключ и профиль.');
	      try {{
	        const body = Object.fromEntries(new FormData(form).entries());
	        body.idempotency_key = body.idempotency_key || (crypto?.randomUUID ? crypto.randomUUID() : `connect-${{Date.now()}}-${{Math.random().toString(16).slice(2)}}`);
	        const response = await fetch('/api/connect/start', {{
	          method: 'POST',
	          headers: {{'Content-Type':'application/json', 'Accept':'application/json'}},
	          body: JSON.stringify(body)
	        }});
	        const payload = await response.json();
	        if (payload.error) throw payload.error;
	        let result = payload.result || {{}};
	        if (response.status === 202 || result.status_url) result = await pollStatus(result.status_url);
	        target.innerHTML = successHtml(result);
	        form.classList.add('hidden');
	      }} catch (error) {{
	        showError(error);
	      }}
	    }});
	  </script>
	</body>
	</html>"""


