def kv_registry_lines(path, key, value):
    rows = []
    for line in read_text(path, "").splitlines():
        raw = line.strip()
        if not raw or raw.startswith("#"):
            continue
        try:
            parsed = parse_kv_line(raw)
        except Exception:
            parsed = {}
        if parsed.get(key) == value:
            rows.append(raw)
    return rows


def backup_file_for_change(path, label, stamp):
    path = Path(path)
    if not path.exists():
        return ""
    backup = path.with_name(f"{path.name}.backup.{label}.{stamp}")
    shutil.copy2(path, backup)
    try:
        os.chmod(backup, path.stat().st_mode & 0o777)
    except OSError:
        pass
    return str(backup)


def remove_kv_registry_lines(path, key, value, label, stamp):
    path = Path(path)
    if not path.exists():
        return {"removed": 0, "backup": ""}
    original_lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    kept = []
    removed = []
    for line in original_lines:
        raw = line.strip()
        parsed = parse_kv_line(raw) if raw and not raw.startswith("#") else {}
        if parsed.get(key) == value:
            removed.append(line)
        else:
            kept.append(line)
    if not removed:
        return {"removed": 0, "backup": ""}
    backup = backup_file_for_change(path, label, stamp)
    mode = path.stat().st_mode & 0o777
    write_text_atomic(path, ("\n".join(kept) + ("\n" if kept else "")), mode=mode or 0o600)
    return {"removed": len(removed), "backup": backup, "lines": removed}


def backup_and_remove_assign_file(ip, stamp):
    assign = STATE_DIR / f"user-{ip}.assign"
    if not assign.exists():
        return {"removed": False, "backup": ""}
    backup = backup_file_for_change(assign, "v7-user-delete", stamp)
    assign.unlink()
    return {"removed": True, "backup": backup}


def user_delete_preview(ip, actor):
    ip = safe_user_ip(ip)
    if not ip:
        return None, {"error": "invalid_user_ip"}
    user_rows = kv_registry_lines(STATE_DIR / "users.registry", "ip", ip)
    lease_rows = kv_registry_lines(IPAM_LEASES, "ip", ip)
    device = identity_active_device_by_ip(ip)
    assign_exists = (STATE_DIR / f"user-{ip}.assign").exists()
    disable_preview = {"rc": 0, "output": "user registry row already absent"}
    if user_rows:
        disable_preview = run_action(["v7-user-disable", ip, "--dry-run"], actor, timeout=20)
    if not user_rows and not lease_rows and not device and not assign_exists:
        return None, {"error": "user_ip_already_free", "ip": ip}
    return {
        "action": "user_delete_preview",
        "ip": ip,
        "will_free_ip": True,
        "registry_rows": len(user_rows),
        "ipam_lease_rows": len(lease_rows),
        "assign_file": assign_exists,
        "active_device": device,
        "disable_preview": disable_preview,
        "next_step": "confirm_DELETE_USER_to_release_ip",
    }, None


def user_delete_apply(ip, actor, confirm):
    if confirm != "DELETE_USER":
        return None, {"error": "user_delete_requires_confirm_DELETE_USER"}
    preview, error = user_delete_preview(ip, actor)
    if error:
        return None, error
    ip = preview["ip"]
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    device = preview.get("active_device")
    revoke_result = None
    if device:
        revoke_result, revoke_error = identity_device_revoke_apply(device.get("id", ""), actor, "REVOKE_DEVICE")
        if revoke_error:
            return {"preview": preview, "revoke": revoke_result}, revoke_error
        disable_result = (revoke_result or {}).get("result", {"rc": 0, "output": "device revoked"})
        revoked_deliveries = (revoke_result or {}).get("revoked_deliveries", [])
    else:
        disable_result = {"rc": 0, "output": "user registry row already absent"}
        if preview.get("registry_rows"):
            disable_result = run_action(["v7-user-disable", ip], actor, timeout=35)
            if disable_result["rc"] != 0:
                return {"preview": preview, "result": disable_result}, {"error": "runtime_user_disable_failed"}
        revoked_deliveries = revoke_profile_deliveries_for_ip(ip, actor)
    registry_removed = remove_kv_registry_lines(STATE_DIR / "users.registry", "ip", ip, "v7-user-delete", stamp)
    lease_removed = remove_kv_registry_lines(IPAM_LEASES, "ip", ip, "v7-user-delete", stamp)
    assign_removed = backup_and_remove_assign_file(ip, stamp)
    audit_admin(
        actor,
        "admin_action_user_delete",
        f"ip={ip} registry_removed={registry_removed.get('removed', 0)} leases_removed={lease_removed.get('removed', 0)} assign_removed={str(assign_removed.get('removed')).lower()}",
        object_type="user",
        object_id=ip,
        result="OK",
        severity="warning",
    )
    return {
        "action": "user_delete",
        "ip": ip,
        "ip_released": True,
        "disable_result": disable_result,
        "revoke": revoke_result,
        "revoked_deliveries": revoked_deliveries,
        "registry_removed": registry_removed,
        "lease_removed": lease_removed,
        "assign_removed": assign_removed,
        "backups": [x for x in [
            registry_removed.get("backup"),
            lease_removed.get("backup"),
            assign_removed.get("backup"),
        ] if x],
    }, None


