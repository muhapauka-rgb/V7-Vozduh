def proxy_runtime_user_routes(inbound_id="happ-test"):
    root = PROXY_RUNTIME_ROOT / (safe_client_name(inbound_id) or "happ-test")
    candidate_path = root / "public-candidate" / "sing-box.json"
    config = read_json(candidate_path, {})
    if not isinstance(config, dict):
        config = {}
    auth_to_outbound = {}
    for rule in ((config.get("route") or {}).get("rules") or []):
        if not isinstance(rule, dict):
            continue
        outbound = str(rule.get("outbound") or "").strip()
        if not outbound:
            continue
        for auth_user in (rule.get("auth_user") or []):
            auth_to_outbound[str(auth_user or "").strip()] = outbound

    result = {}
    bind_dir = root / "bindings"
    if bind_dir.exists():
        for path in sorted(bind_dir.glob("user-*.json")):
            binding = read_json(path, {})
            ip = safe_user_ip(binding.get("user_ip", ""))
            auth_user = str(binding.get("auth_user") or "").strip()
            if not ip or not auth_user:
                continue
            outbound = auth_to_outbound.get(auth_user, "")
            egress_id = outbound[len("v7-egress-"):] if outbound.startswith("v7-egress-") else outbound
            row = result.setdefault(ip, {
                "transport": "vless",
                "auth_users": [],
                "outbound_tags": [],
                "egress_ids": [],
                "primary_egress": "",
                "binding_count": 0,
            })
            row["binding_count"] += 1
            row["auth_users"].append(auth_user)
            if outbound and outbound not in row["outbound_tags"]:
                row["outbound_tags"].append(outbound)
            if egress_id and egress_id not in row["egress_ids"]:
                row["egress_ids"].append(egress_id)
            if egress_id and not row["primary_egress"]:
                row["primary_egress"] = egress_id

    identity_re = re.compile(r"^v7-(?P<ip>10\.(?:0\.0|7\.[0-3])\.[0-9]{1,3})-")
    for auth_user, outbound in auth_to_outbound.items():
        match = identity_re.match(auth_user)
        if not match:
            continue
        ip = safe_user_ip(match.group("ip"))
        if not ip:
            continue
        egress_id = outbound[len("v7-egress-"):] if outbound.startswith("v7-egress-") else outbound
        row = result.setdefault(ip, {
            "transport": "vless",
            "auth_users": [],
            "outbound_tags": [],
            "egress_ids": [],
            "primary_egress": "",
            "binding_count": 0,
        })
        if auth_user not in row["auth_users"]:
            row["auth_users"].append(auth_user)
        if outbound and outbound not in row["outbound_tags"]:
            row["outbound_tags"].append(outbound)
        if egress_id and egress_id not in row["egress_ids"]:
            row["egress_ids"].append(egress_id)
        if egress_id and not row["primary_egress"]:
            row["primary_egress"] = egress_id

    return result


def proxy_profile_connection_state(ip, proxy_route=None, vless_activity=None):
    ip = safe_user_ip(ip)
    proxy_route = proxy_route if isinstance(proxy_route, dict) else proxy_runtime_user_routes(PROXY_INBOUND_ID).get(ip, {})
    vless_activity = vless_activity if isinstance(vless_activity, dict) else vless_activity_state(ip)
    auth_users = [
        str(item or "").strip()
        for item in (proxy_route.get("auth_users") or [])
        if str(item or "").strip()
    ]
    expected_auth_user = auth_users[0] if len(auth_users) == 1 else ""
    active_auth_user = str(vless_activity.get("auth_user") or "").strip()
    recent = bool(vless_activity.get("recent"))
    seen = bool(vless_activity.get("present") or vless_activity.get("seen"))
    blockers = []
    warnings = []
    if len(auth_users) > 1:
        blockers.append("multiple_vless_profiles_for_user")
    if auth_users and active_auth_user and active_auth_user not in auth_users:
        blockers.append("active_vless_profile_not_in_runtime")
    if auth_users and not seen:
        warnings.append("no_seen_vless_connection")
    elif auth_users and not recent:
        warnings.append("vless_connection_seen_not_recent")
    status = "BLOCKED" if blockers else ("OK" if seen else "WAITING")
    if blockers:
        message = "У пользователя несколько VLESS-профилей или активный профиль не совпадает с runtime. Старые профили нужно отозвать."
    elif recent:
        message = "V7 недавно видел подключение актуального VLESS-профиля."
    elif seen:
        message = "V7 уже видел успешное подключение актуального VLESS-профиля. Свежей активности в коротком окне нет."
    else:
        message = "V7 пока не видел живое подключение этого VLESS-профиля. На телефоне может быть выбран старый профиль."
    return {
        "status": status,
        "transport": "vless",
        "auth_user_count": len(auth_users),
        "auth_users": auth_users,
        "expected_auth_user": expected_auth_user,
        "active_auth_user": active_auth_user,
        "target": str(vless_activity.get("target") or "").strip(),
        "seen": seen,
        "recent": recent,
        "latest_activity_epoch": int(vless_activity.get("latest_activity_epoch") or 0),
        "latest_activity_age_sec": vless_activity.get("latest_activity_age_sec"),
        "blockers": blockers,
        "warnings": warnings,
        "message": message,
    }


