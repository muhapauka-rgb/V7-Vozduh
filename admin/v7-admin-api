class ConnectRequestSnapshot:
    def __init__(self, handler):
        headers = {}
        if handler is not None:
            for key in ("X-Forwarded-For", "X-Real-IP", "User-Agent", "Host", "X-Forwarded-Proto"):
                value = handler.headers.get(key, "")
                if value:
                    headers[key] = value
            client_ip = handler.client_address[0]
        else:
            client_ip = "127.0.0.1"
        self.headers = headers
        self.client_address = (client_ip, 0)


def connect_pending_cleanup(now=None):
    now = now or time.time()
    with CONNECT_PENDING_LOCK:
        old_keys = [
            key for key, row in CONNECT_PENDING.items()
            if now - float(row.get("updated_at_epoch") or row.get("created_at_epoch") or now) > 1800
        ]
        for key in old_keys:
            CONNECT_PENDING.pop(key, None)


def connect_pending_set(key, status, **fields):
    key = clean_identity_text(key, 180)
    if not key:
        return
    now = time.time()
    with CONNECT_PENDING_LOCK:
        row = CONNECT_PENDING.get(key, {})
        row.update({
            "idempotency_key": key,
            "status": status,
            "updated_at": now_iso(),
            "updated_at_epoch": now,
            **fields,
        })
        row.setdefault("created_at", now_iso())
        row.setdefault("created_at_epoch", now)
        CONNECT_PENDING[key] = row
        if len(CONNECT_PENDING) > CONNECT_QUEUE_MAX * 2:
            oldest = sorted(CONNECT_PENDING.items(), key=lambda item: float(item[1].get("updated_at_epoch") or 0))
            for old_key, _ in oldest[:CONNECT_QUEUE_MAX]:
                CONNECT_PENDING.pop(old_key, None)


def connect_pending_get(key):
    key = clean_identity_text(key, 180)
    if not key:
        return None
    connect_pending_cleanup()
    with CONNECT_PENDING_LOCK:
        row = CONNECT_PENDING.get(key)
        return dict(row) if row else None


def connect_session_status(data):
    key = clean_identity_text(data.get("idempotency_key") or data.get("k") or "", 180)
    session_id = safe_identity_id(data.get("session_id") or data.get("id") or "")
    if not key and not session_id:
        return None, {"error": "missing_connect_status_ref"}
    identity_init_db()
    with identity_conn() as conn:
        conn.executescript(IDENTITY_SCHEMA)
        identity_migrate_db(conn)
        row = None
        if session_id:
            row = conn.execute("SELECT * FROM connect_sessions WHERE id=?", (session_id,)).fetchone()
        if not row and key:
            row = conn.execute("SELECT * FROM connect_sessions WHERE idempotency_key=?", (key,)).fetchone()
        if row:
            item = dict(row)
            try:
                payload = json.loads(item.get("result_json") or "{}")
            except json.JSONDecodeError:
                payload = {}
            result = {
                "session_id": item.get("id", ""),
                "idempotency_key": item.get("idempotency_key", ""),
                "status": item.get("status", ""),
                "reason": item.get("reason", ""),
                "updated_at": item.get("updated_at", ""),
            }
            if item.get("status") == "completed":
                result["result"] = payload
            elif item.get("status") == "failed":
                result["error"] = payload.get("error") or {"error": item.get("reason") or "connect_failed"}
            return result, None
    pending = connect_pending_get(key)
    if pending:
        return {
            "idempotency_key": key,
            "status": pending.get("status", "queued"),
            "reason": pending.get("reason", ""),
            "updated_at": pending.get("updated_at", ""),
            "position_hint": pending.get("position_hint", ""),
        }, None
    return None, {"error": "connect_session_not_found"}


def connect_worker_loop():
    while True:
        item = CONNECT_JOB_QUEUE.get()
        key = item.get("idempotency_key", "")
        try:
            connect_pending_set(key, "running", reason="worker_started")
            result, error, status = connect_onboard(item.get("data") or {}, handler=item.get("handler"))
            if error:
                connect_pending_set(key, "failed", reason=error.get("error", "connect_failed"), status_code=status)
            else:
                connect_pending_set(key, "completed", reason="completed", status_code=status)
        except Exception as exc:
            connect_pending_set(key, "failed", reason="worker_exception", error=str(exc)[:240])
            try:
                audit_admin("connect", "public_connect_worker_exception", f"key={key[:12]} error={str(exc)[:160]}", object_type="connect_session", object_id=key[:12], result="FAIL", severity="error")
            except Exception:
                pass
        finally:
            CONNECT_JOB_QUEUE.task_done()


def ensure_connect_worker():
    global CONNECT_WORKER_STARTED
    if CONNECT_WORKER_STARTED:
        return
    with CONNECT_WORKER_LOCK:
        if CONNECT_WORKER_STARTED:
            return
        worker = threading.Thread(target=connect_worker_loop, name="v7-connect-provisioning-worker", daemon=True)
        worker.start()
        CONNECT_WORKER_STARTED = True


def connect_prequeue_validate(data, handler=None):
    entered_name = clean_identity_text(data.get("name", ""), 160)
    phone = normalize_phone(data.get("phone", ""))
    org_input = clean_identity_text(data.get("organization", ""), 160)
    password = str(data.get("password", ""))
    vpn_client = safe_connect_client(data.get("vpn_client", "karing"))
    if not entered_name or not phone or not org_input or not password:
        identity_log_attempt(phone, entered_name, org_input, "FAIL", "missing_required_fields", handler)
        return {"error": "missing_required_fields", "message": "Заполните имя, телефон, организацию и пароль."}, 400
    if identity_rate_limited(phone, handler=handler):
        identity_log_attempt(phone, entered_name, org_input, "FAIL", "rate_limited", handler)
        return {"error": "rate_limited", "message": "Слишком много неудачных попыток. Попробуйте позже или обратитесь к администратору."}, 429
    if not connect_client_supported(vpn_client):
        identity_log_attempt(phone, entered_name, org_input, "FAIL", "unsupported_vpn_client", handler)
        client = CONNECT_CLIENTS.get(vpn_client, CONNECT_CLIENTS["karing"])
        return {
            "error": "unsupported_vpn_client",
            "message": "Это приложение ещё не подключено к автоматической выдаче.",
            "client": client.get("label", vpn_client),
            "hint": "Сейчас автоматическая выдача работает для Karing и Hiddify. Для остальных клиентов профиль выдаёт оператор или нужен отдельный адаптер.",
        }, 400
    if not identity_verify_connection_password(password):
        identity_log_attempt(phone, entered_name, org_input, "FAIL", "password_invalid", handler)
        return {"error": "password_invalid", "message": "Неверный пароль подключения."}, 403
    organization = identity_find_organization(org_input)
    if not organization:
        identity_log_attempt(phone, entered_name, org_input, "FAIL", "organization_not_found", handler)
        return {"error": "organization_not_found", "message": "Организация не найдена. Выберите организацию из списка администратора."}, 404
    allowed = identity_find_allowed_phone(phone)
    if allowed and not int(allowed.get("is_active") or 0):
        identity_log_attempt(phone, entered_name, org_input, "FAIL", "phone_not_active", handler)
        return {"error": "phone_not_active", "message": "Телефон сейчас не активен в списке разрешённых. Обратитесь к администратору."}, 403
    return None, None


def connect_enqueue_onboard(data, handler=None):
    identity_init_db()
    validation_error, validation_status = connect_prequeue_validate(data, handler=handler)
    if validation_error:
        return None, validation_error, validation_status
    phone = normalize_phone(data.get("phone", ""))
    key = connect_idempotency_key(data, phone, handler)
    current, current_error = connect_session_status({"idempotency_key": key})
    if current and current.get("status") == "completed":
        return current.get("result", {}), None, 200
    if current and current.get("status") in ("running", "queued"):
        current["status_url"] = f"/api/connect/status?k={key}"
        return current, None, 202
    ensure_connect_worker()
    try:
        position = CONNECT_JOB_QUEUE.qsize() + 1
        CONNECT_JOB_QUEUE.put_nowait({
            "idempotency_key": key,
            "data": dict(data or {}),
            "handler": ConnectRequestSnapshot(handler),
        })
    except queue.Full:
        identity_log_attempt(phone, data.get("name", ""), data.get("organization", ""), "FAIL", "connect_queue_full", handler)
        return None, {
            "error": "connect_queue_full",
            "message": "Сейчас слишком много заявок на выдачу профилей. Попробуйте немного позже.",
        }, 503
    connect_pending_set(key, "queued", reason="queued_for_provisioning", position_hint=str(position))
    return {
        "idempotency_key": key,
        "status": "queued",
        "status_url": f"/api/connect/status?k={key}",
        "message": "Профиль создаётся. Обычно это занимает несколько секунд.",
        "position_hint": position,
    }, None, 202


