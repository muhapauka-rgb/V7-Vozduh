def run_json_command(cmd, timeout=40, max_output=5_000_000):
    try:
        proc = subprocess.run(
            cmd,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
            check=False,
        )
        output = proc.stdout[-max_output:]
    except subprocess.TimeoutExpired as exc:
        return {
            "cmd": cmd,
            "rc": 124,
            "output": redact((exc.stdout or "") + "\nTIMEOUT"),
            "json": None,
        }
    except OSError as exc:
        return {"cmd": cmd, "rc": 127, "output": f"ERROR: {exc}", "json": None}
    parsed = None
    if output.strip():
        try:
            parsed = json.loads(output)
        except json.JSONDecodeError:
            parsed = None
    return {"cmd": cmd, "rc": proc.returncode, "output": redact(output[-12000:]), "json": redact(parsed)}


