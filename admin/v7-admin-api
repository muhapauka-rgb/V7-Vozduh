    with identity_conn() as conn:
        conn.executescript(IDENTITY_SCHEMA)
        identity_migrate_db(conn)
        conn.execute("BEGIN IMMEDIATE")
        existing = conn.execute("SELECT * FROM connect_sessions WHERE idempotency_key=?", (idem,)).fetchone()
        if existing:
            row = dict(existing)
            if row.get("status") == "running":
                conn.commit()
                return row, None, {"in_progress": True}
            conn.commit()
            return row, None, {"duplicate": True}
        session_id = identity_id("cs")
        job_id = identity_id("job")
        conn.execute(
            """
            INSERT INTO connect_sessions
