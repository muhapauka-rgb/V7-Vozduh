        "read_only": True,
        "non_authoritative": True,
        "execution_allowed": False,
        "storage_backend": "jsonl",
        "storage_path": str(RELEASE_TRUST_STORE_FILE),
        "generated_sources": ["git_head", "report_inventory", "backup_summary", "runtime_trust"],
    }
    payload.update(attach_operational_metadata(payload, "release", release_id, RELEASE_TRUST_FRESH_TTL_SECONDS, ts_fields=("updated_at", "created_at", "ts")))
    payload["advanced_details_available"] = True
