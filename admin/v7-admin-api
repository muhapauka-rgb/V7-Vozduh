def execution_gate_catalog_for_drafts(drafts):
    rows = []
    adapters_by_draft = []
    for draft in drafts:
        adapters_by_draft.append((draft, execution_gate_adapters_for_draft(draft)))
    for gate_id, label in EXECUTION_VALIDATION_GATES:
        checks = []
        for draft, adapters in adapters_by_draft:
            if gate_id in adapters:
                item = dict(adapters[gate_id])
                item["draft_id"] = draft.get("draft_id", "")
                item["contract_id"] = draft.get("contract_id", "")
                checks.append(item)
        statuses = {row.get("status") for row in checks}
        if "FAIL" in statuses:
            status = "FAIL"
        elif "REVIEW_REQUIRED" in statuses:
            status = "REVIEW_REQUIRED"
        elif "UNKNOWN" in statuses:
            status = "UNKNOWN"
        elif checks:
            status = "PASS"
        else:
            status = "UNKNOWN"
        rows.append({
            "gate_id": gate_id,
            "label": label,
            "status": status,
            "draft_count": len(checks),
            "adapter_connected": any(row.get("adapter_connected") for row in checks),
            "sources": sorted({row.get("adapter_source", "") for row in checks if row.get("adapter_source")}),
            "checks": checks[:20],
            "read_only": True,
            "preview_only": True,
        })
    return rows


