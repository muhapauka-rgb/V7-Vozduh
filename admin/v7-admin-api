    function sortPlainTableByHeader(th) {
      if (!th || th.classList.contains('sortable-th')) return;
      const tableEl = th.closest('table');
      const row = th.closest('tr');
      const body = tableEl?.tBodies?.[0];
      if (!tableEl || !row || !body) return;
      const headers = Array.from(row.children);
      const index = headers.indexOf(th);
      if (index < 0) return;
      const rows = Array.from(body.rows).filter(r => r.cells && r.cells.length === headers.length);
      if (rows.length < 2) return;
      const nextDir = th.dataset.sortDir === 'asc' ? 'desc' : 'asc';
      headers.forEach(h => { h.dataset.sortDir = ''; h.querySelector('.sort-indicator')?.remove(); });
      th.dataset.sortDir = nextDir;
      const value = r => (r.cells[index]?.innerText || '').trim();
      const numeric = v => {
        const n = Number(String(v).replace(',', '.').replace(/[^0-9.-]/g, ''));
        return Number.isFinite(n) && /[0-9]/.test(String(v)) ? n : null;
      };
      rows.sort((a,b) => {
        const av = value(a), bv = value(b);
        const an = numeric(av), bn = numeric(bv);
        const cmp = an !== null && bn !== null ? an - bn : av.localeCompare(bv, 'ru', {numeric:true, sensitivity:'base'});
        return nextDir === 'desc' ? -cmp : cmp;
      });
      rows.forEach(r => body.appendChild(r));
      th.insertAdjacentHTML('beforeend', `<span class="sort-indicator">${nextDir === 'desc' ? '↓' : '↑'}</span>`);
    }
