def audit_admin(actor, action, message, **fields):
    merged = infer_admin_audit_fields(action, message)
    merged.update({k: v for k, v in fields.items() if v is not None and str(v) != ""})
    extra = [f"{k}={v}" for k, v in merged.items()]
    try:
        subprocess.run(
            ["v7-audit-log", action, "admin", message, *extra],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            env={**os.environ, "V7_ACTOR": actor or "admin"},
        )
    except OSError:
        return


def file_age(path):
    try:
        return int(time.time() - Path(path).stat().st_mtime)
    except OSError:
        return None


def tail_jsonl(path, limit=30):
    path = Path(path)
    if not path.exists():
        return []
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines()[-limit:]
    return parse_jsonl_lines(lines, redact_value=redact)


EVIDENCE_OBJECT_TYPES = {"user", "channel", "route", "alert", "proposal", "release", "backup", "restore", "check", "log", "system"}
EVIDENCE_STATUS_VALUES = {"OPEN", "OBSERVING", "VERIFIED", "CLOSED", "STALE"}
EVIDENCE_SEVERITY_VALUES = {"info", "warn", "bad", "ok"}
SAFE_EVIDENCE_TOKEN_RE = re.compile(r"^[A-Za-z0-9_.:@/-]{1,160}$")


def safe_evidence_token(value, default=""):
    text = str(value or "").strip()
    if SAFE_EVIDENCE_TOKEN_RE.match(text):
        return text
    cleaned = re.sub(r"[^A-Za-z0-9_.:@/-]+", "-", text)[:160].strip("-")
    return cleaned or default


def evidence_iso_from_event(event):
    return str(event.get("ts") or event.get("time") or event.get("created_at") or now_iso())


def evidence_hash(prefix, *parts):
    raw = "|".join(str(part or "") for part in parts)
    return f"{prefix}-{hashlib.sha256(raw.encode('utf-8', errors='ignore')).hexdigest()[:16]}"


def evidence_link(object_type, object_id, label=""):
    object_type = safe_evidence_token(object_type, "system").lower()
    object_id = safe_evidence_token(object_id, "overview")
    return {"object_type": object_type, "object_id": object_id, "label": label or f"{object_type}:{object_id}"}


def evidence_bundle(bundle_id, object_type, object_id, status, severity, summary, *, timeline=None, evidence_items=None, recommendation="", verification_state="UNVERIFIED", closure_state="OPEN", links=None, source="generated", updated_at=None):
    object_type = safe_evidence_token(object_type, "system").lower()
    if object_type not in EVIDENCE_OBJECT_TYPES:
        object_type = "system"
    object_id = safe_evidence_token(object_id, "overview")
    status = str(status or "OPEN").upper()
    severity = str(severity or "info").lower()
    bundle = {
        "bundle_id": safe_evidence_token(bundle_id, evidence_hash("evidence", object_type, object_id, summary)),
        "object_type": object_type,
        "object_id": object_id,
        "status": status if status in EVIDENCE_STATUS_VALUES else "OPEN",
        "severity": severity if severity in EVIDENCE_SEVERITY_VALUES else "info",
        "summary": redact(str(summary or "Пакет доказательств")),
        "timeline": timeline if isinstance(timeline, list) else [],
        "evidence_items": evidence_items if isinstance(evidence_items, list) else [],
        "recommendation": redact(str(recommendation or "")),
        "verification_state": str(verification_state or "UNVERIFIED").upper(),
        "closure_state": str(closure_state or "OPEN").upper(),
        "links": links if isinstance(links, list) else [],
        "source": str(source or "generated"),
        "updated_at": updated_at or now_iso(),
    }
    primary = evidence_link(object_type, object_id)
    existing = {(l.get("object_type"), l.get("object_id")) for l in bundle["links"] if isinstance(l, dict)}
    if (primary["object_type"], primary["object_id"]) not in existing:
        bundle["links"].insert(0, primary)
    return redact(bundle)


def normalize_evidence_bundle(row):
    if not isinstance(row, dict):
        return None
    return evidence_bundle(
        row.get("bundle_id") or row.get("id") or evidence_hash("evidence", row.get("object_type"), row.get("object_id"), row.get("summary")),
        row.get("object_type") or "system",
        row.get("object_id") or "overview",
        row.get("status") or "OPEN",
        row.get("severity") or "info",
        row.get("summary") or "",
        timeline=row.get("timeline") or [],
        evidence_items=row.get("evidence_items") or row.get("items") or [],
        recommendation=row.get("recommendation") or "",
        verification_state=row.get("verification_state") or "UNVERIFIED",
        closure_state=row.get("closure_state") or "OPEN",
        links=row.get("links") or [],
        source=row.get("source") or "store",
        updated_at=row.get("updated_at") or row.get("created_at") or now_iso(),
    )


OBJECT_VIEW_CACHE_TTL_SEC = 12
OBJECT_VIEW_CACHE = {}
OBJECT_VIEW_CACHE_LOCK = threading.Lock()


def cached_read_only_model(key, builder, ttl=OBJECT_VIEW_CACHE_TTL_SEC):
    now = time.monotonic()
    with OBJECT_VIEW_CACHE_LOCK:
        cached = OBJECT_VIEW_CACHE.get(key)
        if cached and now - float(cached.get("ts", 0.0)) <= max(1, int(ttl or 1)):
            return cached.get("data")
    data = builder()
    with OBJECT_VIEW_CACHE_LOCK:
        OBJECT_VIEW_CACHE[key] = {"ts": now, "data": data}
    return data


def evidence_store_bundles():
    if not EVIDENCE_STORE_FILE.exists():
        return []
    bundles = []
    try:
        for line in EVIDENCE_STORE_FILE.read_text(encoding="utf-8", errors="replace").splitlines():
            if not line.strip():
                continue
            try:
                item = normalize_evidence_bundle(json.loads(line))
                if item:
                    bundles.append(item)
            except (TypeError, ValueError, json.JSONDecodeError):
                continue
    except OSError:
        return []
    return bundles


def evidence_event_timeline(events, limit=5):
    rows = []
    for event in (events or [])[:limit]:
        rows.append({
            "ts": evidence_iso_from_event(event),
            "title": public_operator_summary(event.get("action") or event.get("component") or event.get("source") or "event"),
            "status": statusLabel_py(event.get("result") or event.get("severity") or "info"),
            "summary": redact(str(event.get("message") or event.get("reason") or ""))[:220],
            "source": event.get("source") or event.get("component") or "event",
        })
    return rows


def statusLabel_py(value):
    text = str(value or "").strip()
    return text.upper() if text else "UNKNOWN"


def public_operator_summary(value):
    text = str(value or "").replace("_", " ").replace("-", " ").strip()
    translations = {
        "diagnostics": "Диагностика",
        "service matrix": "Сервисы",
        "checks": "Проверки",
        "egress": "Канал",
        "routing": "Маршруты",
        "user switch": "Переключение пользователя",
    }
    low = text.lower()
    if low in translations:
        return translations[low]
    return text[:1].upper() + text[1:] if text else "Доказательство"


def generated_evidence_bundles(limit=120):
    state = read_json(STATE_DIR / "v7-state.json", {})
    users = state.get("users") or parse_registry(STATE_DIR / "users.registry")
    active_users = [u for u in users if str(u.get("enabled", "1")) == "1"]
