def ingest_client_path_sample(payload):
    ingest = "/usr/local/bin/v7-path-sample-ingest"
    if not os.path.exists(ingest):
        return {"ok": False, "error": "ingest_missing"}
    try:
        proc = subprocess.run(
            [ingest],
            input=json.dumps(payload, ensure_ascii=False),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=5,
            check=False,
        )
    except Exception as exc:
        return {"ok": False, "error": "ingest_exception", "detail": str(exc)[:240]}
    output = (proc.stdout or "").strip()
    try:
        parsed = json.loads(output) if output else {}
    except Exception:
        parsed = {"output": output[:500]}
    if proc.returncode != 0:
        return {"ok": False, "error": "ingest_failed", "rc": proc.returncode, "detail": parsed}
    return parsed if isinstance(parsed, dict) else {"ok": True, "detail": parsed}


def save_public_client_speed_sample(token, row, data, user_agent=""):
    ip = safe_user_ip(row.get("ip", ""))
    users = parse_registry(STATE_DIR / "users.registry")
    user_row = next((item for item in users if item.get("ip") == ip and str(item.get("enabled", "1")) == "1"), None)
    if not user_row:
        return None, {"error": "user_not_found_or_disabled", "ip": ip}
    mbps = safe_float(data.get("mbps"))
    duration_ms = int(safe_float(data.get("duration_ms")))
    bytes_count = int(safe_float(data.get("bytes")))
    if mbps <= 0 or duration_ms <= 0 or bytes_count <= 0:
        return None, {"error": "invalid_measurement"}
    registry_egress = user_row.get("current", "")
    ingress_type = normalize_path_ingress_type(row.get("ingress_type", "")) or "unknown"
    proxy_route = proxy_runtime_user_routes(PROXY_INBOUND_ID).get(ip, {})
    proxy_egress = safe_egress_id(proxy_route.get("primary_egress", ""))
    current = proxy_egress if ingress_type == "vless" and proxy_egress else registry_egress
    route_source = "proxy_runtime" if current == proxy_egress and proxy_egress else "users_registry"
    sample = {
        "ts": now_iso(),
        "source_ip": ip,
        "mode": "v7",
        "egress": current,
        "current_egress": current,
        "registry_egress": registry_egress,
        "proxy_egress": proxy_egress,
        "route_source": route_source,
        "ingress_type": ingress_type,
        "mbps": round(mbps, 2),
        "bytes": bytes_count,
        "duration_ms": duration_ms,
        "target_url": str(data.get("target_url", ""))[:160],
        "measured_at": str(data.get("measured_at", ""))[:80],
        "command_id": str(row.get("command_id", ""))[:80],
        "user_agent": str(user_agent or "")[:180],
        "public_speed_token_hint": token[:8],
