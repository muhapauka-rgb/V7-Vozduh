def egress_draft_proxy_runtime_run(metadata, draft_id, raw, actor, duration, requested_mode, run_dir, run_id):
    listen_port = egress_free_local_port()
    runtime_text, error = egress_draft_proxy_runtime_text(raw, listen_port)
    if error:
        return None, error
    runtime_config = run_dir / "sing-box-runtime.json"
    write_text_atomic(runtime_config, runtime_text if runtime_text.endswith("\n") else runtime_text + "\n", mode=0o600)

    result = {
        "id": run_id,
        "draft_id": draft_id,
        "label": metadata.get("label", draft_id),
        "created_at": now_iso(),
        "created_by": actor or "admin",
        "stage": "isolated_runtime",
        "mode": "temporary_sing_box_proxy_auto_cleanup",
        "requested_mode": requested_mode,
        "protocol": metadata.get("protocol", "unknown"),
        "runtime_mode": metadata.get("runtime_mode", "unknown"),
        "listen": f"socks5://127.0.0.1:{listen_port}",
        "duration_seconds": duration,
        "pool_action": "still_not_added",
        "route_action": "none",
        "secret_redaction": "raw_config_not_returned",
        "checks": [],
    }
    sing_box = shutil.which("sing-box")
    if not sing_box:
        result["status"] = "BLOCKED"
        result["checks"].append({"id": "sing_box_present", "status": "FAIL", "detail": "sing-box not found"})
        return result, None
    result["checks"].append({"id": "sing_box_present", "status": "OK", "detail": sing_box})

    check = run_readonly([sing_box, "check", "-c", str(runtime_config)], timeout=20)
    result["config_check"] = {"rc": check["rc"], "output": check["output"]}
    result["checks"].append({"id": "sing_box_check", "status": "OK" if check["rc"] == 0 else "FAIL", "detail": f"rc={check['rc']}"})
    if check["rc"] != 0:
        result["status"] = "BLOCKED"
        return result, None

    proc = None
    started = False
    try:
        proc = subprocess.Popen(
            [sing_box, "run", "-c", str(runtime_config)],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
        )
        time.sleep(1.2)
        started = proc.poll() is None
        result["checks"].append({"id": "sing_box_started", "status": "OK" if started else "FAIL", "detail": "running" if started else f"exited rc={proc.poll()}"})
        if started:
            curl_result = run_readonly([
                "curl",
                "--socks5-hostname", f"127.0.0.1:{listen_port}",
                "-4",
                "--max-time", str(duration),
                "-fsS",
                "https://ifconfig.me",
            ], timeout=duration + 4)
            result["external_ip"] = {
                "ok": curl_result["rc"] == 0 and bool(str(curl_result["output"]).strip()),
                "rc": curl_result["rc"],
                "ip": str(curl_result["output"]).strip() if curl_result["rc"] == 0 else "",
                "detail": curl_result["output"] if curl_result["rc"] != 0 else "",
            }
            result["checks"].append({"id": "external_ip", "status": "OK" if result["external_ip"]["ok"] else "FAIL", "detail": result["external_ip"].get("ip") or result["external_ip"].get("detail", "")})
        else:
            result["external_ip"] = {"ok": False, "rc": proc.poll(), "ip": "", "detail": "sing-box exited before curl"}
        if requested_mode == "quarantine" and started and result.get("external_ip", {}).get("ok"):
            role = ((metadata.get("usage_policy") or {}).get("role") or metadata.get("role") or "GLOBAL_FAST")
            matrix = egress_draft_proxy_service_matrix(listen_port, role, duration)
            result["service_matrix"] = matrix
            result["checks"].append({
                "id": "service_matrix",
                "status": "OK" if matrix.get("status") == "PASS" else "FAIL",
                "detail": f"{matrix.get('ok_count', 0)}/{matrix.get('total', 0)}",
            })
    finally:
        output = ""
        if proc is not None:
            if proc.poll() is None:
                proc.terminate()
                try:
                    output, _ = proc.communicate(timeout=5)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    output, _ = proc.communicate(timeout=5)
            else:
                output, _ = proc.communicate(timeout=1)
        result["process_output"] = redact((output or "")[-4000:])
    result["cleanup"] = {
        "status": "OK" if proc is None or proc.poll() is not None else "FAIL",
        "process_stopped": proc is None or proc.poll() is not None,
        "runtime_config": runtime_config.name,
    }
    result["checks"].append({"id": "cleanup", "status": result["cleanup"]["status"], "detail": "temporary sing-box stopped"})
    result["status"] = "PASS" if result.get("external_ip", {}).get("ok") and result["cleanup"]["status"] == "OK" else ("FAIL_EXTERNAL_IP" if started else "FAIL")
    if requested_mode == "quarantine":
        matrix_status = (result.get("service_matrix") or {}).get("status", "")
        if result["status"] == "PASS" and matrix_status == "PASS":
            result["quarantine_status"] = "PASS"
        else:
            result["quarantine_status"] = "BLOCKED"
            result.setdefault("service_matrix", {"status": "UNAVAILABLE", "reason": "runtime or service checks did not pass"})
    return result, None


def egress_draft_openvpn_runtime_run(metadata, draft_id, raw, actor, duration, requested_mode, run_dir, run_id):
    ifname = f"v7ov{secrets.token_hex(4)}"
    runtime_config = run_dir / "openvpn-runtime.ovpn"
    auth_path = run_dir / "auth-user-pass.txt"
    runtime_text, auth_text, error = egress_openvpn_normalize_runtime_config(raw, ifname, auth_path=auth_path)
    if error:
        return None, error
    write_text_atomic(runtime_config, runtime_text, mode=0o600)
    if auth_text:
        write_text_atomic(auth_path, auth_text, mode=0o600)

    result = {
        "id": run_id,
        "draft_id": draft_id,
        "label": metadata.get("label", draft_id),
        "created_at": now_iso(),
        "created_by": actor or "admin",
        "stage": "isolated_runtime",
        "mode": "temporary_openvpn_interface_auto_cleanup",
        "requested_mode": requested_mode,
        "protocol": "openvpn",
        "runtime_mode": "interface",
        "interface": ifname,
        "duration_seconds": duration,
        "pool_action": "still_not_added",
        "route_action": "route-nopull_v7_owned_routes",
        "secret_redaction": "raw_config_not_returned",
        "checks": [],
    }
    openvpn = shutil.which("openvpn")
    if not openvpn:
        result["status"] = "BLOCKED"
        result["checks"].append({"id": "openvpn_present", "status": "FAIL", "detail": "openvpn not found"})
        return result, None
    result["checks"].append({"id": "openvpn_present", "status": "OK", "detail": openvpn})

    before_link = run_readonly(["ip", "link", "show", ifname], timeout=5)
    if before_link["rc"] == 0:
        result["status"] = "BLOCKED"
        result["checks"].append({"id": "interface_name_free", "status": "FAIL", "detail": "temporary interface already exists"})
        return result, None
    result["checks"].append({"id": "interface_name_free", "status": "OK", "detail": ifname})

    proc = None
    output = ""
    started = False
    try:
        proc = subprocess.Popen(
            [openvpn, "--config", str(runtime_config), "--verb", "3"],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
        )
        deadline = time.time() + max(8, duration + 8)
        while time.time() < deadline:
            if proc.poll() is not None:
                break
            if egress_interface_live(ifname):
                started = True
                break
            time.sleep(0.4)
        result["checks"].append({"id": "runtime_up", "status": "OK" if started else "FAIL", "detail": "interface created" if started else f"openvpn rc={proc.poll()}"})
        if started:
            link_result = run_readonly(["ip", "-br", "addr", "show", ifname], timeout=5)
            curl_result = run_readonly(["curl", "--interface", ifname, "-4", "--max-time", str(duration), "-fsS", "https://ifconfig.me"], timeout=duration + 4)
            result["interface_up"] = link_result["rc"] == 0
            result["link"] = {"rc": link_result["rc"], "output": link_result["output"]}
            result["external_ip"] = {
                "ok": curl_result["rc"] == 0 and bool(str(curl_result["output"]).strip()),
                "rc": curl_result["rc"],
                "ip": str(curl_result["output"]).strip() if curl_result["rc"] == 0 else "",
                "detail": curl_result["output"] if curl_result["rc"] != 0 else "",
            }
            result["checks"].append({"id": "interface_visible", "status": "OK" if result["interface_up"] else "FAIL", "detail": ifname})
            result["checks"].append({"id": "external_ip", "status": "OK" if result["external_ip"]["ok"] else "FAIL", "detail": result["external_ip"].get("ip") or result["external_ip"].get("detail", "")})
            if requested_mode == "quarantine" and result["external_ip"]["ok"]:
                role = ((metadata.get("usage_policy") or {}).get("role") or metadata.get("role") or "GLOBAL_FAST")
                matrix = egress_draft_interface_service_matrix(ifname, role, duration)
                result["service_matrix"] = matrix
                result["checks"].append({
                    "id": "service_matrix",
                    "status": "OK" if matrix.get("status") == "PASS" else "FAIL",
                    "detail": f"{matrix.get('ok_count', 0)}/{matrix.get('total', 0)}",
                })
        else:
            result["interface_up"] = False
            result["external_ip"] = {"ok": False, "rc": proc.poll(), "ip": "", "detail": "OpenVPN did not create a temporary interface"}
    finally:
        if proc is not None:
            if proc.poll() is None:
                proc.terminate()
                try:
                    output, _ = proc.communicate(timeout=8)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    output, _ = proc.communicate(timeout=5)
            else:
                output, _ = proc.communicate(timeout=2)
        result["process_output"] = redact((output or "")[-4000:])
        if not started:
            raw_output = output or ""
            if "UDPv4 link remote:" in raw_output and "TLS: Initial packet" not in raw_output and "VERIFY OK" not in raw_output:
                endpoint_match = re.search(r"UDPv4 link remote:\s+\[AF_INET\]([0-9.]+:\d+)", raw_output)
                endpoint = endpoint_match.group(1) if endpoint_match else "VPN endpoint"
                reason = (
                    f"VPS отправляет UDP на {endpoint}, но OpenVPN не получает первый TLS-ответ. "
                    "Обычно это значит, что VPN-сервер не отвечает этому VPS: порт/UDP закрыт, "
                    "сервер ограничивает подключения по IP или endpoint недоступен из сети VPS."
                )
                result["runtime_failure_reason"] = reason
                result["operator_fix"] = (
                    "Проверьте у провайдера VPN, разрешён ли вход с IP VPS 195.2.79.116, "
                    "открыт ли UDP-порт endpoint-а, нет ли лимита на одного клиента, и есть ли TCP-вариант конфига."
                )
                if isinstance(result.get("external_ip"), dict):
                    result["external_ip"]["detail"] = reason

    after_link = run_readonly(["ip", "link", "show", ifname], timeout=5)
    cleanup_ok = after_link["rc"] != 0 and (proc is None or proc.poll() is not None)
    result["cleanup"] = {
        "status": "OK" if cleanup_ok else "FAIL",
        "process_stopped": proc is None or proc.poll() is not None,
        "interface_absent": after_link["rc"] != 0,
        "runtime_config": runtime_config.name,
    }
    result["checks"].append({"id": "cleanup", "status": result["cleanup"]["status"], "detail": "temporary OpenVPN stopped"})
    result["status"] = "PASS" if result.get("external_ip", {}).get("ok") and cleanup_ok else ("FAIL_EXTERNAL_IP" if started else "FAIL")
    if requested_mode == "quarantine":
        matrix_status = (result.get("service_matrix") or {}).get("status", "")
        if result["status"] == "PASS" and matrix_status == "PASS":
            result["quarantine_status"] = "PASS"
        else:
            result["quarantine_status"] = "BLOCKED"
            result.setdefault("service_matrix", {"status": "UNAVAILABLE", "reason": "OpenVPN runtime or service checks did not pass"})
    return result, None


def egress_draft_runtime_run(draft_id, actor, duration=8, requested_mode="runtime"):
    duration = max(3, min(int(duration or 8), 20))
    requested_mode = str(requested_mode or "runtime")
    if requested_mode not in {"runtime", "quarantine"}:
        return None, {"error": "invalid_runtime_mode"}
    if not safe_draft_id(draft_id):
        return None, {"error": "invalid_draft_id"}
    draft_dir_pre = egress_draft_path(draft_id)
    metadata_pre = read_json(draft_dir_pre / "metadata.json", {}) if draft_dir_pre else {}
    protocol_pre = str(metadata_pre.get("protocol", ""))
    helper = shutil.which("v7-egress-draft-runtime-helper")
    runner = shutil.which("systemd-run")
    if protocol_pre != "openvpn" and helper and runner and os.environ.get("V7_EGRESS_DRAFT_RUNTIME_HELPER", "1") != "0":
        cmd = [
            runner,
            "--quiet",
            "--wait",
            "--pipe",
            "--collect",
            "--property=Type=oneshot",
            "--property=NoNewPrivileges=no",
            "--property=PrivateTmp=yes",
            helper,
            draft_id,
            str(duration),
            actor or "admin",
            requested_mode,
        ]
        helper_timeout = duration + (260 if requested_mode == "quarantine" else 80)
        helper_started_at = time.time()
        helper_result = run_action(cmd, actor, timeout=helper_timeout)
        try:
            parsed = json.loads(helper_result.get("output", "{}"))
        except json.JSONDecodeError:
            parsed = None
        if not isinstance(parsed, dict):
            parsed, metadata_from_file = egress_draft_helper_result_from_files(draft_id, requested_mode, since=helper_started_at)
        else:
            metadata_from_file = {}
        if isinstance(parsed, dict) and not parsed.get("error"):
            draft_dir = egress_draft_path(draft_id)
            metadata = metadata_from_file if isinstance(metadata_from_file, dict) and metadata_from_file else (read_json(draft_dir / "metadata.json", {}) if draft_dir else {})
            parsed = egress_draft_enrich_runtime_result(parsed, metadata)
            if requested_mode == "quarantine" and draft_dir:
                metadata_path = draft_dir / "metadata.json"
                metadata.update({
                    "last_quarantine_status": parsed.get("quarantine_status", metadata.get("last_quarantine_status", "")),
                    "last_quarantine_run_id": parsed.get("id", metadata.get("last_quarantine_run_id", "")),
                    "last_service_matrix_status": (parsed.get("service_matrix") or {}).get("status", ""),
                    "last_route_class_fitness": parsed.get("route_class_fitness", {}),
                    "last_role_fit": parsed.get("role_fit", {}),
                })
                metadata["next_step"] = "add_to_pool_preview" if parsed.get("quarantine_status") == "PASS" else metadata.get("next_step", "")
                metadata["lifecycle"] = egress_draft_lifecycle(metadata)
                write_json_atomic(metadata_path, metadata)
                try:
                    os.chmod(metadata_path, 0o600)
                except OSError:
                    pass
            if draft_dir:
                metadata_path = draft_dir / "metadata.json"
                metadata = read_json(metadata_path, {})
                if isinstance(metadata, dict) and metadata:
                    metadata["lifecycle"] = egress_draft_lifecycle(metadata)
                    write_json_atomic(metadata_path, metadata)
                    try:
                        os.chmod(metadata_path, 0o600)
                    except OSError:
                        pass
                    parsed["lifecycle"] = metadata["lifecycle"]
            return parsed, None
        if isinstance(parsed, dict) and parsed.get("error"):
            return None, parsed
        return None, {
            "error": "runtime_helper_failed",
            "message": "Системный helper изолированной проверки завершился с ошибкой. Канал не добавлен.",
            "detail": (helper_result.get("output", "") or "")[-1200:],
            "rc": helper_result["rc"],
            "output": helper_result.get("output", ""),
        }

    draft_dir = egress_draft_path(draft_id)
    if not draft_dir:
        return None, {"error": "invalid_draft_id"}
    metadata_path = draft_dir / "metadata.json"
    config_path = draft_dir / "config.input"
    metadata = read_json(metadata_path, {})
    if not metadata or not config_path.exists():
        return None, {"error": "draft_not_found"}
    preflight = egress_draft_latest_preflight(metadata)
    if preflight.get("status") != "PASS":
        return None, {"error": "runtime_requires_passing_preflight", "last_preflight_status": metadata.get("last_preflight_status", "")}
    try:
        text = config_path.read_text(encoding="utf-8")
    except OSError as exc:
        return None, {"error": "draft_config_read_failed", "detail": str(exc)}
    preview, error = egress_config_preview({"label": metadata.get("label", draft_id), "config": text})
    if error:
        return None, error
    protocol = preview.get("protocol", "unknown")
    runtime_mode = preview.get("runtime_mode", "unknown")
    proxy_protocols = {"vless", "vmess", "trojan", "shadowsocks_or_outline", "sing-box", "hysteria", "hysteria2", "tuic", "anytls", "socks", "http", "wireguard_uri"}
    if runtime_mode in ("proxy_or_tun", "sing_box") and protocol in proxy_protocols:
        run_id = f"{draft_id}-{requested_mode}-{int(time.time())}-{secrets.token_hex(3)}"
        EGRESS_DRAFT_TESTS_DIR.mkdir(parents=True, exist_ok=True)
        os.chmod(EGRESS_DRAFT_TESTS_DIR, 0o700)
        run_dir = EGRESS_DRAFT_TESTS_DIR / run_id
        run_dir.mkdir(mode=0o700, parents=False, exist_ok=False)
        write_text_atomic(run_dir / "config.input", text if text.endswith("\n") else text + "\n", mode=0o600)
        result, error = egress_draft_proxy_runtime_run(metadata, draft_id, text, actor, duration, requested_mode, run_dir, run_id)
        if error:
            return None, error
        result = egress_draft_enrich_runtime_result(result, metadata)
        result["next_step"] = "add_to_pool_preview" if result.get("quarantine_status") == "PASS" else ("service_matrix_quarantine_test" if result["status"] == "PASS" else "inspect_runtime_failure")
        write_json_atomic(run_dir / "result.json", result)
        try:
            os.chmod(run_dir / "result.json", 0o600)
        except OSError:
            pass
        metadata.update({
            "last_runtime_at": result["created_at"],
            "last_runtime_status": result["status"],
            "last_runtime_run_id": run_id,
            "next_step": result["next_step"],
        })
        if requested_mode == "quarantine":
            metadata.update({
                "last_quarantine_at": result["created_at"],
                "last_quarantine_status": result.get("quarantine_status", "BLOCKED"),
                "last_quarantine_run_id": run_id,
                "last_service_matrix_status": (result.get("service_matrix") or {}).get("status", ""),
                "last_route_class_fitness": result.get("route_class_fitness", {}),
                "last_role_fit": result.get("role_fit", {}),
            })
        metadata["lifecycle"] = egress_draft_lifecycle(metadata)
        write_json_atomic(metadata_path, metadata)
        try:
            os.chmod(metadata_path, 0o600)
        except OSError:
            pass
        return result, None
    if protocol == "openvpn" and runtime_mode == "interface":
        run_id = f"{draft_id}-{requested_mode}-{int(time.time())}-{secrets.token_hex(3)}"
        EGRESS_DRAFT_TESTS_DIR.mkdir(parents=True, exist_ok=True)
        os.chmod(EGRESS_DRAFT_TESTS_DIR, 0o700)
        run_dir = EGRESS_DRAFT_TESTS_DIR / run_id
        run_dir.mkdir(mode=0o700, parents=False, exist_ok=False)
        write_text_atomic(run_dir / "config.input", text if text.endswith("\n") else text + "\n", mode=0o600)
        result, error = egress_draft_openvpn_runtime_run(metadata, draft_id, text, actor, duration, requested_mode, run_dir, run_id)
        if error:
            return None, error
        result = egress_draft_enrich_runtime_result(result, metadata)
        result["next_step"] = "add_to_pool_preview" if result.get("quarantine_status") == "PASS" else ("service_matrix_quarantine_test" if result["status"] == "PASS" else "inspect_runtime_failure")
        write_json_atomic(run_dir / "result.json", result)
        try:
            os.chmod(run_dir / "result.json", 0o600)
        except OSError:
            pass
        metadata.update({
            "last_runtime_at": result["created_at"],
            "last_runtime_status": result["status"],
            "last_runtime_run_id": run_id,
            "next_step": result["next_step"],
        })
        if requested_mode == "quarantine":
            metadata.update({
                "last_quarantine_at": result["created_at"],
                "last_quarantine_status": result.get("quarantine_status", "BLOCKED"),
                "last_quarantine_run_id": run_id,
                "last_service_matrix_status": (result.get("service_matrix") or {}).get("status", ""),
                "last_route_class_fitness": result.get("route_class_fitness", {}),
                "last_role_fit": result.get("role_fit", {}),
            })
        metadata["lifecycle"] = egress_draft_lifecycle(metadata)
        write_json_atomic(metadata_path, metadata)
        try:
            os.chmod(metadata_path, 0o600)
        except OSError:
            pass
        return result, None
    if protocol not in ("wireguard", "amneziawg") or runtime_mode != "interface":
        return None, {"error": "runtime_adapter_not_ready", "protocol": protocol, "runtime_mode": runtime_mode}
    sanitized, error = egress_draft_sanitize_interface_config(text, protocol)
    if error:
        return None, error

    run_id = f"{draft_id}-runtime-{int(time.time())}-{secrets.token_hex(3)}"
    ifname = f"v7rt{secrets.token_hex(5)}"
    EGRESS_DRAFT_TESTS_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(EGRESS_DRAFT_TESTS_DIR, 0o700)
    run_dir = EGRESS_DRAFT_TESTS_DIR / run_id
    run_dir.mkdir(mode=0o700, parents=False, exist_ok=False)
    archived_config = run_dir / "sanitized-runtime.conf"
    runtime_config = Path("/etc/wireguard") / f"{ifname}.conf"
    write_text_atomic(archived_config, sanitized, mode=0o600)

    result = {
        "id": run_id,
        "draft_id": draft_id,
        "label": metadata.get("label", draft_id),
        "created_at": now_iso(),
        "created_by": actor or "admin",
        "stage": "isolated_runtime",
        "mode": "temporary_interface_auto_cleanup",
        "requested_mode": requested_mode,
        "protocol": protocol,
        "runtime_mode": runtime_mode,
        "interface": ifname,
        "duration_seconds": duration,
        "pool_action": "still_not_added",
        "route_action": "none",
        "secret_redaction": "raw_config_not_returned",
        "checks": [],
    }

    before_link = run_readonly(["ip", "link", "show", ifname], timeout=5)
    if before_link["rc"] == 0:
        result["status"] = "BLOCKED"
        result["checks"].append({"id": "interface_name_free", "status": "FAIL", "detail": "temporary interface already exists"})
        write_json_atomic(run_dir / "result.json", result)
        return result, None
    result["checks"].append({"id": "interface_name_free", "status": "OK", "detail": ifname})
    if runtime_config.exists():
        result["status"] = "BLOCKED"
        result["checks"].append({"id": "runtime_config_name_free", "status": "FAIL", "detail": f"{runtime_config.name} already exists"})
        write_json_atomic(run_dir / "result.json", result)
        return result, None
    write_text_atomic(runtime_config, sanitized, mode=0o600)
    result["checks"].append({"id": "runtime_config_created", "status": "OK", "detail": runtime_config.name})

    up_cmd = ["wg-quick", "up", ifname]
    if protocol == "amneziawg" and shutil.which("awg-quick"):
        up_cmd = ["awg-quick", "up", str(runtime_config)]
    up_result = run_action(up_cmd, actor, timeout=25)
    result["up"] = {"rc": up_result["rc"], "output": up_result["output"]}
    result["checks"].append({"id": "runtime_up", "status": "OK" if up_result["rc"] == 0 else "FAIL", "detail": f"rc={up_result['rc']}"})

    if up_result["rc"] == 0:
        link_result = run_readonly(["ip", "-br", "addr", "show", ifname], timeout=5)
        wg_show_cmd = ["wg", "show", ifname] if protocol == "wireguard" else ["awg", "show", ifname]
        wg_result = run_readonly(wg_show_cmd, timeout=5)
        curl_result = run_readonly(["curl", "--interface", ifname, "-4", "--max-time", str(duration), "-fsS", "https://ifconfig.me"], timeout=duration + 4)
        result["interface_up"] = link_result["rc"] == 0
        result["link"] = {"rc": link_result["rc"], "output": link_result["output"]}
        result["wg_show"] = {"rc": wg_result["rc"], "output": wg_result["output"]}
        result["external_ip"] = {
            "ok": curl_result["rc"] == 0 and bool(str(curl_result["output"]).strip()),
            "rc": curl_result["rc"],
            "ip": str(curl_result["output"]).strip() if curl_result["rc"] == 0 else "",
            "detail": curl_result["output"] if curl_result["rc"] != 0 else "",
        }
        result["checks"].append({"id": "interface_visible", "status": "OK" if result["interface_up"] else "FAIL", "detail": ifname})
        result["checks"].append({"id": "external_ip", "status": "OK" if result["external_ip"]["ok"] else "FAIL", "detail": result["external_ip"].get("ip") or result["external_ip"].get("detail", "")})
        if requested_mode == "quarantine" and result["external_ip"]["ok"]:
            role = ((metadata.get("usage_policy") or {}).get("role") or metadata.get("role") or "GLOBAL_FAST")
            matrix = egress_draft_interface_service_matrix(ifname, role, duration)
            result["service_matrix"] = matrix
            result["checks"].append({
                "id": "service_matrix",
                "status": "OK" if matrix.get("status") == "PASS" else "FAIL",
                "detail": f"{matrix.get('ok_count', 0)}/{matrix.get('total', 0)}",
            })
    else:
        result["interface_up"] = False
        result["external_ip"] = {"ok": False, "rc": up_result["rc"], "ip": "", "detail": "runtime did not start"}

    partial_link = run_readonly(["ip", "link", "show", ifname], timeout=5)
    should_cleanup = up_result["rc"] == 0 or partial_link["rc"] == 0
    down_cmd = ["wg-quick", "down", ifname]
    if protocol == "amneziawg" and shutil.which("awg-quick"):
        down_cmd = ["awg-quick", "down", str(runtime_config)]
    down_result = run_action(down_cmd, actor, timeout=25) if should_cleanup else {"rc": 0, "output": "not_started_no_cleanup_needed"}
    try:
        runtime_config.unlink()
        runtime_config_removed = True
    except FileNotFoundError:
        runtime_config_removed = True
    except OSError as exc:
        runtime_config_removed = False
        result["runtime_config_remove_error"] = str(exc)
    after_link = run_readonly(["ip", "link", "show", ifname], timeout=5)
    interface_absent = after_link["rc"] != 0
    cleanup_ok = interface_absent and runtime_config_removed
    result["cleanup"] = {
        "status": "OK" if cleanup_ok else "FAIL",
        "down_rc": down_result["rc"],
        "down_output": down_result["output"],
        "interface_absent": interface_absent,
        "runtime_config_removed": runtime_config_removed,
    }
    result["checks"].append({"id": "cleanup", "status": "OK" if cleanup_ok else "FAIL", "detail": f"down_rc={down_result['rc']}"})
    result["status"] = egress_runtime_status_from_external_ip(result)
    if requested_mode == "quarantine":
        matrix_status = (result.get("service_matrix") or {}).get("status", "")
        if result["status"] == "PASS" and matrix_status == "PASS":
            result["quarantine_status"] = "PASS"
        else:
            result["quarantine_status"] = "BLOCKED"
            result.setdefault("service_matrix", {"status": "UNAVAILABLE", "reason": "runtime or service checks did not pass"})
    result = egress_draft_enrich_runtime_result(result, metadata)
    result["next_step"] = "add_to_pool_preview" if result.get("quarantine_status") == "PASS" else ("service_matrix_quarantine_test" if result["status"] == "PASS" else "inspect_runtime_failure")

    write_json_atomic(run_dir / "result.json", result)
    try:
        os.chmod(run_dir / "result.json", 0o600)
    except OSError:
        pass
    metadata.update({
        "last_runtime_at": result["created_at"],
        "last_runtime_status": result["status"],
        "last_runtime_run_id": run_id,
        "next_step": result["next_step"],
    })
    if requested_mode == "quarantine":
        metadata.update({
            "last_quarantine_at": result["created_at"],
            "last_quarantine_status": result.get("quarantine_status", "BLOCKED"),
            "last_quarantine_run_id": run_id,
            "last_service_matrix_status": (result.get("service_matrix") or {}).get("status", ""),
            "last_route_class_fitness": result.get("route_class_fitness", {}),
            "last_role_fit": result.get("role_fit", {}),
        })
    metadata["lifecycle"] = egress_draft_lifecycle(metadata)
    write_json_atomic(metadata_path, metadata)
    try:
        os.chmod(metadata_path, 0o600)
    except OSError:
        pass
    return result, None


def egress_draft_pool_preview(draft_id, allow_duplicate=False):
    draft_dir = egress_draft_path(draft_id)
    if not draft_dir:
        return None, {"error": "invalid_draft_id"}
    metadata = read_json(draft_dir / "metadata.json", {})
    if not metadata:
        return None, {"error": "draft_not_found"}
    try:
        draft_text = (draft_dir / "config.input").read_text(encoding="utf-8")
    except OSError:
        draft_text = ""
    label = metadata.get("label") or draft_id
    proposed_id = safe_egress_id(re.sub(r"[^A-Za-z0-9_.-]+", "-", str(label).lower()).strip("-")[:32]) or safe_egress_id(draft_id[:32])
    protocol = metadata.get("protocol", "unknown")
    runtime_mode = metadata.get("runtime_mode", "unknown")
    enabled = "0"
    typ = "interface" if runtime_mode == "interface" else "proxy"
    interface = egress_managed_interface_name(proposed_id) if typ == "interface" else ""
    proxy_port = egress_managed_proxy_port(proposed_id) if typ == "proxy" else 0
    test = "interface" if typ == "interface" else f"socks5://127.0.0.1:{proxy_port}"
    target_path = egress_draft_runtime_target_path(protocol, runtime_mode, proposed_id, interface)
    config_part = f" config={target_path}" if target_path else ""
    usage_policy = egress_usage_policy_from_data({}, metadata.get("usage_policy") or metadata)
    policy_part = egress_usage_policy_registry_part(usage_policy)
    proposed_line = f"id={proposed_id} protocol={protocol} type={typ} interface={interface} test={test} enabled={enabled}{config_part} {policy_part}".strip()
    active_text = read_text(STATE_DIR / "egress.registry", "")
    id_exists = bool(re.search(rf"^id={re.escape(proposed_id)}\s", active_text, flags=re.M))
    blockers = []
    if metadata.get("last_preflight_status") != "PASS":
        blockers.append("preflight_not_passed")
    if metadata.get("last_runtime_status") != "PASS":
        blockers.append("runtime_not_passed")
    if metadata.get("last_quarantine_status") != "PASS":
        blockers.append("quarantine_not_passed")
    if id_exists:
        blockers.append("egress_id_already_exists")
    duplicate = {}
    if protocol in ("wireguard", "amneziawg") and runtime_mode == "interface" and draft_text:
        duplicate = egress_draft_duplicate_interface_egress(protocol, draft_text, proposed_id)
        if duplicate and not allow_duplicate:
            blockers.append("duplicate_interface_config")
    if protocol == "openvpn" and runtime_mode == "interface" and draft_text:
        duplicate = egress_draft_duplicate_openvpn_egress(draft_text, proposed_id)
        if duplicate and not allow_duplicate:
            blockers.append("duplicate_interface_config")
    if protocol not in ("wireguard", "amneziawg", "openvpn", "vless", "sing-box", "shadowsocks_or_outline", "vmess", "trojan", "hysteria", "hysteria2", "tuic", "anytls", "socks", "http", "wireguard_uri"):
        blockers.append("unsupported_protocol")
    return {
        "draft_id": draft_id,
        "human": "Только предпросмотр. Файлы не меняются, пользователи не переносятся.",
        "terms": {
            "pool": "активный список egress-каналов, через которые V7 может вести пользователей",
            "registry_line": "строка, которая будет добавлена в /opt/v7/egress/state/egress.registry",
            "enabled_0": "канал стартует выключенным, пока оператор явно не включит его",
            "role": "роль канала, например GLOBAL_FAST или TRUSTED_RU_SENSITIVE",
        },
        "ready": not blockers,
        "blockers": blockers,
        "proposed": {
            "id": proposed_id,
            "protocol": protocol,
            "type": typ,
            "interface": interface,
            "test": test,
            "enabled": enabled,
            "listen_port": proxy_port,
            "config": str(target_path) if target_path else "",
            "role": usage_policy["role"],
            "priority": usage_policy["priority"],
            "weight": usage_policy["weight"],
            "soft_limit": usage_policy["soft_limit"],
            "hard_limit": usage_policy["hard_limit"],
            "manual_only": usage_policy["manual_only"],
            "reserve_only": usage_policy["reserve_only"],
            "service_tags": usage_policy["service_tags"],
            "exclude_route_classes": usage_policy["exclude_route_classes"],
            "usage_policy": usage_policy,
            "registry_line": proposed_line,
        },
        "source_checks": {
            "preflight": metadata.get("last_preflight_status", ""),
            "runtime": metadata.get("last_runtime_status", ""),
            "quarantine": metadata.get("last_quarantine_status", ""),
            "next_step": metadata.get("next_step", ""),
            "duplicate": duplicate,
            "duplicate_override_allowed": bool(duplicate),
            "duplicate_override_requested": bool(duplicate and allow_duplicate),
        },
        "would_backup": [
            str(STATE_DIR / "egress.registry"),
            str(draft_dir / "metadata.json"),
        ],
        "would_change": [
            str(STATE_DIR / "egress.registry"),
        ],
        "would_not_change": [
            str(STATE_DIR / "users.registry"),
            "current user routes",
            "running V7 services",
        ],
        "pool_action": "preview_only_not_added",
        "duplicate_policy": {
            "duplicate": bool(duplicate),
            "default_action": "block_and_ask_operator" if duplicate else "continue",
            "operator_can_create_duplicate": bool(duplicate),
            "duplicate_of": duplicate,
            "override_requested": bool(duplicate and allow_duplicate),
        },
    }, None


def egress_draft_pool_apply(draft_id, actor, allow_duplicate=False):
    preview, error = egress_draft_pool_preview(draft_id, allow_duplicate=allow_duplicate)
    if error:
        return None, error
    if not preview.get("ready"):
        return None, {
            "error": "egress_draft_not_ready_for_pool",
            "blockers": preview.get("blockers", []),
            "preview": preview,
        }

    draft_dir = egress_draft_path(draft_id)
    metadata_path = draft_dir / "metadata.json"
    registry_path = STATE_DIR / "egress.registry"
    metadata = read_json(metadata_path, {})
    registry_text = read_text(registry_path, "")
    if not registry_text.strip():
        return None, {"error": "egress_registry_missing_or_empty", "path": str(registry_path)}

    proposed = preview.get("proposed") or {}
    duplicate = ((preview.get("source_checks") or {}).get("duplicate") or {})
    proposed_id = safe_egress_id(proposed.get("id", ""))
    proposed_line = str(proposed.get("registry_line", "")).strip()
    usage_policy = egress_usage_policy_from_data({}, proposed.get("usage_policy") or proposed)
    if not proposed_id or not proposed_line.startswith(f"id={proposed_id} "):
        return None, {"error": "invalid_pool_preview_proposal"}
    if re.search(rf"^id={re.escape(proposed_id)}\s", registry_text, flags=re.M):
        return None, {"error": "egress_id_already_exists", "egress": proposed_id}

    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    registry_backup = registry_path.with_name(f"{registry_path.name}.backup.v7-egress-draft-pool-apply.{stamp}")
    metadata_backup = metadata_path.with_name(f"{metadata_path.name}.backup.v7-egress-draft-pool-apply.{stamp}")
    shutil.copy2(registry_path, registry_backup)
    shutil.copy2(metadata_path, metadata_backup)

    registry_mode = registry_path.stat().st_mode & 0o777
    next_registry = registry_text.rstrip() + "\n" + proposed_line + "\n"
    write_text_atomic(registry_path, next_registry, mode=registry_mode or 0o600)

    metadata.update({
        "status": "pool_added_disabled",
        "pool_action": "added_disabled",
        "pool_added_at": now_iso(),
        "pool_added_by": actor or "admin",
        "pool_egress_id": proposed_id,
        "pool_registry_line": proposed_line,
        "pool_registry_backup": str(registry_backup),
        "pool_metadata_backup": str(metadata_backup),
        "duplicate_of": duplicate if duplicate else {},
        "duplicate_override_at": now_iso() if duplicate and allow_duplicate else "",
        "duplicate_override_by": (actor or "admin") if duplicate and allow_duplicate else "",
        "role": usage_policy["role"],
        "priority": usage_policy["priority"],
        "weight": usage_policy["weight"],
        "soft_limit": usage_policy["soft_limit"],
        "hard_limit": usage_policy["hard_limit"],
        "manual_only": usage_policy["manual_only"],
        "reserve_only": usage_policy["reserve_only"],
        "service_tags": usage_policy["service_tags"],
        "exclude_route_classes": usage_policy["exclude_route_classes"],
        "usage_policy": usage_policy,
        "next_step": "explicit_enable_after_operator_review",
    })
    metadata["lifecycle"] = egress_draft_lifecycle(metadata)
    write_json_atomic(metadata_path, metadata)
    try:
        os.chmod(metadata_path, 0o600)
    except OSError:
        pass

    return {
        "draft_id": draft_id,
        "human": "The channel was added to the V7 pool disabled. Users were not moved and the channel will not carry traffic until it is explicitly enabled.",
        "terms": {
            "pool": "the active registry of channels V7 knows about",
            "disabled": "enabled=0 means V7 can see the channel, but must not route users through it yet",
            "backup": "timestamped copies created before changing registry or draft metadata",
        },
        "egress": proposed_id,
        "usage_policy": usage_policy,
        "registry_line": proposed_line,
        "enabled": "0",
        "changed": [str(registry_path), str(metadata_path)],
        "backups": [str(registry_backup), str(metadata_backup)],
        "users_moved": False,
        "routes_changed": False,
        "services_restarted": False,
        "next_step": "enable_explicitly_after_operator_review",
        "pool_action": "added_disabled",
        "duplicate_of": duplicate if duplicate else {},
        "duplicate_override": bool(duplicate and allow_duplicate),
    }, None


def egress_draft_existing_update_apply(draft_id, target_egress, actor):
    draft_dir = egress_draft_path(draft_id)
    if not draft_dir:
        return None, {"error": "invalid_draft_id"}
    metadata_path = draft_dir / "metadata.json"
    config_path = draft_dir / "config.input"
    metadata = read_json(metadata_path, {})
    if not metadata or not config_path.exists():
        return None, {"error": "draft_not_found"}
    for field, error in (
        ("last_preflight_status", "preflight_not_passed"),
        ("last_runtime_status", "runtime_not_passed"),
        ("last_quarantine_status", "quarantine_not_passed"),
    ):
        if metadata.get(field) != "PASS":
            return None, {"error": error, "field": field}

    target_egress = safe_egress_id(target_egress or "")
    registry = egress_registry_map(enabled_only=False).get(target_egress, {})
    if not target_egress or not registry:
        return None, {"error": "invalid_target_egress"}
    protocol = metadata.get("protocol", "unknown")
    runtime_mode = metadata.get("runtime_mode", "unknown")
    if protocol not in ("wireguard", "amneziawg", "openvpn") or runtime_mode != "interface" or registry.get("type") != "interface":
        return None, {
            "error": "existing_update_adapter_not_ready",
            "protocol": protocol,
            "runtime_mode": runtime_mode,
            "target_type": registry.get("type", ""),
        }

    raw = config_path.read_text(encoding="utf-8")
    duplicate = egress_draft_duplicate_openvpn_egress(raw, "") if protocol == "openvpn" else egress_draft_duplicate_interface_egress(protocol, raw, "")
    if duplicate.get("egress") != target_egress:
        return None, {
            "error": "existing_update_target_not_duplicate",
            "target_egress": target_egress,
            "duplicate": duplicate,
        }

    ifname = registry.get("interface") or egress_managed_interface_name(target_egress)
    target_path = egress_config_path(target_egress) or egress_draft_runtime_target_path(protocol, runtime_mode, target_egress, ifname)
    safe_path = egress_delete_safe_path(target_path)
    if not safe_path:
        return None, {"error": "unsafe_target_config_path", "path": str(target_path or "")}
    auth_text = ""
    auth_path = None
    if protocol == "openvpn":
        auth_path = safe_path.with_suffix(".auth")
        runtime_text, auth_text, error = egress_openvpn_normalize_runtime_config(raw, ifname, auth_path=auth_path)
    else:
        runtime_text, error = egress_draft_sanitize_interface_config(raw, protocol)
    if error:
        return None, error

    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    backups = []
    commands = []
    metadata_backup = metadata_path.with_name(f"{metadata_path.name}.backup.v7-existing-update.{stamp}")
    shutil.copy2(metadata_path, metadata_backup)
    backups.append(str(metadata_backup))

    target_backup = ""
    old_text = read_text(safe_path, "") if safe_path.exists() else ""
    if safe_path.exists():
        target_backup_path = safe_path.with_name(f"{safe_path.name}.backup.v7-existing-update.{stamp}")
        shutil.copy2(safe_path, target_backup_path)
        target_backup = str(target_backup_path)
        backups.append(target_backup)

    changed = False
    was_enabled = str(registry.get("enabled", "1")) == "1"
    was_live = egress_interface_live(ifname)
    tool = "awg-quick" if protocol == "amneziawg" and shutil.which("awg-quick") else "wg-quick"
    down_result = {"rc": 0, "output": "not_live"}
    if was_live:
        if protocol == "openvpn":
            down_result = run_action(["v7-egress-set-state", target_egress, "disabled", "--apply"], actor, timeout=40)
            commands.append({"cmd": f"v7-egress-set-state {target_egress} disabled --apply", "rc": down_result.get("rc"), "output": down_result.get("output", "")[-800:]})
        else:
            down_result = run_action([tool, "down", str(safe_path)], actor, timeout=30)
            commands.append({"cmd": f"{tool} down {safe_path}", "rc": down_result.get("rc"), "output": down_result.get("output", "")[-800:]})
        if egress_interface_live(ifname):
            return None, {
                "error": "existing_update_down_failed",
                "egress": target_egress,
                "interface": ifname,
                "down_result": down_result,
                "backups": backups,
            }

    try:
        if old_text.strip() != runtime_text.strip():
            safe_path.parent.mkdir(parents=True, exist_ok=True)
            write_text_atomic(safe_path, runtime_text if runtime_text.endswith("\n") else runtime_text + "\n", mode=0o600)
            if auth_text and auth_path:
                write_text_atomic(auth_path, auth_text, mode=0o600)
            changed = True
    except Exception as exc:
        if target_backup and Path(target_backup).exists():
            shutil.copy2(target_backup, safe_path)
        return None, {"error": "existing_update_write_failed", "detail": str(exc), "backups": backups}

    up_result = {"rc": 0, "output": "not_previously_live"}
    rollback_result = {}
    if was_live:
        if protocol == "openvpn":
            up_result = run_action(["v7-egress-set-state", target_egress, "enabled", "--apply"], actor, timeout=40)
            commands.append({"cmd": f"v7-egress-set-state {target_egress} enabled --apply", "rc": up_result.get("rc"), "output": up_result.get("output", "")[-800:]})
        else:
            up_result = run_action([tool, "up", str(safe_path)], actor, timeout=30)
            commands.append({"cmd": f"{tool} up {safe_path}", "rc": up_result.get("rc"), "output": up_result.get("output", "")[-800:]})
        if up_result.get("rc") != 0 and target_backup and Path(target_backup).exists():
            shutil.copy2(target_backup, safe_path)
            rollback_up = run_action(["v7-egress-set-state", target_egress, "enabled", "--apply"], actor, timeout=40) if protocol == "openvpn" else run_action([tool, "up", str(safe_path)], actor, timeout=30)
            rollback_result = {"restored_backup": target_backup, "up": rollback_up}
            return None, {
                "error": "existing_update_restart_failed_rolled_back",
                "egress": target_egress,
                "interface": ifname,
                "up_result": up_result,
                "rollback": rollback_result,
                "backups": backups,
                "commands": commands,
            }

    metadata.update({
        "status": "existing_channel_updated",
        "pool_action": "updated_existing",
        "pool_egress_id": target_egress,
        "updated_existing_egress": target_egress,
        "updated_existing_at": now_iso(),
        "updated_existing_by": actor or "admin",
        "updated_existing_config_path": str(safe_path),
        "updated_existing_config_backup": target_backup,
        "runtime_profile_status": "READY",
        "runtime_profile_path": str(safe_path),
        "runtime_profile_interface": ifname,
        "duplicate_of": duplicate,
        "next_step": "existing_channel_updated_watch_health" if was_enabled else "existing_channel_updated_disabled",
    })
    metadata["lifecycle"] = egress_draft_lifecycle(metadata)
    write_json_atomic(metadata_path, metadata)
    try:
        os.chmod(metadata_path, 0o600)
    except OSError:
        pass

    return {
        "draft_id": draft_id,
        "egress": target_egress,
        "status": "UPDATED",
        "changed": changed,
        "config_path": str(safe_path),
        "backups": backups,
        "was_enabled": was_enabled,
        "was_live": was_live,
        "restarted": bool(was_live),
        "commands": commands,
        "down_result": down_result,
        "up_result": up_result,
        "users_moved": False,
        "routes_changed": False,
        "next_step": metadata["next_step"],
    }, None


def egress_draft_runtime_provision(draft_id, actor):
    draft_dir = egress_draft_path(draft_id)
    if not draft_dir:
        return None, {"error": "invalid_draft_id"}
    metadata_path = draft_dir / "metadata.json"
    config_path = draft_dir / "config.input"
    metadata = read_json(metadata_path, {})
    if not metadata or not config_path.exists():
        return None, {"error": "draft_not_found"}
    if metadata.get("pool_action") != "added_disabled" or not safe_egress_id(metadata.get("pool_egress_id", "")):
        return None, {
            "error": "runtime_provision_requires_added_disabled_pool_entry",
            "current_pool_action": metadata.get("pool_action", "not_added"),
        }

    egress_id = safe_egress_id(metadata.get("pool_egress_id", ""))
    registry = egress_registry_map().get(egress_id, {})
    if not registry:
        return None, {"error": "egress_not_found_in_registry", "egress": egress_id}
    if str(registry.get("enabled", "1")) != "0":
        return None, {"error": "runtime_provision_requires_disabled_egress", "egress": egress_id}

    protocol = metadata.get("protocol", "unknown")
    runtime_mode = metadata.get("runtime_mode", "unknown")
    supported_proxy = protocol in ("vless", "vmess", "trojan", "shadowsocks_or_outline", "sing-box", "hysteria", "hysteria2", "tuic", "anytls", "socks", "http", "wireguard_uri") and runtime_mode in ("proxy_or_tun", "sing_box")
    supported_interface = protocol in ("wireguard", "amneziawg", "openvpn") and runtime_mode == "interface"
    if not supported_interface and not supported_proxy:
        return None, {
            "error": "runtime_provision_adapter_not_ready",
            "protocol": protocol,
            "runtime_mode": runtime_mode,
            "message": "This protocol adapter is not ready for runtime provisioning yet.",
        }

    ifname = registry.get("interface") or (egress_managed_interface_name(egress_id) if supported_interface else "")
    if supported_interface and not re.match(r"^[A-Za-z0-9_.-]{1,15}$", ifname or ""):
        return None, {"error": "invalid_or_too_long_interface_name", "interface": ifname}
    target_path = egress_draft_runtime_target_path(protocol, runtime_mode, egress_id, ifname)
    if not target_path:
        return None, {"error": "runtime_target_path_unavailable", "protocol": protocol, "runtime_mode": runtime_mode}

    try:
        raw = config_path.read_text(encoding="utf-8")
    except OSError as exc:
        return None, {"error": "draft_config_read_failed", "detail": str(exc)}
    auth_text = ""
    auth_path = None
    if supported_interface and protocol == "openvpn":
        auth_path = target_path.with_suffix(".auth")
        runtime_text, auth_text, error = egress_openvpn_normalize_runtime_config(raw, ifname, auth_path=auth_path)
        if error:
            return None, error
    elif supported_interface:
        runtime_text, error = egress_draft_sanitize_interface_config(raw, protocol)
        if error:
            return None, error
    else:
        listen_port = egress_managed_proxy_port(egress_id)
        test_value = str(registry.get("test", ""))
        match = re.search(r":([0-9]{2,5})$", test_value)
        if match:
            listen_port = int(match.group(1))
        if not 1024 <= int(listen_port) <= 65535:
            return None, {"error": "invalid_proxy_listen_port", "port": listen_port}
        runtime_text, error = egress_draft_proxy_runtime_text(raw, listen_port)
        if error:
            return None, error

    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    metadata_backup = metadata_path.with_name(f"{metadata_path.name}.backup.v7-runtime-provision.{stamp}")
    shutil.copy2(metadata_path, metadata_backup)

    target_backup = ""
    target_already_ready = False
    if target_path.exists():
        current = read_text(target_path, "")
        if current.strip() == runtime_text.strip():
            target_already_ready = True
        else:
            return None, {
                "error": "runtime_profile_exists_with_different_content",
                "path": str(target_path),
                "message": "Existing runtime profile differs. Manual review or explicit replace flow is required.",
            }

    if not target_already_ready:
        target_path.parent.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(target_path.parent, 0o700)
        except OSError:
            pass
        write_text_atomic(target_path, runtime_text if runtime_text.endswith("\n") else runtime_text + "\n", mode=0o600)
        if auth_text and auth_path:
            write_text_atomic(auth_path, auth_text, mode=0o600)

    readiness = egress_runtime_readiness(egress_id, registry)
    metadata.update({
        "runtime_profile_status": "READY" if readiness.get("enable_ready") else "BLOCKED",
        "runtime_profile_path": str(target_path),
        "runtime_profile_interface": ifname,
        "runtime_profile_provisioned_at": now_iso(),
        "runtime_profile_provisioned_by": actor or "admin",
        "runtime_profile_metadata_backup": str(metadata_backup),
        "next_step": "explicit_enable_after_operator_review" if readiness.get("enable_ready") else "inspect_runtime_profile_readiness",
    })
    metadata["lifecycle"] = egress_draft_lifecycle(metadata)
    write_json_atomic(metadata_path, metadata)
    try:
        os.chmod(metadata_path, 0o600)
    except OSError:
        pass

    return {
        "draft_id": draft_id,
        "egress": egress_id,
        "human": "Runtime profile is prepared but not started. Users were not moved and the channel remains disabled.",
        "terms": {
            "runtime_profile": "the real root-only config file V7 can use later to start this channel",
            "provisioned": "the profile was written into the managed runtime path",
            "disabled": "the channel still has enabled=0 and cannot carry traffic yet",
        },
        "status": metadata["runtime_profile_status"],
        "protocol": protocol,
        "interface": ifname,
        "listen_port": egress_managed_proxy_port(egress_id) if supported_proxy else 0,
        "path": str(target_path),
        "already_ready": target_already_ready,
        "metadata_backup": str(metadata_backup),
        "target_backup": target_backup,
        "readiness": readiness,
        "users_moved": False,
        "routes_changed": False,
        "services_restarted": False,
        "pool_state": "disabled",
        "next_step": metadata["next_step"],
    }, None


def egress_channel_add_stage(stages, stage_id, status, detail=""):
    for stage in stages:
        if stage.get("id") == stage_id:
            stage["status"] = status
            stage["detail"] = detail
            return
    stages.append({"id": stage_id, "label": stage_id, "status": status, "detail": detail})


def egress_channel_add_result(status, title, detail, draft_id="", egress="", stages=None, error="", fix="", extra=None):
    ok = status in {"ADDED_DISABLED_READY", "UPDATED_EXISTING"}
    result = {
        "status": status,
        "ok": ok,
        "title": title,
        "detail": detail,
        "fix": fix,
        "draft_id": safe_draft_id(draft_id or ""),
        "egress": safe_egress_id(egress or ""),
        "stages": stages or [],
        "users_moved": False,
        "routes_changed": False,
        "entity": "channel",
        "draft_visible_to_operator": False,
    }
    if error:
        result["error"] = error
    if isinstance(extra, dict):
        result.update(extra)
    return result, None


def egress_channel_add_mark_metadata(draft_id, **updates):
    draft_dir = egress_draft_path(draft_id)
    if not draft_dir:
        return
    metadata_path = draft_dir / "metadata.json"
    metadata = read_json(metadata_path, {})
    if not metadata:
        return
    metadata.update(updates)
    metadata["internal_import"] = True
    metadata["user_visible"] = False
    metadata["lifecycle"] = egress_draft_lifecycle(metadata)
    write_json_atomic(metadata_path, metadata)
    try:
        os.chmod(metadata_path, 0o600)
    except OSError:
        pass


def egress_channel_add_convert_container_draft(draft_id, metadata, data, actor):
    draft_dir = egress_draft_path(draft_id)
    config_path = draft_dir / "config.input" if draft_dir else None
    if not config_path or not config_path.exists():
        return None, {"error": "draft_config_not_found"}
    try:
        text = config_path.read_text(encoding="utf-8")
    except OSError as exc:
        return None, {"error": "draft_config_read_failed", "detail": str(exc)}
    expanded, error = egress_expand_endpoints_from_text(text, allow_fetch=True)
    if error:
        return None, error
    endpoints = expanded.get("_internal_endpoints", [])
    ready = [row for row in endpoints if row.get("status") == "READY" and row.get("outbound")]
    if not ready:
        return None, {
            "error": "subscription_has_no_ready_endpoint",
            "count": expanded.get("count", 0),
            "ready": expanded.get("ready", 0),
            "blocked": expanded.get("blocked", 0),
            "source": expanded.get("source", {}),
        }
    selected = ready[0]
    create_result, error = egress_draft_create_endpoint_managed_draft({
        "draft_id": draft_id,
        "endpoint_index": selected.get("index", 1),
        "label": data.get("label") or metadata.get("label") or selected.get("name", ""),
        "role": data.get("role") or metadata.get("role") or (metadata.get("usage_policy") or {}).get("role") or "GLOBAL_FAST",
        "priority": data.get("priority", metadata.get("priority", "")),
        "weight": data.get("weight", metadata.get("weight", "")),
        "soft_limit": data.get("soft_limit", metadata.get("soft_limit", "")),
        "hard_limit": data.get("hard_limit", metadata.get("hard_limit", "")),
        "service_tags": data.get("service_tags", egress_csv_value(metadata.get("service_tags", ""))),
        "exclude_route_classes": data.get("exclude_route_classes", egress_csv_value(metadata.get("exclude_route_classes", ""))),
        "manual_only": data.get("manual_only", metadata.get("manual_only", "")),
        "reserve_only": data.get("reserve_only", metadata.get("reserve_only", "")),
        "organization_scope": data.get("organization_scope", metadata.get("organization_scope", [])),
    }, actor)
    if error:
        return None, error
    child = create_result.get("child_draft") or {}
    child_id = safe_draft_id(child.get("id", ""))
    if child_id:
        egress_channel_add_mark_metadata(
            child_id,
            import_pipeline_started_at=now_iso(),
            import_pipeline_status="RUNNING",
            source_container_draft_id=draft_id,
        )
        child_dir = egress_draft_path(child_id)
        child = read_json(child_dir / "metadata.json", child) if child_dir else child
    public_endpoints = []
    for row in ready[:5]:
        public_endpoints.append({
            "index": row.get("index"),
            "name": row.get("name", ""),
            "protocol": row.get("protocol", ""),
            "target": row.get("target", ""),
        })
    return {
        "status": "CONVERTED",
        "source_draft_id": draft_id,
        "child_draft": child,
        "selected_endpoint_index": selected.get("index"),
        "selected_endpoint_name": selected.get("name", ""),
        "selected_endpoint_protocol": selected.get("protocol", ""),
        "endpoint_count": expanded.get("count", 0),
        "ready_count": expanded.get("ready", 0),
        "candidate_preview": public_endpoints,
    }, None


def egress_channel_add_pipeline(data, actor):
    duplicate_action = str(data.get("duplicate_action", "") or "").strip().lower()
    allow_duplicate = bool_flag_value(data.get("allow_duplicate", "0")) == "1" or duplicate_action in {"allow_duplicate", "create_duplicate", "duplicate"}
    update_existing = duplicate_action in {"update_existing", "replace_existing"}
    target_egress = safe_egress_id(data.get("target_egress") or data.get("egress") or "")
    duration = 10
    duration_raw = str(data.get("duration", "") or "").strip()
    if re.match(r"^[0-9]{1,2}$", duration_raw):
        duration = min(20, max(6, int(duration_raw)))
    stages = [
        {"id": "detect", "label": "Распознавание", "status": "WAITING", "detail": ""},
        {"id": "endpoint", "label": "Выбор endpoint", "status": "WAITING", "detail": ""},
        {"id": "preflight", "label": "Проверка полей", "status": "WAITING", "detail": ""},
        {"id": "runtime", "label": "Временный тест", "status": "WAITING", "detail": ""},
        {"id": "quarantine", "label": "Изолированная проверка", "status": "WAITING", "detail": ""},
        {"id": "duplicate", "label": "Проверка дублей", "status": "WAITING", "detail": ""},
        {"id": "pool", "label": "Добавление в список", "status": "WAITING", "detail": ""},
        {"id": "provision", "label": "Подготовка профиля", "status": "WAITING", "detail": ""},
    ]

    draft_id = safe_draft_id(data.get("draft_id", ""))
    if draft_id:
        draft_dir = egress_draft_path(draft_id)
        if not draft_dir or not (draft_dir / "metadata.json").exists():
            egress_channel_add_stage(stages, "detect", "BLOCKED", "импорт не найден")
            return egress_channel_add_result(
                "NOT_ADDED",
                "Канал не добавлен",
                "V7 не нашёл внутреннюю запись этого импорта. Вставьте конфиг заново и нажмите «Добавить канал».",
                draft_id=draft_id,
                stages=stages,
                error="draft_not_found",
                fix="Вставьте исходный конфиг заново. Рабочие каналы и пользователи не изменялись.",
            )
        metadata = read_json(draft_dir / "metadata.json", {})
    else:
        draft, error = egress_draft_create(data, actor)
        if error:
            egress_channel_add_stage(stages, "detect", "BLOCKED", error.get("error", "ошибка распознавания"))
            return egress_channel_add_result(
                "NOT_ADDED",
                "Канал не добавлен",
                "V7 не смог разобрать конфиг и не менял список каналов.",
                stages=stages,
                error=error.get("error", "config_preview_failed"),
                fix=str(error.get("message") or error.get("detail") or "Проверьте, что вставлен полный рабочий конфиг или ссылка."),
                extra={"raw_error": error},
            )
        draft_id = draft["id"]
        metadata = draft
        egress_channel_add_mark_metadata(draft_id, import_pipeline_started_at=now_iso(), import_pipeline_status="RUNNING")

    validation = str(metadata.get("validation", ""))
    protocol = str(metadata.get("protocol", "unknown"))
    egress_channel_add_stage(stages, "detect", "PASS" if validation == "detected_required_fields" else "BLOCKED", protocol)
    if validation != "detected_required_fields" or protocol == "unknown":
        title = "Канал не добавлен" if protocol != "openvpn" else "OpenVPN распознан, но не добавлен"
        if protocol in {"clash_yaml", "subscription_url", "subscription_list", "xray_json"}:
            return egress_channel_add_result(
                "SELECTION_REQUIRED",
                "Нужно выбрать один endpoint",
                "V7 понял источник, но это список или контейнер. Его нельзя безопасно запускать целиком как один канал.",
                draft_id=draft_id,
                stages=stages,
                error="endpoint_selection_required",
                fix="Разверните источник на endpoint-ы и выберите один конкретный канал для добавления.",
                extra={"protocol": protocol},
            )
        return egress_channel_add_result(
            "NOT_ADDED",
            title,
            "Формат понятен не полностью или не хватает обязательных полей. Канал не попал в рабочий список.",
            draft_id=draft_id,
            stages=stages,
            error="config_not_ready",
            fix="Проверьте адрес сервера, порт, ключи/UUID, сертификаты и вставьте полный конфиг. После этого нажмите «Добавить канал» ещё раз.",
            extra={"protocol": protocol, "validation": validation, "missing": metadata.get("missing", [])},
        )

    if protocol in {"clash_yaml", "subscription_url", "subscription_list", "xray_json"}:
        converted, error = egress_channel_add_convert_container_draft(draft_id, metadata, data, actor)
        if error:
            egress_channel_add_stage(stages, "endpoint", "BLOCKED", error.get("error", "endpoint не выбран"))
            return egress_channel_add_result(
                "NOT_ADDED",
                "Канал не добавлен",
                "V7 распознал подписку или контейнер, но не смог получить из него готовый endpoint для запуска.",
                draft_id=draft_id,
                stages=stages,
                error=error.get("error", "endpoint_conversion_failed"),
                fix="Проверьте, что ссылка подписки доступна с VPS и внутри есть хотя бы один поддерживаемый endpoint. Рабочие каналы не изменялись.",
                extra={"protocol": protocol, "raw_error": error},
            )
        child = converted.get("child_draft") or {}
        child_id = safe_draft_id(child.get("id", ""))
        if not child_id:
            egress_channel_add_stage(stages, "endpoint", "BLOCKED", "managed draft не создан")
            return egress_channel_add_result(
                "NOT_ADDED",
                "Канал не добавлен",
                "V7 выбрал endpoint из подписки, но не смог создать управляемый рабочий профиль.",
                draft_id=draft_id,
                stages=stages,
                error="managed_endpoint_draft_not_created",
                fix="Повторите добавление. Если ошибка сохранится, откройте логи импорта.",
                extra={"protocol": protocol, "conversion": converted},
            )
        egress_channel_add_stage(
            stages,
            "endpoint",
            "PASS",
            f"{converted.get('selected_endpoint_protocol', 'endpoint')} {converted.get('selected_endpoint_index', '')}; готовых {converted.get('ready_count', 0)}/{converted.get('endpoint_count', 0)}",
        )
        draft_id = child_id
        metadata = child
        validation = str(metadata.get("validation", ""))
        protocol = str(metadata.get("protocol", "unknown"))

    if metadata.get("last_preflight_status") == "PASS":
        egress_channel_add_stage(stages, "preflight", "SKIP", "уже пройдено")
    else:
        preflight, error = egress_draft_preflight_run(draft_id, actor)
        if error or str((preflight or {}).get("status", "")).upper() != "PASS":
            egress_channel_add_stage(stages, "preflight", "BLOCKED", (error or preflight or {}).get("error", "проверка не прошла"))
            return egress_channel_add_result(
                "NOT_ADDED",
                "Канал не добавлен",
                "V7 остановился на проверке полей и безопасных директив. Рабочий список каналов не изменён.",
                draft_id=draft_id,
                stages=stages,
                error=(error or {}).get("error", "preflight_blocked"),
                fix="Исправьте строки, отмеченные в проверке. Скрипты, внешние файлы учётных данных, системный DNS и чужие маршруты не переносятся в автозапуск.",
                extra={"preflight": preflight or {}, "raw_error": error or {}},
            )
        egress_channel_add_stage(stages, "preflight", "PASS", "поля проверены")

    metadata = read_json(egress_draft_path(draft_id) / "metadata.json", {})
    if metadata.get("last_runtime_status") == "PASS":
        egress_channel_add_stage(stages, "runtime", "SKIP", "уже пройдено")
    else:
        runtime, error = egress_draft_runtime_run(draft_id, actor, duration=duration)
        if error or str((runtime or {}).get("status", "")).upper() != "PASS":
            runtime_reason = (runtime or {}).get("runtime_failure_reason") or (error or runtime or {}).get("error", "временный тест не прошёл")
            runtime_fix = (runtime or {}).get("operator_fix") or "Если на телефоне конфиг работает, проверьте доступность VPN endpoint с VPS, DNS, UDP/TCP порт, ключи и ограничения сервера по IP."
            egress_channel_add_stage(stages, "runtime", "BLOCKED", runtime_reason)
            return egress_channel_add_result(
                "NOT_ADDED",
                "Канал не добавлен",
                (runtime or {}).get("runtime_failure_reason") or "Конфиг распознан, но временный туннель не запустился или не вышел в интернет с VPS.",
                draft_id=draft_id,
                stages=stages,
                error=(error or {}).get("error", "runtime_blocked"),
                fix=runtime_fix,
                extra={"runtime": runtime or {}, "raw_error": error or {}},
            )
        egress_channel_add_stage(stages, "runtime", "PASS", "временный туннель работает")

    metadata = read_json(egress_draft_path(draft_id) / "metadata.json", {})
    if metadata.get("last_quarantine_status") == "PASS":
        egress_channel_add_stage(stages, "quarantine", "SKIP", "уже пройдено")
    else:
        quarantine, error = egress_draft_runtime_run(draft_id, actor, duration=duration, requested_mode="quarantine")
        if error or str((quarantine or {}).get("quarantine_status", "")).upper() != "PASS":
            detail = ""
            matrix = (quarantine or {}).get("service_matrix") or {}
            if isinstance(matrix, dict) and matrix.get("total"):
                detail = f"сервисы {matrix.get('ok_count', 0)}/{matrix.get('total')}"
            egress_channel_add_stage(stages, "quarantine", "BLOCKED", detail or (error or quarantine or {}).get("error", "изолированная проверка не прошла"))
            return egress_channel_add_result(
                "NOT_ADDED",
                "Канал не добавлен",
                "Туннель поднялся не полностью или не прошёл изолированную проверку нужных сервисов. Рабочие каналы не изменены.",
                draft_id=draft_id,
                stages=stages,
                error=(error or {}).get("error", "quarantine_blocked"),
                fix="Проверьте доступность VPN с VPS и роль канала. Для обычного канала Telegram должен быть рабочим; RU-сервисы в матрицу не входят.",
                extra={"quarantine": quarantine or {}, "raw_error": error or {}},
            )
        matrix = (quarantine or {}).get("service_matrix") or {}
        egress_channel_add_stage(stages, "quarantine", "PASS", f"сервисы {matrix.get('ok_count', 0)}/{matrix.get('total')}" if matrix.get("total") else "пройдено")

    if update_existing and not target_egress:
        egress_channel_add_stage(stages, "duplicate", "BLOCKED", "не выбран существующий канал")
        return egress_channel_add_result(
            "NOT_ADDED",
            "Канал не обновлён",
            "V7 не получил, какой существующий канал нужно обновить этим конфигом.",
            draft_id=draft_id,
            stages=stages,
            error="target_egress_required",
            fix="Повторите действие из сообщения о дубле: там V7 передаёт найденный канал автоматически.",
        )

    if update_existing:
        egress_channel_add_stage(stages, "duplicate", "PASS", f"обновляю {target_egress}")
        update, error = egress_draft_existing_update_apply(draft_id, target_egress, actor)
        if error:
            egress_channel_add_stage(stages, "pool", "BLOCKED", error.get("error", "обновление не прошло"))
            return egress_channel_add_result(
                "NOT_ADDED",
                "Канал не обновлён",
                "V7 подтвердил безопасные проверки, но остановил замену существующего канала.",
                draft_id=draft_id,
                egress=target_egress,
                stages=stages,
                error=error.get("error", "existing_update_failed"),
                fix="Старый канал не перезаписан небезопасно. Откройте логи и проверьте, почему замена или перезапуск остановились.",
                extra={"raw_error": error},
            )
        egress_channel_add_stage(stages, "pool", "PASS", "существующий канал обновлён")
        egress_channel_add_stage(stages, "provision", "PASS", "рабочий профиль готов")
        egress_channel_add_mark_metadata(draft_id, import_pipeline_status="UPDATED_EXISTING", import_pipeline_finished_at=now_iso())
        return egress_channel_add_result(
            "UPDATED_EXISTING",
            "Существующий канал обновлён",
            f"V7 не создал дубль. Конфиг применён к каналу {update.get('egress', target_egress)}.",
            draft_id=draft_id,
            egress=update.get("egress", target_egress),
            stages=stages,
            fix="Откройте канал в списке. Если он был включён, V7 перезапустил его безопасно; если был выключен, он останется выключенным.",
            extra={"result": update},
        )

    pool_preview, error = egress_draft_pool_preview(draft_id, allow_duplicate=allow_duplicate)
    if error:
        egress_channel_add_stage(stages, "duplicate", "BLOCKED", error.get("error", "preview не прошёл"))
        return egress_channel_add_result(
            "NOT_ADDED",
            "Канал не добавлен",
            "V7 не смог подготовить безопасное добавление в список каналов.",
            draft_id=draft_id,
            stages=stages,
            error=error.get("error", "pool_preview_failed"),
            fix="Проверьте журнал egress и конфликт имени канала. Список каналов не изменён.",
            extra={"raw_error": error},
        )
    duplicate = ((pool_preview.get("source_checks") or {}).get("duplicate") or {})
    if duplicate and not allow_duplicate:
        egress_channel_add_stage(stages, "duplicate", "BLOCKED", f"уже есть {duplicate.get('egress', '')}")
        return egress_channel_add_result(
            "DUPLICATE_FOUND",
            "Такой канал уже есть",
            f"Этот конфиг совпадает с каналом {duplicate.get('egress', '')}. V7 не создаёт дубль без явного решения оператора.",
            draft_id=draft_id,
            egress=duplicate.get("egress", ""),
            stages=stages,
            error="duplicate_interface_config",
            fix="Можно открыть существующий канал, обновить его этим конфигом или осознанно создать второй такой же канал.",
            extra={"duplicate": duplicate, "pool_preview": pool_preview},
        )
    if not pool_preview.get("ready"):
        egress_channel_add_stage(stages, "duplicate", "PASS", "дублей не найдено" if not duplicate else "дубль разрешён")
        egress_channel_add_stage(stages, "pool", "BLOCKED", ", ".join(pool_preview.get("blockers", [])) or "не готов")
        return egress_channel_add_result(
            "NOT_ADDED",
            "Канал не добавлен",
            "Проверки прошли, но V7 не может безопасно добавить канал в рабочий список.",
            draft_id=draft_id,
            stages=stages,
            error="pool_blocked",
            fix="Закройте блокеры добавления. Чаще всего это конфликт имени, неподдержанный протокол или попытка добавить дубль без разрешения.",
            extra={"pool_preview": pool_preview},
        )
    egress_channel_add_stage(stages, "duplicate", "PASS", "дубль разрешён" if duplicate else "дублей не найдено")

    metadata = read_json(egress_draft_path(draft_id) / "metadata.json", {})
    if str(metadata.get("pool_action", "")) in {"added_disabled", "enabled"}:
        egress_channel_add_stage(stages, "pool", "SKIP", "уже в списке")
        pool_result = {"egress": metadata.get("pool_egress_id", "")}
    else:
        pool_result, error = egress_draft_pool_apply(draft_id, actor, allow_duplicate=allow_duplicate)
        if error:
            egress_channel_add_stage(stages, "pool", "BLOCKED", error.get("error", "добавление не прошло"))
            return egress_channel_add_result(
                "NOT_ADDED",
                "Канал не добавлен",
                "V7 не смог записать канал в рабочий список.",
                draft_id=draft_id,
                stages=stages,
                error=error.get("error", "pool_apply_failed"),
                fix="Рабочие пользователи не тронуты. Проверьте egress.registry, конфликт имени и права записи.",
                extra={"raw_error": error, "pool_preview": pool_preview},
            )
        egress_channel_add_stage(stages, "pool", "PASS", "добавлен выключенным")

    metadata = read_json(egress_draft_path(draft_id) / "metadata.json", {})
    if metadata.get("runtime_profile_status") == "READY":
        provision = {"egress": metadata.get("pool_egress_id", ""), "status": "READY"}
        egress_channel_add_stage(stages, "provision", "SKIP", "уже готов")
    else:
        provision, error = egress_draft_runtime_provision(draft_id, actor)
        if error or str((provision or {}).get("status", "")).upper() != "READY":
            egress_channel_add_stage(stages, "provision", "BLOCKED", (error or provision or {}).get("error", "профиль не готов"))
            return egress_channel_add_result(
                "NOT_ADDED",
                "Канал добавлен в список, но профиль не готов",
                "V7 записал канал выключенным, но не смог подготовить рабочий профиль. Канал не будет использоваться, пока профиль не исправлен.",
                draft_id=draft_id,
                egress=(pool_result or {}).get("egress", ""),
                stages=stages,
                error=(error or {}).get("error", "runtime_provision_failed"),
                fix="Проверьте путь профиля и поддерживаемость runtime-адаптера. Пользователи не переносились.",
                extra={"raw_error": error or {}, "provision": provision or {}},
            )
        egress_channel_add_stage(stages, "provision", "PASS", "рабочий профиль готов")

    egress_id = safe_egress_id((provision or {}).get("egress") or (pool_result or {}).get("egress") or "")
    egress_channel_add_mark_metadata(draft_id, import_pipeline_status="ADDED_DISABLED_READY", import_pipeline_finished_at=now_iso())
    return egress_channel_add_result(
        "ADDED_DISABLED_READY",
        "Канал добавлен",
        f"Канал {egress_id or 'готов'} прошёл проверки, появился в общем списке и пока выключен. Пользователи этим действием не переносились.",
        draft_id=draft_id,
        egress=egress_id,
        stages=stages,
        fix="Дальше откройте список каналов. Кнопка Play запускает канал; Pause останавливает и запускает миграцию пользователей по правилам V7.",
        extra={"pool": pool_result, "provision": provision, "duplicate_created": bool(duplicate and allow_duplicate)},
    )


def egress_draft_enable_preview(draft_id, actor="admin"):
    draft_dir = egress_draft_path(draft_id)
    if not draft_dir:
        return None, {"error": "invalid_draft_id"}
    metadata = read_json(draft_dir / "metadata.json", {})
    if not metadata:
        return None, {"error": "draft_not_found"}
    egress_id = safe_egress_id(metadata.get("pool_egress_id", ""))
    if not egress_id:
        return None, {"error": "draft_has_no_pool_egress_id"}
    registry = egress_registry_map().get(egress_id, {})
    if not registry:
        return None, {"error": "egress_not_found_in_registry", "egress": egress_id}
    readiness = egress_runtime_readiness(egress_id, registry)
    blockers = []
    if metadata.get("pool_action") not in {"added_disabled", "enabled"}:
        blockers.append("draft_not_added_disabled")
    if str(registry.get("enabled", "1")) != "0":
        if metadata.get("pool_action") == "enabled":
            blockers.append("already_enabled")
        else:
            blockers.append("registry_not_disabled")
    if metadata.get("runtime_profile_status") != "READY":
        blockers.append("runtime_profile_not_ready")
    if not readiness.get("enable_ready"):
        blockers.append("runtime_readiness_blocked")
    dry_run = run_action(["v7-egress-set-state", egress_id, "enabled"], actor, timeout=20)
    if dry_run.get("rc") not in (0,):
        blockers.append("egress_set_state_preview_failed")
    return {
        "draft_id": draft_id,
        "egress": egress_id,
        "ready": not blockers,
        "blockers": blockers,
        "confirm": "ENABLE_DRAFT_EGRESS",
        "human": "Только предпросмотр. Включение сделает канал доступным V7, но само по себе не перенесёт пользователей.",
        "runtime_readiness": readiness,
        "set_state_preview": dry_run,
        "would_change": [str(STATE_DIR / "egress.registry"), str(STATE_DIR / "egress-flags.state")],
        "would_not_change": [
            str(STATE_DIR / "users.registry"),
            "current user assignments",
            "current per-user route tables",
            "running V7 services",
            "kill switch rules",
        ],
        "kill_switch_guard": "enable does not edit firewall rules; route use still depends on separate routing/failover/rebalance decisions",
        "next_step": "apply_enable" if not blockers else "fix_enable_blockers",
    }, None


def egress_draft_enable_apply(draft_id, actor):
    preview, error = egress_draft_enable_preview(draft_id, actor=actor)
    if error:
        return None, error
    if not preview.get("ready"):
        return None, {
            "error": "draft_egress_not_ready_for_enable",
            "blockers": preview.get("blockers", []),
            "preview": preview,
        }
    draft_dir = egress_draft_path(draft_id)
    metadata_path = draft_dir / "metadata.json"
    metadata = read_json(metadata_path, {})
    egress_id = preview["egress"]
    result = run_action(["v7-egress-set-state", egress_id, "enabled", "--apply"], actor, timeout=30)
    if result.get("rc") != 0:
        return None, {"error": "egress_set_state_apply_failed", "result": result}
    metadata.update({
        "pool_action": "enabled",
        "pool_enabled_at": now_iso(),
        "pool_enabled_by": actor or "admin",
        "next_step": "enabled_watch_health",
    })
    metadata["lifecycle"] = egress_draft_lifecycle(metadata)
    write_json_atomic(metadata_path, metadata)
    try:
        os.chmod(metadata_path, 0o600)
    except OSError:
        pass
    validation = egress_draft_post_enable_validation(draft_id, actor=actor)[0]
    return {
        "draft_id": draft_id,
        "egress": egress_id,
        "status": "ENABLED",
        "human": "The channel is now enabled in the V7 pool. Users were not moved by this action.",
        "result": result,
        "users_moved": False,
        "routes_changed": False,
        "services_restarted": False,
        "lifecycle": metadata["lifecycle"],
        "post_enable_validation": validation,
        "next_step": "monitor_health_then_manual_switch_or_rebalance",
    }, None


def egress_draft_post_enable_validation(draft_id, actor="admin"):
    draft_dir = egress_draft_path(draft_id)
    if not draft_dir:
        return None, {"error": "invalid_draft_id"}
    metadata = read_json(draft_dir / "metadata.json", {})
    if not metadata:
        return None, {"error": "draft_not_found"}
    egress_id = safe_egress_id(metadata.get("pool_egress_id", ""))
    if not egress_id:
        return None, {"error": "draft_has_no_pool_egress_id"}
    registry = egress_registry_map().get(egress_id, {})
    if not registry:
        return None, {"error": "egress_not_found_in_registry", "egress": egress_id}
    readiness = egress_runtime_readiness(egress_id, registry)
    runtime_path_raw = str(metadata.get("runtime_profile_path") or readiness.get("profile_path") or "")
    runtime_path = Path(runtime_path_raw) if runtime_path_raw else None
    runtime_exists = bool(runtime_path and runtime_path.exists())
    users_on_egress = [row for row in parse_registry(STATE_DIR / "users.registry") if row.get("current") == egress_id]
    registry_enabled = str(registry.get("enabled", "0")) == "1"
    checks = [
        {"id": "registry_present", "status": "OK", "detail": egress_id},
        {"id": "registry_enabled", "status": "OK" if registry_enabled else "BLOCKED", "detail": f"enabled={registry.get('enabled', '')}"},
        {"id": "runtime_profile_path", "status": "OK" if runtime_exists else "BLOCKED", "detail": runtime_path_raw or "missing"},
        {"id": "runtime_readiness", "status": "OK" if readiness.get("enable_ready") else "BLOCKED", "detail": readiness.get("reason", "")},
        {"id": "users_not_moved_by_enable", "status": "OK", "detail": f"assigned_users={len(users_on_egress)}"},
        {"id": "routes_not_changed_by_enable", "status": "OK", "detail": "enable only changed pool availability"},
    ]
    blockers = [row["id"] for row in checks if row.get("status") == "BLOCKED"]
    warnings = [row["id"] for row in checks if row.get("status") == "WARN"]
    rebalance_preview = run_readonly(["v7-users-rebalance-dry-run"], timeout=10)
    manual_switch_hint = ""
    users = parse_registry(STATE_DIR / "users.registry")
    if users:
        manual_switch_hint = f"manual switch can be tested with one user, for example {users[0].get('ip', '')}"
    result = {
        "draft_id": draft_id,
        "egress": egress_id,
        "status": "OK" if not blockers else "BLOCKED",
        "checks": checks,
        "blockers": blockers,
        "warnings": warnings,
        "runtime_readiness": readiness,
        "assigned_users": len(users_on_egress),
        "users_moved_by_enable": False,
        "routes_changed_by_enable": False,
        "kill_switch_changed_by_enable": False,
        "safe_next_actions": [
            "run service matrix for this egress",
            "manual switch one test user if needed",
            "run rebalance dry-run before any broader movement",
        ],
        "manual_switch_hint": manual_switch_hint,
        "rebalance_preview": rebalance_preview,
        "next_step": "manual_switch_one_user_or_rebalance_dry_run" if not blockers else "fix_post_enable_blockers",
    }
    metadata.update({
        "last_post_enable_at": now_iso(),
        "last_post_enable_status": result["status"],
        "last_post_enable_blockers": blockers,
        "last_post_enable_warnings": warnings,
        "next_step": result["next_step"],
    })
    metadata["lifecycle"] = egress_draft_lifecycle(metadata)
    write_json_atomic(draft_dir / "metadata.json", metadata)
    try:
        os.chmod(draft_dir / "metadata.json", 0o600)
    except OSError:
        pass
    return result, None


