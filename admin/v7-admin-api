def egress_delete_safe_path(path):
    try:
        resolved = Path(path).resolve()
    except OSError:
        return None
    roots = [
        WIREGUARD_DIR.resolve(),
        AMNEZIAWG_DIR.resolve(),
        OPENVPN_DIR.resolve(),
        EGRESS_RUNTIME_DIR.resolve(),
        Path("/etc/amneziawg").resolve(),
    ]
    if any(resolved == root or root in resolved.parents for root in roots):
        return resolved
    return None


def remove_json_items(path, egress_id):
    data = read_json(path, {})
    if not isinstance(data, dict):
        return False
    changed = False
    items = data.get("items")
    if isinstance(items, dict) and egress_id in items:
        items.pop(egress_id, None)
        changed = True
    if egress_id in data and path == EGRESS_LABELS_FILE:
        data.pop(egress_id, None)
        changed = True
    if changed:
        write_json_atomic(path, data)
    return changed


