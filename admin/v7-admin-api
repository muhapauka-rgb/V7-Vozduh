            audit_admin(actor, "admin_action_identity_device_issue", f"user_id={user['id']} ip={ip} client={vpn_client} proxy_identity=fail", object_type="identity_user", object_id=user["id"], result="FAIL")
            return {"planned": planned, "preflight": preflight, "created": created, "parsed": parsed, "proxy_identity": proxy_identity}, {"error": "proxy_identity_bind_failed"}, 500
    elif adapter_uses_karing_wg(adapter):
        generated = generate_karing_wg_endpoint_profile(ip, artifact_name, mode, output, conf, actor)
    else:
