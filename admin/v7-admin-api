        closure_state="CLOSED" if ok else "OPEN",
        links=[evidence_link("user", ip), evidence_link("log", "latest-audit")],
    )]


def all_evidence_bundles():
    def build():
        by_id = {}
        for item in evidence_store_bundles() + generated_evidence_bundles():
            if item and item.get("bundle_id"):
                by_id[item["bundle_id"]] = item
        return sorted(by_id.values(), key=lambda x: str(x.get("updated_at") or ""), reverse=True)

    return cached_read_only_model("all_evidence_bundles", build)


def evidence_matches_object(bundle, object_type, object_id):
    object_type = safe_evidence_token(object_type, "").lower()
    object_id = safe_evidence_token(object_id, "")
    if not object_type or not object_id:
        return False
    if str(bundle.get("object_type", "")).lower() == object_type and str(bundle.get("object_id", "")) == object_id:
        return True
    for link in bundle.get("links") or []:
        if isinstance(link, dict) and str(link.get("object_type", "")).lower() == object_type and str(link.get("object_id", "")) == object_id:
            return True
    return False


