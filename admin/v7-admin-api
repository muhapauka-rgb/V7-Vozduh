def wg_conf_for_user_ip(ip):
    if not CLIENT_ROOT.exists():
        return None
    for conf in CLIENT_ROOT.glob("*/*.conf"):
        try:
            text = conf.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        if f"Address = {ip}/32" not in text and f"Address={ip}/32" not in text:
            continue
        return conf
    return None


def client_artifacts_for_ip(ip):
    rows = []
    conf = wg_conf_for_user_ip(ip)
    if not conf:
        return rows
    try:
        name = conf.stem
        qr = conf.with_suffix(".png")
        rows.append({
            "name": name,
            "config_ready": True,
            "qr_ready": qr.exists(),
            "config_url": f"/api/client-artifact?name={name}&type=conf",
            "qr_url": f"/api/client-artifact?name={name}&type=qr" if qr.exists() else None,
            "mtime": datetime.fromtimestamp(conf.stat().st_mtime, timezone.utc).isoformat(),
        })
    except OSError:
        return rows
    return rows


def client_artifacts_map(users):
    wanted = {row.get("ip") for row in users if row.get("ip")}
    result = {ip: [] for ip in wanted}
    if not CLIENT_ROOT.exists():
        return result
    for conf in CLIENT_ROOT.glob("*/*.conf"):
        try:
            text = conf.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        matches = re.findall(r"(?m)^\s*Address\s*=\s*([0-9.]+)/32\s*$", text)
        for ip in matches:
            if ip not in wanted:
                continue
            try:
                name = conf.stem
                qr = conf.with_suffix(".png")
                result.setdefault(ip, []).append({
                    "name": name,
                    "config_ready": True,
                    "qr_ready": qr.exists(),
                    "config_url": f"/api/client-artifact?name={name}&type=conf",
                    "qr_url": f"/api/client-artifact?name={name}&type=qr" if qr.exists() else None,
                    "mtime": datetime.fromtimestamp(conf.stat().st_mtime, timezone.utc).isoformat(),
                })
            except OSError:
                continue
    return result


def wg_handshake_map():
    result = {}
    wg = run_readonly(["wg", "show", "wg0", "dump"], timeout=5)
    now = int(time.time())
    for line in str(wg.get("output", "")).splitlines()[1:]:
        parts = line.split("\t")
        if len(parts) < 7:
            continue
        for allowed in parts[3].split(","):
            allowed = allowed.strip()
            if not allowed.endswith("/32"):
                continue
            ip = allowed[:-3]
            if not safe_user_ip(ip):
                continue
            try:
                handshake_ts = int(parts[4])
            except ValueError:
                handshake_ts = 0
            age = None if handshake_ts <= 0 else max(0, now - handshake_ts)
            result[ip] = {
                "present": True,
                "latest_handshake_epoch": handshake_ts,
                "latest_handshake_age_sec": age,
                "recent": age is not None and age <= 180,
                "transfer_rx_bytes": int(parts[5]) if parts[5].isdigit() else 0,
                "transfer_tx_bytes": int(parts[6]) if parts[6].isdigit() else 0,
            }
    return result


def wg_handshake_state(ip):
    ip = safe_user_ip(ip)
    if not ip:
        return {}
    row = wg_handshake_map().get(ip)
    if row:
        return row
    return {
        "present": False,
        "latest_handshake_epoch": 0,
        "latest_handshake_age_sec": None,
        "recent": False,
        "transfer_rx_bytes": 0,
        "transfer_tx_bytes": 0,
    }


def vless_activity_map(window_seconds=None):
    window = int(window_seconds or VLESS_ACTIVITY_FRESH_SECONDS)
    window = max(60, min(window, VLESS_ACTIVITY_LOOKBACK_SECONDS))
    result = {}
    now = int(time.time())
    cache = read_json(VLESS_ACTIVITY_FILE, {})
    if not isinstance(cache, dict):
        cache = {}
    for ip, item in cache.items():
        ip = safe_user_ip(ip)
        if not ip or not isinstance(item, dict):
            continue
        ts = int(item.get("latest_activity_epoch") or 0)
        if ts <= 0:
            continue
        age = max(0, now - ts)
        if age > VLESS_ACTIVITY_SEEN_SECONDS:
            continue
        result[ip] = {
            "present": True,
            "source": "vless_activity_cache",
            "service": str(item.get("service") or PROXY_PUBLIC_SERVICE),
            "auth_user": str(item.get("auth_user") or ""),
            "target": str(item.get("target") or ""),
            "latest_activity_epoch": ts,
            "latest_activity_age_sec": age,
            "recent": age <= VLESS_ACTIVITY_FRESH_SECONDS,
            "seen": True,
        }
    check = run_readonly([
        "journalctl",
        "-u",
        PROXY_PUBLIC_SERVICE,
        "--since",
        f"-{max(window, VLESS_ACTIVITY_LOOKBACK_SECONDS)} seconds",
        "-n",
        "5000",
        "--no-pager",
        "-o",
        "short-unix",
    ], timeout=5)
    if check.get("rc") != 0:
        return result
    auth_re = re.compile(r"\b(?P<auth>v7-(?P<ip>10\.(?:0\.0|7\.[0-3])\.[0-9]{1,3})-[A-Za-z0-9_.+-]+)\b")
    target_re = re.compile(r"\binbound (?:multiplex )?connection to (?P<target>[^ ]+)")
    changed_cache = False
    for line in str(check.get("output", "")).splitlines():
        match = auth_re.search(line)
        if not match:
            continue
        ip = safe_user_ip(match.group("ip"))
        if not ip:
            continue
        try:
            ts = int(float(line.split(maxsplit=1)[0]))
        except (IndexError, ValueError):
            ts = now
        age = max(0, now - ts)
        previous = result.get(ip)
        if previous and previous.get("latest_activity_epoch", 0) >= ts:
            continue
        target_match = target_re.search(line)
        target = target_match.group("target") if target_match else ""
        result[ip] = {
            "present": True,
            "source": "vless_inbound_log",
            "service": PROXY_PUBLIC_SERVICE,
            "auth_user": match.group("auth"),
            "target": target,
            "latest_activity_epoch": ts,
            "latest_activity_age_sec": age,
            "recent": age <= VLESS_ACTIVITY_FRESH_SECONDS,
            "seen": True,
        }
        cached = cache.get(ip) if isinstance(cache.get(ip), dict) else {}
        if int(cached.get("latest_activity_epoch") or 0) < ts:
            cache[ip] = {
                "service": PROXY_PUBLIC_SERVICE,
                "auth_user": match.group("auth"),
                "target": target,
                "latest_activity_epoch": ts,
                "updated_at": now_iso(),
            }
            changed_cache = True
    if changed_cache:
        write_json_atomic(VLESS_ACTIVITY_FILE, cache)
    return result


