    endpoint_ip_rule = {"ip_cidr": [f"{endpoint_host}/32"], "action": "route", "outbound": "direct"} if re.match(r"^\d+\.\d+\.\d+\.\d+$", endpoint_host) else {"domain": [endpoint_host], "action": "route", "outbound": "direct"}
