def evidence_list_response(query):
    params = query or {}
    bundles = [
        attach_operational_metadata(
            b,
            "evidence",
            b.get("bundle_id", ""),
            EVIDENCE_FRESH_TTL_SECONDS,
            ts_fields=("updated_at", "created_at"),
        )
        for b in all_evidence_bundles()
    ]
    object_type = safe_evidence_token((params.get("object_type") or [""])[0], "").lower()
    object_id = safe_evidence_token((params.get("object_id") or [""])[0], "")
    status = str((params.get("status") or [""])[0] or "").upper()
    severity = str((params.get("severity") or [""])[0] or "").lower()
    if object_type and object_id:
        bundles = [b for b in bundles if evidence_matches_object(b, object_type, object_id)]
    elif object_type:
        bundles = [b for b in bundles if str(b.get("object_type", "")).lower() == object_type or any(str(l.get("object_type", "")).lower() == object_type for l in b.get("links") or [] if isinstance(l, dict))]
    if status:
        bundles = [b for b in bundles if str(b.get("status", "")).upper() == status]
    if severity:
        bundles = [b for b in bundles if str(b.get("severity", "")).lower() == severity]
    bundles = apply_operational_filters(bundles, params, ts_fields=("updated_at", "created_at"))
    limit, offset = pagination_from_query(params)
    page = bundles[offset: offset + limit]
    next_cursor = str(offset + limit) if offset + limit < len(bundles) else ""
    return {
        "items": [evidence_summary_item(b) for b in page],
        "count": len(page),
        "total": len(bundles),
        "next_cursor": next_cursor,
        "read_only": True,
        "storage_backend": "jsonl",
        "storage_path": str(EVIDENCE_STORE_FILE),
        "generated_sources": ["checks", "logs", "overview_data", "registries"],
        "freshness_model": {"ttl_seconds": EVIDENCE_FRESH_TTL_SECONDS, "states": sorted(FRESHNESS_STATES)},
        "retention_model": {"retention_days": HARDENING_RETENTION_DAYS, "state": "visible"},
        "closure_model": {"enabled": True, "states": sorted(CLOSURE_STATES), "store": str(CLOSURE_STORE_FILE)},
        "filters": {
            "q": query_value(params, "q", "search"),
            "user": query_value(params, "user", "ip", "user_ip"),
            "channel": query_value(params, "channel", "egress", "target"),
            "status": status,
            "severity": severity,
            "freshness": query_value(params, "freshness"),
            "closure_state": query_value(params, "closure_state", "closure"),
            "timeframe": query_value(params, "timeframe"),
        },
    }


