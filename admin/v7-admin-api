def execution_health_from_readiness(readiness):
    status = str(readiness.get("status") or "UNKNOWN").upper()
    failed = readiness.get("failed_gates") or []
    review = readiness.get("review_required_gates") or []
    unknown = readiness.get("unknown_gates") or []
    if status == "READY":
        health = "READY"
        meaning = "All preview gates pass."
    elif failed:
        health = "BLOCKED"
        meaning = "At least one hard gate failed closed."
    elif review:
        health = "DEGRADED"
        meaning = "No failed gate exists, but operator review is required."
    elif unknown or status == "UNKNOWN":
        health = "UNKNOWN"
        meaning = "Readiness cannot be fully explained from current draft data."
    else:
        health = "READY_WITH_REVIEW"
        meaning = "Preview is structurally ready but still needs review."
    return {
        "health": health,
        "criteria": {
            "ready": "All preview gates pass.",
            "ready_with_review": "No failed gate exists, but at least one review gate exists.",
            "blocked": "At least one validation gate fails closed.",
            "degraded": "Trust, policy, or runtime evidence is incomplete but inspectable.",
            "unknown": "No proposal-derived draft or no readable gate state exists.",
        },
        "operator_meaning": meaning,
        "readiness_status": status,
        "read_only": True,
        "preview_only": True,
    }


def execution_gate_workflow_item(gate, draft_check=None):
    gate_id = gate.get("gate_id") or gate.get("id") or ""
    label = gate.get("label") or gate_id
    status = str((draft_check or gate).get("status") or "UNKNOWN").upper()
    model = execution_gate_operator_model(gate_id)
    reason = (draft_check or gate).get("reason") or gate.get("reason") or ""
    source = (draft_check or gate).get("adapter_source") or (draft_check or gate).get("source") or ", ".join(gate.get("sources") or [])
    if status == "FAIL":
        action = model.get("fail_action", "")
        severity = "blocker"
    elif status == "REVIEW_REQUIRED":
        action = model.get("review_action", "")
        severity = "review"
    elif status == "UNKNOWN":
        action = "Collect evidence until this gate can become PASS, FAIL, or REVIEW_REQUIRED."
        severity = "unknown"
    else:
        action = "No operator action needed for this gate right now."
        severity = "ok"
    return {
        "gate_id": gate_id,
        "label": label,
        "status": status,
        "severity": severity,
        "owner": model.get("owner", ""),
        "category": model.get("category", ""),
