def ensure_proxy_runtime_egress_outbound(config, outbound_tag, bind_interface, connect_timeout=""):
    outbounds = config.setdefault("outbounds", [])
    outbound = next(
        (row for row in outbounds if isinstance(row, dict) and row.get("tag") == outbound_tag),
        None,
    )
    if not outbound:
        outbound = next(
            (
                row for row in outbounds
                if isinstance(row, dict)
                and row.get("type") == "direct"
                and str(row.get("tag", "")).startswith("v7-egress-")
            ),
            None,
        )
    if not outbound:
        outbound = {"type": "direct", "tag": outbound_tag}
        block_index = next(
            (idx for idx, row in enumerate(outbounds) if isinstance(row, dict) and row.get("tag") == "block"),
            len(outbounds),
        )
        outbounds.insert(block_index, outbound)
    outbound["type"] = "direct"
    outbound["tag"] = outbound_tag
    if bind_interface:
        outbound["bind_interface"] = bind_interface
    else:
        outbound.pop("bind_interface", None)
    connect_timeout = str(connect_timeout or "").strip()
    if connect_timeout:
        outbound["connect_timeout"] = connect_timeout
    else:
        outbound.pop("connect_timeout", None)
    return outbound


def ensure_proxy_runtime_egress_outbound_exact(config, outbound_tag, bind_interface, connect_timeout=""):
    outbounds = config.setdefault("outbounds", [])
    outbound = next(
        (row for row in outbounds if isinstance(row, dict) and row.get("tag") == outbound_tag),
        None,
    )
    if not outbound:
        outbound = {"type": "direct", "tag": outbound_tag}
        block_index = next(
            (idx for idx, row in enumerate(outbounds) if isinstance(row, dict) and row.get("tag") == "block"),
            len(outbounds),
        )
        outbounds.insert(block_index, outbound)
    outbound["type"] = "direct"
    outbound["tag"] = outbound_tag
    if bind_interface:
        outbound["bind_interface"] = bind_interface
    else:
        outbound.pop("bind_interface", None)
    connect_timeout = str(connect_timeout or "").strip()
    if connect_timeout:
        outbound["connect_timeout"] = connect_timeout
    else:
        outbound.pop("connect_timeout", None)
    return outbound


def proxy_runtime_auth_users_for_ip(config, ip):
    ip = safe_user_ip(ip)
    if not ip:
        return []
    auth_users = []
    binding = read_json(proxy_binding_path(ip), {})
    binding_auth = str(binding.get("auth_user") or "").strip() if isinstance(binding, dict) else ""
    if binding_auth:
        auth_users.append(binding_auth)
    prefix = f"v7-{ip}-"
    for inbound in config.get("inbounds", []) if isinstance(config, dict) else []:
        if not isinstance(inbound, dict) or inbound.get("type") != "vless":
            continue
        for user in inbound.get("users") or []:
            name = str((user or {}).get("name") or "").strip() if isinstance(user, dict) else ""
            if name.startswith(prefix):
                auth_users.append(name)
    for rule in ((config.get("route") or {}).get("rules") or []) if isinstance(config, dict) else []:
        if not isinstance(rule, dict):
            continue
        for auth_user in (rule.get("auth_user") or []):
            auth_user = str(auth_user or "").strip()
            if auth_user.startswith(prefix):
                auth_users.append(auth_user)
    return sorted(set(item for item in auth_users if item))


def proxy_runtime_current_binding_auth_user(ip):
    ip = safe_user_ip(ip)
    if not ip:
        return ""
    binding = read_json(proxy_binding_path(ip), {})
    auth_user = str(binding.get("auth_user") or "").strip() if isinstance(binding, dict) else ""
    return auth_user if auth_user.startswith(f"v7-{ip}-") else ""


def prune_proxy_runtime_ip_identity(config, ip, keep_auth_user):
    ip = safe_user_ip(ip)
    keep_auth_user = str(keep_auth_user or "").strip()
    if not ip or not keep_auth_user:
        return 0
    prefix = f"v7-{ip}-"
    removed = 0
    for inbound in config.get("inbounds", []) if isinstance(config, dict) else []:
        if not isinstance(inbound, dict) or inbound.get("type") != "vless":
            continue
        users = inbound.get("users")
        if not isinstance(users, list):
            continue
        kept_users = []
        for user in users:
            name = str((user or {}).get("name") or "").strip() if isinstance(user, dict) else ""
            if name.startswith(prefix) and name != keep_auth_user:
                removed += 1
                continue
            kept_users.append(user)
        inbound["users"] = kept_users
    rules = ((config.get("route") or {}).get("rules") or []) if isinstance(config, dict) else []
    if isinstance(rules, list):
        kept_rules = []
        for rule in rules:
            if not isinstance(rule, dict):
                kept_rules.append(rule)
                continue
            auth_users = rule.get("auth_user")
            if not isinstance(auth_users, list):
                kept_rules.append(rule)
                continue
            kept_auth = []
            changed_rule = False
            for auth_user in auth_users:
                auth_user = str(auth_user or "").strip()
                if auth_user.startswith(prefix) and auth_user != keep_auth_user:
                    removed += 1
                    changed_rule = True
                    continue
                kept_auth.append(auth_user)
            if changed_rule:
                if kept_auth:
                    next_rule = dict(rule)
                    next_rule["auth_user"] = kept_auth
                    kept_rules.append(next_rule)
                continue
            kept_rules.append(rule)
        config.setdefault("route", {})["rules"] = kept_rules
    return removed


def proxy_runtime_switch_user_egress(ip, egress_id, actor):
    ip = safe_user_ip(ip)
    egress_id = safe_egress_id(egress_id)
    if not ip:
        return {"rc": 1, "output": "ERROR: invalid_user_ip"}
    if not egress_id:
        return {"rc": 1, "output": "ERROR: invalid_egress"}
    config_path = proxy_public_config_path()
    config = read_json(config_path, {})
    if not isinstance(config, dict) or not config.get("inbounds"):
        return {"rc": 0, "output": f"proxy_runtime_switch_skipped path={config_path}"}
    binding_auth_user = proxy_runtime_current_binding_auth_user(ip)
    auth_users = [binding_auth_user] if binding_auth_user else proxy_runtime_auth_users_for_ip(config, ip)
    if not auth_users:
        return {"rc": 0, "output": f"proxy_runtime_switch_skipped no_auth_user ip={ip}"}
    registry = egress_registry_map().get(egress_id, {})
    bind_interface = str(registry.get("interface") or PROXY_EGRESS_BIND_INTERFACE or "").strip()
    outbound_tag = f"v7-egress-{egress_id}"
    connect_timeout = str(registry.get("connect_timeout") or "").strip()
    ensure_proxy_runtime_egress_outbound_exact(config, outbound_tag, bind_interface, connect_timeout)
    pruned = prune_proxy_runtime_ip_identity(config, ip, auth_users[0]) if len(auth_users) == 1 else 0
    rules = config.setdefault("route", {}).setdefault("rules", [])
    changed = 0
    missing = set(auth_users)
    for rule in rules:
        if not isinstance(rule, dict):
            continue
        rule_auth = {str(item or "").strip() for item in (rule.get("auth_user") or [])}
        if rule_auth.intersection(auth_users):
            if rule.get("outbound") != outbound_tag:
                rule["outbound"] = outbound_tag
                changed += 1
            missing.difference_update(rule_auth)
    if missing:
        rules.append({"auth_user": sorted(missing), "outbound": outbound_tag})
        changed += 1
    if not changed and not pruned:
        return {"rc": 0, "output": f"proxy_runtime_switch=noop ip={ip} egress={egress_id} outbound={outbound_tag}"}
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    backup = config_path.with_name(f"{config_path.name}.backup.v7-user-switch-runtime.{stamp}")
    shutil.copy2(config_path, backup)
    try:
        stat = config_path.stat()
        write_json_atomic(config_path, config)
        try:
            os.chmod(config_path, stat.st_mode & 0o777)
            os.chown(config_path, stat.st_uid, stat.st_gid)
        except OSError:
            pass
        check = run_action(["sing-box", "check", "-c", str(config_path)], actor, timeout=10)
        if check.get("rc") != 0:
            shutil.copy2(backup, config_path)
            return {"rc": check.get("rc", 1), "output": f"{check.get('output', '')}\nrolled_back={backup}"}
        restarted = run_action(["systemctl", "restart", PROXY_PUBLIC_SERVICE], actor, timeout=15)
        if restarted.get("rc") != 0:
            shutil.copy2(backup, config_path)
            rollback_restart = run_action(["systemctl", "restart", PROXY_PUBLIC_SERVICE], actor, timeout=15)
            return {
                "rc": restarted.get("rc", 1),
                "output": f"{restarted.get('output', '')}\nrolled_back={backup}\nrollback_restart_rc={rollback_restart.get('rc')}",
            }
    except OSError as exc:
        shutil.copy2(backup, config_path)
        return {"rc": 1, "output": f"ERROR: {exc}\nrolled_back={backup}"}
    return {
        "rc": 0,
        "output": f"proxy_runtime_switch=OK ip={ip} egress={egress_id} outbound={outbound_tag} auth_users={len(auth_users)} changed_rules={changed} pruned_identity_refs={pruned} backup={backup}",
    }


def ensure_public_proxy_reply_route(actor):
    source = public_profile_host()
    if not safe_user_ip(source):
        return {"rc": 0, "output": "public_reply_route_skipped_non_ip_host"}
    rule_text = f"from {source} lookup main"
    existing = run_readonly(["ip", "-4", "rule", "show", "pref", "55"], timeout=4)
    if rule_text not in str(existing.get("output", "")):
        added = run_action(["ip", "-4", "rule", "add", "pref", "55", "from", source, "lookup", "main"], actor, timeout=4)
        if added.get("rc") != 0 and "File exists" not in str(added.get("output", "")):
            return added
    dropin = Path(f"/etc/systemd/system/{PROXY_PUBLIC_SERVICE}.d/20-public-reply-route.conf")
    text = (
        "[Service]\n"
        "ExecStartPre=/bin/sh -c '/usr/sbin/ip -4 rule show pref 55 | "
        f"/bin/grep -q \"from {source} lookup main\" || "
        f"/usr/sbin/ip -4 rule add pref 55 from {source} lookup main'\n"
    )
    try:
        if read_text(dropin, "") != text:
            write_text_atomic(dropin, text, mode=0o644)
            run_action(["systemctl", "daemon-reload"], actor, timeout=8)
    except OSError as exc:
        return {"rc": 1, "output": f"ERROR: {exc}"}
    return {"rc": 0, "output": f"public_reply_route=OK source={source}"}


def ensure_karing_vless_identity(ip, client_name, actor, dry_run=False):
    ip = safe_user_ip(ip)
    if not ip:
        return {"rc": 1, "output": "ERROR: invalid_user_ip"}
    name = safe_client_name(client_name) or f"user-{ip.replace('.', '-')}"
    auth_user = proxy_auth_user(ip, name, "karing")
    binding = read_json(proxy_binding_path(ip), {})
    proxy_uuid = str(binding.get("proxy_uuid") or "").strip()
    if not valid_uuid(proxy_uuid):
        proxy_uuid = str(uuid.uuid4())
    if dry_run:
        return {
            "rc": 0,
            "output": f"dry_run=1 inbound_id={PROXY_INBOUND_ID} auth_user={auth_user} uuid={proxy_uuid}",
            "proxy_uuid": proxy_uuid,
            "auth_user": auth_user,
        }
    route = ensure_public_proxy_reply_route(actor)
    if route.get("rc") != 0:
        return route
    config_path = proxy_public_config_path()
    config = read_json(config_path, {})
    if not isinstance(config, dict) or not config.get("inbounds"):
        return {"rc": 1, "output": f"ERROR: proxy_public_config_missing path={config_path}"}
    inbound = next((row for row in config.get("inbounds", []) if isinstance(row, dict) and row.get("type") == "vless"), None)
    if not inbound:
        return {"rc": 1, "output": f"ERROR: vless_inbound_missing path={config_path}"}
    runtime_egress = proxy_runtime_egress_for_user(ip)
    egress_outbound = ensure_proxy_runtime_egress_outbound(
        config,
        runtime_egress["outbound_tag"],
        runtime_egress["interface"],
        runtime_egress.get("connect_timeout", ""),
    )
    users = inbound.setdefault("users", [])
    prefix = f"v7-{ip}-"
    users[:] = [
        row for row in users
        if not (
            isinstance(row, dict)
            and str(row.get("name") or "").strip().startswith(prefix)
            and str(row.get("name") or "").strip() != auth_user
        )
    ]
    users[:] = [row for row in users if isinstance(row, dict) and row.get("name") != auth_user]
    users.append({"uuid": proxy_uuid, "name": auth_user})
    route_config = config.setdefault("route", {})
    rules = route_config.setdefault("rules", [])
    prune_proxy_runtime_ip_identity(config, ip, auth_user)
    rules = route_config.setdefault("rules", [])
    rules[:] = [
        row for row in rules
        if not (isinstance(row, dict) and auth_user in [str(item) for item in (row.get("auth_user") or [])])
    ]
    rules.append({"auth_user": [auth_user], "outbound": egress_outbound["tag"]})
    write_json_atomic(config_path, config)
    binding_data = {
        "schema": "v7-proxy-identity-binding/v1",
        "status": "binding_active",
        "inbound_id": PROXY_INBOUND_ID,
        "client": "karing",
        "user_ip": ip,
        "label": name,
        "proxy_protocol": "vless",
        "proxy_uuid": proxy_uuid,
        "auth_user": auth_user,
        "public_host": public_profile_host(),
        "public_port": PROXY_PUBLIC_PORT,
        "included_in_runtime_config": True,
        "updated_at": now_iso(),
    }
    existing_created = binding.get("created_at") if isinstance(binding, dict) else ""
    binding_data["created_at"] = existing_created or binding_data["updated_at"]
    write_json_atomic(proxy_binding_path(ip), binding_data)
    check = run_action(["sing-box", "check", "-c", str(config_path)], actor, timeout=10)
    if check.get("rc") != 0:
        return check
    restarted = run_action(["systemctl", "restart", PROXY_PUBLIC_SERVICE], actor, timeout=15)
    if restarted.get("rc") != 0:
        return restarted
    return {
        "rc": 0,
        "output": f"inbound_id={PROXY_INBOUND_ID} auth_user={auth_user} uuid={proxy_uuid} public={public_profile_host()}:{PROXY_PUBLIC_PORT} egress={runtime_egress['egress_id'] or 'default'} egress_bind={runtime_egress['interface'] or 'default'}",
        "proxy_uuid": proxy_uuid,
        "auth_user": auth_user,
    }


