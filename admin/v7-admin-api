def egress_registry_load_limit(registry, key, default_value):
    try:
        value = int(str((registry or {}).get(key, "") or default_value))
    except (TypeError, ValueError):
        value = default_value
    return max(0, value)


def egress_delete_migration_plan(egress_id):
    egress_id = safe_egress_id(egress_id)
    registry_map = egress_registry_map(enabled_only=False)
    source = registry_map.get(egress_id, {})
    if not egress_id or not source:
        return None, {"error": "invalid_egress"}
    assigned_users = egress_assigned_user_rows(egress_id)
    users = parse_registry(STATE_DIR / "users.registry")
    counts = {}
    for row in users:
        current = row.get("current", "")
        if current:
            counts[current] = counts.get(current, 0) + 1

    enabled_targets = {
        row_id: row
        for row_id, row in registry_map.items()
        if row_id != egress_id and str(row.get("enabled", "1")) == "1"
    }
    state = read_json(STATE_DIR / "v7-state.json", {})
    state_egress = state.get("egress") or {}
    matrix_items = (service_matrix_state().get("items") or {})
    speed_items = (speed_state().get("items") or {})
    policy_load = (policy_state().get("load") or {})
    source_role = safe_egress_role(source.get("role", ""), "GLOBAL_FAST")
    planned_counts = {}
    moves = []
    blockers = []

    for user in assigned_users:
        ip = safe_user_ip(user.get("ip", ""))
        candidates = []
        for target_id, target in enabled_targets.items():
            candidate = egress_candidate_score(
                target_id,
                target,
                source_role,
                state_egress.get(target_id, {}),
                matrix_items.get(target_id, {}),
                speed_items.get(target_id, {}),
            )
            if not candidate:
                continue
            current_count = counts.get(target_id, 0) + planned_counts.get(target_id, 0)
            soft_limit = egress_registry_load_limit(target, "soft_limit", int(policy_load.get("soft_limit") or 1))
            hard_limit = egress_registry_load_limit(target, "hard_limit", int(policy_load.get("hard_limit") or 2))
            over_soft = bool(soft_limit and current_count + 1 > soft_limit)
            over_hard = bool(hard_limit and current_count + 1 > hard_limit)
            adjusted_score = float(candidate.get("score") or 0) - (planned_counts.get(target_id, 0) * 12)
            if over_soft:
                adjusted_score -= 20
            if over_hard:
                adjusted_score -= 45
            candidate.update({
                "current_users": current_count,
                "soft_limit": soft_limit,
                "hard_limit": hard_limit,
                "over_soft_after_move": over_soft,
                "over_hard_after_move": over_hard,
                "adjusted_score": round(adjusted_score, 2),
            })
            candidates.append(candidate)
        candidates.sort(key=lambda row: (-float(row.get("adjusted_score") or 0), row.get("priority", 999), row.get("egress", "")))
        selected = candidates[0] if candidates else None
        if not selected:
            blockers.append({
                "ip": ip,
                "reason": "no_enabled_suitable_egress",
                "message": "Нет включённого подходящего канала для переноса этого клиента.",
            })
            continue
        target_id = selected.get("egress", "")
        planned_counts[target_id] = planned_counts.get(target_id, 0) + 1
        moves.append({
            "ip": ip,
            "from": egress_id,
            "to": target_id,
            "target_role": selected.get("role", ""),
            "score": selected.get("adjusted_score"),
            "fitness": selected.get("fitness", ""),
            "over_soft_after_move": selected.get("over_soft_after_move", False),
            "over_hard_after_move": selected.get("over_hard_after_move", False),
            "reason": ", ".join(selected.get("reasons") or []) or "best_available_candidate",
            "candidates": candidates[:5],
        })

    warnings = []
    if any(move.get("over_soft_after_move") for move in moves):
        warnings.append("some_targets_over_soft_limit_after_migration")
    if any(move.get("over_hard_after_move") for move in moves):
        warnings.append("some_targets_over_hard_limit_after_migration")
    return {
        "egress": egress_id,
        "source_role": source_role,
        "assigned_count": len(assigned_users),
        "assigned_users": [{"ip": row.get("ip", ""), "table": row.get("table", ""), "enabled": row.get("enabled", "1")} for row in assigned_users],
        "target_count": len(enabled_targets),
        "moves": moves,
        "blockers": blockers,
        "warnings": warnings,
        "ready": len(blockers) == 0 and len(moves) == len(assigned_users),
        "message": "Канал можно удалить после миграции клиентов." if assigned_users else "На канале нет клиентов, можно удалять сразу.",
    }, None


def migrate_users_then_delete_egress(egress_id, actor):
    plan, error = egress_delete_migration_plan(egress_id)
    if error:
        return None, error
    if not plan.get("assigned_count"):
        deleted, delete_error = delete_egress_everywhere(egress_id, actor)
        if delete_error:
            return None, delete_error
        return {"migration": plan, "switches": [], "delete": deleted}, None
    return None, {
        "error": "governed_execution_pipeline_required",
        "egress": egress_id,
        "assigned_count": int(plan.get("assigned_count") or 0),
        "migration_preview": plan,
        "message": "Deleting an assigned channel requires governed movement via approval packet and v7-users-autoswitch.",
    }


def migrate_users_then_pause_egress(egress_id, actor):
    plan, error = egress_delete_migration_plan(egress_id)
    if error:
        return None, error
    if int(plan.get("assigned_count") or 0) > 0:
        return None, {
            "error": "governed_execution_pipeline_required",
            "egress": egress_id,
            "assigned_count": int(plan.get("assigned_count") or 0),
            "migration_preview": plan,
            "message": "Pausing an assigned channel requires governed movement via approval packet and v7-users-autoswitch.",
        }
    if not plan.get("ready"):
        return None, {"error": "egress_pause_migration_not_ready", "migration_preview": plan}

    switches = []
    result = run_action(["v7-egress-set-state", egress_id, "disabled", "--apply"], actor, timeout=30)
    if result.get("rc") != 0:
        return None, {
            "error": "egress_pause_state_apply_failed",
            "egress": egress_id,
            "state_result": result,
            "switches": switches,
