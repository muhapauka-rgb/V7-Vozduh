      const raw = String(history.output || history.history || history || '');
      const lineBreak = String.fromCharCode(10);
      return raw.replaceAll('\\\\n', lineBreak).split(new RegExp(lineBreak + '+')).map(line => {
        const text = line.trim();
        if (!text) return null;
        const time = (text.match(/^\\d{4}-\\d{2}-\\d{2}T\\S+/) || [''])[0];
        const get = key => (text.match(new RegExp(`${key}=([^\\s]+)`)) || [,''])[1];
        const from = get('from');
        const to = get('to');
        return {
          time,
          user: get('user'),
          from,
          to,
          table: get('table'),
          reason: get('reason'),
          plain: from && to ? `Переведён с ${from} на ${to}` : text,
        };
      }).filter(Boolean);
    }
