def p2_7_candidate_review_state(candidate):
    lifecycle = str(candidate.get("lifecycle_state") or "").upper()
    risk = str(candidate.get("risk_state") or "").upper()
    if lifecycle in {"ARCHIVED", "EXPIRED"}:
        return "ARCHIVED"
    if lifecycle == "BLOCKED" or risk in {"BLOCKED", "FAIL"}:
        return "BLOCKED"
    if lifecycle == "READY_FOR_CONTRACT" and risk in {"LOW", "PASS", ""}:
        return "READY_FOR_APPROVAL"
    if lifecycle == "READY_FOR_REVIEW" or risk == "REVIEW_REQUIRED":
        return "UNDER_REVIEW"
    return "NEW"


