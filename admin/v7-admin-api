        wg_outbound["peers"][0]["pre_shared_key"] = parsed.get("preshared_key")
    outbounds = [wg_outbound, {"type": "direct", "tag": "direct"}, {"type": "block", "tag": "block"}]
    if mode == "AUTO_TRAVEL":
        outbounds.extend([
            {"type": "selector", "tag": "ru-mode", "outbounds": ["direct", wg_tag], "default": "direct"},
            {"type": "selector", "tag": "global-mode", "outbounds": [wg_tag, "direct"], "default": wg_tag},
        ])
    rules = [
        {"action": "sniff", "timeout": "300ms"},
        endpoint_ip_rule,
        {"network": "udp", "port": 443, "action": "route", "outbound": "block"},
        {"ip_version": 6, "action": "route", "outbound": "block"},
        {"protocol": "dns", "action": "hijack-dns"},
        {"domain_suffix": ["ru", "xn--p1ai"], "action": "route", "outbound": ru_outbound},
    ]
    return {
        "log": {"level": "info", "timestamp": True},
        "experimental": {"cache_file": {"enabled": True, "path": f"v7-{safe_client_name(client_name)}-{mode.lower()}-wg.db"}},
        "dns": {
            "servers": [
                {"type": "local", "tag": "local"},
                {"type": "udp", "tag": "v7-dns", "server": parsed.get("dns") or "10.0.0.1", "detour": wg_tag},
