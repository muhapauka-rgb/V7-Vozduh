    function v2IssuePersonCandidates(query='') {
      const raw = String(query || '').trim();
      const q = normalizeV2IssueSearchText(raw);
      const digits = raw.replace(/\\D+/g, '');
      const phone = normalizeV2IssuePhone(raw);
      if (!q && !digits) return [];
      const candidates = [];
      const seen = new Set();
      const addCandidate = item => {
        const key = `${item.kind}:${item.key}`;
        if (seen.has(key)) return;
        seen.add(key);
        candidates.push(item);
      };
      (overview.identity?.users || []).forEach(user => {
        const userPhone = normalizeV2IssuePhone(user.phone_normalized || user.phone || '');
        const name = v2IssueUserName(user);
        const org = v2IssueUserOrg(user);
        const haystack = normalizeV2IssueSearchText([name, user.entered_name, user.display_name, org, user.phone_normalized].filter(Boolean).join(' '));
        const phoneMatch = phone && userPhone === phone;
        const partialPhoneMatch = digits.length >= 3 && String(user.phone_normalized || '').replace(/\\D+/g, '').includes(digits);
        const textMatch = q.length >= 2 && haystack.includes(q);
        if (!phoneMatch && !partialPhoneMatch && !textMatch) return;
        const devices = v2IssueDevicesForPerson(user, userPhone);
        addCandidate({
          kind: 'identity',
          key: user.id || userPhone,
          score: phoneMatch ? 0 : (partialPhoneMatch ? 1 : 2),
          name,
          phone: user.phone_normalized || userPhone,
          org,
          devices: devices.identityDevices.length || devices.vpnRows.length || Number(user.active_devices || 0),
          maxDevices: user.max_devices || '',
          note: identityUserStatus(user) || user.status || 'active',
        });
      });
      (overview.identity?.allowed_users || []).forEach(row => {
        const rowPhone = normalizeV2IssuePhone(row.phone_normalized || row.phone || '');
        const org = identityOrgNameById(row.organization_id || '');
        const haystack = normalizeV2IssueSearchText([row.expected_name, row.phone_normalized, org, row.note].filter(Boolean).join(' '));
        const phoneMatch = phone && rowPhone === phone;
        const partialPhoneMatch = digits.length >= 3 && String(row.phone_normalized || '').replace(/\\D+/g, '').includes(digits);
        const textMatch = q.length >= 2 && haystack.includes(q);
        if (!phoneMatch && !partialPhoneMatch && !textMatch) return;
        if ((overview.identity?.users || []).some(u => normalizeV2IssuePhone(u.phone_normalized || u.phone || '') === rowPhone)) return;
        addCandidate({
          kind: 'allowed',
          key: rowPhone,
          score: phoneMatch ? 3 : (partialPhoneMatch ? 4 : 5),
          name: row.expected_name || rowPhone,
          phone: row.phone_normalized || rowPhone,
          org,
          devices: 0,
          maxDevices: '',
          note: Number(row.is_active ?? 1) === 1 ? 'разрешён' : 'выключен',
        });
      });
      users().forEach(row => {
        const h = userHumanFields(row.ip || '', row);
        const rowPhone = normalizeV2IssuePhone(h.phone || row.phone || row.phone_normalized || '');
        if (!rowPhone) return;
        if ((overview.identity?.users || []).some(u => normalizeV2IssuePhone(u.phone_normalized || u.phone || '') === rowPhone)) return;
        const haystack = normalizeV2IssueSearchText([h.name, h.phone, row.ip, row.current].filter(Boolean).join(' '));
        const phoneMatch = phone && rowPhone === phone;
        const partialPhoneMatch = digits.length >= 3 && rowPhone.includes(digits);
        const textMatch = q.length >= 2 && haystack.includes(q);
        if (!phoneMatch && !partialPhoneMatch && !textMatch) return;
        addCandidate({
          kind: 'existing',
          key: row.ip || rowPhone,
          score: phoneMatch ? 6 : (partialPhoneMatch ? 7 : 8),
          name: h.name || row.ip || rowPhone,
          phone: h.phone || rowPhone,
          org: h.organization || '',
          devices: 1,
          maxDevices: '',
          note: row.current || row.status || 'устройство',
        });
      });
      return candidates.sort((a, b) => (a.score - b.score) || String(a.name || '').localeCompare(String(b.name || ''), 'ru')).slice(0, 12);
    }
