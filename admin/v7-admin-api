        return {"status": "FAIL", "reason": f"active stored execution contracts={len(active)}", "source": "execution_contract_store", "detail": {"active_contract_ids": [c.get("contract_id") for c in active[:10]]}}
    return {"status": "PASS", "reason": "no active stored execution contract conflict", "source": "execution_contract_store", "detail": {"active_contracts": 0}}


def routing_mode_read_adapter(draft):
    users = draft.get("affected_users") or []
    registry = users_registry_map()
    missing = [ip for ip in users if ip not in registry]
    if missing:
        return {"status": "FAIL", "reason": f"users missing from registry: {', '.join(missing[:8])}", "source": "users.registry", "detail": {"missing_users": missing}}
    if not users:
        return {"status": "REVIEW_REQUIRED", "reason": "no affected users; routing mode not applicable", "source": "draft", "detail": {}}
    return {"status": "PASS", "reason": "all affected users have known registry routing state", "source": "users.registry", "detail": {"users": users}}


def containment_read_adapter(draft):
    manifest = draft.get("rollback_manifest") or {}
    unknown = [ip for ip, target in manifest.items() if not target or target == "UNKNOWN"]
    if unknown:
        return {"status": "FAIL", "reason": f"rollback target unknown for {len(unknown)} users", "source": "rollback_manifest", "detail": {"unknown_users": unknown}}
    if not manifest and draft.get("action_type") != "OBSERVE":
        return {"status": "FAIL", "reason": "rollback manifest missing for movement draft", "source": "rollback_manifest", "detail": {}}
    return {"status": "PASS", "reason": "rollback/containment manifest is available for preview scope", "source": "rollback_manifest", "detail": {"rollback_users": len(manifest)}}


def group_constraints_read_adapter(draft):
    users = draft.get("affected_users") or []
    if not users:
        return {"status": "REVIEW_REQUIRED", "reason": "no affected users; group constraints not applicable", "source": "draft", "detail": {}}
    return {"status": "REVIEW_REQUIRED", "reason": "group policy is not yet a dedicated read adapter; registry users are known", "source": "users.registry", "detail": {"users": users}}


def execution_gate_adapters_for_draft(draft):
    selected = selected_moves_read_adapter()
    restore = restore_settle_read_adapter()
    hidden = hidden_movers_read_adapter(selected)
    runtime = runtime_convergence_response()
    release = release_current_model()
    runtime_status = runtime.get("runtime_status", "RUNTIME_UNKNOWN")
    release_status = release.get("release_status", "RELEASE_UNKNOWN")
    proposal_id = (draft.get("proposal_references") or [""])[0] if draft.get("proposal_references") else ""
    evidence_id = (draft.get("evidence_references") or [""])[0] if draft.get("evidence_references") else ""
    capacity = capacity_read_adapter(draft.get("target", ""), len(draft.get("affected_users") or []))
    target_ready = target_readiness_read_adapter(draft.get("target", ""))
    adapters = {
        "authority": execution_gate_adapter_result("authority", "Authority", "PASS" if proposal_id else "FAIL", "Proposal reference present." if proposal_id else "Contract draft has no proposal reference.", source="proposal", detail={"proposal_id": proposal_id}),
        "evaluator": execution_gate_adapter_result("evaluator", "Evaluator", "PASS" if evidence_id else "FAIL", "Evidence reference present." if evidence_id else "Proposal without evidence cannot become execution draft.", source="evidence", detail={"evidence_bundle_id": evidence_id}),
        "conflict_resolver": execution_gate_adapter_result("conflict_resolver", "Conflict Resolver", "PASS" if capacity.get("status") != "FAIL" else "FAIL", "Capacity and target conflict sources are readable.", source="capacity_adapter", detail={"capacity_status": capacity.get("status")}),
        "runtime_trust": execution_gate_adapter_result("runtime_trust", "Runtime Trust", "PASS" if runtime_status == "RUNTIME_OK" else ("FAIL" if runtime_status == "RUNTIME_BLOCKING" else "REVIEW_REQUIRED"), runtime.get("operator_status_text", ""), source="runtime_trust", detail={"runtime_status": runtime_status}),
        "release_trust": execution_gate_adapter_result("release_trust", "Release Trust", "PASS" if release_status == "RELEASE_OK" else ("FAIL" if release_status == "RELEASE_DRIFT" else "REVIEW_REQUIRED"), release.get("operator_status_text", ""), source="release_trust", detail={"release_status": release_status}),
        "required_services": execution_gate_adapter_result("required_services", "Required Services", **required_services_read_adapter(draft), blocking=False),
        "capacity": execution_gate_adapter_result("capacity", "Capacity", **capacity),
        "policy": execution_gate_adapter_result("policy", "Policy", **policy_read_adapter(draft)),
        "concurrency": execution_gate_adapter_result("concurrency", "Concurrency", **concurrency_read_adapter(draft), blocking=False),
        "restore_settle": execution_gate_adapter_result("restore_settle", "Restore-Settle", **restore),
        "selected_moves": execution_gate_adapter_result("selected_moves", "Selected Moves", selected.get("status"), selected.get("reason"), source=selected.get("source"), detail=selected),
        "hidden_movers": execution_gate_adapter_result("hidden_movers", "Hidden Movers", hidden.get("status"), hidden.get("reason"), source=hidden.get("source"), detail=hidden),
        "target_readiness": execution_gate_adapter_result("target_readiness", "Target Readiness", **target_ready),
        "routing_mode": execution_gate_adapter_result("routing_mode", "Routing Mode", **routing_mode_read_adapter(draft)),
        "containment_state": execution_gate_adapter_result("containment_state", "Containment State", **containment_read_adapter(draft)),
        "group_constraints": execution_gate_adapter_result("group_constraints", "Group Constraints", **group_constraints_read_adapter(draft), blocking=False),
    }
    return adapters


