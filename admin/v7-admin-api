def traffic_sum_rows(conn, table, entity_type, entity_id, where="", params=()):
    try:
        row = conn.execute(
            f"""
            SELECT COALESCE(SUM(rx_bytes),0) AS rx, COALESCE(SUM(tx_bytes),0) AS tx, COALESCE(SUM(total_bytes),0) AS total
            FROM {table}
            WHERE entity_type=? AND entity_id=? {where}
            """,
            (entity_type, entity_id, *params),
        ).fetchone()
    except sqlite3.Error:
        return {"rx_bytes": 0, "tx_bytes": 0, "total_bytes": 0}
    return {
        "rx_bytes": int(row["rx"] or 0),
        "tx_bytes": int(row["tx"] or 0),
        "total_bytes": int(row["total"] or 0),
    }


