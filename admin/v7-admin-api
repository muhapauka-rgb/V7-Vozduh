def shadow_autonomy_history(limit=500):
    return read_jsonl_records(SHADOW_AUTONOMY_LOG_FILE, limit=limit)


def shadow_autonomy_response(decision_surface=None, record=True):
    surface = decision_surface or operator_decision_surface_response()
    history = shadow_autonomy_history(limit=500)
    model = shadow_autonomy.build_shadow_autonomy_model(surface, history=history, now=now_iso())
    logged = []
    if record:
        known = {
            str(row.get("decision_id") or "")
            for row in history
            if row.get("record_type") == shadow_autonomy.DECISION_RECORD_TYPE
        }
        for decision in model.get("current_decisions") or []:
            decision_id = str(decision.get("decision_id") or "")
            if decision_id and decision_id not in known:
                append_jsonl(SHADOW_AUTONOMY_LOG_FILE, decision)
                logged.append(decision_id)
                history.append(decision)
        if logged:
            model = shadow_autonomy.build_shadow_autonomy_model(surface, history=history, now=now_iso())
    model["storage_backend"] = "jsonl"
    model["storage_path"] = str(SHADOW_AUTONOMY_LOG_FILE)
    model["logged_decisions_added"] = logged
    model["execution_allowed_now"] = False
    model["runtime_mutation_performed"] = False
    model["users_moved"] = 0
    model["apply_executed"] = False
    model["autonomy_enabled"] = False
    return model


