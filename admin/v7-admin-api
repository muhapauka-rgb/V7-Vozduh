def summarize_workflow_by_key(items, key):
    rows = {}
    for item in items:
        value = item.get(key) or "Unknown"
        row = rows.setdefault(value, {"name": value, "total": 0, "failed": 0, "review_required": 0, "unknown": 0, "pass": 0, "gates": []})
        row["total"] += 1
        status = str(item.get("status") or "UNKNOWN").upper()
        if status == "FAIL":
            row["failed"] += 1
        elif status == "REVIEW_REQUIRED":
            row["review_required"] += 1
        elif status == "UNKNOWN":
            row["unknown"] += 1
        elif status == "PASS":
            row["pass"] += 1
        if item.get("gate_id") not in row["gates"]:
            row["gates"].append(item.get("gate_id"))
    return sorted(rows.values(), key=lambda row: (row["failed"], row["review_required"], row["unknown"], row["total"]), reverse=True)


