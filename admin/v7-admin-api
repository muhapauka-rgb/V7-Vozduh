def traffic_summary_state():
    result = {"status": "MISSING", "users": {}, "channels": {}, "updated_at": now_iso(), "db": str(TRAFFIC_DB_FILE)}
    conn = traffic_db_connect()
    if not conn:
        return result
    registry_users = parse_registry(STATE_DIR / "users.registry")
    users_by_ip = {row.get("ip", ""): row for row in registry_users if row.get("ip")}
    proxy_routes = proxy_runtime_user_routes(PROXY_INBOUND_ID)
    vless_activities = vless_activity_map()
    try:
        result["status"] = "OK"
        user_ids = set(users_by_ip.keys())
        channel_ids = {row.get("id", "") for row in parse_registry(STATE_DIR / "egress.registry") if row.get("id")}
        try:
            user_ids.update(row["entity_id"] for row in conn.execute("SELECT entity_id FROM traffic_totals WHERE entity_type='user'"))
            channel_ids.update(row["entity_id"] for row in conn.execute("SELECT entity_id FROM traffic_totals WHERE entity_type='channel'"))
        except sqlite3.Error:
            pass
        result["users"] = {}
        for ip in sorted(user_ids):
            if not ip:
                continue
            row = traffic_entity_summary(conn, "user", ip)
            proxy_route = proxy_routes.get(ip, {})
            if proxy_route:
                row["proxy_route"] = proxy_route
                row["vless_activity"] = vless_activities.get(ip, empty_vless_activity())
                row["accounting"] = {
                    "mode": "vless_identity",
                    "exact_user_bytes": False,
                    "status": "activity_only",
                    "channel_entity_id": proxy_route.get("primary_egress", ""),
                    "note": "VLESS users are identified in sing-box by auth_user; nft per-IP counters only measure kernel WG/AWG traffic.",
                }
            else:
                row["accounting"] = {
                    "mode": "kernel_ip_counter",
                    "exact_user_bytes": True,
                    "status": "ok",
                    "channel_entity_id": (users_by_ip.get(ip) or {}).get("current", ""),
                }
            result["users"][ip] = row
        result["channels"] = {eid: traffic_entity_summary(conn, "channel", eid) for eid in sorted(channel_ids) if eid}
        result["proxy_user_routes"] = proxy_routes
    finally:
        conn.close()
    return result


