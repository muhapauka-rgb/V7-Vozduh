def egress_draft_tool_requirements(protocol, runtime_mode):
    if protocol in ("wireguard",):
        return {
            "required": ["ip", "wg", "wg-quick", "curl"],
            "alternatives": [],
            "notes": ["WireGuard egress drafts are tested with V7-managed routing; the isolated runtime copy is normalized to Table = off."],
        }
    if protocol in ("amneziawg",):
        return {
            "required": ["ip", "awg", "curl"],
            "alternatives": [["awg-quick", "amneziawg-go"]],
            "notes": ["AmneziaWG needs native x86_64 tooling; V7 owns routing, so the isolated runtime copy is normalized to Table = off."],
        }
    if protocol in ("vless", "sing-box", "shadowsocks_or_outline", "vmess", "trojan", "hysteria", "hysteria2", "tuic", "anytls", "socks", "http", "wireguard_uri"):
        return {
            "required": ["sing-box", "curl"],
            "alternatives": [],
            "notes": ["Proxy/tun drafts must be tested through an isolated sing-box profile before pool activation."],
        }
    if protocol == "openvpn":
        return {
            "required": ["openvpn", "curl"],
            "alternatives": [],
            "notes": ["OpenVPN drafts run as V7-managed interface egress: V7 forces route-nopull, blocks scripts, keeps DNS under V7 control, and tests through a temporary interface first."],
        }
    if protocol == "clash_yaml":
        return {
            "required": ["sing-box", "curl"],
            "alternatives": [],
            "notes": ["Clash YAML drafts can run read-only conversion preview, then require selected-proxy conversion before isolated runtime testing."],
        }
    return {
        "required": ["curl"],
        "alternatives": [],
        "notes": ["Unknown drafts can only run generic preflight until the protocol adapter is known."],
    }


def egress_draft_check_tools(requirements):
    checks = []
    ok = True
    for tool in requirements.get("required", []):
        path = shutil.which(tool)
        state = "OK" if path else "MISSING"
        ok = ok and bool(path)
        checks.append({"tool": tool, "required": True, "status": state, "path": path or ""})
    for group in requirements.get("alternatives", []):
        found = [(tool, shutil.which(tool)) for tool in group]
        group_ok = any(path for _, path in found)
        ok = ok and group_ok
        checks.append({
            "tool": " or ".join(group),
            "required": True,
            "status": "OK" if group_ok else "MISSING",
            "path": ", ".join(f"{tool}={path}" for tool, path in found if path),
        })
    return checks, ok


def egress_draft_unsafe_interface_options(text):
    sections = _egress_preview_ini_sections(text)
    blocked = []
    for section_name, section in (("Interface", sections.get("Interface", {})), ("Peer", sections.get("Peer", {}))):
        for key in section:
            if key.lower() in {"preup", "postup", "predown", "postdown", "saveconfig"}:
                blocked.append(f"{section_name}.{key}")
    return blocked


def egress_interface_config_fingerprint(text):
    sections = _egress_preview_ini_sections(text or "")
    interface = {str(k).lower(): str(v).strip() for k, v in (sections.get("Interface") or {}).items()}
    peer = {str(k).lower(): str(v).strip() for k, v in (sections.get("Peer") or {}).items()}
    address = ",".join(sorted(part.strip() for part in interface.get("address", "").split(",") if part.strip()))
    return {
        "private_key": interface.get("privatekey", ""),
        "address": address,
        "peer_public_key": peer.get("publickey", ""),
        "endpoint": peer.get("endpoint", "").lower(),
        "allowed_ips": ",".join(sorted(part.strip() for part in peer.get("allowedips", "").split(",") if part.strip())),
    }


def egress_draft_duplicate_interface_egress(protocol, text, proposed_id=""):
    fingerprint = egress_interface_config_fingerprint(text)
    required = ("private_key", "peer_public_key", "endpoint")
    if not all(fingerprint.get(key) for key in required):
        return {}
    proposed_id = safe_egress_id(proposed_id or "")
    for row in egress_registry_rows(enabled_only=False):
        egress_id = safe_egress_id(row.get("id", ""))
        if not egress_id or egress_id == proposed_id:
            continue
        if str(row.get("type", "")) != "interface" or str(row.get("protocol", "")) != protocol:
            continue
        for path in egress_runtime_profile_candidates(egress_id, row):
            if not path.exists():
                continue
            other = egress_interface_config_fingerprint(read_text(path, ""))
            if all(other.get(key) == fingerprint.get(key) for key in required):
                return {
                    "egress": egress_id,
                    "interface": row.get("interface", ""),
                    "config": str(path),
                    "enabled": row.get("enabled", ""),
                }
    return {}


def egress_draft_static_checks(draft_id, preview, text=""):
    checks = []
    protocol = preview.get("protocol", "unknown")
    runtime_mode = preview.get("runtime_mode", "unknown")
    checks.append({
        "id": "detected_required_fields",
        "status": "OK" if preview.get("validation") == "detected_required_fields" else "FAIL",
        "detail": preview.get("validation", "unknown"),
    })
    active_text = read_text(STATE_DIR / "egress.registry", "") + "\n" + read_text(STATE_DIR / "users.registry", "")
    checks.append({
        "id": "not_in_active_registry",
        "status": "OK" if draft_id not in active_text else "FAIL",
        "detail": "draft id is not active" if draft_id not in active_text else "draft id found in active registry",
    })
    if runtime_mode == "interface" and protocol in ("wireguard", "amneziawg"):
        blocked_hooks = egress_draft_unsafe_interface_options(text)
        checks.append({
            "id": "unsafe_hooks_absent",
            "status": "OK" if not blocked_hooks else "FAIL",
            "detail": "no executable hooks/options copied" if not blocked_hooks else ",".join(blocked_hooks),
        })
        table_value = str((preview.get("detected_fields") or {}).get("table", "")).strip().lower()
        checks.append({
            "id": "table_off_runtime_normalized",
            "status": "OK",
            "detail": "source already has Table = off" if table_value == "off" else "isolated runtime copy will force Table = off",
        })
        endpoint = str((preview.get("detected_fields") or {}).get("endpoint_host", "")).strip()
        checks.append({
            "id": "endpoint_present",
            "status": "OK" if endpoint else "FAIL",
            "detail": endpoint or "missing endpoint host",
        })
    if runtime_mode in ("proxy_or_tun", "sing_box"):
        checks.append({
            "id": "proxy_runtime_isolated",
            "status": "OK",
            "detail": "runtime test must use a temporary profile and must not touch current sing-box service",
        })
        if protocol in ("subscription_url", "subscription_list", "xray_json"):
            checks.append({
                "id": "conversion_adapter",
                "status": "FAIL",
                "detail": "recognized container/subscription config must be expanded or converted into one managed sing-box outbound before runtime use",
            })
        if protocol == "clash_yaml":
            checks.append({
                "id": "clash_conversion_adapter",
                "status": "FAIL",
                "detail": "Clash YAML read-only converter preview is available, but runtime still requires selected-proxy conversion to a V7-managed sing-box draft",
            })
    if protocol == "openvpn":
        fields = _egress_preview_openvpn_fields(text)
        normalized_text, auth_file_content, normalize_error = egress_openvpn_normalize_runtime_config(
            text,
            "v7ovpncheck",
            auth_path="/etc/v7/egress-openvpn/v7ovpncheck.auth",
            redact_output=True,
        )
        checks.append({
            "id": "openvpn_scripts_absent",
            "status": "OK" if not fields.get("scripts") else "FAIL",
            "detail": "no scripts/hooks detected" if not fields.get("scripts") else "; ".join(fields.get("scripts", [])[:4]),
        })
        checks.append({
            "id": "openvpn_route_dns_normalized",
            "status": "OK" if not normalize_error else "FAIL",
            "detail": "V7 will force route-nopull, ignore pushed DNS, and keep routing under V7 control" if not normalize_error else "; ".join((normalize_error.get("details") or [])[:3]) or "normalization failed",
        })
        checks.append({
            "id": "openvpn_runtime_adapter",
            "status": "OK" if not normalize_error else "FAIL",
            "detail": "managed OpenVPN runtime adapter ready" if not normalize_error else "OpenVPN profile still has unsafe or unsupported directives",
        })
    return checks


