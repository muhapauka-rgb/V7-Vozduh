def _count_best_available_pool(obj):
    if isinstance(obj, dict):
        count = 1 if obj.get("best_available_pool") is True else 0
        return count + sum(_count_best_available_pool(value) for value in obj.values())
    if isinstance(obj, list):
        return sum(_count_best_available_pool(item) for item in obj)
    return 0


def _planner_refresh_summary(plan):
    if not isinstance(plan, dict):
        plan = {}
    summary = plan.get("summary") if isinstance(plan.get("summary"), dict) else {}
    dynamic_load = plan.get("dynamic_load") if isinstance(plan.get("dynamic_load"), dict) else {}
    safety = plan.get("safety") if isinstance(plan.get("safety"), dict) else {}
    snapshot_gate = safety.get("intelligence_snapshots") if isinstance(safety.get("intelligence_snapshots"), dict) else {}
    refresh = snapshot_gate.get("pre_planner_refresh") if isinstance(snapshot_gate.get("pre_planner_refresh"), dict) else {}
    selected_moves = plan.get("selected_moves") if isinstance(plan.get("selected_moves"), list) else []
    source_mismatch = snapshot_gate.get("source_mismatch_families") or snapshot_gate.get("stop_families") or []
    if not isinstance(source_mismatch, list):
        source_mismatch = [str(source_mismatch)]
    candidate_moves_total = summary.get("candidate_moves_total", summary.get("candidate_moves", 0))
    return {
        "snapshot_stop_required": bool(snapshot_gate.get("stop_required", False)),
        "source_mismatch_families": source_mismatch,
        "candidate_moves_total": candidate_moves_total,
        "selected_moves_before_gate": snapshot_gate.get("selected_moves_before_gate", 0),
        "selected_moves_after_gate": snapshot_gate.get("selected_moves_after_gate", summary.get("selected_moves", len(selected_moves))),
        "healthy_egress_total": summary.get("healthy_egress_total", dynamic_load.get("healthy_channels", 0)),
        "best_available_pool": {
            "count": _count_best_available_pool(plan),
            "policy": plan.get("best_available_pool_policy") if isinstance(plan.get("best_available_pool_policy"), dict) else {},
        },
        "pre_planner_refresh_state": refresh.get("state", ""),
        "pre_planner_refresh_rc": refresh.get("rc", None),
        "refresh_snapshot_count": refresh.get("snapshot_count", 0),
        "refresh_warnings": refresh.get("warnings", []),
        "apply_present": bool(plan.get("apply_result", {}).get("applied")) if isinstance(plan.get("apply_result"), dict) else False,
        "runtime_behavior_changed": False,
        "governance_behavior_changed": False,
        "users_moved": False,
        "routing_mutation_performed": False,
    }


def autoswitch_planner_refresh_dry_run_state(actor):
    cmd = [
