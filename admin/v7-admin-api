OVERVIEW_CACHE_TTL_SEC = 20
OVERVIEW_CACHE = {"data": None, "ts": 0.0, "refreshing": False, "error": ""}
OVERVIEW_CACHE_LOCK = threading.Lock()


def overview_for_session(data, session=None, stale=False):
    result = dict(data or {})
    result["access"] = role_state_for_session(session)
    result["cache"] = {
        "stale": bool(stale),
        "updated_age_sec": max(0, int(time.monotonic() - float(OVERVIEW_CACHE.get("ts") or 0))),
    }
    if OVERVIEW_CACHE.get("error"):
        result["cache"]["last_error"] = OVERVIEW_CACHE.get("error")
    return result


def refresh_overview_cache():
    with OVERVIEW_CACHE_LOCK:
        if OVERVIEW_CACHE.get("refreshing"):
            return
        OVERVIEW_CACHE["refreshing"] = True
    try:
        data = overview(None)
        with OVERVIEW_CACHE_LOCK:
            OVERVIEW_CACHE.update({"data": data, "ts": time.monotonic(), "error": ""})
    except Exception as exc:
        with OVERVIEW_CACHE_LOCK:
            OVERVIEW_CACHE["error"] = str(exc)
    finally:
        with OVERVIEW_CACHE_LOCK:
            OVERVIEW_CACHE["refreshing"] = False


def overview_cached(session=None, force=False):
    now = time.monotonic()
    with OVERVIEW_CACHE_LOCK:
        data = OVERVIEW_CACHE.get("data")
        age = now - float(OVERVIEW_CACHE.get("ts") or 0)
        refreshing = bool(OVERVIEW_CACHE.get("refreshing"))
    if data is not None and not force:
        stale = age > OVERVIEW_CACHE_TTL_SEC
        if stale and not refreshing:
            threading.Thread(target=refresh_overview_cache, name="v7-overview-cache-refresh", daemon=True).start()
        return overview_for_session(data, session, stale=stale)
    refresh_overview_cache()
    with OVERVIEW_CACHE_LOCK:
        data = OVERVIEW_CACHE.get("data")
    if data is not None:
        return overview_for_session(data, session, stale=False)
    return overview(session)


