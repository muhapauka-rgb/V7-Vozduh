            "default_domain_resolver": default_resolver,
        },
    }


def yaml_single_quote(value):
    return "'" + str(value or "").replace("'", "''") + "'"


def wg_clash_ip_addresses(address_value):
    ipv4 = ""
    ipv6 = ""
    for item in str(address_value or "").split(","):
        item = item.strip()
        if not item:
            continue
        host = item.split("/", 1)[0].strip()
        if ":" in host and not ipv6:
            ipv6 = host
        elif "." in host and not ipv4:
            ipv4 = host
    return ipv4, ipv6


def build_karing_wg_clash_profile(ip, client_name, mode, conf_path):
    mode = safe_smart_mode(mode) or "RU_LOCAL"
    parsed = parse_wg_client_conf(conf_path)
    endpoint_host = parsed.get("endpoint_host") or public_profile_host()
    endpoint_port = int(parsed.get("endpoint_port") or 51820)
    keepalive = 25
    try:
        keepalive = int(parsed.get("persistent_keepalive") or 25)
    except (TypeError, ValueError):
        keepalive = 25
    keepalive = max(0, min(keepalive, 120))
    ipv4, ipv6 = wg_clash_ip_addresses(parsed.get("address") or f"{safe_user_ip(ip)}/32")
    if not ipv4:
        ipv4 = safe_user_ip(ip)
    wg_name = "V7-WG"
    if mode == "ABROAD_RU_VIA_V7":
        ru_outbound = wg_name
        final_outbound = "DIRECT"
