def file_fingerprint_component(name, path, label=""):
    path = Path(path)
    exists = path.exists()
    age = file_age(path) if exists else None
    digest = ""
    size = 0
    if exists:
        try:
            raw = path.read_bytes()
            size = len(raw)
            digest = hashlib.sha256(raw).hexdigest()
        except OSError:
            digest = ""
    status = "OK" if exists and digest else "MISSING"
    return {
        "name": name,
        "label": label or name,
        "present": bool(exists),
        "status": status,
        "age_sec": age,
        "size_bytes": size,
        "fingerprint_short": digest[:12] if digest else "",
        "advanced_hash_available": bool(digest),
        "hash": digest,
    }


