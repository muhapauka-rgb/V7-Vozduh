def git_value(args, default=""):
    res = run_readonly(["git", "-C", str(REPO_ROOT), *args], timeout=5)
    if res.get("rc") != 0:
        return default
    return str(res.get("output") or "").strip().splitlines()[0] if str(res.get("output") or "").strip() else default


def git_status_count():
    res = run_readonly(["git", "-C", str(REPO_ROOT), "status", "--short"], timeout=5)
    if res.get("rc") != 0:
        return None
    return len([line for line in str(res.get("output") or "").splitlines() if line.strip()])


def release_report_inventory(limit=30):
    try:
        roots = [REPO_ROOT, REPO_ROOT / "docs" / "track7" / "productization"]
        files = []
        for root in roots:
            if not root.exists():
                continue
            files.extend(root.glob("BLOCK_*_REPORT.md"))
        unique = {}
        for path in files:
            try:
                stat = path.stat()
            except OSError:
                continue
            unique[str(path)] = {
                "path": str(path.relative_to(REPO_ROOT)) if str(path).startswith(str(REPO_ROOT)) else str(path),
                "updated_at": datetime.fromtimestamp(stat.st_mtime, tz=timezone.utc).isoformat(),
                "size_bytes": stat.st_size,
            }
        return sorted(unique.values(), key=lambda x: x.get("updated_at", ""), reverse=True)[:limit]
    except OSError:
        return []


def release_current_model(include_advanced=False):
    head = git_value(["rev-parse", "--short", "HEAD"], "")
    branch = git_value(["rev-parse", "--abbrev-ref", "HEAD"], "")
    dirty_count = git_status_count()
    reports = release_report_inventory(40)
    backups_rows = backups()
    runtime = runtime_convergence_response(include_advanced=False)
    runtime_ok = runtime.get("runtime_status") == "RUNTIME_OK"
    release_id = f"release-{head}" if head else evidence_hash("release", branch, len(reports), now_iso()[:10])
    if not head:
        status = "RELEASE_UNKNOWN"
        certification_state = "UNKNOWN"
    elif dirty_count:
        status = "RELEASE_WARNING"
        certification_state = "LOCAL_CHANGES_PRESENT"
    elif not runtime_ok:
        status = "RELEASE_DRIFT"
        certification_state = "RUNTIME_ATTENTION_REQUIRED"
    else:
        status = "RELEASE_OK"
        certification_state = "CERTIFIED"
    rollback_available = bool(head or backups_rows)
    payload = {
