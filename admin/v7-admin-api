        risks.append({"category": "service", "severity": "review", "source": "service_impact", "detail": service_id})
    if rollback.get("status") != "PASS":
        risks.append({"category": "rollback", "severity": "blocker" if rollback.get("status") == "FAIL" else "review", "source": "rollback_impact", "detail": rollback.get("rollback_risk", "")})
    if not draft.get("proposal_references"):
        risks.append({"category": "authority", "severity": "blocker", "source": "candidate", "detail": "proposal reference missing"})
    if validation.get("status") == "FAIL":
        state = "BLOCKED"
    elif risks:
        state = "REVIEW_REQUIRED"
    else:
        state = "LOW"
    return {
        "candidate_id": candidate_id,
        "risk_state": state,
        "risk_count": len(risks),
        "risk_categories": sorted({row.get("category") for row in risks if row.get("category")}),
        "items": risks,
        "read_only": True,
        "non_authoritative": True,
        "preview_only": True,
        "execution_allowed_now": False,
    }


