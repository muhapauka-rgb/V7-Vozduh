def ts_epoch(value):
    if isinstance(value, (int, float)):
        return float(value)
    dt = parse_ts(value)
    if not dt:
        return None
    if isinstance(dt, (int, float)):
        return float(dt)
    try:
        return dt.timestamp()
    except (TypeError, ValueError, OSError):
        return None


def age_from_ts(value):
    epoch = ts_epoch(value)
    if epoch is None:
        return None
    return max(0, int(time.time() - epoch))


def iso_from_epoch(epoch):
    if epoch is None:
        return ""
    try:
        return datetime.fromtimestamp(epoch, tz=timezone.utc).isoformat()
    except (TypeError, ValueError, OSError):
        return ""


def freshness_model(ts_value, ttl_seconds):
    ttl = max(60, int(ttl_seconds or 60))
    age = age_from_ts(ts_value)
    if age is None:
        return {
            "freshness_state": "UNKNOWN",
            "freshness_age_sec": None,
            "freshness_ttl_sec": ttl,
            "expires_at": "",
        }
    state = "FRESH"
    if age > ttl * 2:
        state = "EXPIRED"
    elif age > ttl:
        state = "STALE"
    epoch = ts_epoch(ts_value)
    return {
        "freshness_state": state,
        "freshness_age_sec": age,
        "freshness_ttl_sec": ttl,
        "expires_at": iso_from_epoch(epoch + ttl) if epoch is not None else "",
    }


def retention_model(ts_value):
    days = max(1, int(HARDENING_RETENTION_DAYS or 1))
    age = age_from_ts(ts_value)
    if age is None:
        return {
            "retention_state": "UNKNOWN",
            "retention_days": days,
            "retention_age_sec": None,
        }
    due = age > days * 86400
    return {
        "retention_state": "RETENTION_DUE" if due else "RETAINED",
        "retention_days": days,
        "retention_age_sec": age,
    }


