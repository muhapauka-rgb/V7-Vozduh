    function operatorTone(value='') {
      const v = String(value || '').toUpperCase();
      if (['SAFE','FRESH','GO','OK','PASS','CLOSED','FALSE'].includes(v)) return 'ok';
      if (['BLOCKED','CONTAINED','REPLAY_RISK','MISSING','TRUE'].includes(v)) return 'bad';
      if (['CONDITIONAL','STALE','DEGRADED','RESTORE_PENDING','MOVEMENT_PENDING','HISTORICAL','UNKNOWN'].includes(v)) return 'warn';
      return statusTone(v);
    }
    function operatorDecisionTone(value='') {
      const v = String(value || '').toLowerCase();
      if (['excellent','good','ok','keep'].includes(v)) return 'ok';
      if (['warning','recommendation','move_recommended'].includes(v)) return 'warn';
      if (['degraded','blocked','bad'].includes(v)) return 'bad';
      return 'muted';
    }
    function channelStateTone(value='') {
      const v = String(value || '').toUpperCase();
      if (v === 'TRUSTED') return 'ok';
      if (v === 'WATCH' || v === 'RECOVERING' || v === 'NEW') return 'warn';
      if (v === 'DEGRADED' || v === 'QUARANTINED') return 'bad';
      return 'muted';
    }
