def run_readonly(cmd, timeout=12):
    try:
        proc = subprocess.run(
            cmd,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
            check=False,
        )
        return {
            "cmd": cmd,
            "rc": proc.returncode,
            "output": redact(proc.stdout[-12000:]),
        }
    except subprocess.TimeoutExpired as exc:
        output = exc.stdout or ""
        if isinstance(output, bytes):
            output = output.decode("utf-8", "replace")
        return {
            "cmd": cmd,
            "rc": 124,
            "output": redact(str(output) + "\nTIMEOUT"),
        }
    except OSError as exc:
        return {
            "cmd": cmd,
            "rc": 127,
            "output": f"ERROR: {exc}",
        }


def run_action(cmd, actor, timeout=40, extra_env=None):
    env = os.environ.copy()
    env["V7_ACTOR"] = actor or "admin"
    if extra_env:
        env.update(extra_env)
    try:
        proc = subprocess.run(
            cmd,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
            check=False,
            env=env,
        )
        return {
            "cmd": cmd,
            "rc": proc.returncode,
            "output": redact(proc.stdout[-12000:]),
        }
    except subprocess.TimeoutExpired as exc:
        output = exc.stdout or ""
        if isinstance(output, bytes):
            output = output.decode("utf-8", "replace")
        return {
            "cmd": cmd,
            "rc": 124,
            "output": redact(str(output) + "\nTIMEOUT"),
        }
    except OSError as exc:
        return {
            "cmd": cmd,
            "rc": 127,
            "output": f"ERROR: {exc}",
        }


def normalize_smart_profile_check(check, adapter):
    check = check if isinstance(check, dict) else {"rc": 1, "output": str(check)}
    output = str(check.get("output") or "")
    # Karing/Hiddify consume client-side sing-box profiles. The server binary can
    # be newer than the mobile client schema, so compatibility warnings must not
    # block issuing when our own profile validation still sees the V7 route.
    if (
        check.get("rc") != 0
        and adapter in ("karing", "hiddify")
        and (
            ("geosite database is deprecated" in output and "removed in sing-box" in output)
            or ("outbounds[" in output and 'unknown field "server"' in output)
        )
    ):
        normalized = dict(check)
        normalized["rc"] = 0
        normalized["warning"] = "server_singbox_check_skipped_for_client_profile_schema"
        return normalized
    return check


