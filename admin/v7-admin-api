    return forwarded or real_ip or handler.client_address[0]


def request_base_url(handler):
    host = str(handler.headers.get("Host") or "").strip()
    if not host:
        host = f"{HOST}:{PORT}"
    proto = str(handler.headers.get("X-Forwarded-Proto") or "").split(",", 1)[0].strip().lower()
    if proto not in ("http", "https"):
        local_hosts = ("127.0.0.1", "localhost", "[::1]")
        proto = "http" if any(host.startswith(item) for item in local_hosts) else "https"
    return f"{proto}://{host}"


