def execution_timeline_items(contract_id=""):
    safe_id = safe_execution_id(contract_id, "")
    items = []
    for contract in execution_contracts():
        if safe_id and contract.get("contract_id") != safe_id:
            continue
        items.append({
            "kind": "contract",
            "id": contract.get("contract_id", ""),
            "ts": contract.get("created_at") or contract.get("updated_at") or "",
            "title": "Execution contract",
            "status": contract.get("status", ""),
            "summary": contract.get("summary", ""),
            "affected_users": contract.get("affected_users", []),
            "target": contract.get("target", ""),
        })
    for event in execution_events():
