def delete_egress_everywhere(egress_id, actor):
    egress_id = safe_egress_id(egress_id)
    registry = egress_registry_map().get(egress_id, {})
    if not egress_id or not registry:
        return None, {"error": "invalid_egress"}

    assigned_users = egress_assigned_user_rows(egress_id)
    if assigned_users:
        migration_preview, _ = egress_delete_migration_plan(egress_id)
        return None, {
            "error": "egress_delete_blocked_users_assigned",
            "egress": egress_id,
            "users": [row.get("ip", "") for row in assigned_users],
            "assigned_count": len(assigned_users),
            "migration_preview": migration_preview,
            "message": "Move users to another channel before deleting this channel.",
        }

    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    changed = []
    backups = []
    removed_files = []
    skipped_files = []
    commands = []

    ifname = registry.get("interface", "")
    protocol = str(registry.get("protocol", "")).lower()
    if registry.get("type") == "interface" and egress_interface_live(ifname):
        tool = "awg-quick" if protocol == "amneziawg" else "wg-quick"
        down = run_action([tool, "down", ifname], actor, timeout=25)
        commands.append({"cmd": f"{tool} down {ifname}", "rc": down.get("rc"), "output": down.get("output", "")[-500:]})
        if egress_interface_live(ifname):
            return None, {
                "error": "egress_delete_interface_still_live",
                "egress": egress_id,
                "interface": ifname,
                "down_result": down,
                "message": "The channel interface is still up after the down command; registry/config deletion was not performed.",
            }

    registry_path = STATE_DIR / "egress.registry"
    if registry_path.exists():
        backup = registry_path.with_name(f"{registry_path.name}.backup.v7-egress-delete.{stamp}")
        shutil.copy2(registry_path, backup)
        backups.append(str(backup))
        lines = read_text(registry_path).splitlines()
        next_lines = [line for line in lines if not line.startswith(f"id={egress_id} ")]
        if next_lines != lines:
            write_text_atomic(registry_path, "\n".join(next_lines) + ("\n" if next_lines else ""), mode=registry_path.stat().st_mode & 0o777 or 0o600)
            changed.append(str(registry_path))

    flags_path = STATE_DIR / "egress-flags.state"
    if flags_path.exists():
        backup = flags_path.with_name(f"{flags_path.name}.backup.v7-egress-delete.{stamp}")
        shutil.copy2(flags_path, backup)
        backups.append(str(backup))
        lines = read_text(flags_path).splitlines()
        next_lines = [line for line in lines if not line.startswith(f"{egress_id}_")]
        if next_lines != lines:
            write_text_atomic(flags_path, "\n".join(next_lines) + ("\n" if next_lines else ""), mode=flags_path.stat().st_mode & 0o777 or 0o600)
            changed.append(str(flags_path))

    state_path = STATE_DIR / "v7-state.json"
    state_data = read_json(state_path, {})
    if isinstance(state_data.get("egress"), dict) and egress_id in state_data["egress"]:
        backup = state_path.with_name(f"{state_path.name}.backup.v7-egress-delete.{stamp}")
        shutil.copy2(state_path, backup)
        backups.append(str(backup))
        state_data["egress"].pop(egress_id, None)
        write_json_atomic(state_path, state_data)
        changed.append(str(state_path))

    for path in (SPEED_FILE, SERVICE_MATRIX_FILE, EGRESS_LABELS_FILE):
        if path.exists():
            backup = path.with_name(f"{path.name}.backup.v7-egress-delete.{stamp}")
            shutil.copy2(path, backup)
            if remove_json_items(path, egress_id):
                backups.append(str(backup))
                changed.append(str(path))

    org_policy = read_json(ORG_POLICY_FILE, {})
    if isinstance(org_policy.get("egress"), dict) and egress_id in org_policy["egress"]:
        backup = ORG_POLICY_FILE.with_name(f"{ORG_POLICY_FILE.name}.backup.v7-egress-delete.{stamp}")
        shutil.copy2(ORG_POLICY_FILE, backup)
        backups.append(str(backup))
        org_policy["egress"].pop(egress_id, None)
        write_json_atomic(ORG_POLICY_FILE, org_policy)
        changed.append(str(ORG_POLICY_FILE))

    candidate_paths = egress_runtime_profile_candidates(egress_id, registry)
    seen_paths = set()
    for candidate in candidate_paths:
        safe_path = egress_delete_safe_path(candidate)
        if not safe_path or str(safe_path) in seen_paths:
            continue
        seen_paths.add(str(safe_path))
        if not safe_path.exists():
            continue
        backup = safe_path.with_name(f"{safe_path.name}.backup.v7-egress-delete.{stamp}")
        shutil.copy2(safe_path, backup)
        backups.append(str(backup))
        try:
            safe_path.unlink()
            removed_files.append(str(safe_path))
            changed.append(str(safe_path))
        except OSError as exc:
            skipped_files.append({"path": str(safe_path), "error": str(exc)})

    if EGRESS_RUNTIME_DIR.exists():
        runtime_dir = (EGRESS_RUNTIME_DIR / egress_id).resolve()
        root = EGRESS_RUNTIME_DIR.resolve()
        if runtime_dir.exists() and (runtime_dir == root or root in runtime_dir.parents):
            backup = runtime_dir.with_name(f"{runtime_dir.name}.backup.v7-egress-delete.{stamp}")
            shutil.copytree(runtime_dir, backup)
            backups.append(str(backup))
            shutil.rmtree(runtime_dir)
            removed_files.append(str(runtime_dir))
            changed.append(str(runtime_dir))

    for meta_path in EGRESS_DRAFTS_DIR.glob("*/metadata.json") if EGRESS_DRAFTS_DIR.exists() else []:
        meta = read_json(meta_path, {})
        duplicate = meta.get("duplicate_of") or {}
        if meta.get("pool_egress_id") == egress_id or meta.get("id") == egress_id or duplicate.get("egress") == egress_id:
            backup = meta_path.with_name(f"{meta_path.name}.backup.v7-egress-delete.{stamp}")
            shutil.copy2(meta_path, backup)
            backups.append(str(backup))
            meta.update({
                "status": "channel_deleted",
                "pool_action": "deleted",
                "pool_egress_id": "",
                "deleted_egress_id": egress_id,
                "deleted_at": now_iso(),
                "deleted_by": actor or "admin",
                "next_step": "channel_removed",
            })
            write_json_atomic(meta_path, meta)
            changed.append(str(meta_path))

    return {
        "egress": egress_id,
        "status": "DELETED",
        "changed": changed,
        "backups": backups,
        "removed_files": removed_files,
        "skipped_files": skipped_files,
        "commands": commands,
        "users_moved": False,
        "assigned_users": 0,
    }, None


def egress_detail(egress_id):
    egress_id = safe_egress_id(egress_id)
    if not egress_id:
        return None

    state = read_json(STATE_DIR / "v7-state.json", {})
    state_egress = (state.get("egress") or {}).get(egress_id) or {}
    registry_rows = parse_registry(STATE_DIR / "egress.registry")
    registry = next((row for row in registry_rows if row.get("id") == egress_id), None)
    if not registry and not state_egress:
        return None

    users = parse_registry(STATE_DIR / "users.registry")
    assigned_users = [
        {
            "ip": row.get("ip"),
            "table": row.get("table"),
            "enabled": row.get("enabled", "1"),
        }
        for row in users
        if row.get("current") == egress_id
    ]

    config, config_error = egress_config_payload(egress_id)
    config_json = None
    if config and config.get("content") and str(config.get("path", "")).endswith(".json"):
        try:
            config_json = redact(json.loads(config["content"]))
        except Exception:
            config_json = None

    speed_items = (speed_state().get("items") or {})
    server_speed = speed_items.get(egress_id) or {}
    matrix_items = (service_matrix_state().get("items") or {})
    matrix = matrix_items.get(egress_id) or {}
    flags = read_state_kv(STATE_DIR / "egress-flags.state")
    client_data = client_speed_state()
    user_speed_rows = []
    v7_values = []
    direct_values = []

    for ip, user_data in (client_data.get("users") or {}).items():
        latest = user_data.get("latest") or {}
        latest_v7 = latest.get("v7") or {}
        latest_direct = (latest.get("direct") or {}).get(egress_id) or {}
        if latest_v7.get("egress") == egress_id and isinstance(latest_v7.get("mbps"), (int, float)):
            v7_values.append(float(latest_v7["mbps"]))
        if isinstance(latest_direct.get("mbps"), (int, float)):
            direct_values.append(float(latest_direct["mbps"]))
        history = [
            item for item in (user_data.get("history") or [])
            if item.get("egress") == egress_id
        ][-20:]
        if latest_v7.get("egress") == egress_id or latest_direct or history:
            degradation = None
            if isinstance(latest_v7.get("mbps"), (int, float)) and isinstance(latest_direct.get("mbps"), (int, float)) and float(latest_direct["mbps"]) > 0:
                degradation = round(max(0.0, (float(latest_direct["mbps"]) - float(latest_v7["mbps"])) / float(latest_direct["mbps"]) * 100), 1)
            user_speed_rows.append({
                "ip": ip,
                "latest_v7": latest_v7 if latest_v7.get("egress") == egress_id else {},
                "latest_direct": latest_direct,
                "degradation_pct": degradation,
                "history": history,
            })

    client_v7_avg = round(sum(v7_values) / len(v7_values), 2) if v7_values else None
    client_direct_avg = round(sum(direct_values) / len(direct_values), 2) if direct_values else None
    aggregate_degradation = None
    if client_v7_avg is not None and client_direct_avg and client_direct_avg > 0:
        aggregate_degradation = round(max(0.0, (client_direct_avg - client_v7_avg) / client_direct_avg * 100), 1)

    related_events = [
        event for event in normalized_events(source="all", limit=120, component="", action="", severity="", user_ip="").get("events", [])
        if event.get("object_id") == egress_id or f"egress={egress_id}" in str(event.get("message", "")) or f"id={egress_id}" in str(event.get("message", ""))
    ][:30]
    related_drafts = [
        row for row in egress_drafts_state().get("items", [])
        if row.get("pool_egress_id") == egress_id or row.get("id") == egress_id
    ][:8]

    return redact({
        "egress": egress_id,
        "label": egress_labels_state().get(egress_id, ""),
        "pool_state": flags.get(f"{egress_id}_state") or ("disabled" if registry and registry.get("enabled") == "0" else "enabled"),
        "runtime_readiness": egress_runtime_readiness(egress_id, registry or {}),
        "registry": registry or {},
        "state": state_egress,
        "assigned_users": assigned_users,
        "config": config,
        "config_error": config_error,
        "config_json": config_json,
        "server_speed": server_speed,
        "client_speed": {
            "fresh_seconds": CLIENT_SPEED_FRESH_SECONDS,
            "client_v7_avg_mbps": client_v7_avg,
            "client_direct_avg_mbps": client_direct_avg,
            "degradation_pct": aggregate_degradation,
            "users": user_speed_rows,
            "note": "Client samples are kept visible while fresh; current freshness window is 86400 seconds.",
        },
        "service_matrix": matrix,
        "events": related_events,
        "draft_lifecycle": related_drafts,
    })


