        "model": {
          "PREPARED": "Policy is staged for a higher class, but certified evidence has not caught up; runtime caps to certified authority.",
          "CERTIFIED": "Evidence supports the prepared class and runtime may use that class ceiling.",
          "CANARY_CERTIFIED": "Alias of CERTIFIED for the one-user governed authority floor.",
          "CANARY_EXPANSION": "A transitional bridge from certified CANARY to prepared SMALL_BATCH that permits only the next blast-radius step with explicit bridge evidence.",
          "PROVISIONAL_SMALL_BATCH": "A transitional bridge that allows the first bounded 2-user cohort without certifying SMALL_BATCH.",
          "SMALL_BATCH_CERTIFIED": "Alias of CERTIFIED for completed SMALL_BATCH evidence.",
          "PROMOTED": "A certified class has been explicitly promoted after required outcomes, rollback, verification, and closure evidence.",
          "DEMOTED": "Runtime authority is intentionally below available certification because risk or operator policy reduced scope.",
          "FROZEN": "Runtime authority is temporarily zero because truth, evidence, snapshot, trust, prediction, or governance state is unknown.",
          "REVOKED": "Runtime authority is zero until a fresh operator governance program reinstates it."
        },
        "bridge_model": {
          "schema_version": "v7.authority-transition-bridge-model.v1",
          "purpose": "break_canary_to_small_batch_deadlock_without_certifying_small_batch",
          "states": {
            "CANARY_CERTIFIED": {
              "budget": 1,
              "entry_criteria": [
                "one_successful_governed_user",
                "verification",
                "rollback_readiness",
                "outcome_closure"
              ],
              "exit_criteria": [
                "explicit_operator_bridge_request",
                "fresh_restore_barrier",
                "snapshot_gate_clean"
              ]
            },
            "CANARY_EXPANSION": {
              "budget": 2,
              "entry_criteria": [
                "CANARY_CERTIFIED",
