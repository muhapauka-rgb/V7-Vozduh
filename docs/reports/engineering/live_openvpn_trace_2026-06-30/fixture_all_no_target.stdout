            "requires_verification": true,
            "requires_outcome_closure": true
          },
          "SMALL_BATCH": {
            "required_successful_governed_users": 2,
            "requires_prior_canary_certification": true,
            "requires_atomic_execution_envelope": true,
            "requires_no_snapshot_source_mismatch": true,
            "requires_outcome_feedback": true
          },
          "MEDIUM_BATCH": {
