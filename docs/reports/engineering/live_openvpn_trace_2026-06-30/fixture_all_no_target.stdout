                "certified_authority_class_CANARY"
              ],
              "exit_criteria": [
                "2_user_execution_verified",
                "outcome_feedback_materialized"
              ],
              "promotion_certification": false
            },
            "PROVISIONAL_SMALL_BATCH": {
              "budget": 2,
              "entry_criteria": [
                "CANARY_EXPANSION_ready",
                "operator_approval_packet",
                "rollback_manifest_ready"
              ],
              "exit_criteria": [
                "successful_2_user_governed_execution",
                "trust_prediction_recommendation_feedback"
              ],
              "promotion_certification": false
            },
            "SMALL_BATCH_CERTIFIED": {
