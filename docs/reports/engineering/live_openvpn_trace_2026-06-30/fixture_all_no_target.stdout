              "entry_criteria": [
                "successful_2_user_governed_execution",
                "verification",
                "outcome_feedback",
                "no_snapshot_mismatch"
              ],
              "exit_criteria": [
                "operator_promoted_next_authority_class"
              ],
              "promotion_certification": true
            }
          },
          "new_truth_sources_created": false,
          "duplicate_systems_created": false
        },
        "certification_rules": {
          "CANARY": {
            "required_successful_governed_users": 1,
