#!/usr/bin/env bash
set -euo pipefail

VPN_SUBNETS="${V7_VPN_SUBNETS:-${V7_VPN_SUBNET:-10.0.0.0/24,10.7.0.0/22}}"
PUBLIC_IF="ens3"
PUBLIC_GW="195.2.79.1"
DIRECT_MARK="0x77"
DIRECT_TABLE="70"
DIRECT_RULE_PREF="50"
STATE_DIR="${V7_STATE_DIR:-/opt/v7/egress/state}"
EGRESS_REG="${V7_EGRESS_REGISTRY:-$STATE_DIR/egress.registry}"
EGRESS_IFS=()

command -v nft >/dev/null || { echo "ERROR: nft not found" >&2; exit 1; }
command -v ip >/dev/null || { echo "ERROR: ip not found" >&2; exit 1; }

if [ -r "$EGRESS_REG" ]; then
  while read -r ifname; do
    [ -n "$ifname" ] || continue
    [[ "$ifname" =~ ^[A-Za-z0-9_.-]{1,15}$ ]] || continue
    [ -e "/sys/class/net/$ifname" ] || continue
    EGRESS_IFS+=("$ifname")
  done < <(awk '
    {
      enabled="1"; iface="";
      for (i=1; i<=NF; i++) {
        split($i, a, "=");
        if (a[1] == "enabled") enabled=a[2];
        if (a[1] == "interface") iface=a[2];
      }
      if (enabled == "1" && iface != "") print iface;
    }
  ' "$EGRESS_REG" | sort -u)
fi
if [ "${#EGRESS_IFS[@]}" -eq 0 ]; then
  EGRESS_IFS=("awg2" "tun0")
fi

IFS=',' read -r -a VPN_SUBNET_ARR <<< "$VPN_SUBNETS"
VPN_SUBNET_ELEMENTS=""
for subnet in "${VPN_SUBNET_ARR[@]}"; do
  subnet="${subnet//[[:space:]]/}"
  [ -n "$subnet" ] || continue
  if ! ip -4 route show "$subnet" 2>/dev/null | grep -q ' dev wg0 '; then
    ip -4 route replace "$subnet" dev wg0 scope link
  fi
  if [ -z "$VPN_SUBNET_ELEMENTS" ]; then
    VPN_SUBNET_ELEMENTS="$subnet"
  else
    VPN_SUBNET_ELEMENTS="$VPN_SUBNET_ELEMENTS, $subnet"
  fi
done
[ -n "$VPN_SUBNET_ELEMENTS" ] || { echo "ERROR: no VPN subnets configured" >&2; exit 1; }

ip -4 rule del pref "$DIRECT_RULE_PREF" 2>/dev/null || true
ip -4 route flush table "$DIRECT_TABLE" 2>/dev/null || true
ip -4 route replace default via "$PUBLIC_GW" dev "$PUBLIC_IF" table "$DIRECT_TABLE"
ip -4 rule add pref "$DIRECT_RULE_PREF" fwmark "$DIRECT_MARK" lookup "$DIRECT_TABLE"

NFT_EGRESS_RULES=""
for ifname in "${EGRESS_IFS[@]}"; do
  NFT_EGRESS_RULES="${NFT_EGRESS_RULES}
add rule inet v7_killswitch postrouting ip saddr @v7_client_src oifname \"$ifname\" counter masquerade comment \"V7 NAT users via $ifname\"
add rule inet v7_killswitch forward ip saddr @v7_client_src oifname \"$ifname\" tcp flags syn tcp option maxseg size set rt mtu counter comment \"V7 MSS clamp users via $ifname\"
add rule inet v7_killswitch forward ip saddr @v7_client_src oifname \"$ifname\" counter accept comment \"V7 allow users via $ifname\""
done

nft delete table inet v7_killswitch 2>/dev/null || true
nft -f - <<NFT
add table inet v7_killswitch
add set inet v7_killswitch v7_client_src { type ipv4_addr; flags interval; comment "V7 VPN client source networks"; elements = { $VPN_SUBNET_ELEMENTS }; }
add set inet v7_killswitch v7_direct_dst { type ipv4_addr; flags interval; timeout 6h; comment "V7 direct whitelist destination IPs"; }
add set inet v7_killswitch v7_direct_exclude_dst { type ipv4_addr; flags interval; timeout 6h; comment "V7 direct exclusion destination IPs"; }
add chain inet v7_killswitch prerouting { type filter hook prerouting priority mangle; policy accept; comment "V7 direct destination marker"; }
add chain inet v7_killswitch dstnat { type nat hook prerouting priority dstnat; policy accept; comment "V7 DNS capture for VPN clients"; }
add chain inet v7_killswitch postrouting { type nat hook postrouting priority srcnat; policy accept; comment "V7 egress NAT for VPN clients"; }
add chain inet v7_killswitch forward { type filter hook forward priority -50; policy accept; comment "V7 user traffic leak guard"; }
add rule inet v7_killswitch prerouting ip saddr @v7_client_src ip daddr @v7_direct_dst ip daddr != @v7_direct_exclude_dst meta mark set $DIRECT_MARK counter comment "V7 mark explicit direct whitelist"
add rule inet v7_killswitch dstnat iifname "wg0" ip saddr @v7_client_src udp dport 53 counter dnat ip to 10.0.0.1 comment "V7 capture client UDP DNS"
add rule inet v7_killswitch dstnat iifname "wg0" ip saddr @v7_client_src tcp dport 53 counter dnat ip to 10.0.0.1 comment "V7 capture client TCP DNS"
$NFT_EGRESS_RULES
add rule inet v7_killswitch forward ip saddr @v7_client_src oifname "$PUBLIC_IF" ip daddr @v7_direct_dst ip daddr != @v7_direct_exclude_dst counter accept comment "V7 allow explicit direct whitelist"
add rule inet v7_killswitch forward ip saddr @v7_client_src oifname "$PUBLIC_IF" counter drop comment "V7 block direct leak to public interface"
NFT

if command -v v7-audit-log >/dev/null 2>&1; then
  v7-audit-log "killswitch_enable" "killswitch" "public_if=$PUBLIC_IF vpn_subnets=$VPN_SUBNETS direct_mark=$DIRECT_MARK direct_table=$DIRECT_TABLE direct_rule_pref=$DIRECT_RULE_PREF" >/dev/null 2>&1 || true
fi

echo "V7_KILLSWITCH_ENABLE=OK"
echo "vpn_subnets=$VPN_SUBNETS"
echo "direct_mark=$DIRECT_MARK"
echo "direct_table=$DIRECT_TABLE"
echo "direct_rule_pref=$DIRECT_RULE_PREF"
echo "egress_ifs=${EGRESS_IFS[*]}"
ip -4 rule show pref "$DIRECT_RULE_PREF"
ip -4 route show table "$DIRECT_TABLE"
nft list table inet v7_killswitch
