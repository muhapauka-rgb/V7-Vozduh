[Unit]
Description=V7 autoswitch planner state refresh
Wants=network-online.target
After=network-online.target v7-health.service v7-benchmark.service

[Service]
Type=oneshot
Environment=V7_ACTOR=autoswitch-planner
# The fast sentinel writes canonical Matrix events.  Consume only those
# existing events first; this performs no network probe and can enter the
# governed path only through the already active standing-policy gates.
# The Runtime consumer may invoke only the existing Matrix/current-scope and
# governed Packet/lease/barrier path. OMP, reports and certification tails are
# Engineering/controlled-owner work and are explicitly outside this process.
ExecStart=/usr/local/bin/v7-service-matrix-refresh-all --consume-existing-service-failure-events-only --runtime-hot-path-only
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
