[Unit]
Description=V7 health and state summary loop
Wants=network-online.target
After=network-online.target v7-routing-sync.service

[Service]
Type=simple
Environment=V7_ACTOR=health
ExecStart=/usr/local/bin/v7-health-loop
Restart=always
RestartSec=5
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
