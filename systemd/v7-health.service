[Unit]
Description=V7 health and state summary loop
Wants=network-online.target
After=network-online.target v7-routing-sync.service

[Service]
Type=simple
Environment=V7_ACTOR=health
ExecStartPre=/usr/local/bin/v7-service-matrix-refresh-all --initialize-standing-lineage-only
ExecStart=/usr/local/bin/v7-health-loop --role-based-fast
Restart=always
RestartSec=5
# The parent is a tiny deadline/preemption loop. Child processes retain their
# prior effective nice levels explicitly in v7-health-loop, while the parent
# must be schedulable promptly enough to stop disposable work at confirmed T0.
Nice=0
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
