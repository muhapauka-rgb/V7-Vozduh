def canonical_service_failure_t0_ns(
    matrix_state_file: Path,
    users_registry_file: Path = DEFAULT_USERS_REGISTRY_FILE,
    service_id: str = "__channel_liveness__",
    required_evidence_class: str = "",
) -> int:
    """Read one current Matrix service failure and unresolved assignment.

    Process duration alone is not incident evidence: on a busy two-core host a
    healthy HARD observation can cross the scheduling discriminator and used
    to kill the Planner projection which the next real incident needed.  Only
    Matrix may establish the failure.  The existing users registry then proves
    whether an enabled client still needs recovery from that exact source.
    Once the last affected assignment has moved, the failed source may remain
    down but it no longer owns the recovery deadline, so background readiness
    work must resume.  A registry read failure keeps the previous fail-safe
    priority.  This reader persists nothing and creates no scheduler or health
    state.
    """
    try:
        payload = json.loads(matrix_state_file.read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        return 0
    items = payload.get("items") if isinstance(payload, dict) else {}
    if not isinstance(items, dict):
        return 0
    # The persistent consumer may be restarted independently from Matrix.  A
    # historical failed row can therefore otherwise look "new" to its
    # process-local exact-once cursor and preempt the real detector for a
    # full governed attempt.  A route-recovery wake needs fresh Matrix
    # evidence; stale rows remain visible to Matrix/history, but cannot be
    # re-consumed as a current incident after a health-owner restart.
    max_observation_age_seconds = 10
    now_epoch = time.time()

    def has_current_observation(
        source: dict[str, Any], service: dict[str, Any],
    ) -> bool:
        stamp = str(
            service.get("observed_at")
            or service.get("tested_at")
            or source.get("checked_at")
            or source.get("updated")
            or ""
        )
        # Older controlled fixtures can carry only monotonic evidence.  Keep
        # their existing compatibility contract, while production rows always
        # supply an ISO observation timestamp and are freshness-bound here.
        if not stamp:
            return True
        try:
            observed_epoch = datetime.fromisoformat(
                stamp.replace("Z", "+00:00")
            ).timestamp()
        except (TypeError, ValueError, OverflowError):
            return False
        age = now_epoch - observed_epoch
        return 0 <= age <= max_observation_age_seconds

    failed_sources: dict[str, int] = {}
    for source_id, source in items.items():
        if not isinstance(source, dict):
            continue
        services = source.get("services")
        services = services if isinstance(services, dict) else {}
        service = services.get(service_id)
        if not isinstance(service, dict):
            continue
        if (
            service.get("ok") is False
            and has_current_observation(source, service)
            and (
                not required_evidence_class
                or str(service.get("evidence_class") or "")
                == required_evidence_class
            )
            and str(service.get("failure_state") or "").startswith(
                "OBSERVED_"
            )
            and str(service.get("source_incident_id") or "")
            and str(service.get("failure_event_id") or "")
        ):
            try:
                t0_ns = int(str(service.get("confirmed_hard_failure_monotonic_ns") or "0"))
            except (TypeError, ValueError):
                t0_ns = 0
            # Older canonical rows can still admit recovery priority, but are
            # deliberately not eligible for the persistent handoff: a fresh
            # Matrix-owned monotonic T0 is required for this exact transaction.
            if t0_ns > 0:
                failed_sources[str(source_id)] = t0_ns
    # A channel can remain locally UP while its application path is unusable
    # (for example a proxy process accepts the interface but every ordinary
    # service probe fails).  The existing Matrix owner already records that
    # evidence, and ``tools/v7-users-autoswitch`` applies the same majority
    # predicate when building the affected scope.  Feed that exact current
    # Matrix generation into the already-existing persistent consumer; do not
    # create a second probe, event store, timer or health owner here.
    if not failed_sources and service_id == "__channel_liveness__":
        for source_id, source in items.items():
            if not isinstance(source, dict):
                continue
            checked_at = str(source.get("checked_at") or source.get("updated") or "")
            try:
                checked_epoch = datetime.fromisoformat(
                    checked_at.replace("Z", "+00:00")
                ).timestamp()
            except (TypeError, ValueError, OverflowError):
                continue
            age = now_epoch - checked_epoch
            if age < 0 or age > max_observation_age_seconds:
                continue
            services = source.get("services")
            if not isinstance(services, dict):
                continue
            service_rows = [
                row for key, row in services.items()
                if key != "__channel_liveness__" and isinstance(row, dict)
            ]
            if not service_rows:
                continue
            failed_rows = [
                row for row in service_rows
                if row.get("ok") is False
                or str(row.get("status") or "").upper() in {"FAIL", "DOWN", "ERROR"}
            ]
            threshold = max(2, (len(service_rows) + 1) // 2)
            if len(failed_rows) < threshold:
                continue
            # The majority used for the wake must carry Matrix's immutable
            # incident identity.  New/transitioning service rows may still be
            # missing an episode id in the same generation; they are simply
            # excluded from the credited quorum rather than making the whole
            # source unknown or allowing an unidentified failure to wake a
            # route action.
            identified_failed_rows = [
                row for row in failed_rows
                if str(row.get("source_incident_id") or "")
                and str(row.get("failure_event_id") or "")
            ]
            if len(identified_failed_rows) < threshold:
                continue
            t0_values = []
            for row in identified_failed_rows:
                try:
                    value = int(str(
                        row.get("confirmed_hard_failure_monotonic_ns")
                        or row.get("observation_monotonic_ns")
                        or "0"
                    ))
                except (TypeError, ValueError):
                    value = 0
                if value > 0:
                    t0_values.append(value)
            if t0_values:
                failed_sources[str(source_id)] = max(t0_values)
    if not failed_sources:
        return 0

    try:
        rows = users_registry_file.read_text(encoding="utf-8").splitlines()
    except OSError:
        return max(failed_sources.values())
    assigned_t0s: list[int] = []
    for line in rows:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        row = {}
        for token in stripped.split():
            key, separator, value = token.partition("=")
            if separator:
                row[key] = value
        if str(row.get("enabled", "1")).lower() in {
            "0", "false", "no", "off", "disabled",
        }:
            continue
        source_id = str(row.get("current") or "")
        if source_id in failed_sources:
            assigned_t0s.append(failed_sources[source_id])

    # The persistent consumer has one process-local de-duplication cursor,
    # while Matrix can hold several independent current failures.  Registry
    # order is not an incident ordering law: returning the first matching
    # source could therefore hide a newer T0 behind an older unresolved
    # source and suppress the only Runtime wake for that newer incident.
    # Matrix still re-reads and admits the complete current scope; this value
    # only selects the freshest exact Matrix-owned wake for the existing
    # health owner.
    return max(assigned_t0s, default=0)


def canonical_definitive_hard_failure_t0_ns(
    matrix_state_file: Path,
    users_registry_file: Path = DEFAULT_USERS_REGISTRY_FILE,
) -> int:
    """Compatibility wrapper for the Matrix-owned HARD incident predicate."""
    return canonical_service_failure_t0_ns(
        matrix_state_file,
        users_registry_file,
        "__channel_liveness__",
        "DEFINITIVE_LOCAL_HARD_FAILURE",
    )


def canonical_profile_service_failure_binding(
    matrix_state_file: Path,
    users_registry_file: Path = DEFAULT_USERS_REGISTRY_FILE,
    service_preferences_file: Path = DEFAULT_SERVICE_PREFERENCES_FILE,
) -> dict[str, Any]:
    """Return the exact current profile-required failure binding.

    The ordinary detector is profile-scoped: a source need not lose a majority
    of its complete catalog before one user's required service has failed. This
    reader joins only existing Matrix, users-registry and preferences owners.
    It creates no incident, target, operation or state, and requires Matrix's
    incident identity before the existing health consumer may proceed.  The
    compact binding identity makes a *newly affected* profile visible even if
    the source incident started before that user was assigned there.
    """
    bindings = canonical_profile_service_failure_bindings(
        matrix_state_file,
        users_registry_file,
        service_preferences_file,
    )
    if not bindings:
        return {}
    affected_profile_count = sum(
        int(binding.get("affected_profile_count") or 0)
        for binding in bindings
    )
    canonical = json.dumps([
        str(binding.get("dedupe_identity") or "") for binding in bindings
    ], separators=(",", ":"))
    result = {
        "t0_ns": max(int(binding.get("t0_ns") or 0) for binding in bindings),
        "dedupe_identity": hashlib.sha256(canonical.encode("utf-8")).hexdigest(),
        "affected_profile_count": affected_profile_count,
    }
    # Preserve the narrow compatibility contract.  The live health owner uses
    # the per-source reader below: when several incidents are current, one
    # aggregate wake must not silently select an unrelated newer source.
    if len(bindings) == 1:
        result["source_egress"] = str(bindings[0]["source_egress"])
    return result


def prepared_reentry_invalidator_fingerprint(
    matrix_summary_file: Path,
) -> str:
    """Return the current existing-owner blocker generation, if available.

    A profile failure binding describes *what is broken*.  The prepared Matrix
    projection separately owns the generations that describe whether that
    failure can currently be acted on: target health/topology, capacity,
    Authority/policy and an overlapping operation.  Reuse those generations
    rather than treating one STOP_SAFE receipt as permanent history or
    creating a health-loop blocker registry.

    This is intentionally a compact read-only projection.  It excludes
    observation timestamps and advisory ranking so an unchanged continuing
    incident cannot re-enter just because a probe was refreshed.
    """
    try:
        summary = json.loads(matrix_summary_file.read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        return ""
    if not isinstance(summary, dict):
        return ""
    prepared = summary.get("prepared_class_decisions")
    freshness = summary.get("prepared_class_decision_freshness")
    if not isinstance(prepared, dict) or not isinstance(freshness, dict):
        return ""
    invalidators = prepared.get("invalidators")
    if not isinstance(invalidators, dict):
        return ""
    selected_invalidators = {
        key: str(invalidators.get(key) or "")
        for key in PREPARED_REENTRY_INVALIDATOR_KEYS
    }
    if not any(selected_invalidators.values()):
        return ""
    fact_freshness = freshness.get("fact_specific_freshness")
    fact_freshness = fact_freshness if isinstance(fact_freshness, dict) else {}
    selected_freshness = {
        key: bool(value.get("fresh"))
        for key, value in sorted(fact_freshness.items())
        if isinstance(value, dict)
        and key in {
            "capacity",
            "identity_and_role",
            "other_required_service",
            "path_liveness",
            "policy",
            "telegram_required_service",
        }
    }
    payload = {
        "invalidators": selected_invalidators,
        "freshness": selected_freshness,
        "prepared_status": str(prepared.get("status") or ""),
        "freshness_status": str(freshness.get("status") or ""),
        "invalidation_reasons": sorted(
            str(value)
            for value in (freshness.get("invalidation_reasons") or [])
            if str(value)
        ),
    }
    canonical = json.dumps(payload, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def canonical_profile_service_failure_bindings(
    matrix_state_file: Path,
    users_registry_file: Path = DEFAULT_USERS_REGISTRY_FILE,
    service_preferences_file: Path = DEFAULT_SERVICE_PREFERENCES_FILE,
    matrix_summary_file: Path | None = None,
) -> list[dict[str, Any]]:
    """Return one exact current profile-required binding per failed source.

    Several sources can fail at once. Collapsing them into one newest-T0
    binding made the health consumer pass a stale/absent source constraint,
    after which Matrix could choose a different incident. These compact rows
    remain a read-only join of the existing Matrix, registry and preference
    owners; they only drive independent exact-once wakes of existing Matrix.
    """
    try:
        matrix = json.loads(matrix_state_file.read_text(encoding="utf-8"))
        preferences = json.loads(service_preferences_file.read_text(encoding="utf-8"))
        registry_lines = users_registry_file.read_text(encoding="utf-8").splitlines()
    except (OSError, ValueError, TypeError):
        return []
    items = matrix.get("items") if isinstance(matrix, dict) else {}
    users = preferences.get("users") if isinstance(preferences, dict) else {}
    if not isinstance(items, dict) or not isinstance(users, dict):
        return []
    # This handoff is the live ordinary-recovery wake, not a historical
    # incident reconciler.  A past ``OBSERVED_*`` row must stay visible in
    # Matrix, but may not repeatedly start the governed executor after the
    # affected service has recovered or a user was later assigned elsewhere.
    # The Matrix/Planner path applies the same ten-second live-evidence bound
    # before admitting a move.  Keep this producer aligned with that law so a
    # stale row cannot monopolise the 5 s service role and delay a new event.
    max_observation_age_seconds = 10
    now_epoch = time.time()

    def has_current_observation(observed: dict[str, Any]) -> bool:
        stamp = str(observed.get("observed_at") or observed.get("tested_at") or "")
        # Isolated legacy/Polygon fixtures may have only monotonic T0.  The
        # production Matrix always has an ISO timestamp, which is where this
        # freshness law is enforceable.
        if not stamp:
            return True
        try:
            observed_epoch = datetime.fromisoformat(
                stamp.replace("Z", "+00:00")
            ).timestamp()
        except (TypeError, ValueError, OverflowError):
            return False
        age = now_epoch - observed_epoch
        return 0 <= age <= max_observation_age_seconds

    t0_values: list[int] = []
    affected: list[dict[str, Any]] = []
    for line in registry_lines:
        row: dict[str, str] = {}
        for token in line.strip().split():
            key, separator, value = token.partition("=")
            if separator:
                row[key] = value
        if not row or str(row.get("enabled", "1")).lower() in {
            "0", "false", "no", "off", "disabled",
        }:
            continue
        user_id = str(row.get("ip") or "")
        source_id = str(row.get("current") or "")
        preference = users.get(user_id)
        required = preference.get("services") if isinstance(preference, dict) else []
        if not isinstance(required, list) or not source_id:
            continue
        source = items.get(source_id)
        services = source.get("services") if isinstance(source, dict) else {}
        if not isinstance(services, dict):
            continue
        for service_id in required:
            observed = services.get(str(service_id))
            if not isinstance(observed, dict):
                continue
            failed = (
                observed.get("ok") is False
                or str(observed.get("status") or "").upper() in {"FAIL", "DOWN", "ERROR"}
            )
            if not failed or not str(observed.get("failure_state") or "").startswith("OBSERVED_"):
                continue
            if not str(observed.get("source_incident_id") or "") or not str(observed.get("failure_event_id") or ""):
                continue
            if not has_current_observation(observed):
                continue
            # Keep the immutable incident time for Matrix/history, but use
            # the newest owner-backed observation as the dispatch clock.  A
            # user may be placed on a source whose incident is already open;
            # charging that newly affected user to the old incident start
            # creates a fictitious multi-minute recovery interval.  The
            # stable identity below still prevents this continuing incident
            # from being re-consumed on every Matrix observation.
            try:
                incident_t0_ns = int(str(
                    observed.get("confirmed_hard_failure_monotonic_ns")
                    or observed.get("first_failed_observation_monotonic_ns")
                    or observed.get("observation_monotonic_ns")
                    or "0"
                ))
                dispatch_t0_ns = int(str(
                    observed.get("observation_monotonic_ns")
                    or incident_t0_ns
                    or "0"
                ))
            except (TypeError, ValueError):
                incident_t0_ns = 0
                dispatch_t0_ns = 0
            if dispatch_t0_ns > 0:
                t0_values.append(dispatch_t0_ns)
                affected.append({
                    "source": source_id,
                    "user_ip": user_id,
                    "service": str(service_id),
                    "source_incident_id": str(observed.get("source_incident_id") or ""),
                    # ``failure_event_id`` is a per-observation evidence
                    # record and legitimately rotates during one continuing
                    # Matrix incident.  Preserve it for diagnostics, but do
                    # not make it part of the health consumer's exact-once
                    # identity or it repeatedly monopolises the live
                    # recovery slot.
                    "failure_event_id": str(observed.get("failure_event_id") or ""),
                    "incident_t0_ns": incident_t0_ns,
                    "t0_ns": dispatch_t0_ns,
                })
    by_source: dict[str, list[dict[str, Any]]] = {}
    for row in affected:
        by_source.setdefault(str(row["source"]), []).append(row)
    summary_file = matrix_summary_file or (
        matrix_state_file.parent / "service-matrix-refresh-summary.json"
    )
    reentry_invalidator = prepared_reentry_invalidator_fingerprint(summary_file)
    result: list[dict[str, Any]] = []
    for source, source_rows in sorted(by_source.items()):
        # Do not serialize evolving evidence timestamps/event ids into the
        # exact-once key.  The durable Matrix incident plus the currently
        # affected profile/service set is the recovery identity; individual
        # observations are only the dispatch clock and diagnostics.
        stable_rows = [{
            key: row.get(key)
            for key in ("user_ip", "service", "source_incident_id")
        } for row in source_rows]
        failure_scope = sorted(
            stable_rows,
            key=lambda row: (
                str(row.get("user_ip") or ""),
                str(row.get("service") or ""),
                str(row.get("source_incident_id") or ""),
            ),
        )
        canonical = json.dumps({
            "failure_scope": failure_scope,
            # Empty is the deliberate compatibility value for old Polygon
            # fixtures which contain no prepared Matrix projection.  Runtime
            # always supplies the projection from the existing Matrix owner.
            "reentry_invalidator": reentry_invalidator,
        }, separators=(",", ":"), sort_keys=True)
        result.append({
            "source_egress": source,
            "t0_ns": max(int(row.get("t0_ns") or 0) for row in source_rows),
            "incident_t0_ns": max(
                int(row.get("incident_t0_ns") or 0) for row in source_rows
            ),
            "dedupe_identity": hashlib.sha256(canonical.encode("utf-8")).hexdigest(),
            "reentry_invalidator_fingerprint": reentry_invalidator,
            "affected_profile_count": len({str(row["user_ip"]) for row in source_rows}),
        })
    return result


def canonical_profile_service_failure_t0_ns(
    matrix_state_file: Path,
    users_registry_file: Path = DEFAULT_USERS_REGISTRY_FILE,
    service_preferences_file: Path = DEFAULT_SERVICE_PREFERENCES_FILE,
) -> int:
    """Compatibility reader for callers that only need Matrix T0."""
    return int(canonical_profile_service_failure_binding(
        matrix_state_file,
        users_registry_file,
        service_preferences_file,
    ).get("t0_ns") or 0)


def canonical_definitive_hard_failure_active(
    matrix_state_file: Path,
    users_registry_file: Path = DEFAULT_USERS_REGISTRY_FILE,
) -> bool:
    """Preserve the original Matrix admission predicate for priority only.

    The persistent handoff additionally needs a fresh monotonic T0, but an
    older valid Matrix incident must retain its historical safety priority.
    """
    try:
        payload = json.loads(matrix_state_file.read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        return False
    items = payload.get("items") if isinstance(payload, dict) else {}
    if not isinstance(items, dict):
        return False
    failed_sources: set[str] = set()
    for source_id, source in items.items():
        if not isinstance(source, dict):
            continue
        services = source.get("services")
        services = services if isinstance(services, dict) else {}
        liveness = services.get("__channel_liveness__")
        if (
            isinstance(liveness, dict)
            and liveness.get("ok") is False
            and str(liveness.get("evidence_class") or "")
            == "DEFINITIVE_LOCAL_HARD_FAILURE"
            and str(liveness.get("failure_state") or "").startswith("OBSERVED_")
            and str(liveness.get("source_incident_id") or "")
            and str(liveness.get("failure_event_id") or "")
        ):
            failed_sources.add(str(source_id))
    if not failed_sources:
        return False
    try:
        rows = users_registry_file.read_text(encoding="utf-8").splitlines()
    except OSError:
        return True
    for line in rows:
        row = {
            key: value for token in line.strip().split()
            for key, separator, value in [token.partition("=")]
            if separator
        }
        if not row or str(row.get("enabled", "1")).lower() in {
            "0", "false", "no", "off", "disabled",
        }:
            continue
        if str(row.get("current") or "") in failed_sources:
            return True
    return False


def monotonic_ns() -> int:
    return time.monotonic_ns()


def elapsed_ms(start_ns: int, end_ns: int) -> int:
    return max(0, (end_ns - start_ns) // 1_000_000)


def _scheduler_observation() -> dict[str, int]:
    """Read process-local Linux scheduler counters for timing evidence only."""
    try:
        parts = Path("/proc/self/schedstat").read_text(encoding="utf-8").split()
        return {
            "run_time_ns": int(parts[0]),
            "runqueue_wait_ns": int(parts[1]),
            "timeslices": int(parts[2]),
        }
    except (OSError, ValueError, IndexError):
        return {}


def health_runtime_observation() -> dict[str, Any]:
    """Capture no-state process counters for one existing HARD role."""
    usage = resource.getrusage(resource.RUSAGE_SELF)
    try:
        load = [round(float(value), 3) for value in os.getloadavg()]
    except (AttributeError, OSError, ValueError):
        load = []
    return {
        "pid": os.getpid(),
        "user_cpu_us": int(float(usage.ru_utime) * 1_000_000),
        "system_cpu_us": int(float(usage.ru_stime) * 1_000_000),
        "voluntary_context_switches": int(usage.ru_nvcsw),
        "involuntary_context_switches": int(usage.ru_nivcsw),
        "load_average": load,
        "scheduler": _scheduler_observation(),
    }


def health_runtime_observation_delta(
    started: dict[str, Any], completed: dict[str, Any],
) -> dict[str, Any]:
    """Project a bounded delta; unknown procfs data remains unknown."""
    before = started if isinstance(started, dict) else {}
    after = completed if isinstance(completed, dict) else {}
    before_scheduler = before.get("scheduler") if isinstance(before.get("scheduler"), dict) else {}
    after_scheduler = after.get("scheduler") if isinstance(after.get("scheduler"), dict) else {}
    return {
        "health_owner_pid": int(after.get("pid") or os.getpid()),
        "process_cpu_ms": round(
            max(0, int(after.get("user_cpu_us") or 0) - int(before.get("user_cpu_us") or 0)
            + int(after.get("system_cpu_us") or 0) - int(before.get("system_cpu_us") or 0)) / 1000.0,
            3,
        ),
        "scheduler_run_time_ms": round(
            max(0, int(after_scheduler.get("run_time_ns") or 0) - int(before_scheduler.get("run_time_ns") or 0)) / 1_000_000.0,
            3,
        ) if before_scheduler and after_scheduler else None,
        "scheduler_runqueue_wait_ms": round(
            max(0, int(after_scheduler.get("runqueue_wait_ns") or 0) - int(before_scheduler.get("runqueue_wait_ns") or 0)) / 1_000_000.0,
            3,
        ) if before_scheduler and after_scheduler else None,
        "voluntary_context_switches": max(
            0, int(after.get("voluntary_context_switches") or 0) - int(before.get("voluntary_context_switches") or 0),
        ),
        "involuntary_context_switches": max(
            0, int(after.get("involuntary_context_switches") or 0) - int(before.get("involuntary_context_switches") or 0),
        ),
        "load_average_start": before.get("load_average") or [],
        "load_average_end": after.get("load_average") or [],
        "diagnostic_only": True,
    }


def terminate_process_group(process: subprocess.Popen[bytes]) -> None:
    """Terminate a bounded legacy child and every child it spawned."""
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()


def run_command(command: Sequence[str], timeout_ms: int | None = None) -> tuple[str, int]:
    process = subprocess.Popen(
        list(command), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    try:
        rc = process.wait(None if timeout_ms is None else max(0.001, timeout_ms / 1000))
    except subprocess.TimeoutExpired:
        terminate_process_group(process)
        return "TIMEOUT", 0
    return "COMPLETED", rc


@dataclass
class HealthLoop:
    interval_ns: int
    legacy_guard_ns: int
    max_phases: int
    fast_command: tuple[str, ...]
    legacy_commands: tuple[tuple[str, str], ...]
    legacy_cursor: int = 0

    def run_fast(self) -> int:
        _, rc = run_command(self.fast_command)
        return rc

    def run_legacy_until(self, deadline_ns: int) -> None:
        """Spend only the current phase's remaining budget on legacy work."""
        count = len(self.legacy_commands)
        for _ in range(count):
            remaining_ns = deadline_ns - monotonic_ns()
            if remaining_ns <= self.legacy_guard_ns:
                return
            budget_ms = (remaining_ns - self.legacy_guard_ns) // 1_000_000
            if budget_ms <= 0:
                return
            label, command = self.legacy_commands[self.legacy_cursor]
            self.legacy_cursor = (self.legacy_cursor + 1) % count
            status, rc = run_command((command,), int(budget_ms))
            if status == "TIMEOUT":
                print(f"V7_HEALTH_LEGACY_DEFERRED label={label} reason=DEADLINE_BUDGET_EXHAUSTED budget_ms={budget_ms}", flush=True)
            elif rc == 0:
                print(f"V7_HEALTH_LEGACY_COMPLETED label={label} budget_ms={budget_ms}", flush=True)
            else:
                print(f"V7_HEALTH_LEGACY_FAILED label={label} rc={rc} budget_ms={budget_ms}", flush=True)

    def run(self) -> int:
        planned_start_ns = monotonic_ns()
        previous_actual_start_ns: int | None = None
        phase = 0
        while True:
            wait_ns = planned_start_ns - monotonic_ns()
            if wait_ns > 0:
                time.sleep(wait_ns / 1_000_000_000)
            actual_start_ns = monotonic_ns()
            phase += 1
            fast_rc = self.run_fast()
            finish_ns = monotonic_ns()
            intended_next_ns = planned_start_ns + self.interval_ns
            jitter_ms = elapsed_ms(planned_start_ns, actual_start_ns)
            start_to_start_ms = 0 if previous_actual_start_ns is None else elapsed_ms(previous_actual_start_ns, actual_start_ns)
            overrun_ms = max(0, elapsed_ms(intended_next_ns, finish_ns))
            print(
                "V7_HEALTH_FAST_PHASE "
                f"phase={phase} planned_start_ns={planned_start_ns} actual_start_ns={actual_start_ns} finish_ns={finish_ns} "
                f"phase_start_jitter_ms={jitter_ms} start_to_start_ms={start_to_start_ms} "
                f"pass_duration_ms={elapsed_ms(actual_start_ns, finish_ns)} deadline_overrun_ms={overrun_ms} "
                # A host can wake a few milliseconds after an absolute sleep
                # deadline without losing a phase.  Reserve deadline_miss for
                # an actual phase overrun; preserve the raw wake fact
                # separately for Runtime diagnostics.
                f"schedule_wake_late={int(jitter_ms > 0)} deadline_miss={int(overrun_ms > 0)} fast_rc={fast_rc}",
                flush=True,
            )
            previous_actual_start_ns = actual_start_ns
            # Preserve absolute deadlines. A late phase starts the currently due
            # phase immediately; no backlog or overlapping phase is created.
            planned_start_ns = intended_next_ns
            if self.max_phases and phase >= self.max_phases:
                return 0
            self.run_legacy_until(planned_start_ns)


@dataclass
class ManagedRole:
    name: str
    cadence_ns: int
    command: tuple[str, ...]
    initial_offset_ns: int = 0
    next_due_ns: int = 0
    process: subprocess.Popen[bytes] | None = None
    started_ns: int = 0
    starts: int = 0
    completions: int = 0
    deadline_misses: int = 0
    runtime_observation_started: dict[str, Any] = field(default_factory=dict)


def prepared_hot_target_timing_from_output(output: bytes | str) -> dict[str, Any]:
    """Return the already-emitted bounded Matrix timing for journal evidence.

    The health loop owns no additional state: it keeps the child receipt only
    until that child has exited, then emits a compact journal projection.  The
    Matrix command remains the canonical writer and its normal JSON receipt is
    unchanged.
    """
    if isinstance(output, bytes):
        text = output.decode("utf-8", errors="replace")
    else:
        text = str(output or "")
    try:
        payload = json.loads(text)
    except (TypeError, ValueError):
        return {}
    if not isinstance(payload, dict):
        return {}
    timing = payload.get("prepared_path_timing")
    timing = timing if isinstance(timing, dict) else {}
    lock = payload.get("service_matrix_lock")
    lock = lock if isinstance(lock, dict) else {}
    if not timing and not lock:
        return {}
    return {
        "total_ms": timing.get("total_ms"),
        "owner_load_ms": timing.get("owner_load_ms"),
        "parallel_probe_wall_ms": timing.get("parallel_probe_wall_ms"),
        "serialized_write_wall_ms": timing.get("serialized_write_wall_ms"),
        "writer_lock_timeout_count": lock.get("writer_lock_timeout_count"),
        "selected_target_count": (
            (payload.get("prepared_hot_target_scope") or {}).get(
                "selected_target_count_for_service_class"
            )
            if isinstance(payload.get("prepared_hot_target_scope"), dict)
            else None
        ),
    }


def ordinary_required_timing_from_output(output: bytes | str) -> dict[str, int]:
    """Extract the diagnostic-only child receipt from the ordinary detector.

    The existing health owner observes the child lifetime already.  Its state
    file is atomically written before the receipt is printed; parsing this
    bounded line therefore cannot become an operational input or a second
    state source.  It simply makes child startup, atomic commit and parent
    scheduling distinguishable for the next outlier.
    """
    text = output.decode("utf-8", errors="replace") if isinstance(output, bytes) else str(output or "")
    for line in text.splitlines():
        if not line.startswith("V7_EGRESS_DIAGNOSE_TIMING "):
            continue
        fields: dict[str, int] = {}
        for token in line.split()[1:]:
            key, separator, value = token.partition("=")
            if not separator:
                continue
            try:
                fields[key] = max(0, int(value))
            except ValueError:
                continue
        if fields:
            return fields
    return {}


@dataclass
class RoleHealthLoop:
    """Multi-cadence work placement inside the one existing health owner."""

    roles: tuple[ManagedRole, ...]
    max_hard_phases: int = 0
    poll_ns: int = 25_000_000
    serialize_slow_roles: bool = True
    # The Matrix state, not elapsed duration, proves a definitive HARD
    # incident.  Once that canonical proof exists, unrelated observations must
    # yield immediately; delaying priority by 750 ms consumed a material part
    # of the three-second recovery budget on the two-core production host.
    # Healthy or ambiguous observations never satisfy the Matrix predicate and
    # therefore never preempt background work.
    hard_takeover_ns: int = 0
    matrix_state_file: Path = DEFAULT_MATRIX_STATE_FILE
    users_registry_file: Path = DEFAULT_USERS_REGISTRY_FILE
    hard_recovery_latched: bool = False
    persistent_matrix_module: Any = None
    persistent_matrix_ready: bool = False
    persistent_matrix_load_error: str = ""
    # Process-local de-duplication only.  Matrix remains the durable owner of
    # the incident and its receipt; this prevents one already-confirmed T0
    # from being replayed once per observation while that same incident is
    # still open.  The three health roles have independent Matrix incident
    # families, so a newer Telegram/HARD T0 must never suppress an earlier
    # still-open profile-required-service T0.
    persistent_matrix_last_consumed_t0_ns: int = 0
    persistent_matrix_last_consumed_t0_ns_by_role: dict[str, int] = field(
        default_factory=dict,
    )
    persistent_matrix_last_consumed_identity_by_role: dict[str, str] = field(
        default_factory=dict,
    )
    # Last in-process Matrix result, retained only in this health-process
    # memory for the compact outcome receipt.  Every exact Matrix binding is
    # consumed at most once here, including a governed STOP_SAFE result: a
    # repeated attempt with unchanged evidence is not a new failure and must
    # not monopolise the single health owner ahead of another current source.
    persistent_matrix_last_result: dict[str, Any] = field(default_factory=dict)
    # Process-local throttle for the existing Matrix/users owner reads while
    # a detector child is live. It is deliberately neither persisted nor used
    # as recovery admission state.
    profile_binding_last_checked_ns: int = 0

    def _default_hard_runtime(self) -> bool:
        hard = next((role for role in self.roles if role.name == "hard"), None)
        return bool(
            hard
            and hard.command
            and Path(hard.command[0]).name == "v7-egress-diagnose"
        )

    def _load_persistent_matrix_runtime(self) -> None:
        """Load code once inside the existing health owner, never state.

        Matrix remains the source of truth and its normal ``main`` re-reads
        current state, authority, policy and ownership on every event.  A
        failure to load is intentionally harmless: the HARD child continues
        to invoke the existing external Matrix consumer as before.
        """
        if not self._default_hard_runtime():
            return
        candidates = (
            Path(__file__).with_name("v7-service-matrix-refresh-all"),
            Path(__file__).resolve().parents[1] / "v7-service-matrix-refresh-all",
        )
        matrix_path = next((path for path in candidates if path.is_file()), None)
        if matrix_path is None:
            self.persistent_matrix_load_error = "MATRIX_SCRIPT_MISSING"
            return
        try:
            loader = importlib.machinery.SourceFileLoader(
                "v7_health_persistent_matrix", str(matrix_path)
            )
            spec = importlib.util.spec_from_loader(loader.name, loader)
            if spec is None or spec.loader is None:
                raise RuntimeError("MATRIX_MODULE_SPEC_UNAVAILABLE")
            module = importlib.util.module_from_spec(spec)
            sys.modules[loader.name] = module
            spec.loader.exec_module(module)
            if not callable(getattr(module, "main", None)):
                raise RuntimeError("MATRIX_MAIN_UNAVAILABLE")
            self.persistent_matrix_module = module
            self.persistent_matrix_ready = True
        except Exception as exc:  # exact external governed path remains live
            self.persistent_matrix_module = None
            self.persistent_matrix_ready = False
            self.persistent_matrix_load_error = type(exc).__name__

    def _run_persistent_matrix_consumer(
        self, t0_ns: int, health_dispatch_context: dict[str, Any] | None = None,
    ) -> int:
        if not self.persistent_matrix_ready or self.persistent_matrix_module is None:
            return 3
        previous_argv = list(sys.argv)
        previous_t0 = os.environ.get("V7_HARD_T0_MONOTONIC_NS")
        previous_owner = os.environ.get("V7_HARD_PERSISTENT_MATRIX_OWNER")
        previous_context = os.environ.get("V7_HARD_HEALTH_DISPATCH_CONTEXT")
        previous_service_t0 = os.environ.get("V7_SERVICE_T0_MONOTONIC_NS")
        previous_service_owner = os.environ.get("V7_SERVICE_PERSISTENT_MATRIX_OWNER")
        previous_service_context = os.environ.get("V7_SERVICE_HEALTH_DISPATCH_CONTEXT")
        previous_service_source = os.environ.get("V7_SERVICE_PROFILE_SOURCE_EGRESS")
        self.persistent_matrix_last_result = {}
        try:
            sys.argv = [
                "v7-service-matrix-refresh-all",
                "--consume-existing-service-failure-events-only",
                "--runtime-hot-path-only",
            ]
            os.environ["V7_HARD_T0_MONOTONIC_NS"] = str(t0_ns)
            os.environ["V7_HARD_PERSISTENT_MATRIX_OWNER"] = "1"
            os.environ["V7_HARD_HEALTH_DISPATCH_CONTEXT"] = json.dumps(
                health_dispatch_context if isinstance(health_dispatch_context, dict) else {},
                sort_keys=True,
            )
            # HARD keeps its historical call contract. Service-specific roles
            # carry an explicit label so their evidence cannot be misreported
            # as a HARD-path interval.
            if (
                isinstance(health_dispatch_context, dict)
                and str(health_dispatch_context.get("service_role") or "")
                in {"telegram", "other_required"}
            ):
                os.environ["V7_SERVICE_T0_MONOTONIC_NS"] = str(t0_ns)
                os.environ["V7_SERVICE_PERSISTENT_MATRIX_OWNER"] = "1"
                os.environ["V7_SERVICE_HEALTH_DISPATCH_CONTEXT"] = json.dumps(
                    health_dispatch_context, sort_keys=True,
                )
                source_egress = str(health_dispatch_context.get("profile_source_egress") or "")
                if source_egress:
                    os.environ["V7_SERVICE_PROFILE_SOURCE_EGRESS"] = source_egress
            with open(os.devnull, "w", encoding="utf-8") as sink:
                with io.StringIO() as output:
                    with contextlib.redirect_stdout(output), contextlib.redirect_stderr(sink):
                        result = int(self.persistent_matrix_module.main())
                    rendered = output.getvalue().strip()
            if rendered:
                try:
                    self.persistent_matrix_last_result = json.loads(rendered)
                except json.JSONDecodeError:
                    # The external compatibility contract permits diagnostic
                    # lines before its final JSON result.  Keep only a valid
                    # final object; an unreadable result must retain normal
                    # de-duplication instead of creating a retry loop.
                    for line in reversed(rendered.splitlines()):
                        try:
                            candidate = json.loads(line)
                        except json.JSONDecodeError:
                            continue
                        if isinstance(candidate, dict):
                            self.persistent_matrix_last_result = candidate
                            break
            if not isinstance(self.persistent_matrix_last_result, dict):
                self.persistent_matrix_last_result = {}
            return result
        except BaseException as exc:
            self.persistent_matrix_load_error = type(exc).__name__
            return 3
        finally:
            sys.argv = previous_argv
            if previous_t0 is None:
                os.environ.pop("V7_HARD_T0_MONOTONIC_NS", None)
            else:
                os.environ["V7_HARD_T0_MONOTONIC_NS"] = previous_t0
            if previous_owner is None:
                os.environ.pop("V7_HARD_PERSISTENT_MATRIX_OWNER", None)
            else:
                os.environ["V7_HARD_PERSISTENT_MATRIX_OWNER"] = previous_owner
            if previous_context is None:
                os.environ.pop("V7_HARD_HEALTH_DISPATCH_CONTEXT", None)
            else:
                os.environ["V7_HARD_HEALTH_DISPATCH_CONTEXT"] = previous_context
            if previous_service_t0 is None:
                os.environ.pop("V7_SERVICE_T0_MONOTONIC_NS", None)
            else:
                os.environ["V7_SERVICE_T0_MONOTONIC_NS"] = previous_service_t0
            if previous_service_owner is None:
                os.environ.pop("V7_SERVICE_PERSISTENT_MATRIX_OWNER", None)
            else:
                os.environ["V7_SERVICE_PERSISTENT_MATRIX_OWNER"] = previous_service_owner
            if previous_service_context is None:
                os.environ.pop("V7_SERVICE_HEALTH_DISPATCH_CONTEXT", None)
            else:
                os.environ["V7_SERVICE_HEALTH_DISPATCH_CONTEXT"] = previous_service_context
            if previous_service_source is None:
                os.environ.pop("V7_SERVICE_PROFILE_SOURCE_EGRESS", None)
            else:
                os.environ["V7_SERVICE_PROFILE_SOURCE_EGRESS"] = previous_service_source

    def _fallback_matrix_consumer(
        self, t0_ns: int, health_dispatch_context: dict[str, Any] | None = None,
    ) -> None:
        """Use the exact historical child path only after an in-process fault."""
        environment = os.environ.copy()
        environment["V7_HARD_T0_MONOTONIC_NS"] = str(t0_ns)
        environment.pop("V7_HARD_PERSISTENT_MATRIX_OWNER", None)
        environment["V7_HARD_HEALTH_DISPATCH_CONTEXT"] = json.dumps(
            health_dispatch_context if isinstance(health_dispatch_context, dict) else {},
            sort_keys=True,
        )
        if (
            isinstance(health_dispatch_context, dict)
            and str(health_dispatch_context.get("service_role") or "")
            in {"telegram", "other_required"}
        ):
            environment["V7_SERVICE_T0_MONOTONIC_NS"] = str(t0_ns)
            environment["V7_SERVICE_HEALTH_DISPATCH_CONTEXT"] = environment[
                "V7_HARD_HEALTH_DISPATCH_CONTEXT"
            ]
            source_egress = str(health_dispatch_context.get("profile_source_egress") or "")
            if source_egress:
                environment["V7_SERVICE_PROFILE_SOURCE_EGRESS"] = source_egress
        subprocess.run(
            [
                "/usr/local/bin/v7-service-matrix-refresh-all",
                "--consume-existing-service-failure-events-only",
                "--runtime-hot-path-only",
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            env=environment,
        )

    def _consume_new_persistent_matrix_t0(
        self,
        t0_ns: int,
        health_dispatch_context: dict[str, Any] | None = None,
        *,
        dedupe_key: str = "hard",
        dedupe_identity: str = "",
    ) -> bool:
        """Consume each current canonical T0 at most once per health process.

        The external compatibility child historically re-entered Matrix for
        every HARD observation.  The persistent owner instead carries a
        specific canonical T0.  Replaying that same T0 would turn an already
        terminal controlled attempt into fresh attempts without a new failure
        generation.  This is scheduling-local de-duplication, not a new
        Matrix state or an admission rule.
        """
        key = str(dedupe_key or "hard")
        last_consumed = int(
            self.persistent_matrix_last_consumed_t0_ns_by_role.get(key) or 0
        )
        identity = str(dedupe_identity or "")
        last_identity = str(
            self.persistent_matrix_last_consumed_identity_by_role.get(key) or ""
        )
        if t0_ns <= 0 or (identity and identity == last_identity) or (
            not identity and t0_ns <= last_consumed
        ):
            return False
        self._hard_recovery_takeover(monotonic_ns())
        consumer_started_ns = monotonic_ns()
        persistent_rc = (
            self._run_persistent_matrix_consumer(t0_ns, health_dispatch_context)
            if isinstance(health_dispatch_context, dict) and health_dispatch_context
            else self._run_persistent_matrix_consumer(t0_ns)
        )
        if persistent_rc == 3:
            if isinstance(health_dispatch_context, dict) and health_dispatch_context:
                self._fallback_matrix_consumer(t0_ns, health_dispatch_context)
            else:
                self._fallback_matrix_consumer(t0_ns)
        consumer_completed_ns = monotonic_ns()
        delegated = self.persistent_matrix_last_result.get(
            "bounded_delegated_service_failure_action"
        )
        source_scope = self.persistent_matrix_last_result.get(
            "current_failed_source_scope"
        )
        consumer_result = (
            delegated.get("consumer_result")
            if isinstance(delegated, dict)
            and isinstance(delegated.get("consumer_result"), dict)
            else {}
        )
        governed_timing = (
            consumer_result.get("execution_timing")
            if isinstance(consumer_result.get("execution_timing"), dict)
            else {}
        )
        # The governed executor already owns this monotonic breakdown.  Keep a
        # bounded projection in the health receipt so a live automatic action
        # can be attributed without replaying it or creating another timing
        # writer.  The receipt contains stages and durations only: no user,
        # source, target, Packet or route is added to the health owner.
        governed_timing_receipt = {
            key: governed_timing.get(key)
            for key in (
                "schema_version",
                "status",
                "total_ms",
                "dominant_stage",
                "clock_source",
                "wall_clock_used_for_elapsed",
            )
            if key in governed_timing
        }
        spans = governed_timing.get("spans")
        if isinstance(spans, list):
            governed_timing_receipt["spans"] = [
                {
                    "stage": str(row.get("stage") or ""),
                    "duration_ms": row.get("duration_ms"),
                }
                for row in spans
                if isinstance(row, dict)
                and str(row.get("stage") or "")
                and isinstance(row.get("duration_ms"), (int, float))
            ]
        # `apply` has its own owner-backed monotonic timeline.  Preserve a
        # compact, ID-free projection of it in the same receipt so latency
        # analysis can distinguish route-writer, kernel and S11 time without
        # asking the health owner to run or reconstruct any of those steps.
        # Do not project operation / Packet / Lease identifiers: they remain
        # owned by the governed executor's canonical evidence.
        for source_key, receipt_key in (
            ("nested_timeline", "apply_timing"),
            ("second_level_timeline", "apply_second_level_timing"),
        ):
            timeline = governed_timing.get(source_key)
            if not isinstance(timeline, dict):
                continue
            compact_timeline = {
                key: timeline.get(key)
                for key in ("schema_version", "total_ms", "clock_source", "measurement_overhead_ms")
                if key in timeline
            }
            timeline_spans = timeline.get("spans")
            if isinstance(timeline_spans, list):
                compact_timeline["spans"] = [
                    {
                        "stage": str(row.get("stage") or ""),
                        "duration_ms": row.get("duration_ms"),
                    }
                    for row in timeline_spans[:32]
                    if isinstance(row, dict)
                    and str(row.get("stage") or "")
                    and isinstance(row.get("duration_ms"), (int, float))
                ]
            if compact_timeline:
                governed_timing_receipt[receipt_key] = compact_timeline
        # The existing health owner used to suppress the Matrix consumer's
        # structured result after an in-process call. That obscured whether a
        # live confirmed failure stopped in scope, Authority, Planner or the
        # governed executor, and made a current continuing incident look like
        # an unexplained non-recovery. Emit one compact journal receipt.  It
        # contains no user identities and neither changes admission nor
        # retries an action; Matrix and the downstream owners remain the only
        # sources of the underlying state.
        source_rows = (
            source_scope.get("active_sources")
            if isinstance(source_scope, dict)
            and isinstance(source_scope.get("active_sources"), list)
            else []
        )
        affected_count = sum(
            int(row.get("affected_scope_count") or 0)
            for row in source_rows if isinstance(row, dict)
        )
        receipt = {
            "schema": "v7.health-persistent-matrix-consumer-receipt.v1",
            "role": key,
            "source": str((health_dispatch_context or {}).get("profile_source_egress") or ""),
            # These three spans are deliberately retained in the existing
            # health receipt: they distinguish Matrix/consumer scheduling
            # delay from the governed transaction itself without creating a
            # second timing owner or changing any recovery decision.
            "t0_monotonic_ns": int(t0_ns),
            "incident_t0_monotonic_ns": int(
                (health_dispatch_context or {}).get(
                    "matrix_incident_t0_monotonic_ns"
                ) or t0_ns
            ),
            "consumer_started_monotonic_ns": int(consumer_started_ns),
            "consumer_completed_monotonic_ns": int(consumer_completed_ns),
            "t0_to_consumer_started_ms": elapsed_ms(t0_ns, consumer_started_ns),
            "t0_to_consumer_complete_ms": elapsed_ms(t0_ns, consumer_completed_ns),
            "consumer_execution_ms": elapsed_ms(consumer_started_ns, consumer_completed_ns),
            "consumer_rc": int(persistent_rc),
            "matrix_status": str(self.persistent_matrix_last_result.get("status") or ""),
            "next_output": str(self.persistent_matrix_last_result.get("next_output") or ""),
            "failed_scope_active": bool(source_scope.get("active")) if isinstance(source_scope, dict) else False,
            "affected_scope_count": affected_count,
            "action_status": str(delegated.get("status") or "") if isinstance(delegated, dict) else "MISSING",
            "action_attempted": bool(delegated.get("action_attempted")) if isinstance(delegated, dict) else False,
            "action_completed": bool(delegated.get("action_completed")) if isinstance(delegated, dict) else False,
            "runtime_mutation_performed": bool(delegated.get("runtime_mutation_performed")) if isinstance(delegated, dict) else False,
            "users_moved": int(delegated.get("users_moved") or 0) if isinstance(delegated, dict) else 0,
            "stop_reason": str(consumer_result.get("stop_reason") or delegated.get("reason") or "") if isinstance(delegated, dict) else "",
        }
        if governed_timing_receipt:
            receipt["governed_execution_timing"] = governed_timing_receipt
        print(
            "V7_HEALTH_RECOVERY_CONSUMER_RECEIPT "
            + json.dumps(receipt, sort_keys=True, separators=(",", ":")),
            flush=True,
        )
        # A STOP_SAFE outcome is evidence, not permission to replay exactly
        # the same incident immediately.  The former exception for a
        # downstream-proof failure retried one unchanged source on every
        # detector cycle.  Because this is a synchronous call in the existing
        # health owner, that retry starved unrelated fresh source bindings and
        # could leave their affected users unrecovered indefinitely.  Matrix
        # re-enters this path only on a changed exact binding (new incident,
        # affected profile/service scope, or source assignment), preserving
        # fail-closed semantics without creating another scheduler or state
        # owner.
        self.persistent_matrix_last_consumed_t0_ns_by_role[key] = t0_ns
        if identity:
            self.persistent_matrix_last_consumed_identity_by_role[key] = identity
        # Retain the aggregate high-water mark solely for existing diagnostics
        # and controlled fixtures.  It is deliberately not an admission gate.
        self.persistent_matrix_last_consumed_t0_ns = max(
            self.persistent_matrix_last_consumed_t0_ns, t0_ns,
        )
        return True

    def _hard_recovery_active(self, now_ns: int) -> bool:
        hard = next((role for role in self.roles if role.name == "hard"), None)
        if hard is None or hard.process is None:
            self.hard_recovery_latched = False
            return False
        if (
            now_ns - hard.started_ns >= self.hard_takeover_ns
            and canonical_definitive_hard_failure_active(
                self.matrix_state_file, self.users_registry_file
            )
        ):
            # Matrix owns admission.  The latch is process-local scheduling
            # state only: once admitted, preserve priority through every
            # Matrix episode phase until this exact HARD child returns.  A
            # later phase name must not restart background probes midway.
            self.hard_recovery_latched = True
        return self.hard_recovery_latched

    def _hard_recovery_takeover(self, now_ns: int) -> None:
        """Give an admitted long HARD cycle priority until it returns.

        Duration is only the scheduling discriminator.  The existing Matrix
        state must also expose a current definitive local failure before any
        other role is preempted. PATH readiness is an input to the same HARD
        decision and remains live in parallel. Telegram is critical to its own
        incident, but is unrelated once a Matrix-owned HARD successor has been
        admitted; it restarts on its absolute cadence after HARD completes.
        """
        hard = next((role for role in self.roles if role.name == "hard"), None)
        if hard is None or not self._hard_recovery_active(now_ns):
            return
        for role in self.roles:
            if (
                role.name == "hard"
                or role.process is None
            ):
                continue
            duration = elapsed_ms(role.started_ns, now_ns)
            terminate_process_group(role.process)
            role.process = None
            role.started_ns = 0
            print(
                f"V7_HEALTH_ROLE_PREEMPTED role={role.name} duration_ms={duration} "
                "reason=HARD_RECOVERY_PRIORITY",
                flush=True,
            )

    def _planner_projection_freshness_takeover(self, now_ns: int) -> None:
        """Let the existing prepared-decision refresh run when it is due.

        The projection has a bounded freshness window. Treating its refresh
        like every other slow observation allowed a continuously running
        ``hot_target_other`` or deep probe to defer it past that window. A
        real incident then had to rebuild the exact same decision on the
        synchronous path. This only arbitrates already-existing disposable
        children: HARD still preempts everything on a Matrix-confirmed
        incident, and each interrupted observation returns on its own
        existing cadence.
        """
        for role in self.roles:
            if (
                role.name == "planner_projection"
                or role.name not in SLOW_ROLE_NAMES
                or role.name in RECOVERY_CRITICAL_ROLE_NAMES
                or role.process is None
            ):
                continue
            duration = elapsed_ms(role.started_ns, now_ns)
            terminate_process_group(role.process)
            role.process = None
            role.started_ns = 0
            print(
                f"V7_HEALTH_ROLE_PREEMPTED role={role.name} "
                f"duration_ms={duration} "
                "reason=PREPARED_PROJECTION_FRESHNESS_PRIORITY",
                flush=True,
            )

    def _recovery_critical_takeover(self, now_ns: int) -> None:
        """Release disposable slow work before a service-failure detector.

        The service-failure producer is an existing recovery-critical role.
        If a background Matrix projection already owns the shared Matrix lock,
        allowing the detector to wait behind it can turn a five-second health
        observation into a minute-long stale window.  Preempt every
        non-critical slow observation, including advisory non-critical target
        warming. Exact PATH/Telegram readiness remains owned by the
        recovery-critical target role; other-service warming and deep analysis
        must never postpone detection of a currently failed client contract.
        Matrix/Planner ownership and cadence remain unchanged, and each
        interrupted role returns on its own due schedule.
        """
        for role in self.roles:
            if (
                role.name in RECOVERY_CRITICAL_ROLE_NAMES
                or role.name not in SLOW_ROLE_NAMES
                or role.process is None
            ):
                continue
            duration = elapsed_ms(role.started_ns, now_ns)
            terminate_process_group(role.process)
            role.process = None
            role.started_ns = 0
            print(
                f"V7_HEALTH_ROLE_PREEMPTED role={role.name} "
                f"duration_ms={duration} "
                "reason=RECOVERY_CRITICAL_FAILURE_DETECTION_PRIORITY",
                flush=True,
            )

    def _ordinary_required_detector_takeover(self, now_ns: int) -> None:
        """Give the existing ordinary service detector one bounded CPU slot.

        ``other_required`` is the only regular producer for an ordinary
        profile-required-service failure.  Its one-second probes were being
        scheduled together with Telegram and prepared-target Matrix writers;
        on two CPUs that turned the five-second detector into a 20--30 second
        job.  The other roles are observations, not an execution authority,
        and are restarted on their existing cadences after the detector exits.
        HARD stays live because an unambiguous local interface loss is a
        separate higher-safety signal.  No health state, priority, cadence or
        downstream owner changes here.
        """
        for role in self.roles:
            if (
                role.name in {"hard", "other_required"}
                or role.process is None
            ):
                continue
            duration = elapsed_ms(role.started_ns, now_ns)
            terminate_process_group(role.process)
            role.process = None
            role.started_ns = 0
            role.runtime_observation_started = {}
            print(
                f"V7_HEALTH_ROLE_PREEMPTED role={role.name} "
                f"duration_ms={duration} "
                "reason=ORDINARY_REQUIRED_SERVICE_DETECTION_PRIORITY",
                flush=True,
            )

    def _start_due_roles(self, now_ns: int) -> None:
        hard = next((role for role in self.roles if role.name == "hard"), None)
        hard_takeover = self._hard_recovery_active(now_ns)
        for role in self.roles:
            if now_ns < role.next_due_ns:
                continue
            while role.next_due_ns <= now_ns:
                role.next_due_ns += role.cadence_ns
            if role.process is not None:
                role.deadline_misses += 1
                print(
                    f"V7_HEALTH_ROLE_DEADLINE_MISS role={role.name} "
                    f"misses={role.deadline_misses} reason=PREVIOUS_INVOCATION_RUNNING",
                    flush=True,
                )
                continue
            if hard_takeover and role.name != "hard":
                print(
                    f"V7_HEALTH_ROLE_DEFERRED role={role.name} "
                    "reason=HARD_RECOVERY_PRIORITY",
                    flush=True,
                )
                continue
            ordinary_detector_running = any(
                other.name == "other_required" and other.process is not None
                for other in self.roles
            )
            if (
                ordinary_detector_running
                and role.name not in {"hard", "other_required"}
            ):
                print(
                    f"V7_HEALTH_ROLE_DEFERRED role={role.name} "
                    "reason=ORDINARY_REQUIRED_SERVICE_DETECTION_PRIORITY",
                    flush=True,
                )
                continue
            # Keep the prepared decision inside its existing freshness
            # contract. The refresh itself is an existing slow child; it
            # gains no authority and does not alter cadence or Matrix-state
            # ownership. Without this arbitration a lower-priority slow
            # probe can repeatedly win the serialized slot until the next
            # incident pays a multi-second synchronous rebuild.
            if role.name == "planner_projection" and self.serialize_slow_roles:
                self._planner_projection_freshness_takeover(now_ns)
            if role.name in RECOVERY_CRITICAL_ROLE_NAMES and self.serialize_slow_roles:
                self._recovery_critical_takeover(now_ns)
            if role.name == "other_required":
                self._ordinary_required_detector_takeover(now_ns)
            # HARD is the recovery deadline owner. It may run alongside an
            # observation child long enough to prove that a real incident is
            # underway; _hard_recovery_takeover then cancels that disposable
            # work after the bounded discriminator. Never defer the HARD
            # observation itself behind background serialization.
            if (
                self.serialize_slow_roles
                and role.name in SLOW_ROLE_NAMES
                and role.name not in RECOVERY_CRITICAL_ROLE_NAMES
            ):
                running_slow = next(
                    (
                        other.name for other in self.roles
                        if other.name in SLOW_ROLE_NAMES
                        and other.name != role.name
                        and other.process is not None
                    ),
                    "",
                )
                if running_slow and not (
                    role.name in {"hot_target_other", "deep"}
                    and running_slow == "other_required"
                ):
                    print(
                        f"V7_HEALTH_ROLE_DEFERRED role={role.name} "
                        f"reason=SLOW_ROLE_ALREADY_RUNNING running_role={running_slow}",
                        flush=True,
                    )
                    continue
            command = list(role.command)
            nice = DEFAULT_ROLE_NICE.get(role.name)
            if nice is not None:
                command = ["/usr/bin/nice", "-n", str(nice), *command]
            environment = None
            if role.name in {"hard", "telegram", "other_required"} and self.persistent_matrix_ready:
                environment = os.environ.copy()
                environment["V7_HEALTH_PERSISTENT_MATRIX_CONSUMER"] = "1"
                # This is evidence provenance for the existing Matrix writer,
                # not Authority or a route instruction.
                environment["V7_HEALTH_RUNTIME_ROLE"] = role.name
            # A prepared PATH run already emits one small Matrix receipt. Keep
            # it in this existing owner only until exit so the journal can
            # expose the measured critical-path split. Other roles retain
            # their historical DEVNULL behaviour and no durable surface or
            # execution semantics are introduced.
            capture_prepared_path_timing = role.name in {"hot_target", "other_required"}
            role.process = subprocess.Popen(
                command,
                stdout=(subprocess.PIPE if capture_prepared_path_timing else subprocess.DEVNULL),
                stderr=subprocess.DEVNULL,
                start_new_session=True,
                env=environment,
            )
            role.started_ns = now_ns
            role.runtime_observation_started = (
                health_runtime_observation()
                if role.name in {"hard", "telegram", "other_required"} else {}
            )
            role.starts += 1
            print(
                f"V7_HEALTH_ROLE_START role={role.name} start={role.starts} "
                f"cadence_ms={role.cadence_ns // 1_000_000} actual_start_ns={now_ns}",
                flush=True,
            )

    def _collect_roles(self, now_ns: int) -> None:
        for role in self.roles:
            if role.process is None:
                continue
            rc = role.process.poll()
            # The profile-service detector can keep harmless probes for other
            # sources in flight after one exact source has already published a
            # fresh Matrix T0.  Waiting for that whole child to return made
            # the existing health caller defer its governed recovery handoff
            # behind unrelated one-second probe timeouts.  Read the same
            # canonical Matrix while the detector runs.  If its identity is
            # new, stop only the now-disposable remainder of that detector and
            # let the existing persistent Matrix consumer continue normally.
            #
            # This adds no caller, state or authority: the health loop is
            # already the only normal Runtime caller, Matrix remains the
            # writer, and the downstream Planner/Authority/route owners keep
            # every current gate.  Old or already-consumed evidence does not
            # interrupt the detector.
            if (
                rc is None
                and role.name == "other_required"
                and self.persistent_matrix_ready
                and (
                    self.profile_binding_last_checked_ns <= 0
                    or now_ns - self.profile_binding_last_checked_ns
                    >= PROFILE_BINDING_POLL_NS
                )
            ):
                self.profile_binding_last_checked_ns = now_ns
                profile_bindings = canonical_profile_service_failure_bindings(
                    self.matrix_state_file,
                    self.users_registry_file,
                )
                pending_bindings = [
                    binding
                    for binding in profile_bindings
                    if int(binding.get("t0_ns") or 0) > 0
                    and str(binding.get("dedupe_identity") or "")
                    != str(
                        self.persistent_matrix_last_consumed_identity_by_role.get(
                            f"other_required:{str(binding.get('source_egress') or '')}",
                            "",
                        )
                    )
                ]
                if pending_bindings:
                    detector_process = role.process
                    detector_pid = int(getattr(detector_process, "pid", 0) or 0)
                    duration = elapsed_ms(role.started_ns, now_ns)
                    detector_started_ns = int(role.started_ns)
                    detector_observation_started = dict(
                        role.runtime_observation_started
                    )
                    terminate_process_group(detector_process)
                    role.process = None
                    role.started_ns = 0
                    role.runtime_observation_started = {}
                    print(
                        f"V7_HEALTH_ROLE_PREEMPTED role=other_required "
                        f"duration_ms={duration} "
                        "reason=PROFILE_MATRIX_T0_CONSUMED",
                        flush=True,
                    )
                    for profile_binding in pending_bindings:
                        t0_ns = int(profile_binding.get("t0_ns") or 0)
                        source_egress = str(
                            profile_binding.get("source_egress") or ""
                        )
                        dispatch_ns = monotonic_ns()
                        context = health_runtime_observation_delta(
                            detector_observation_started,
                            health_runtime_observation(),
                        )
                        context.update({
                            "service_role": role.name,
                            "service_role_pid": detector_pid,
                            "service_role_started_monotonic_ns": detector_started_ns,
                            "persistent_dispatch_monotonic_ns": int(dispatch_ns),
                            "matrix_t0_monotonic_ns": t0_ns,
                            "matrix_incident_t0_monotonic_ns": int(
                                profile_binding.get("incident_t0_ns") or t0_ns
                            ),
                            "profile_source_egress": source_egress,
                        })
                        self._consume_new_persistent_matrix_t0(
                            t0_ns,
                            context,
                            dedupe_key=(
                                f"{role.name}:{source_egress}"
                                if source_egress else role.name
                            ),
                            dedupe_identity=str(
                                profile_binding.get("dedupe_identity") or ""
                            ),
                        )
                    continue
            if rc is None:
                continue
            prepared_timing: dict[str, Any] = {}
            ordinary_detector_timing: dict[str, int] = {}
            if role.name in {"hot_target", "other_required"} and role.process.stdout is not None:
                try:
                    # ``poll`` has already observed child exit.  Reading the
                    # small completed receipt without a zero-length timeout
                    # cannot delay the role, while ``timeout=0`` could throw
                    # before Python drained an already closed pipe and lose
                    # the diagnostic evidence.
                    stdout, _stderr = role.process.communicate()
                    if role.name == "hot_target":
                        prepared_timing = prepared_hot_target_timing_from_output(stdout)
                    else:
                        ordinary_detector_timing = ordinary_required_timing_from_output(stdout)
                except OSError:
                    prepared_timing = {}
            if role.name in {"hard", "telegram", "other_required"} and self.persistent_matrix_ready:
                if role.name == "other_required":
                    profile_bindings = canonical_profile_service_failure_bindings(
                        self.matrix_state_file,
                        self.users_registry_file,
                    )
                else:
                    profile_bindings = [{}]
                    t0_ns = canonical_service_failure_t0_ns(
                        self.matrix_state_file,
                        self.users_registry_file,
                        "__channel_liveness__" if role.name == "hard" else "telegram",
                        "DEFINITIVE_LOCAL_HARD_FAILURE" if role.name == "hard" else "",
                    )
                if role.name != "other_required":
                    profile_bindings[0]["t0_ns"] = t0_ns
                for profile_binding in profile_bindings:
                    t0_ns = int(profile_binding.get("t0_ns") or 0)
                    if t0_ns <= 0:
                        continue
                    dispatch_ns = monotonic_ns()
                    context = health_runtime_observation_delta(
                        role.runtime_observation_started,
                        health_runtime_observation(),
                    )
                    context.update({
                        "service_role": role.name,
                        "service_role_pid": int(role.process.pid),
                        "service_role_started_monotonic_ns": int(role.started_ns),
                        "persistent_dispatch_monotonic_ns": int(dispatch_ns),
                        "matrix_t0_monotonic_ns": int(t0_ns),
                        "matrix_incident_t0_monotonic_ns": int(
                            profile_binding.get("incident_t0_ns") or t0_ns
                        ),
                    })
                    if profile_binding.get("source_egress"):
                        context["profile_source_egress"] = str(
                            profile_binding["source_egress"]
                        )
                    source_egress = str(profile_binding.get("source_egress") or "")
                    self._consume_new_persistent_matrix_t0(
                        t0_ns,
                        context,
                        dedupe_key=(f"{role.name}:{source_egress}" if source_egress else role.name),
                        dedupe_identity=str(profile_binding.get("dedupe_identity") or ""),
                    )
                    now_ns = monotonic_ns()
            duration = elapsed_ms(role.started_ns, now_ns)
            role.completions += 1
            print(
                f"V7_HEALTH_ROLE_COMPLETE role={role.name} completion={role.completions} "
                f"duration_ms={duration} rc={rc}",
                flush=True,
            )
            if prepared_timing:
                print(
                    "V7_HEALTH_PREPARED_TARGET_TIMING "
                    f"role={role.name} "
                    + " ".join(
                        f"{key}={value}"
                        for key, value in prepared_timing.items()
                        if value is not None
                    ),
                    flush=True,
                )
            if ordinary_detector_timing:
                print(
                    "V7_HEALTH_OTHER_REQUIRED_TIMING "
                    f"role={role.name} "
                    + " ".join(
                        f"{key}={value}"
                        for key, value in ordinary_detector_timing.items()
                    ),
                    flush=True,
                )
            role.process = None
            role.started_ns = 0
            role.runtime_observation_started = {}
            if role.name == "hard":
                self.hard_recovery_latched = False

    def _stop_children(self) -> None:
        for role in self.roles:
            if role.process is not None:
                terminate_process_group(role.process)
                role.process = None
        self.hard_recovery_latched = False

    def run(self) -> int:
        self._load_persistent_matrix_runtime()
        print(
            "V7_HEALTH_PERSISTENT_MATRIX "
            f"status={'READY' if self.persistent_matrix_ready else 'UNAVAILABLE'} "
            f"error={self.persistent_matrix_load_error or 'NONE'}",
            flush=True,
        )
        started = monotonic_ns()
        for role in self.roles:
            role.next_due_ns = started + role.initial_offset_ns
        hard = next((role for role in self.roles if role.name == "hard"), self.roles[0])
        try:
            while True:
                now_ns = monotonic_ns()
                self._collect_roles(now_ns)
                self._hard_recovery_takeover(now_ns)
                self._start_due_roles(now_ns)
                if self.max_hard_phases and hard.starts >= self.max_hard_phases:
                    # A finite Polygon completes only after every invocation it
                    # started has returned; no child or orphan survives it.
                    while any(role.process is not None for role in self.roles):
                        time.sleep(self.poll_ns / 1_000_000_000)
                        finite_now_ns = monotonic_ns()
                        self._collect_roles(finite_now_ns)
                        self._hard_recovery_takeover(finite_now_ns)
                    return 0
                next_due = min(role.next_due_ns for role in self.roles)
                wait_ns = max(1_000_000, min(self.poll_ns, next_due - monotonic_ns()))
                time.sleep(wait_ns / 1_000_000_000)
        finally:
            self._stop_children()


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--fast-interval-ms", type=int, default=30_000)
    parser.add_argument("--legacy-guard-ms", type=int, default=250)
    parser.add_argument("--max-phases", type=int, default=0)
    parser.add_argument("--controlled-fast-command")
    parser.add_argument("--controlled-legacy-command", action="append", default=[])
    parser.add_argument("--role-based-fast", action="store_true")
    parser.add_argument("--controlled-hard-command")
    parser.add_argument("--controlled-telegram-command")
    parser.add_argument("--controlled-hot-target-command")
    parser.add_argument("--controlled-hot-target-other-command")
    parser.add_argument("--controlled-required-command")
    parser.add_argument("--controlled-planner-projection-command")
    parser.add_argument("--controlled-deep-command")
    parser.add_argument("--hard-interval-ms", type=int, default=1_000)
    parser.add_argument("--telegram-interval-ms", type=int, default=1_000)
    parser.add_argument("--hot-target-interval-ms", type=int, default=1_000)
    parser.add_argument("--hot-target-other-interval-ms", type=int, default=5_000)
    parser.add_argument("--required-interval-ms", type=int, default=3_500)
    parser.add_argument("--planner-projection-interval-ms", type=int, default=30_000)
    parser.add_argument("--deep-interval-ms", type=int, default=60_000)
    parser.add_argument(
        "--controlled-matrix-state-file",
        default="",
        help=(
            "Finite Polygon/test override for the existing Matrix state reader; "
            "production always reads the canonical default."
        ),
    )
    parser.add_argument(
        "--controlled-users-registry-file",
        default="",
        help=(
            "Finite Polygon/test override for the existing users registry; "
            "production always reads the canonical default."
        ),
    )
    args = parser.parse_args(argv)
    if args.fast_interval_ms <= 0:
        parser.error("--fast-interval-ms must be positive")
    if not 0 <= args.legacy_guard_ms < args.fast_interval_ms:
        parser.error("--legacy-guard-ms must be non-negative and below the interval")
    if args.max_phases < 0:
        parser.error("--max-phases must be non-negative")
    if (args.controlled_fast_command or args.controlled_legacy_command) and not args.max_phases:
        parser.error("controlled health commands require finite --max-phases")
    controlled_roles = (
        args.controlled_hard_command,
        args.controlled_telegram_command,
        args.controlled_hot_target_command,
        args.controlled_hot_target_other_command,
        args.controlled_required_command,
        args.controlled_planner_projection_command,
        args.controlled_deep_command,
    )
    if any(controlled_roles) and (not args.role_based_fast or not args.max_phases):
        parser.error("controlled role commands require --role-based-fast and finite --max-phases")
    if args.controlled_matrix_state_file and (
        not args.role_based_fast
        or not args.max_phases
        or not any(controlled_roles)
    ):
        parser.error(
            "--controlled-matrix-state-file requires controlled role commands "
            "and a finite role-based Polygon run"
        )
    if args.controlled_users_registry_file and (
        not args.controlled_matrix_state_file
        or not args.role_based_fast
        or not args.max_phases
        or not any(controlled_roles)
    ):
        parser.error(
            "--controlled-users-registry-file requires the controlled Matrix "
            "state and a finite role-based Polygon run"
        )
    for value in (
        args.hard_interval_ms, args.telegram_interval_ms,
        args.hot_target_interval_ms,
        args.hot_target_other_interval_ms,
        args.required_interval_ms, args.planner_projection_interval_ms,
        args.deep_interval_ms,
    ):
        if value <= 0:
            parser.error("role intervals must be positive")
    return args


def main(argv: Sequence[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    if args.role_based_fast:
        controlled = {
            "hard": args.controlled_hard_command,
            "telegram": args.controlled_telegram_command,
            "hot_target": args.controlled_hot_target_command,
            "hot_target_other": args.controlled_hot_target_other_command,
            "other_required": args.controlled_required_command,
            "planner_projection": args.controlled_planner_projection_command,
            "deep": args.controlled_deep_command,
        }
        intervals = {
            "hard": args.hard_interval_ms,
            "telegram": args.telegram_interval_ms,
            "hot_target": args.hot_target_interval_ms,
            "hot_target_other": args.hot_target_other_interval_ms,
            "other_required": args.required_interval_ms,
            "planner_projection": args.planner_projection_interval_ms,
            "deep": args.deep_interval_ms,
        }
        roles = tuple(
            ManagedRole(
                name=name,
                cadence_ns=intervals[name] * 1_000_000,
                command=(controlled[name],) if controlled[name] else tuple(command),
                initial_offset_ns=(
                    0
                    if any(controlled.values())
                    else DEFAULT_ROLE_INITIAL_OFFSETS_MS[name] * 1_000_000
                ),
            )
            for name, _default_interval, command in DEFAULT_ROLE_COMMANDS
        )
        return RoleHealthLoop(
            roles=roles,
            max_hard_phases=args.max_phases,
            # Controlled Polygon commands remain able to exercise deliberate
            # overlap. Production commands use one low-priority background
            # role at a time so DEEP/quality work cannot form a CPU burst.
            serialize_slow_roles=not any(controlled.values()),
            matrix_state_file=(
                Path(args.controlled_matrix_state_file)
                if args.controlled_matrix_state_file
                else DEFAULT_MATRIX_STATE_FILE
            ),
            users_registry_file=(
                Path(args.controlled_users_registry_file)
                if args.controlled_users_registry_file
                else DEFAULT_USERS_REGISTRY_FILE
            ),
        ).run()
    if args.controlled_fast_command:
        fast_command = (args.controlled_fast_command,)
        legacy_commands = tuple((f"controlled_{index}", command) for index, command in enumerate(args.controlled_legacy_command))
    else:
        fast_command = DEFAULT_FAST
        legacy_commands = DEFAULT_LEGACY
    return HealthLoop(
        interval_ns=args.fast_interval_ms * 1_000_000,
        legacy_guard_ns=args.legacy_guard_ms * 1_000_000,
        max_phases=args.max_phases,
        fast_command=fast_command,
        legacy_commands=legacy_commands,
    ).run()


if __name__ == "__main__":
    raise SystemExit(main())
