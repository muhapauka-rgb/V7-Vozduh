def monotonic_ns() -> int:
    return time.monotonic_ns()


def elapsed_ms(start_ns: int, end_ns: int) -> int:
    return max(0, (end_ns - start_ns) // 1_000_000)


def terminate_process_group(process: subprocess.Popen[bytes]) -> None:
    """Terminate a bounded legacy child and every child it spawned."""
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()


def run_command(command: Sequence[str], timeout_ms: int | None = None) -> tuple[str, int]:
    process = subprocess.Popen(
        list(command), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    try:
        rc = process.wait(None if timeout_ms is None else max(0.001, timeout_ms / 1000))
    except subprocess.TimeoutExpired:
        terminate_process_group(process)
        return "TIMEOUT", 0
    return "COMPLETED", rc


@dataclass
class HealthLoop:
    interval_ns: int
    legacy_guard_ns: int
    max_phases: int
    fast_command: tuple[str, ...]
    legacy_commands: tuple[tuple[str, str], ...]
    legacy_cursor: int = 0

    def run_fast(self) -> int:
        _, rc = run_command(self.fast_command)
        return rc

    def run_legacy_until(self, deadline_ns: int) -> None:
        """Spend only the current phase's remaining budget on legacy work."""
        count = len(self.legacy_commands)
        for _ in range(count):
            remaining_ns = deadline_ns - monotonic_ns()
            if remaining_ns <= self.legacy_guard_ns:
                return
            budget_ms = (remaining_ns - self.legacy_guard_ns) // 1_000_000
            if budget_ms <= 0:
                return
            label, command = self.legacy_commands[self.legacy_cursor]
            self.legacy_cursor = (self.legacy_cursor + 1) % count
            status, rc = run_command((command,), int(budget_ms))
            if status == "TIMEOUT":
                print(f"V7_HEALTH_LEGACY_DEFERRED label={label} reason=DEADLINE_BUDGET_EXHAUSTED budget_ms={budget_ms}", flush=True)
            elif rc == 0:
                print(f"V7_HEALTH_LEGACY_COMPLETED label={label} budget_ms={budget_ms}", flush=True)
            else:
                print(f"V7_HEALTH_LEGACY_FAILED label={label} rc={rc} budget_ms={budget_ms}", flush=True)

    def run(self) -> int:
        planned_start_ns = monotonic_ns()
        previous_actual_start_ns: int | None = None
        phase = 0
        while True:
            wait_ns = planned_start_ns - monotonic_ns()
            if wait_ns > 0:
                time.sleep(wait_ns / 1_000_000_000)
            actual_start_ns = monotonic_ns()
            phase += 1
            fast_rc = self.run_fast()
            finish_ns = monotonic_ns()
            intended_next_ns = planned_start_ns + self.interval_ns
            jitter_ms = elapsed_ms(planned_start_ns, actual_start_ns)
            start_to_start_ms = 0 if previous_actual_start_ns is None else elapsed_ms(previous_actual_start_ns, actual_start_ns)
            overrun_ms = max(0, elapsed_ms(intended_next_ns, finish_ns))
            print(
                "V7_HEALTH_FAST_PHASE "
                f"phase={phase} planned_start_ns={planned_start_ns} actual_start_ns={actual_start_ns} finish_ns={finish_ns} "
                f"phase_start_jitter_ms={jitter_ms} start_to_start_ms={start_to_start_ms} "
                f"pass_duration_ms={elapsed_ms(actual_start_ns, finish_ns)} deadline_overrun_ms={overrun_ms} "
                # A host can wake a few milliseconds after an absolute sleep
                # deadline without losing a phase.  Reserve deadline_miss for
                # an actual phase overrun; preserve the raw wake fact
                # separately for Runtime diagnostics.
                f"schedule_wake_late={int(jitter_ms > 0)} deadline_miss={int(overrun_ms > 0)} fast_rc={fast_rc}",
                flush=True,
            )
            previous_actual_start_ns = actual_start_ns
            # Preserve absolute deadlines. A late phase starts the currently due
            # phase immediately; no backlog or overlapping phase is created.
            planned_start_ns = intended_next_ns
            if self.max_phases and phase >= self.max_phases:
                return 0
            self.run_legacy_until(planned_start_ns)


@dataclass
class ManagedRole:
    name: str
    cadence_ns: int
    command: tuple[str, ...]
    next_due_ns: int = 0
    process: subprocess.Popen[bytes] | None = None
    started_ns: int = 0
    starts: int = 0
    completions: int = 0
    deadline_misses: int = 0


@dataclass
class RoleHealthLoop:
    """Multi-cadence work placement inside the one existing health owner."""

    roles: tuple[ManagedRole, ...]
    max_hard_phases: int = 0
    poll_ns: int = 25_000_000

    def _start_due_roles(self, now_ns: int) -> None:
        for role in self.roles:
            if now_ns < role.next_due_ns:
                continue
            while role.next_due_ns <= now_ns:
                role.next_due_ns += role.cadence_ns
            if role.process is not None:
                role.deadline_misses += 1
                print(
                    f"V7_HEALTH_ROLE_DEADLINE_MISS role={role.name} "
                    f"misses={role.deadline_misses} reason=PREVIOUS_INVOCATION_RUNNING",
                    flush=True,
                )
                continue
            role.process = subprocess.Popen(
                list(role.command),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            role.started_ns = now_ns
            role.starts += 1
            print(
                f"V7_HEALTH_ROLE_START role={role.name} start={role.starts} "
                f"cadence_ms={role.cadence_ns // 1_000_000} actual_start_ns={now_ns}",
                flush=True,
            )

    def _collect_roles(self, now_ns: int) -> None:
        for role in self.roles:
            if role.process is None:
                continue
            rc = role.process.poll()
            if rc is None:
                continue
            duration = elapsed_ms(role.started_ns, now_ns)
            role.completions += 1
            print(
                f"V7_HEALTH_ROLE_COMPLETE role={role.name} completion={role.completions} "
                f"duration_ms={duration} rc={rc}",
                flush=True,
            )
            role.process = None
            role.started_ns = 0

    def _stop_children(self) -> None:
        for role in self.roles:
            if role.process is not None:
                terminate_process_group(role.process)
                role.process = None

    def run(self) -> int:
        started = monotonic_ns()
        for role in self.roles:
            role.next_due_ns = started
        hard = next((role for role in self.roles if role.name == "hard"), self.roles[0])
        try:
            while True:
                now_ns = monotonic_ns()
                self._collect_roles(now_ns)
                self._start_due_roles(now_ns)
                if self.max_hard_phases and hard.starts >= self.max_hard_phases:
                    # A finite Polygon completes only after every invocation it
                    # started has returned; no child or orphan survives it.
                    while any(role.process is not None for role in self.roles):
                        time.sleep(self.poll_ns / 1_000_000_000)
                        self._collect_roles(monotonic_ns())
                    return 0
                next_due = min(role.next_due_ns for role in self.roles)
                wait_ns = max(1_000_000, min(self.poll_ns, next_due - monotonic_ns()))
                time.sleep(wait_ns / 1_000_000_000)
        finally:
            self._stop_children()


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--fast-interval-ms", type=int, default=30_000)
    parser.add_argument("--legacy-guard-ms", type=int, default=250)
    parser.add_argument("--max-phases", type=int, default=0)
    parser.add_argument("--controlled-fast-command")
    parser.add_argument("--controlled-legacy-command", action="append", default=[])
    parser.add_argument("--role-based-fast", action="store_true")
    parser.add_argument("--controlled-hard-command")
    parser.add_argument("--controlled-telegram-command")
    parser.add_argument("--controlled-hot-target-command")
    parser.add_argument("--controlled-hot-target-other-command")
    parser.add_argument("--controlled-required-command")
    parser.add_argument("--controlled-deep-command")
    parser.add_argument("--hard-interval-ms", type=int, default=1_000)
    parser.add_argument("--telegram-interval-ms", type=int, default=1_000)
    parser.add_argument("--hot-target-interval-ms", type=int, default=1_000)
    parser.add_argument("--hot-target-other-interval-ms", type=int, default=5_000)
    parser.add_argument("--required-interval-ms", type=int, default=5_000)
    parser.add_argument("--deep-interval-ms", type=int, default=60_000)
    args = parser.parse_args(argv)
    if args.fast_interval_ms <= 0:
        parser.error("--fast-interval-ms must be positive")
    if not 0 <= args.legacy_guard_ms < args.fast_interval_ms:
        parser.error("--legacy-guard-ms must be non-negative and below the interval")
    if args.max_phases < 0:
        parser.error("--max-phases must be non-negative")
    if (args.controlled_fast_command or args.controlled_legacy_command) and not args.max_phases:
        parser.error("controlled health commands require finite --max-phases")
    controlled_roles = (
        args.controlled_hard_command,
        args.controlled_telegram_command,
        args.controlled_hot_target_command,
        args.controlled_hot_target_other_command,
        args.controlled_required_command,
        args.controlled_deep_command,
    )
    if any(controlled_roles) and (not args.role_based_fast or not args.max_phases):
        parser.error("controlled role commands require --role-based-fast and finite --max-phases")
    for value in (
        args.hard_interval_ms, args.telegram_interval_ms,
        args.hot_target_interval_ms,
        args.hot_target_other_interval_ms,
        args.required_interval_ms, args.deep_interval_ms,
    ):
        if value <= 0:
            parser.error("role intervals must be positive")
    return args


def main(argv: Sequence[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    if args.role_based_fast:
        controlled = {
            "hard": args.controlled_hard_command,
            "telegram": args.controlled_telegram_command,
            "hot_target": args.controlled_hot_target_command,
            "hot_target_other": args.controlled_hot_target_other_command,
            "other_required": args.controlled_required_command,
            "deep": args.controlled_deep_command,
        }
        intervals = {
            "hard": args.hard_interval_ms,
            "telegram": args.telegram_interval_ms,
            "hot_target": args.hot_target_interval_ms,
            "hot_target_other": args.hot_target_other_interval_ms,
            "other_required": args.required_interval_ms,
            "deep": args.deep_interval_ms,
        }
        roles = tuple(
            ManagedRole(
                name=name,
                cadence_ns=intervals[name] * 1_000_000,
                command=(controlled[name],) if controlled[name] else tuple(command),
            )
            for name, _default_interval, command in DEFAULT_ROLE_COMMANDS
        )
        return RoleHealthLoop(roles=roles, max_hard_phases=args.max_phases).run()
    if args.controlled_fast_command:
        fast_command = (args.controlled_fast_command,)
        legacy_commands = tuple((f"controlled_{index}", command) for index, command in enumerate(args.controlled_legacy_command))
    else:
        fast_command = DEFAULT_FAST
        legacy_commands = DEFAULT_LEGACY
    return HealthLoop(
        interval_ns=args.fast_interval_ms * 1_000_000,
        legacy_guard_ns=args.legacy_guard_ms * 1_000_000,
        max_phases=args.max_phases,
        fast_command=fast_command,
        legacy_commands=legacy_commands,
    ).run()


if __name__ == "__main__":
    raise SystemExit(main())
