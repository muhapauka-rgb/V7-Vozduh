#!/usr/bin/env python3
"""Existing V7 registry-wide route owner with Reset Core class migration mode."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import ipaddress
import json
import os
from pathlib import Path
import subprocess
import sys
import time

from admin_core import operator_execution


STATE_DIR = Path(os.environ.get("V7_STATE_DIR", "/opt/v7/egress/state"))
USERS = Path(os.environ.get("V7_USERS_REGISTRY", STATE_DIR / "users.registry"))
EGRESS = Path(os.environ.get("V7_EGRESS_REGISTRY", STATE_DIR / "egress.registry"))
CLASSES = Path(os.environ.get("V7_ROUTE_CLASSES_REG", "/opt/v7/policy/route-classes.registry"))
POLICY = Path(os.environ.get("V7_POLICY_FILE", "/etc/v7/policy.json"))
NFT_FAMILY = "inet"
NFT_TABLE = "v7_routing_core"
RULE_PREF_BASE = 200
TABLE_BASE = 200
MARK_BASE = 0x200


def rows(path: Path) -> list[dict[str, str]]:
    result = []
    for raw in path.read_text(encoding="utf-8").splitlines():
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        row = {}
        for token in raw.split():
            if "=" in token:
                key, value = token.split("=", 1)
                row[key] = value
        result.append(row)
    return result


def run(argv: list[str], *, input_text: str = "") -> subprocess.CompletedProcess[str]:
    return subprocess.run(argv, input=input_text or None, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False, timeout=30)


def canonical_hash(value: object) -> str:
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def replace_rule(*, pref: int, selector: list[str], table: int) -> None:
    while run(["ip", "rule", "del", "pref", str(pref), *selector, "table", str(table)]).returncode == 0:
        pass
    result = run(["ip", "rule", "add", "pref", str(pref), *selector, "table", str(table)])
    if result.returncode:
        raise RuntimeError(result.stdout)


def exact_reset_authority(policy_path: Path) -> tuple[bool, dict]:
    try:
        policy = json.loads(policy_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return False, {}
    promotion = policy.get("routing_core_primary_promotion")
    promotion = promotion if isinstance(promotion, dict) else {}
    required = {
        "schema_version": "v7.routing-core-primary-promotion.v1",
        "active_program": "V7_SYSTEM_RESET_AND_ROUTING_CORE_MIGRATION_PROGRAM_V1",
        "state": "APPROVED",
        "scope": "ALL_COMPATIBLE_PRODUCTION_USERS",
        "legacy_fallback_required": True,
    }
    ok = all(promotion.get(key) == value for key, value in required.items())
    preimage = dict(promotion)
    supplied = str(preimage.pop("contract_hash", "") or "")
    preimage.pop("contract_id", None)
    ok = ok and bool(supplied) and canonical_hash(preimage) == supplied
    return ok, promotion


def core_primary_operation_authority(
    *,
    emergency_failover: bool = False,
    operation_id: str = "",
    selected_move_hash: str = "",
    max_users: int = 0,
) -> tuple[bool, dict]:
    """Resolve only an existing Core-primary authority for this operation.

    Reset migrations retain their original exact contract.  A bounded ordinary
    failed-source recovery may instead use the already-issued standing
    delegated policy, but only while the existing operation-scoped execution
    control owner binds this exact emergency operation.  This does not select
    users or a target and cannot turn the routing owner into an Authority.
    """
    reset_ok, reset = exact_reset_authority(POLICY)
    if reset_ok:
        return True, {"authority_kind": "reset", **reset}
    if not emergency_failover:
        return False, {}
    normalized_count = int(max_users or 0)
    if not operation_id or not selected_move_hash or not 2 <= normalized_count <= 4:
        return False, {}
    try:
        root = json.loads(POLICY.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return False, {}
    contract = root.get("delegated_autonomy_policy")
    contract = contract if isinstance(contract, dict) else {}
    validation = operator_execution.validate_standing_delegated_operational_policy(
        contract,
        audit_records=operator_execution.read_live_execution_lineage_records(
            operator_execution.DEFAULT_PRODUCTION_OPERATOR_EXECUTION_AUDIT_STORE,
        ),
    )
    policy = validation.get("policy") if isinstance(validation.get("policy"), dict) else {}
    control = operator_execution.autonomous_execution_control_decision(
        mutation_kind="forward",
        action_class="EMERGENCY_FAILOVER",
        operation_id=operation_id,
        selected_move_hash=selected_move_hash,
        source_bundle_hash=str((operator_execution.autonomous_execution_control_state().get("source_bundle_hash") or "")),
        snapshot_bundle_hash=str((operator_execution.autonomous_execution_control_state().get("snapshot_bundle_hash") or "")),
        max_users=normalized_count,
    )
    valid = (
        bool(validation.get("ok"))
        and str(policy.get("policy_state") or "") == "APPROVED"
        and str(policy.get("current_mode") or "") == "DELEGATED_AUTONOMY"
        and policy.get("runtime_apply_enabled") is True
        and policy.get("self_expansion_allowed") is False
        and int(policy.get("max_users_per_action") or 0) >= normalized_count
        and int(policy.get("max_concurrent_transactions") or 0) == 1
        and bool(control.get("allowed_forward_mutation"))
    )
    if not valid:
        return False, {}
    return True, {
        "authority_kind": "standing_emergency_failover",
        "contract_id": str(contract.get("contract_id") or ""),
        "contract_hash": str(contract.get("contract_hash") or ""),
        "operation_id": operation_id,
        "selected_move_hash": selected_move_hash,
    }


def classes_for_users(
    users: list[dict[str, str]], egress: dict[str, dict[str, str]],
) -> list[dict]:
    """Derive the existing Core-primary classes for an in-memory registry view."""
    classes = []
    for index, name in enumerate(sorted({row.get("current", "") for row in users})):
        target = egress.get(name)
        if not name or not target or not target.get("interface"):
            raise ValueError(f"unresolved_current_egress:{name}")
        classes.append({
            "class_id": "current_" + hashlib.sha256(name.encode()).hexdigest()[:16],
            "current_egress": name,
            "interface": target["interface"],
            "mark": MARK_BASE + index,
            "table": TABLE_BASE + index,
            "members": sorted(row["ip"] for row in users if row.get("current") == name),
        })
    return classes


def derived_classes() -> tuple[list[dict], list[dict]]:
    users = [row for row in rows(USERS) if row.get("enabled", "0") == "1"]
    egress = {
        row.get("id", ""): row
        for row in rows(EGRESS)
        if row.get("enabled", "0") == "1"
    }
    return users, classes_for_users(users, egress)


def legacy_sync() -> dict:
    users, classes = derived_classes()
    by_egress = {row["current_egress"]: row for row in classes}
    mutations = 0
    for user in users:
        target = by_egress[user["current"]]
        table = int(user["table"])
        proc = run(["ip", "route", "replace", "default", "dev", target["interface"], "table", str(table)])
        if proc.returncode:
            raise RuntimeError(proc.stdout)
        replace_rule(pref=table, selector=["from", user["ip"]], table=table)
        mutations += 1
    return {"status": "LEGACY_PER_USER_SYNC_PASS", "users": len(users), "mutations": mutations}


def scoped_user_sync(user_ip: str) -> dict:
    """Reconcile one existing registry identity without changing assignment."""
    try:
        canonical_ip = str(ipaddress.ip_address(str(user_ip or "")))
    except ValueError:
        return {"status": "STOP_SAFE", "blockers": ["scoped_user_ip_invalid"], "runtime_mutation": False}
    users = [
        row for row in rows(USERS)
        if row.get("ip") == canonical_ip and row.get("enabled", "0") == "1"
    ]
    if len(users) != 1:
        return {"status": "STOP_SAFE", "blockers": ["scoped_user_registry_identity_not_unique"], "runtime_mutation": False}
    user = users[0]
    targets = [
        row for row in rows(EGRESS)
        if row.get("id") == user.get("current")
        and row.get("enabled", "0") == "1"
        and row.get("interface")
    ]
    if len(targets) != 1:
        return {"status": "STOP_SAFE", "blockers": ["scoped_user_current_egress_not_unique_or_disabled"], "runtime_mutation": False}
    try:
        table = int(str(user.get("table") or ""))
    except ValueError:
        return {"status": "STOP_SAFE", "blockers": ["scoped_user_route_table_invalid"], "runtime_mutation": False}
    target = targets[0]
    proc = run([
        "ip", "route", "replace", "default", "dev", target["interface"],
        "table", str(table),
    ])
    if proc.returncode:
        return {"status": "STOP_SAFE", "blockers": ["scoped_user_route_write_failed"], "runtime_mutation": False}
    try:
        replace_rule(pref=table, selector=["from", canonical_ip], table=table)
    except RuntimeError:
        return {"status": "STOP_SAFE", "blockers": ["scoped_user_rule_write_failed"], "runtime_mutation": False}
    return {
        "status": "SCOPED_USER_SYNC_PASS",
        "user": canonical_ip,
        "current_egress": str(user.get("current") or ""),
        "interface": target["interface"],
        "table": table,
        "assignment_changed": False,
        "users": 1,
        "mutations": 1,
        "runtime_mutation": True,
    }


def retire_legacy_primary_routes(users: list[dict[str, str]]) -> dict:
    """Remove only the superseded per-user primary rules/routes.

    The registry facts and legacy_sync builder remain the explicit fallback;
    no fallback artifact or semantic owner is deleted.
    """
    rules_removed = 0
    routes_removed = 0
    for user in users:
        table = int(user["table"])
        while run(["ip", "rule", "del", "pref", str(table), "from", user["ip"], "table", str(table)]).returncode == 0:
            rules_removed += 1
        if run(["ip", "route", "del", "default", "table", str(table)]).returncode == 0:
            routes_removed += 1
    return {"rules_removed": rules_removed, "routes_removed": routes_removed}


def core_primary_apply() -> dict:
    authority_ok, authority = exact_reset_authority(POLICY)
    if not authority_ok:
        return {"status": "STOP_SAFE", "blockers": ["exact_reset_core_primary_promotion_contract_required"], "runtime_mutation": False}
    users, classes = derived_classes()
    lines = [f"delete table {NFT_FAMILY} {NFT_TABLE}", f"add table {NFT_FAMILY} {NFT_TABLE}", f"add map {NFT_FAMILY} {NFT_TABLE} user_class {{ type ipv4_addr : mark; }}", f"add map {NFT_FAMILY} {NFT_TABLE} class_egress {{ type mark : mark; }}", f"add chain {NFT_FAMILY} {NFT_TABLE} ingress {{ type filter hook prerouting priority -160; policy accept; }}"]
    user_elements = []
    class_elements = []
    for row in classes:
        user_elements.extend(f"{ip} : 0x{row['mark']:x}" for ip in row["members"])
        class_elements.append(f"0x{row['mark']:x} : 0x{row['mark']:x}")
    lines.extend([f"add element {NFT_FAMILY} {NFT_TABLE} user_class {{ {', '.join(user_elements)} }}", f"add element {NFT_FAMILY} {NFT_TABLE} class_egress {{ {', '.join(class_elements)} }}", f"add rule {NFT_FAMILY} {NFT_TABLE} ingress iifname \"wg0\" counter meta mark set ip saddr map @user_class", f"add rule {NFT_FAMILY} {NFT_TABLE} ingress iifname \"wg0\" counter meta mark set meta mark map @class_egress"])
    # Removing a missing table is allowed only as the first command through a
    # separate idempotent operation; the apply transaction itself is atomic.
    run(["nft", "delete", "table", NFT_FAMILY, NFT_TABLE])
    transaction = "\n".join(lines[1:]) + "\n"
    proc = run(["nft", "-f", "-"], input_text=transaction)
    if proc.returncode:
        return {"status": "STOP_SAFE", "blockers": ["nft_atomic_apply_failed", proc.stdout[-1000:]], "runtime_mutation": False}
    try:
        for index, row in enumerate(classes):
            result = run(["ip", "route", "replace", "default", "dev", row["interface"], "table", str(row["table"])])
            if result.returncode:
                raise RuntimeError(result.stdout)
            replace_rule(pref=RULE_PREF_BASE + index, selector=["fwmark", hex(row["mark"])], table=row["table"])
    except RuntimeError as exc:
        core_primary_fallback()
        return {"status": "STOP_SAFE_FALLBACK_RESTORED", "blockers": [str(exc)], "runtime_mutation": False}
    retired = retire_legacy_primary_routes(users)
    return {"status": "CORE_PRIMARY_APPLY_PASS", "users": len(users), "classes": len(classes), "membership_generation": canonical_hash(users), "class_generation": canonical_hash([{key: value for key, value in row.items() if key != "members"} for row in classes]), "authority_contract_id": authority.get("contract_id", ""), "legacy_primary_routes_retired": retired, "legacy_fallback_ready": True, "runtime_mutation": True}


def core_primary_fallback() -> dict:
    run(["nft", "delete", "table", NFT_FAMILY, NFT_TABLE])
    _, classes = derived_classes()
    for index, row in enumerate(classes):
        while run(["ip", "rule", "del", "pref", str(RULE_PREF_BASE + index), "fwmark", hex(row["mark"]), "table", str(row["table"])]).returncode == 0:
            pass
    legacy = legacy_sync()
    return {"status": "CORE_PRIMARY_FALLBACK_PASS", "legacy": legacy, "core_table_present": False}


def core_primary_cohort_commit(
    members: list[str], operation_id: str = "", *, emergency_failover: bool = False,
    selected_move_hash: str = "",
) -> dict:
    """Atomically update only an already-governed Core-primary cohort.

    The canonical users registry remains the sole desired-state source.  This
    operation is deliberately narrower than ``core_primary_apply``: it is
    lawful only when the live table is otherwise exact and the cohort does not
    create, retire or renumber a routing class.  Those cases retain the
    existing full-projection owner/fallback instead of silently widening this
    bounded operation.
    """
    authority_ok, authority = core_primary_operation_authority(
        emergency_failover=emergency_failover, operation_id=operation_id,
        selected_move_hash=selected_move_hash, max_users=len(members),
    )
    normalized: list[str] = []
    try:
        normalized = sorted({str(ipaddress.ip_address(value)) for value in members})
    except ValueError:
        return {"status": "STOP_SAFE", "blockers": ["core_primary_cohort_member_invalid"], "runtime_mutation": False}
    if not authority_ok:
        return {"status": "STOP_SAFE", "blockers": ["exact_reset_core_primary_promotion_contract_required"], "runtime_mutation": False}
    if not 2 <= len(normalized) <= 4:
        return {"status": "STOP_SAFE", "blockers": ["core_primary_cohort_scope_must_be_2_to_4"], "runtime_mutation": False}
    users, classes = derived_classes()
    users_by_ip = {str(row.get("ip") or ""): row for row in users}
    if any(ip not in users_by_ip for ip in normalized):
        return {"status": "STOP_SAFE", "blockers": ["core_primary_cohort_registry_member_not_enabled"], "runtime_mutation": False}
    nft = run(["nft", "-j", "list", "table", NFT_FAMILY, NFT_TABLE])
    try:
        nft_payload = json.loads(nft.stdout or "{}") if nft.returncode == 0 else {}
    except json.JSONDecodeError:
        nft_payload = {}
    actual_user_class, user_class_readable = nft_map_elements(nft_payload, "user_class")
    actual_class_egress, class_egress_readable = nft_map_elements(nft_payload, "class_egress")
    expected_user_class = {
        (str(member), str(row["mark"]))
        for row in classes for member in row["members"]
    }
    expected_class_egress = {
        (str(row["mark"]), str(row["mark"])) for row in classes
    }
    selected = set(normalized)
    actual_outside = {entry for entry in actual_user_class if entry[0] not in selected}
    expected_outside = {entry for entry in expected_user_class if entry[0] not in selected}
    expected_selected = sorted(entry for entry in expected_user_class if entry[0] in selected)
    if (
        not user_class_readable
        or not class_egress_readable
        or actual_outside != expected_outside
        or actual_class_egress != expected_class_egress
        or len(expected_selected) != len(normalized)
    ):
        return {
            "status": "STOP_SAFE",
            "blockers": ["core_primary_cohort_baseline_not_exact_or_class_delta_required"],
            "runtime_mutation": False,
        }
    # This nft batch is one kernel-visible projection commit.  It never
    # recreates the table or touches entries outside ``normalized``.
    element_text = ", ".join(f"{ip} : 0x{int(mark):x}" for ip, mark in expected_selected)
    proc = run([
        "nft", "-f", "-",
    ], input_text=(
        # The deployed nft version has neither ``replace element`` nor
        # duplicate-tolerant ``add element``.  Its transactional batch keeps
        # the delete/add pair atomic: there is no kernel-visible interval and
        # no table recreation or per-user full projection.
        f"delete element {NFT_FAMILY} {NFT_TABLE} user_class {{ {', '.join(ip for ip, _ in expected_selected)} }}\n"
        f"add element {NFT_FAMILY} {NFT_TABLE} user_class {{ {element_text} }}\n"
    ))
    if proc.returncode:
        return {"status": "STOP_SAFE", "blockers": ["core_primary_cohort_nft_atomic_commit_failed", proc.stdout[-1000:]], "runtime_mutation": False}
    whole_system = verify(
        emergency_failover=emergency_failover, operation_id=operation_id,
        selected_move_hash=selected_move_hash, max_users=len(normalized),
    )
    if whole_system.get("status") != "CORE_PRIMARY_VERIFY_PASS":
        return {
            "status": "STOP_SAFE",
            "blockers": ["core_primary_cohort_post_commit_whole_system_verify_failed"],
            "whole_system": whole_system,
            "runtime_mutation": True,
        }
    # The route writer stages a temporary exact source rule so its immediate
    # kernel write is observable.  Once the same Core-primary owner has
    # published the cohort map, that per-user primary rule is superseded.
    # Retire only the exact cohort, never the fallback implementation or a
    # broad population projection.
    retired = retire_legacy_primary_routes([
        users_by_ip[ip] for ip in normalized
    ])
    whole_system = verify(
        emergency_failover=emergency_failover, operation_id=operation_id,
        selected_move_hash=selected_move_hash, max_users=len(normalized),
    )
    if whole_system.get("status") != "CORE_PRIMARY_VERIFY_PASS":
        return {
            "status": "STOP_SAFE",
            "blockers": ["core_primary_cohort_post_retirement_verify_failed"],
            "whole_system": whole_system,
            "runtime_mutation": True,
        }
    return {
        "status": "CORE_PRIMARY_COHORT_COMMIT_PASS",
        "operation_id": operation_id,
        "affected_users": len(normalized),
        "affected_user_fingerprint": canonical_hash(normalized),
        "membership_generation": canonical_hash(users),
        "class_generation": canonical_hash([{key: value for key, value in row.items() if key != "members"} for row in classes]),
        "authority_contract_id": authority.get("contract_id", ""),
        "affected_scope_verified": True,
        "whole_system": whole_system,
        "retired_legacy_primary_routes": retired,
        "runtime_mutation": True,
    }


def core_primary_cohort_admissible(
    members: list[str], target_egress: str, *, emergency_failover: bool = False,
    operation_id: str = "", selected_move_hash: str = "",
) -> dict:
    """Prove that a proposed cohort can use the bounded Core-primary commit.

    This is deliberately read-only and is called before an N10 contract is
    consumed. A bounded map replacement is lawful only when moving the exact
    members leaves every non-member's class mark and the class-egress map
    untouched. Otherwise the existing full projection owner would be needed,
    so the bounded production transaction must stop before it stages a user.
    """
    authority_ok, authority = core_primary_operation_authority(
        emergency_failover=emergency_failover, operation_id=operation_id,
        selected_move_hash=selected_move_hash, max_users=len(members),
    )
    try:
        normalized = sorted({str(ipaddress.ip_address(value)) for value in members})
    except ValueError:
        return {"status": "STOP_SAFE", "blockers": ["core_primary_cohort_member_invalid"], "runtime_mutation": False}
    target = str(target_egress or "").strip()
    if not authority_ok:
        return {"status": "STOP_SAFE", "blockers": ["exact_reset_core_primary_promotion_contract_required"], "runtime_mutation": False}
    if not 2 <= len(normalized) <= 4:
        return {"status": "STOP_SAFE", "blockers": ["core_primary_cohort_scope_must_be_2_to_4"], "runtime_mutation": False}
    users, classes = derived_classes()
    users_by_ip = {str(row.get("ip") or ""): row for row in users}
    if any(ip not in users_by_ip for ip in normalized):
        return {"status": "STOP_SAFE", "blockers": ["core_primary_cohort_registry_member_not_enabled"], "runtime_mutation": False}
    egress = {
        row.get("id", ""): row
        for row in rows(EGRESS)
        if row.get("enabled", "0") == "1"
    }
    if target not in egress or not egress[target].get("interface"):
        return {"status": "STOP_SAFE", "blockers": ["core_primary_cohort_target_not_enabled"], "runtime_mutation": False}
    nft = run(["nft", "-j", "list", "table", NFT_FAMILY, NFT_TABLE])
    try:
        nft_payload = json.loads(nft.stdout or "{}") if nft.returncode == 0 else {}
    except json.JSONDecodeError:
        nft_payload = {}
    actual_user_class, user_class_readable = nft_map_elements(nft_payload, "user_class")
    actual_class_egress, class_egress_readable = nft_map_elements(nft_payload, "class_egress")
    expected_current_user_class = {
        (str(member), str(row["mark"]))
        for row in classes for member in row["members"]
    }
    expected_current_class_egress = {
        (str(row["mark"]), str(row["mark"])) for row in classes
    }
    if (
        not user_class_readable
        or not class_egress_readable
        or actual_user_class != expected_current_user_class
        or actual_class_egress != expected_current_class_egress
    ):
        return {"status": "STOP_SAFE", "blockers": ["core_primary_cohort_baseline_not_exact"], "runtime_mutation": False}
    selected = set(normalized)
    prospective_users = [
        {**row, "current": target} if str(row.get("ip") or "") in selected else dict(row)
        for row in users
    ]
    prospective_classes = classes_for_users(prospective_users, egress)
    prospective_user_class = {
        (str(member), str(row["mark"]))
        for row in prospective_classes for member in row["members"]
    }
    prospective_class_egress = {
        (str(row["mark"]), str(row["mark"])) for row in prospective_classes
    }
    current_outside = {
        entry for entry in expected_current_user_class if entry[0] not in selected
    }
    prospective_outside = {
        entry for entry in prospective_user_class if entry[0] not in selected
    }
    if (
        current_outside != prospective_outside
        or actual_class_egress != prospective_class_egress
        or len([entry for entry in prospective_user_class if entry[0] in selected]) != len(normalized)
    ):
        return {"status": "CORE_PRIMARY_COHORT_NOT_ADMISSIBLE", "blockers": ["core_primary_cohort_changes_nonmember_class_or_class_egress"], "runtime_mutation": False}
    return {
        "status": "CORE_PRIMARY_COHORT_ADMISSIBLE",
        "affected_users": len(normalized),
        "affected_user_fingerprint": canonical_hash(normalized),
        "target_egress": target,
        "authority_contract_id": authority.get("contract_id", ""),
        "runtime_mutation": False,
    }


def nft_map_elements(payload: object, name: str) -> tuple[set[tuple[str, str]], bool]:
    """Return the exact live nft map contents without making them a new state source."""
    if not isinstance(payload, dict):
        return set(), False
    entries = payload.get("nftables")
    if not isinstance(entries, list):
        return set(), False
    for entry in entries:
        mapping = entry.get("map") if isinstance(entry, dict) else None
        if not isinstance(mapping, dict) or str(mapping.get("name") or "") != name:
            continue
        elements = mapping.get("elem")
        if not isinstance(elements, list):
            return set(), False
        normalized: set[tuple[str, str]] = set()
        for element in elements:
            if not isinstance(element, list) or len(element) != 2:
                return set(), False
            normalized.add((str(element[0]), str(element[1])))
        return normalized, True
    return set(), False


def verify(
    *, emergency_failover: bool = False, operation_id: str = "",
    selected_move_hash: str = "", max_users: int = 0,
) -> dict:
    authority_ok, authority = core_primary_operation_authority(
        emergency_failover=emergency_failover, operation_id=operation_id,
        selected_move_hash=selected_move_hash, max_users=max_users,
    )
    users, classes = derived_classes()
    nft = run(["nft", "-j", "list", "table", NFT_FAMILY, NFT_TABLE])
    rules = run(["ip", "-j", "rule", "show"])
    rule_rows = json.loads(rules.stdout or "[]") if rules.returncode == 0 else []
    marks = {str(row.get("fwmark") or "") for row in rule_rows}
    missing = [hex(row["mark"]) for row in classes if hex(row["mark"]) not in marks]
    try:
        nft_payload = json.loads(nft.stdout or "{}") if nft.returncode == 0 else {}
    except json.JSONDecodeError:
        nft_payload = {}
    actual_user_class, user_class_readable = nft_map_elements(
        nft_payload, "user_class",
    )
    actual_class_egress, class_egress_readable = nft_map_elements(
        nft_payload, "class_egress",
    )
    expected_user_class = {
        (str(member), str(row["mark"]))
        for row in classes for member in row["members"]
    }
    expected_class_egress = {
        (str(row["mark"]), str(row["mark"])) for row in classes
    }
    user_class_missing = expected_user_class - actual_user_class
    user_class_unexpected = actual_user_class - expected_user_class
    class_egress_missing = expected_class_egress - actual_class_egress
    class_egress_unexpected = actual_class_egress - expected_class_egress
    maps_ok = (
        user_class_readable
        and class_egress_readable
        and not user_class_missing
        and not user_class_unexpected
        and not class_egress_missing
        and not class_egress_unexpected
    )
    return {
        "status": "CORE_PRIMARY_VERIFY_PASS" if authority_ok and nft.returncode == 0 and not missing and maps_ok else "STOP_SAFE",
        "authority_contract_id": authority.get("contract_id", ""),
        "users": len(users),
        "classes": len(classes),
        "nft_table_present": nft.returncode == 0,
        "missing_mark_rules": missing,
        "user_class_map_readable": user_class_readable,
        "user_class_expected_count": len(expected_user_class),
        "user_class_actual_count": len(actual_user_class),
        "user_class_missing_count": len(user_class_missing),
        "user_class_unexpected_count": len(user_class_unexpected),
        "class_egress_map_readable": class_egress_readable,
        "class_egress_expected_count": len(expected_class_egress),
        "class_egress_actual_count": len(actual_class_egress),
        "class_egress_missing_count": len(class_egress_missing),
        "class_egress_unexpected_count": len(class_egress_unexpected),
        "legacy_primary_rules_present": any(str(row.get("priority") or "") in {str(user.get("table") or "") for user in users} for row in rule_rows),
        "legacy_fallback_ready": all(str(user.get("table") or "") and str(user.get("ip") or "") for user in users),
    }


def core_primary_active(
    *, emergency_failover: bool = False, operation_id: str = "",
    selected_move_hash: str = "", max_users: int = 0,
) -> dict:
    """Expose the current Core-primary contract without inferring it elsewhere."""
    authority_ok, authority = core_primary_operation_authority(
        emergency_failover=emergency_failover, operation_id=operation_id,
        selected_move_hash=selected_move_hash, max_users=max_users,
    )
    return {
        "status": "CORE_PRIMARY_ACTIVE" if authority_ok else "CORE_PRIMARY_INACTIVE",
        "authority_contract_id": authority.get("contract_id", ""),
        "runtime_mutation": False,
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--core-primary-apply", action="store_true")
    parser.add_argument("--core-primary-cohort-commit", action="store_true")
    parser.add_argument("--core-primary-cohort-admissible", action="store_true")
    parser.add_argument("--core-primary-fallback", action="store_true")
    parser.add_argument("--core-primary-verify", action="store_true")
    parser.add_argument("--core-primary-active", action="store_true")
    parser.add_argument("--user", default="")
    parser.add_argument("--cohort-user", action="append", default=[])
    parser.add_argument("--cohort-size", type=int, default=0)
    parser.add_argument("--cohort-target", default="")
    parser.add_argument("--operation-id", default="")
    parser.add_argument("--selected-move-hash", default="")
    parser.add_argument("--emergency-failover-cohort", action="store_true")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    lock_path = Path(os.environ.get("V7_ROUTING_LOCK", "/tmp/v7-routing.lock"))
    with lock_path.open("a+") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        if args.user:
            result = scoped_user_sync(args.user)
        elif args.core_primary_cohort_commit:
            result = core_primary_cohort_commit(
                args.cohort_user, args.operation_id,
                emergency_failover=args.emergency_failover_cohort,
                selected_move_hash=args.selected_move_hash,
            )
        elif args.core_primary_cohort_admissible:
            result = core_primary_cohort_admissible(
                args.cohort_user, args.cohort_target,
                emergency_failover=args.emergency_failover_cohort,
                operation_id=args.operation_id,
                selected_move_hash=args.selected_move_hash,
            )
        elif args.core_primary_apply:
            result = core_primary_apply()
        elif args.core_primary_fallback:
            result = core_primary_fallback()
        elif args.core_primary_verify:
            result = verify()
        elif args.core_primary_active:
            result = core_primary_active(
                emergency_failover=args.emergency_failover_cohort,
                operation_id=args.operation_id,
                selected_move_hash=args.selected_move_hash,
                max_users=args.cohort_size or len(args.cohort_user),
            )
        else:
            authority_ok, _ = exact_reset_authority(POLICY)
            result = core_primary_apply() if authority_ok else legacy_sync()
    print(json.dumps(result, sort_keys=True) if args.json else json.dumps(result, indent=2, sort_keys=True))
    return 0 if result.get("status", "").endswith(
        ("PASS", "ACTIVE", "INACTIVE", "ADMISSIBLE")
    ) else 2


if __name__ == "__main__":
    raise SystemExit(main())
