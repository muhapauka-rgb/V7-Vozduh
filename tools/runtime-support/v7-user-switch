#!/usr/bin/env bash
set -euo pipefail

v7_route_timing_now() {
  if [ -r /proc/uptime ]; then
    read -r now _ < /proc/uptime
    printf '%s' "$now"
  else
    date +%s
  fi
}

if [ "${V7_LOCKED_USER_SWITCH:-0}" != "1" ]; then
  export V7_LOCKED_USER_SWITCH=1
  export V7_ROUTE_TIMING_LOCK_STARTED="$(v7_route_timing_now)"
  # The only route writer remains globally serialised.  A caller that is
  # explicitly latency-bounded (the operator UI) must be able to distinguish
  # a held writer from a failed route mutation, so it can safely retry through
  # the same owner instead of reporting a false failed switch.
  if flock -E 75 -w "${V7_LOCK_WAIT:-20}" "${V7_USERS_LOCK:-/tmp/v7-users.lock}" "$0" "$@"; then
    exit 0
  else
    lock_rc=$?
    if [ "$lock_rc" = "75" ]; then
      echo "V7_ROUTE_WRITE_FAILURE=ROUTE_WRITE_LOCK_BUSY"
    fi
    exit "$lock_rc"
  fi
fi

V7_ROUTE_TIMING_ENTERED="$(v7_route_timing_now)"

USER_IP="${1:-}"
EGRESS="${2:-}"
STATE_DIR="${V7_STATE_DIR:-/opt/v7/egress/state}"
REG="${V7_USERS_REGISTRY:-$STATE_DIR/users.registry}"
LIB="${V7_EGRESS_LIB:-/usr/local/lib/v7-egress-lib}"
[ -r "$LIB" ] && . "$LIB"
if command -v v7_load_node_env >/dev/null 2>&1; then
  v7_load_node_env
fi

if [ -z "$USER_IP" ] || [ -z "$EGRESS" ]; then
  echo "V7_ROUTE_WRITE_FAILURE=ROUTE_INPUT_INVALID"
  exit 1
fi
v7_safe_ip "$USER_IP" || { echo "V7_ROUTE_WRITE_FAILURE=ROUTE_INPUT_INVALID"; exit 1; }
v7_safe_id "$EGRESS" || { echo "V7_ROUTE_WRITE_FAILURE=ROUTE_INPUT_INVALID"; exit 1; }

line=$(grep "ip=$USER_IP " "$REG" || true)
if [ -z "$line" ]; then
  echo "V7_ROUTE_WRITE_FAILURE=ROUTE_USER_ASSIGNMENT_MISSING"
  exit 1
fi

ip="$(v7_kv_get "$line" ip)"
current="$(v7_kv_get "$line" current)"
table="$(v7_kv_get "$line" table)"
enabled="$(v7_kv_get "$line" enabled)"
[[ "$table" =~ ^[0-9]+$ ]] || { echo "V7_ROUTE_WRITE_FAILURE=ROUTE_TABLE_INVALID"; exit 1; }
FROM_EGRESS="${current:-unknown}"

if ! command -v v7_egress_exists >/dev/null 2>&1 || ! v7_egress_exists "$EGRESS"; then
  echo "V7_ROUTE_WRITE_FAILURE=ROUTE_EGRESS_UNKNOWN"
  exit 1
fi
if ! v7_egress_enabled "$EGRESS"; then
  echo "V7_ROUTE_WRITE_FAILURE=ROUTE_EGRESS_DISABLED"
  exit 1
fi
dev="$(v7_egress_interface "$EGRESS" || true)"
[ -n "$dev" ] || { echo "V7_ROUTE_WRITE_FAILURE=ROUTE_EGRESS_INTERFACE_MISSING"; exit 1; }
from_dev="$(v7_egress_interface "$current" || true)"

CONTROL_GENERATION="${V7_EXECUTION_CONTROL_GENERATION:-}"
MUTATION_KIND="${V7_EXECUTION_MUTATION_KIND:-}"
OPERATION_ID="${V7_EXECUTION_OPERATION_ID:-}"
ACTION_CLASS="${V7_EXECUTION_ACTION_CLASS:-}"
SELECTED_MOVE_HASH="${V7_EXECUTION_SELECTED_MOVE_HASH:-}"
SOURCE_BUNDLE_HASH="${V7_EXECUTION_SOURCE_BUNDLE_HASH:-}"
SNAPSHOT_BUNDLE_HASH="${V7_EXECUTION_SNAPSHOT_BUNDLE_HASH:-}"
MAX_USERS="${V7_EXECUTION_MAX_USERS:-}"
CONTROL_FILE="${V7_ADMIN_SAFE_MODE_FILE:-/etc/v7/admin/safe-mode.json}"
CONTROL_FILE_HASH="${V7_EXECUTION_CONTROL_FILE_HASH:-}"
[ -n "$CONTROL_GENERATION" ] || { echo "STOP_SAFE: execution control generation missing"; exit 2; }
[ -n "$MUTATION_KIND" ] || { echo "STOP_SAFE: execution mutation kind missing"; exit 2; }
[ -n "$OPERATION_ID" ] || { echo "STOP_SAFE: execution operation id missing"; exit 2; }
[ -n "$ACTION_CLASS" ] || { echo "STOP_SAFE: execution action class missing"; exit 2; }
if [ "$MUTATION_KIND" = "forward" ]; then
  [ -n "$SELECTED_MOVE_HASH" ] || { echo "STOP_SAFE: selected move hash missing"; exit 2; }
  [ -n "$SOURCE_BUNDLE_HASH" ] || { echo "STOP_SAFE: source bundle hash missing"; exit 2; }
  [ -n "$SNAPSHOT_BUNDLE_HASH" ] || { echo "STOP_SAFE: snapshot bundle hash missing"; exit 2; }
  if [ "$MAX_USERS" != "1" ]; then
    # A group is lawful only when the existing operation control explicitly
    # names a bounded 2..4-member cohort.  N10 is one such contract; the
    # already-admitted ordinary emergency-failover contract is the other.
    # In both cases this writer still re-reads the exact operation identity,
    # source/snapshot hashes and member bound above.  Every other invocation
    # retains the historical one-user fence.
    { [ "$ACTION_CLASS" = "N10_SMALL_COHORT" ] \
      || [ "$ACTION_CLASS" = "EMERGENCY_FAILOVER" ]; } \
      && [[ "$MAX_USERS" =~ ^[2-4]$ ]] \
      || { echo "STOP_SAFE: max users outside exact action scope"; exit 2; }
  fi
fi

validator=(
  v7-operator-execution-packet
  --check-autonomous-execution-control
  --execution-control-file "$CONTROL_FILE"
  --expected-breaker-generation "$CONTROL_GENERATION"
  --mutation-kind "$MUTATION_KIND"
  --action-class "$ACTION_CLASS"
  --operation-id "$OPERATION_ID"
  --json
)
if [ "$MUTATION_KIND" = "forward" ]; then
  validator+=(
    --selected-move-hash "$SELECTED_MOVE_HASH"
    --source-bundle-hash "$SOURCE_BUNDLE_HASH"
    --snapshot-bundle-hash "$SNAPSHOT_BUNDLE_HASH"
    --max-users "$MAX_USERS"
  )
fi
if [ "$MUTATION_KIND" = "rollback" ]; then
  [ "${V7_EXECUTION_ROLLBACK_CERTIFIED:-0}" = "1" ] || { echo "STOP_SAFE: rollback context uncertified"; exit 2; }
  validator+=(--rollback-certified)
fi
# The in-memory Planner owner validates this exact operation immediately
# before invoking the route writer.  When it supplies the hash of that same
# control file, re-reading the bytes here proves that the decision surface did
# not change across the process boundary without paying for a third Python
# import. Missing, malformed or changed hashes retain the established owner
# CLI and fail closed exactly as before.
CONTROL_HASH_REUSED=0
if [ "$MUTATION_KIND" = "forward" ] \
  && [[ "$CONTROL_FILE_HASH" =~ ^[0-9a-f]{64}$ ]] \
  && [ -r "$CONTROL_FILE" ] \
  && command -v jq >/dev/null 2>&1; then
  if command -v sha256sum >/dev/null 2>&1; then
    current_control_hash="$(sha256sum "$CONTROL_FILE" 2>/dev/null | awk '{print $1}')"
  elif command -v shasum >/dev/null 2>&1; then
    current_control_hash="$(shasum -a 256 "$CONTROL_FILE" 2>/dev/null | awk '{print $1}')"
  else
    current_control_hash=""
  fi
  if [ "$current_control_hash" = "$CONTROL_FILE_HASH" ] \
    && jq -e \
      --arg generation "$CONTROL_GENERATION" \
      --arg operation "$OPERATION_ID" \
      --arg action "$ACTION_CLASS" \
      --arg move "$SELECTED_MOVE_HASH" \
      --arg source "$SOURCE_BUNDLE_HASH" \
      --arg snapshot "$SNAPSHOT_BUNDLE_HASH" \
      --arg max "$MAX_USERS" \
      '.state == "CLOSED"
       and .scope == "operation"
       and .generation == $generation
       and .operation_id == $operation
      and .action_class == $action
       and .selected_move_hash == $move
       and .source_bundle_hash == $source
       and .snapshot_bundle_hash == $snapshot
       and ((.max_users | tostring) == $max)' "$CONTROL_FILE" >/dev/null 2>&1; then
    CONTROL_HASH_REUSED=1
  fi
fi
if [ "$CONTROL_HASH_REUSED" != "1" ]; then
  "${validator[@]}" >/dev/null || { echo "STOP_SAFE: autonomous execution control denied"; exit 2; }
fi
V7_ROUTE_TIMING_BOOTSTRAP_AND_CONTROL_VALIDATED="$(v7_route_timing_now)"

# The Core-primary owner is the authoritative projection for every compatible
# registry assignment when its approved contract is active.  Ask that owner
# rather than duplicating policy parsing here.  Legacy installs retain their
# existing per-user path unchanged.
CORE_PRIMARY_ACTIVE=0
if command -v v7-routing-sync >/dev/null 2>&1; then
  core_primary_status="$(v7-routing-sync --core-primary-active --json 2>/dev/null || true)"
  if printf '%s\n' "$core_primary_status" | grep -Fq '"status": "CORE_PRIMARY_ACTIVE"'; then
    CORE_PRIMARY_ACTIVE=1
  fi
fi

# A bounded N10 cohort may stage its already-authorized canonical member
# assignments and let the same Core-primary owner publish their nft membership
# delta once.  This is an operation-scoped hand-off, not a second writer: the
# caller must later invoke ``v7-routing-sync --core-primary-cohort-commit``.
# Any other action class keeps the established immediate projection commit.
CORE_PRIMARY_COHORT_DEFER="${V7_CORE_PRIMARY_COHORT_DEFER:-0}"
CORE_PRIMARY_OPERATOR_REBIND="${V7_OPERATOR_PROFILE_REBIND:-0}"
if [ "$CORE_PRIMARY_COHORT_DEFER" = "1" ]; then
  if [ "$CORE_PRIMARY_ACTIVE" != "1" ] \
    || { [ "$ACTION_CLASS" != "N10_SMALL_COHORT" ] \
      && [ "$ACTION_CLASS" != "EMERGENCY_FAILOVER" ]; } \
    || ! [[ "$MAX_USERS" =~ ^[2-4]$ ]]; then
    echo "STOP_SAFE: core-primary cohort defer outside exact bounded cohort scope"
    exit 2
  fi
fi
if [ "$CORE_PRIMARY_OPERATOR_REBIND" = "1" ]; then
  if [ "$CORE_PRIMARY_ACTIVE" != "1" ] \
    || [ "$CORE_PRIMARY_COHORT_DEFER" = "1" ] \
    || [ "$ACTION_CLASS" != "USER_SWITCH" ] \
    || [ "$MAX_USERS" != "1" ]; then
    echo "STOP_SAFE: operator profile rebind outside exact one-user Core-primary scope"
    exit 2
  fi
fi

# A Core-primary rebuild derives from the registry.  Keep a narrowly scoped
# preimage only for the duration of this one governed operation so a failed
# rebuild cannot leave the canonical assignment ahead of the live map.
CORE_REGISTRY_BACKUP=""
CORE_ASSIGNMENT_BACKUP=""
CORE_ASSIGNMENT_EXISTED=0
ASSIGNMENT_FILE="$STATE_DIR/user-${USER_IP}.assign"
cleanup_core_primary_preimage() {
  [ -z "${CORE_REGISTRY_BACKUP:-}" ] || rm -f "$CORE_REGISTRY_BACKUP" || true
  [ -z "${CORE_ASSIGNMENT_BACKUP:-}" ] || rm -f "$CORE_ASSIGNMENT_BACKUP" || true
}
trap cleanup_core_primary_preimage EXIT
if [ "$CORE_PRIMARY_ACTIVE" = "1" ] && [ "$CORE_PRIMARY_COHORT_DEFER" != "1" ]; then
  CORE_REGISTRY_BACKUP="${REG}.core-primary-rollback.$$"
  if ! cp "$REG" "$CORE_REGISTRY_BACKUP"; then
    echo "V7_ROUTE_WRITE_FAILURE=ROUTE_CORE_PRIMARY_PREIMAGE_FAILED"
    exit 1
  fi
  if [ -e "$ASSIGNMENT_FILE" ]; then
    CORE_ASSIGNMENT_EXISTED=1
    CORE_ASSIGNMENT_BACKUP="${ASSIGNMENT_FILE}.core-primary-rollback.$$"
    if ! cp "$ASSIGNMENT_FILE" "$CORE_ASSIGNMENT_BACKUP"; then
      rm -f "$CORE_REGISTRY_BACKUP" || true
      echo "V7_ROUTE_WRITE_FAILURE=ROUTE_CORE_PRIMARY_PREIMAGE_FAILED"
      exit 1
    fi
  fi
fi

echo "[V7] user $USER_IP -> $EGRESS / table $table / dev $dev"
if [ -r /proc/uptime ]; then
  read -r V7_ROUTE_WRITE_STARTED _ < /proc/uptime
  V7_ROUTE_WRITE_CLOCK="linux_monotonic_uptime"
else
  # Production uses Linux monotonic uptime.  The fallback keeps the existing
  # writer testable on non-Linux development hosts without changing a Linux
  # route mutation or its timing source.
  V7_ROUTE_WRITE_STARTED="$(date +%s)"
  V7_ROUTE_WRITE_CLOCK="posix_epoch_seconds_fallback"
fi
if ! route_write_error="$(ip route replace default dev "$dev" table "$table" 2>&1)"; then
  # Keep the route writer's failure observable by its existing consumers without
  # leaking the raw kernel text (which can contain local topology details).
  # This does not alter the mutation, rollback, or authority contract: it only
  # replaces an otherwise opaque non-zero subprocess result with a stable code.
  case "$route_write_error" in
    *"Cannot find device"*) route_write_failure="ROUTE_INTERFACE_UNAVAILABLE" ;;
    *"Network is unreachable"*) route_write_failure="ROUTE_TARGET_UNREACHABLE" ;;
    *"Operation not permitted"*|*"Permission denied"*) route_write_failure="ROUTE_WRITE_PERMISSION_DENIED" ;;
    *"Invalid argument"*) route_write_failure="ROUTE_TABLE_WRITE_INVALID" ;;
    *) route_write_failure="ROUTE_TABLE_WRITE_FAILED" ;;
  esac
  echo "V7_ROUTE_WRITE_FAILURE=$route_write_failure"
  exit 1
fi
# The per-user routing table is ineffective without its source rule.  Reuse
# this existing low-level owner to keep both kernel primitives coherent for
# the exact governed user.  Existing rules are preserved; only a missing
# exact source/table binding is added.
ip_rules="$(ip -4 rule show 2>/dev/null || true)"
if ! printf '%s\n' "$ip_rules" | grep -Fq "from $USER_IP lookup $table" \
  && ! printf '%s\n' "$ip_rules" | grep -Fq "from $USER_IP/32 lookup $table"; then
  if ! rule_write_error="$(ip rule add pref "$table" from "$USER_IP" table "$table" 2>&1)"; then
    if [ -n "$from_dev" ] && ip route replace default dev "$from_dev" table "$table" >/dev/null 2>&1; then
      echo "V7_ROUTE_WRITE_FAILURE=ROUTE_POLICY_RULE_WRITE_FAILED_ROUTE_RESTORED"
    else
      echo "V7_ROUTE_WRITE_FAILURE=ROUTE_POLICY_RULE_WRITE_FAILED_ROLLBACK_FAILED"
    fi
    exit 1
  fi
fi
if [ -r /proc/uptime ]; then
  read -r V7_ROUTE_WRITE_COMPLETED _ < /proc/uptime
else
  V7_ROUTE_WRITE_COMPLETED="$(date +%s)"
fi
V7_ROUTE_TIMING_KERNEL_MUTATION_COMPLETED="$V7_ROUTE_WRITE_COMPLETED"
V7_ROUTE_WRITE_MS=$(awk -v start="$V7_ROUTE_WRITE_STARTED" -v end="$V7_ROUTE_WRITE_COMPLETED" 'BEGIN { printf "%.3f", (end-start)*1000 }')
echo "V7_TIMING_ROUTE_WRITE_CLOCK=$V7_ROUTE_WRITE_CLOCK"
echo "V7_TIMING_ROUTE_WRITE_MS=$V7_ROUTE_WRITE_MS"

now=$(date +%s)
if ! cat > "$ASSIGNMENT_FILE" <<STATE
egress=$EGRESS
last_switch=$now
fail_count=0
STATE
then
  echo "V7_ROUTE_WRITE_FAILURE=ROUTE_ASSIGNMENT_STATE_WRITE_FAILED"
  exit 1
fi
V7_ROUTE_TIMING_ASSIGNMENT_STATE_COMMITTED="$(v7_route_timing_now)"

tmp="${REG}.tmp.$$"
if ! awk -v ip="$USER_IP" -v egress="$EGRESS" -v table="$table" '
  $0 ~ "^ip=" ip " " {
    if ($0 ~ / current=[^ ]+/) sub(/ current=[^ ]+/, " current=" egress)
    else $0 = $0 " current=" egress
    if ($0 ~ / table=[^ ]+/) sub(/ table=[^ ]+/, " table=" table)
    else $0 = $0 " table=" table
    if ($0 ~ / enabled=[^ ]+/) sub(/ enabled=[^ ]+/, " enabled=1")
    else $0 = $0 " enabled=1"
    print
    next
  }
  { print }
' "$REG" > "$tmp"; then
  rm -f "$tmp" || true
  echo "V7_ROUTE_WRITE_FAILURE=ROUTE_REGISTRY_PREPARE_FAILED"
  exit 1
fi
if ! mv "$tmp" "$REG"; then
  rm -f "$tmp" || true
  echo "V7_ROUTE_WRITE_FAILURE=ROUTE_REGISTRY_COMMIT_FAILED"
  exit 1
fi
V7_ROUTE_TIMING_REGISTRY_COMMITTED="$(v7_route_timing_now)"

# Rebuild the existing Core-primary projection immediately from the just
# committed canonical registry.  Without this hand-off a successful governed
# user switch can leave the nft membership map temporarily pointed at the old
# egress class.  This is not another route writer or state source: it invokes
# the current registry-wide owner and fails closed if that owner cannot commit.
if [ "$CORE_PRIMARY_ACTIVE" = "1" ] && [ "$CORE_PRIMARY_COHORT_DEFER" != "1" ]; then
  core_primary_success_status="CORE_PRIMARY_APPLY_PASS"
  if [ "$CORE_PRIMARY_OPERATOR_REBIND" = "1" ]; then
    core_primary_apply_cmd=(
      v7-routing-sync --core-primary-cohort-commit
      --cohort-user "$USER_IP"
      --operation-id "$OPERATION_ID"
      --selected-move-hash "$SELECTED_MOVE_HASH"
      --operator-profile-rebind --json
    )
    core_primary_success_status="CORE_PRIMARY_COHORT_COMMIT_PASS"
  else
    core_primary_apply_cmd=(v7-routing-sync --core-primary-apply --json)
  fi
  if ! core_primary_apply_output="$("${core_primary_apply_cmd[@]}" 2>&1)"; then
    core_primary_apply_output=""
  fi
  if ! printf '%s\n' "$core_primary_apply_output" | grep -Fq "\"status\": \"$core_primary_success_status\""; then
    rollback_ok=1
    if ! mv "$CORE_REGISTRY_BACKUP" "$REG"; then
      rollback_ok=0
    fi
    if [ "$CORE_ASSIGNMENT_EXISTED" = "1" ]; then
      if ! mv "$CORE_ASSIGNMENT_BACKUP" "$ASSIGNMENT_FILE"; then
        rollback_ok=0
      fi
    else
      rm -f "$ASSIGNMENT_FILE" || rollback_ok=0
    fi
    rollback_apply_output="$(v7-routing-sync --core-primary-apply --json 2>&1 || true)"
    if ! printf '%s\n' "$rollback_apply_output" | grep -Fq '"status": "CORE_PRIMARY_APPLY_PASS"'; then
      rollback_ok=0
    fi
    cleanup_core_primary_preimage
    if [ "$rollback_ok" = "1" ]; then
      echo "V7_ROUTE_WRITE_FAILURE=ROUTE_CORE_PRIMARY_SYNC_FAILED_ROLLBACK_RESTORED"
    else
      echo "V7_ROUTE_WRITE_FAILURE=ROUTE_CORE_PRIMARY_SYNC_FAILED_ROLLBACK_FAILED"
    fi
    exit 1
  fi
  cleanup_core_primary_preimage
  echo "V7_CORE_PRIMARY_SYNC=PASS"
  if [ "$CORE_PRIMARY_OPERATOR_REBIND" = "1" ]; then
    echo "V7_CORE_PRIMARY_SCOPE=EXACT_OPERATOR_USER"
  fi
elif [ "$CORE_PRIMARY_ACTIVE" = "1" ]; then
  echo "V7_CORE_PRIMARY_SYNC=DEFERRED_COHORT"
fi

if command -v v7-audit-log >/dev/null 2>&1; then
  v7-audit-log "user_switch" "users" "ip=$USER_IP from=$FROM_EGRESS to=$EGRESS table=$table dev=$dev breaker_generation=$CONTROL_GENERATION" >/dev/null 2>&1 || true
fi
if command -v v7-switch-log >/dev/null 2>&1; then
  v7-switch-log "$USER_IP" "$FROM_EGRESS" "$EGRESS" "$table" "${V7_SWITCH_REASON:-manual}" >/dev/null 2>&1 || true
fi
V7_ROUTE_TIMING_AUDIT_COMPLETED="$(v7_route_timing_now)"

echo "=== ROUTE ==="
if ! route_observation="$(ip route get 8.8.8.8 from "$USER_IP" iif wg0 2>&1)"; then
  echo "V7_ROUTE_WRITE_FAILURE=ROUTE_POST_APPLY_OBSERVATION_FAILED"
  exit 1
fi
printf '%s\n' "$route_observation"
echo "=== STATE ==="
if ! assignment_observation="$(cat "$STATE_DIR/user-${USER_IP}.assign" 2>&1)"; then
  echo "V7_ROUTE_WRITE_FAILURE=ROUTE_POST_APPLY_STATE_OBSERVATION_FAILED"
  exit 1
fi
printf '%s\n' "$assignment_observation"
V7_ROUTE_TIMING_POST_APPLY_OBSERVATION_COMPLETED="$(v7_route_timing_now)"
printf 'V7_ROUTE_TIMING_LOCK_STARTED=%s\n' "${V7_ROUTE_TIMING_LOCK_STARTED:-$V7_ROUTE_TIMING_ENTERED}"
printf 'V7_ROUTE_TIMING_ENTERED=%s\n' "$V7_ROUTE_TIMING_ENTERED"
printf 'V7_ROUTE_TIMING_BOOTSTRAP_AND_CONTROL_VALIDATED=%s\n' "$V7_ROUTE_TIMING_BOOTSTRAP_AND_CONTROL_VALIDATED"
printf 'V7_ROUTE_TIMING_KERNEL_MUTATION_COMPLETED=%s\n' "$V7_ROUTE_TIMING_KERNEL_MUTATION_COMPLETED"
printf 'V7_ROUTE_TIMING_ASSIGNMENT_STATE_COMMITTED=%s\n' "$V7_ROUTE_TIMING_ASSIGNMENT_STATE_COMMITTED"
printf 'V7_ROUTE_TIMING_REGISTRY_COMMITTED=%s\n' "$V7_ROUTE_TIMING_REGISTRY_COMMITTED"
printf 'V7_ROUTE_TIMING_AUDIT_COMPLETED=%s\n' "$V7_ROUTE_TIMING_AUDIT_COMPLETED"
printf 'V7_ROUTE_TIMING_POST_APPLY_OBSERVATION_COMPLETED=%s\n' "$V7_ROUTE_TIMING_POST_APPLY_OBSERVATION_COMPLETED"
