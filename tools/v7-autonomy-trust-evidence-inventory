#!/usr/bin/env python3
"""Read-only V7 autonomy trust evidence inventory.

This tool reads existing runtime state, snapshots, and JSONL evidence families.
It does not write evidence, move users, enable daemons, or execute apply.
"""

from __future__ import annotations

import argparse
import gzip
import json
import os
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from admin_core import autonomy_trust_acceleration, operator_decision_surface, registry_readers  # noqa: E402


DEFAULT_STATE_DIR = Path("/opt/v7/egress/state")
DEFAULT_EVENT_DIR = Path("/opt/v7/events")


def read_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return default


def read_registry(path: Path) -> list[dict[str, str]]:
    try:
        return registry_readers.parse_registry_lines(path.read_text(encoding="utf-8").splitlines())
    except OSError:
        return []


def jsonl_family_paths(path: Path) -> list[Path]:
    candidates: list[tuple[int, Path]] = []
    try:
        matches = list(path.parent.glob(f"{path.name}.*"))
    except OSError:
        matches = []
    for item in matches:
        suffix = item.name.removeprefix(f"{path.name}.")
        if suffix.isdigit():
            candidates.append((int(suffix), item))
    ordered = [item for _, item in sorted(candidates, key=lambda pair: pair[0], reverse=True)]
    ordered.append(path)
    seen: set[str] = set()
    unique: list[Path] = []
    for item in ordered:
        key = str(item)
        if key not in seen:
            seen.add(key)
            unique.append(item)
    return unique


def read_jsonl_family(path: Path, limit: int = 5000) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    for item in jsonl_family_paths(path):
        try:
            if item.suffix == ".gz":
                text = gzip.open(item, "rt", encoding="utf-8", errors="replace").read()
            else:
                text = item.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for line in text.splitlines():
            if not line.strip():
                continue
            try:
                parsed = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(parsed, dict):
                rows.append(parsed)
    return rows[-max(1, int(limit)):]


def default_audit_dir(state_dir: Path) -> Path:
    if len(state_dir.parents) > 1 and state_dir.name == "state" and state_dir.parent.name == "egress":
        return state_dir.parents[1] / "audit"
    return state_dir.parent / "audit"


def event_source_paths(event_dir: Path) -> list[Path]:
    paths = [
        event_dir / "telegram-sentinel.jsonl",
        event_dir / "service-matrix.jsonl",
        event_dir / "quality-regressions.jsonl",
        event_dir / "events.jsonl",
        event_dir / "l3-wake-events.jsonl",
        event_dir / "service-failure-events.jsonl",
        event_dir / "runtime-wake-events.jsonl",
        event_dir / "governance-lifecycle.jsonl",
    ]
    for pattern in ("telegram-sentinel-*.jsonl", "service-matrix-refresh-*.jsonl"):
        try:
            paths.extend(sorted(event_dir.glob(pattern))[-3:])
        except OSError:
            pass
    return list(dict.fromkeys(paths))


def event_rows(event_dir: Path, limit: int = 5000) -> list[dict[str, Any]]:
    paths = event_source_paths(event_dir)
    per_source_limit = max(100, int(limit) // max(1, len(paths)))
    rows: list[dict[str, Any]] = []
    for path in paths:
        rows.extend(read_jsonl_family(path, limit=per_source_limit))
    return rows[-max(1, int(limit)):]


def discover_live_packet_preview(args: argparse.Namespace) -> dict[str, Any]:
    command = Path(__file__).with_name("v7-governed-canary-dry-run-cycle")
    argv = [
        str(command),
        "--state-dir", str(args.state_dir),
        "--event-dir", str(args.event_dir),
        "--max-users", "1",
        "--skip-planner-observe",
    ]
    if args.snapshot_root:
        argv.extend(["--snapshot-root", str(args.snapshot_root)])
    if args.audit_dir:
        argv.extend(["--audit-dir", str(args.audit_dir)])
    try:
        completed = subprocess.run(argv, text=True, capture_output=True, timeout=240, check=False)
        payload = json.loads(completed.stdout)
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError) as exc:
        return {"status": "LIVE_PACKET_DISCOVERY_FAILED", "error": str(exc), "packet_preview": {}}
    packet_preview = dict(payload.get("packet_preview") or {})
    candidate = payload.get("candidate") if isinstance(payload.get("candidate"), dict) else {}
    allowed_users = {str(value) for value in packet_preview.get("allowed_users") or []}
    allowed_targets = {str(value) for value in packet_preview.get("allowed_targets") or []}
    candidate_user = str(candidate.get("user") or "")
    candidate_target = str(candidate.get("recommended_channel") or "")
    reason_summary = [str(value) for value in candidate.get("reason_summary") or [] if str(value)]
    genuine_production_candidate = (
        bool(candidate.get("execution_candidate"))
        and not bool(candidate.get("review_required"))
        and candidate_user in allowed_users
        and candidate_target in allowed_targets
        and bool(reason_summary)
    )
    packet_preview["_v7_genuine_production_candidate"] = genuine_production_candidate
    packet_preview["_v7_candidate_reason_summary"] = reason_summary
    return {
        "status": "LIVE_PACKET_DISCOVERED" if isinstance(payload.get("packet_preview"), dict) else "LIVE_PACKET_NOT_AVAILABLE",
        "exit_code": completed.returncode,
        "stop_reason": payload.get("stop_reason"),
        "packet_preview": packet_preview,
        "genuine_production_candidate": genuine_production_candidate,
        "runtime_mutation_performed": bool(payload.get("runtime_mutation_performed")),
        "apply_executed": bool(payload.get("apply_executed")),
        "users_moved": int(payload.get("users_moved") or 0),
    }


def terminal_execution_observation(state_dir: Path, *, verify_routes: bool = False) -> dict[str, Any] | None:
    lease_path = state_dir / "operator-execution-lease.json"
    lease = read_json(lease_path, {})
    if not isinstance(lease, dict) or lease.get("status") != "EXECUTION_FINISHED":
        return None
    identity = lease.get("immutable_packet_identity") if isinstance(lease.get("immutable_packet_identity"), dict) else {}
    user = str(identity.get("user") or "")
    source = str(identity.get("source") or "")
    target = str(identity.get("target") or "")
    if not user or not target:
        return None
    current = ""
    for row in read_registry(state_dir / "users.registry"):
        if str(row.get("ip") or row.get("user_ip") or "") == user:
            current = str(row.get("current") or row.get("egress") or "")
            break
    route_check = {"requested": verify_routes, "passed": False, "returncode": None}
    if verify_routes:
        try:
            with tempfile.TemporaryDirectory(prefix="v7-route-check-") as tmp:
                scoped = Path(tmp)
                selected = [
                    line for line in (state_dir / "users.registry").read_text(encoding="utf-8").splitlines()
                    if line.startswith(f"ip={user} ")
                ]
                if len(selected) != 1:
                    raise OSError("user_registry_identity_not_unique")
                (scoped / "users.registry").write_text(selected[0] + "\n", encoding="utf-8")
                for name in ("egress.registry", f"user-{user}.assign"):
                    source_path = state_dir / name
                    if source_path.exists():
                        (scoped / name).symlink_to(source_path)
                env = dict(os.environ)
                env["V7_STATE_DIR"] = str(scoped)
                completed = subprocess.run(
                    ["v7-user-route-check"], text=True, capture_output=True,
                    timeout=180, check=False, env=env,
                )
            route_check = {"requested": True, "passed": completed.returncode == 0, "returncode": completed.returncode}
        except (OSError, subprocess.TimeoutExpired):
            route_check = {"requested": True, "passed": False, "returncode": None}
    finished_raw = str(lease.get("finished_at") or "")
    try:
        finished = datetime.fromisoformat(finished_raw.replace("Z", "+00:00"))
    except ValueError:
        finished = datetime.now(timezone.utc)
    now = datetime.now(timezone.utc)
    elapsed = max(0, int((now - finished).total_seconds()))
    current_matches = current == target
    verified = current_matches and route_check["passed"]
    packet = lease.get("packet") if isinstance(lease.get("packet"), dict) else {}
    source_preview = lease.get("source_preview") if isinstance(lease.get("source_preview"), dict) else {}
    evidence_class = str(source_preview.get("_v7_evidence_class") or "CONTROLLED_PRODUCTION")
    return {
        "schema_version": "v7.l7-l8.terminal-execution-observation.v1",
        "_v7_evidence_source_path": f"{lease_path}+users.registry+v7-user-route-check",
        "evidence_class": evidence_class,
        "operation_id": str(lease.get("operation_id") or identity.get("operation_id") or ""),
        "source_operation_id": str(identity.get("operation_id") or ""),
        "packet_id": str(lease.get("packet_id") or identity.get("packet_id") or ""),
        "decision_id": str(identity.get("decision_id") or packet.get("decision_id") or ""),
        "user": user,
        "source_channel": source,
        "target_channel": target,
        "outcome_observed_at": now.isoformat(),
        "execution_outcome": {"applied": True, "success": verified},
        "verification_result": {"verification_passed": verified, "current_channel": current, "route_check": route_check},
        "stability_window_seconds": elapsed if verified else 0,
        "delayed_5m_observation": verified and elapsed >= 300,
        "delayed_1h_observation": verified and elapsed >= 3600,
        "decision_trace_id": str(identity.get("decision_id") or packet.get("decision_id") or ""),
        "input_snapshot_identity": str(identity.get("snapshot_bundle_hash") or packet.get("snapshot_bundle_hash") or ""),
        "expected_terminal": "SUCCESS",
        "terminal_outcome_classification": "SUCCESS" if verified else "REGRESSION_REQUIRED",
        "observation_owner": "existing execution lease, users registry and v7-user-route-check owners",
        "read_only": True,
        "runtime_mutation_performed": False,
        "apply_executed": False,
        "users_moved": 0,
    }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Read-only V7 autonomy trust evidence inventory.")
    parser.add_argument("--state-dir", default=str(DEFAULT_STATE_DIR))
    parser.add_argument("--event-dir", default=str(DEFAULT_EVENT_DIR))
    parser.add_argument("--snapshot-root", default="")
    parser.add_argument("--audit-dir", default="")
    parser.add_argument("--knowledge-quality-only", action="store_true")
    parser.add_argument("--routing-foundation-only", action="store_true")
    parser.add_argument("--action-class-runtime-only", action="store_true")
    parser.add_argument("--delegated-autonomy-policy-only", action="store_true")
    parser.add_argument("--delegated-autonomy-eligibility-only", action="store_true")
    parser.add_argument("--l7-l8-authority-evolution-only", action="store_true")
    parser.add_argument("--polygon-driven-l7-l8-acquisition-only", action="store_true")
    parser.add_argument("--discover-live-packet-preview", action="store_true")
    parser.add_argument("--verify-terminal-execution-observation", action="store_true")
    parser.add_argument(
        "--expected-material-outcome",
        action="append",
        default=[],
        help="JSON object for one CPS-owned current action-class material outcome; repeatable",
    )
    parser.add_argument("--pretty", action="store_true")
    return parser


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    state_dir = Path(args.state_dir)
    event_dir = Path(args.event_dir)
    snapshot_root = Path(args.snapshot_root) if args.snapshot_root else state_dir / "intelligence"
    audit_dir = Path(args.audit_dir) if args.audit_dir else default_audit_dir(state_dir)
    # Run the nested live dry-run before loading the large evidence corpus so
    # the parent and child processes do not retain both full inventories at once.
    live_packet_discovery = {"status": "NOT_REQUESTED", "packet_preview": {}}
    if args.discover_live_packet_preview:
        live_packet_discovery = discover_live_packet_preview(args)
    users = read_registry(state_dir / "users.registry")
    egress = read_registry(state_dir / "egress.registry")
    runtime_state = read_json(state_dir / "v7-state.json", {})
    decision_surface = operator_decision_surface.build_operator_decision_surface(
        snapshot_root=snapshot_root,
        users=users,
        egress=egress,
        runtime_state=runtime_state,
    )
    audit_paths = [
        event_dir / "switch-history.jsonl",
        audit_dir / "audit.jsonl",
        audit_dir / "operator-execution-audit.jsonl",
        audit_dir / "operator-runtime-governance-actions.jsonl",
    ]
    feedback_paths = [
        state_dir / "execution-events.jsonl",
        state_dir / "runtime-trust.jsonl",
        state_dir / "proposal-records.jsonl",
        state_dir / "proposals.jsonl",
        state_dir / "closure-records.jsonl",
    ]
    rollback_paths = [event_dir / "rollback-history.jsonl"]
    decision_records = []
    for path in audit_paths + feedback_paths + rollback_paths:
        for row in read_jsonl_family(path):
            decision_records.append({
                **row,
                "_v7_evidence_source_path": str(path),
            })
    terminal_observation = terminal_execution_observation(
        state_dir,
        verify_routes=args.verify_terminal_execution_observation,
    )
    if terminal_observation:
        decision_records.append(terminal_observation)
    shadow_history = read_jsonl_family(state_dir / "shadow-autonomy-decisions.jsonl")
    events = event_rows(event_dir)
    natural_event_paths = event_source_paths(event_dir)
    expected_material_outcomes = []
    for raw in args.expected_material_outcome:
        try:
            parsed = json.loads(raw)
        except json.JSONDecodeError as exc:
            raise SystemExit(f"invalid --expected-material-outcome JSON: {exc}") from exc
        if not isinstance(parsed, dict):
            raise SystemExit("--expected-material-outcome must be a JSON object")
        expected_material_outcomes.append(parsed)
    payload = autonomy_trust_acceleration.build_acceleration_inventory(
        snapshot_root=snapshot_root,
        decision_surface=decision_surface,
        shadow_history=shadow_history,
        decision_records=decision_records,
        event_rows=events,
    )
    if expected_material_outcomes:
        payload["l7_l8_authority_evolution_program"] = autonomy_trust_acceleration.build_l7_l8_outcome_evidence_program(
            decision_records,
            expected_material_outcomes=expected_material_outcomes,
            generated_at=payload.get("generated_at"),
        )
    capture_sources = [
        {
            "path": str(event_dir),
            "owner_role": "NATURAL_EVENT_DETECTION",
            "exists": any(path.exists() for path in natural_event_paths),
            "readable": True,
            "records_read": len(events),
        },
        {
            "path": ";".join(str(path) for path in audit_paths),
            "owner_role": "DECISION_TRACE_AND_SNAPSHOT",
            "exists": any(path.exists() for path in audit_paths),
            "readable": True,
            "records_read": len(decision_records),
        },
        {
            "path": ";".join(str(path) for path in feedback_paths),
            "owner_role": "OUTCOME_AND_FEEDBACK",
            "exists": any(path.exists() for path in feedback_paths),
            "readable": True,
            "records_read": len(decision_records),
        },
        {
            "path": ";".join(str(path) for path in rollback_paths + [event_dir / "switch-history.jsonl", state_dir / "closure-records.jsonl"]),
            "owner_role": "ROLLBACK_OR_NO_ROLLBACK",
            "exists": any(path.exists() for path in rollback_paths + [event_dir / "switch-history.jsonl", state_dir / "closure-records.jsonl"]),
            "readable": True,
            "records_read": len(decision_records),
        },
        {
            "path": str(state_dir / "runtime-trust.jsonl"),
            "owner_role": "LEARNING_AND_REPLAY",
            "exists": (state_dir / "runtime-trust.jsonl").exists(),
            "readable": True,
            "records_read": len(read_jsonl_family(state_dir / "runtime-trust.jsonl")),
        },
    ]
    payload["polygon_driven_l7_l8_evidence_acquisition"] = autonomy_trust_acceleration.build_polygon_driven_l7_l8_evidence_acquisition(
        payload.get("l7_l8_authority_evolution_program") or {},
        users=users,
        egress=egress,
        packet_preview=live_packet_discovery.get("packet_preview") or {},
        delegated_policy=autonomy_trust_acceleration.build_delegated_autonomy_policy_preview(),
        owner_capture_sources=capture_sources,
    )
    payload["polygon_driven_l7_l8_evidence_acquisition"]["live_packet_discovery"] = {
        key: value for key, value in live_packet_discovery.items() if key != "packet_preview"
    }
    payload["inputs"] = {
        "state_dir": str(state_dir),
        "event_dir": str(event_dir),
        "snapshot_root": str(snapshot_root),
        "audit_paths": [str(path) for path in audit_paths],
        "feedback_paths": [str(path) for path in feedback_paths],
        "rollback_paths": [str(path) for path in rollback_paths],
        "decision_records_read": len(decision_records),
        "shadow_history_records_read": len(shadow_history),
        "event_records_read": len(events),
        "terminal_execution_observation_consumed": bool(terminal_observation),
    }
    if args.knowledge_quality_only:
        payload = payload["knowledge_quality_read_model"]
    if args.routing_foundation_only:
        payload = {
            key: payload[key]
            for key in [
                "service_user_sla_fit",
                "decision_outcome_closure",
                "recovery_admission",
                "anti_flapping",
                "freshness_actionability",
                "action_class_freshness_windows",
                "hard_failure_classification",
                "liveness_evidence_aggregation",
                "hard_failure_policy_windows",
                "soft_degradation_threshold_vocabulary",
                "degradation_signal_policy_mapping",
                "observed_degradation_attribution",
                "v7_native_degradation_response_mapping",
                "service_objective_policy_threshold_binding",
                "recovery_admission_certification",
                "post_admission_observation_windows",
                "recovery_slow_start_progression",
                "org_cohort_identity_policy_integration",
                "next_action_class_stage_certification",
                "service_pool_cohort_blast_radius_scope",
                "all_at_once_promotion_unavailable_verification",
                "stale_read_mutation_blocking",
                "owner_issued_version_lease_pattern",
                "hysteresis_state_change_cost_mapping",
                "hard_failure_override_anti_flap_arbitration",
                "per_user_routing_control_mode",
                "fail_open_fail_closed_action_class_behavior",
                "probabilistic_suspicion_advisory_evidence",
                "routing_recommendation_readiness",
            ]
        }
    if args.action_class_runtime_only:
        payload = payload["action_class_runtime_enablement"]
    if args.delegated_autonomy_policy_only:
        payload = payload["action_class_runtime_enablement"]["delegated_autonomy_policy_preview"]
    if args.delegated_autonomy_eligibility_only:
        payload = payload["action_class_runtime_enablement"]["delegated_autonomy_runtime_eligibility"]
    if args.l7_l8_authority_evolution_only:
        payload = payload["l7_l8_authority_evolution_program"]
    if args.polygon_driven_l7_l8_acquisition_only:
        payload = payload["polygon_driven_l7_l8_evidence_acquisition"]
    print(json.dumps(payload, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
