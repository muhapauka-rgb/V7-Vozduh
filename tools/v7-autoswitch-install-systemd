#!/bin/sh
set -eu

ROOT="${V7_REPO_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
BIN_SRC="$ROOT/tools/v7-users-autoswitch"
SERVICE_SRC="$ROOT/systemd/v7-users-autoswitch.service"
TIMER_SRC="$ROOT/systemd/v7-users-autoswitch.timer"

if [ ! -x "$BIN_SRC" ]; then
  echo "ERROR: missing executable $BIN_SRC" >&2
  exit 1
fi

if [ "${1:-}" = "--apply" ]; then
  install -m 0755 "$BIN_SRC" /usr/local/bin/v7-users-autoswitch
  install -m 0644 "$SERVICE_SRC" /etc/systemd/system/v7-users-autoswitch.service
  install -m 0644 "$TIMER_SRC" /etc/systemd/system/v7-users-autoswitch.timer
  systemctl daemon-reload
  systemctl enable --now v7-users-autoswitch.timer
  systemctl status v7-users-autoswitch.timer --no-pager
else
  echo "DRY_RUN=1"
  echo "would install $BIN_SRC -> /usr/local/bin/v7-users-autoswitch"
  echo "would install $SERVICE_SRC -> /etc/systemd/system/v7-users-autoswitch.service"
  echo "would install $TIMER_SRC -> /etc/systemd/system/v7-users-autoswitch.timer"
  echo "would run systemctl daemon-reload"
  echo "would run systemctl enable --now v7-users-autoswitch.timer"
  echo "rerun with --apply to install"
fi
