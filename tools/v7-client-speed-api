def write_json_file(path, data):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp.{secrets.token_hex(4)}")
    tmp.write_text(json.dumps(data, ensure_ascii=True, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def client_ip(handler):
    ip = handler.client_address[0]
    if ip.startswith("::ffff:"):
        ip = ip[7:]
    return ip


def safe_float(value, default=0.0):
    try:
        return float(value)
    except Exception:
        return default


def safe_int(value, default=0):
    try:
        if isinstance(value, str):
            return int(value, 0)
        return int(value)
    except Exception:
        return default


def parse_iso(value):
    text = str(value or "").strip().replace("Z", "+00:00")
    parsed = datetime.fromisoformat(text)
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc)


def exact_probe_context_errors(context):
    context = context if isinstance(context, dict) else {}
    errors = []
    if context.get("schema_version") != EXACT_PROBE_CONTEXT_SCHEMA:
        errors.append("context_schema_invalid")
    required_text = (
        "contract_id",
        "validation_generation_id",
        "issuing_owner",
        "active_program",
        "incident_id",
        "incident_generation",
        "user",
        "source",
        "target",
        "source_address",
        "interface",
        "routing_table",
        "expected_egress_ip",
        "expected_target_egress_fingerprint",
        "target_url",
        "clock_domain_id",
        "context_hash",
    )
    for key in required_text:
        if not str(context.get(key) or "").strip():
            errors.append(f"{key}_missing")
    if context.get("certification_identity") is not True:
        errors.append("certification_identity_required")
    if str(context.get("context_hash") or "") != exact_probe_context_hash(context):
        errors.append("context_hash_mismatch")
    if str(context.get("sample_kind") or "") not in {"cold", "warm"}:
        errors.append("sample_kind_invalid")
    if not re.fullmatch(
        r"[0-9a-f]{64}",
        str(context.get("expected_target_egress_fingerprint") or ""),
    ):
        errors.append("expected_target_egress_fingerprint_invalid")
    if safe_int(context.get("network_namespace_inode"), 0) <= 0:
        errors.append("network_namespace_inode_missing")
    if safe_int(context.get("fwmark"), 0) <= 0:
        errors.append("fwmark_missing")
    first = safe_int(context.get("first_failed_observation_monotonic_ns"), 0)
    confirmed = safe_int(context.get("confirmed_hard_failure_monotonic_ns"), 0)
    if first <= 0 or confirmed < first:
        errors.append("failure_clock_boundaries_invalid")
    if safe_int(context.get("timeout_ms"), 0) <= 0:
        errors.append("timeout_contract_missing")
    if safe_int(context.get("retry_count"), -1) < 0:
        errors.append("retry_contract_missing")
    if safe_int(context.get("observation_cadence_ms"), 0) <= 0:
        errors.append("observation_cadence_missing")
    if safe_float(context.get("clock_uncertainty_ms"), -1.0) < 0:
        errors.append("clock_uncertainty_missing")
    try:
        if parse_iso(context.get("expires_at")) <= datetime.now(timezone.utc):
            errors.append("context_expired")
    except Exception:
        errors.append("context_expiry_invalid")
    target = urlparse(str(context.get("target_url") or ""))
    if target.scheme != "https" or not target.hostname:
        errors.append("https_target_required")
    preferred_protocol = str(
        context.get("preferred_probe_protocol") or "HTTPS_EGRESS_IP"
    )
    if preferred_protocol not in {
        "HTTPS_EGRESS_IP",
        "STUN_XOR_MAPPED_ADDRESS",
    }:
        errors.append("preferred_probe_protocol_invalid")
    if preferred_protocol == "STUN_XOR_MAPPED_ADDRESS":
        if not str(context.get("stun_host") or "").strip():
            errors.append("stun_host_missing")
        if safe_int(context.get("stun_port"), 0) != 3478:
            errors.append("stun_port_invalid")
    expected_ip = str(context.get("expected_egress_ip") or "").strip()
    try:
        expected_ip_value = ipaddress.ip_address(expected_ip)
    except ValueError:
        expected_ip_value = None
    if expected_ip_value is None or not expected_ip_value.is_global:
        errors.append("expected_egress_ip_invalid")
    return sorted(set(errors))


def target_egress_payload_context_errors(context):
    """Validate a target-only payload context from an existing owner.

    This mode deliberately cannot claim exact-user or remote-device recovery.
    It reuses the existing TLS/HTTP and egress-IP validation primitive only to
    prove that the separately selected target tunnel can carry fresh payload.
    """
    context = context if isinstance(context, dict) else {}
    errors = []
    if context.get("schema_version") != TARGET_EGRESS_PAYLOAD_CONTEXT_SCHEMA:
        errors.append("context_schema_invalid")
    for key in (
        "contract_id",
        "validation_generation_id",
        "issuing_owner",
        "active_program",
        "incident_id",
        "incident_generation",
        "user",
        "source",
        "target",
        "candidate_id",
        "packet_id",
        "lease_id",
        "operation_id",
        "source_address",
        "interface",
        "expected_egress_ip",
        "expected_target_egress_fingerprint",
        "target_url",
        "context_hash",
    ):
        if not str(context.get(key) or "").strip():
            errors.append(f"{key}_missing")
    if context.get("certification_identity") is not True:
        errors.append("certification_identity_required")
    if str(context.get("context_hash") or "") != exact_probe_context_hash(context):
        errors.append("context_hash_mismatch")
    if str(context.get("sample_kind") or "") not in {"cold", "warm"}:
        errors.append("sample_kind_invalid")
    if not re.fullmatch(r"[0-9a-f]{64}", str(context.get("expected_target_egress_fingerprint") or "")):
        errors.append("expected_target_egress_fingerprint_invalid")
    if safe_int(context.get("timeout_ms"), 0) <= 0:
        errors.append("timeout_contract_missing")
    if safe_int(context.get("retry_count"), -1) < 0:
        errors.append("retry_contract_missing")
    try:
        if parse_iso(context.get("expires_at")) <= datetime.now(timezone.utc):
            errors.append("context_expired")
    except Exception:
        errors.append("context_expiry_invalid")
    target_url = urlparse(str(context.get("target_url") or ""))
    if target_url.scheme != "https" or not target_url.hostname:
        errors.append("https_target_required")
    try:
        if not ipaddress.ip_address(str(context.get("expected_egress_ip") or "")).is_global:
            errors.append("expected_egress_ip_invalid")
        if not ipaddress.ip_address(str(context.get("source_address") or "")):
            errors.append("source_address_invalid")
    except ValueError:
        errors.append("address_invalid")
    return sorted(set(errors))


def route_lookup_for_exact_probe(destination_ip, context):
    command = [
        "ip",
        "-j",
        "route",
        "get",
        str(destination_ip),
        "from",
        str(context.get("source_address") or ""),
        "mark",
        str(context.get("fwmark") or "0"),
    ]
    if str(context.get("ingress_interface") or ""):
        command.extend(("iif", str(context.get("ingress_interface") or "")))
    # A target-egress payload probe deliberately proves the already selected
    # target interface.  The socket below uses SO_BINDTODEVICE, so its route
    # lookup must model that same execution context.  Exact-client probes do
    # not set this flag: they must continue proving the user's fwmark/table
    # path without an output-interface constraint.
    if context.get("target_egress_interface_bound_probe") is True:
        command.extend(("oif", str(context.get("interface") or "")))
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=max(1, min(safe_int(context.get("timeout_ms"), 1000) // 1000 + 1, 10)),
            check=False,
        )
        rows = json.loads(proc.stdout or "[]") if proc.returncode == 0 else []
    except Exception as exc:
        return {
            "ok": False,
            "command": command,
            "error": f"{type(exc).__name__}:{exc}"[:240],
        }
    row = rows[0] if isinstance(rows, list) and rows and isinstance(rows[0], dict) else {}
    return {
        "ok": bool(row),
        "command": command,
        "dev": str(row.get("dev") or ""),
        "table": str(row.get("table") or "main"),
        "prefsrc": str(row.get("prefsrc") or row.get("src") or ""),
        "gateway": str(row.get("gateway") or ""),
        "raw": row,
    }


def _cache_busted_url(url, nonce):
    parsed = urlparse(url)
    query = list(parse_qsl(parsed.query, keep_blank_values=True))
    query.extend((("v7ProbeNonce", nonce), ("v7ProbeTimeNs", str(time.time_ns()))))
    return urlunparse(parsed._replace(query=urlencode(query)))


def exact_certification_client_profile(source_address):
    """Return the existing client profile for one exact certification IP.

    The profile is an already-owned client artifact, not a second identity
    registry.  Ambiguity fails closed and no key material is returned here.
    """
    source_address = str(source_address or "").strip()
    matches = []
    address_re = re.compile(
        rf"^Address\s*=\s*{re.escape(source_address)}/32(?:\s|$)", re.M
    )
    try:
        candidates = sorted(CLIENT_PROFILE_ROOT.glob("*/*.conf"))
    except OSError:
        candidates = []
    for path in candidates:
        try:
            if address_re.search(path.read_text(encoding="utf-8")):
                matches.append(path)
        except OSError:
            continue
    return matches[0] if len(matches) == 1 else None


def wireguard_setconf_text(
    profile_text, *, endpoint_override="", peer_public_key_override=""
):
    """Strip wg-quick-only fields without writing private keys to disk."""
    allowed_interface = {"privatekey", "listenport", "fwmark"}
    allowed_peer = {
        "publickey", "presharedkey", "allowedips", "endpoint",
        "persistentkeepalive",
    }
    section = ""
    output = []
    for raw in str(profile_text or "").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line.lower()
            if section in {"[interface]", "[peer]"}:
                output.append(line)
            continue
        if "=" not in line or section not in {"[interface]", "[peer]"}:
            continue
        key = line.split("=", 1)[0].strip().lower()
        allowed = allowed_interface if section == "[interface]" else allowed_peer
        if section == "[peer]" and key == "publickey" and peer_public_key_override:
            output.append(f"PublicKey = {peer_public_key_override}")
        elif key == "endpoint" and endpoint_override:
            output.append(f"Endpoint = {endpoint_override}")
        elif key in allowed:
            output.append(line)
    return "\n".join(output) + "\n"


def wireguard_profile_metadata(profile_text):
    metadata = {
        "address": "", "endpoint_host": "", "endpoint_port": "",
        "private_key": "",
    }
    for raw in str(profile_text or "").splitlines():
        if "=" not in raw:
            continue
        key, value = (item.strip() for item in raw.split("=", 1))
        if key.lower() == "address":
            metadata["address"] = value.split(",", 1)[0].split("/", 1)[0].strip()
        elif key.lower() == "privatekey":
            metadata["private_key"] = value
        elif key.lower() == "endpoint":
            endpoint = value.strip()
            metadata["endpoint_host"] = (
                endpoint.rsplit(":", 1)[0].strip("[]")
                if ":" in endpoint else endpoint
            )
            metadata["endpoint_port"] = (
                endpoint.rsplit(":", 1)[1].strip()
                if ":" in endpoint else ""
            )
    return metadata


def _run_probe_command(command, *, input_text=None, timeout=5):
    return subprocess.run(
        command,
        input=input_text,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
        timeout=timeout,
    )


def _exact_namespace_http_script():
    # Kept as one bounded child so the socket is genuinely created inside the
    # client namespace.  The context contains no secrets.
    return r'''import hashlib,http.client,ipaddress,json,secrets,socket,ssl,struct,sys,time
from urllib.parse import parse_qsl,urlencode,urlparse,urlunparse
c=json.loads(sys.stdin.read()); p=urlparse(c["target_url"]); host=p.hostname
dest=c["destination_ip"]; proto=c.get("preferred_probe_protocol",""); port=c.get("destination_port") or p.port or 443; started=time.monotonic_ns()
s=None; t=None
try:
 if proto=="STUN_XOR_MAPPED_ADDRESS":
  tx=secrets.token_bytes(12); q=struct.pack("!HHI12s",1,0,0x2112A442,tx)
  s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM); s.settimeout(c["timeout_seconds"])
  s.setsockopt(socket.SOL_SOCKET,getattr(socket,"SO_BINDTODEVICE",25),(c["client_interface"]+"\0").encode())
  s.bind((c["source_address"],0)); s.sendto(q,(dest,port)); data,_=s.recvfrom(2048)
  rtype,rlen,cookie=struct.unpack("!HHI",data[:8]) if len(data)>=20 else (0,0,0)
  if rtype!=0x0101 or cookie!=0x2112A442 or len(data)<20+rlen or data[8:20]!=tx: raise ValueError("stun_response_identity_invalid")
