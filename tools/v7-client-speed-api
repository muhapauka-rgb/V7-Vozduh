def now_iso():
    return datetime.now(timezone.utc).isoformat()


def sha256_text(value):
    return hashlib.sha256(str(value or "").encode("utf-8")).hexdigest()


def exact_probe_session_names(source_address):
    """Return deterministic runtime-only names for one Polygon client."""
    suffix = sha256_text(source_address)[:6]
    return {
        "namespace": f"v7p{suffix}"[:15],
        "host_interface": f"v7h{suffix}"[:15],
        "peer_interface": f"v7n{suffix}"[:15],
        "client_interface": f"v7w{suffix}"[:15],
    }


def exact_probe_link_addresses(source_address):
    """Return a deterministic, source-isolated /30 for one Polygon fixture.

    A shared link-local /30 permits a stale prepared namespace to capture a
    later fixture's reply.  The addresses live only for the namespace session;
    deriving them from the exact certification identity prevents that overlap.
    """
    slot = int(sha256_text(source_address)[:3], 16)
    third = slot // 64
    fourth = (slot % 64) * 4
    return {
        "gateway": f"169.254.{third}.{fourth + 1}",
        "client": f"169.254.{third}.{fourth + 2}",
        "prefix": 30,
    }


def cleanup_exact_probe_session(source_address):
    names = exact_probe_session_names(source_address)
    _run_probe_command(["ip", "netns", "del", names["namespace"]], timeout=5)
    _run_probe_command(["ip", "link", "del", names["host_interface"]], timeout=5)
    return {
        "schema_version": "v7.exact-client-probe-session.v1",
        "status": "EXACT_CLIENT_PROBE_SESSION_REMOVED",
        "ok": True,
        "source_address_fingerprint": sha256_text(source_address),
        "persistent_state_created": False,
        "routing_mutation_performed": False,
        "ordinary_user_effect": False,
    }


def exact_probe_context_hash(context):
    canonical = dict(context if isinstance(context, dict) else {})
    canonical.pop("context_hash", None)
    return hashlib.sha256(
        json.dumps(canonical, sort_keys=True, separators=(",", ":")).encode("utf-8")
    ).hexdigest()


