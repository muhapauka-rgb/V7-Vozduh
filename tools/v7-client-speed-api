def consume_exact_probe_receipt(receipt, context):
    repo_root = str(Path(__file__).resolve().parents[1])
    if repo_root not in sys.path:
        sys.path.insert(0, repo_root)
    try:
        from admin_core import operator_execution_pipeline

        probe = operator_execution_pipeline.exact_client_network_context_traffic_probe_contract(
            receipt,
            expected_user=str(context.get("user") or ""),
            expected_target_fingerprint=str(
                context.get("expected_target_egress_fingerprint") or ""
            ),
        )
        clock = operator_execution_pipeline.client_recovery_clock_contract(receipt)
    except Exception as exc:
        return {
            "status": "TIME_OWNER_CONSUMER_UNAVAILABLE",
            "ok": False,
            "error": f"{type(exc).__name__}:{exc}"[:240],
            "owner": "admin_core.operator_execution_pipeline",
        }
    ok = probe.get("ok") is True and clock.get("ok") is True
    return {
        "status": (
            "EXACT_CLIENT_PROBE_AND_RECOVERY_CLOCK_CONSUMED"
            if ok else "EXACT_CLIENT_PROBE_OR_RECOVERY_CLOCK_REJECTED"
        ),
        "ok": ok,
        "owner": "admin_core.operator_execution_pipeline",
        "probe_contract": probe,
        "recovery_clock": clock,
        "runtime_mutation_performed": False,
        "routing_mutation_performed": False,
        "user_movement": 0,
    }


def run_exact_probe_context(path):
    try:
        context = json.loads(Path(path).read_text(encoding="utf-8"))
    except Exception as exc:
        return {
            "schema_version": EXACT_PROBE_RECEIPT_SCHEMA,
            "status": "PROBE_INVALID",
            "blockers": [f"context_read_failed:{type(exc).__name__}"],
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "user_movement": 0,
        }
    errors = exact_probe_context_errors(context)
    if errors:
        return {
            "schema_version": EXACT_PROBE_RECEIPT_SCHEMA,
            "status": "PROBE_INVALID",
            "blockers": errors,
            "contract_id": str(context.get("contract_id") or ""),
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "user_movement": 0,
        }
    successful, attempts = execute_fresh_exact_probe_request(context)
    receipt = build_exact_probe_receipt(context, successful, attempts)
    receipt["time_owner_consumption"] = consume_exact_probe_receipt(receipt, context)
    if receipt["time_owner_consumption"].get("ok") is not True:
        receipt["status"] = "PROBE_INVALID"
        receipt["blockers"] = sorted(set(
            list(receipt.get("blockers") or [])
            + ["time_owner_consumer_rejected"]
        ))
    return receipt


def build_target_egress_payload_receipt(context, successful_attempt, attempts):
    """Build target-only payload evidence; never promote it to user recovery."""
    context = context if isinstance(context, dict) else {}
    attempt = successful_attempt if isinstance(successful_attempt, dict) else {}
    route = attempt.get("route") if isinstance(attempt.get("route"), dict) else {}
    expected_fingerprint = str(context.get("expected_target_egress_fingerprint") or "")
    interface_bound = all((
        attempt.get("interface_bind_applied") is True,
        str(route.get("dev") or "") == str(context.get("interface") or ""),
    ))
    target_fingerprint_verified = (
        attempt.get("response_matches_expected_egress_ip") is True
        and bool(expected_fingerprint)
    )
    receipt_seed = {
        key: context.get(key)
        for key in (
            "contract_id",
            "validation_generation_id",
            "incident_generation",
            "operation_id",
            "target",
        )
    }
    receipt = {
        "schema_version": TARGET_EGRESS_PAYLOAD_RECEIPT_SCHEMA,
        "receipt_id": "cttarget_" + sha256_text(json.dumps(receipt_seed, sort_keys=True))[:24],
        "scope": "TARGET_EGRESS_PATH_ONLY",
        "probe_owner": "existing tools/v7-client-speed-api target-egress payload mode",
        **{
            key: str(context.get(key) or "")
            for key in (
                "contract_id",
                "validation_generation_id",
                "issuing_owner",
                "active_program",
                "incident_id",
                "incident_generation",
                "user",
                "source",
                "target",
                "candidate_id",
                "packet_id",
                "lease_id",
                "operation_id",
            )
        },
        "sample_kind": str(context.get("sample_kind") or ""),
        "certification_identity": context.get("certification_identity") is True,
        "target_interface": str(context.get("interface") or ""),
        "target_interface_bound": interface_bound,
        "observed_target_egress_fingerprint": expected_fingerprint if target_fingerprint_verified else "",
        "target_fingerprint_verified": target_fingerprint_verified,
        "payload_response_verified": attempt.get("payload_response_verified") is True,
        "payload_fingerprint": str(attempt.get("payload_fingerprint") or ""),
        "fresh_socket": attempt.get("fresh_socket") is True,
        "fresh_dns_resolution": attempt.get("fresh_dns_resolution") is True,
        "management_default_route_used": not interface_bound,
        "kernel_counter_only": False,
        "exact_user_source_fwmark_table_traversed": False,
        "timeout_ms": safe_int(context.get("timeout_ms"), 0),
        "retry_count": safe_int(context.get("retry_count"), -1),
        "clock_source": "time.monotonic_ns",
        "started_monotonic_ns": safe_int(attempt.get("started_monotonic_ns"), 0),
        "target_egress_payload_pass_monotonic_ns": safe_int(attempt.get("finished_monotonic_ns"), 0),
        "attempt_count": len(attempts if isinstance(attempts, list) else []),
        "attempts": attempts if isinstance(attempts, list) else [],
        "remote_client_recovery_claimed": False,
        "runtime_mutation_performed": False,
        "routing_mutation_performed": False,
        "user_movement": 0,
    }
    blockers = []
    if not interface_bound:
        blockers.append("target_interface_binding_not_proven")
    if not target_fingerprint_verified:
        blockers.append("target_egress_fingerprint_not_proven")
    if receipt["payload_response_verified"] is not True:
        blockers.append("payload_response_not_verified")
    if not receipt["payload_fingerprint"]:
        blockers.append("payload_fingerprint_missing")
    receipt["status"] = (
        "TARGET_EGRESS_ROUTE_BOUND_PAYLOAD_PROBE_PROVEN"
        if not blockers else "PROBE_INVALID"
    )
    receipt["blockers"] = sorted(set(blockers))
    return receipt


def run_target_egress_payload_context(path):
    try:
        context = json.loads(Path(path).read_text(encoding="utf-8"))
    except Exception as exc:
        return {
            "schema_version": TARGET_EGRESS_PAYLOAD_RECEIPT_SCHEMA,
            "status": "PROBE_INVALID",
            "blockers": [f"context_read_failed:{type(exc).__name__}"],
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "user_movement": 0,
        }
    errors = target_egress_payload_context_errors(context)
    if errors:
        return {
            "schema_version": TARGET_EGRESS_PAYLOAD_RECEIPT_SCHEMA,
            "status": "PROBE_INVALID",
            "blockers": errors,
            "contract_id": str(context.get("contract_id") or ""),
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "user_movement": 0,
        }
    # Reuse the already deployed fresh DNS/socket, TLS payload and egress-IP
    # verifier.  SO_MARK=0 is explicit here: this is target-interface evidence,
    # not a claim that the certification user's policy table carried payload.
    probe_context = dict(context)
    probe_context["fwmark"] = 0
    successful, attempts = execute_fresh_exact_probe_request(probe_context)
    return build_target_egress_payload_receipt(context, successful, attempts)


def normalize_ingress(value):
    text = str(value or "").strip().lower()
    if text == "wg":
        return "wireguard"
    if text == "awg":
        return "amneziawg"
    return text if text in SAFE_INGRESS else ""


def infer_ingress_type(ip, data):
    explicit = normalize_ingress(data.get("ingress_type") or data.get("ingress"))
    if explicit:
        return explicit
    if ip.startswith("10.7."):
        return "amneziawg"
    if ip.startswith("10.0."):
        return "wireguard"
    return "unknown"


def registered_user(ip):
    users = parse_registry()
    row = users.get(ip)
    if not row or str(row.get("enabled", "1")) != "1":
        return None
    return row


def update_agent(ip, user_row, user_agent):
    data = read_json_file(AGENTS, {"updated": now_iso(), "agents": {}})
    agents = data.setdefault("agents", {})
    now = now_iso()
    agents[ip] = {
        "ip": ip,
        "current_egress": user_row.get("current"),
        "table": user_row.get("table"),
        "last_seen": now,
        "online_until": int(time.time()) + ONLINE_TTL,
        "user_agent": str(user_agent or "")[:180],
    }
    data["updated"] = now
    write_json_file(AGENTS, data)
    return agents[ip]


def commands_for(ip):
    data = read_json_file(COMMANDS, {"updated": now_iso(), "commands": []})
    cmds = data.setdefault("commands", [])
    changed = False
    now = now_iso()
    out = []
    for cmd in cmds:
        if cmd.get("ip") != ip:
            continue
        if cmd.get("status") not in ("pending", "delivered"):
            continue
        cmd["status"] = "delivered"
        cmd["delivered_at"] = now
        changed = True
        out.append(cmd)
    if changed:
        data["updated"] = now
        write_json_file(COMMANDS, data)
    return out


def complete_command(command_id, ip, sample):
    if not command_id:
        return
    data = read_json_file(COMMANDS, {"updated": now_iso(), "commands": []})
    changed = False
    for cmd in data.setdefault("commands", []):
        if cmd.get("id") == command_id and cmd.get("ip") == ip:
            cmd["status"] = "completed"
            cmd["completed_at"] = now_iso()
            cmd["result"] = {
                "mode": sample.get("mode"),
                "egress": sample.get("egress"),
                "mbps": sample.get("mbps"),
                "duration_ms": sample.get("duration_ms"),
            }
            changed = True
            break
    if changed:
        data["updated"] = now_iso()
        write_json_file(COMMANDS, data)


def record_path_sample(raw_data, sample, ingress_type):
    if sample.get("mode") != "v7":
        return {"ok": True, "skipped": "direct_mode"}
    egress_id = str(sample.get("egress") or sample.get("current_egress") or "").strip()
    if not egress_id:
        return {"ok": False, "error": "missing_egress"}
    if not os.path.exists(PATH_SAMPLE_INGEST):
        return {"ok": False, "error": "ingest_missing", "path": PATH_SAMPLE_INGEST}

    payload = {
        "user_ip": sample.get("source_ip"),
        "ingress_type": ingress_type,
        "egress_id": egress_id,
        "mbps": sample.get("mbps"),
        "bytes": sample.get("bytes"),
        "duration_ms": sample.get("duration_ms"),
        "target_url": sample.get("target_url"),
        "client_transport": str(raw_data.get("client_transport") or raw_data.get("adapter") or "")[:80],
        "path_profile": str(raw_data.get("path_profile") or "client-speed-api")[:80],
        "command_id": sample.get("command_id"),
        "source": "v7-client-speed-api",
    }
    try:
        proc = subprocess.run(
            [PATH_SAMPLE_INGEST],
            input=json.dumps(payload, ensure_ascii=False),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=5,
            check=False,
        )
    except Exception as exc:
        return {"ok": False, "error": "ingest_exception", "detail": str(exc)[:240]}

    output = (proc.stdout or "").strip()
    try:
        parsed = json.loads(output) if output else {}
    except Exception:
        parsed = {"output": output[:500]}
    if proc.returncode != 0:
        return {"ok": False, "error": "ingest_failed", "rc": proc.returncode, "detail": parsed}
    if isinstance(parsed, dict):
        return parsed
    return {"ok": True, "detail": parsed}


