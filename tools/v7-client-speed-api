        "observation_cadence_ms": safe_int(context.get("observation_cadence_ms"), 0),
        "clock_source": "time.monotonic_ns",
        "clock_domain_id": actual_clock,
        "clock_uncertainty_ms": safe_float(context.get("clock_uncertainty_ms"), 0.0),
        "first_failed_observation_monotonic_ns": safe_int(context.get("first_failed_observation_monotonic_ns"), 0),
        "confirmed_hard_failure_monotonic_ns": safe_int(context.get("confirmed_hard_failure_monotonic_ns"), 0),
        "first_successful_client_traffic_monotonic_ns": recovered_ns,
