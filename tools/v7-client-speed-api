def execute_ephemeral_client_namespace_probe(context, destination_ip):
    """Run one request as the existing synthetic WireGuard client.

    The namespace and veth exist only for the request and are removed in a
    finally block.  No production route, assignment, Matrix state or timer is
    changed.  The actual packet enters the server through its canonical wg0
    owner, so the user's source rule and selected target table are exercised.
    """
    profile = exact_certification_client_profile(context.get("source_address"))
    if profile is None:
        return {}, [{
            "error": "exact_certification_client_profile_missing_or_ambiguous",
            "fresh_socket": False,
            "payload_response_verified": False,
        }]
    try:
        profile_text = profile.read_text(encoding="utf-8")
    except OSError as exc:
        return {}, [{
            "error": f"client_profile_read_failed:{type(exc).__name__}",
            "fresh_socket": False,
            "payload_response_verified": False,
        }]
    metadata = wireguard_profile_metadata(profile_text)
    source = str(context.get("source_address") or "")
    if metadata.get("address") != source or not metadata.get("private_key"):
        return {}, [{
            "error": "client_profile_identity_or_key_invalid",
            "fresh_socket": False,
            "payload_response_verified": False,
        }]
    endpoint_host = str(metadata.get("endpoint_host") or "")
    try:
        endpoint_ip = socket.gethostbyname(endpoint_host)
    except OSError as exc:
        return {}, [{
            "error": f"client_endpoint_resolution_failed:{type(exc).__name__}",
            "fresh_socket": False,
            "payload_response_verified": False,
        }]

    route = route_lookup_for_exact_probe(destination_ip, {
        **context,
        "fwmark": 0,
        "ingress_interface": EXACT_PROBE_INGRESS_INTERFACE,
    })
    reuse_session = context.get("reuse_prepared_client_session") is True
    names = (
        exact_probe_session_names(source)
        if reuse_session
        else {
            "namespace": f"v7p{secrets.token_hex(3)}"[:15],
            "host_interface": "",
            "peer_interface": "",
            "client_interface": "",
        }
    )
    if not reuse_session:
        suffix = names["namespace"][3:]
        names.update({
            "host_interface": f"v7h{suffix}"[:15],
            "peer_interface": f"v7n{suffix}"[:15],
            "client_interface": f"v7w{suffix}"[:15],
        })
    namespace = names["namespace"]
    host_if = names["host_interface"]
    peer_if = names["peer_interface"]
    wg_if = names["client_interface"]
    link = exact_probe_link_addresses(source)
    cleanup = []
    started_ns = time.monotonic_ns()
    lock_handle = None
    session_ready = False
    session_reused = False
    try:
        EXACT_PROBE_LOCK.parent.mkdir(parents=True, exist_ok=True)
        lock_handle = EXACT_PROBE_LOCK.open("a+", encoding="utf-8")
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
        namespace_probe = _run_probe_command(
            ["ip", "netns", "exec", namespace, "ip", "link", "show", wg_if],
            timeout=2,
        )
        host_probe = _run_probe_command(
            ["ip", "link", "show", host_if], timeout=2,
        )
        session_reused = bool(
            reuse_session
            and namespace_probe.returncode == 0
            and host_probe.returncode == 0
        )
        if reuse_session and not session_reused:
            # A partial namespace is not a reusable client context.  Remove
            # only the deterministic Polygon fixture and rebuild it below.
            _run_probe_command(["ip", "netns", "del", namespace], timeout=5)
            _run_probe_command(["ip", "link", "del", host_if], timeout=5)
        ingress_key_proc = _run_probe_command(
            ["wg", "show", EXACT_PROBE_INGRESS_INTERFACE, "public-key"]
        )
        ingress_public_key = (ingress_key_proc.stdout or "").strip()
        if ingress_key_proc.returncode != 0 or not ingress_public_key:
            raise RuntimeError("canonical_ingress_public_key_unavailable")
        setup = (
            (["ip", "netns", "add", namespace], None),
            (["ip", "link", "add", host_if, "type", "veth", "peer", "name", peer_if], None),
            (["ip", "link", "set", peer_if, "netns", namespace], None),
            (["ip", "addr", "add", f"{link['gateway']}/{link['prefix']}", "dev", host_if], None),
            (["ip", "link", "set", host_if, "up"], None),
            (["ip", "netns", "exec", namespace, "ip", "link", "set", "lo", "up"], None),
            (["ip", "netns", "exec", namespace, "ip", "addr", "add", f"{link['client']}/{link['prefix']}", "dev", peer_if], None),
            (["ip", "netns", "exec", namespace, "ip", "link", "set", peer_if, "up"], None),
            (["ip", "netns", "exec", namespace, "ip", "route", "add", f"{endpoint_ip}/32", "via", link["gateway"], "dev", peer_if], None),
            (["ip", "netns", "exec", namespace, "ip", "link", "add", wg_if, "type", "wireguard"], None),
            (
                ["ip", "netns", "exec", namespace, "wg", "setconf", wg_if, "/dev/stdin"],
                wireguard_setconf_text(
                    profile_text,
                    # The Polygon client namespace is on this host.  Its
                    # outer WireGuard UDP packet must therefore enter the
                    # host-side veth directly rather than attempt an
                    # unroutable public-address round trip from 169.254/30.
                    # This changes only the runtime-only namespace fixture;
                    # the existing client profile and production endpoint are
                    # never written or modified.
                    endpoint_override=(
                        f"{link['gateway']}:"
                        f"{metadata['endpoint_port']}"
                        if metadata.get("endpoint_port") else ""
                    ),
                    # Some retained synthetic client artifacts predate a
                    # local wg0 key rotation.  The temporary namespace must
                    # authenticate against the live canonical ingress owner,
                    # while the stored client artifact remains untouched.
                    peer_public_key_override=ingress_public_key,
                ),
            ),
            (["ip", "netns", "exec", namespace, "ip", "addr", "add", f"{source}/32", "dev", wg_if], None),
            (["ip", "netns", "exec", namespace, "ip", "link", "set", wg_if, "up"], None),
            (["ip", "netns", "exec", namespace, "ip", "route", "add", "default", "dev", wg_if], None),
        )
        if not session_reused:
            for command, input_text in setup:
                proc = _run_probe_command(command, input_text=input_text)
                if proc.returncode != 0:
                    raise RuntimeError(
                        f"namespace_setup_failed:{command[-1]}:{(proc.stdout or '').strip()[:160]}"
                    )
        inode_proc = _run_probe_command([
            "ip", "netns", "exec", namespace, "stat", "-Lc", "%i",
            "/proc/self/ns/net",
        ])
        client_netns_inode = safe_int((inode_proc.stdout or "").strip(), 0)
        public_proc = _run_probe_command(
            ["wg", "pubkey"], input_text=metadata["private_key"] + "\n"
        )
        public_key = (public_proc.stdout or "").strip() if public_proc.returncode == 0 else ""
        allowed_proc = _run_probe_command(
            ["wg", "show", EXACT_PROBE_INGRESS_INTERFACE, "allowed-ips"]
        )
        peer_mapping = any(
            line.split()[0] == public_key
            and f"{source}/32" in line.split()[1:]
            for line in (allowed_proc.stdout or "").splitlines()
            if len(line.split()) >= 2
        )
        if not peer_mapping or not client_netns_inode:
            raise RuntimeError("prepared_client_session_identity_validation_failed")
        session_ready = True
        if context.get("prepare_client_session_only") is True:
            keepalive = _run_probe_command([
                "ip", "netns", "exec", namespace,
                "ping", "-c", "1", "-W", "1",
                EXACT_PROBE_TUNNEL_KEEPALIVE_ADDRESS,
            ], timeout=3)
            if keepalive.returncode != 0:
                session_ready = False
                raise RuntimeError("prepared_client_session_tunnel_handshake_failed")
            finished_ns = time.monotonic_ns()
            prepared = {
                "attempt": 1,
                "started_monotonic_ns": started_ns,
                "finished_monotonic_ns": finished_ns,
                "duration_ms": round((finished_ns - started_ns) / 1_000_000.0, 3),
                "status": "EXACT_CLIENT_PROBE_SESSION_PREPARED",
                "fresh_socket": False,
                "payload_response_verified": False,
                "client_tunnel_ingress_proven": True,
                "client_profile_peer_mapping_proven": True,
                "client_namespace_isolated": True,
                "client_network_namespace_inode": client_netns_inode,
                "prepared_session_reused": session_reused,
                "keepalive_returncode": keepalive.returncode,
                "source_address_fingerprint": sha256_text(source),
            }
            return prepared, [prepared]
        child_context = {
            "target_url": str(context.get("target_url") or ""),
            "destination_ip": destination_ip,
            "timeout_seconds": max(
                0.05, safe_int(context.get("timeout_ms"), 1000) / 1000.0
            ),
            "client_interface": wg_if,
            "source_address": source,
        }
        probe_proc = _run_probe_command(
            ["ip", "netns", "exec", namespace, sys.executable, "-c", _exact_namespace_http_script()],
            input_text=json.dumps(child_context, sort_keys=True),
            timeout=max(2, safe_int(context.get("timeout_ms"), 1000) // 1000 + 3),
        )
        try:
            result = json.loads(probe_proc.stdout or "{}")
        except json.JSONDecodeError:
            result = {"ok": False, "error": "client_namespace_probe_output_invalid"}
        response_text = str(result.get("response_text") or "").strip()
        expected_ip = str(context.get("expected_egress_ip") or "").strip()
        payload_ok = bool(result.get("ok") and response_text == expected_ip)
        attempt = {
            "attempt": 1,
            "started_monotonic_ns": safe_int(result.get("started_monotonic_ns"), started_ns),
            "finished_monotonic_ns": safe_int(result.get("finished_monotonic_ns"), time.monotonic_ns()),
            "duration_ms": round((safe_int(result.get("finished_monotonic_ns"), time.monotonic_ns()) - safe_int(result.get("started_monotonic_ns"), started_ns)) / 1_000_000.0, 3),
            "destination_ip": destination_ip,
            "route": route,
            "fresh_dns_resolution": False,
            "dns_mode": "DECLARED_NO_DNS",
            "fresh_socket": result.get("fresh_socket") is True,
            "source_bind_applied": result.get("source_bind_applied") is True,
            "source_identity_freebind_applied": False,
            "interface_bind_applied": True,
            "so_mark_applied": False,
            "host_policy_route_proven": bool(
                route.get("ok") is True
                and str(route.get("table") or "") == str(context.get("routing_table") or "")
                and str(route.get("dev") or "") == str(context.get("interface") or "")
            ),
            "client_tunnel_ingress_proven": bool(
                peer_mapping and client_netns_inode and result.get("client_interface_bound") is True
            ),
            "client_profile_peer_mapping_proven": peer_mapping,
            "client_namespace_isolated": bool(client_netns_inode),
            "client_network_namespace_inode": client_netns_inode,
            "prepared_session_reused": session_reused,
            "probe_protocol": str(
                result.get("probe_protocol") or "HTTPS_EGRESS_IP"
            ),
            "status_line": str(result.get("status_line") or ""),
            "payload_response_verified": payload_ok,
            "payload_fingerprint": str(result.get("payload_fingerprint") or ""),
            "response_matches_expected_egress_ip": response_text == expected_ip,
            "error": str(result.get("error") or ""),
        }
        return (attempt if payload_ok else {}), [attempt]
    except Exception as exc:
        finished_ns = time.monotonic_ns()
        return {}, [{
            "attempt": 1,
            "started_monotonic_ns": started_ns,
            "finished_monotonic_ns": finished_ns,
            "duration_ms": round((finished_ns - started_ns) / 1_000_000.0, 3),
            "error": f"{type(exc).__name__}:{exc}"[:240],
            "fresh_socket": False,
            "payload_response_verified": False,
        }]
    finally:
        if not reuse_session or not session_ready:
            _run_probe_command(["ip", "netns", "del", namespace], timeout=5)
            _run_probe_command(["ip", "link", "del", host_if], timeout=5)
        if lock_handle is not None:
            try:
                fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)
                lock_handle.close()
            except OSError:
                pass


def execute_fresh_exact_probe_request(context):
    parsed = urlparse(str(context.get("target_url") or ""))
    preferred_protocol = str(
        context.get("preferred_probe_protocol") or "HTTPS_EGRESS_IP"
    )
    host = str(
        context.get("stun_host")
        if preferred_protocol == "STUN_XOR_MAPPED_ADDRESS"
        else parsed.hostname
        or ""
    )
    port = int(
        context.get("stun_port") or 3478
        if preferred_protocol == "STUN_XOR_MAPPED_ADDRESS"
        else parsed.port or 443
    )
    timeout_seconds = max(0.05, safe_int(context.get("timeout_ms"), 1000) / 1000.0)
    retry_count = max(0, safe_int(context.get("retry_count"), 0))
    cadence_seconds = max(0.001, safe_int(context.get("observation_cadence_ms"), 100) / 1000.0)
    if str(context.get("probe_transport") or "") == "EXISTING_LOCAL_CLIENT_PROFILE_NAMESPACE":
        try:
            resolved = socket.getaddrinfo(
                host,
                port,
                socket.AF_INET,
                (
                    socket.SOCK_DGRAM
                    if preferred_protocol == "STUN_XOR_MAPPED_ADDRESS"
                    else socket.SOCK_STREAM
                ),
            )
            destination_ip = str(resolved[0][4][0])
        except (OSError, IndexError) as exc:
            return {}, [{
                "error": f"probe_destination_resolution_failed:{type(exc).__name__}",
                "fresh_socket": False,
                "payload_response_verified": False,
            }]
        preferred_context = {
            **context,
            "preferred_probe_protocol": preferred_protocol,
            "destination_port": port,
        }
        successful, attempts = execute_ephemeral_client_namespace_probe(
            preferred_context, destination_ip,
        )
        if (
            successful
            or preferred_protocol != "STUN_XOR_MAPPED_ADDRESS"
            or context.get("protocol_fallback_allowed") is not True
        ):
            return successful, attempts
        # A protocol failure must not become an availability claim. Reuse the
        # established HTTPS exact-client proof as a fail-closed compatibility
        # fallback; it may miss the fast SLO but preserves correctness.
        try:
            fallback_host = str(parsed.hostname or "")
            fallback_port = int(parsed.port or 443)
            fallback_resolved = socket.getaddrinfo(
                fallback_host,
                fallback_port,
                socket.AF_INET,
                socket.SOCK_STREAM,
            )
            fallback_ip = str(fallback_resolved[0][4][0])
        except (OSError, IndexError, ValueError) as exc:
            return {}, attempts + [{
                "error": f"https_fallback_resolution_failed:{type(exc).__name__}",
                "probe_protocol": "HTTPS_EGRESS_IP_FALLBACK",
                "fresh_socket": False,
                "payload_response_verified": False,
            }]
        fallback_context = {
            **context,
            "preferred_probe_protocol": "HTTPS_EGRESS_IP",
            "destination_port": fallback_port,
        }
        fallback_success, fallback_attempts = (
            execute_ephemeral_client_namespace_probe(
                fallback_context, fallback_ip,
            )
        )
        for row in fallback_attempts:
            if isinstance(row, dict):
                row["protocol_fallback_used"] = True
        return fallback_success, attempts + fallback_attempts
    attempts = []
    for attempt_index in range(retry_count + 1):
        started_ns = time.monotonic_ns()
        nonce = secrets.token_hex(16)
        sock = None
        tls_sock = None
        try:
            resolved = socket.getaddrinfo(host, port, socket.AF_INET, socket.SOCK_STREAM)
            if not resolved:
                raise OSError("dns_resolution_empty")
            destination_ip = str(resolved[0][4][0])
            if not ipaddress.ip_address(destination_ip).is_global:
                raise OSError("non_public_probe_destination_forbidden")
            route = route_lookup_for_exact_probe(destination_ip, context)
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(timeout_seconds)
            interface = str(context.get("interface") or "")
            # The exact certification identity is an ingress/client address,
            # not an address configured on the selected egress interface.
            # Linux IP_FREEBIND lets this read-only probe originate with that
            # exact source identity so the normal source rule and per-user
            # routing table are genuinely traversed.  Target-only probes keep
            # their configured interface address and do not use this option.
            source_identity_freebind = not bool(
                context.get("target_egress_interface_bound_probe")
            )
            if source_identity_freebind:
                sock.setsockopt(
                    socket.SOL_IP,
                    getattr(socket, "IP_FREEBIND", 15),
                    1,
                )
            sock.setsockopt(socket.SOL_SOCKET, getattr(socket, "SO_BINDTODEVICE", 25), interface.encode("utf-8") + b"\0")
            sock.setsockopt(socket.SOL_SOCKET, getattr(socket, "SO_MARK", 36), safe_int(context.get("fwmark"), 0))
            sock.bind((str(context.get("source_address") or ""), 0))
            sock.connect((destination_ip, port))
            tls_sock = ssl.create_default_context().wrap_socket(sock, server_hostname=host)
            request_url = _cache_busted_url(str(context.get("target_url") or ""), nonce)
            request_target = urlparse(request_url).path or "/"
            if urlparse(request_url).query:
                request_target += "?" + urlparse(request_url).query
            request = (
                f"GET {request_target} HTTP/1.1\r\n"
                f"Host: {host}\r\n"
                "Accept: text/plain\r\n"
                "Cache-Control: no-cache, no-store\r\n"
                "Pragma: no-cache\r\n"
                "Connection: close\r\n\r\n"
            ).encode("ascii")
            tls_sock.sendall(request)
            chunks = []
            total = 0
            while total < 65536:
                chunk = tls_sock.recv(min(8192, 65536 - total))
                if not chunk:
                    break
                chunks.append(chunk)
                total += len(chunk)
            raw = b"".join(chunks)
            header, separator, body = raw.partition(b"\r\n\r\n")
            status_line = header.split(b"\r\n", 1)[0].decode("ascii", errors="replace")
            response_text = body.decode("utf-8", errors="replace").strip()
            expected_ip = str(context.get("expected_egress_ip") or "").strip()
            payload_ok = bool(separator and " 200 " in status_line and response_text == expected_ip)
            finished_ns = time.monotonic_ns()
            attempt = {
                "attempt": attempt_index + 1,
                "started_monotonic_ns": started_ns,
                "finished_monotonic_ns": finished_ns,
                "duration_ms": round((finished_ns - started_ns) / 1_000_000.0, 3),
                "dns_addresses": sorted({str(row[4][0]) for row in resolved}),
                "destination_ip": destination_ip,
                "route": route,
                "fresh_dns_resolution": True,
                "fresh_socket": True,
                "source_bind_applied": True,
                "source_identity_freebind_applied": source_identity_freebind,
                "interface_bind_applied": True,
                "so_mark_applied": True,
                "status_line": status_line,
                "payload_response_verified": payload_ok,
                "payload_fingerprint": hashlib.sha256(body).hexdigest(),
                "response_matches_expected_egress_ip": response_text == expected_ip,
            }
            attempts.append(attempt)
            if payload_ok:
                return attempt, attempts
        except Exception as exc:
            finished_ns = time.monotonic_ns()
            attempts.append({
                "attempt": attempt_index + 1,
                "started_monotonic_ns": started_ns,
                "finished_monotonic_ns": finished_ns,
                "duration_ms": round((finished_ns - started_ns) / 1_000_000.0, 3),
                "error": f"{type(exc).__name__}:{exc}"[:240],
                "fresh_socket": sock is not None,
                "payload_response_verified": False,
            })
        finally:
            for handle in (tls_sock, sock):
                try:
                    if handle is not None:
                        handle.close()
                except OSError:
                    pass
        if attempt_index < retry_count:
            time.sleep(cadence_seconds)
    return {}, attempts


def prepare_exact_client_probe_session(source_address):
    """Warm one existing Polygon client tunnel before controlled T0.

    The fixture is runtime-only and contains no copied credential or decision
    state.  It represents the already-connected client condition that the
    recovery SLO is intended to measure; the server-side route remains owned
    by the normal per-user routing table.
    """
    source = str(source_address or "").strip()
    try:
        if not ipaddress.ip_address(source).is_private:
            raise ValueError("source_address_not_private")
    except ValueError as exc:
        return {
            "schema_version": "v7.exact-client-probe-session.v1",
            "status": "PROBE_INVALID",
            "ok": False,
            "blockers": [str(exc)],
        }
    prepared, attempts = execute_ephemeral_client_namespace_probe({
        "source_address": source,
        "interface": "",
        "routing_table": "",
        "reuse_prepared_client_session": True,
        "prepare_client_session_only": True,
    }, "1.1.1.1")
    ok = bool(prepared.get("status") == "EXACT_CLIENT_PROBE_SESSION_PREPARED")
    return {
        "schema_version": "v7.exact-client-probe-session.v1",
        "status": (
            "EXACT_CLIENT_PROBE_SESSION_PREPARED"
            if ok else "PROBE_INVALID"
        ),
        "ok": ok,
        "source_address_fingerprint": sha256_text(source),
        "prepared_session_reused": bool(
            prepared.get("prepared_session_reused")
        ),
        "duration_ms": prepared.get("duration_ms"),
        "client_tunnel_ingress_proven": bool(
            prepared.get("client_tunnel_ingress_proven")
        ),
