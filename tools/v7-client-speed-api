def read_text(path, default=""):
    try:
        return Path(path).read_text(encoding="utf-8")
    except OSError:
        return default


def parse_registry():
    users = {}
    for line in read_text(USERS_REG).splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        row = {}
        for part in line.split():
            if "=" in part:
                k, v = part.split("=", 1)
                row[k] = v
        if row.get("ip"):
            users[row["ip"]] = row
    return users


def parse_egress_registry():
    rows = []
    for line in read_text(EGRESS_REG).splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        row = {}
        for part in line.split():
            if "=" in part:
                k, v = part.split("=", 1)
                row[k] = v
        if row.get("id") and str(row.get("enabled", "1")) == "1":
            rows.append(row)
    return rows


def exact_client_probe_readiness():
    """Project whether an existing certification client can own CT-M0F-V.

    This is deliberately a compact read model over the existing users,
    egress and client-agent owners.  It does not enqueue a command, disclose
    the selected identity, create a context, or perform a network operation.
    """
    users = parse_registry()
    agents_root = read_json_file(AGENTS, {"agents": {}})
    agents = (
        agents_root.get("agents")
        if isinstance(agents_root, dict)
        and isinstance(agents_root.get("agents"), dict)
        else {}
    )
    egresses = {row.get("id"): row for row in parse_egress_registry()}
    now = int(time.time())
    eligible = []
    for ip, row in sorted(users.items()):
        agent = agents.get(ip) if isinstance(agents.get(ip), dict) else {}
        capabilities = {
            str(item)
            for item in (
                agent.get("capabilities")
                if isinstance(agent.get("capabilities"), list)
                else []
            )
        }
        current = str(row.get("current") or "")
        egress = egresses.get(current) if isinstance(egresses.get(current), dict) else {}
        local_profile_ready = bool(
            os.geteuid() == 0 and exact_certification_client_profile(ip)
        )
        expected_ip = str(egress.get("expected_ip") or "")
        try:
            expected_ip_ok = bool(ipaddress.ip_address(expected_ip).is_global)
        except ValueError:
            expected_ip_ok = False
        if not all((
            str(row.get("enabled", "1")) == "1",
            str(row.get("certification_user", "")).lower() in {"1", "true", "yes"},
            (
                local_profile_ready
                or (
                    int(agent.get("online_until") or 0) >= now
                    and "exact_client_network_context_traffic_probe_v1"
                    in capabilities
                )
            ),
            current,
            str(row.get("table") or "").isdigit(),
            str(egress.get("interface") or ""),
            expected_ip_ok,
        )):
            continue
        eligible.append({
            "identity_fingerprint": sha256_text(ip),
            "current_egress": current,
            "routing_table_fingerprint": sha256_text(row.get("table")),
            "target_interface_fingerprint": sha256_text(egress.get("interface")),
            "expected_egress_fingerprint": sha256_text(expected_ip),
            "execution_mode": (
                "EXISTING_LOCAL_CLIENT_PROFILE_NAMESPACE"
                if local_profile_ready else "ONLINE_CLIENT_AGENT"
            ),
            "agent_last_seen": str(agent.get("last_seen") or ""),
            "online_until": int(agent.get("online_until") or 0),
        })
    selected = eligible[0] if eligible else {}
    blockers = []
    if not users:
        blockers.append("users_registry_unavailable")
    if not any(
        str(row.get("certification_user", "")).lower() in {"1", "true", "yes"}
        and str(row.get("enabled", "1")) == "1"
        for row in users.values()
    ):
        blockers.append("enabled_certification_identity_missing")
    if not eligible:
        blockers.append("exact_certification_client_execution_context_missing")
    return {
        "schema_version": "v7.exact-client-probe-readiness.v1",
        "status": (
            "EXACT_CERTIFICATION_CLIENT_CONTEXT_READY"
            if selected else "STOP_SAFE_EXACT_CERTIFICATION_CLIENT_CONTEXT_REQUIRED"
        ),
        "ok": bool(selected),
        "owner": "existing tools/v7-client-speed-api client-agent owner",
        "eligible_context_count": len(eligible),
        "selected_context": selected,
        "identity_disclosed": False,
        "command_enqueued": False,
        "network_probe_executed": False,
        "runtime_mutation_performed": False,
        "routing_mutation_performed": False,
        "user_movement": 0,
        "blockers": sorted(set(blockers)),
        "next_required_consumer": (
            "existing Controlled Production owner issues one short-lived exact probe command/context"
            if selected
            else "existing Controlled Production owner provisions one local Polygon profile or activates one dedicated certification client agent"
        ),
    }


