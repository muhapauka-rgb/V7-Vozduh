      return {bytes: TARGET_BYTES, duration_ms: Math.round(durationMs), mbps: Math.round(mbps * 100) / 100, target_url: 'https://speed.cloudflare.com/__down'};
    }
    function queue(sample) {
      const list = JSON.parse(localStorage.getItem('v7_speed_pending') || '[]');
      list.push(sample);
      localStorage.setItem('v7_speed_pending', JSON.stringify(list.slice(-10)));
    }
    async function submit(sample) {
      const r = await fetch('/api/sample', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(sample)});
      if (!r.ok) throw new Error(`submit failed: ${r.status}`);
      return await r.json();
    }
    async function runTest(mode, command = {}) {
      if (typeof command === 'string') command = {id: command};
      const egress = document.getElementById('egress').value;
      log(`running ${mode} test...`);
      try {
        const sample = await measure();
        sample.mode = mode;
        sample.egress = mode === 'direct' ? egress : '';
        sample.command_id = command.id || '';
        sample.ingress_type = command.ingress_type || command.ingress || '';
        sample.client_transport = command.client_transport || '';
        sample.path_profile = command.path_profile || 'client-speed-api';
        sample.measured_at = new Date().toISOString();
        if (mode === 'v7') document.getElementById('v7Metric').textContent = fmt(sample.mbps);
        if (mode === 'direct') document.getElementById('directMetric').textContent = fmt(sample.mbps);
        try {
          const saved = await submit(sample);
          log(JSON.stringify(saved, null, 2));
        } catch (e) {
          queue(sample);
          log(`saved locally; reconnect to V7 and tap Sync.\\n${e.message}`);
        }
      } catch (e) {
        log(`test failed: ${e.message}`);
      }
    }
    const runningCommands = new Set();
    async function pollCommands() {
      try {
        const r = await fetch('/api/agent/poll', {cache:'no-store'});
        if (!r.ok) return;
        const d = await r.json();
        if (d.agent) document.getElementById('who').textContent = `${d.ip} · current egress: ${d.agent.current_egress || 'unknown'} · online`;
        for (const cmd of d.commands || []) {
          if (runningCommands.has(cmd.id)) continue;
          runningCommands.add(cmd.id);
          if (cmd.type === 'speedtest') {
            const mode = cmd.mode || 'v7';
            if (cmd.egress) document.getElementById('egress').value = cmd.egress;
            await runTest(mode, cmd);
          }
        }
      } catch (e) {}
    }
    async function syncPending() {
      const list = JSON.parse(localStorage.getItem('v7_speed_pending') || '[]');
      if (!list.length) { log('nothing to sync'); return; }
      const rest = [];
      for (const item of list) {
        try { await submit(item); } catch (e) { rest.push(item); }
      }
      localStorage.setItem('v7_speed_pending', JSON.stringify(rest));
      log(rest.length ? `${rest.length} samples still pending` : 'all samples synced');
      await loadMe();
    }
    document.getElementById('egress').addEventListener('change', loadMe);
    loadMe();
    syncPending().catch(()=>{});
    pollCommands();
    setInterval(pollCommands, 5000);
