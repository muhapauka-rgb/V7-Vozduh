    required_evidence = candidate.get("evidence")
    if not all((
        candidate.get("terminal") == "REDUNDANT_LINK_PROVEN",
        candidate.get("mutation_performed") is False,
        candidate.get("answer_disclosed_to_executor") is False,
        candidate.get("changed_path") == "benchmark_target.py",
        isinstance(candidate.get("redundant_symbol"), str),
        bool(candidate.get("redundant_symbol")),
        isinstance(required_evidence, list),
        bool(required_evidence),
        isinstance(candidate.get("control_observables"), list),
        bool(candidate.get("control_observables")),
        isinstance(candidate.get("counterfactual_observables"), list),
        bool(candidate.get("counterfactual_observables")),
        isinstance(candidate.get("safety_compatibility_invariants"), list),
        bool(candidate.get("safety_compatibility_invariants")),
        bool(candidate.get("rollback")),
        bool(candidate.get("native_agent_id")),
        candidate.get("fork_turns") == "none",
        candidate.get("platform_dispatch") == "spawn_agent",
    )):
        errors.append("benchmark_candidate_contract_invalid")
    if control.get("target_before_sha256") != _sha(target.read_bytes()):
        errors.append("benchmark_candidate_mutated_fixture_before_authorization")
    if control.get("product_worktree_fingerprint") != _product_worktree_fingerprint():
        errors.append("benchmark_candidate_product_worktree_changed")
    if control.get("cps_sha256") != _sha((ROOT / "docs/programs/V7_CURRENT_PROGRAM_STATE.md").read_bytes()):
        errors.append("benchmark_candidate_cps_changed")
    source = target.read_text(encoding="utf-8")
    if str(candidate.get("redundant_symbol") or "") not in source:
        errors.append("benchmark_candidate_symbol_not_in_fixture")
    if errors:
        return {
            "final_verdict": "STOP_SAFE",
            "terminal": "STOP_SAFE_BENCHMARK_CANDIDATE_NOT_AUTHORIZED",
            "errors": sorted(set(errors)),
        }
    authorization = {
        "schema": "v7.code-optimization-hidden-benchmark-cleanup-authorization.v1",
        "candidate_sha256": _sha(candidate_path.read_bytes()),
        "candidate_native_agent_id": candidate["native_agent_id"],
