def _benchmark_observe(fixture: Path) -> tuple[int, dict[str, Any], str]:
    completed = subprocess.run(
        [sys.executable, str(fixture / "observe_benchmark.py")], cwd=fixture,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
        timeout=60, check=False,
    )
    try:
        receipt = json.loads(completed.stdout)
    except json.JSONDecodeError:
        receipt = {}
    return completed.returncode, receipt, completed.stdout


def _product_worktree_fingerprint() -> str:
    completed = subprocess.run(
        ["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
        cwd=ROOT,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False,
    )
    if completed.returncode:
        return _sha(b"GIT_INVENTORY_ERROR\0" + completed.stdout)
    records: list[dict[str, str]] = []
    for raw in sorted(item for item in completed.stdout.split(b"\0") if item):
        relative = os.fsdecode(raw)
        path = ROOT / relative
        if path.is_symlink():
            records.append({"path": relative, "kind": "symlink", "sha256": _sha(os.fsencode(os.readlink(path)))})
        elif path.is_file():
            records.append({"path": relative, "kind": "file", "sha256": _sha(path.read_bytes())})
        else:
            records.append({"path": relative, "kind": "missing", "sha256": "MISSING"})
    return _sha(json.dumps(records, sort_keys=True, separators=(",", ":")).encode("utf-8"))


