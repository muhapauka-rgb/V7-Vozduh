#!/usr/bin/env python3
"""Disposable packaging and deterministic gates for native Code Optimization agents."""

from __future__ import annotations

import argparse
import ast
import hashlib
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "tools"))
import v7_sync_lib as sync_lib  # noqa: E402


REVIEW_ASPECTS = {
    "ARCHITECTURE_REVIEW", "SAFETY_REGRESSION_REVIEW", "EVIDENCE_REVIEW",
    "QUALITY_COMPLEXITY_REVIEW", "MISSION_INTEGRITY_REVIEW",
}

# Run artifacts live only in a caller-provided disposable directory.  They are
# evidence for one invocation, never an OMP registry or a new truth source.
RUN_MANIFEST_SCHEMA = "v7.code-optimization-disposable-run-manifest.v1"
RUN_CHECKPOINT_SCHEMA = "v7.code-optimization-disposable-run-checkpoint.v1"
MODEL_ARTIFACT_SCHEMA = "v7.code-optimization-model-authored-external-artifact.v1"
ORCHESTRATOR_ATTESTATION_SCHEMA = "v7.code-optimization-orchestrator-attestation.v1"


def _sha(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def _json_fingerprint(value: Any) -> str:
    return _sha(json.dumps(
        value, ensure_ascii=False, sort_keys=True, separators=(",", ":"),
    ).encode("utf-8"))


def _write_json(path: Path, value: Any, *, immutable: bool = True) -> str:
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = json.dumps(value, ensure_ascii=False, sort_keys=True, indent=2).encode("utf-8") + b"\n"
    path.write_bytes(payload)
    if immutable:
        path.chmod(0o444)
    return _sha(payload)


def _read_json(path: Path) -> Any:
    return json.loads(path.read_text(encoding="utf-8"))


def _agent_view(packet: dict[str, Any]) -> dict[str, Any]:
    subgraph = packet.get("subgraph_result") or {}
    unknown_counts: dict[str, int] = {}
    for item in subgraph.get("unknown_references") or []:
        if isinstance(item, dict):
            identity = str(item.get("called") or item.get("kind") or "UNKNOWN")
            unknown_counts[identity] = unknown_counts.get(identity, 0) + 1
    return {
        key: packet.get(key) for key in (
            "packet_fingerprint", "mission_id", "mission_intent_fingerprint",
            "profile_fingerprint", "run_nonce", "repo_fingerprint", "domain_id",
            "owner", "entry_condition", "source_paths", "source_fingerprints",
            "nodes", "edges", "canonical_to_be", "structural_baseline",
            "semantic_taxonomy", "semantic_question", "required_symbol_evidence",
            "required_hypothesis_fields", "required_reviews", "submission_consumer",
        )
    } | {
        "input_fingerprint": (packet.get("profile_contract") or {}).get("input_fingerprint"),
        "responsibility_subgraph_identity": {
            key: subgraph.get(key) for key in (
                "domain_id", "repo_fingerprint", "subgraph_fingerprint",
                "result_fingerprint", "generated_at", "expires_at",
            )
        },
        "unknown_reference_counts": unknown_counts,
        "evidence_items": (packet.get("evidence_package") or {}).get("evidence_items") or [],
    }


def _git_head() -> str:
    return subprocess.run(
        ["git", "rev-parse", "HEAD"], cwd=ROOT, stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL, text=True, check=False,
    ).stdout.strip()


def _run_snapshot(packets: list[dict[str, Any]]) -> dict[str, Any]:
    """Capture every identity that may invalidate a prepared semantic packet."""
    paths = sorted({
        path for packet in packets for path in (packet.get("source_paths") or [])
    })
    source = {
        path: _sha((ROOT / path).read_bytes()) if (ROOT / path).is_file() else "MISSING"
        for path in paths
    }
    system_map = ROOT / "docs/reference/SYSTEM_MAP.md"
    return {
        "base_commit": _git_head(),
        "worktree_fingerprint": _product_worktree_fingerprint(),
        "system_map_sha256": _sha(system_map.read_bytes()) if system_map.is_file() else "MISSING",
        "source_fingerprints": source,
    }


def _stop_safe(terminal: str, *errors: str) -> dict[str, Any]:
    return {"final_verdict": "STOP_SAFE", "terminal": terminal, "errors": sorted(set(errors))}


def _load_run_manifest(bundle: Path) -> tuple[dict[str, Any], dict[str, Any]]:
    try:
        manifest = _read_json(bundle / "run-manifest.json")
        checkpoint = _read_json(bundle / "checkpoint.json")
    except (OSError, json.JSONDecodeError):
        return {}, _stop_safe("STOP_SAFE_CODE_OPTIMIZATION_RUN_MANIFEST_MISSING", "run_manifest_or_checkpoint_missing")
    if not isinstance(manifest, dict) or manifest.get("schema") != RUN_MANIFEST_SCHEMA:
        return {}, _stop_safe("STOP_SAFE_CODE_OPTIMIZATION_RUN_MANIFEST_INVALID", "run_manifest_schema_invalid")
    if not isinstance(checkpoint, dict) or checkpoint.get("schema") != RUN_CHECKPOINT_SCHEMA:
        return {}, _stop_safe("STOP_SAFE_CODE_OPTIMIZATION_RUN_CHECKPOINT_INVALID", "run_checkpoint_schema_invalid")
    return {"manifest": manifest, "checkpoint": checkpoint}, {}


def _verify_run_manifest(bundle: Path) -> tuple[dict[str, Any], dict[str, Any]]:
    state, error = _load_run_manifest(bundle)
    if error:
        return {}, error
    manifest = state["manifest"]
    checkpoint = state["checkpoint"]
    manifest_sha = _sha((bundle / "run-manifest.json").read_bytes())
    snapshot = manifest.get("snapshot") if isinstance(manifest.get("snapshot"), dict) else {}
    errors: list[str] = []
    if checkpoint.get("manifest_sha256") != manifest_sha:
        errors.append("run_checkpoint_manifest_binding_mismatch")
    expected_checkpoint_fingerprint = _json_fingerprint({
        key: value for key, value in checkpoint.items() if key != "checkpoint_fingerprint"
    })
    if checkpoint.get("checkpoint_fingerprint") != expected_checkpoint_fingerprint:
        errors.append("run_checkpoint_fingerprint_mismatch")
    ordered = list(manifest.get("ordered_domain_ids") or [])
    completed = list(checkpoint.get("completed_domains") or [])
    index = checkpoint.get("current_domain_index")
    if not isinstance(index, int) or index < 0 or index > len(ordered):
        errors.append("run_checkpoint_index_invalid")
    else:
        completed_ids = [str(item.get("domain_id") or "") for item in completed if isinstance(item, dict)]
        if completed_ids != ordered[:index]:
            errors.append("run_checkpoint_completed_prefix_invalid")
        expected_current = None if index == len(ordered) else ordered[index]
        if checkpoint.get("current_domain_id") != expected_current:
            errors.append("run_checkpoint_current_domain_invalid")
    if snapshot.get("base_commit") != _git_head():
        errors.append("run_manifest_commit_drift")
    if snapshot.get("worktree_fingerprint") != _product_worktree_fingerprint():
        errors.append("run_manifest_worktree_drift")
    system_map = ROOT / "docs/reference/SYSTEM_MAP.md"
    current_map = _sha(system_map.read_bytes()) if system_map.is_file() else "MISSING"
    if snapshot.get("system_map_sha256") != current_map:
        errors.append("run_manifest_system_map_drift")
    for path, fingerprint in (snapshot.get("source_fingerprints") or {}).items():
        current = _sha((ROOT / path).read_bytes()) if (ROOT / path).is_file() else "MISSING"
        if current != fingerprint:
            errors.append(f"run_manifest_source_drift:{path}")
    if errors:
        return {}, _stop_safe("STOP_SAFE_CODE_OPTIMIZATION_RUN_SNAPSHOT_DRIFT", *errors)
    return state, {}


def _write_checkpoint(bundle: Path, checkpoint: dict[str, Any]) -> None:
    checkpoint["checkpoint_fingerprint"] = _sha(json.dumps(
        {key: value for key, value in checkpoint.items() if key != "checkpoint_fingerprint"},
        sort_keys=True, separators=(",", ":"), ensure_ascii=False,
    ).encode("utf-8"))
    _write_json(bundle / "checkpoint.json", checkpoint, immutable=False)


def _structural_native_receipt_errors(
    manifest: dict[str, Any], packet: dict[str, Any], result: dict[str, Any],
) -> list[str]:
    """Bind observed contexts without claiming platform cryptography."""
    manifest_fingerprint = _json_fingerprint(manifest)
    roles = ((result.get("native_context_manifest") or {}).get("roles") or [])
    if len(roles) != 1 or not isinstance(roles[0], dict):
        return ["native_analyst_receipt_missing"]
    analyst = roles[0]
    reviews = result.get("reviews") if isinstance(result.get("reviews"), list) else []
    reviewer_ids = {str((review.get("native_context_proof") or {}).get("native_agent_id") or "") for review in reviews if isinstance(review, dict)}
    errors: list[str] = []
    if analyst.get("role") != "ANALYST" or not analyst.get("native_agent_id"):
        errors.append("native_analyst_receipt_invalid")
    if analyst.get("manifest_fingerprint") != manifest_fingerprint:
        errors.append("native_analyst_manifest_binding_mismatch")
    if packet.get("packet_fingerprint") not in (analyst.get("input_artifact_fingerprints") or []):
        errors.append("native_analyst_packet_binding_missing")
    if not analyst.get("output_artifact_fingerprint"):
        errors.append("native_analyst_result_hash_missing")
    if len(reviewer_ids) != 1 or "" in reviewer_ids or analyst.get("native_agent_id") in reviewer_ids:
        errors.append("native_reviewer_receipt_missing_or_colliding")
    for review in reviews:
        proof = review.get("native_context_proof") if isinstance(review, dict) else {}
        if not isinstance(proof, dict) or proof.get("analyst_result_fingerprint") != analyst.get("output_artifact_fingerprint"):
            errors.append("native_reviewer_result_binding_mismatch")
    attestation = result.get("orchestrator_attestation")
    if not isinstance(attestation, dict) or attestation.get("schema") != ORCHESTRATOR_ATTESTATION_SCHEMA:
        errors.append("orchestrator_attestation_missing")
    else:
        reviewer_id = next(iter(reviewer_ids), "")
        if attestation.get("manifest_fingerprint") != manifest_fingerprint:
            errors.append("orchestrator_attestation_manifest_mismatch")
        if attestation.get("packet_fingerprint") != packet.get("packet_fingerprint"):
            errors.append("orchestrator_attestation_packet_mismatch")
        if attestation.get("analyst_context_ref") != analyst.get("native_agent_id"):
            errors.append("orchestrator_attestation_analyst_context_mismatch")
        if attestation.get("reviewer_context_ref") != reviewer_id:
            errors.append("orchestrator_attestation_reviewer_context_mismatch")
        if attestation.get("analyst_payload_hash") != analyst.get("output_artifact_fingerprint"):
            errors.append("orchestrator_attestation_analyst_hash_mismatch")
        review_hashes = {
            str((review.get("native_context_proof") or {}).get("output_artifact_fingerprint") or "")
            for review in reviews if isinstance(review, dict)
        }
        if len(review_hashes) != 1 or attestation.get("reviewer_payload_hash") not in review_hashes:
            errors.append("orchestrator_attestation_reviewer_hash_mismatch")
        if attestation.get("provenance_level") != "ORCHESTRATOR_OBSERVED_NOT_CRYPTOGRAPHIC":
            errors.append("orchestrator_attestation_provenance_invalid")
        if attestation.get("provenance_verified_by_python") is not False:
            errors.append("orchestrator_attestation_python_provenance_claim_invalid")
    return sorted(set(errors))


def orchestrator_attestation(
    *, manifest_fingerprint: str, packet_fingerprint: str, analyst_payload_hash: str,
    reviewer_payload_hash: str, analyst_context_ref: str, reviewer_context_ref: str,
) -> dict[str, Any]:
    """Narrow observation record; it is explicitly not platform provenance."""
    return {
        "schema": ORCHESTRATOR_ATTESTATION_SCHEMA,
        "artifact_kind": "ORCHESTRATOR_ATTESTATION",
        "manifest_fingerprint": manifest_fingerprint, "packet_fingerprint": packet_fingerprint,
        "analyst_payload_hash": analyst_payload_hash, "reviewer_payload_hash": reviewer_payload_hash,
        "analyst_context_ref": analyst_context_ref, "reviewer_context_ref": reviewer_context_ref,
        "role_order": ["ANALYST", "REVIEWER"],
        "provenance_level": "ORCHESTRATOR_OBSERVED_NOT_CRYPTOGRAPHIC",
        "provenance_verified_by_python": False,
    }


def prepare(args: argparse.Namespace) -> dict[str, Any]:
    output = Path(args.output_dir).resolve()
    output.mkdir(parents=True, exist_ok=True)
    if (output / "run-manifest.json").exists() or (output / "checkpoint.json").exists():
        state, error = _verify_run_manifest(output)
        if error:
            return error
        checkpoint = state["checkpoint"]
        return {
            "schema": "v7.code-optimization-disposable-bundle.v2",
            "bundle_dir": str(output), "final_verdict": "CONTINUE_SAME_MISSION",
            "terminal": "CURRENT_DOMAIN_ALREADY_PREPARED",
            "current_domain_id": checkpoint.get("current_domain_id"),
            "completed_domain_count": len(checkpoint.get("completed_domains") or []),
            "review_attempt": checkpoint.get("review_attempt"),
        }
    prepared = sync_lib.code_optimization_operational_campaign(
        root=ROOT, mode=args.mode, domain_id=args.domain_id,
        changed_dependencies=args.changed,
    )
    if prepared.get("terminal") != "SEMANTIC_EXECUTOR_REQUIRED":
        return prepared
    packets = list(prepared.get("pending_packets") or [])
    request = {
        "mode": args.mode, "domain_id": args.domain_id,
        "changed_dependencies": list(args.changed or []),
    }
    if not packets:
        return _stop_safe("STOP_SAFE_CODE_OPTIMIZATION_NO_CURRENT_DOMAIN", "no_owner_backed_domains_prepared")
    request_sha = _write_json(output / "request.json", request)
    snapshot = _run_snapshot(packets)
    ordered_domains = [str(packet.get("domain_id") or "") for packet in packets]
    if not all(ordered_domains) or len(set(ordered_domains)) != len(ordered_domains):
        return _stop_safe("STOP_SAFE_CODE_OPTIMIZATION_DOMAIN_ORDER_INVALID", "domain_identity_missing_or_duplicate")
    manifest = {
        "schema": RUN_MANIFEST_SCHEMA,
        "mission_id": packets[0].get("mission_id"),
        "profile_fingerprint": packets[0].get("profile_fingerprint"),
        "mission_intent_fingerprint": packets[0].get("mission_intent_fingerprint"),
        "run_nonce": packets[0].get("run_nonce"),
        "request": request,
        "snapshot": snapshot,
        "ordered_domain_ids": ordered_domains,
        "packets_by_domain": {str(packet["domain_id"]): packet for packet in packets},
        "manifest_effect": "DISPOSABLE_DERIVED_CHECKPOINT_NOT_OWNER_OR_REGISTRY",
    }
    manifest_sha = _write_json(output / "run-manifest.json", manifest)
    _write_json(output / "prepared-packets.json", packets)
    checkpoint = {
        "schema": RUN_CHECKPOINT_SCHEMA,
        "manifest_sha256": manifest_sha,
        "current_domain_index": 0,
        "current_domain_id": ordered_domains[0],
        "completed_domains": [],
        "candidate_status": "NOT_STARTED",
        "review_attempt": 0,
        "next_action": "DISPATCH_NATIVE_ANALYST_FOR_CURRENT_DOMAIN",
    }
    _write_checkpoint(output, checkpoint)
    current_packet = packets[0]
    current_sha = _write_json(output / "current-packet.json", current_packet, immutable=False)
    view_sha = _write_json(output / "agent-packets.json", {
        "schema": "v7.code-optimization-native-agent-input.v1",
        "packets": [_agent_view(current_packet)],
    }, immutable=False)
    summary = {
        "schema": "v7.code-optimization-disposable-bundle.v2",
        "bundle_dir": str(output), "packet_count": 1,
        "total_domain_count": len(packets), "current_domain_id": ordered_domains[0],
        "request_sha256": request_sha, "run_manifest_sha256": manifest_sha,
        "current_packet_sha256": current_sha,
        "agent_packets_sha256": view_sha,
        "campaign_fingerprint": prepared.get("campaign_fingerprint"),
        "coverage_terminal": (
            "PARTIAL_OWNER_BACKED_COVERAGE"
            if prepared.get("blocked_domains") else "FULL_ACTIVE_COVERAGE"
        ),
        "blocked_domains": prepared.get("blocked_domains") or [],
        "final_verdict": "CONTINUE_SAME_MISSION", "terminal": "SEMANTIC_EXECUTOR_REQUIRED",
        "snapshot": snapshot,
        "roles": ["ANALYST", "REVIEWER"],
        "review_aspects": sorted(REVIEW_ASPECTS),
        "next_action": "run ANALYST once per checkpointed domain, then one independent REVIEWER context for all five aspects",
        "durable_queue_or_registry_created": False,
    }
    _write_json(output / "bundle.json", summary)
    return summary


def consume(args: argparse.Namespace) -> dict[str, Any]:
    bundle = Path(args.bundle_dir).resolve()
    state, error = _verify_run_manifest(bundle)
    if error:
        return error
    request = _read_json(bundle / "request.json")
    packets = _read_json(bundle / "prepared-packets.json")
    results = _read_json(Path(args.results).resolve())
    if not isinstance(results, list):
        return {"final_verdict": "STOP_SAFE", "terminal": "STOP_SAFE_NATIVE_RESULTS_NOT_LIST"}
    checkpoint = state["checkpoint"]
    ordered = list(state["manifest"].get("ordered_domain_ids") or [])
    completed = list(checkpoint.get("completed_domains") or [])
    result_by_domain = {
        str((item.get("output") or {}).get("domain_id") or ""): item
        for item in results if isinstance(item, dict)
    }
    binding_errors: list[str] = []
    if checkpoint.get("current_domain_id") is not None or len(completed) != len(ordered):
        binding_errors.append("all_domain_checkpoints_not_complete")
    for record in completed:
        domain_id = str(record.get("domain_id") or "") if isinstance(record, dict) else ""
        supplied = result_by_domain.get(domain_id)
        if not isinstance(supplied, dict):
            binding_errors.append(f"checkpoint_result_missing:{domain_id}")
            continue
        if record.get("result_artifact_fingerprint") != _json_fingerprint(supplied):
            binding_errors.append(f"checkpoint_result_hash_mismatch:{domain_id}")
        if record.get("result_fingerprint") != supplied.get("result_fingerprint"):
            binding_errors.append(f"checkpoint_result_identity_mismatch:{domain_id}")
    if binding_errors:
        return _stop_safe("STOP_SAFE_CODE_OPTIMIZATION_CHECKPOINT_RESULT_BINDING_INVALID", *binding_errors)
    result = sync_lib.code_optimization_operational_campaign(
        root=ROOT, mode=request["mode"], domain_id=request.get("domain_id") or "",
        changed_dependencies=request.get("changed_dependencies") or [],
        prepared_packets=packets, executor_results=results,
    )
    _write_json(Path(args.output).resolve(), result, immutable=False)
    return result


def ingest_domain(args: argparse.Namespace) -> dict[str, Any]:
    """Package verbatim model artifacts plus a narrow orchestrator observation."""
    bundle = Path(args.bundle_dir).resolve()
    state, error = _verify_run_manifest(bundle)
    if error:
        return error
    manifest, progress = state["manifest"], state["checkpoint"]
    domain_id = str(progress.get("current_domain_id") or "")
    packet = (manifest.get("packets_by_domain") or {}).get(domain_id)
    analyst_path = Path(args.analyst).resolve()
    reviewer_path = Path(args.reviewer).resolve()
    attestation_path = Path(args.attestation).resolve()
    try:
        analyst = _read_json(analyst_path)
        reviewer = _read_json(reviewer_path)
        attestation = _read_json(attestation_path)
    except (OSError, json.JSONDecodeError):
        return _stop_safe("STOP_SAFE_INVALID_NATIVE_AGENT_OUTPUT", "model_or_attestation_artifact_not_json")
    analyst_hash = _sha(analyst_path.read_bytes())
    reviewer_hash = _sha(reviewer_path.read_bytes())
    manifest_fingerprint = _json_fingerprint(manifest)
    required_analyst = set(sync_lib.CODE_OPTIMIZATION_OUTPUT_FIELDS) | {
        "symbol_evidence", "counterfactual_attempts", "considered_mechanisms",
    }
    required_reviewer = {
        "schema", "analyst_payload_hash", "sections", "verdict",
        "rejected_candidate_ids", "rejection_reasons",
    }
    errors: list[str] = []
    if not isinstance(packet, dict):
        errors.append("current_domain_packet_missing")
    if not isinstance(analyst, dict) or any(field not in analyst for field in required_analyst):
        errors.append("analyst_payload_fields_missing")
    if isinstance(analyst, dict) and ({"reviews", "review_verdict", "reviewer_context_ref"} & set(analyst)):
        errors.append("analyst_payload_contains_review")
    if isinstance(packet, dict) and isinstance(analyst, dict):
        profile = packet.get("profile_contract") or {}
        if analyst.get("mission_reference") != profile.get("mission_id"):
            errors.append("analyst_mission_reference_invalid")
        if analyst.get("profile_reference") != profile.get("profile_fingerprint"):
            errors.append("analyst_profile_reference_invalid")
        if analyst.get("input_fingerprint") != profile.get("input_fingerprint"):
            errors.append("analyst_input_fingerprint_invalid")
        subgraph = packet.get("subgraph_result") or {}
        expected_subgraph_binding = {
            key: subgraph.get(key) for key in (
                "domain_id", "repo_fingerprint", "subgraph_fingerprint",
                "result_fingerprint", "generated_at", "expires_at",
            )
        }
        if analyst.get("responsibility_subgraph") != expected_subgraph_binding:
            errors.append("analyst_responsibility_subgraph_binding_invalid")
        evidence_items = (packet.get("evidence_package") or {}).get("evidence_items") or []
        evidence = {
            str(item.get("evidence_id") or ""): set(item.get("supports_claims") or [])
            for item in evidence_items if isinstance(item, dict)
        }
        for item in analyst.get("responsibility_classifications") or []:
            if not isinstance(item, dict):
                errors.append("analyst_classification_invalid")
                continue
            if item.get("classification") != "UNKNOWN":
                required = {
                    "subject", "caller", "consumer", "behavior_state_effect",
                    "semantic_contribution", "invalidation_triggers", "claim_type",
                    "evidence_item_ids",
                }
                ids = set(map(str, item.get("evidence_item_ids") or []))
                claim = str(item.get("claim_type") or "")
                if not required.issubset(item) or not ids or not ids.issubset(evidence):
                    errors.append("analyst_classification_contract_invalid")
                elif any(claim not in evidence[current] for current in ids):
                    errors.append("analyst_classification_evidence_claim_invalid")
        for candidate in analyst.get("ranked_candidates") or []:
            required = {
                "caller", "consumer", "control_path", "counterfactual_path",
                "proof_plan", "evidence_item_ids",
            }
            if not isinstance(candidate, dict) or not required.issubset(candidate):
                errors.append("analyst_ranked_candidate_contract_invalid")
    if not isinstance(reviewer, dict) or not required_reviewer.issubset(reviewer):
        errors.append("reviewer_payload_fields_missing")
    else:
        if reviewer.get("schema") != "v7.code-optimization-reviewer-output.v1":
            errors.append("reviewer_payload_schema_invalid")
        if set((reviewer.get("sections") or {}).keys()) != REVIEW_ASPECTS:
            errors.append("reviewer_section_set_invalid")
        if reviewer.get("verdict") not in {"PASS", "REJECT"}:
            errors.append("reviewer_verdict_invalid")
        if reviewer.get("analyst_payload_hash") != analyst_hash:
            errors.append("reviewer_analyst_hash_mismatch")
        if reviewer.get("verdict") == "REJECT" and not reviewer.get("rejected_candidate_ids"):
            errors.append("reviewer_rejection_unscoped")
    required_attestation = {
        "schema": ORCHESTRATOR_ATTESTATION_SCHEMA,
        "artifact_kind": "ORCHESTRATOR_ATTESTATION",
        "manifest_fingerprint": manifest_fingerprint,
        "packet_fingerprint": packet.get("packet_fingerprint") if isinstance(packet, dict) else None,
        "analyst_payload_hash": analyst_hash,
        "reviewer_payload_hash": reviewer_hash,
        "role_order": ["ANALYST", "REVIEWER"],
        "provenance_level": "ORCHESTRATOR_OBSERVED_NOT_CRYPTOGRAPHIC",
        "provenance_verified_by_python": False,
    }
    if not isinstance(attestation, dict):
        errors.append("orchestrator_attestation_missing")
    else:
        for field, expected in required_attestation.items():
            if attestation.get(field) != expected:
                errors.append(f"orchestrator_attestation_mismatch:{field}")
        analyst_context = str(attestation.get("analyst_context_ref") or "")
        reviewer_context = str(attestation.get("reviewer_context_ref") or "")
        if not analyst_context or not reviewer_context or analyst_context == reviewer_context:
            errors.append("orchestrator_context_refs_missing_or_colliding")
    if errors:
        return _stop_safe("STOP_SAFE_INVALID_NATIVE_AGENT_OUTPUT", *errors)
    analyst_context = str(attestation["analyst_context_ref"])
    reviewer_context = str(attestation["reviewer_context_ref"])
    context_manifest = {
