    authorization = _read_json(authorization_path)
    authored = _read_json(Path(args.result).resolve())
    reviews: list[dict[str, Any]] = []
    for review_path in args.reviews:
        value = _read_json(Path(review_path).resolve())
        if isinstance(value, list):
            reviews.extend(item for item in value if isinstance(item, dict))
        elif isinstance(value, dict):
            reviews.append(value)
    test = subprocess.run(
        [sys.executable, "-m", "unittest", "-v"], cwd=fixture,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=60, check=False,
    )
    code, receipt, output = _benchmark_observe(fixture)
    try:
        source = target.read_text(encoding="utf-8")
        tree = ast.parse(source)
    except (OSError, UnicodeDecodeError, SyntaxError):
        source, tree = "", ast.Module(body=[], type_ignores=[])
    functions = {node.name for node in tree.body if isinstance(node, ast.FunctionDef)}
    reviewer_ids = {
        str(item.get("native_agent_id") or "") for item in reviews if isinstance(item, dict)
    } if isinstance(reviews, list) else set()
    review_types = {
        str(item.get("review_type") or "") for item in reviews if isinstance(item, dict)
    } if isinstance(reviews, list) else set()
    reviews_pass = all(
        isinstance(item, dict) and item.get("verdict") == "PASS"
        and item.get("fork_turns") == "none" and item.get("platform_dispatch") == "spawn_agent"
        for item in reviews
    ) if isinstance(reviews, list) else False
    passed = all((
        candidate.get("terminal") == "REDUNDANT_LINK_PROVEN",
        candidate.get("mutation_performed") is False,
        candidate.get("answer_disclosed_to_executor") is False,
        candidate.get("fork_turns") == "none",
        candidate.get("platform_dispatch") == "spawn_agent",
        authorization.get("candidate_sha256") == _sha(candidate_path.read_bytes()),
        authorization.get("candidate_native_agent_id") == candidate.get("native_agent_id"),
        authorization.get("cleanup_count_limit") == 1,
        authorization.get("allowed_fixture_root") == str(fixture),
        authorization.get("allowed_path") == "benchmark_target.py",
        authored.get("candidate_sha256") == _sha(candidate_path.read_bytes()),
        authored.get("cleanup_authorization_sha256") == _sha(authorization_path.read_bytes()),
        authored.get("native_agent_id") == candidate.get("native_agent_id"),
        authored.get("fork_turns") == "none",
        authored.get("platform_dispatch") == "spawn_agent",
        authored.get("terminal") == "REDUNDANT_LINK_PROVEN",
        authored.get("cleanup_count") == 1,
        authored.get("changed_path") == "benchmark_target.py",
        test.returncode == 0, code == 0,
        control.get("observations") == receipt.get("observations"),
        "_stabilize_envelope" not in source,
        functions == {"_validate_owner", "normalize_owner", "build_record"},
        len(reviews) == 1,
        len(reviewer_ids) == 1, "" not in reviewer_ids,
        all(set(item.get("aspects") or []) == REVIEW_ASPECTS for item in reviews),
        authored.get("native_agent_id") not in reviewer_ids, reviews_pass,
        control.get("cps_sha256") == _sha((ROOT / "docs/programs/V7_CURRENT_PROGRAM_STATE.md").read_bytes()),
        control.get("product_worktree_fingerprint") == _product_worktree_fingerprint(),
    ))
    result = {
        "schema": "v7.code-optimization-hidden-benchmark-verified.v1",
        "dynamic_liveness_proven": "_stabilize_envelope" in (control.get("calls") or []),
        "behavior_error_state_equivalence_proven": control.get("observations") == receipt.get("observations"),
        "cleanup_count": 1 if passed else 0, "review_context_count": len(reviewer_ids),
        "fixture_only": True, "cps_runtime_production_authority_effect": "NONE",
        "final_verdict": "PASS" if passed else "STOP_SAFE",
        "terminal": "REDUNDANT_LINK_PROVEN" if passed else "STOP_SAFE_HIDDEN_BENCHMARK_NOT_PROVEN",
        "errors": [] if passed else ["hidden_benchmark_cleanup_equivalence_residue_or_reviews_failed"],
        "test_output": test.stdout[-4000:], "observer_output": output[-4000:],
    }
    _write_json(Path(args.output).resolve(), result, immutable=False)
    return result


def final_accept(args: argparse.Namespace) -> dict[str, Any]:
    """Bind native product consumption and the hidden benchmark to one terminal."""
    bundle = Path(args.bundle_dir).resolve()
    state, manifest_error = _verify_run_manifest(bundle)
    if manifest_error:
        return manifest_error
    packets = _read_json(bundle / "prepared-packets.json")
    results = _read_json(Path(args.results).resolve())
    consumption = _read_json(Path(args.consumption).resolve())
    benchmark = _read_json(Path(args.benchmark_verification).resolve())
    packet_map = {
        str(item.get("packet_fingerprint") or ""): item
        for item in packets if isinstance(item, dict)
    }
    result_map = {
        str(item.get("packet_fingerprint") or ""): item
        for item in results if isinstance(item, dict)
    }
    errors: list[str] = []
    checkpoint = state["checkpoint"]
    if checkpoint.get("current_domain_id") is not None or len(checkpoint.get("completed_domains") or []) != len(packets):
        errors.append("native_product_checkpoints_incomplete")
    completed_by_domain = {
        str(item.get("domain_id") or ""): item
        for item in (checkpoint.get("completed_domains") or []) if isinstance(item, dict)
    }
    if not packet_map or len(packet_map) != len(packets) or set(packet_map) != set(result_map):
        errors.append("native_product_packet_result_set_invalid")
    author_ids: set[str] = set()
    reviewer_ids: set[str] = set()
    for fingerprint, packet in packet_map.items():
        result = result_map.get(fingerprint) or {}
        checkpoint_record = completed_by_domain.get(str(packet.get("domain_id") or "")) or {}
        if checkpoint_record.get("result_artifact_fingerprint") != _json_fingerprint(result):
            errors.append(f"{fingerprint}:native_product_checkpoint_result_hash_mismatch")
        errors.extend(
            f"{fingerprint}:{error}"
            for error in sync_lib.validate_code_optimization_executor_result(packet, result)
        )
        roles = (result.get("native_context_manifest") or {}).get("roles") or []
        author_ids.update(
            str(item.get("native_agent_id") or "") for item in roles if isinstance(item, dict)
        )
        reviews = result.get("reviews") or []
        if any(
            not isinstance(item, dict) or item.get("review_verdict") != "PASS"
            for item in reviews
        ):
            errors.append(f"{fingerprint}:native_product_review_not_pass")
        reviewer_ids.update(
            str((item.get("native_context_proof") or {}).get("native_agent_id") or "")
            for item in reviews if isinstance(item, dict)
        )
    if "" in author_ids or len(author_ids) != 1:
        errors.append("native_product_author_context_set_invalid")
    if "" in reviewer_ids or len(reviewer_ids) != 1 or author_ids & reviewer_ids:
        errors.append("native_product_review_context_set_invalid")
    if not all((
        consumption.get("final_verdict") == "PASS",
        consumption.get("coverage_terminal") == "FULL_ACTIVE_COVERAGE",
        consumption.get("final_completion") == "COMPLETE_WITH_LEGAL_TERMINAL",
        set(consumption.get("domains_completed") or [])
        == {str(item.get("domain_id") or "") for item in packets},
        consumption.get("blocked_domains") == [],
        consumption.get("errors") == [],
        consumption.get("cleanup_count") in {0, 1},
        consumption.get("no_cps_effect") is True,
        consumption.get("runtime_impact") == "NONE",
        consumption.get("production_impact") == "NONE",
        consumption.get("authority_impact") == "NONE",
    )):
        errors.append("native_product_consumption_not_accepted")
    if not all((
        benchmark.get("schema") == "v7.code-optimization-hidden-benchmark-verified.v1",
        benchmark.get("final_verdict") == "PASS",
        benchmark.get("terminal") == "REDUNDANT_LINK_PROVEN",
        benchmark.get("dynamic_liveness_proven") is True,
        benchmark.get("behavior_error_state_equivalence_proven") is True,
        benchmark.get("cleanup_count") == 1,
        benchmark.get("review_context_count") == 1,
        benchmark.get("fixture_only") is True,
        benchmark.get("cps_runtime_production_authority_effect") == "NONE",
        benchmark.get("errors") == [],
    )):
        errors.append("hidden_benchmark_not_accepted")
    result = {
        "schema": "v7.code-optimization-agent-runtime-acceptance.v1",
        "native_product_domain_count": len(packet_map),
        "native_author_context_count": len(author_ids),
        "native_reviewer_context_count": len(reviewer_ids),
        "product_cleanup_count": consumption.get("cleanup_count"),
        "benchmark_cleanup_count": benchmark.get("cleanup_count"),
        "coverage_terminal": consumption.get("coverage_terminal"),
        "cps_runtime_production_authority_effect": "NONE" if not errors else "UNKNOWN",
        "errors": sorted(set(errors)),
        "final_verdict": "PASS" if not errors else "STOP_SAFE",
        "terminal": (
            "V7_CODE_OPTIMIZATION_AGENT_RUNTIME_FULLY_ACCEPTED"
            if not errors else "STOP_SAFE_CODE_OPTIMIZATION_AGENT_RUNTIME_ACCEPTANCE_INVALID"
        ),
    }
    _write_json(Path(args.output).resolve(), result, immutable=False)
    return result


def parser() -> argparse.ArgumentParser:
    value = argparse.ArgumentParser()
    sub = value.add_subparsers(dest="command", required=True)
    p = sub.add_parser("prepare")
    p.add_argument("--mode", choices=["FULL_BASELINE", "CONTINUE", "DOMAIN", "CHANGED"], required=True)
    p.add_argument("--domain-id", default="")
    p.add_argument("--changed", nargs="*", default=[])
    p.add_argument("--output-dir", required=True)
    p.set_defaults(handler=prepare)
    c = sub.add_parser("consume")
    c.add_argument("--bundle-dir", required=True); c.add_argument("--results", required=True); c.add_argument("--output", required=True)
    c.set_defaults(handler=consume)
    a = sub.add_parser("assemble-analyst")
    a.add_argument("--bundle-dir", required=True); a.add_argument("--analyst", required=True)
    a.add_argument("--analyst-agent-id", required=True); a.add_argument("--output", required=True)
    a.set_defaults(handler=assemble_analyst)
    ar = sub.add_parser("attach-review")
    ar.add_argument("--bundle-dir", required=True); ar.add_argument("--proposed", required=True); ar.add_argument("--review", required=True); ar.add_argument("--output", required=True)
    ar.set_defaults(handler=attach_review)
    b = sub.add_parser("benchmark-prepare")
    b.add_argument("--output-dir", required=True); b.set_defaults(handler=benchmark_prepare)
    ba = sub.add_parser("benchmark-authorize")
    ba.add_argument("--bundle-dir", required=True); ba.add_argument("--candidate", required=True)
    ba.add_argument("--output", required=True); ba.set_defaults(handler=benchmark_authorize)
    v = sub.add_parser("benchmark-verify")
    v.add_argument("--bundle-dir", required=True); v.add_argument("--candidate", required=True); v.add_argument("--authorization", required=True); v.add_argument("--result", required=True); v.add_argument("--reviews", nargs="+", required=True); v.add_argument("--output", required=True)
    v.set_defaults(handler=benchmark_verify)
    f = sub.add_parser("accept")
    f.add_argument("--bundle-dir", required=True); f.add_argument("--results", required=True)
    f.add_argument("--consumption", required=True); f.add_argument("--benchmark-verification", required=True)
    f.add_argument("--output", required=True); f.set_defaults(handler=final_accept)
    cp = sub.add_parser("checkpoint")
    cp.add_argument("--bundle-dir", required=True); cp.add_argument("--results", required=True)
    cp.add_argument("--output", required=True); cp.set_defaults(handler=checkpoint)
    ingest = sub.add_parser("ingest-domain")
    ingest.add_argument("--bundle-dir", required=True); ingest.add_argument("--analyst", required=True)
    ingest.add_argument("--reviewer", required=True); ingest.add_argument("--attestation", required=True)
    ingest.add_argument("--output", required=True); ingest.set_defaults(handler=ingest_domain)
    return value


def main() -> int:
    args = parser().parse_args()
    result = args.handler(args)
    print(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True))
    return 0 if result.get("final_verdict") in {"PASS", "CONTINUE_SAME_MISSION"} else 2


if __name__ == "__main__":
    raise SystemExit(main())
