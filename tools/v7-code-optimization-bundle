def benchmark_authorize(args: argparse.Namespace) -> dict[str, Any]:
    """Validate a read-only native candidate and bind one fixture-only cleanup."""
    bundle = Path(args.bundle_dir).resolve()
    fixture = bundle / "fixture"
    candidate_path = Path(args.candidate).resolve()
