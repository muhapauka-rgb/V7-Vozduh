def checkpoint(args: argparse.Namespace) -> dict[str, Any]:
    """Consume one reviewed domain, or preserve its single targeted retry."""
    bundle = Path(args.bundle_dir).resolve()
    state, error = _verify_run_manifest(bundle)
    if error:
        return error
    manifest, progress = state["manifest"], state["checkpoint"]
    domain_id = str(progress.get("current_domain_id") or "")
    packet = (manifest.get("packets_by_domain") or {}).get(domain_id)
    try:
        results = _read_json(Path(args.results).resolve())
    except (OSError, json.JSONDecodeError):
        return _stop_safe("STOP_SAFE_CODE_OPTIMIZATION_CURRENT_RESULT_MISSING", "current_result_missing")
    if not isinstance(packet, dict) or not isinstance(results, list) or len(results) != 1:
        return _stop_safe("STOP_SAFE_CODE_OPTIMIZATION_CHECKPOINT_INPUT_INVALID", "exactly_one_current_packet_and_result_required")
    supplied = results[0] if isinstance(results[0], dict) else {}
    if supplied.get("packet_fingerprint") != packet.get("packet_fingerprint"):
        return _stop_safe("STOP_SAFE_CODE_OPTIMIZATION_CHECKPOINT_PACKET_MISMATCH", "current_packet_identity_mismatch")
    errors = _structural_native_receipt_errors(manifest, packet, supplied)
    errors.extend(sync_lib.validate_code_optimization_executor_result(packet, supplied))
    reviews = supplied.get("reviews") if isinstance(supplied.get("reviews"), list) else []
    rejected = sorted({
        candidate for review in reviews if isinstance(review, dict)
        for candidate in (review.get("rejected_candidate_ids") or []) if str(candidate)
    })
    review_failures = [review for review in reviews if isinstance(review, dict) and review.get("review_verdict") != "PASS"]
    if errors:
        return _stop_safe("STOP_SAFE_CODE_OPTIMIZATION_CURRENT_RESULT_INVALID", *errors)
    if review_failures:
        if not rejected:
            return _stop_safe("STOP_SAFE_CODE_OPTIMIZATION_REVIEW_REJECTION_UNSCOPED", "rejected_candidate_ids_required")
        if int(progress.get("review_attempt") or 0) >= 1:
            return _stop_safe("STOP_SAFE_SECOND_REVIEW_REJECTION", "targeted_reentry_already_used")
        progress.update({
            "candidate_status": "TARGETED_REENTRY_REQUIRED", "review_attempt": 1,
            "rejected_candidate_ids": rejected,
            "next_action": "ANALYST_RETRY_ONLY_REJECTED_CANDIDATE_IDS",
        })
        _write_checkpoint(bundle, progress)
        result = {"final_verdict": "CONTINUE_SAME_MISSION", "terminal": "TARGETED_REENTRY_REQUIRED", "current_domain_id": domain_id, "rejected_candidate_ids": rejected, "review_attempt": 1}
        _write_json(Path(args.output).resolve(), result, immutable=False)
        return result
    completed = list(progress.get("completed_domains") or [])
    author_roles = ((supplied.get("native_context_manifest") or {}).get("roles") or [])
    analyst_context = next((
        str(item.get("native_agent_id") or "") for item in author_roles
        if isinstance(item, dict) and item.get("role") == "ANALYST"
    ), "")
    reviewer_contexts = sorted({
        str((review.get("native_context_proof") or {}).get("native_agent_id") or "")
        for review in reviews if isinstance(review, dict)
    })
    completed.append({
        "domain_id": domain_id,
        "packet_fingerprint": packet["packet_fingerprint"],
        "result_fingerprint": supplied.get("result_fingerprint"),
        "result_artifact_fingerprint": _json_fingerprint(supplied),
        "analyst_context_ref": analyst_context,
        "reviewer_context_ref": reviewer_contexts[0] if len(reviewer_contexts) == 1 else "",
    })
    next_index = int(progress.get("current_domain_index") or 0) + 1
    ordered = list(manifest.get("ordered_domain_ids") or [])
    done = next_index >= len(ordered)
    progress.update({
        "completed_domains": completed, "current_domain_index": next_index,
        "current_domain_id": None if done else ordered[next_index],
        "candidate_status": "COMPLETED", "review_attempt": 0,
        "rejected_candidate_ids": [],
        "next_action": "ALL_DOMAINS_CHECKPOINTED" if done else "DISPATCH_NATIVE_ANALYST_FOR_CURRENT_DOMAIN",
    })
    if not done:
        next_packet = manifest["packets_by_domain"][ordered[next_index]]
        _write_json(bundle / "current-packet.json", next_packet, immutable=False)
        _write_json(bundle / "agent-packets.json", {"schema": "v7.code-optimization-native-agent-input.v1", "packets": [_agent_view(next_packet)]}, immutable=False)
    _write_checkpoint(bundle, progress)
    result = {"final_verdict": "PASS" if done else "CONTINUE_SAME_MISSION", "terminal": "ALL_DOMAINS_CHECKPOINTED" if done else "NEXT_DOMAIN_PREPARED", "completed_domain_count": len(completed), "total_domain_count": len(ordered), "current_domain_id": progress["current_domain_id"]}
    _write_json(Path(args.output).resolve(), result, immutable=False)
    return result


def _packet_map(value: Any, field: str = "packet_results") -> dict[str, dict[str, Any]]:
    if not isinstance(value, dict) or not isinstance(value.get(field), list):
        raise ValueError(f"{field}_missing")
    mapped: dict[str, dict[str, Any]] = {}
    for item in value[field]:
        if not isinstance(item, dict):
            raise ValueError(f"{field}_item_invalid")
        identity = str(item.get("packet_fingerprint") or "")
        if not identity or identity in mapped:
            raise ValueError(f"{field}_identity_missing_or_duplicate")
        mapped[identity] = item
    return mapped


