def read_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return default
    except json.JSONDecodeError as exc:
        return {"_error": f"json_error:{exc}"}


def lineage_entries(lineage_dir: Path) -> dict[str, dict[str, Any]]:
    entries: dict[str, dict[str, Any]] = {}
    for path in sorted(lineage_dir.glob("*.json")):
        data = read_json(path, {})
        for item in data.get("entries", []) if isinstance(data, dict) else []:
            basename = str(item.get("basename") or "")
            if basename:
                entry = dict(item)
                entry["_lineage_file"] = str(path)
                entries[basename] = entry
    return entries


def runtime_tools(runtime_enumeration: Path) -> dict[str, dict[str, Any]]:
    data = read_json(runtime_enumeration, {})
    tools = data.get("tools", []) if isinstance(data, dict) else []
    result: dict[str, dict[str, Any]] = {}
    for item in tools:
        basename = str(item.get("basename") or "")
        if basename:
            result[basename] = item
    return result


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except FileNotFoundError:
        return ""


def e8_rehearsal_status(docs_dir: Path) -> dict[str, Any]:
    evidence_dir = docs_dir / "e8-evidence"
    summary = read_text(evidence_dir / "summary.txt")
    post_restore = read_text(evidence_dir / "post-restore.txt")
    abort = read_text(evidence_dir / "abort.txt")
    sample_a = evidence_dir / "quiet-window-sample-a.txt"
    sample_b = evidence_dir / "quiet-window-sample-b.txt"
    sample_c = evidence_dir / "quiet-window-sample-c.txt"

    executed = "rehearsal_executed=true" in summary
    aborted = "abort=1" in summary or bool(abort.strip())
    restored = (
        "autoswitch_timer_restore_attempted=true" in summary
        and "systemctl is-active v7-users-autoswitch.timer" in post_restore
        and "\nactive" in post_restore
    )
    samples_present = sample_a.is_file() and sample_b.is_file()
    quiet_verified = executed and not aborted and samples_present

    if not executed:
        operational_status = "rehearsal_planned"
        reconcile_under_quiet = "NOT_RUN"
    elif aborted and restored:
        operational_status = "rehearsal_aborted_restored"
        reconcile_under_quiet = "NOT_SAMPLED_ABORTED"
    elif aborted:
        operational_status = "rehearsal_aborted_restore_uncertain"
        reconcile_under_quiet = "NOT_SAMPLED_ABORTED"
    elif quiet_verified:
        operational_status = "rehearsal_executed_pending_analysis"
        combined = "\n".join(read_text(path) for path in [sample_a, sample_b, sample_c] if path.is_file())
        if "V7_RECONCILE_RESULT=FAIL" in combined:
            reconcile_under_quiet = "FAIL"
        elif "V7_RECONCILE_RESULT=OK" in combined:
            reconcile_under_quiet = "OK"
        else:
            reconcile_under_quiet = "UNKNOWN"
    else:
        operational_status = "rehearsal_executed_incomplete"
        reconcile_under_quiet = "UNKNOWN"

    return {
        "evidence_dir": str(evidence_dir),
        "evidence_present": evidence_dir.is_dir(),
        "rehearsal_executed": executed,
        "rehearsal_aborted": aborted,
        "autoswitch_restored": restored,
        "quiet_window_verified": quiet_verified,
        "quiet_samples_present": {
            "a": sample_a.is_file(),
            "b": sample_b.is_file(),
            "c": sample_c.is_file(),
        },
        "reconcile_under_quiet": reconcile_under_quiet,
        "current_operational_status": operational_status,
        "abort_reason": "active_control_plane_process_after_hold" if "active_control_plane_process_after_hold" in abort else "",
    }


def build_report(args: argparse.Namespace) -> dict[str, Any]:
    docs_dir = Path(args.docs_dir)
    lineage_dir = Path(args.lineage_dir)
    runtime = runtime_tools(Path(args.runtime_enumeration))
    lineage = lineage_entries(lineage_dir)

    high_risk_rows = []
    for name, reason in HIGH_RISK.items():
        rt = runtime.get(name, {})
        ln = lineage.get(name, {})
        high_risk_rows.append(
            {
                "tool": name,
                "risk": reason,
                "runtime_present": bool(rt),
                "lineage_resolved": bool(ln),
                "governance_class": rt.get("governance_class"),
                "runtime_criticality": rt.get("runtime_criticality"),
                "release_relevance": rt.get("release_relevance"),
                "mutation_level": ln.get("mutation_level", "unclassified"),
                "lineage_file": ln.get("_lineage_file", ""),
                "execution_allowed_now": False,
            }
        )

    missing_docs = [name for name in CONTROL_DOCS if not (docs_dir / name).is_file()]
    missing_canary_docs = [name for name in CANARY_DOCS if not (docs_dir / name).is_file()]
    missing_canary_blocker_docs = [name for name in CANARY_BLOCKER_DOCS if not (docs_dir / name).is_file()]
    missing_routing_integrity_docs = [name for name in ROUTING_INTEGRITY_DOCS if not (docs_dir / name).is_file()]
    missing_quiet_window_docs = [name for name in QUIET_WINDOW_DOCS if not (docs_dir / name).is_file()]
    missing_rehearsal_docs = [name for name in REHEARSAL_DOCS if not (docs_dir / name).is_file()]
    missing_rehearsal_execution_docs = [name for name in REHEARSAL_EXECUTION_DOCS if not (docs_dir / name).is_file()]
    rehearsal_e8 = e8_rehearsal_status(docs_dir)
    preview_artifacts = {name: path.is_file() if name != "fixtures" else path.is_dir() for name, path in PREVIEW_ARTIFACTS.items()}
    missing_preview_artifacts = [name for name, exists in preview_artifacts.items() if not exists]
    canary_preview_artifacts = {name: path.is_file() for name, path in CANARY_PREVIEW_ARTIFACTS.items()}
    missing_canary_preview_artifacts = [name for name, exists in canary_preview_artifacts.items() if not exists]
    unresolved = [row for row in high_risk_rows if row["runtime_present"] and not row["lineage_resolved"]]
    mutation_capable = [row for row in high_risk_rows if row["runtime_present"]]

    return {
        "schema_version": 1,
        "tool": "v7-control-plane-governance-check",
        "read_only": True,
        "runtime_commands_executed": False,
        "runtime_enumeration": str(args.runtime_enumeration),
        "control_plane_docs_missing": missing_docs,
        "canary_readiness": {
            "docs_missing": missing_canary_docs,
            "blocker_resolution_docs_missing": missing_canary_blocker_docs,
            "routing_integrity_docs_missing": missing_routing_integrity_docs,
            "quiet_window_docs_missing": missing_quiet_window_docs,
            "rehearsal_docs_missing": missing_rehearsal_docs,
            "rehearsal_execution_docs_missing": missing_rehearsal_execution_docs,
            "preview_artifacts": canary_preview_artifacts,
            "missing_preview_artifacts": missing_canary_preview_artifacts,
            "go_no_go_defined": (docs_dir / "CANARY_GO_NO_GO.md").is_file(),
            "autoswitch_hold_governance_exists": (docs_dir / "AUTOSWITCH_HOLD_GOVERNANCE.md").is_file(),
