def main() -> int:
    parser = argparse.ArgumentParser(description="Read-only V7 control-plane governance checker")
    parser.add_argument("--runtime-enumeration", default="runtime-enumeration.json")
    parser.add_argument("--docs-dir", default="docs/track7/control-plane")
    parser.add_argument("--lineage-dir", default="docs/track7/lineage")
    parser.add_argument("--pretty", action="store_true")
    args = parser.parse_args()

    report = build_report(args)
    if args.pretty:
        print_pretty(report)
    else:
        print(json.dumps(report, ensure_ascii=False, indent=2))
    preview_missing = report["route_movement_preview"]["missing_artifacts"]
    canary = report["canary_readiness"]
    canary_missing = (
        canary["docs_missing"]
        or canary["blocker_resolution_docs_missing"]
        or canary["routing_integrity_docs_missing"]
        or canary["quiet_window_docs_missing"]
        or canary["rehearsal_docs_missing"]
        or canary["rehearsal_execution_docs_missing"]
        or canary["full_authority_docs_missing"]
        or canary["missing_preview_artifacts"]
        or canary["missing_split_draft_units"]
    )
    return 0 if not report["control_plane_docs_missing"] and not preview_missing and not canary_missing else 1


if __name__ == "__main__":
    raise SystemExit(main())
