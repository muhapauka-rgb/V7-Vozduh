#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="/opt/v7/egress/state"
OUT=""
SHADOW_TRIGGER_COMMAND=""
SHADOW_TRIGGER_EGRESS=""
SHADOW_TRIGGER_SERVICES=""
SHADOW_TRIGGER_PROFILE_USER=""
SHADOW_TRIGGER_EVENT_DIR=""
CANONICAL_EVENT_DIR="${V7_EVENT_DIR:-}"
SHADOW_TRIGGER_COOLDOWN_SEC="60"
PROFILE_SERVICE_SUSPICION_COMMAND=""
PROFILE_SERVICE_FAILURE_SAMPLES="2"
PROFILE_SERVICE_COOLDOWN_SEC="60"
PROFILE_CONTRACTS_FILE=""
ACTIVE_SOURCE_FILE=""
FAST_PRODUCER_ONLY="0"
LIGHTWEIGHT_BATCH_PRODUCER="0"
HARD_SIGNAL_ONLY="0"
DEFINITIVE_MATRIX_COMMAND=""
CONSUMER_WAKE_COMMAND=""
HARD_SIGNAL_OBSERVATION_COUNT=0
HARD_SIGNAL_T0_COUNT=0
HARD_SIGNAL_WAKE_COUNT=0
HARD_SIGNAL_CONSUMER_T0_MONOTONIC_NS=""
OUTPUT_EXPLICIT="0"
PROFILE_SERVICE_SHADOW_MATRIX_SAMPLES=""
PROFILE_SERVICE_SHADOW_MATRIX_WINDOW_SEC=""
PROFILE_SERVICE_OBSERVATION_COUNT=0
PROFILE_SERVICE_RECEIVER_INVOCATION_COUNT=0
PROFILE_SERVICE_CONSUMER_WAKE_COUNT=0
PROFILE_SERVICE_CONTRACT_COUNT=0
PROFILE_SERVICE_ACTIVE_SOURCE_COUNT=0
FAST_PRODUCER_CONCURRENCY="1"
FAST_PRODUCER_MAX_INFLIGHT=0
FAST_PRODUCER_STARTED_NS="0"
FAST_PRODUCER_MONOTONIC_STARTED_NS="0"
FAST_PRODUCER_CONTRACT_BUILD_STARTED_NS="0"
FAST_PRODUCER_CONTRACT_BUILD_COMPLETED_NS="0"
FAST_PRODUCER_COMMIT_OUTPUT_WALL_MS="0"
FAST_PRODUCER_SCRIPT_STARTED_NS="0"
FAST_PRODUCER_COMPLETION_MS=()
PROFILE_SERVICE_PROBE_TIMEOUT_ARGS=(--timeout 5)
FAST_MATRIX_FRESH_FAILURES_FILE=""
# The health owner accepts a profile-required Matrix observation for ten
# seconds. Reusing a two-minute-old failure in this producer left the normal
# caller with a correctly stale T0 and made a new placement on an already bad
# source invisible. Keep the reuse budget identical to the consumer's live
# evidence law; older results are only a probe hint and must be reconfirmed by
# the existing Matrix writer.
PROFILE_MATRIX_REUSE_MAX_AGE_SEC="10"

monotonic_ns() {
  python3 -c 'import time; print(time.monotonic_ns())'
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --state-dir)
      STATE_DIR="$2"
      shift 2
      ;;
    --output)
      OUT="$2"
      OUTPUT_EXPLICIT="1"
      shift 2
      ;;
    --fast-producer-only)
      FAST_PRODUCER_ONLY="1"
      shift
      ;;
    --lightweight-batch-producer)
      LIGHTWEIGHT_BATCH_PRODUCER="1"
      shift
      ;;
    --hard-signal-only)
      HARD_SIGNAL_ONLY="1"
      shift
      ;;
    --definitive-matrix-command)
      DEFINITIVE_MATRIX_COMMAND="$2"
      shift 2
      ;;
    --consumer-wake-command)
      CONSUMER_WAKE_COMMAND="$2"
      shift 2
      ;;
    --fast-producer-concurrency)
      FAST_PRODUCER_CONCURRENCY="$2"
      shift 2
      ;;
    --shadow-trigger-command)
      SHADOW_TRIGGER_COMMAND="$2"
      shift 2
      ;;
    --shadow-trigger-egress)
      SHADOW_TRIGGER_EGRESS="$2"
      shift 2
      ;;
    --shadow-trigger-services)
      SHADOW_TRIGGER_SERVICES="$2"
      shift 2
      ;;
    --shadow-trigger-profile-user)
      SHADOW_TRIGGER_PROFILE_USER="$2"
      shift 2
      ;;
    --shadow-trigger-event-dir)
      SHADOW_TRIGGER_EVENT_DIR="$2"
      shift 2
      ;;
    --shadow-trigger-cooldown-sec)
      SHADOW_TRIGGER_COOLDOWN_SEC="$2"
      shift 2
      ;;
    --profile-service-suspicion-command)
      PROFILE_SERVICE_SUSPICION_COMMAND="$2"
      shift 2
      ;;
    --profile-service-failure-samples)
      PROFILE_SERVICE_FAILURE_SAMPLES="$2"
      shift 2
      ;;
    --profile-service-cooldown-sec)
      PROFILE_SERVICE_COOLDOWN_SEC="$2"
      shift 2
      ;;
    --profile-service-shadow-matrix-samples)
      PROFILE_SERVICE_SHADOW_MATRIX_SAMPLES="$2"
      shift 2
      ;;
    --profile-service-shadow-matrix-window-sec)
      PROFILE_SERVICE_SHADOW_MATRIX_WINDOW_SEC="$2"
      shift 2
      ;;
    *)
      echo "unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

if [ -n "$SHADOW_TRIGGER_COMMAND" ] && { [ -n "$SHADOW_TRIGGER_EGRESS" ] || [ -n "$SHADOW_TRIGGER_SERVICES" ] || [ -n "$SHADOW_TRIGGER_PROFILE_USER" ]; }; then
  case "$SHADOW_TRIGGER_COOLDOWN_SEC" in
    ''|*[!0-9]*)
      echo "invalid --shadow-trigger-cooldown-sec" >&2
      exit 2
      ;;
  esac
  if [ -z "$SHADOW_TRIGGER_EGRESS" ] || { [ -z "$SHADOW_TRIGGER_SERVICES" ] && [ -z "$SHADOW_TRIGGER_PROFILE_USER" ]; } || { [ -n "$SHADOW_TRIGGER_SERVICES" ] && [ -n "$SHADOW_TRIGGER_PROFILE_USER" ]; }; then
    echo "shadow trigger requires exact egress and exactly one service source" >&2
    exit 2
  fi
fi

if [ -n "$PROFILE_SERVICE_SUSPICION_COMMAND" ]; then
  case "$PROFILE_SERVICE_FAILURE_SAMPLES" in
    ''|*[!0-9]*)
      echo "invalid --profile-service-failure-samples" >&2
      exit 2
      ;;
  esac
  case "$PROFILE_SERVICE_COOLDOWN_SEC" in
    ''|*[!0-9]*)
      echo "invalid --profile-service-cooldown-sec" >&2
      exit 2
      ;;
  esac
  if [ -z "$SHADOW_TRIGGER_COMMAND" ]; then
    echo "profile service suspicion requires existing Matrix receiver" >&2
    exit 2
  fi
fi

if [ "$FAST_PRODUCER_ONLY" = "1" ] && { [ -z "$PROFILE_SERVICE_SUSPICION_COMMAND" ] || [ "$OUTPUT_EXPLICIT" != "1" ]; }; then
  echo "fast producer only requires profile suspicion command and explicit output" >&2
  exit 2
fi
if [ "$FAST_PRODUCER_ONLY" = "1" ]; then
  # A FAST producer may use an exact one-second service confirmation only.
  # Timeout/unknown remains fail-closed and is never a move authorization;
  # the existing full/deep Matrix owners keep their normal five-plus second
  # diagnostic semantics outside the customer recovery deadline.
  PROFILE_SERVICE_PROBE_TIMEOUT_ARGS=(--role-fast-timeout --timeout 1)
fi
if [ "$LIGHTWEIGHT_BATCH_PRODUCER" = "1" ] && [ "$FAST_PRODUCER_ONLY" != "1" ]; then
  echo "lightweight batch producer requires --fast-producer-only" >&2
  exit 2
fi

if [ "$HARD_SIGNAL_ONLY" = "1" ]; then
  if [ "$FAST_PRODUCER_ONLY" = "1" ] || [ -n "$PROFILE_SERVICE_SUSPICION_COMMAND" ] || [ -n "$SHADOW_TRIGGER_COMMAND" ]; then
    echo "hard signal only is exclusive from service-probe modes" >&2
    exit 2
  fi
  if [ -z "$DEFINITIVE_MATRIX_COMMAND" ] || [ "$OUTPUT_EXPLICIT" != "1" ]; then
    echo "hard signal only requires canonical Matrix command and explicit output" >&2
    exit 2
  fi
fi

case "$FAST_PRODUCER_CONCURRENCY" in
  ''|*[!0-9]*) echo "invalid --fast-producer-concurrency" >&2; exit 2 ;;
esac
if [ "$FAST_PRODUCER_CONCURRENCY" -lt 1 ] || [ "$FAST_PRODUCER_CONCURRENCY" -gt 128 ]; then
  echo "--fast-producer-concurrency must be between 1 and 128" >&2
  exit 2
fi
if [ "$FAST_PRODUCER_CONCURRENCY" -gt 1 ] && [ "$FAST_PRODUCER_ONLY" != "1" ]; then
  echo "parallel FAST producer execution requires --fast-producer-only" >&2
  exit 2
fi

for profile_shadow_value in "$PROFILE_SERVICE_SHADOW_MATRIX_SAMPLES" "$PROFILE_SERVICE_SHADOW_MATRIX_WINDOW_SEC"; do
  case "$profile_shadow_value" in
    '') ;;
    *[!0-9]*) echo "invalid controlled Matrix persistence override" >&2; exit 2 ;;
  esac
done
if { [ -n "$PROFILE_SERVICE_SHADOW_MATRIX_SAMPLES" ] || [ -n "$PROFILE_SERVICE_SHADOW_MATRIX_WINDOW_SEC" ]; } && [ "$FAST_PRODUCER_ONLY" != "1" ]; then
  echo "controlled Matrix persistence override requires --fast-producer-only" >&2
  exit 2
fi

REG="${STATE_DIR}/egress.registry"
SUM="${STATE_DIR}/summary.state"
OUT="${OUT:-${STATE_DIR}/egress-diagnose.state}"
# Production Matrix events are owned at /opt/v7/events, not below the egress
# state subtree. Preserve the state-relative fallback only for an explicitly
# isolated/custom state directory used by tests or a local Polygon.
if [ -z "$CANONICAL_EVENT_DIR" ]; then
  if [ "$STATE_DIR" = "/opt/v7/egress/state" ]; then
    CANONICAL_EVENT_DIR="/opt/v7/events"
  else
    CANONICAL_EVENT_DIR="${STATE_DIR}/../events"
  fi
fi
if [ -n "$SHADOW_TRIGGER_EVENT_DIR" ]; then
  CANONICAL_EVENT_DIR="$SHADOW_TRIGGER_EVENT_DIR"
fi
TMP="${OUT}.tmp.$$"
if [ "$OUT" = "-" ]; then
  TMP="$(mktemp "${TMPDIR:-/tmp}/v7-egress-diagnose-output.XXXXXX")"
fi

commit_output() {
  commit_started_ns="$(monotonic_ns)"
  if [ "$OUT" = "-" ]; then
    cat "$TMP"
    rm -f "$TMP"
  else
    mv "$TMP" "$OUT"
  fi
  commit_completed_ns="$(monotonic_ns)"
  if [ "$FAST_PRODUCER_MONOTONIC_STARTED_NS" -gt 0 ] 2>/dev/null; then
    FAST_PRODUCER_COMMIT_OUTPUT_WALL_MS="$(( (commit_completed_ns - commit_started_ns) / 1000000 ))"
  fi
}

emit_fast_producer_timing_receipt() {
  # This one-line stdout receipt is consumed only by the parent v7-health
  # process while the child is still alive.  It is diagnostics, not Matrix
  # state: the canonical state file was atomically committed before this is
  # emitted, and no recovery owner reads this output.
  [ "$FAST_PRODUCER_MONOTONIC_STARTED_NS" -gt 0 ] 2>/dev/null || return 0
  receipt_finished_ns="$(monotonic_ns)"
  printf 'V7_EGRESS_DIAGNOSE_TIMING contract_build_ms=%s producer_to_receipt_ms=%s commit_output_ms=%s script_total_ms=%s\n' \
    "$(( (FAST_PRODUCER_CONTRACT_BUILD_COMPLETED_NS - FAST_PRODUCER_CONTRACT_BUILD_STARTED_NS) / 1000000 ))" \
    "$(( (receipt_finished_ns - FAST_PRODUCER_MONOTONIC_STARTED_NS) / 1000000 ))" \
    "$FAST_PRODUCER_COMMIT_OUTPUT_WALL_MS" \
    "$(( (receipt_finished_ns - FAST_PRODUCER_SCRIPT_STARTED_NS) / 1000000 ))"
}

previous_value() {
  key="$1"
  grep "^${key}=" "$OUT" 2>/dev/null | tail -n1 | cut -d= -f2- || true
}

shadow_trigger_for_reason() {
  id="$1"
  reason="$2"
  severity="$3"
  [ -n "$SHADOW_TRIGGER_COMMAND" ] || return 0
  [ "$id" = "$SHADOW_TRIGGER_EGRESS" ] || return 0
  [ "$severity" = "FAIL" ] || return 0

  trigger_class=""
  case "$reason" in
    curl_failed_and_handshake_stale|curl_failed_and_handshake_unsupported)
      trigger_class="TUNNEL_UP_INTERNET_DEAD"
      ;;
    *)
      return 0
      ;;
  esac

  now_epoch="$(date +%s)"
  previous_epoch="$(previous_value "${id}_shadow_trigger_epoch")"
  if [ -n "$previous_epoch" ] && [ "$previous_epoch" -ge $((now_epoch - SHADOW_TRIGGER_COOLDOWN_SEC)) ] 2>/dev/null; then
    printf '%s_shadow_trigger_status=SUPPRESSED_COOLDOWN\n' "$id" >> "$TMP"
    printf '%s_shadow_trigger_class=%s\n' "$id" "$trigger_class" >> "$TMP"
    return 0
  fi

  trigger_id="v7st_$(printf '%s' "${id}|${trigger_class}|${reason}" | shasum -a 256 | awk '{print substr($1,1,24)}')"
  trigger_event_dir="$CANONICAL_EVENT_DIR"
  trigger_service_args=()
  if [ -n "$SHADOW_TRIGGER_PROFILE_USER" ]; then
    trigger_service_args=(--shadow-trigger-profile-user "$SHADOW_TRIGGER_PROFILE_USER")
  else
    trigger_service_args=(--services "$SHADOW_TRIGGER_SERVICES")
  fi
  if "$SHADOW_TRIGGER_COMMAND" \
      --state-dir "$STATE_DIR" \
      --event-dir "$trigger_event_dir" \
      --egresses "$id" \
      "${trigger_service_args[@]}" \
      --shadow-trigger-source "$id" \
      --shadow-trigger-class "$trigger_class" \
      --shadow-trigger-id "$trigger_id" \
      --matrix-observation-only >/dev/null 2>&1; then
    trigger_status="PASS"
    trigger_rc="0"
  else
    trigger_rc="$?"
    trigger_status="FAILED"
  fi
  printf '%s_shadow_trigger_status=%s\n' "$id" "$trigger_status" >> "$TMP"
  printf '%s_shadow_trigger_class=%s\n' "$id" "$trigger_class" >> "$TMP"
  printf '%s_shadow_trigger_id=%s\n' "$id" "$trigger_id" >> "$TMP"
  printf '%s_shadow_trigger_epoch=%s\n' "$id" "$now_epoch" >> "$TMP"
  printf '%s_shadow_trigger_rc=%s\n' "$id" "$trigger_rc" >> "$TMP"
}

build_active_hard_rows() {
  python3 - "$STATE_DIR/users.registry" "$REG" "$STATE_DIR/service-matrix.json" <<'PY'
import json
import sys
from pathlib import Path

def fields(line):
    return dict(part.split("=", 1) for part in line.split() if "=" in part)

try:
    users = Path(sys.argv[1]).read_text(encoding="utf-8", errors="replace").splitlines()
except OSError:
    users = []
active = {
    str(row.get("current") or "")
    for row in (fields(line) for line in users if line.strip() and not line.lstrip().startswith("#"))
    if str(row.get("enabled", "1")).lower() not in {"0", "false", "no", "off"}
    and str(row.get("current") or "")
}
try:
    registry = Path(sys.argv[2]).read_text(encoding="utf-8", errors="replace").splitlines()
except OSError:
    registry = []
try:
    matrix = json.loads(Path(sys.argv[3]).read_text(encoding="utf-8"))
except (OSError, ValueError, TypeError):
    matrix = {}
matrix_items = matrix.get("items") if isinstance(matrix, dict) else {}
if not isinstance(matrix_items, dict):
    matrix_items = {}
for row in (fields(line) for line in registry if line.strip() and not line.lstrip().startswith("#")):
    source = str(row.get("id") or "")
    iface = str(row.get("interface") or "")
    enabled = str(row.get("enabled", "1"))
    if source in active and iface:
        liveness = "UNKNOWN"
        try:
            flags = int(Path(f"/sys/class/net/{iface}/flags").read_text().strip(), 0)
            liveness = "UP" if flags & 1 else "DOWN"
        except (OSError, ValueError):
            # Preserve the existing ``ip link`` fallback for platforms or
            # interface types without a readable sysfs flag surface.
            pass
        matrix_row = matrix_items.get(source) if isinstance(matrix_items.get(source), dict) else {}
        services = matrix_row.get("services") if isinstance(matrix_row, dict) else {}
        direct = services.get("__channel_liveness__") if isinstance(services, dict) else {}
        recovery_open = "1" if isinstance(direct, dict) and (
            direct.get("ok") is False
            or str(direct.get("failure_episode_id") or "")
            or str(direct.get("failure_state") or "").startswith("OBSERVED_")
        ) else "0"
        print(f"{source}\t{iface}\t{enabled}\t{liveness}\t{recovery_open}")
PY
}

wake_existing_failure_consumer() {
  # A profile-source wake is narrower than an interface-liveness wake: the
  # existing Matrix consumer needs the source that the just-completed
  # canonical profile observation belongs to.  It still derives users,
  # target, Authority and every execution object itself.
  profile_source_id="${1:-}"
  profile_t0_ns="${2:-}"
  [ -n "$CONSUMER_WAKE_COMMAND" ] || return 0
  if [ "${V7_HEALTH_PERSISTENT_MATRIX_CONSUMER:-0}" = "1" ]; then
    # This producer is not an operational recovery caller.  Once it has
    # written canonical Matrix evidence, the already-running health owner
    # observes that exact binding within its bounded poll and is the one
    # persistent Matrix consumer.  Starting a second external Matrix process
    # here duplicated advisory/Planner initialization and raced the same
    # Packet/Lease chain, adding seconds to an ordinary recovery while
    # providing no new evidence.  A direct local-interface event also has no
    # profile binding, so it has always remained parent-consumed.
    #
    # Keep the historical external wake for callers that do *not* run inside
    # the persistent health owner.  That is the compatibility fallback, not
    # a second consumer for the normal production path.
    if [ -n "$profile_source_id" ] && [ "$(basename "$CONSUMER_WAKE_COMMAND")" = "v7-service-matrix-refresh-all" ]; then
      return 0
    fi
    return 0
  fi
  if [ "$(basename "$CONSUMER_WAKE_COMMAND")" = "systemctl" ]; then
    # The existing FAST role has a five-second deadline, while the governed
    # oneshot consumer may legitimately take longer to complete its Packet /
    # Lease / Apply gates.  Start that same systemd owner asynchronously so
    # this producer can durably publish the confirmed Matrix event before its
    # deadline; systemd still provides the single-flight unit semantics.
    "$CONSUMER_WAKE_COMMAND" start --no-block v7-autoswitch-planner.service >/dev/null 2>&1
  elif [ "$(basename "$CONSUMER_WAKE_COMMAND")" = "v7-service-matrix-refresh-all" ]; then
    # The production HARD role is already a single, deadline-isolated child
    # of the existing v7-health owner. Invoke the exact ExecStart consumer
    # payload directly so canonical T0 does not wait for a second systemd
    # scheduling boundary. This creates no daemon, watcher, queue or owner;
    # the same Matrix consumer still performs every current-scope, policy,
    # Packet, lease, barrier and apply check and this HARD child waits for its
    # bounded terminal before returning.
    if [ -n "$HARD_SIGNAL_CONSUMER_T0_MONOTONIC_NS" ]; then
      V7_HARD_T0_MONOTONIC_NS="$HARD_SIGNAL_CONSUMER_T0_MONOTONIC_NS" \
        "$CONSUMER_WAKE_COMMAND" \
          --consume-existing-service-failure-events-only \
          --runtime-hot-path-only >/dev/null 2>&1
    else
      "$CONSUMER_WAKE_COMMAND" \
        --consume-existing-service-failure-events-only \
        --runtime-hot-path-only >/dev/null 2>&1
    fi
  else
    "$CONSUMER_WAKE_COMMAND" >/dev/null 2>&1
  fi
}

publish_definitive_interface_failure() {
  source_id="$1"
  iface="$2"
  observed_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  result_file="$(mktemp "${TMPDIR:-/tmp}/v7-hard-signal.XXXXXX")"
  HARD_SIGNAL_OBSERVATION_COUNT=$((HARD_SIGNAL_OBSERVATION_COUNT + 1))
  if "$DEFINITIVE_MATRIX_COMMAND" "$source_id" all \
      --state-dir "$STATE_DIR" \
      --event-dir "$CANONICAL_EVENT_DIR" \
      --interface "$iface" \
      --direct-local-failure-class INTERFACE_DOWN_OR_MISSING \
      --direct-signal-observed-at "$observed_at" \
      --direct-signal-max-age-seconds 3 >"$result_file" 2>/dev/null; then
    direct_result="$(python3 - "$result_file" <<'PY'
import json
import sys
try:
    payload = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    payload = {}
direct = payload.get("direct_local_failure") if isinstance(payload, dict) else {}
status = "EMITTED" if isinstance(direct, dict) and direct.get("event_emitted") else (
    "T0" if isinstance(direct, dict) and direct.get("status") == "CANONICAL_T0_WRITTEN" else "STOP_SAFE"
)
print(status, int(direct.get("confirmed_hard_failure_monotonic_ns") or 0) if isinstance(direct, dict) else 0)
PY
)"
  else
    direct_result="STOP_SAFE"
  fi
  rm -f "$result_file"
  read -r direct_status HARD_SIGNAL_CONSUMER_T0_MONOTONIC_NS <<<"$direct_result"
  printf '%s_hard_signal_class=INTERFACE_DOWN_OR_MISSING\n' "$source_id" >> "$TMP"
  printf '%s_hard_signal_status=%s\n' "$source_id" "$direct_status" >> "$TMP"
  printf '%s_hard_signal_observed_at=%s\n' "$source_id" "$observed_at" >> "$TMP"
  if [ "$direct_status" = "EMITTED" ]; then
    HARD_SIGNAL_T0_COUNT=$((HARD_SIGNAL_T0_COUNT + 1))
    if wake_existing_failure_consumer; then
      HARD_SIGNAL_WAKE_COUNT=$((HARD_SIGNAL_WAKE_COUNT + 1))
      printf '%s_hard_signal_consumer_wake=PASS\n' "$source_id" >> "$TMP"
    else
      printf '%s_hard_signal_consumer_wake=STOP_SAFE\n' "$source_id" >> "$TMP"
    fi
  fi
}

publish_definitive_interface_recovery() {
  source_id="$1"
  iface="$2"
  result_file="$(mktemp "${TMPDIR:-/tmp}/v7-hard-recovery.XXXXXX")"
  HARD_SIGNAL_OBSERVATION_COUNT=$((HARD_SIGNAL_OBSERVATION_COUNT + 1))
  if "$DEFINITIVE_MATRIX_COMMAND" "$source_id" all \
      --state-dir "$STATE_DIR" \
      --event-dir "$CANONICAL_EVENT_DIR" \
      --interface "$iface" \
      --direct-local-recovery >"$result_file" 2>/dev/null; then
    recovery_status="$(python3 - "$result_file" <<'PY'
import json
import sys
try:
    payload = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    payload = {}
direct = payload.get("direct_local_recovery") if isinstance(payload, dict) else {}
print("EMITTED" if isinstance(direct, dict) and direct.get("event_emitted") else (
    "RECOVERED" if isinstance(direct, dict) and direct.get("status") == "CANONICAL_RECOVERY_WRITTEN" else "STOP_SAFE"
))
PY
)"
  else
    recovery_status="STOP_SAFE"
  fi
  rm -f "$result_file"
  printf '%s_hard_signal_recovery_status=%s\n' "$source_id" "$recovery_status" >> "$TMP"
  if [ "$recovery_status" = "EMITTED" ]; then
    HARD_SIGNAL_RECOVERY_COUNT=$((HARD_SIGNAL_RECOVERY_COUNT + 1))
    # Recovery is already durable in the canonical Matrix/event flow.  It has
    # no failure action to execute, so waking the failure-action consumer here
    # creates a race with a subsequent failure and can prepare an action while
    # the source is healthy.  The next failure owns the only hot-path wake.
    printf '%s_hard_signal_recovery_consumer_wake=NOT_REQUIRED_RECOVERY_EVENT\n' "$source_id" >> "$TMP"
  fi
}

build_active_profile_contracts() {
  python3 - "$STATE_DIR/users.registry" "$STATE_DIR/service-preferences.json" "$REG" <<'PY'
import hashlib
import json
import sys
from pathlib import Path

users_path, prefs_path, registry_path = map(Path, sys.argv[1:])
try:
    users_lines = users_path.read_text(encoding="utf-8", errors="replace").splitlines()
except OSError:
    users_lines = []
try:
    prefs = json.loads(prefs_path.read_text(encoding="utf-8"))
except Exception:
    prefs = {}
if not isinstance(prefs, dict):
    prefs = {}
try:
    registry_lines = registry_path.read_text(encoding="utf-8", errors="replace").splitlines()
except OSError:
    registry_lines = []
registry = {}
for line in registry_lines:
    fields = {}
    for part in line.split():
        if "=" in part:
            key, value = part.split("=", 1)
            fields[key.strip()] = value.strip()
    source = str(fields.get("id") or "").strip()
    if source:
        registry[source] = (
            str(fields.get("interface") or "").strip(),
            str(fields.get("enabled", "1")).strip(),
        )
users_prefs = prefs.get("users") if isinstance(prefs.get("users"), dict) else {}
# Keep the fallback aligned with the existing autoswitch default priority
# contract.  It is used only when a live user has no profile row at all; an
# explicit empty profile remains an intentional opt-out.
DEFAULT_PROFILE_SERVICES = ("youtube", "instagram", "telegram", "google", "google_auth")
active_sources = {}
for line in users_lines:
    line = line.strip()
    if not line or line.startswith("#"):
        continue
    fields = {}
    for part in line.split():
        if "=" in part:
            key, value = part.split("=", 1)
            fields[key.strip()] = value.strip()
    # Certification identities are owned by the existing controlled lane.  A
    # failed certification source must not continuously create an ordinary
    # profile-recovery workload: that both misclassifies the scope and can
    # starve a real customer's bounded failure observation. Their Matrix
    # facts remain visible to the certification owner; only the ordinary FAST
    # producer excludes them here.
    if str(fields.get("certification_user", "")).strip().lower() in {
        "1", "true", "yes", "on"
    }:
        continue
    source = str(fields.get("current") or "").strip()
    if not source or fields.get("enabled", "1").lower() in {"0", "false", "no"}:
        continue
    identity = str(fields.get("ip") or "").strip()
    active_sources.setdefault(source, set()).add(identity)

global_values = prefs.get("required_services") or []
if isinstance(global_values, str):
    global_values = [item.strip() for item in global_values.split(",") if item.strip()]
global_services = tuple(sorted({str(item).strip() for item in global_values if str(item).strip() and str(item).lower() != "all"})) if isinstance(global_values, list) else ()

for source, identities in sorted(active_sources.items()):
    contracts = {}
    missing_profile = False
    for identity in sorted(identities):
        row = users_prefs.get(identity) if identity else None
        if not isinstance(row, dict):
            missing_profile = True
            continue
        if "required_services" in row:
            values = row.get("required_services")
        elif "services" in row:
            values = row.get("services")
        else:
            # A profile record without a service declaration is equivalent to
            # no profile record for health observation purposes.  This does
            # not override an explicitly declared empty list.
            missing_profile = True
            continue
        values = values or []
        if isinstance(values, str):
            values = [item.strip() for item in values.split(",") if item.strip()]
        if not isinstance(values, list):
            continue
        services = tuple(sorted({str(item).strip() for item in values if str(item).strip() and str(item).lower() != "all"}))
        if services:
            contracts.setdefault(services, set()).add(identity)
    if missing_profile:
        contracts.setdefault(tuple(sorted(DEFAULT_PROFILE_SERVICES)), set()).add("__GLOBAL__")
    if not contracts and global_services:
        contracts[global_services] = {"__GLOBAL__"}
    for services, profiles in sorted(contracts.items()):
        # The first canonical profile is only an anchor for the existing
        # receiver.  The observation itself is deduplicated by source + exact
        # service contract, never by user count.
        interface, enabled = registry.get(source, ("", "0"))
        profile = sorted(profiles)[0]
        # Precompute the existing per-profile state key in this single source
        # parse.  Parallel workers must not spawn one hashing process each.
        key_hash = hashlib.sha256(f"{source}|{profile}".encode("utf-8")).hexdigest()[:16]
        print(f"{source}\t{profile}\t{','.join(services)}\t{len(profiles)}\t{interface}\t{enabled}\t{source}_profile_{key_hash}")
PY
}

profile_rows_for_source() {
  source_id="$1"
  [ -n "$PROFILE_CONTRACTS_FILE" ] && [ -r "$PROFILE_CONTRACTS_FILE" ] || return 0
