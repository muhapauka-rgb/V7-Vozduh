    printf 'fast_producer_p50_contract_result_ms=%s\n' "$p50_completion_ms" >> "$TMP"
    printf 'fast_producer_p95_contract_result_ms=%s\n' "$p95_completion_ms" >> "$TMP"
    printf 'fast_producer_max_contract_result_ms=%s\n' "$max_completion_ms" >> "$TMP"
  fi
}

get_field() {
  key="$1"
  line="$2"
  printf '%s\n' "$line" | tr ' ' '\n' | awk -F= -v k="$key" '$1 == k {print substr($0, length(k) + 2); exit}'
}

summary_value() {
  key="$1"
  grep "^${key}=" "$SUM" 2>/dev/null | tail -n1 | cut -d= -f2- || true
}

parse_handshake_text_age() {
  hs="$1"
  python3 - "$hs" <<'PY'
import re
import sys

s = sys.argv[1]
if not s or s.strip().lower() in {"never", "(none)"}:
    print("999999")
    raise SystemExit

total = 0
for n, unit in re.findall(r'(\d+)\s+(day|hour|minute|second)', s):
    n = int(n)
    if unit == "day":
        total += n * 86400
    elif unit == "hour":
        total += n * 3600
    elif unit == "minute":
        total += n * 60
    elif unit == "second":
        total += n
print(total if total else 999999)
PY
}

wg_handshake_age_seconds() {
  iface="$1"
  now="$(date +%s)"
  latest="$(wg show "$iface" latest-handshakes 2>/dev/null | awk 'NF >= 2 && $2 ~ /^[0-9]+$/ {print $2; exit}' || true)"
  if [ -n "$latest" ] && [ "$latest" -gt 0 ] 2>/dev/null; then
    age=$((now - latest))
    if [ "$age" -lt 0 ]; then
      echo "0"
    else
      echo "$age"
    fi
    return
  fi

  hs="$(wg show "$iface" 2>/dev/null | grep 'latest handshake' | sed 's/.*latest handshake: //' || true)"
  if [ -z "$hs" ]; then
    echo "999999"
    return
  fi
  parse_handshake_text_age "$hs"
}

awg_handshake_age_seconds() {
  iface="$1"
  hs="$(awg show "$iface" 2>/dev/null | grep 'latest handshake' | sed 's/.*latest handshake: //' || true)"
  if [ -z "$hs" ]; then
    echo "999999"
    return
  fi
  parse_handshake_text_age "$hs"
}

handshake_age_seconds() {
  protocol="$1"
  iface="$2"
  case "$protocol" in
    wireguard|wg)
      wg_handshake_age_seconds "$iface"
      ;;
    amneziawg|awg)
      awg_handshake_age_seconds "$iface"
      ;;
    *)
      echo "unsupported"
      ;;
  esac
}

interface_up() {
  iface="$1"
  if [ -r "/sys/class/net/${iface}/flags" ]; then
    IFS= read -r interface_flags < "/sys/class/net/${iface}/flags" || interface_flags="0"
    [ $((interface_flags & 1)) -eq 1 ] 2>/dev/null && return 0
    return 1
  fi
  if command -v ip >/dev/null 2>&1; then
    ip link show "$iface" 2>/dev/null | grep -q 'UP,LOWER_UP'
    return
  fi
  # Engineering Polygon runs may execute on a BSD/macOS host without
  # iproute2.  Preserve the same local IFF_UP evidence through its native
  # read-only interface owner rather than misclassifying every interface as
  # absent and spawning a false Matrix event per source.
  if command -v ifconfig >/dev/null 2>&1; then
    ifconfig "$iface" 2>/dev/null | grep -qE '(^|[<,])UP([,>]|$)'
    return
  fi
  return 1
}

diagnose_row() {
  id="$1"
  protocol="$2"
  iface="$3"
  enabled="$4"
  code="$(summary_value "${id}_code")"
  code="${code:-200}"

  severity="OK"
  reason="OK"
  detail="protocol=${protocol}"

  if [ "$enabled" != "1" ]; then
    severity="DISABLED"
    reason="egress_disabled"
    detail="protocol=${protocol}"
  elif ! interface_up "$iface"; then
    severity="FAIL"
    reason="interface_down_or_missing"
    detail="protocol=${protocol}"
  else
    age="$(handshake_age_seconds "$protocol" "$iface")"
    if [ "$age" = "unsupported" ]; then
      if [ "$code" = "200" ]; then
        severity="SUSPECT"
        reason="handshake_unsupported_for_protocol_${protocol}"
      else
        severity="FAIL"
        reason="curl_failed_and_handshake_unsupported"
      fi
      detail="protocol=${protocol}"
    elif [ "$age" -ge 300 ] 2>/dev/null; then
      if [ "$code" = "200" ]; then
        if [ "$protocol" = "wireguard" ] || [ "$protocol" = "wg" ]; then
          severity="WARN"
          reason="curl_ok_but_wireguard_handshake_unavailable"
        else
          severity="SUSPECT"
          reason="curl_ok_but_handshake_stale"
        fi
      else
        severity="FAIL"
        reason="curl_failed_and_handshake_stale"
      fi
      detail="handshake_age_seconds=${age}"
    else
      severity="OK"
      reason="OK"
      detail="handshake_age_seconds=${age}"
    fi
  fi

  {
    printf '%s_diagnose_reason=%s\n' "$id" "$reason"
    printf '%s_diagnose_severity=%s\n' "$id" "$severity"
  printf '%s_diagnose_detail=%s\n' "$id" "$detail"
  } >> "$TMP"
  shadow_trigger_for_reason "$id" "$reason" "$severity"
}

build_ready_fast_contract_workset() {
  # This is an immutable, per-process work list.  It is neither persisted nor a
  # state/registry owner: canonical source/profile truth remains in the two
  # existing state files used to build it.
  #
  # The source is the transport being observed, so probe its one exact union
  # of currently declared ordinary services once.  Probing every profile
  # contract independently made one failed source serialize Matrix writes and
  # consumer wakes after otherwise parallel one-second probes.  The existing
  # Matrix and Autoswitch owners still expand this source evidence back to
  # each user's individual profile before Authority or Apply; ``__GLOBAL__``
  # is only the existing source-scoped probe anchor and never a user decision.
  [ -n "$PROFILE_SERVICE_SUSPICION_COMMAND" ] || return 0
  [ -r "$PROFILE_CONTRACTS_FILE" ] || return 0
  python3 - "$PROFILE_CONTRACTS_FILE" <<'PY'
import sys

sources = {}
try:
    rows = open(sys.argv[1], encoding="utf-8")
except OSError:
    rows = []
for raw in rows:
    fields = raw.rstrip("\n").split("\t")
    if len(fields) < 7:
        continue
    source, _profile, services, profile_count, iface, enabled, _state_key = fields[:7]
    if not source or not services:
        continue
    row = sources.setdefault(source, {
        "services": set(), "profile_count": 0,
        "iface": iface, "enabled": enabled or "1",
    })
    row["services"].update(
        service.strip() for service in services.split(",") if service.strip()
    )
    try:
        row["profile_count"] += max(1, int(profile_count or 0))
    except ValueError:
        row["profile_count"] += 1
for source in sorted(sources):
    row = sources[source]
    services = ",".join(sorted(row["services"]))
    if services:
        print(
            f"{source}\t__GLOBAL__\t{services}\t{row['profile_count']}"
            f"\t{row['iface']}\t{row['enabled']}"
            f"\t{source}_profile_source_aggregate"
        )
PY
}

build_fast_matrix_fresh_failure_index() {
  FAST_MATRIX_FRESH_FAILURES_FILE="$(mktemp "${TMPDIR:-/tmp}/v7-fast-matrix-failures.XXXXXX")"
  python3 - "$STATE_DIR/service-matrix.json" "$PROFILE_MATRIX_REUSE_MAX_AGE_SEC" > "$FAST_MATRIX_FRESH_FAILURES_FILE" <<'PY'
import json
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

try:
    items = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8")).get("items") or {}
except (OSError, ValueError, TypeError):
    items = {}
now = time.time()
try:
    max_age = max(1, int(sys.argv[2]))
except (IndexError, TypeError, ValueError):
    max_age = 10
for source_id, source in items.items():
    if not isinstance(source, dict):
        continue
    for service_id, row in (source.get("services") or {}).items():
        if not isinstance(row, dict):
            continue
        observed = str(row.get("observed_at") or row.get("tested_at") or "")
        try:
            at = datetime.fromisoformat(observed.replace("Z", "+00:00"))
            if at.tzinfo is None:
                at = at.replace(tzinfo=timezone.utc)
            age = now - at.timestamp()
        except (TypeError, ValueError, OverflowError):
            continue
        if age < 0 or age > max_age:
            continue
        if not str(row.get("source_incident_id") or ""):
            continue
        status = str(row.get("status") or "").upper()
        severity = str(row.get("severity") or "").upper()
        failure_state = str(row.get("failure_state") or "").upper()
        if status == "FAIL" or severity == "FAIL" or failure_state.startswith("OBSERVED_"):
            print(f"{source_id}\t{service_id}")
PY
}

run_lightweight_batch_profile_suspicion_cycle() {
  # These values are also passed as source-observation context to existing
  # consumers, so retain their historical wall-clock domain.  The new outer
  # diagnostics use a separate monotonic clock only for elapsed time.
  batch_started_ns="$(python3 -c 'import time; print(time.time_ns())')"
  work_dir="$(mktemp -d "${TMPDIR:-/tmp}/v7-fast-batch.XXXXXX")"
  work_file="$work_dir/active-contract-set.tsv"
  result_file="$work_dir/batch-result.json"
  parsed_file="$work_dir/parsed.tsv"
  build_ready_fast_contract_workset > "$work_file"
  if [ ! -s "$work_file" ]; then
    rm -rf "$work_dir"
    return 0
  fi
  build_fast_matrix_fresh_failure_index
  batch_probe_started_ns="$(python3 -c 'import time; print(time.time_ns())')"
  # The ordinary recovery detector must distinguish an actual failure from an
  # overloaded half-second observation. One second remains bounded and runs
  # in parallel, while UNKNOWN is still fail-closed.
  if ! "$PROFILE_SERVICE_SUSPICION_COMMAND" __batch__ all \
      --state-dir "$STATE_DIR" \
      --batch-lightweight-contracts "$work_file" \
      --batch-concurrency "$FAST_PRODUCER_CONCURRENCY" \
      --sentinel-timeout-ms 1000 > "$result_file" 2>/dev/null; then
    printf 'fast_producer_batch_status=STOP_SAFE_BATCH_OWNER_FAILED\n' >> "$TMP"
    rm -rf "$work_dir"
    return 0
  fi
  batch_probe_completed_ns="$(python3 -c 'import time; print(time.time_ns())')"
  python3 - "$result_file" > "$parsed_file" <<'PY'
import json
import sys
import time
try:
    payload = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    payload = {}
for row in payload.get("contracts") or []:
    if not isinstance(row, dict):
        continue
    services = [str(item) for item in row.get("services") or [] if str(item)]
    if not services:
        continue
    blockers = [str(item) for item in row.get("blockers") or [] if str(item)]
    unknown = list(row.get("unknown_services") or [])
    if blockers:
        unknown.extend(services)
    values = [
        str(row.get("source") or ""),
        str(row.get("profile") or ""),
        ",".join(services),
        str(max(0, int(row.get("failure_count") or 0))),
        ",".join(str(item) for item in row.get("dns_services") or []),
        ",".join(str(item) for item in row.get("degraded_services") or []),
        ",".join(str(item) for item in row.get("failed_services") or []),
        ",".join(sorted(set(unknown))),
        str(row.get("state_key") or ""),
        str(time.time_ns()),
    ]
    print("|".join(value.replace("|", " ").replace("\n", " ") for value in values))
PY
  batch_probe_count="$(python3 - "$result_file" <<'PY'
import json, sys
try: print(max(0, int(json.load(open(sys.argv[1], encoding="utf-8")).get("probe_count") or 0)))
except Exception: print(0)
PY
)"
  if [ "$batch_probe_count" -lt "$FAST_PRODUCER_CONCURRENCY" ] 2>/dev/null; then
    FAST_PRODUCER_MAX_INFLIGHT="$batch_probe_count"
  else
    FAST_PRODUCER_MAX_INFLIGHT="$FAST_PRODUCER_CONCURRENCY"
  fi
  while IFS='|' read -r source_id profile_user services failure_count dns_services degraded_services failed_services unknown_services state_key completion_ns; do
    [ -n "$source_id" ] || continue
    PROFILE_SERVICE_OBSERVATION_COUNT=$((PROFILE_SERVICE_OBSERVATION_COUNT + 1))
    probe="OK|${failure_count}|${dns_services}|${degraded_services}|${failed_services}|${unknown_services}|${completion_ns}"
    process_profile_service_probe "$source_id" "$profile_user" "$services" "$probe" "$state_key"
  done < "$parsed_file"
  batch_postprocess_completed_ns="$(python3 -c 'import time; print(time.time_ns())')"
  # The batch probe and its canonical Matrix consequence handling are
  # intentionally separate.  These diagnostic-only spans expose whether a
  # slow ordinary detection cycle is network sampling or repeated local
  # confirmation/record work.  They do not participate in admission, do not
  # persist a new truth source and do not change the existing caller.
  printf 'fast_producer_batch_probe_wall_ms=%s\n' "$(( (batch_probe_completed_ns - batch_started_ns) / 1000000 ))" >> "$TMP"
  printf 'fast_producer_batch_setup_wall_ms=%s\n' "$(( (batch_probe_started_ns - batch_started_ns) / 1000000 ))" >> "$TMP"
  printf 'fast_producer_batch_network_wall_ms=%s\n' "$(( (batch_probe_completed_ns - batch_probe_started_ns) / 1000000 ))" >> "$TMP"
  printf 'fast_producer_batch_postprocess_wall_ms=%s\n' "$(( (batch_postprocess_completed_ns - batch_probe_completed_ns) / 1000000 ))" >> "$TMP"
  printf 'fast_producer_batch_total_wall_ms=%s\n' "$(( (batch_postprocess_completed_ns - batch_started_ns) / 1000000 ))" >> "$TMP"
  printf 'fast_producer_batch_status=PASS\n' >> "$TMP"
  printf 'fast_producer_batch_probe_count=%s\n' "$batch_probe_count" >> "$TMP"
  rm -rf "$work_dir"
  rm -f "$FAST_MATRIX_FRESH_FAILURES_FILE"
  FAST_MATRIX_FRESH_FAILURES_FILE=""
}

run_parallel_active_profile_suspicion_cycle() {
  work_dir="$(mktemp -d "${TMPDIR:-/tmp}/v7-fast-contracts.XXXXXX")"
  work_file="$work_dir/active-contract-set.tsv"
  # The set is intentionally temporary and discarded before the owner returns.
  build_ready_fast_contract_workset > "$work_file"

  work_sources=()
  work_profiles=()
  work_services=()
  work_state_keys=()
  last_checked_iface=""
  last_checked_iface_ready="0"
  while IFS=$'\t' read -r source_id profile_user services _profile_count iface enabled state_key; do
    [ -n "$source_id" ] || continue
    [ -n "$profile_user" ] || continue
    [ -n "$services" ] || continue
    enabled="${enabled:-1}"
    [ "$enabled" = "1" ] || continue
    [ -n "$iface" ] || continue
    if [ "$iface" = "$last_checked_iface" ]; then
      [ "$last_checked_iface_ready" = "1" ] || continue
    elif interface_up "$iface"; then
      last_checked_iface="$iface"
      last_checked_iface_ready="1"
    else
      last_checked_iface="$iface"
      last_checked_iface_ready="0"
      continue
    fi
    work_sources+=("$source_id")
    work_profiles+=("$profile_user")
    work_services+=("$services")
    work_state_keys+=("$state_key")
  done < "$work_file"

  total="${#work_sources[@]}"
  [ "$total" -gt 0 ] || { rm -rf "$work_dir"; return 0; }
  probe_pids=()
  next_index=0
  inflight=0
  completed=0
  while [ "$next_index" -lt "$total" ] || [ "$inflight" -gt 0 ]; do
    while [ "$next_index" -lt "$total" ] && [ "$inflight" -lt "$FAST_PRODUCER_CONCURRENCY" ]; do
      slot="$next_index"
      printf '%s\t%s\t%s\t%s\n' "${work_sources[$slot]}" "${work_profiles[$slot]}" "${work_services[$slot]}" "${work_state_keys[$slot]}" > "$work_dir/$slot.meta"
      (
        run_profile_service_probe "${work_sources[$slot]}" "${work_services[$slot]}" > "$work_dir/$slot.result"
        touch "$work_dir/$slot.done"
      ) &
      probe_pids[$slot]="$!"
      PROFILE_SERVICE_OBSERVATION_COUNT=$((PROFILE_SERVICE_OBSERVATION_COUNT + 1))
      inflight=$((inflight + 1))
      if [ "$inflight" -gt "$FAST_PRODUCER_MAX_INFLIGHT" ]; then
        FAST_PRODUCER_MAX_INFLIGHT="$inflight"
      fi
      next_index=$((next_index + 1))
    done

    made_progress="0"
    for slot in "${!probe_pids[@]}"; do
      [ -n "${probe_pids[$slot]:-}" ] || continue
      [ -f "$work_dir/$slot.done" ] || continue
      wait "${probe_pids[$slot]}" || true
      IFS=$'\t' read -r source_id profile_user services state_key < "$work_dir/$slot.meta"
      probe="$(cat "$work_dir/$slot.result")"
      # Only this parent processes trigger/state consequences.  Probe workers
      # are read-only and cannot race the canonical writer or incident state.
      process_profile_service_probe "$source_id" "$profile_user" "$services" "$probe" "$state_key"
      unset 'probe_pids[$slot]'
      inflight=$((inflight - 1))
      completed=$((completed + 1))
      made_progress="1"
    done
    [ "$completed" -ge "$total" ] && break
    if [ "$made_progress" = "0" ]; then
      sleep 0.02
    fi
  done
  rm -rf "$work_dir"
}

run_active_profile_suspicion_cycle() {
  [ -n "$PROFILE_SERVICE_SUSPICION_COMMAND" ] || return 0
  [ -r "$PROFILE_CONTRACTS_FILE" ] || return 0
  if [ "$LIGHTWEIGHT_BATCH_PRODUCER" = "1" ]; then
    run_lightweight_batch_profile_suspicion_cycle
    return 0
  fi
  # The governed fast producer always consumes the source-aggregated workset,
  # even when its configured fan-out is one.  The legacy sequential branch
  # below iterates every profile contract and would reintroduce the very
  # per-profile Matrix/wake serialization this bounded path removes.
  if [ "$FAST_PRODUCER_ONLY" = "1" ]; then
    run_parallel_active_profile_suspicion_cycle
    return 0
  fi
  if [ "$FAST_PRODUCER_CONCURRENCY" -gt 1 ] 2>/dev/null; then
    run_parallel_active_profile_suspicion_cycle
    return 0
  fi
  previous_source=""
  last_checked_iface=""
  last_checked_iface_ready="0"
  while IFS=$'\t' read -r source_id _profile _services _profile_count iface enabled _state_key; do
    [ -n "$source_id" ] || continue
    [ "$source_id" = "$previous_source" ] && continue
    previous_source="$source_id"
    enabled="${enabled:-1}"
    [ "$enabled" = "1" ] || continue
    [ -n "$iface" ] || continue
    if [ "$iface" = "$last_checked_iface" ]; then
      [ "$last_checked_iface_ready" = "1" ] || continue
    elif interface_up "$iface"; then
      last_checked_iface="$iface"
      last_checked_iface_ready="1"
    else
      last_checked_iface="$iface"
      last_checked_iface_ready="0"
      continue
    fi
    profile_service_suspicion_for_source "$source_id"
  done < "$PROFILE_CONTRACTS_FILE"
}

if [ ! -r "$REG" ]; then
  echo "egress registry unreadable: $REG" >&2
  exit 1
fi

if [ -n "$PROFILE_SERVICE_SUSPICION_COMMAND" ]; then
  FAST_PRODUCER_SCRIPT_STARTED_NS="$(monotonic_ns)"
  FAST_PRODUCER_CONTRACT_BUILD_STARTED_NS="$(monotonic_ns)"
  PROFILE_CONTRACTS_FILE="$(mktemp "${TMPDIR:-/tmp}/v7-profile-contracts.XXXXXX")"
  build_active_profile_contracts > "$PROFILE_CONTRACTS_FILE"
  PROFILE_SERVICE_CONTRACT_COUNT="$(wc -l < "$PROFILE_CONTRACTS_FILE" | tr -d ' ')"
  PROFILE_SERVICE_ACTIVE_SOURCE_COUNT="$(cut -f1 "$PROFILE_CONTRACTS_FILE" | uniq | wc -l | tr -d ' ')"
  FAST_PRODUCER_CONTRACT_BUILD_COMPLETED_NS="$(monotonic_ns)"
  trap 'test -z "$PROFILE_CONTRACTS_FILE" || rm -f "$PROFILE_CONTRACTS_FILE"; test -z "$ACTIVE_SOURCE_FILE" || rm -f "$ACTIVE_SOURCE_FILE"; test -z "$FAST_MATRIX_FRESH_FAILURES_FILE" || rm -f "$FAST_MATRIX_FRESH_FAILURES_FILE"' EXIT
elif [ "$HARD_SIGNAL_ONLY" = "1" ]; then
  ACTIVE_SOURCE_FILE="$(mktemp "${TMPDIR:-/tmp}/v7-active-sources.XXXXXX")"
  build_active_hard_rows > "$ACTIVE_SOURCE_FILE"
  trap 'test -z "$PROFILE_CONTRACTS_FILE" || rm -f "$PROFILE_CONTRACTS_FILE"; test -z "$ACTIVE_SOURCE_FILE" || rm -f "$ACTIVE_SOURCE_FILE"; test -z "$FAST_MATRIX_FRESH_FAILURES_FILE" || rm -f "$FAST_MATRIX_FRESH_FAILURES_FILE"' EXIT
fi

: > "$TMP"
echo "updated=$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> "$TMP"
if [ -n "$PROFILE_SERVICE_SUSPICION_COMMAND" ]; then
  FAST_PRODUCER_STARTED_NS="$(python3 -c 'import time; print(time.time_ns())')"
  FAST_PRODUCER_MONOTONIC_STARTED_NS="$(monotonic_ns)"
fi

if [ "$FAST_PRODUCER_ONLY" = "1" ]; then
  echo "fast_producer_mode=CONTROLLED_OBSERVATION_ONLY" >> "$TMP"
  run_active_profile_suspicion_cycle
  write_fast_producer_telemetry
  commit_output
  emit_fast_producer_timing_receipt
  exit 0
fi

if [ "$HARD_SIGNAL_ONLY" = "1" ]; then
  echo "hard_signal_mode=ROLE_BASED_ACTIVE_SOURCE_LOCAL_LIVENESS" >> "$TMP"
  hard_last_iface=""
  hard_last_iface_up="0"
  HARD_SIGNAL_RECOVERY_COUNT=0
  while IFS=$'\t' read -r id iface enabled local_liveness recovery_open; do
    [ -n "$id" ] || continue
    [ -n "$iface" ] || continue
    [ "${enabled:-1}" = "1" ] || continue
    if [ "${local_liveness:-UNKNOWN}" = "UP" ]; then
      hard_last_iface="$iface"
      hard_last_iface_up="1"
    elif [ "${local_liveness:-UNKNOWN}" = "DOWN" ]; then
      hard_last_iface="$iface"
      hard_last_iface_up="0"
    elif [ "$iface" != "$hard_last_iface" ]; then
      hard_last_iface="$iface"
      if interface_up "$iface"; then
        hard_last_iface_up="1"
      else
        hard_last_iface_up="0"
      fi
    fi
    if [ "$hard_last_iface_up" = "1" ]; then
      if [ "${recovery_open:-0}" = "1" ]; then
        publish_definitive_interface_recovery "$id" "$iface"
      else
        printf '%s_hard_signal_status=HEALTHY_LOCAL_INTERFACE\n' "$id"
      fi
    else
      publish_definitive_interface_failure "$id" "$iface"
    fi
  done < "$ACTIVE_SOURCE_FILE" >> "$TMP"
  printf 'hard_signal_active_source_count=%s\n' "$(wc -l < "$ACTIVE_SOURCE_FILE" | tr -d ' ')" >> "$TMP"
  printf 'hard_signal_observation_count=%s\n' "$HARD_SIGNAL_OBSERVATION_COUNT" >> "$TMP"
  printf 'hard_signal_new_t0_count=%s\n' "$HARD_SIGNAL_T0_COUNT" >> "$TMP"
  printf 'hard_signal_recovery_count=%s\n' "$HARD_SIGNAL_RECOVERY_COUNT" >> "$TMP"
  printf 'hard_signal_consumer_wake_count=%s\n' "$HARD_SIGNAL_WAKE_COUNT" >> "$TMP"
  commit_output
  exit 0
fi

run_active_profile_suspicion_cycle
write_fast_producer_telemetry

while IFS= read -r line; do
  [ -z "$line" ] && continue
  case "$line" in \#*) continue ;; esac
  id="$(get_field id "$line")"
  iface="$(get_field interface "$line")"
  protocol="$(get_field protocol "$line")"
  enabled="$(get_field enabled "$line")"
  [ -z "$id" ] && continue
  [ -z "$iface" ] && continue
  protocol="${protocol:-unknown}"
  enabled="${enabled:-1}"
  diagnose_row "$id" "$protocol" "$iface" "$enabled"
done < "$REG"

commit_output
