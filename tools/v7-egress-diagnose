run_profile_service_probe() {
  source_id="$1"
  services="$2"
  probe_dir="$(mktemp -d "${TMPDIR:-/tmp}/v7-profile-probe.XXXXXX")"
  probe_output="$probe_dir/result.json"
  mkdir -p "$probe_dir/events"
  if "$PROFILE_SERVICE_SUSPICION_COMMAND" "$source_id" all \
      --services "$services" \
      --state-dir "$STATE_DIR" \
      --matrix-file "$probe_dir/service-matrix.json" \
      --event-dir "$probe_dir/events" \
      --probe-observation-only \
      --failure-persistence-samples 1 \
      --failure-persistence-window-seconds 30 \
      --timeout 5 >"$probe_output" 2>/dev/null; then
    probe_rc=0
  else
    probe_rc="$?"
  fi
  python3 - "$probe_output" "$probe_rc" "$services" <<'PY'
import json
import sys
import time
from pathlib import Path
try:
    payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
except Exception:
    payload = {}
results = payload.get("results") if isinstance(payload, dict) and isinstance(payload.get("results"), dict) else {}
expected = [item.strip() for item in str(sys.argv[3] or "").split(",") if item.strip()]
failed = []
dns = []
degraded = []
unknown = []
for service in expected:
    if service not in results:
        unknown.append(service)
for service, row in results.items():
    if not isinstance(row, dict):
        continue
    status = str(row.get("status") or "UNKNOWN").upper()
    reason = str(row.get("reason") or row.get("error") or "").upper()
    if status in {"UNKNOWN", "STALE", "CONFLICT"}:
        unknown.append(str(service))
    elif not bool(row.get("ok")) or status not in {"OK", "WARN"}:
        failed.append(f"{service}:{status}")
    if (
        reason == "DNS_FAILURE"
        or "DNS_FAILURE" in reason
        or "COULD NOT RESOLVE" in reason
        or "NAME RESOLUTION" in reason
    ):
        dns.append(str(service))
    if status in {"DEGRADED", "DOWN_GRACE", "GRACE"}:
        degraded.append(str(service))
print("|".join([
    "OK" if int(sys.argv[2] or 1) == 0 else "FAILED",
    str(len(failed)),
    ",".join(sorted(dns)),
    ",".join(sorted(degraded)),
    ",".join(sorted(failed)),
    ",".join(sorted(set(unknown))),
    str(time.time_ns()),
]))
PY
  rm -rf "$probe_dir"
}

profile_service_trigger() {
  source_id="$1"
  profile_user="$2"
  services="$3"
  failure_count="$4"
  dns_services="$5"
  degraded_services="$6"
  failed_services="$7"
  unknown_services="$8"
  state_key="${9:-}"
  if [ -z "$state_key" ]; then
    key_hash="$(printf '%s' "${source_id}|${profile_user}" | shasum -a 256 | awk '{print substr($1,1,16)}')"
    state_key="${source_id}_profile_${key_hash}"
  fi
  previous_count="$(previous_value "${state_key}_profile_failure_count")"
  previous_count="${previous_count:-0}"
  if [ "$failure_count" -gt 0 ] 2>/dev/null; then
    current_count=$((previous_count + 1))
  else
    current_count=0
  fi
  printf '%s_profile_user=%s\n' "$state_key" "$profile_user" >> "$TMP"
  printf '%s_profile_services=%s\n' "$state_key" "$services" >> "$TMP"
  printf '%s_profile_failure_count=%s\n' "$state_key" "$current_count" >> "$TMP"
  printf '%s_profile_failed_services=%s\n' "$state_key" "$failed_services" >> "$TMP"
  printf '%s_profile_dns_services=%s\n' "$state_key" "$dns_services" >> "$TMP"
  printf '%s_profile_degraded_services=%s\n' "$state_key" "$degraded_services" >> "$TMP"
  printf '%s_profile_unknown_services=%s\n' "$state_key" "$unknown_services" >> "$TMP"
  if [ -n "$unknown_services" ]; then
    printf '%s_profile_trigger_status=STOP_SAFE_UNKNOWN\n' "$state_key" >> "$TMP"
    printf '%s_profile_trigger_class=STALE_OR_UNKNOWN_STATE\n' "$state_key" >> "$TMP"
    return 0
  fi
  [ "$failure_count" -gt 0 ] 2>/dev/null || return 0
  if [ "$current_count" -lt "$PROFILE_SERVICE_FAILURE_SAMPLES" ] 2>/dev/null; then
    printf '%s_profile_trigger_status=WAITING_REPEAT\n' "$state_key" >> "$TMP"
    return 0
  fi

  trigger_class=""
  producer_family="PROFILE_SERVICE_SUSPICION_PRODUCER"
  if [ -n "$dns_services" ]; then
    trigger_class="DNS_FAILURE"
    producer_family="DNS_SUSPICION_PRODUCER"
  elif [ "$(printf '%s' "$failed_services" | awk -F, '{print NF}')" -ge 2 ] 2>/dev/null; then
    trigger_class="MULTI_SERVICE_FAILURE"
  elif [ -n "$degraded_services" ]; then
    trigger_class="PARTIAL_CENSORSHIP"
  else
    required_ids="$(required_service_ids)"
    failed_ids="$(printf '%s' "$failed_services" | cut -d: -f1 | sed 's/,/\n/g')"
    required_hit=""
    while IFS= read -r failed_id; do
      [ -n "$failed_id" ] || continue
      case ",${required_ids}," in
        *,${failed_id},*) required_hit=1; break ;;
      esac
    done <<EOF
$failed_ids
EOF
    if [ -n "$required_hit" ] || [ "$profile_user" = "__GLOBAL__" ]; then
      trigger_class="REQUIRED_SERVICE_FAILURE"
    else
      trigger_class="OTHER_PROFILE_REQUIRED_SERVICE_FAILURE"
    fi
  fi
  [ -n "$trigger_class" ] || return 0
  now_epoch="$(date +%s)"
  previous_epoch="$(previous_value "${state_key}_profile_trigger_epoch")"
  if [ "$PROFILE_SERVICE_COOLDOWN_SEC" -gt 0 ] 2>/dev/null && [ -n "$previous_epoch" ] && [ "$previous_epoch" -ge $((now_epoch - PROFILE_SERVICE_COOLDOWN_SEC)) ] 2>/dev/null; then
    printf '%s_profile_trigger_status=SUPPRESSED_COOLDOWN\n' "$state_key" >> "$TMP"
    printf '%s_profile_trigger_family=%s\n' "$state_key" "$producer_family" >> "$TMP"
    printf '%s_profile_trigger_class=%s\n' "$state_key" "$trigger_class" >> "$TMP"
    return 0
  fi
  trigger_id="v7ps_$(printf '%s' "${source_id}|${profile_user}|${trigger_class}|${failed_services}" | shasum -a 256 | awk '{print substr($1,1,24)}')"
  trigger_event_dir="$CANONICAL_EVENT_DIR"
  trigger_service_args=()
  if [ "$profile_user" = "__GLOBAL__" ]; then
    trigger_service_args=(--services "$services")
  else
    trigger_service_args=(--shadow-trigger-profile-user "$profile_user")
  fi
  trigger_persistence_args=()
  if [ -n "$PROFILE_SERVICE_SHADOW_MATRIX_SAMPLES" ]; then
    trigger_persistence_args+=(--shadow-failure-persistence-samples "$PROFILE_SERVICE_SHADOW_MATRIX_SAMPLES")
  fi
  if [ -n "$PROFILE_SERVICE_SHADOW_MATRIX_WINDOW_SEC" ]; then
    trigger_persistence_args+=(--shadow-failure-persistence-window-seconds "$PROFILE_SERVICE_SHADOW_MATRIX_WINDOW_SEC")
  fi
  PROFILE_SERVICE_RECEIVER_INVOCATION_COUNT=$((PROFILE_SERVICE_RECEIVER_INVOCATION_COUNT + 1))
  if "$SHADOW_TRIGGER_COMMAND" \
      --state-dir "$STATE_DIR" \
      --event-dir "$trigger_event_dir" \
      --egresses "$source_id" \
      "${trigger_service_args[@]}" \
      --shadow-trigger-source "$source_id" \
      --shadow-trigger-class "$trigger_class" \
      --shadow-trigger-id "$trigger_id" \
      "${trigger_persistence_args[@]}" \
      --matrix-observation-only >/dev/null 2>&1; then
    trigger_status="PASS"
    trigger_rc="0"
    # A targeted Matrix confirmation is only the canonical health/T0 write.
    # Hand the confirmed event to the already existing governed consumer in
    # the same way as the definitive hard-signal path.  The consumer remains
    # fail-closed and single-flight; this producer never plans or applies a
    # route itself.
    if [ -n "$CONSUMER_WAKE_COMMAND" ]; then
      if wake_existing_failure_consumer; then
        PROFILE_SERVICE_CONSUMER_WAKE_COUNT=$((PROFILE_SERVICE_CONSUMER_WAKE_COUNT + 1))
        printf '%s_profile_consumer_wake=PASS\n' "$state_key" >> "$TMP"
      else
        printf '%s_profile_consumer_wake=STOP_SAFE\n' "$state_key" >> "$TMP"
      fi
    fi
  else
    trigger_rc="$?"
    trigger_status="FAILED"
  fi
  printf '%s_profile_trigger_status=%s\n' "$state_key" "$trigger_status" >> "$TMP"
  printf '%s_profile_trigger_family=%s\n' "$state_key" "$producer_family" >> "$TMP"
  printf '%s_profile_trigger_class=%s\n' "$state_key" "$trigger_class" >> "$TMP"
  printf '%s_profile_trigger_id=%s\n' "$state_key" "$trigger_id" >> "$TMP"
  printf '%s_profile_trigger_epoch=%s\n' "$state_key" "$now_epoch" >> "$TMP"
  printf '%s_profile_trigger_rc=%s\n' "$state_key" "$trigger_rc" >> "$TMP"
}

dns_suspicion_producer() {
  source_id="$1"
  profile_user="$2"
  services="$3"
  failure_count="$4"
  dns_services="$5"
  degraded_services="$6"
  failed_services="$7"
  unknown_services="$8"
  state_key="${9:-}"
  [ -n "$dns_services" ] || return 0
  profile_service_trigger "$source_id" "$profile_user" "$services" "$failure_count" "$dns_services" "$degraded_services" "$failed_services" "$unknown_services" "$state_key"
}

profile_service_suspicion_for_source() {
  source_id="$1"
  [ -n "$PROFILE_SERVICE_SUSPICION_COMMAND" ] || return 0
  rows="$(profile_rows_for_source "$source_id")"
  [ -n "$rows" ] || return 0
  while IFS=$'\t' read -r profile_user services; do
    [ -n "$profile_user" ] || continue
    [ -n "$services" ] || continue
    PROFILE_SERVICE_OBSERVATION_COUNT=$((PROFILE_SERVICE_OBSERVATION_COUNT + 1))
    if [ "$FAST_PRODUCER_MAX_INFLIGHT" -lt 1 ]; then
      FAST_PRODUCER_MAX_INFLIGHT=1
    fi
    probe="$(run_profile_service_probe "$source_id" "$services")"
    process_profile_service_probe "$source_id" "$profile_user" "$services" "$probe"
  done <<EOF
$rows
EOF
}

process_profile_service_probe() {
  source_id="$1"
  profile_user="$2"
  services="$3"
  probe="$4"
  state_key="${5:-}"
  IFS='|' read -r probe_status failure_count dns_services degraded_services failed_services unknown_services completion_ns <<EOF
$probe
EOF
  if [ -n "$completion_ns" ] && [ "$completion_ns" -ge "$FAST_PRODUCER_STARTED_NS" ] 2>/dev/null; then
    completion_ms=$(( (completion_ns - FAST_PRODUCER_STARTED_NS) / 1000000 ))
    FAST_PRODUCER_COMPLETION_MS+=("$completion_ms")
  fi
  if [ -n "$dns_services" ]; then
    dns_suspicion_producer "$source_id" "$profile_user" "$services" "$failure_count" "$dns_services" "$degraded_services" "$failed_services" "$unknown_services" "$state_key"
  else
    profile_service_trigger "$source_id" "$profile_user" "$services" "$failure_count" "$dns_services" "$degraded_services" "$failed_services" "$unknown_services" "$state_key"
  fi
}

