run_profile_service_probe() {
  source_id="$1"
  services="$2"
  probe_dir="$(mktemp -d "${TMPDIR:-/tmp}/v7-profile-probe.XXXXXX")"
  probe_output="$probe_dir/result.json"
  mkdir -p "$probe_dir/events"
  if "$PROFILE_SERVICE_SUSPICION_COMMAND" "$source_id" all \
      --services "$services" \
      --state-dir "$STATE_DIR" \
      --matrix-file "$probe_dir/service-matrix.json" \
      --event-dir "$probe_dir/events" \
      --probe-observation-only \
      --failure-persistence-samples 1 \
      --failure-persistence-window-seconds 30 \
      "${PROFILE_SERVICE_PROBE_TIMEOUT_ARGS[@]}" >"$probe_output" 2>/dev/null; then
    probe_rc=0
  else
    probe_rc="$?"
  fi
  python3 - "$probe_output" "$probe_rc" "$services" <<'PY'
import json
import sys
import time
from pathlib import Path
try:
    payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
except Exception:
    payload = {}
results = payload.get("results") if isinstance(payload, dict) and isinstance(payload.get("results"), dict) else {}
expected = [item.strip() for item in str(sys.argv[3] or "").split(",") if item.strip()]
failed = []
dns = []
degraded = []
unknown = []
for service in expected:
    if service not in results:
        unknown.append(service)
for service, row in results.items():
    if not isinstance(row, dict):
        continue
    status = str(row.get("status") or "UNKNOWN").upper()
    reason = str(row.get("reason") or row.get("error") or "").upper()
    if status in {"UNKNOWN", "STALE", "CONFLICT"}:
        unknown.append(str(service))
    elif not bool(row.get("ok")) or status not in {"OK", "WARN"}:
        failed.append(f"{service}:{status}")
    if (
        reason == "DNS_FAILURE"
        or "DNS_FAILURE" in reason
        or "COULD NOT RESOLVE" in reason
        or "NAME RESOLUTION" in reason
    ):
        dns.append(str(service))
    if status in {"DEGRADED", "DOWN_GRACE", "GRACE"}:
        degraded.append(str(service))
print("|".join([
    "OK" if int(sys.argv[2] or 1) == 0 else "FAILED",
    str(len(failed)),
    ",".join(sorted(dns)),
    ",".join(sorted(degraded)),
    ",".join(sorted(failed)),
    ",".join(sorted(set(unknown))),
    str(time.time_ns()),
]))
PY
  rm -rf "$probe_dir"
}

profile_service_trigger() {
  source_id="$1"
  profile_user="$2"
  services="$3"
  failure_count="$4"
  dns_services="$5"
  degraded_services="$6"
  failed_services="$7"
  unknown_services="$8"
  state_key="${9:-}"
  matrix_failure_fallback="${10:-0}"
  if [ -z "$state_key" ]; then
    key_hash="$(printf '%s' "${source_id}|${profile_user}" | shasum -a 256 | awk '{print substr($1,1,16)}')"
    state_key="${source_id}_profile_${key_hash}"
  fi
  previous_count="$(previous_value "${state_key}_profile_failure_count")"
  previous_count="${previous_count:-0}"
  if [ "$failure_count" -gt 0 ] 2>/dev/null; then
    current_count=$((previous_count + 1))
  else
    current_count=0
  fi
  printf '%s_profile_user=%s\n' "$state_key" "$profile_user" >> "$TMP"
  printf '%s_profile_services=%s\n' "$state_key" "$services" >> "$TMP"
  printf '%s_profile_failure_count=%s\n' "$state_key" "$current_count" >> "$TMP"
  printf '%s_profile_failed_services=%s\n' "$state_key" "$failed_services" >> "$TMP"
  printf '%s_profile_dns_services=%s\n' "$state_key" "$dns_services" >> "$TMP"
  printf '%s_profile_degraded_services=%s\n' "$state_key" "$degraded_services" >> "$TMP"
  printf '%s_profile_unknown_services=%s\n' "$state_key" "$unknown_services" >> "$TMP"
  if [ -n "$unknown_services" ]; then
    printf '%s_profile_trigger_status=STOP_SAFE_UNKNOWN\n' "$state_key" >> "$TMP"
    printf '%s_profile_trigger_class=STALE_OR_UNKNOWN_STATE\n' "$state_key" >> "$TMP"
    return 0
  fi
  [ "$failure_count" -gt 0 ] 2>/dev/null || return 0
  if [ "$current_count" -lt "$PROFILE_SERVICE_FAILURE_SAMPLES" ] 2>/dev/null; then
    printf '%s_profile_trigger_status=WAITING_REPEAT\n' "$state_key" >> "$TMP"
    return 0
  fi

  trigger_class=""
  producer_family="PROFILE_SERVICE_SUSPICION_PRODUCER"
  if [ -n "$dns_services" ]; then
    trigger_class="DNS_FAILURE"
    producer_family="DNS_SUSPICION_PRODUCER"
  elif [ "$(printf '%s' "$failed_services" | awk -F, '{print NF}')" -ge 2 ] 2>/dev/null; then
    trigger_class="MULTI_SERVICE_FAILURE"
  elif [ -n "$degraded_services" ]; then
    trigger_class="PARTIAL_CENSORSHIP"
  else
    required_ids="$(required_service_ids)"
    failed_ids="$(printf '%s' "$failed_services" | cut -d: -f1 | sed 's/,/\n/g')"
    required_hit=""
    while IFS= read -r failed_id; do
      [ -n "$failed_id" ] || continue
      case ",${required_ids}," in
        *,${failed_id},*) required_hit=1; break ;;
      esac
    done <<EOF
$failed_ids
EOF
    if [ -n "$required_hit" ] || [ "$profile_user" = "__GLOBAL__" ]; then
      trigger_class="REQUIRED_SERVICE_FAILURE"
    else
      trigger_class="OTHER_PROFILE_REQUIRED_SERVICE_FAILURE"
    fi
  fi
  [ -n "$trigger_class" ] || return 0
  now_epoch="$(date +%s)"
  previous_epoch="$(previous_value "${state_key}_profile_trigger_epoch")"
  if [ "$PROFILE_SERVICE_COOLDOWN_SEC" -gt 0 ] 2>/dev/null && [ -n "$previous_epoch" ] && [ "$previous_epoch" -ge $((now_epoch - PROFILE_SERVICE_COOLDOWN_SEC)) ] 2>/dev/null; then
    printf '%s_profile_trigger_status=SUPPRESSED_COOLDOWN\n' "$state_key" >> "$TMP"
    printf '%s_profile_trigger_family=%s\n' "$state_key" "$producer_family" >> "$TMP"
    printf '%s_profile_trigger_class=%s\n' "$state_key" "$trigger_class" >> "$TMP"
    return 0
  fi
  trigger_id="v7ps_$(printf '%s' "${source_id}|${profile_user}|${trigger_class}|${failed_services}" | shasum -a 256 | awk '{print substr($1,1,24)}')"
  trigger_event_dir="$CANONICAL_EVENT_DIR"
  trigger_service_args=()
  if [ "$profile_user" = "__GLOBAL__" ]; then
    trigger_service_args=(--services "$services")
  else
    trigger_service_args=(--shadow-trigger-profile-user "$profile_user")
  fi
  trigger_persistence_args=()
  if [ -n "$PROFILE_SERVICE_SHADOW_MATRIX_SAMPLES" ]; then
    trigger_persistence_args+=(--shadow-failure-persistence-samples "$PROFILE_SERVICE_SHADOW_MATRIX_SAMPLES")
  fi
  if [ -n "$PROFILE_SERVICE_SHADOW_MATRIX_WINDOW_SEC" ]; then
    trigger_persistence_args+=(--shadow-failure-persistence-window-seconds "$PROFILE_SERVICE_SHADOW_MATRIX_WINDOW_SEC")
  fi
  # A current canonical Matrix failure was just read above.  Re-running the
  # same Matrix confirmation here is duplicate synchronous work and can delay
  # the ordinary recovery caller by many seconds.  Reuse it only when the
  # existing governed consumer can be woken; otherwise retain the historical
  # shadow confirmation as the fail-closed fallback.
  if [ "$matrix_failure_fallback" = "1" ]; then
    trigger_status="PASS"
    trigger_rc="0"
    printf '%s_profile_matrix_confirmation=REUSED_CURRENT\n' "$state_key" >> "$TMP"
  elif [ -n "$DEFINITIVE_MATRIX_COMMAND" ]; then
    # The lightweight sentinel is only suspicion. On a failed exact profile
    # contract, ask the existing canonical Matrix writer to confirm precisely
    # those failed services before waking recovery. The former shadow-only
    # observation never updated Matrix, leaving the consumer with an old
    # failure that it correctly refused to act on.
    PROFILE_SERVICE_RECEIVER_INVOCATION_COUNT=$((PROFILE_SERVICE_RECEIVER_INVOCATION_COUNT + 1))
    confirmed_services="$(printf '%s' "$failed_services" | tr ',' '\n' | cut -d: -f1 | awk 'NF && !seen[$0]++ { values = values (values ? "," : "") $0 } END { print values }')"
    if [ -z "$confirmed_services" ]; then
      confirmed_services="$services"
    fi
    # This is the exact, role-scoped Matrix confirmation that starts an
    # ordinary recovery.  The former default Matrix lock wait (90 seconds)
    # allowed a busy advisory writer to turn a one-second failure signal
    # into a minute-long blind spot.  Keep the same canonical writer and
    # all its persistence semantics, but bound this foreground attempt to
    # its existing one-second role budget.  A contended/unknown write stays
    # fail-closed and is retried by the existing health role; it never
    # manufactures an incident or a route change.
    if "$DEFINITIVE_MATRIX_COMMAND" "$source_id" all \
      --services "$confirmed_services" \
      --state-dir "$STATE_DIR" \
      --event-dir "$CANONICAL_EVENT_DIR" \
      --failure-persistence-samples 1 \
      --failure-persistence-window-seconds 30 \
      --role-fast-timeout \
      --lock-timeout-sec 1 \
      --timeout 1 >/dev/null 2>&1; then
      trigger_status="PASS"
      trigger_rc="0"
      printf '%s_profile_matrix_confirmation=CANONICAL_EXACT_CURRENT\n' "$state_key" >> "$TMP"
    else
      trigger_rc="$?"
      trigger_status="FAILED"
    fi
  else
    PROFILE_SERVICE_RECEIVER_INVOCATION_COUNT=$((PROFILE_SERVICE_RECEIVER_INVOCATION_COUNT + 1))
    # This is an independent canonical confirmation of the exact affected
    # profile/source, not a route decision.  Its answer must fit inside the
    # live seven-second recovery budget; timeout/unknown remains fail-closed.
    if "$SHADOW_TRIGGER_COMMAND" \
      --state-dir "$STATE_DIR" \
      --event-dir "$trigger_event_dir" \
      --egresses "$source_id" \
      "${trigger_service_args[@]}" \
      --shadow-trigger-source "$source_id" \
      --shadow-trigger-class "$trigger_class" \
      --shadow-trigger-id "$trigger_id" \
      --timeout 1 \
      "${trigger_persistence_args[@]}" \
        --matrix-observation-only >/dev/null 2>&1; then
      trigger_status="PASS"
      trigger_rc="0"
    else
      trigger_rc="$?"
      trigger_status="FAILED"
    fi
  fi
  # A targeted Matrix confirmation, or reuse of the current canonical Matrix
  # failure, only opens the existing governed consumer.  This producer never
  # plans or applies a route itself.
  #
  # The lightweight batch can contain several different profile contracts on
  # one source.  Once the existing Matrix owner has independently confirmed
  # one of them, make that *fresh canonical* evidence visible to the later
  # contracts in this same ephemeral batch.  Without this refresh every
  # profile waits for another synchronous Matrix process even when its exact
  # failed service has already been confirmed.  The index is local to this
  # invocation and is discarded with the batch; Matrix remains its sole
  # persistent writer and unknown results still fail closed.
  if [ "$trigger_status" = "PASS" ] && [ "$LIGHTWEIGHT_BATCH_PRODUCER" = "1" ] && [ "$matrix_failure_fallback" != "1" ]; then
    build_fast_matrix_fresh_failure_index
  fi
  if [ "$trigger_status" = "PASS" ] && [ -n "$CONSUMER_WAKE_COMMAND" ]; then
    if wake_existing_failure_consumer "$source_id" "$completion_ns"; then
      PROFILE_SERVICE_CONSUMER_WAKE_COUNT=$((PROFILE_SERVICE_CONSUMER_WAKE_COUNT + 1))
      printf '%s_profile_consumer_wake=PASS\n' "$state_key" >> "$TMP"
    else
      printf '%s_profile_consumer_wake=STOP_SAFE\n' "$state_key" >> "$TMP"
    fi
  fi
  printf '%s_profile_trigger_status=%s\n' "$state_key" "$trigger_status" >> "$TMP"
  printf '%s_profile_trigger_family=%s\n' "$state_key" "$producer_family" >> "$TMP"
  printf '%s_profile_trigger_class=%s\n' "$state_key" "$trigger_class" >> "$TMP"
  printf '%s_profile_trigger_id=%s\n' "$state_key" "$trigger_id" >> "$TMP"
  printf '%s_profile_trigger_epoch=%s\n' "$state_key" "$now_epoch" >> "$TMP"
  printf '%s_profile_trigger_rc=%s\n' "$state_key" "$trigger_rc" >> "$TMP"
}

dns_suspicion_producer() {
  source_id="$1"
  profile_user="$2"
  services="$3"
  failure_count="$4"
  dns_services="$5"
  degraded_services="$6"
  failed_services="$7"
  unknown_services="$8"
  state_key="${9:-}"
  [ -n "$dns_services" ] || return 0
  profile_service_trigger "$source_id" "$profile_user" "$services" "$failure_count" "$dns_services" "$degraded_services" "$failed_services" "$unknown_services" "$state_key"
}

profile_service_suspicion_for_source() {
  source_id="$1"
  [ -n "$PROFILE_SERVICE_SUSPICION_COMMAND" ] || return 0
  rows="$(profile_rows_for_source "$source_id")"
  [ -n "$rows" ] || return 0
  while IFS=$'\t' read -r profile_user services; do
    [ -n "$profile_user" ] || continue
    [ -n "$services" ] || continue
    PROFILE_SERVICE_OBSERVATION_COUNT=$((PROFILE_SERVICE_OBSERVATION_COUNT + 1))
    if [ "$FAST_PRODUCER_MAX_INFLIGHT" -lt 1 ]; then
      FAST_PRODUCER_MAX_INFLIGHT=1
    fi
    probe="$(run_profile_service_probe "$source_id" "$services")"
    process_profile_service_probe "$source_id" "$profile_user" "$services" "$probe"
  done <<EOF
$rows
EOF
}

process_profile_service_probe() {
  source_id="$1"
  profile_user="$2"
  services="$3"
  probe="$4"
  state_key="${5:-}"
  matrix_failure_fallback="0"
  IFS='|' read -r probe_status failure_count dns_services degraded_services failed_services unknown_services completion_ns <<EOF
$probe
EOF
  if [ -n "$completion_ns" ] && [ "$completion_ns" -ge "$FAST_PRODUCER_STARTED_NS" ] 2>/dev/null; then
    completion_ms=$(( (completion_ns - FAST_PRODUCER_STARTED_NS) / 1000000 ))
    FAST_PRODUCER_COMPLETION_MS+=("$completion_ms")
  fi
  # A batch observation is not a reason to repeat an identical synchronous
  # Matrix confirmation.  If the Matrix already owns fresh source-bound
  # failure evidence for this contract, consume that evidence directly.  The
  # fallback remains unavailable for stale or unknown Matrix rows.
  if [ -n "$failed_services" ]; then
    matrix_failed_services="$(matrix_failed_services_for_source "$source_id" "$services")"
    if [ -n "$matrix_failed_services" ]; then
      failed_services="$matrix_failed_services"
      failure_count="1"
      matrix_failure_fallback="1"
      printf '%s_profile_matrix_failure_fallback=USED\n' "${state_key:-${source_id}_profile}" >> "$TMP"
    fi
  fi
  if [ -n "$unknown_services" ] && [ -z "$failed_services" ]; then
    # A stale Matrix failure is never sufficient evidence for a move.  It is
    # only a bounded hint that the existing Matrix probe owner should refresh
    # the exact profile services now.  This repairs the no-timer lifecycle
    # without weakening freshness or creating a second state owner.
    stale_matrix_failed_services="$(matrix_stale_failed_services_for_source "$source_id" "$services")"
    if [ -n "$stale_matrix_failed_services" ]; then
      # This is the ordinary-recovery critical caller.  A stale Matrix record
      # may request its normal reconciliation, but must not synchronously
      # repeat a full network probe for every profile here: that turned a
      # one-second probe budget into 7..24 seconds.  UNKNOWN remains
      # fail-closed; only a fresh Matrix failure reaches the recovery consumer.
      if [ "$LIGHTWEIGHT_BATCH_PRODUCER" = "1" ]; then
        printf '%s_profile_targeted_revalidation=DEFERRED_STALE_MATRIX\n' "$state_key" >> "$TMP"
      else
        now_epoch="$(date +%s)"
        previous_revalidation_epoch="$(previous_value "${state_key}_profile_targeted_revalidation_epoch")"
        targeted_revalidation_cooldown_sec="${PROFILE_SERVICE_COOLDOWN_SEC:-5}"
        if [ "$targeted_revalidation_cooldown_sec" -lt 1 ] 2>/dev/null; then
          targeted_revalidation_cooldown_sec=1
        fi
        if [ -z "$previous_revalidation_epoch" ] || [ "$previous_revalidation_epoch" -lt $((now_epoch - targeted_revalidation_cooldown_sec)) ] 2>/dev/null; then
          targeted_probe="$(run_profile_service_probe "$source_id" "$services")"
          IFS='|' read -r targeted_status targeted_failure_count targeted_dns_services targeted_degraded_services targeted_failed_services targeted_unknown_services targeted_completion_ns <<EOF
$targeted_probe
EOF
          if [ -z "$targeted_unknown_services" ]; then
            failure_count="$targeted_failure_count"
            dns_services="$targeted_dns_services"
            degraded_services="$targeted_degraded_services"
            failed_services="$targeted_failed_services"
            unknown_services=""
            printf '%s_profile_targeted_revalidation=USED\n' "$state_key" >> "$TMP"
          fi
          printf '%s_profile_targeted_revalidation_epoch=%s\n' "$state_key" "$now_epoch" >> "$TMP"
        else
          printf '%s_profile_targeted_revalidation=COOLDOWN\n' "$state_key" >> "$TMP"
        fi
      fi
    fi
  fi
  if [ -n "$unknown_services" ] && [ -z "$failed_services" ]; then
    # The bounded batch sentinel may legitimately return no per-service result
    # when its deadline is exhausted.  Do not treat that as a fresh failure,
    # but do consume a recent canonical Matrix failure as the exact evidence
    # for waking the existing failure consumer.  The consumer revalidates
    # source, scope, target, authority and Packet/Lease gates before any move.
    matrix_failed_services="$(matrix_failed_services_for_source "$source_id" "$services")"
    if [ -n "$matrix_failed_services" ]; then
      failed_services="$matrix_failed_services"
      failure_count="1"
      unknown_services=""
      matrix_failure_fallback="1"
      printf '%s_profile_matrix_failure_fallback=USED\n' "${state_key:-${source_id}_profile}" >> "$TMP"
    fi
  fi
  if [ -n "$dns_services" ]; then
    dns_suspicion_producer "$source_id" "$profile_user" "$services" "$failure_count" "$dns_services" "$degraded_services" "$failed_services" "$unknown_services" "$state_key"
  else
  profile_service_trigger "$source_id" "$profile_user" "$services" "$failure_count" "$dns_services" "$degraded_services" "$failed_services" "$unknown_services" "$state_key" "$matrix_failure_fallback"
  fi
}

