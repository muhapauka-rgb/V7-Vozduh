#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="/opt/v7/egress/state"
OUT=""
SHADOW_TRIGGER_COMMAND=""
SHADOW_TRIGGER_EGRESS=""
SHADOW_TRIGGER_SERVICES=""
SHADOW_TRIGGER_PROFILE_USER=""
SHADOW_TRIGGER_EVENT_DIR=""
SHADOW_TRIGGER_COOLDOWN_SEC="60"
PROFILE_SERVICE_SUSPICION_COMMAND=""
PROFILE_SERVICE_FAILURE_SAMPLES="2"
PROFILE_SERVICE_COOLDOWN_SEC="60"
PROFILE_CONTRACTS_FILE=""
FAST_PRODUCER_ONLY="0"
OUTPUT_EXPLICIT="0"
PROFILE_SERVICE_SHADOW_MATRIX_SAMPLES=""
PROFILE_SERVICE_SHADOW_MATRIX_WINDOW_SEC=""
PROFILE_SERVICE_OBSERVATION_COUNT=0
PROFILE_SERVICE_RECEIVER_INVOCATION_COUNT=0
PROFILE_SERVICE_CONTRACT_COUNT=0
PROFILE_SERVICE_ACTIVE_SOURCE_COUNT=0
FAST_PRODUCER_CONCURRENCY="1"
FAST_PRODUCER_MAX_INFLIGHT=0
FAST_PRODUCER_STARTED_NS="0"
FAST_PRODUCER_COMPLETION_MS=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --state-dir)
      STATE_DIR="$2"
      shift 2
      ;;
    --output)
      OUT="$2"
      OUTPUT_EXPLICIT="1"
      shift 2
      ;;
    --fast-producer-only)
      FAST_PRODUCER_ONLY="1"
      shift
      ;;
    --fast-producer-concurrency)
      FAST_PRODUCER_CONCURRENCY="$2"
      shift 2
      ;;
    --shadow-trigger-command)
      SHADOW_TRIGGER_COMMAND="$2"
      shift 2
      ;;
    --shadow-trigger-egress)
      SHADOW_TRIGGER_EGRESS="$2"
      shift 2
      ;;
    --shadow-trigger-services)
      SHADOW_TRIGGER_SERVICES="$2"
      shift 2
      ;;
    --shadow-trigger-profile-user)
      SHADOW_TRIGGER_PROFILE_USER="$2"
      shift 2
      ;;
    --shadow-trigger-event-dir)
      SHADOW_TRIGGER_EVENT_DIR="$2"
      shift 2
      ;;
    --shadow-trigger-cooldown-sec)
      SHADOW_TRIGGER_COOLDOWN_SEC="$2"
      shift 2
      ;;
    --profile-service-suspicion-command)
      PROFILE_SERVICE_SUSPICION_COMMAND="$2"
      shift 2
      ;;
    --profile-service-failure-samples)
      PROFILE_SERVICE_FAILURE_SAMPLES="$2"
      shift 2
      ;;
    --profile-service-cooldown-sec)
      PROFILE_SERVICE_COOLDOWN_SEC="$2"
      shift 2
      ;;
    --profile-service-shadow-matrix-samples)
      PROFILE_SERVICE_SHADOW_MATRIX_SAMPLES="$2"
      shift 2
      ;;
    --profile-service-shadow-matrix-window-sec)
      PROFILE_SERVICE_SHADOW_MATRIX_WINDOW_SEC="$2"
      shift 2
      ;;
    *)
      echo "unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

if [ -n "$SHADOW_TRIGGER_COMMAND" ] && { [ -n "$SHADOW_TRIGGER_EGRESS" ] || [ -n "$SHADOW_TRIGGER_SERVICES" ] || [ -n "$SHADOW_TRIGGER_PROFILE_USER" ]; }; then
  case "$SHADOW_TRIGGER_COOLDOWN_SEC" in
    ''|*[!0-9]*)
      echo "invalid --shadow-trigger-cooldown-sec" >&2
      exit 2
      ;;
  esac
  if [ -z "$SHADOW_TRIGGER_EGRESS" ] || { [ -z "$SHADOW_TRIGGER_SERVICES" ] && [ -z "$SHADOW_TRIGGER_PROFILE_USER" ]; } || { [ -n "$SHADOW_TRIGGER_SERVICES" ] && [ -n "$SHADOW_TRIGGER_PROFILE_USER" ]; }; then
    echo "shadow trigger requires exact egress and exactly one service source" >&2
    exit 2
  fi
fi

if [ -n "$PROFILE_SERVICE_SUSPICION_COMMAND" ]; then
  case "$PROFILE_SERVICE_FAILURE_SAMPLES" in
    ''|*[!0-9]*)
      echo "invalid --profile-service-failure-samples" >&2
      exit 2
      ;;
  esac
  case "$PROFILE_SERVICE_COOLDOWN_SEC" in
    ''|*[!0-9]*)
      echo "invalid --profile-service-cooldown-sec" >&2
      exit 2
      ;;
  esac
  if [ -z "$SHADOW_TRIGGER_COMMAND" ]; then
    echo "profile service suspicion requires existing Matrix receiver" >&2
    exit 2
  fi
fi

if [ "$FAST_PRODUCER_ONLY" = "1" ] && { [ -z "$PROFILE_SERVICE_SUSPICION_COMMAND" ] || [ "$OUTPUT_EXPLICIT" != "1" ]; }; then
  echo "fast producer only requires profile suspicion command and explicit output" >&2
  exit 2
fi

case "$FAST_PRODUCER_CONCURRENCY" in
  ''|*[!0-9]*) echo "invalid --fast-producer-concurrency" >&2; exit 2 ;;
esac
if [ "$FAST_PRODUCER_CONCURRENCY" -lt 1 ] || [ "$FAST_PRODUCER_CONCURRENCY" -gt 8 ]; then
  echo "--fast-producer-concurrency must be between 1 and 8" >&2
  exit 2
fi
if [ "$FAST_PRODUCER_CONCURRENCY" -gt 1 ] && [ "$FAST_PRODUCER_ONLY" != "1" ]; then
  echo "parallel FAST producer execution requires --fast-producer-only" >&2
  exit 2
fi

for profile_shadow_value in "$PROFILE_SERVICE_SHADOW_MATRIX_SAMPLES" "$PROFILE_SERVICE_SHADOW_MATRIX_WINDOW_SEC"; do
  case "$profile_shadow_value" in
    '') ;;
    *[!0-9]*) echo "invalid controlled Matrix persistence override" >&2; exit 2 ;;
  esac
done
if { [ -n "$PROFILE_SERVICE_SHADOW_MATRIX_SAMPLES" ] || [ -n "$PROFILE_SERVICE_SHADOW_MATRIX_WINDOW_SEC" ]; } && [ "$FAST_PRODUCER_ONLY" != "1" ]; then
  echo "controlled Matrix persistence override requires --fast-producer-only" >&2
  exit 2
fi

REG="${STATE_DIR}/egress.registry"
SUM="${STATE_DIR}/summary.state"
OUT="${OUT:-${STATE_DIR}/egress-diagnose.state}"
TMP="${OUT}.tmp.$$"

previous_value() {
  key="$1"
  grep "^${key}=" "$OUT" 2>/dev/null | tail -n1 | cut -d= -f2- || true
}

shadow_trigger_for_reason() {
  id="$1"
  reason="$2"
  severity="$3"
  [ -n "$SHADOW_TRIGGER_COMMAND" ] || return 0
  [ "$id" = "$SHADOW_TRIGGER_EGRESS" ] || return 0
  [ "$severity" = "FAIL" ] || return 0

  trigger_class=""
  case "$reason" in
    curl_failed_and_handshake_stale|curl_failed_and_handshake_unsupported)
      trigger_class="TUNNEL_UP_INTERNET_DEAD"
      ;;
    *)
      return 0
      ;;
  esac

  now_epoch="$(date +%s)"
  previous_epoch="$(previous_value "${id}_shadow_trigger_epoch")"
  if [ -n "$previous_epoch" ] && [ "$previous_epoch" -ge $((now_epoch - SHADOW_TRIGGER_COOLDOWN_SEC)) ] 2>/dev/null; then
    printf '%s_shadow_trigger_status=SUPPRESSED_COOLDOWN\n' "$id" >> "$TMP"
    printf '%s_shadow_trigger_class=%s\n' "$id" "$trigger_class" >> "$TMP"
    return 0
  fi

  trigger_id="v7st_$(printf '%s' "${id}|${trigger_class}|${reason}" | shasum -a 256 | awk '{print substr($1,1,24)}')"
  trigger_event_dir="${SHADOW_TRIGGER_EVENT_DIR:-${STATE_DIR}/../events}"
  trigger_service_args=()
  if [ -n "$SHADOW_TRIGGER_PROFILE_USER" ]; then
    trigger_service_args=(--shadow-trigger-profile-user "$SHADOW_TRIGGER_PROFILE_USER")
  else
    trigger_service_args=(--services "$SHADOW_TRIGGER_SERVICES")
  fi
  if "$SHADOW_TRIGGER_COMMAND" \
      --state-dir "$STATE_DIR" \
      --event-dir "$trigger_event_dir" \
      --egresses "$id" \
      "${trigger_service_args[@]}" \
      --shadow-trigger-source "$id" \
      --shadow-trigger-class "$trigger_class" \
      --shadow-trigger-id "$trigger_id" \
      --matrix-observation-only >/dev/null 2>&1; then
    trigger_status="PASS"
    trigger_rc="0"
  else
    trigger_rc="$?"
    trigger_status="FAILED"
  fi
  printf '%s_shadow_trigger_status=%s\n' "$id" "$trigger_status" >> "$TMP"
  printf '%s_shadow_trigger_class=%s\n' "$id" "$trigger_class" >> "$TMP"
  printf '%s_shadow_trigger_id=%s\n' "$id" "$trigger_id" >> "$TMP"
  printf '%s_shadow_trigger_epoch=%s\n' "$id" "$now_epoch" >> "$TMP"
  printf '%s_shadow_trigger_rc=%s\n' "$id" "$trigger_rc" >> "$TMP"
}

build_active_profile_contracts() {
  python3 - "$STATE_DIR/users.registry" "$STATE_DIR/service-preferences.json" "$REG" <<'PY'
import json
import sys
from pathlib import Path

users_path, prefs_path, registry_path = map(Path, sys.argv[1:])
try:
    users_lines = users_path.read_text(encoding="utf-8", errors="replace").splitlines()
except OSError:
    users_lines = []
try:
    prefs = json.loads(prefs_path.read_text(encoding="utf-8"))
except Exception:
    prefs = {}
if not isinstance(prefs, dict):
    prefs = {}
try:
    registry_lines = registry_path.read_text(encoding="utf-8", errors="replace").splitlines()
except OSError:
    registry_lines = []
registry = {}
for line in registry_lines:
    fields = {}
    for part in line.split():
        if "=" in part:
            key, value = part.split("=", 1)
            fields[key.strip()] = value.strip()
    source = str(fields.get("id") or "").strip()
    if source:
        registry[source] = (
            str(fields.get("interface") or "").strip(),
            str(fields.get("enabled", "1")).strip(),
        )
users_prefs = prefs.get("users") if isinstance(prefs.get("users"), dict) else {}
active_sources = {}
for line in users_lines:
    line = line.strip()
    if not line or line.startswith("#"):
        continue
    fields = {}
    for part in line.split():
        if "=" in part:
            key, value = part.split("=", 1)
            fields[key.strip()] = value.strip()
    source = str(fields.get("current") or "").strip()
    if not source or fields.get("enabled", "1").lower() in {"0", "false", "no"}:
        continue
    identity = str(fields.get("ip") or "").strip()
    active_sources.setdefault(source, set()).add(identity)

global_values = prefs.get("required_services") or []
if isinstance(global_values, str):
    global_values = [item.strip() for item in global_values.split(",") if item.strip()]
global_services = tuple(sorted({str(item).strip() for item in global_values if str(item).strip() and str(item).lower() != "all"})) if isinstance(global_values, list) else ()

for source, identities in sorted(active_sources.items()):
    contracts = {}
    for identity in sorted(identities):
        row = users_prefs.get(identity) if identity else None
        if not isinstance(row, dict):
            continue
        values = row.get("required_services") or row.get("services") or []
        if isinstance(values, str):
            values = [item.strip() for item in values.split(",") if item.strip()]
        if not isinstance(values, list):
            continue
        services = tuple(sorted({str(item).strip() for item in values if str(item).strip() and str(item).lower() != "all"}))
        if services:
            contracts.setdefault(services, set()).add(identity)
    if not contracts and global_services:
        contracts[global_services] = {"__GLOBAL__"}
    for services, profiles in sorted(contracts.items()):
        # The first canonical profile is only an anchor for the existing
        # receiver.  The observation itself is deduplicated by source + exact
        # service contract, never by user count.
        interface, enabled = registry.get(source, ("", "0"))
        print(f"{source}\t{sorted(profiles)[0]}\t{','.join(services)}\t{len(profiles)}\t{interface}\t{enabled}")
PY
}

profile_rows_for_source() {
  source_id="$1"
  [ -n "$PROFILE_CONTRACTS_FILE" ] && [ -r "$PROFILE_CONTRACTS_FILE" ] || return 0
  awk -F '\t' -v source="$source_id" '$1 == source {print $2 "\t" $3}' "$PROFILE_CONTRACTS_FILE"
}

required_service_ids() {
  python3 - "$STATE_DIR/service-preferences.json" <<'PY'
import json
import sys
from pathlib import Path
try:
    value = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8")).get("required_services", [])
except Exception:
    value = []
if isinstance(value, str):
    value = [item.strip() for item in value.split(",") if item.strip()]
if isinstance(value, list):
    print(",".join(sorted({str(item).strip() for item in value if str(item).strip()})))
PY
}

run_profile_service_probe() {
  source_id="$1"
  services="$2"
  probe_dir="$(mktemp -d "${TMPDIR:-/tmp}/v7-profile-probe.XXXXXX")"
  probe_output="$probe_dir/result.json"
  mkdir -p "$probe_dir/events"
  if "$PROFILE_SERVICE_SUSPICION_COMMAND" "$source_id" all \
      --services "$services" \
      --state-dir "$STATE_DIR" \
      --matrix-file "$probe_dir/service-matrix.json" \
      --event-dir "$probe_dir/events" \
      --probe-observation-only \
      --failure-persistence-samples 1 \
      --failure-persistence-window-seconds 30 \
      --timeout 5 >"$probe_output" 2>/dev/null; then
    probe_rc=0
  else
    probe_rc="$?"
  fi
  python3 - "$probe_output" "$probe_rc" "$services" <<'PY'
import json
import sys
import time
from pathlib import Path
try:
    payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
except Exception:
    payload = {}
results = payload.get("results") if isinstance(payload, dict) and isinstance(payload.get("results"), dict) else {}
expected = [item.strip() for item in str(sys.argv[3] or "").split(",") if item.strip()]
failed = []
dns = []
degraded = []
unknown = []
for service in expected:
    if service not in results:
        unknown.append(service)
for service, row in results.items():
    if not isinstance(row, dict):
        continue
    status = str(row.get("status") or "UNKNOWN").upper()
    reason = str(row.get("reason") or row.get("error") or "").upper()
    if status in {"UNKNOWN", "STALE", "CONFLICT"}:
        unknown.append(str(service))
    elif not bool(row.get("ok")) or status not in {"OK", "WARN"}:
        failed.append(f"{service}:{status}")
    if (
        reason == "DNS_FAILURE"
        or "DNS_FAILURE" in reason
        or "COULD NOT RESOLVE" in reason
        or "NAME RESOLUTION" in reason
    ):
        dns.append(str(service))
    if status in {"DEGRADED", "DOWN_GRACE", "GRACE"}:
        degraded.append(str(service))
print("|".join([
    "OK" if int(sys.argv[2] or 1) == 0 else "FAILED",
    str(len(failed)),
    ",".join(sorted(dns)),
    ",".join(sorted(degraded)),
    ",".join(sorted(failed)),
    ",".join(sorted(set(unknown))),
    str(time.time_ns()),
]))
PY
  rm -rf "$probe_dir"
}

profile_service_trigger() {
  source_id="$1"
  profile_user="$2"
  services="$3"
  failure_count="$4"
  dns_services="$5"
  degraded_services="$6"
  failed_services="$7"
  unknown_services="$8"
  key_hash="$(printf '%s' "${source_id}|${profile_user}" | shasum -a 256 | awk '{print substr($1,1,16)}')"
  state_key="${source_id}_profile_${key_hash}"
  previous_count="$(previous_value "${state_key}_profile_failure_count")"
  previous_count="${previous_count:-0}"
  if [ "$failure_count" -gt 0 ] 2>/dev/null; then
    current_count=$((previous_count + 1))
  else
    current_count=0
  fi
  printf '%s_profile_user=%s\n' "$state_key" "$profile_user" >> "$TMP"
  printf '%s_profile_services=%s\n' "$state_key" "$services" >> "$TMP"
  printf '%s_profile_failure_count=%s\n' "$state_key" "$current_count" >> "$TMP"
  printf '%s_profile_failed_services=%s\n' "$state_key" "$failed_services" >> "$TMP"
  printf '%s_profile_dns_services=%s\n' "$state_key" "$dns_services" >> "$TMP"
  printf '%s_profile_degraded_services=%s\n' "$state_key" "$degraded_services" >> "$TMP"
  printf '%s_profile_unknown_services=%s\n' "$state_key" "$unknown_services" >> "$TMP"
  if [ -n "$unknown_services" ]; then
    printf '%s_profile_trigger_status=STOP_SAFE_UNKNOWN\n' "$state_key" >> "$TMP"
    printf '%s_profile_trigger_class=STALE_OR_UNKNOWN_STATE\n' "$state_key" >> "$TMP"
    return 0
  fi
  [ "$failure_count" -gt 0 ] 2>/dev/null || return 0
  if [ "$current_count" -lt "$PROFILE_SERVICE_FAILURE_SAMPLES" ] 2>/dev/null; then
    printf '%s_profile_trigger_status=WAITING_REPEAT\n' "$state_key" >> "$TMP"
    return 0
  fi

  trigger_class=""
  producer_family="PROFILE_SERVICE_SUSPICION_PRODUCER"
  if [ -n "$dns_services" ]; then
    trigger_class="DNS_FAILURE"
    producer_family="DNS_SUSPICION_PRODUCER"
  elif [ "$(printf '%s' "$failed_services" | awk -F, '{print NF}')" -ge 2 ] 2>/dev/null; then
    trigger_class="MULTI_SERVICE_FAILURE"
  elif [ -n "$degraded_services" ]; then
    trigger_class="PARTIAL_CENSORSHIP"
  else
    required_ids="$(required_service_ids)"
    failed_ids="$(printf '%s' "$failed_services" | cut -d: -f1 | sed 's/,/\n/g')"
    required_hit=""
    while IFS= read -r failed_id; do
      [ -n "$failed_id" ] || continue
      case ",${required_ids}," in
        *,${failed_id},*) required_hit=1; break ;;
      esac
    done <<EOF
$failed_ids
EOF
    if [ -n "$required_hit" ] || [ "$profile_user" = "__GLOBAL__" ]; then
      trigger_class="REQUIRED_SERVICE_FAILURE"
    else
      trigger_class="OTHER_PROFILE_REQUIRED_SERVICE_FAILURE"
    fi
  fi
  [ -n "$trigger_class" ] || return 0
  now_epoch="$(date +%s)"
  previous_epoch="$(previous_value "${state_key}_profile_trigger_epoch")"
  if [ "$PROFILE_SERVICE_COOLDOWN_SEC" -gt 0 ] 2>/dev/null && [ -n "$previous_epoch" ] && [ "$previous_epoch" -ge $((now_epoch - PROFILE_SERVICE_COOLDOWN_SEC)) ] 2>/dev/null; then
    printf '%s_profile_trigger_status=SUPPRESSED_COOLDOWN\n' "$state_key" >> "$TMP"
    printf '%s_profile_trigger_family=%s\n' "$state_key" "$producer_family" >> "$TMP"
    printf '%s_profile_trigger_class=%s\n' "$state_key" "$trigger_class" >> "$TMP"
    return 0
  fi
  trigger_id="v7ps_$(printf '%s' "${source_id}|${profile_user}|${trigger_class}|${failed_services}" | shasum -a 256 | awk '{print substr($1,1,24)}')"
  trigger_event_dir="${SHADOW_TRIGGER_EVENT_DIR:-${STATE_DIR}/../events}"
  trigger_service_args=()
  if [ "$profile_user" = "__GLOBAL__" ]; then
    trigger_service_args=(--services "$services")
  else
    trigger_service_args=(--shadow-trigger-profile-user "$profile_user")
  fi
  trigger_persistence_args=()
  if [ -n "$PROFILE_SERVICE_SHADOW_MATRIX_SAMPLES" ]; then
    trigger_persistence_args+=(--shadow-failure-persistence-samples "$PROFILE_SERVICE_SHADOW_MATRIX_SAMPLES")
  fi
  if [ -n "$PROFILE_SERVICE_SHADOW_MATRIX_WINDOW_SEC" ]; then
    trigger_persistence_args+=(--shadow-failure-persistence-window-seconds "$PROFILE_SERVICE_SHADOW_MATRIX_WINDOW_SEC")
  fi
  PROFILE_SERVICE_RECEIVER_INVOCATION_COUNT=$((PROFILE_SERVICE_RECEIVER_INVOCATION_COUNT + 1))
  if "$SHADOW_TRIGGER_COMMAND" \
      --state-dir "$STATE_DIR" \
      --event-dir "$trigger_event_dir" \
      --egresses "$source_id" \
      "${trigger_service_args[@]}" \
      --shadow-trigger-source "$source_id" \
      --shadow-trigger-class "$trigger_class" \
      --shadow-trigger-id "$trigger_id" \
      "${trigger_persistence_args[@]}" \
      --matrix-observation-only >/dev/null 2>&1; then
    trigger_status="PASS"
    trigger_rc="0"
  else
    trigger_rc="$?"
    trigger_status="FAILED"
  fi
  printf '%s_profile_trigger_status=%s\n' "$state_key" "$trigger_status" >> "$TMP"
  printf '%s_profile_trigger_family=%s\n' "$state_key" "$producer_family" >> "$TMP"
  printf '%s_profile_trigger_class=%s\n' "$state_key" "$trigger_class" >> "$TMP"
  printf '%s_profile_trigger_id=%s\n' "$state_key" "$trigger_id" >> "$TMP"
  printf '%s_profile_trigger_epoch=%s\n' "$state_key" "$now_epoch" >> "$TMP"
  printf '%s_profile_trigger_rc=%s\n' "$state_key" "$trigger_rc" >> "$TMP"
}

dns_suspicion_producer() {
  source_id="$1"
  profile_user="$2"
  services="$3"
  failure_count="$4"
  dns_services="$5"
  degraded_services="$6"
  failed_services="$7"
  unknown_services="$8"
  [ -n "$dns_services" ] || return 0
  profile_service_trigger "$source_id" "$profile_user" "$services" "$failure_count" "$dns_services" "$degraded_services" "$failed_services" "$unknown_services"
}

profile_service_suspicion_for_source() {
  source_id="$1"
  [ -n "$PROFILE_SERVICE_SUSPICION_COMMAND" ] || return 0
  rows="$(profile_rows_for_source "$source_id")"
  [ -n "$rows" ] || return 0
  while IFS=$'\t' read -r profile_user services; do
    [ -n "$profile_user" ] || continue
    [ -n "$services" ] || continue
    PROFILE_SERVICE_OBSERVATION_COUNT=$((PROFILE_SERVICE_OBSERVATION_COUNT + 1))
    if [ "$FAST_PRODUCER_MAX_INFLIGHT" -lt 1 ]; then
      FAST_PRODUCER_MAX_INFLIGHT=1
    fi
    probe="$(run_profile_service_probe "$source_id" "$services")"
    process_profile_service_probe "$source_id" "$profile_user" "$services" "$probe"
  done <<EOF
$rows
EOF
}

process_profile_service_probe() {
  source_id="$1"
  profile_user="$2"
  services="$3"
  probe="$4"
  IFS='|' read -r probe_status failure_count dns_services degraded_services failed_services unknown_services completion_ns <<EOF
$probe
EOF
  if [ -n "$completion_ns" ] && [ "$completion_ns" -ge "$FAST_PRODUCER_STARTED_NS" ] 2>/dev/null; then
    completion_ms=$(( (completion_ns - FAST_PRODUCER_STARTED_NS) / 1000000 ))
    FAST_PRODUCER_COMPLETION_MS+=("$completion_ms")
  fi
  if [ -n "$dns_services" ]; then
    dns_suspicion_producer "$source_id" "$profile_user" "$services" "$failure_count" "$dns_services" "$degraded_services" "$failed_services" "$unknown_services"
  else
    profile_service_trigger "$source_id" "$profile_user" "$services" "$failure_count" "$dns_services" "$degraded_services" "$failed_services" "$unknown_services"
  fi
}

write_fast_producer_telemetry() {
  printf 'fast_producer_active_source_count=%s\n' "$PROFILE_SERVICE_ACTIVE_SOURCE_COUNT" >> "$TMP"
  printf 'fast_producer_distinct_contract_count=%s\n' "$PROFILE_SERVICE_CONTRACT_COUNT" >> "$TMP"
  printf 'fast_producer_observation_count=%s\n' "$PROFILE_SERVICE_OBSERVATION_COUNT" >> "$TMP"
  printf 'fast_producer_receiver_invocation_count=%s\n' "$PROFILE_SERVICE_RECEIVER_INVOCATION_COUNT" >> "$TMP"
  printf 'fast_producer_concurrency_cap=%s\n' "$FAST_PRODUCER_CONCURRENCY" >> "$TMP"
  printf 'fast_producer_max_inflight=%s\n' "$FAST_PRODUCER_MAX_INFLIGHT" >> "$TMP"
  completion_count="${#FAST_PRODUCER_COMPLETION_MS[@]}"
  printf 'fast_producer_completed_contract_count=%s\n' "$completion_count" >> "$TMP"
  if [ "$completion_count" -gt 0 ]; then
    sorted_completion_ms="$(printf '%s\n' "${FAST_PRODUCER_COMPLETION_MS[@]}" | sort -n)"
    first_completion_ms="$(printf '%s\n' "$sorted_completion_ms" | sed -n '1p')"
    p50_index=$(( (completion_count + 1) / 2 ))
    p95_index=$(( (completion_count * 95 + 99) / 100 ))
    p50_completion_ms="$(printf '%s\n' "$sorted_completion_ms" | sed -n "${p50_index}p")"
    p95_completion_ms="$(printf '%s\n' "$sorted_completion_ms" | sed -n "${p95_index}p")"
    max_completion_ms="$(printf '%s\n' "$sorted_completion_ms" | sed -n "${completion_count}p")"
    printf 'fast_producer_first_contract_result_ms=%s\n' "$first_completion_ms" >> "$TMP"
    printf 'fast_producer_p50_contract_result_ms=%s\n' "$p50_completion_ms" >> "$TMP"
    printf 'fast_producer_p95_contract_result_ms=%s\n' "$p95_completion_ms" >> "$TMP"
    printf 'fast_producer_max_contract_result_ms=%s\n' "$max_completion_ms" >> "$TMP"
  fi
}

get_field() {
  key="$1"
  line="$2"
  printf '%s\n' "$line" | tr ' ' '\n' | awk -F= -v k="$key" '$1 == k {print substr($0, length(k) + 2); exit}'
}

summary_value() {
  key="$1"
  grep "^${key}=" "$SUM" 2>/dev/null | tail -n1 | cut -d= -f2- || true
}

parse_handshake_text_age() {
  hs="$1"
  python3 - "$hs" <<'PY'
import re
import sys

s = sys.argv[1]
if not s or s.strip().lower() in {"never", "(none)"}:
    print("999999")
    raise SystemExit

total = 0
for n, unit in re.findall(r'(\d+)\s+(day|hour|minute|second)', s):
    n = int(n)
    if unit == "day":
        total += n * 86400
    elif unit == "hour":
        total += n * 3600
    elif unit == "minute":
        total += n * 60
    elif unit == "second":
        total += n
print(total if total else 999999)
PY
}

wg_handshake_age_seconds() {
  iface="$1"
  now="$(date +%s)"
  latest="$(wg show "$iface" latest-handshakes 2>/dev/null | awk 'NF >= 2 && $2 ~ /^[0-9]+$/ {print $2; exit}' || true)"
  if [ -n "$latest" ] && [ "$latest" -gt 0 ] 2>/dev/null; then
    age=$((now - latest))
    if [ "$age" -lt 0 ]; then
      echo "0"
    else
      echo "$age"
    fi
    return
  fi

  hs="$(wg show "$iface" 2>/dev/null | grep 'latest handshake' | sed 's/.*latest handshake: //' || true)"
  if [ -z "$hs" ]; then
    echo "999999"
    return
  fi
  parse_handshake_text_age "$hs"
}

awg_handshake_age_seconds() {
  iface="$1"
  hs="$(awg show "$iface" 2>/dev/null | grep 'latest handshake' | sed 's/.*latest handshake: //' || true)"
  if [ -z "$hs" ]; then
    echo "999999"
    return
  fi
  parse_handshake_text_age "$hs"
}

handshake_age_seconds() {
  protocol="$1"
  iface="$2"
  case "$protocol" in
    wireguard|wg)
      wg_handshake_age_seconds "$iface"
      ;;
    amneziawg|awg)
      awg_handshake_age_seconds "$iface"
      ;;
    *)
      echo "unsupported"
      ;;
  esac
}

interface_up() {
  iface="$1"
  ip link show "$iface" 2>/dev/null | grep -q 'UP,LOWER_UP'
}

diagnose_row() {
  id="$1"
  protocol="$2"
  iface="$3"
  enabled="$4"
  code="$(summary_value "${id}_code")"
  code="${code:-200}"

  severity="OK"
  reason="OK"
  detail="protocol=${protocol}"

  if [ "$enabled" != "1" ]; then
    severity="DISABLED"
    reason="egress_disabled"
    detail="protocol=${protocol}"
  elif ! interface_up "$iface"; then
    severity="FAIL"
    reason="interface_down_or_missing"
    detail="protocol=${protocol}"
  else
    age="$(handshake_age_seconds "$protocol" "$iface")"
    if [ "$age" = "unsupported" ]; then
      if [ "$code" = "200" ]; then
        severity="SUSPECT"
        reason="handshake_unsupported_for_protocol_${protocol}"
      else
        severity="FAIL"
        reason="curl_failed_and_handshake_unsupported"
      fi
      detail="protocol=${protocol}"
    elif [ "$age" -ge 300 ] 2>/dev/null; then
      if [ "$code" = "200" ]; then
        if [ "$protocol" = "wireguard" ] || [ "$protocol" = "wg" ]; then
          severity="WARN"
          reason="curl_ok_but_wireguard_handshake_unavailable"
        else
          severity="SUSPECT"
          reason="curl_ok_but_handshake_stale"
        fi
      else
        severity="FAIL"
        reason="curl_failed_and_handshake_stale"
      fi
      detail="handshake_age_seconds=${age}"
    else
      severity="OK"
      reason="OK"
      detail="handshake_age_seconds=${age}"
    fi
  fi

  {
    printf '%s_diagnose_reason=%s\n' "$id" "$reason"
    printf '%s_diagnose_severity=%s\n' "$id" "$severity"
  printf '%s_diagnose_detail=%s\n' "$id" "$detail"
  } >> "$TMP"
  shadow_trigger_for_reason "$id" "$reason" "$severity"
}

build_ready_fast_contract_workset() {
  # This is an immutable, per-process work list.  It is neither persisted nor a
  # state/registry owner: canonical source/profile truth remains in the two
  # existing state files used to build it.
  [ -n "$PROFILE_SERVICE_SUSPICION_COMMAND" ] || return 0
  [ -r "$PROFILE_CONTRACTS_FILE" ] || return 0
  previous_source=""
  source_ready="0"
  last_checked_iface=""
  last_checked_iface_ready="0"
  while IFS=$'\t' read -r source_id profile_user services _profile_count iface enabled; do
    [ -n "$source_id" ] || continue
    if [ "$source_id" != "$previous_source" ]; then
      previous_source="$source_id"
      source_ready="0"
      enabled="${enabled:-1}"
      [ "$enabled" = "1" ] || continue
      [ -n "$iface" ] || continue
      if [ "$iface" = "$last_checked_iface" ]; then
        source_ready="$last_checked_iface_ready"
      elif interface_up "$iface"; then
        source_ready="1"
        last_checked_iface="$iface"
        last_checked_iface_ready="1"
      else
        last_checked_iface="$iface"
        last_checked_iface_ready="0"
      fi
    fi
    [ "$source_ready" = "1" ] || continue
    printf '%s\t%s\t%s\n' "$source_id" "$profile_user" "$services"
  done < "$PROFILE_CONTRACTS_FILE"
}

run_parallel_active_profile_suspicion_cycle() {
  work_dir="$(mktemp -d "${TMPDIR:-/tmp}/v7-fast-contracts.XXXXXX")"
  work_file="$work_dir/active-contract-set.tsv"
  # The set is intentionally temporary and discarded before the owner returns.
  build_ready_fast_contract_workset > "$work_file"

  work_sources=()
  work_profiles=()
  work_services=()
  while IFS=$'\t' read -r source_id profile_user services; do
    [ -n "$source_id" ] || continue
    [ -n "$profile_user" ] || continue
    [ -n "$services" ] || continue
    work_sources+=("$source_id")
    work_profiles+=("$profile_user")
    work_services+=("$services")
  done < "$work_file"

  total="${#work_sources[@]}"
  [ "$total" -gt 0 ] || { rm -rf "$work_dir"; return 0; }
  probe_pids=()
  next_index=0
  inflight=0
  completed=0
  while [ "$next_index" -lt "$total" ] || [ "$inflight" -gt 0 ]; do
    while [ "$next_index" -lt "$total" ] && [ "$inflight" -lt "$FAST_PRODUCER_CONCURRENCY" ]; do
      slot="$next_index"
      printf '%s\t%s\t%s\n' "${work_sources[$slot]}" "${work_profiles[$slot]}" "${work_services[$slot]}" > "$work_dir/$slot.meta"
      (
        run_profile_service_probe "${work_sources[$slot]}" "${work_services[$slot]}" > "$work_dir/$slot.result"
        touch "$work_dir/$slot.done"
      ) &
      probe_pids[$slot]="$!"
      PROFILE_SERVICE_OBSERVATION_COUNT=$((PROFILE_SERVICE_OBSERVATION_COUNT + 1))
      inflight=$((inflight + 1))
      if [ "$inflight" -gt "$FAST_PRODUCER_MAX_INFLIGHT" ]; then
        FAST_PRODUCER_MAX_INFLIGHT="$inflight"
      fi
      next_index=$((next_index + 1))
    done

    made_progress="0"
    for slot in "${!probe_pids[@]}"; do
      [ -n "${probe_pids[$slot]:-}" ] || continue
      [ -f "$work_dir/$slot.done" ] || continue
      wait "${probe_pids[$slot]}" || true
      IFS=$'\t' read -r source_id profile_user services < "$work_dir/$slot.meta"
      probe="$(cat "$work_dir/$slot.result")"
      # Only this parent processes trigger/state consequences.  Probe workers
      # are read-only and cannot race the canonical writer or incident state.
      process_profile_service_probe "$source_id" "$profile_user" "$services" "$probe"
      unset 'probe_pids[$slot]'
      inflight=$((inflight - 1))
      completed=$((completed + 1))
      made_progress="1"
    done
    [ "$completed" -ge "$total" ] && break
    if [ "$made_progress" = "0" ]; then
      sleep 0.02
    fi
  done
  rm -rf "$work_dir"
}

run_active_profile_suspicion_cycle() {
  [ -n "$PROFILE_SERVICE_SUSPICION_COMMAND" ] || return 0
  [ -r "$PROFILE_CONTRACTS_FILE" ] || return 0
  if [ "$FAST_PRODUCER_CONCURRENCY" -gt 1 ] 2>/dev/null; then
    run_parallel_active_profile_suspicion_cycle
    return 0
  fi
  previous_source=""
  last_checked_iface=""
  last_checked_iface_ready="0"
  while IFS=$'\t' read -r source_id _profile _services _profile_count iface enabled; do
    [ -n "$source_id" ] || continue
    [ "$source_id" = "$previous_source" ] && continue
    previous_source="$source_id"
    enabled="${enabled:-1}"
    [ "$enabled" = "1" ] || continue
    [ -n "$iface" ] || continue
    if [ "$iface" = "$last_checked_iface" ]; then
      [ "$last_checked_iface_ready" = "1" ] || continue
    elif interface_up "$iface"; then
      last_checked_iface="$iface"
      last_checked_iface_ready="1"
    else
      last_checked_iface="$iface"
      last_checked_iface_ready="0"
      continue
    fi
    profile_service_suspicion_for_source "$source_id"
  done < "$PROFILE_CONTRACTS_FILE"
}

if [ ! -r "$REG" ]; then
  echo "egress registry unreadable: $REG" >&2
  exit 1
fi

if [ -n "$PROFILE_SERVICE_SUSPICION_COMMAND" ]; then
  PROFILE_CONTRACTS_FILE="$(mktemp "${TMPDIR:-/tmp}/v7-profile-contracts.XXXXXX")"
  build_active_profile_contracts > "$PROFILE_CONTRACTS_FILE"
  PROFILE_SERVICE_CONTRACT_COUNT="$(wc -l < "$PROFILE_CONTRACTS_FILE" | tr -d ' ')"
  PROFILE_SERVICE_ACTIVE_SOURCE_COUNT="$(cut -f1 "$PROFILE_CONTRACTS_FILE" | uniq | wc -l | tr -d ' ')"
  trap 'test -z "$PROFILE_CONTRACTS_FILE" || rm -f "$PROFILE_CONTRACTS_FILE"' EXIT
fi

: > "$TMP"
echo "updated=$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> "$TMP"
if [ -n "$PROFILE_SERVICE_SUSPICION_COMMAND" ]; then
  FAST_PRODUCER_STARTED_NS="$(python3 -c 'import time; print(time.time_ns())')"
fi

if [ "$FAST_PRODUCER_ONLY" = "1" ]; then
  echo "fast_producer_mode=CONTROLLED_OBSERVATION_ONLY" >> "$TMP"
  run_active_profile_suspicion_cycle
  write_fast_producer_telemetry
  mv "$TMP" "$OUT"
  exit 0
fi

run_active_profile_suspicion_cycle
write_fast_producer_telemetry

while IFS= read -r line; do
  [ -z "$line" ] && continue
  case "$line" in \#*) continue ;; esac
  id="$(get_field id "$line")"
  iface="$(get_field interface "$line")"
  protocol="$(get_field protocol "$line")"
  enabled="$(get_field enabled "$line")"
  [ -z "$id" ] && continue
  [ -z "$iface" ] && continue
  protocol="${protocol:-unknown}"
  enabled="${enabled:-1}"
  diagnose_row "$id" "$protocol" "$iface" "$enabled"
done < "$REG"

mv "$TMP" "$OUT"
