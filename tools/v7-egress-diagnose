matrix_failed_services_for_source() {
  source_id="$1"
  services="$2"
  if [ "$LIGHTWEIGHT_BATCH_PRODUCER" = "1" ] && [ -n "$FAST_MATRIX_FRESH_FAILURES_FILE" ] && [ -r "$FAST_MATRIX_FRESH_FAILURES_FILE" ]; then
    awk -F '\t' -v source="$source_id" -v services="$services" '
      BEGIN { split(services, wanted, ","); for (i in wanted) required[wanted[i]] = 1 }
      $1 == source && required[$2] { found[$2] = 1 }
      END { for (service in found) print service ":MATRIX_CONFIRMED_FAILURE" }
    ' "$FAST_MATRIX_FRESH_FAILURES_FILE" | sort | paste -sd, -
    return 0
  fi
  python3 - "$STATE_DIR/service-matrix.json" "$source_id" "$services" "$PROFILE_MATRIX_REUSE_MAX_AGE_SEC" <<'PY'
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

try:
    payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
except (OSError, ValueError, TypeError):
    payload = {}
items = payload.get("items") if isinstance(payload, dict) else {}
source = items.get(str(sys.argv[2] or "")) if isinstance(items, dict) else {}
rows = source.get("services") if isinstance(source, dict) else {}
expected = [item.strip() for item in str(sys.argv[3] or "").split(",") if item.strip()]
try:
    max_age = max(1, int(sys.argv[4]))
except (IndexError, TypeError, ValueError):
    max_age = 10
now = datetime.now(timezone.utc)
failed = []
for service in expected:
    row = rows.get(service) if isinstance(rows, dict) else None
    if not isinstance(row, dict):
        continue
    observed = str(row.get("observed_at") or row.get("tested_at") or "")
    try:
        at = datetime.fromisoformat(observed.replace("Z", "+00:00"))
        if at.tzinfo is None:
            at = at.replace(tzinfo=timezone.utc)
        age = (now - at).total_seconds()
    except (TypeError, ValueError):
        continue
    # Matrix is the canonical failure owner.  Only a recent, explicitly
    # observed failure may unblock a probe-budget timeout; stale/unknown
    # evidence remains fail-closed in profile_service_trigger().
    if age < 0 or age > max_age:
        continue
    status = str(row.get("status") or "").upper()
    severity = str(row.get("severity") or "").upper()
    failure_state = str(row.get("failure_state") or "").upper()
    incident = str(row.get("source_incident_id") or "")
    if incident and (
        status == "FAIL"
        or severity == "FAIL"
        or failure_state.startswith("OBSERVED_")
    ):
        failed.append(service + ":MATRIX_CONFIRMED_FAILURE")
print(",".join(sorted(set(failed))))
PY
}

