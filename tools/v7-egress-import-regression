#!/usr/bin/env python3
import base64
import json
import os
import pathlib
import runpy
import tempfile


ROOT = pathlib.Path(__file__).resolve().parents[1]
APP = pathlib.Path(os.environ.get("V7_ADMIN_API_PATH", str(ROOT / "admin" / "v7-admin-api")))


def load_app():
    module = runpy.run_path(str(APP), run_name="v7_egress_import_regression")
    globals_ref = module["egress_draft_create"].__globals__
    return module, globals_ref


def wg_key(fill):
    return base64.b64encode(bytes([fill]) * 32).decode()


def amnezia_config(table=False):
    table_line = "Table = off\n" if table else ""
    return f"""[Interface]
PrivateKey = {wg_key(1)}
Address = 10.70.0.2/32
DNS = 1.1.1.1
{table_line}Jc = 4
Jmin = 40
Jmax = 80
S1 = 1
S2 = 2
S3 = 3
S4 = 4
H1 = 1011963196-1562928229
H2 = 1669515394-2004129229
H3 = 2054029308-2135946885
H4 = 2139118861-2146192612
I1 = <r 2><b 0x858000010001000000000669636c6f756403636f6d0000010001c00c000100010000105a00044d583737>
I2 =

[Peer]
PublicKey = {wg_key(2)}
Endpoint = vpn.example.com:51820
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
"""


OPENVPN_CONFIG = """client
dev tun
proto udp
remote openvpn.example.com 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth SHA256
cipher AES-256-GCM
redirect-gateway def1
dhcp-option DNS 1.1.1.1
<ca>
-----BEGIN CERTIFICATE-----
MIIBtestca
-----END CERTIFICATE-----
</ca>
<cert>
-----BEGIN CERTIFICATE-----
MIIBtestcert
-----END CERTIFICATE-----
</cert>
<key>
-----BEGIN PRIVATE KEY-----
MIIBtestkey
-----END PRIVATE KEY-----
</key>
"""

OPENVPN_CONFIG_ALT = OPENVPN_CONFIG.replace(
    "remote openvpn.example.com 1194",
    "remote openvpn-alt.example.com 1195",
)


XRAY_VLESS = json.dumps({
    "outbounds": [{
        "protocol": "vless",
        "tag": "xray-vless",
        "settings": {
            "vnext": [{
                "address": "xray.example.com",
                "port": 443,
                "users": [{"id": "11111111-1111-4111-8111-111111111111"}],
            }]
        },
        "streamSettings": {
            "security": "tls",
            "tlsSettings": {"serverName": "xray.example.com"},
        },
    }]
})


OUTLINE_YAML = """transport: tcpudp
endpoint: outline.example.com:8388
method: chacha20-ietf-poly1305
password: secret-value
"""


def configure_temp_paths(globals_ref, root):
    globals_ref["STATE_DIR"] = root / "state"
    globals_ref["EGRESS_DRAFTS_DIR"] = root / "drafts"
    globals_ref["EGRESS_DRAFT_TESTS_DIR"] = root / "tests"
    globals_ref["EGRESS_RUNTIME_DIR"] = root / "runtime"
    globals_ref["WIREGUARD_DIR"] = root / "wireguard"
    globals_ref["AMNEZIAWG_DIR"] = root / "amneziawg"
    globals_ref["OPENVPN_DIR"] = root / "openvpn"
    for key in ("STATE_DIR", "EGRESS_DRAFTS_DIR", "EGRESS_DRAFT_TESTS_DIR", "EGRESS_RUNTIME_DIR", "WIREGUARD_DIR", "AMNEZIAWG_DIR", "OPENVPN_DIR"):
        globals_ref[key].mkdir(parents=True, exist_ok=True)
    (globals_ref["STATE_DIR"] / "egress.registry").write_text(
        "id=existing protocol=wireguard type=interface interface=wg0 test=interface enabled=1\n",
        encoding="utf-8",
    )
    (globals_ref["STATE_DIR"] / "users.registry").write_text("", encoding="utf-8")


def assert_ok(condition, message, detail=None):
    if not condition:
        raise AssertionError(f"{message}: {detail!r}")


def patch_draft_metadata(globals_ref, draft_id, updates):
    meta_path = globals_ref["EGRESS_DRAFTS_DIR"] / draft_id / "metadata.json"
    meta = json.loads(meta_path.read_text(encoding="utf-8"))
    meta.update(updates)
    meta["lifecycle"] = globals_ref["egress_draft_lifecycle"](meta)
    meta_path.write_text(json.dumps(meta), encoding="utf-8")
    return meta


def main():
    app, g = load_app()
    with tempfile.TemporaryDirectory(prefix="v7-egress-import-regression-") as tmp:
        root = pathlib.Path(tmp)
        configure_temp_paths(g, root)

        awg = amnezia_config(table=False)
        preview, error = app["egress_config_preview"]({"label": "awg", "config": awg, "role": "GLOBAL_FAST"})
        assert_ok(not error, "amnezia preview failed", error)
        assert_ok(preview["protocol"] == "amneziawg", "amnezia protocol mismatch", preview)
        checks = app["egress_draft_static_checks"]("draft-awg", preview, awg)
        table_check = next(row for row in checks if row["id"] == "table_off_runtime_normalized")
        assert_ok(table_check["status"] == "OK", "Table=off normalization check failed", table_check)
        hooks_check = next(row for row in checks if row["id"] == "unsafe_hooks_absent")
        assert_ok(hooks_check["status"] == "OK", "DNS should be ignored, not treated as unsafe hook", hooks_check)
        sanitized, error = app["egress_draft_sanitize_interface_config"](awg, "amneziawg")
        assert_ok(not error and "Table = off" in sanitized, "amnezia sanitize failed", error or sanitized)
        assert_ok("DNS =" not in sanitized, "DNS must not be copied into isolated runtime config", sanitized)
        assert_ok("Jc = 4" in sanitized and "H1 = 1011963196-1562928229" in sanitized, "AmneziaWG options must be preserved", sanitized)
        assert_ok("I1 = <r 2><b 0x858000010001000000000669636c6f756403636f6d0000010001c00c000100010000105a00044d583737>" in sanitized, "AmneziaWG I1 must be preserved", sanitized)
        assert_ok("I2 =" not in sanitized, "Empty AmneziaWG I fields should not be copied", sanitized)

        ovpn_preview, error = app["egress_config_preview"]({"label": "ovpn", "config": OPENVPN_CONFIG, "role": "GLOBAL_FAST"})
        assert_ok(not error, "openvpn preview failed", error)
        assert_ok(ovpn_preview["protocol"] == "openvpn", "openvpn protocol mismatch", ovpn_preview)
        ovpn_checks = app["egress_draft_static_checks"]("draft-ovpn", ovpn_preview, OPENVPN_CONFIG)
        ovpn_adapter = next(row for row in ovpn_checks if row["id"] == "openvpn_runtime_adapter")
        assert_ok(ovpn_adapter["status"] == "OK", "openvpn adapter should be ready", ovpn_checks)
        ovpn_runtime, ovpn_auth, error = app["egress_openvpn_normalize_runtime_config"](OPENVPN_CONFIG, "v7ovpnx", auth_path=root / "openvpn" / "v7ovpnx.auth")
        assert_ok(not error, "openvpn normalize failed", error)
        assert_ok("dev v7ovpnx" in ovpn_runtime and "route-nopull" in ovpn_runtime, "openvpn must force managed interface/routing", ovpn_runtime)
        assert_ok("redirect-gateway" not in "\n".join(line for line in ovpn_runtime.splitlines() if not line.startswith("pull-filter")), "openvpn redirect-gateway must not be copied", ovpn_runtime)
        assert_ok("dhcp-option DNS" not in "\n".join(line for line in ovpn_runtime.splitlines() if not line.startswith("pull-filter")), "openvpn pushed DNS must not be copied", ovpn_runtime)
        parsed_403 = app["egress_draft_parse_curl_http_metrics"]("curl: (22) The requested URL returned error: 403\n403 0.150000 0.160000")
        assert_ok(parsed_403 == ("403", "0.150000", "0.160000"), "curl 403 metrics parsing failed", parsed_403)
        original_run_readonly = g["run_readonly"]

        def fake_matrix_curl(cmd, timeout=12):
            url = str(cmd[-1])
            if "chatgpt.com" in url or "auth.openai.com" in url:
                return {"rc": 22, "output": "curl: (22) The requested URL returned error: 403\n403 0.150000 0.160000"}
            return {"rc": 0, "output": "200 0.050000 0.060000"}

        g["run_readonly"] = fake_matrix_curl
        try:
            limited_matrix = app["egress_draft_interface_service_matrix"]("if-test", "GLOBAL_FAST", 8)
        finally:
            g["run_readonly"] = original_run_readonly
        assert_ok(limited_matrix["status"] == "PASS", "HTTP-limited services should not block import matrix", limited_matrix)
        assert_ok(limited_matrix["services"]["chatgpt"]["status"] == "HTTP_LIMITED", "HTTP 403 should be HTTP_LIMITED", limited_matrix)
        assert_ok(limited_matrix["ok_count"] == limited_matrix["total"], "HTTP_LIMITED should count as reachable", limited_matrix)
        unsafe_ovpn = OPENVPN_CONFIG + "\nup /bin/true\n"
        unsafe_preview, error = app["egress_config_preview"]({"label": "unsafe-ovpn", "config": unsafe_ovpn, "role": "GLOBAL_FAST"})
        assert_ok(not error and unsafe_preview["protocol"] == "openvpn", "unsafe openvpn preview failed", error or unsafe_preview)
        unsafe_checks = app["egress_draft_static_checks"]("draft-unsafe-ovpn", unsafe_preview, unsafe_ovpn)
        unsafe_adapter = next(row for row in unsafe_checks if row["id"] == "openvpn_runtime_adapter")
        assert_ok(unsafe_adapter["status"] == "FAIL", "openvpn unsafe hooks must block autostart", unsafe_checks)

        xray_preview, error = app["egress_config_preview"]({"label": "xray", "config": XRAY_VLESS, "role": "GLOBAL_FAST"})
        assert_ok(not error, "xray preview failed", error)
        assert_ok(xray_preview["protocol"] == "xray_json", "xray protocol mismatch", xray_preview)
        expanded, error = app["egress_expand_endpoints_from_text"](XRAY_VLESS, allow_fetch=False)
        assert_ok(not error and expanded["ready"] == 1, "xray endpoint expansion failed", error or expanded)

        outline_preview, error = app["egress_config_preview"]({"label": "outline", "config": OUTLINE_YAML, "role": "GLOBAL_FAST"})
        assert_ok(not error, "outline preview failed", error)
        assert_ok(outline_preview["validation"] == "detected_required_fields", "outline validation mismatch", outline_preview)
        runtime_text, error = app["egress_draft_proxy_runtime_text"](OUTLINE_YAML, 23456)
        assert_ok(not error and '"listen_port": 23456' in runtime_text, "outline runtime text failed", error or runtime_text)

        draft, error = app["egress_draft_create"]({"label": "outline", "config": OUTLINE_YAML, "role": "GLOBAL_FAST"}, "regression")
        assert_ok(not error, "draft create failed", error)
        meta_path = g["EGRESS_DRAFTS_DIR"] / draft["id"] / "metadata.json"
        meta = json.loads(meta_path.read_text(encoding="utf-8"))
        meta.update({
            "last_preflight_status": "PASS",
            "last_runtime_status": "PASS",
            "last_quarantine_status": "PASS",
            "next_step": "add_to_pool_preview",
        })
        meta_path.write_text(json.dumps(meta), encoding="utf-8")
        pool_preview, error = app["egress_draft_pool_preview"](draft["id"])
        assert_ok(not error and pool_preview["ready"], "pool preview failed", error or pool_preview)
        pool_result, error = app["egress_draft_pool_apply"](draft["id"], "regression")
        assert_ok(not error and pool_result["pool_action"] == "added_disabled", "pool apply failed", error or pool_result)
        provision, error = app["egress_draft_runtime_provision"](draft["id"], "regression")
        assert_ok(not error, "runtime provision failed", error)
        assert_ok(pathlib.Path(provision["path"]).exists(), "runtime profile missing", provision)

        ovpn_draft, error = app["egress_draft_create"]({"label": "ovpn", "config": OPENVPN_CONFIG, "role": "GLOBAL_FAST"}, "regression")
        assert_ok(not error, "openvpn draft create failed", error)
        ovpn_meta_path = g["EGRESS_DRAFTS_DIR"] / ovpn_draft["id"] / "metadata.json"
        ovpn_meta = json.loads(ovpn_meta_path.read_text(encoding="utf-8"))
        ovpn_meta.update({
            "last_preflight_status": "PASS",
            "last_runtime_status": "PASS",
            "last_quarantine_status": "PASS",
            "next_step": "add_to_pool_preview",
        })
        ovpn_meta_path.write_text(json.dumps(ovpn_meta), encoding="utf-8")
        ovpn_pool_preview, error = app["egress_draft_pool_preview"](ovpn_draft["id"])
        assert_ok(not error and ovpn_pool_preview["ready"], "openvpn pool preview failed", error or ovpn_pool_preview)
        ovpn_pool_result, error = app["egress_draft_pool_apply"](ovpn_draft["id"], "regression")
        assert_ok(not error and ovpn_pool_result["pool_action"] == "added_disabled", "openvpn pool apply failed", error or ovpn_pool_result)
        ovpn_provision, error = app["egress_draft_runtime_provision"](ovpn_draft["id"], "regression")
        assert_ok(not error and ovpn_provision["status"] == "READY", "openvpn runtime provision failed", error or ovpn_provision)
        assert_ok(pathlib.Path(ovpn_provision["path"]).exists(), "openvpn runtime profile missing", ovpn_provision)

        original_preflight = g["egress_draft_preflight_run"]
        original_runtime = g["egress_draft_runtime_run"]

        def fake_preflight(draft_id, actor):
            patch_draft_metadata(g, draft_id, {
                "last_preflight_at": "2026-01-01T00:00:00+00:00",
                "last_preflight_status": "PASS",
                "last_preflight_run_id": f"{draft_id}-preflight",
                "next_step": "isolated_runtime_test",
            })
            return {"draft_id": draft_id, "status": "PASS"}, None

        def fake_runtime(draft_id, actor, duration=8, requested_mode="runtime"):
            updates = {
                "last_runtime_at": "2026-01-01T00:00:01+00:00",
                "last_runtime_status": "PASS",
                "last_runtime_run_id": f"{draft_id}-{requested_mode}",
                "next_step": "add_to_pool_preview" if requested_mode == "quarantine" else "service_matrix_quarantine_test",
            }
            result = {
                "draft_id": draft_id,
                "status": "PASS",
                "requested_mode": requested_mode,
                "service_matrix": {"status": "PASS", "ok_count": 12, "total": 12},
            }
            if requested_mode == "quarantine":
                updates.update({
                    "last_quarantine_at": "2026-01-01T00:00:02+00:00",
                    "last_quarantine_status": "PASS",
                    "last_quarantine_run_id": f"{draft_id}-quarantine",
                    "last_service_matrix_status": "PASS",
                })
                result["quarantine_status"] = "PASS"
            patch_draft_metadata(g, draft_id, updates)
            return result, None

        g["egress_draft_preflight_run"] = fake_preflight
        g["egress_draft_runtime_run"] = fake_runtime
        try:
            pipeline, error = app["egress_channel_add_pipeline"]({"label": "ovpn-pipeline", "config": OPENVPN_CONFIG_ALT, "role": "GLOBAL_FAST"}, "regression")
            assert_ok(not error and pipeline["status"] == "ADDED_DISABLED_READY", "channel pipeline add failed", error or pipeline)
            assert_ok(pipeline["egress"], "pipeline must return egress id", pipeline)
            assert_ok(all(row["id"] != pipeline["draft_id"] for row in app["egress_drafts_state"]()["items"]), "successful internal import should not be shown as draft", app["egress_drafts_state"]())

            duplicate, error = app["egress_channel_add_pipeline"]({"label": "ovpn-dup", "config": OPENVPN_CONFIG_ALT, "role": "GLOBAL_FAST"}, "regression")
            assert_ok(not error and duplicate["status"] == "DUPLICATE_FOUND", "duplicate should be detected", error or duplicate)
            assert_ok((duplicate.get("duplicate") or {}).get("egress") == pipeline["egress"], "duplicate should point to first egress", duplicate)

            updated, error = app["egress_channel_add_pipeline"]({
                "draft_id": duplicate["draft_id"],
                "duplicate_action": "update_existing",
                "target_egress": pipeline["egress"],
            }, "regression")
            assert_ok(not error and updated["status"] == "UPDATED_EXISTING", "duplicate update existing failed", error or updated)
            assert_ok(updated["egress"] == pipeline["egress"], "update existing target mismatch", updated)
        finally:
            g["egress_draft_preflight_run"] = original_preflight
            g["egress_draft_runtime_run"] = original_runtime

        scratch, error = app["egress_draft_create"]({"label": "scratch", "config": OUTLINE_YAML, "role": "GLOBAL_FAST"}, "regression")
        assert_ok(not error, "scratch draft create failed", error)
        deleted, error = app["egress_draft_delete"](scratch["id"], "regression")
        assert_ok(not error and deleted["status"] == "DELETED", "draft delete failed", error or deleted)
        state = app["egress_drafts_state"]()
        assert_ok(all(row["id"] != scratch["id"] for row in state["items"]), "deleted draft still visible", state)

    print("egress_import_regression_ok")


if __name__ == "__main__":
    main()
