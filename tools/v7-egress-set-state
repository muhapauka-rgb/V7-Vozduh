#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${V7_STATE_DIR:-/opt/v7/egress/state}"
EGRESS_REG="${V7_EGRESS_REGISTRY:-$STATE_DIR/egress.registry}"
USERS_REG="${V7_USERS_REGISTRY:-$STATE_DIR/users.registry}"
FLAGS="$STATE_DIR/egress-flags.state"
EGRESS_ID="${1:-}"
STATE="${2:-}"
APPLY=0
CONTROLLED_CERTIFICATION=0
CERTIFICATION_USERS=""
CERTIFICATION_GROUP="controlled-production"
RESERVATION_ID=""
RESERVATION_EXPIRES_AT=""
EXPECTED_EGRESS_FINGERPRINT=""
RESTORE_BACKUP=""
CONFIRM=""

usage() {
  echo "Usage: v7-egress-set-state <egress_id> <enabled|disabled|maintenance|certification-failure|certification-telegram-failure|certification-telegram-recovery|certification-scope|certification-reserve|certification-release> [--apply] [--controlled-certification] [--certification-users ip1,ip2] [--certification-group name] [--reservation-id id] [--reservation-expires-at ISO8601] [--expected-egress-fingerprint sha256] [--restore-backup path] [--confirm token]" >&2
}

while [ "$#" -gt 2 ]; do
  arg="$3"
  case "$arg" in
    --apply)
      APPLY=1
      shift
      ;;
    --controlled-certification)
      CONTROLLED_CERTIFICATION=1
      shift
      ;;
    --certification-users)
      [ "$#" -ge 4 ] || { echo "missing value for --certification-users" >&2; usage; exit 1; }
      CERTIFICATION_USERS="$4"
      shift 2
      ;;
    --certification-group)
      [ "$#" -ge 4 ] || { echo "missing value for --certification-group" >&2; usage; exit 1; }
      CERTIFICATION_GROUP="$4"
      shift 2
      ;;
    --reservation-id)
      [ "$#" -ge 4 ] || { echo "missing value for --reservation-id" >&2; usage; exit 1; }
      RESERVATION_ID="$4"
      shift 2
      ;;
    --reservation-expires-at)
      [ "$#" -ge 4 ] || { echo "missing value for --reservation-expires-at" >&2; usage; exit 1; }
      RESERVATION_EXPIRES_AT="$4"
      shift 2
      ;;
    --expected-egress-fingerprint)
      [ "$#" -ge 4 ] || { echo "missing value for --expected-egress-fingerprint" >&2; usage; exit 1; }
      EXPECTED_EGRESS_FINGERPRINT="$4"
      shift 2
      ;;
    --restore-backup)
      [ "$#" -ge 4 ] || { echo "missing value for --restore-backup" >&2; usage; exit 1; }
      RESTORE_BACKUP="$4"
      shift 2
      ;;
    --confirm)
      [ "$#" -ge 4 ] || { echo "missing value for --confirm" >&2; usage; exit 1; }
      CONFIRM="$4"
      shift 2
      ;;
    *)
      echo "unknown option: $arg" >&2
      usage
      exit 1
      ;;
  esac
done

safe_id() {
  [[ "${1:-}" =~ ^[A-Za-z0-9_.-]{1,64}$ ]]
}

safe_ip_list() {
  [[ "${1:-}" =~ ^[0-9A-Fa-f:.,]+$ ]]
}

safe_group() {
  [[ "${1:-}" =~ ^[A-Za-z0-9_.-]{1,64}$ ]]
}

safe_sha256() {
  [[ "${1:-}" =~ ^[0-9a-f]{64}$ ]]
}

telegram_table_name() {
  # Egress ids are already constrained by safe_id.  nft identifiers cannot
  # contain '-' or '.', so derive one deterministic, owner-scoped table name.
  local normalized
  normalized="$(tr -c '[:alnum:]_' '_' <<< "$EGRESS_ID")"
  printf 'v7_ct_telegram_%s' "$normalized"
}

telegram_ipv4_targets() {
  {
    printf '%s\n' \
      149.154.167.50 \
      149.154.175.50 \
      91.108.56.177 \
      194.221.250.50
    # api.telegram.org is an explicitly required sentinel target.  Resolve it
    # at injection time so a controlled condition cannot silently miss its
    # current IPv4 address; static targets retain a closed, bounded fallback.
    getent ahostsv4 api.telegram.org 2>/dev/null | awk '$1 ~ /^[0-9]{1,3}(\.[0-9]{1,3}){3}$/ {print $1}' || true
  } | sort -u | paste -sd ',' -
}

validate_exact_controlled_certification_scope() {
  # $1 is exact (the identity must still be on source) or released (after the
  # automatic move only an empty source is lawful).  All callers retain the
  # same reservation/group/fingerprint boundary; this helper owns no state.
  local mode="$1"
  local label="${CONTROLLED_CONDITION_LABEL:-certification_condition}"
  [ "$CONTROLLED_CERTIFICATION" -eq 1 ] || {
    echo "ACTION=blocked"
    echo "reason=${label}_requires_controlled_certification"
    return 1
  }
  [ -n "$CERTIFICATION_USERS" ] && safe_ip_list "$CERTIFICATION_USERS" || {
    echo "ACTION=blocked"
    echo "reason=${label}_requires_exact_users"
    return 1
  }
  safe_id "$RESERVATION_ID" || {
    echo "ACTION=blocked"
    echo "reason=${label}_requires_reservation_id"
    return 1
  }
  safe_sha256 "$EXPECTED_EGRESS_FINGERPRINT" || {
    echo "ACTION=blocked"
    echo "reason=${label}_requires_egress_fingerprint"
    return 1
  }
  [ "$line_hash" = "$EXPECTED_EGRESS_FINGERPRINT" ] || {
    echo "ACTION=blocked"
    echo "reason=egress_fingerprint_changed"
    return 1
  }
  local role_now reservation_id_now reservation_expiry_now certification_group_now
  role_now="$(kv_get "$line" role)"
  reservation_id_now="$(kv_get "$line" controlled_source_reservation_id)"
  reservation_expiry_now="$(kv_get "$line" controlled_source_reservation_expires_at)"
  certification_group_now="$(kv_get "$line" certification_group)"
  [ "$enabled_now" = "1" ] \
    && [ "$controlled_certification_source_now" = "1" ] \
    && [ "$role_now" = "EXECUTION_ONLY" ] \
    && [ "$reservation_owner_now" = "operator_execution_governance" ] \
    && [ "$reservation_id_now" = "$RESERVATION_ID" ] \
    && future_iso8601 "$reservation_expiry_now" \
    && [ "$certification_group_now" = "$CERTIFICATION_GROUP" ] || {
      echo "ACTION=blocked"
    echo "reason=${label}_reservation_or_role_not_exact"
      return 1
    }
  local requested_users assigned_users
  requested_users="$(tr ',' '\n' <<< "$CERTIFICATION_USERS" | awk 'NF' | sort -u | paste -sd ',' -)"
  assigned_users="$(awk -v e="$EGRESS_ID" -v group="$CERTIFICATION_GROUP" '
    {
      enabled="1"; current=""; ip=""; certification="0"; assigned_group=""
      for (i=1;i<=NF;i++) {
        if ($i ~ /^enabled=/) enabled=substr($i,9)
        if ($i ~ /^current=/) current=substr($i,9)
        if ($i ~ /^ip=/) ip=substr($i,4)
        if ($i ~ /^certification_user=/) certification=substr($i,20)
        if ($i ~ /^certification_group=/) assigned_group=substr($i,21)
      }
      if (enabled == "1" && current == e) {
        if (certification != "1" || assigned_group != group) exit 3
        print ip
      }
    }
  ' "$USERS_REG" | sort -u | paste -sd ',' -)" || {
      echo "ACTION=blocked"
      echo "reason=${label}_source_contains_non_exact_member"
      return 1
    }
  if [ "$mode" = "exact" ]; then
    [ -n "$assigned_users" ] && [ "$assigned_users" = "$requested_users" ] || {
      echo "ACTION=blocked"
      echo "reason=${label}_user_scope_changed"
      echo "requested_users=$requested_users"
      echo "assigned_users=$assigned_users"
      return 1
    }
  else
    [ -z "$assigned_users" ] || [ "$assigned_users" = "$requested_users" ] || {
      echo "ACTION=blocked"
      echo "reason=${label}_recovery_scope_changed"
      echo "requested_users=$requested_users"
      echo "assigned_users=$assigned_users"
      return 1
    }
  fi
  CONTROLLED_ASSIGNED_USERS="$assigned_users"
  CONTROLLED_RESERVATION_ID="$reservation_id_now"
  CONTROLLED_CERTIFICATION_GROUP="$certification_group_now"
}

future_iso8601() {
  python3 - "$1" <<'PY'
from datetime import datetime, timezone
import sys
try:
    value = datetime.fromisoformat(sys.argv[1].replace("Z", "+00:00"))
    if value.tzinfo is None:
        raise ValueError("timezone required")
    raise SystemExit(0 if value > datetime.now(timezone.utc) else 1)
except (TypeError, ValueError):
    raise SystemExit(1)
PY
}

line_fingerprint() {
  printf '%s' "$1" | sha256sum | awk '{print $1}'
}

kv_get() {
  local line="$1"
  local key="$2"
  awk -v key="$key" '{
    for (i = 1; i <= NF; i++) {
      split($i, a, "=")
      if (a[1] == key) {
        sub("^[^=]+=", "", $i)
        print $i
        exit
      }
    }
  }' <<< "$line"
}

interface_live() {
  local ifname="$1"
  [ -n "$ifname" ] && [ -e "/sys/class/net/$ifname" ]
}

quick_bin_for_protocol() {
  local protocol="$1"
  case "$protocol" in
    amneziawg) command -v awg-quick || true ;;
    wireguard) command -v wg-quick || true ;;
    openvpn) command -v openvpn || true ;;
    *) echo "" ;;
  esac
}

address_conflicts() {
  local ifname="$1"
  local config="$2"
  awk -F= 'tolower($1) ~ /^[[:space:]]*address[[:space:]]*$/ {print $2}' "$config" |
    tr ',' '\n' |
    sed 's/^[[:space:]]*//;s/[[:space:]]*$//' |
    while read -r cidr; do
      [ -n "$cidr" ] || continue
      ip -o addr show | awk -v cidr="$cidr" -v ifname="$ifname" '$4 == cidr && $2 != ifname {print $2 ":" $4}'
    done
}

ensure_interface_up() {
  local id="$1"
  local protocol="$2"
  local ifname="$3"
  local config="$4"
  if [ "$protocol" != "amneziawg" ] && [ "$protocol" != "wireguard" ] && [ "$protocol" != "openvpn" ]; then
    echo "unsupported interface protocol: $protocol"
    return 1
  fi
  [ -n "$ifname" ] || { echo "egress has no interface: $id"; return 1; }
  [ -r "$config" ] || { echo "egress config not readable: $config"; return 1; }
  if interface_live "$ifname"; then
    echo "interface_already_up=$ifname"
    return 0
  fi
  if [ "$protocol" = "openvpn" ]; then
    local openvpn
    openvpn="$(quick_bin_for_protocol "$protocol")"
    [ -n "$openvpn" ] || { echo "openvpn missing"; return 1; }
    local systemd_unit=""
    if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files "v7-egress-openvpn@.service" --no-legend 2>/dev/null | grep -q '^v7-egress-openvpn@.service'; then
      systemd_unit="v7-egress-openvpn@$ifname.service"
      echo "runtime_up=systemctl start $systemd_unit"
      systemctl reset-failed "$systemd_unit" >/dev/null 2>&1 || true
      systemctl start "$systemd_unit"
    else
      local pid_file="$STATE_DIR/openvpn-$EGRESS_ID.pid"
      echo "runtime_up=$openvpn --config $config --daemon --writepid $pid_file"
      "$openvpn" --config "$config" --daemon "v7-egress-$EGRESS_ID" --writepid "$pid_file"
    fi
    for _ in $(seq 1 30); do
      if interface_live "$ifname"; then
        if [ -n "$systemd_unit" ]; then
          sleep 1
          if systemctl is-active --quiet "$systemd_unit" && interface_live "$ifname"; then
            echo "interface_up=$ifname"
            return 0
          fi
        else
          echo "interface_up=$ifname"
          return 0
        fi
      fi
      if [ -n "$systemd_unit" ]; then
        local sub_state
        sub_state="$(systemctl show "$systemd_unit" -p SubState --value 2>/dev/null || true)"
        if [ "$sub_state" = "auto-restart" ] || [ "$sub_state" = "failed" ]; then
          echo "openvpn_unit_failed=$systemd_unit sub_state=$sub_state"
          journalctl -u "$systemd_unit" --no-pager -n 40 2>/dev/null || true
          return 1
        fi
      fi
      sleep 1
    done
    echo "interface_not_created=$ifname"
    return 1
  fi
  local conflicts
  conflicts="$(address_conflicts "$ifname" "$config" | paste -sd ',' -)"
  if [ -n "$conflicts" ]; then
    echo "address_conflict=$conflicts"
    return 1
  fi
  local quick
  quick="$(quick_bin_for_protocol "$protocol")"
  [ -n "$quick" ] || { echo "quick tool missing for protocol: $protocol"; return 1; }
  echo "runtime_up=$quick up $config"
  "$quick" up "$config"
  if ! interface_live "$ifname"; then
    echo "interface_not_created=$ifname"
    return 1
  fi
  echo "interface_up=$ifname"
}

ensure_interface_down() {
  local id="$1"
  local protocol="$2"
  local ifname="$3"
  local config="$4"
  if [ "$protocol" != "amneziawg" ] && [ "$protocol" != "wireguard" ] && [ "$protocol" != "openvpn" ]; then
    echo "unsupported interface protocol: $protocol"
    return 1
  fi
  [ -n "$ifname" ] || { echo "egress has no interface: $id"; return 1; }
  if ! interface_live "$ifname"; then
    echo "interface_already_down=$ifname"
    return 0
  fi
  if [ "$protocol" = "openvpn" ]; then
    if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files "v7-egress-openvpn@.service" --no-legend 2>/dev/null | grep -q '^v7-egress-openvpn@.service'; then
      echo "runtime_down=systemctl stop v7-egress-openvpn@$ifname.service"
      systemctl stop "v7-egress-openvpn@$ifname.service" || true
    else
      local pid_file="$STATE_DIR/openvpn-$EGRESS_ID.pid"
      if [ -s "$pid_file" ]; then
        echo "runtime_down=kill $(cat "$pid_file")"
        kill "$(cat "$pid_file")" 2>/dev/null || true
      else
        echo "runtime_down=pkill -f openvpn.*$config"
        pkill -f "openvpn.*$config" 2>/dev/null || true
      fi
    fi
    for _ in $(seq 1 15); do
      interface_live "$ifname" || { echo "interface_down=$ifname"; return 0; }
      sleep 1
    done
    echo "interface_still_up=$ifname"
    return 1
  fi
  [ -r "$config" ] || { echo "egress config not readable: $config"; return 1; }
  local quick
  quick="$(quick_bin_for_protocol "$protocol")"
  [ -n "$quick" ] || { echo "quick tool missing for protocol: $protocol"; return 1; }
  echo "runtime_down=$quick down $config"
  "$quick" down "$config"
  if interface_live "$ifname"; then
    echo "interface_still_up=$ifname"
    return 1
  fi
  echo "interface_down=$ifname"
}

rebuild_killswitch() {
  local reason="$1"
  if ! command -v v7-killswitch-enable >/dev/null 2>&1; then
    echo "killswitch_rebuild=skipped missing_tool"
    return 0
  fi

  echo "killswitch_rebuild=running reason=$reason"
  if v7-killswitch-enable >/tmp/v7-egress-set-state-killswitch.log 2>&1; then
    echo "killswitch_rebuild=OK"
    return 0
  fi

  local rc="$?"
  echo "killswitch_rebuild=FAIL rc=$rc"
  sed -n '1,80p' /tmp/v7-egress-set-state-killswitch.log 2>/dev/null || true
  return "$rc"
}

[ -n "$EGRESS_ID" ] && [ -n "$STATE" ] || { usage; exit 1; }
safe_id "$EGRESS_ID" || { echo "unsafe egress id: $EGRESS_ID"; exit 1; }
case "$STATE" in
  enabled|disabled|maintenance|certification-failure|certification-telegram-failure|certification-telegram-recovery|certification-scope|certification-reserve|certification-release) ;;
  *) usage; exit 1 ;;
esac
safe_group "$CERTIFICATION_GROUP" || { echo "unsafe certification group: $CERTIFICATION_GROUP"; exit 1; }
if [ "$STATE" = "certification-scope" ]; then
  [ -n "$CERTIFICATION_USERS" ] || { echo "missing --certification-users for certification-scope"; exit 1; }
  safe_ip_list "$CERTIFICATION_USERS" || { echo "unsafe certification users list"; exit 1; }
fi

line="$(grep "^id=${EGRESS_ID} " "$EGRESS_REG" 2>/dev/null || true)"
[ -n "$line" ] || { echo "FAIL: egress not found: $EGRESS_ID"; exit 1; }
line_hash="$(line_fingerprint "$line")"

protocol="$(kv_get "$line" protocol)"
type="$(kv_get "$line" type)"
ifname="$(kv_get "$line" interface)"
config="$(kv_get "$line" config)"
[ -n "$config" ] || config="$(kv_get "$line" config_path)"
enabled_now="$(kv_get "$line" enabled)"
[ -n "$enabled_now" ] || enabled_now=1
controlled_certification_source_now="$(kv_get "$line" controlled_certification_source)"
reservation_owner_now="$(kv_get "$line" reservation_owner)"

echo "===== V7 EGRESS SET STATE ====="
date -Is
echo "egress=$EGRESS_ID"
echo "requested_state=$STATE"
echo "protocol=$protocol"
echo "type=$type"
echo "interface=$ifname"
echo "config=$config"
echo "enabled_now=$enabled_now"
echo "egress_fingerprint=$line_hash"

if [ "$STATE" = "certification-reserve" ]; then
  safe_id "$RESERVATION_ID" || { echo "unsafe or missing reservation id"; exit 1; }
  [ -n "$RESERVATION_EXPIRES_AT" ] || { echo "missing --reservation-expires-at"; exit 1; }
  future_iso8601 "$RESERVATION_EXPIRES_AT" || { echo "reservation expiry must be a future timezone-aware ISO8601 timestamp"; exit 1; }
  safe_sha256 "$EXPECTED_EGRESS_FINGERPRINT" || { echo "missing or invalid expected egress fingerprint"; exit 1; }
  [ "$line_hash" = "$EXPECTED_EGRESS_FINGERPRINT" ] || {
    echo "ACTION=blocked"
    echo "reason=egress_fingerprint_changed"
    echo "expected_egress_fingerprint=$EXPECTED_EGRESS_FINGERPRINT"
    echo "actual_egress_fingerprint=$line_hash"
    exit 2
  }
  assigned_count="$(awk -v e="$EGRESS_ID" '
    {
      enabled="1"; current=""
      for (i=1;i<=NF;i++) {
        if ($i ~ /^enabled=/) enabled=substr($i,9)
        if ($i ~ /^current=/) current=substr($i,9)
      }
      if (enabled == "1" && current == e) count++
    }
    END {print count+0}
  ' "$USERS_REG")"
  assigned_ordinary_count="$(awk -v e="$EGRESS_ID" '
    {
      enabled="1"; current=""; certification="0"
      for (i=1;i<=NF;i++) {
        if ($i ~ /^enabled=/) enabled=substr($i,9)
        if ($i ~ /^current=/) current=substr($i,9)
        if ($i ~ /^certification_user=/) certification=substr($i,20)
      }
      if (enabled == "1" && current == e && certification != "1") count++
    }
    END {print count+0}
  ' "$USERS_REG")"
  assigned_group_mismatch_count="$(awk -v e="$EGRESS_ID" -v expected="$CERTIFICATION_GROUP" '
    {
      enabled="1"; current=""; certification="0"; group=""
      for (i=1;i<=NF;i++) {
        if ($i ~ /^enabled=/) enabled=substr($i,9)
        if ($i ~ /^current=/) current=substr($i,9)
        if ($i ~ /^certification_user=/) certification=substr($i,20)
        if ($i ~ /^certification_group=/) group=substr($i,21)
      }
      if (enabled == "1" && current == e && (certification != "1" || group != expected)) count++
    }
    END {print count+0}
  ' "$USERS_REG")"
  continuation_eligible=0
  if [ "$assigned_count" -gt 0 ] \
    && [ "$assigned_ordinary_count" -eq 0 ] \
    && [ "$assigned_group_mismatch_count" -eq 0 ] \
    && [ "$controlled_certification_source_now" = "1" ] \
    && [ "$reservation_owner_now" = "operator_execution_governance" ]; then
    continuation_eligible=1
  fi
  [ "$assigned_count" -eq 0 ] || [ "$continuation_eligible" -eq 1 ] || {
    echo "ACTION=blocked"
    echo "reason=controlled_source_reservation_requires_empty_or_same_campaign_certification_source"
    echo "assigned_enabled_users=$assigned_count"
    echo "assigned_ordinary_users=$assigned_ordinary_count"
    echo "assigned_group_mismatch_users=$assigned_group_mismatch_count"
    exit 2
  }
  echo "reservation_id=$RESERVATION_ID"
  echo "reservation_expires_at=$RESERVATION_EXPIRES_AT"
  echo "assigned_enabled_users=$assigned_count"
  echo "ordinary_users=$assigned_ordinary_count"
  echo "same_campaign_continuation=$continuation_eligible"
  echo "would_set=controlled_certification_source,certification_group,execution_reserved,canary_reserved,reservation_owner,autoswitch_allowed,rebalance_allowed,production_assignment_allowed,controlled_source_reservation_id,controlled_source_reservation_expires_at"
  if [ "$APPLY" -ne 1 ]; then
    echo "MODE=dry_run"
    echo "ACTION=none"
    exit 0
  fi
  [ "$CONFIRM" = "RESERVE_CONTROLLED_CERTIFICATION_SOURCE" ] || {
    echo "ACTION=blocked"
    echo "reason=exact_reservation_confirmation_required"
    exit 2
  }
  backup_ts="$(date +%Y%m%d-%H%M%S)"
  backup="$EGRESS_REG.backup.v7-controlled-source-reserve.$backup_ts"
  cp -a "$EGRESS_REG" "$backup"
  tmp_egress="$(mktemp "$STATE_DIR/.egress.registry.reserve.XXXXXX")"
  awk -v e="$EGRESS_ID" -v group="$CERTIFICATION_GROUP" -v rid="$RESERVATION_ID" -v expiry="$RESERVATION_EXPIRES_AT" '
    function put(key, value,    i, found) {
      found=0
      for (i=1;i<=NF;i++) {
        if ($i ~ ("^" key "=")) {$i=key "=" value; found=1}
      }
      if (!found) $0=$0 " " key "=" value
    }
    {
      if ($0 ~ ("^id=" e " ")) {
        put("controlled_certification_source","1")
        put("certification_group",group)
        put("execution_reserved","1")
        put("canary_reserved","1")
        put("reservation_owner","operator_execution_governance")
        put("autoswitch_allowed","false")
        put("rebalance_allowed","false")
        put("production_assignment_allowed","false")
        put("controlled_source_reservation_id",rid)
        put("controlled_source_reservation_expires_at",expiry)
      }
      print
    }
  ' "$EGRESS_REG" > "$tmp_egress"
  cat "$tmp_egress" > "$EGRESS_REG"
  rm -f "$tmp_egress"
  current_line="$(grep "^id=${EGRESS_ID} " "$EGRESS_REG")"
  echo "MODE=apply"
  echo "ACTION=controlled_source_reserved"
  echo "restore_backup=$backup"
  echo "reserved_egress_fingerprint=$(line_fingerprint "$current_line")"
  echo "users_moved=0"
  echo "routes_changed=0"
  exit 0
fi

if [ "$STATE" = "certification-release" ]; then
  safe_id "$RESERVATION_ID" || { echo "unsafe or missing reservation id"; exit 1; }
  safe_sha256 "$EXPECTED_EGRESS_FINGERPRINT" || { echo "missing or invalid expected egress fingerprint"; exit 1; }
  [ "$line_hash" = "$EXPECTED_EGRESS_FINGERPRINT" ] || {
    echo "ACTION=blocked"
    echo "reason=egress_fingerprint_changed"
    exit 2
  }
  current_reservation="$(kv_get "$line" controlled_source_reservation_id)"
  [ "$current_reservation" = "$RESERVATION_ID" ] || {
    echo "ACTION=blocked"
    echo "reason=controlled_source_reservation_identity_mismatch"
    exit 2
  }
  case "$RESTORE_BACKUP" in
    "$EGRESS_REG".backup.v7-controlled-source-reserve.*) ;;
    *) echo "unsafe or missing restore backup"; exit 1 ;;
  esac
  [ -r "$RESTORE_BACKUP" ] || { echo "restore backup is not readable"; exit 1; }
  prior_line="$(grep "^id=${EGRESS_ID} " "$RESTORE_BACKUP" 2>/dev/null || true)"
  [ -n "$prior_line" ] || { echo "restore backup lacks exact egress"; exit 1; }
  assigned_count="$(awk -v e="$EGRESS_ID" '
    {
      enabled="1"; current=""
      for (i=1;i<=NF;i++) {
        if ($i ~ /^enabled=/) enabled=substr($i,9)
        if ($i ~ /^current=/) current=substr($i,9)
      }
      if (enabled == "1" && current == e) count++
    }
    END {print count+0}
  ' "$USERS_REG")"
  [ "$assigned_count" -eq 0 ] || {
    echo "ACTION=blocked"
    echo "reason=controlled_source_release_requires_empty_source"
    echo "assigned_enabled_users=$assigned_count"
    exit 2
  }
  echo "reservation_id=$RESERVATION_ID"
  echo "restore_backup=$RESTORE_BACKUP"
  echo "restored_egress_fingerprint=$(line_fingerprint "$prior_line")"
  if [ "$APPLY" -ne 1 ]; then
    echo "MODE=dry_run"
    echo "ACTION=none"
    exit 0
  fi
  [ "$CONFIRM" = "RELEASE_CONTROLLED_CERTIFICATION_SOURCE" ] || {
    echo "ACTION=blocked"
    echo "reason=exact_release_confirmation_required"
    exit 2
  }
  tmp_egress="$(mktemp "$STATE_DIR/.egress.registry.release.XXXXXX")"
  awk -v e="$EGRESS_ID" -v prior="$prior_line" '
    $0 ~ ("^id=" e " ") {$0=prior}
    {print}
  ' "$EGRESS_REG" > "$tmp_egress"
  cat "$tmp_egress" > "$EGRESS_REG"
  rm -f "$tmp_egress"
  echo "MODE=apply"
  echo "ACTION=controlled_source_released"
  echo "users_moved=0"
  echo "routes_changed=0"
  exit 0
fi

if [ "$STATE" = "certification-scope" ]; then
  [ -r "$USERS_REG" ] || { echo "FAIL: users registry not readable: $USERS_REG"; exit 1; }
  missing_certification_users="$(tr ',' '\n' <<< "$CERTIFICATION_USERS" | awk 'NF {print}' | while read -r ip; do
    awk -v ip="$ip" -v e="$EGRESS_ID" '
      $0 ~ "enabled=1" {
        row_ip=""; current=""
        for (i=1;i<=NF;i++) {
          if ($i ~ /^ip=/) row_ip=substr($i,4)
          if ($i ~ /^current=/) current=substr($i,9)
        }
        if (row_ip == ip && current == e) found=1
      }
      END {exit(found ? 0 : 1)}
    ' "$USERS_REG" || echo "$ip"
  done | paste -sd ',' -)"
  if [ -n "$missing_certification_users" ]; then
    echo "ACTION=blocked"
    echo "reason=certification_users_not_enabled_on_source"
    echo "missing_or_wrong_source=$missing_certification_users"
    exit 2
  fi

  echo "certification_group=$CERTIFICATION_GROUP"
  echo "certification_users=$CERTIFICATION_USERS"
  if [ "$APPLY" -ne 1 ]; then
    echo "MODE=dry_run"
    echo "would_mark_source=$EGRESS_ID"
    tr ',' '\n' <<< "$CERTIFICATION_USERS" | awk 'NF {print "would_mark_user="$0}'
    echo "ACTION=none"
    echo "To apply: v7-egress-set-state $EGRESS_ID certification-scope --certification-users $CERTIFICATION_USERS --certification-group $CERTIFICATION_GROUP --apply"
    exit 0
  fi

  backup_ts="$(date +%Y%m%d-%H%M%S)"
  cp -a "$EGRESS_REG" "$EGRESS_REG.backup.v7-egress-certification-scope.$backup_ts"
  cp -a "$USERS_REG" "$USERS_REG.backup.v7-egress-certification-scope.$backup_ts"

  tmp_egress="$(mktemp "$STATE_DIR/.egress.registry.certification.XXXXXX")"
  tmp_users="$(mktemp "$STATE_DIR/.users.registry.certification.XXXXXX")"

  awk -v e="$EGRESS_ID" -v group="$CERTIFICATION_GROUP" '
    function has_field(key,    i) {
      for (i=1;i<=NF;i++) if ($i == key || $i ~ ("^" key "=")) return 1
      return 0
    }
    {
      if ($0 ~ ("^id=" e " ")) {
        if (!has_field("controlled_certification_source")) $0=$0 " controlled_certification_source=1"
        if (!has_field("certification_group")) $0=$0 " certification_group=" group
      }
      print
    }
  ' "$EGRESS_REG" > "$tmp_egress"

  awk -v users_csv="$CERTIFICATION_USERS" -v group="$CERTIFICATION_GROUP" '
    BEGIN {
      n=split(users_csv, parts, ",")
      for (i=1;i<=n;i++) wanted[parts[i]]=1
    }
    function has_field(key,    i) {
      for (i=1;i<=NF;i++) if ($i == key || $i ~ ("^" key "=")) return 1
      return 0
    }
    {
      ip=""
      for (i=1;i<=NF;i++) if ($i ~ /^ip=/) ip=substr($i,4)
      if (wanted[ip]) {
        if (!has_field("certification_user")) $0=$0 " certification_user=1"
        if (!has_field("certification_group")) $0=$0 " certification_group=" group
      }
      print
    }
  ' "$USERS_REG" > "$tmp_users"

  cat "$tmp_egress" > "$EGRESS_REG"
  cat "$tmp_users" > "$USERS_REG"
  rm -f "$tmp_egress" "$tmp_users"

  if command -v v7-audit-log >/dev/null 2>&1; then
    v7-audit-log "egress_certification_scope" "egress" "id=$EGRESS_ID group=$CERTIFICATION_GROUP users=$CERTIFICATION_USERS" object_type=egress object_id="$EGRESS_ID" result=OK >/dev/null 2>&1 || true
  fi

  echo "MODE=apply"
  echo "ACTION=certification_scope_marked"
  echo "egress_registry_backup=$EGRESS_REG.backup.v7-egress-certification-scope.$backup_ts"
  echo "users_registry_backup=$USERS_REG.backup.v7-egress-certification-scope.$backup_ts"
  exit 0
fi

if [ "$STATE" != "enabled" ]; then
  if command -v v7-egress-guard >/dev/null 2>&1; then
    guard_args=("$EGRESS_ID")
    if [ "$CONTROLLED_CERTIFICATION" -eq 1 ]; then
      guard_args+=("--controlled-certification")
    fi
    if ! v7-egress-guard "${guard_args[@]}"; then
      echo "ACTION=blocked"
      echo "Move assigned users away before disabling or maintenance."
      exit 2
    fi
  fi
fi

# Polygon-only hard-failure injection.  Keep the canonical registry enabled so
# the existing hard-signal owner observes the same condition as an unexpected
# interface loss.  The older controlled ``maintenance`` path disabled the
# registry after removing the interface, leaving only a scheduler race in
# which Matrix could see the failure.  This explicit action remains inside the
# existing state owner and is admitted only for one exact, unexpired,
# certification-only reservation.  Recovery is the existing ``enabled`` path.
if [ "$STATE" = "certification-failure" ]; then
  CONTROLLED_CONDITION_LABEL="certification_failure"
  validate_exact_controlled_certification_scope exact || exit 2
  echo "reservation_id=$CONTROLLED_RESERVATION_ID"
  echo "certification_group=$CONTROLLED_CERTIFICATION_GROUP"
  echo "certification_users=$CONTROLLED_ASSIGNED_USERS"
  echo "registry_enabled_preserved=1"
  echo "recovery_owner=v7-egress-set-state enabled --apply"
  if [ "$APPLY" -ne 1 ]; then
    echo "MODE=dry_run"
    echo "would_runtime=down_without_registry_disable"
    echo "ACTION=none"
    exit 0
  fi
  [ "$CONFIRM" = "INJECT_CONTROLLED_CERTIFICATION_FAILURE" ] || {
    echo "ACTION=blocked"
    echo "reason=exact_certification_failure_confirmation_required"
    exit 2
  }
  [ "$type" = "interface" ] || {
    echo "ACTION=blocked"
    echo "reason=certification_failure_requires_interface_owner"
    exit 2
  }
  ensure_interface_down "$EGRESS_ID" "$protocol" "$ifname" "$config"
  rebuild_killswitch "controlled_certification_failure:$EGRESS_ID"
  if command -v v7-audit-log >/dev/null 2>&1; then
    v7-audit-log "controlled_certification_failure" "egress" "id=$EGRESS_ID reservation_id=$CONTROLLED_RESERVATION_ID users=$CONTROLLED_ASSIGNED_USERS" object_type=egress object_id="$EGRESS_ID" result=OK >/dev/null 2>&1 || true
  fi
  echo "MODE=apply"
  echo "ACTION=controlled_certification_failure_injected"
  echo "registry_enabled_preserved=1"
  echo "users_moved=0"
  echo "ordinary_users_affected=0"
  exit 0
fi

# Polygon-only Telegram failure injection.  This intentionally does not take
# the interface down: it creates one ephemeral nftables table which rejects
# TCP/443 only to the documented Telegram targets and only on the isolated
# certification source interface.  The exact same existing owner removes the
# table after the automatic transaction; no registry, timer or second truth
# source is introduced.
if [ "$STATE" = "certification-telegram-failure" ]; then
  CONTROLLED_CONDITION_LABEL="certification_telegram_failure"
  validate_exact_controlled_certification_scope exact || exit 2
  safe_id "$ifname" || {
    echo "ACTION=blocked"
    echo "reason=certification_telegram_failure_interface_unsafe"
    exit 2
  }
  command -v nft >/dev/null 2>&1 || {
    echo "ACTION=blocked"
    echo "reason=certification_telegram_failure_nft_unavailable"
    exit 2
  }
  telegram_targets="$(telegram_ipv4_targets)"
  [ -n "$telegram_targets" ] || {
    echo "ACTION=blocked"
    echo "reason=certification_telegram_failure_targets_unresolved"
    exit 2
  }
  telegram_table="$(telegram_table_name)"
  if nft list table inet "$telegram_table" >/dev/null 2>&1; then
    echo "ACTION=blocked"
    echo "reason=certification_telegram_failure_existing_condition_residue"
    exit 2
  fi
  echo "reservation_id=$CONTROLLED_RESERVATION_ID"
  echo "certification_group=$CONTROLLED_CERTIFICATION_GROUP"
  echo "certification_users=$CONTROLLED_ASSIGNED_USERS"
  echo "telegram_targets=$telegram_targets"
  echo "telegram_table=$telegram_table"
  echo "registry_enabled_preserved=1"
  echo "recovery_owner=v7-egress-set-state certification-telegram-recovery --apply"
  if [ "$APPLY" -ne 1 ]; then
    echo "MODE=dry_run"
    echo "would_runtime=telegram_tcp_443_reject_on_exact_interface"
    echo "ACTION=none"
    exit 0
  fi
  [ "$CONFIRM" = "INJECT_CONTROLLED_CERTIFICATION_TELEGRAM_FAILURE" ] || {
    echo "ACTION=blocked"
    echo "reason=exact_certification_telegram_failure_confirmation_required"
    exit 2
  }
  nft_targets="${telegram_targets//,/\, }"
  if ! nft -f - <<EOF
table inet $telegram_table {
  set telegram_ipv4_targets {
    type ipv4_addr
    elements = { $nft_targets }
  }
  chain output {
    type filter hook output priority filter
    policy accept
    oifname "$ifname" ip daddr @telegram_ipv4_targets tcp dport 443 reject with tcp reset comment "v7 controlled Telegram certification"
  }
}
EOF
  then
    echo "ACTION=blocked"
    echo "reason=certification_telegram_failure_nft_apply_failed"
    exit 2
  fi
  if ! nft list table inet "$telegram_table" | grep -Fq "oifname \"$ifname\""; then
    nft delete table inet "$telegram_table" >/dev/null 2>&1 || true
    echo "ACTION=blocked"
    echo "reason=certification_telegram_failure_nft_verification_failed"
    exit 2
  fi
  if command -v v7-audit-log >/dev/null 2>&1; then
    v7-audit-log "controlled_certification_telegram_failure" "egress" "id=$EGRESS_ID reservation_id=$CONTROLLED_RESERVATION_ID users=$CONTROLLED_ASSIGNED_USERS table=$telegram_table targets=$telegram_targets" object_type=egress object_id="$EGRESS_ID" result=OK >/dev/null 2>&1 || true
  fi
  echo "MODE=apply"
  echo "ACTION=controlled_certification_telegram_failure_injected"
  echo "registry_enabled_preserved=1"
  echo "users_moved=0"
  echo "ordinary_users_affected=0"
  exit 0
fi

if [ "$STATE" = "certification-telegram-recovery" ]; then
  CONTROLLED_CONDITION_LABEL="certification_telegram_recovery"
  validate_exact_controlled_certification_scope released || exit 2
  command -v nft >/dev/null 2>&1 || {
    echo "ACTION=blocked"
    echo "reason=certification_telegram_recovery_nft_unavailable"
    exit 2
  }
  telegram_table="$(telegram_table_name)"
  echo "reservation_id=$CONTROLLED_RESERVATION_ID"
  echo "telegram_table=$telegram_table"
  echo "registry_enabled_preserved=1"
  if [ "$APPLY" -ne 1 ]; then
    echo "MODE=dry_run"
    nft list table inet "$telegram_table" >/dev/null 2>&1 && echo "would_runtime=remove_telegram_condition" || echo "would_runtime=already_recovered"
    echo "ACTION=none"
    exit 0
  fi
  [ "$CONFIRM" = "RECOVER_CONTROLLED_CERTIFICATION_TELEGRAM_FAILURE" ] || {
    echo "ACTION=blocked"
    echo "reason=exact_certification_telegram_recovery_confirmation_required"
    exit 2
  }
  if nft list table inet "$telegram_table" >/dev/null 2>&1; then
    nft delete table inet "$telegram_table" || {
      echo "ACTION=blocked"
      echo "reason=certification_telegram_recovery_nft_remove_failed"
      exit 2
    }
    action="controlled_certification_telegram_failure_recovered"
  else
    action="controlled_certification_telegram_failure_already_recovered"
  fi
  if command -v v7-audit-log >/dev/null 2>&1; then
    v7-audit-log "controlled_certification_telegram_recovery" "egress" "id=$EGRESS_ID reservation_id=$CONTROLLED_RESERVATION_ID table=$telegram_table action=$action" object_type=egress object_id="$EGRESS_ID" result=OK >/dev/null 2>&1 || true
  fi
  echo "MODE=apply"
  echo "ACTION=$action"
  echo "users_moved=0"
  echo "ordinary_users_affected=0"
  exit 0
fi

if [ "$APPLY" -ne 1 ]; then
  echo "MODE=dry_run"
  if [ "$type" = "interface" ]; then
    if [ "$STATE" = "enabled" ]; then
      echo "would_runtime=up"
      interface_live "$ifname" && echo "interface_live=1" || echo "interface_live=0"
    else
      echo "would_runtime=down"
      interface_live "$ifname" && echo "interface_live=1" || echo "interface_live=0"
    fi
  else
    echo "would_runtime=unchanged"
  fi
  echo "ACTION=none"
  echo "To apply: v7-egress-set-state $EGRESS_ID $STATE --apply"
  exit 0
fi

if [ "$type" = "interface" ]; then
  if [ "$STATE" = "enabled" ]; then
    ensure_interface_up "$EGRESS_ID" "$protocol" "$ifname" "$config"
  else
    ensure_interface_down "$EGRESS_ID" "$protocol" "$ifname" "$config"
  fi
fi

backup_ts="$(date +%Y%m%d-%H%M%S)"
cp -a "$EGRESS_REG" "$EGRESS_REG.backup.v7-egress-set-state.$backup_ts"
touch "$FLAGS"
cp -a "$FLAGS" "$FLAGS.backup.v7-egress-set-state.$backup_ts"

enabled_value=1
[ "$STATE" = "enabled" ] || enabled_value=0

awk -v id="$EGRESS_ID" -v enabled="$enabled_value" '
  $0 ~ "^id=" id " " {
    if ($0 ~ / enabled=[^ ]+/) sub(/ enabled=[^ ]+/, " enabled=" enabled)
    else $0 = $0 " enabled=" enabled
  }
  {print}
' "$EGRESS_REG" > "$EGRESS_REG.tmp"
mv "$EGRESS_REG.tmp" "$EGRESS_REG"

grep -v "^${EGRESS_ID}_state=" "$FLAGS" > "$FLAGS.tmp" 2>/dev/null || true
echo "${EGRESS_ID}_state=${STATE}" >> "$FLAGS.tmp"
mv "$FLAGS.tmp" "$FLAGS"

if [ "$type" = "interface" ]; then
  rebuild_killswitch "egress_state_changed:$EGRESS_ID:$STATE"
fi

if command -v v7-audit-log >/dev/null 2>&1; then
  v7-audit-log "egress_set_state" "egress" "id=$EGRESS_ID state=$STATE enabled=$enabled_value interface=$ifname" object_type=egress object_id="$EGRESS_ID" result=OK >/dev/null 2>&1 || true
fi

echo "V7_EGRESS_SET_STATE=OK"
echo "egress_registry_backup=$EGRESS_REG.backup.v7-egress-set-state.$backup_ts"
echo "flags_backup=$FLAGS.backup.v7-egress-set-state.$backup_ts"
