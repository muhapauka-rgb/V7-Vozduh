#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${V7_STATE_DIR:-/opt/v7/egress/state}"
EGRESS_REG="${V7_EGRESS_REGISTRY:-$STATE_DIR/egress.registry}"
USERS_REG="${V7_USERS_REGISTRY:-$STATE_DIR/users.registry}"
FLAGS="$STATE_DIR/egress-flags.state"
EGRESS_ID="${1:-}"
STATE="${2:-}"
APPLY=0
CONTROLLED_CERTIFICATION=0
CERTIFICATION_USERS=""
CERTIFICATION_GROUP="controlled-production"

usage() {
  echo "Usage: v7-egress-set-state <egress_id> <enabled|disabled|maintenance|certification-scope> [--apply] [--controlled-certification] [--certification-users ip1,ip2] [--certification-group name]" >&2
}

while [ "$#" -gt 2 ]; do
  arg="$3"
  case "$arg" in
    --apply)
      APPLY=1
      shift
      ;;
    --controlled-certification)
      CONTROLLED_CERTIFICATION=1
      shift
      ;;
    --certification-users)
      [ "$#" -ge 4 ] || { echo "missing value for --certification-users" >&2; usage; exit 1; }
      CERTIFICATION_USERS="$4"
      shift 2
      ;;
    --certification-group)
      [ "$#" -ge 4 ] || { echo "missing value for --certification-group" >&2; usage; exit 1; }
      CERTIFICATION_GROUP="$4"
      shift 2
      ;;
    *)
      echo "unknown option: $arg" >&2
      usage
      exit 1
      ;;
  esac
done

safe_id() {
  [[ "${1:-}" =~ ^[A-Za-z0-9_.-]{1,64}$ ]]
}

safe_ip_list() {
  [[ "${1:-}" =~ ^[0-9A-Fa-f:.,]+$ ]]
}

safe_group() {
  [[ "${1:-}" =~ ^[A-Za-z0-9_.-]{1,64}$ ]]
}

kv_get() {
  local line="$1"
  local key="$2"
  awk -v key="$key" '{
    for (i = 1; i <= NF; i++) {
      split($i, a, "=")
      if (a[1] == key) {
        sub("^[^=]+=", "", $i)
        print $i
        exit
      }
    }
  }' <<< "$line"
}

interface_live() {
  local ifname="$1"
  [ -n "$ifname" ] && [ -e "/sys/class/net/$ifname" ]
}

quick_bin_for_protocol() {
  local protocol="$1"
  case "$protocol" in
    amneziawg) command -v awg-quick || true ;;
    wireguard) command -v wg-quick || true ;;
    openvpn) command -v openvpn || true ;;
    *) echo "" ;;
  esac
}

address_conflicts() {
  local ifname="$1"
  local config="$2"
  awk -F= 'tolower($1) ~ /^[[:space:]]*address[[:space:]]*$/ {print $2}' "$config" |
    tr ',' '\n' |
    sed 's/^[[:space:]]*//;s/[[:space:]]*$//' |
    while read -r cidr; do
      [ -n "$cidr" ] || continue
      ip -o addr show | awk -v cidr="$cidr" -v ifname="$ifname" '$4 == cidr && $2 != ifname {print $2 ":" $4}'
    done
}

ensure_interface_up() {
  local id="$1"
  local protocol="$2"
  local ifname="$3"
  local config="$4"
  if [ "$protocol" != "amneziawg" ] && [ "$protocol" != "wireguard" ] && [ "$protocol" != "openvpn" ]; then
    echo "unsupported interface protocol: $protocol"
    return 1
  fi
  [ -n "$ifname" ] || { echo "egress has no interface: $id"; return 1; }
  [ -r "$config" ] || { echo "egress config not readable: $config"; return 1; }
  if interface_live "$ifname"; then
    echo "interface_already_up=$ifname"
    return 0
  fi
  if [ "$protocol" = "openvpn" ]; then
    local openvpn
    openvpn="$(quick_bin_for_protocol "$protocol")"
    [ -n "$openvpn" ] || { echo "openvpn missing"; return 1; }
    local systemd_unit=""
    if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files "v7-egress-openvpn@.service" --no-legend 2>/dev/null | grep -q '^v7-egress-openvpn@.service'; then
      systemd_unit="v7-egress-openvpn@$ifname.service"
      echo "runtime_up=systemctl start $systemd_unit"
      systemctl reset-failed "$systemd_unit" >/dev/null 2>&1 || true
      systemctl start "$systemd_unit"
    else
      local pid_file="$STATE_DIR/openvpn-$EGRESS_ID.pid"
      echo "runtime_up=$openvpn --config $config --daemon --writepid $pid_file"
      "$openvpn" --config "$config" --daemon "v7-egress-$EGRESS_ID" --writepid "$pid_file"
    fi
    for _ in $(seq 1 30); do
      if interface_live "$ifname"; then
        if [ -n "$systemd_unit" ]; then
          sleep 1
          if systemctl is-active --quiet "$systemd_unit" && interface_live "$ifname"; then
            echo "interface_up=$ifname"
            return 0
          fi
        else
          echo "interface_up=$ifname"
          return 0
        fi
      fi
      if [ -n "$systemd_unit" ]; then
        local sub_state
        sub_state="$(systemctl show "$systemd_unit" -p SubState --value 2>/dev/null || true)"
        if [ "$sub_state" = "auto-restart" ] || [ "$sub_state" = "failed" ]; then
          echo "openvpn_unit_failed=$systemd_unit sub_state=$sub_state"
          journalctl -u "$systemd_unit" --no-pager -n 40 2>/dev/null || true
          return 1
        fi
      fi
      sleep 1
    done
    echo "interface_not_created=$ifname"
    return 1
  fi
  local conflicts
  conflicts="$(address_conflicts "$ifname" "$config" | paste -sd ',' -)"
  if [ -n "$conflicts" ]; then
    echo "address_conflict=$conflicts"
    return 1
  fi
  local quick
  quick="$(quick_bin_for_protocol "$protocol")"
  [ -n "$quick" ] || { echo "quick tool missing for protocol: $protocol"; return 1; }
  echo "runtime_up=$quick up $config"
  "$quick" up "$config"
  if ! interface_live "$ifname"; then
    echo "interface_not_created=$ifname"
    return 1
  fi
  echo "interface_up=$ifname"
}

ensure_interface_down() {
  local id="$1"
  local protocol="$2"
  local ifname="$3"
  local config="$4"
  if [ "$protocol" != "amneziawg" ] && [ "$protocol" != "wireguard" ] && [ "$protocol" != "openvpn" ]; then
    echo "unsupported interface protocol: $protocol"
    return 1
  fi
  [ -n "$ifname" ] || { echo "egress has no interface: $id"; return 1; }
  if ! interface_live "$ifname"; then
    echo "interface_already_down=$ifname"
    return 0
  fi
  if [ "$protocol" = "openvpn" ]; then
    if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files "v7-egress-openvpn@.service" --no-legend 2>/dev/null | grep -q '^v7-egress-openvpn@.service'; then
      echo "runtime_down=systemctl stop v7-egress-openvpn@$ifname.service"
      systemctl stop "v7-egress-openvpn@$ifname.service" || true
    else
      local pid_file="$STATE_DIR/openvpn-$EGRESS_ID.pid"
      if [ -s "$pid_file" ]; then
        echo "runtime_down=kill $(cat "$pid_file")"
        kill "$(cat "$pid_file")" 2>/dev/null || true
      else
        echo "runtime_down=pkill -f openvpn.*$config"
        pkill -f "openvpn.*$config" 2>/dev/null || true
      fi
    fi
    for _ in $(seq 1 15); do
      interface_live "$ifname" || { echo "interface_down=$ifname"; return 0; }
      sleep 1
    done
    echo "interface_still_up=$ifname"
    return 1
  fi
  [ -r "$config" ] || { echo "egress config not readable: $config"; return 1; }
  local quick
  quick="$(quick_bin_for_protocol "$protocol")"
  [ -n "$quick" ] || { echo "quick tool missing for protocol: $protocol"; return 1; }
  echo "runtime_down=$quick down $config"
  "$quick" down "$config"
  if interface_live "$ifname"; then
    echo "interface_still_up=$ifname"
    return 1
  fi
  echo "interface_down=$ifname"
}

rebuild_killswitch() {
  local reason="$1"
  if ! command -v v7-killswitch-enable >/dev/null 2>&1; then
    echo "killswitch_rebuild=skipped missing_tool"
    return 0
  fi

  echo "killswitch_rebuild=running reason=$reason"
  if v7-killswitch-enable >/tmp/v7-egress-set-state-killswitch.log 2>&1; then
    echo "killswitch_rebuild=OK"
    return 0
  fi

  local rc="$?"
  echo "killswitch_rebuild=FAIL rc=$rc"
  sed -n '1,80p' /tmp/v7-egress-set-state-killswitch.log 2>/dev/null || true
  return "$rc"
}

[ -n "$EGRESS_ID" ] && [ -n "$STATE" ] || { usage; exit 1; }
safe_id "$EGRESS_ID" || { echo "unsafe egress id: $EGRESS_ID"; exit 1; }
case "$STATE" in
  enabled|disabled|maintenance|certification-scope) ;;
  *) usage; exit 1 ;;
esac
safe_group "$CERTIFICATION_GROUP" || { echo "unsafe certification group: $CERTIFICATION_GROUP"; exit 1; }
if [ "$STATE" = "certification-scope" ]; then
  [ -n "$CERTIFICATION_USERS" ] || { echo "missing --certification-users for certification-scope"; exit 1; }
  safe_ip_list "$CERTIFICATION_USERS" || { echo "unsafe certification users list"; exit 1; }
fi

line="$(grep "^id=${EGRESS_ID} " "$EGRESS_REG" 2>/dev/null || true)"
[ -n "$line" ] || { echo "FAIL: egress not found: $EGRESS_ID"; exit 1; }

protocol="$(kv_get "$line" protocol)"
type="$(kv_get "$line" type)"
ifname="$(kv_get "$line" interface)"
config="$(kv_get "$line" config)"
[ -n "$config" ] || config="$(kv_get "$line" config_path)"
enabled_now="$(kv_get "$line" enabled)"
[ -n "$enabled_now" ] || enabled_now=1

echo "===== V7 EGRESS SET STATE ====="
date -Is
echo "egress=$EGRESS_ID"
echo "requested_state=$STATE"
echo "protocol=$protocol"
echo "type=$type"
echo "interface=$ifname"
echo "config=$config"
echo "enabled_now=$enabled_now"

if [ "$STATE" = "certification-scope" ]; then
  [ -r "$USERS_REG" ] || { echo "FAIL: users registry not readable: $USERS_REG"; exit 1; }
  missing_certification_users="$(tr ',' '\n' <<< "$CERTIFICATION_USERS" | awk 'NF {print}' | while read -r ip; do
    awk -v ip="$ip" -v e="$EGRESS_ID" '
      $0 ~ "enabled=1" {
        row_ip=""; current=""
        for (i=1;i<=NF;i++) {
          if ($i ~ /^ip=/) row_ip=substr($i,4)
          if ($i ~ /^current=/) current=substr($i,9)
        }
        if (row_ip == ip && current == e) found=1
      }
      END {exit(found ? 0 : 1)}
    ' "$USERS_REG" || echo "$ip"
  done | paste -sd ',' -)"
  if [ -n "$missing_certification_users" ]; then
    echo "ACTION=blocked"
    echo "reason=certification_users_not_enabled_on_source"
    echo "missing_or_wrong_source=$missing_certification_users"
    exit 2
  fi

  echo "certification_group=$CERTIFICATION_GROUP"
  echo "certification_users=$CERTIFICATION_USERS"
  if [ "$APPLY" -ne 1 ]; then
    echo "MODE=dry_run"
    echo "would_mark_source=$EGRESS_ID"
    tr ',' '\n' <<< "$CERTIFICATION_USERS" | awk 'NF {print "would_mark_user="$0}'
    echo "ACTION=none"
    echo "To apply: v7-egress-set-state $EGRESS_ID certification-scope --certification-users $CERTIFICATION_USERS --certification-group $CERTIFICATION_GROUP --apply"
    exit 0
  fi

  backup_ts="$(date +%Y%m%d-%H%M%S)"
  cp -a "$EGRESS_REG" "$EGRESS_REG.backup.v7-egress-certification-scope.$backup_ts"
  cp -a "$USERS_REG" "$USERS_REG.backup.v7-egress-certification-scope.$backup_ts"

  tmp_egress="$(mktemp "$STATE_DIR/.egress.registry.certification.XXXXXX")"
  tmp_users="$(mktemp "$STATE_DIR/.users.registry.certification.XXXXXX")"

  awk -v e="$EGRESS_ID" -v group="$CERTIFICATION_GROUP" '
    function has_field(key,    i) {
      for (i=1;i<=NF;i++) if ($i == key || $i ~ ("^" key "=")) return 1
      return 0
    }
    {
      if ($0 ~ ("^id=" e " ")) {
        if (!has_field("controlled_certification_source")) $0=$0 " controlled_certification_source=1"
        if (!has_field("certification_group")) $0=$0 " certification_group=" group
      }
      print
    }
  ' "$EGRESS_REG" > "$tmp_egress"

  awk -v users_csv="$CERTIFICATION_USERS" -v group="$CERTIFICATION_GROUP" '
    BEGIN {
      n=split(users_csv, parts, ",")
      for (i=1;i<=n;i++) wanted[parts[i]]=1
    }
    function has_field(key,    i) {
      for (i=1;i<=NF;i++) if ($i == key || $i ~ ("^" key "=")) return 1
      return 0
    }
    {
      ip=""
      for (i=1;i<=NF;i++) if ($i ~ /^ip=/) ip=substr($i,4)
      if (wanted[ip]) {
        if (!has_field("certification_user")) $0=$0 " certification_user=1"
        if (!has_field("certification_group")) $0=$0 " certification_group=" group
      }
      print
    }
  ' "$USERS_REG" > "$tmp_users"

  cat "$tmp_egress" > "$EGRESS_REG"
  cat "$tmp_users" > "$USERS_REG"
  rm -f "$tmp_egress" "$tmp_users"

  if command -v v7-audit-log >/dev/null 2>&1; then
    v7-audit-log "egress_certification_scope" "egress" "id=$EGRESS_ID group=$CERTIFICATION_GROUP users=$CERTIFICATION_USERS" object_type=egress object_id="$EGRESS_ID" result=OK >/dev/null 2>&1 || true
  fi

  echo "MODE=apply"
  echo "ACTION=certification_scope_marked"
  echo "egress_registry_backup=$EGRESS_REG.backup.v7-egress-certification-scope.$backup_ts"
  echo "users_registry_backup=$USERS_REG.backup.v7-egress-certification-scope.$backup_ts"
  exit 0
fi

if [ "$STATE" != "enabled" ]; then
  if command -v v7-egress-guard >/dev/null 2>&1; then
    guard_args=("$EGRESS_ID")
    if [ "$CONTROLLED_CERTIFICATION" -eq 1 ]; then
      guard_args+=("--controlled-certification")
    fi
    if ! v7-egress-guard "${guard_args[@]}"; then
      echo "ACTION=blocked"
      echo "Move assigned users away before disabling or maintenance."
      exit 2
    fi
  fi
fi

if [ "$APPLY" -ne 1 ]; then
  echo "MODE=dry_run"
  if [ "$type" = "interface" ]; then
    if [ "$STATE" = "enabled" ]; then
      echo "would_runtime=up"
      interface_live "$ifname" && echo "interface_live=1" || echo "interface_live=0"
    else
      echo "would_runtime=down"
      interface_live "$ifname" && echo "interface_live=1" || echo "interface_live=0"
    fi
  else
    echo "would_runtime=unchanged"
  fi
  echo "ACTION=none"
  echo "To apply: v7-egress-set-state $EGRESS_ID $STATE --apply"
  exit 0
fi

if [ "$type" = "interface" ]; then
  if [ "$STATE" = "enabled" ]; then
    ensure_interface_up "$EGRESS_ID" "$protocol" "$ifname" "$config"
  else
    ensure_interface_down "$EGRESS_ID" "$protocol" "$ifname" "$config"
  fi
fi

backup_ts="$(date +%Y%m%d-%H%M%S)"
cp -a "$EGRESS_REG" "$EGRESS_REG.backup.v7-egress-set-state.$backup_ts"
touch "$FLAGS"
cp -a "$FLAGS" "$FLAGS.backup.v7-egress-set-state.$backup_ts"

enabled_value=1
[ "$STATE" = "enabled" ] || enabled_value=0

awk -v id="$EGRESS_ID" -v enabled="$enabled_value" '
  $0 ~ "^id=" id " " {
    if ($0 ~ / enabled=[^ ]+/) sub(/ enabled=[^ ]+/, " enabled=" enabled)
    else $0 = $0 " enabled=" enabled
  }
  {print}
' "$EGRESS_REG" > "$EGRESS_REG.tmp"
mv "$EGRESS_REG.tmp" "$EGRESS_REG"

grep -v "^${EGRESS_ID}_state=" "$FLAGS" > "$FLAGS.tmp" 2>/dev/null || true
echo "${EGRESS_ID}_state=${STATE}" >> "$FLAGS.tmp"
mv "$FLAGS.tmp" "$FLAGS"

if [ "$type" = "interface" ]; then
  rebuild_killswitch "egress_state_changed:$EGRESS_ID:$STATE"
fi

if command -v v7-audit-log >/dev/null 2>&1; then
  v7-audit-log "egress_set_state" "egress" "id=$EGRESS_ID state=$STATE enabled=$enabled_value interface=$ifname" object_type=egress object_id="$EGRESS_ID" result=OK >/dev/null 2>&1 || true
fi

echo "V7_EGRESS_SET_STATE=OK"
echo "egress_registry_backup=$EGRESS_REG.backup.v7-egress-set-state.$backup_ts"
echo "flags_backup=$FLAGS.backup.v7-egress-set-state.$backup_ts"
