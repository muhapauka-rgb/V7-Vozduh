def transaction_packet_constraints_ok(packet: dict[str, Any], cycle: dict[str, Any], max_users: int) -> dict[str, Any]:
    constraints = packet.get("constraints") if isinstance(packet.get("constraints"), dict) else {}
    expected = packet.get("expected") if isinstance(packet.get("expected"), dict) else {}
    action_class = str(
        ((cycle.get("action_class_runtime_enablement") or {}).get("current_action_class"))
        or ((cycle.get("runtime_capability_view") or {}).get("runtime_capability"))
        or ""
    )
    users = [str(item) for item in (constraints.get("allowed_users") or []) if str(item)]
    targets = [str(item) for item in (constraints.get("allowed_targets") or []) if str(item)]
    selected_count = int(expected.get("selected_move_count") or 0)
    errors: list[str] = []
    if action_class != "single-user governed candidate failover":
        errors.append("action_class_changed")
    if selected_count != 1:
        errors.append("selected_move_count_not_one")
    if len(users) != 1:
        errors.append("user_scope_not_one")
    if len(targets) != 1:
        errors.append("target_scope_not_one")
    if max_users != 1:
        errors.append("transaction_max_users_not_one")
    return {
        "ok": not errors,
        "errors": errors,
        "action_class": action_class,
        "users": users,
        "targets": targets,
        "selected_move_count": selected_count,
    }


def autoswitch_apply_timeout_seconds(max_users: int) -> int:
    users = max(1, int(max_users or 1))
    return min(900, max(90, 60 + users * 30))


def run_autoswitch_apply(
    *,
    state_dir: Path,
    event_dir: Path,
    snapshot_root: Path,
    restore_barrier_file: Path,
    user: str = "",
    target: str = "",
    source: str = "",
    max_users: int = 1,
    packet_id: str = "",
    operation_id: str = "",
    selected_move_hash: str = "",
    authority_generation: str = "",
    breaker_generation: str = "",
    source_bundle_hash: str = "",
    snapshot_bundle_hash: str = "",
    execution_control_file: str = "",
    emergency_failover_autonomy: bool = False,
) -> dict[str, Any]:
    timeout_seconds = autoswitch_apply_timeout_seconds(max_users)
    command = [
        str(planner_observe_executable()),
        "--mode",
        "guarded",
        "--max-selected-moves",
        str(max(1, int(max_users))),
        "--state-dir",
        str(state_dir),
        "--event-dir",
        str(event_dir),
        "--intelligence-snapshot-root",
        str(snapshot_root),
        "--restore-barrier-file",
        str(restore_barrier_file),
        "--apply",
        "--verify",
        "--allow-pre-planner-refresh-with-apply",
        "--pretty",
    ]
    if user:
        command.extend(["--user", user])
    if source:
        command.extend(["--source-egress", source])
    if target:
        command.extend(["--target-egress", target])
    if packet_id:
        command.extend(["--approved-packet-id", packet_id])
    if operation_id:
        command.extend(["--approved-operation-id", operation_id])
    if selected_move_hash:
        command.extend(["--approved-selected-move-hash", selected_move_hash])
    if authority_generation:
        command.extend(["--approved-authority-generation", authority_generation])
    if breaker_generation:
        command.extend(["--approved-breaker-generation", breaker_generation])
    if source_bundle_hash:
        command.extend(["--approved-source-bundle-hash", source_bundle_hash])
    if snapshot_bundle_hash:
        command.extend(["--approved-snapshot-bundle-hash", snapshot_bundle_hash])
    if execution_control_file:
        command.extend(["--execution-control-file", execution_control_file])
    if emergency_failover_autonomy:
        command.insert(1, "--emergency-failover-autonomy")
    try:
        proc = subprocess.run(command, capture_output=True, text=True, timeout=timeout_seconds)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "ok": False,
            "command": command,
            "returncode": 124,
            "error": str(exc),
            "payload": {},
            "timeout_seconds": timeout_seconds,
        }
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        payload = {}
    return {
        "ok": proc.returncode == 0 and isinstance(payload, dict),
        "command": command,
        "returncode": proc.returncode,
        "payload": payload if isinstance(payload, dict) else {},
        "stderr_tail": proc.stderr[-1200:],
        "stdout_tail": proc.stdout[-1200:] if not isinstance(payload, dict) else "",
        "timeout_seconds": timeout_seconds,
    }


def lease_terminal_status_from_apply(payload: dict[str, Any]) -> str:
    operation = payload.get("operation") if isinstance(payload.get("operation"), dict) else {}
    apply_result = payload.get("apply_result") if isinstance(payload.get("apply_result"), dict) else {}
    terminal = str(operation.get("terminal_state") or "")
    rollback = str(operation.get("rollback_verdict") or "")
    if terminal in {"ROLLED_BACK", "ROLLBACK_COMPLETED"} or rollback in {"ROLLBACK_COMPLETED", "ROLLED_BACK"}:
        return "ROLLBACK_FINISHED"
    if apply_result.get("applied"):
        return "EXECUTION_FINISHED"
    return "OPERATOR_CANCELLED"


def l3_production_validation_proof_quality(apply_run: dict[str, Any], apply_payload: dict[str, Any]) -> dict[str, Any]:
    blockers: list[str] = []
    apply_result = apply_payload.get("apply_result") if isinstance(apply_payload.get("apply_result"), dict) else {}
    operation = apply_payload.get("operation") if isinstance(apply_payload.get("operation"), dict) else {}
    rows = [row for row in (apply_result.get("results") or []) if isinstance(row, dict)]

    def row_verified(row: dict[str, Any]) -> bool:
        if int(row.get("verify_rc", 1)) != 0:
            return False
        if row.get("service_verify_rc") is not None and int(row.get("service_verify_rc", 1)) != 0:
            return False
        return True

    if not apply_run.get("ok"):
        blockers.append("autoswitch_apply_command_failed")
    if not apply_result.get("applied"):
        blockers.append("runtime_apply_not_performed")
    if not rows:
        blockers.append("verification_results_missing")

    verification_failures = [
        {
            "user_ip": str(row.get("user_ip") or row.get("user") or ""),
            "verify_rc": row.get("verify_rc"),
            "from": str(row.get("from") or ""),
            "to": str(row.get("to") or ""),
        }
        for row in rows
        if not row_verified(row)
    ]
    if verification_failures:
        blockers.append("verification_failed")

    rollback_failures = [
        {
            "user_ip": str(row.get("user_ip") or row.get("user") or ""),
            "rollback_rc": row.get("rollback_rc"),
            "from": str(row.get("from") or ""),
            "to": str(row.get("to") or ""),
        }
        for row in rows
        if row.get("rollback_rc") is not None and int(row.get("rollback_rc", 1)) != 0
    ]
    rollback_verdict = str(operation.get("rollback_verdict") or "")
    if rollback_failures or rollback_verdict in {"ROLLBACK_FAILED", "ROLLBACK_FAILURE", "CONTAINMENT_FAILED_OPERATOR_REVIEW_REQUIRED"}:
        blockers.append("rollback_failed")

    verified_successes = [
        {
            "user_ip": str(row.get("user_ip") or row.get("user") or ""),
            "from": str(row.get("from") or ""),
            "to": str(row.get("to") or ""),
        }
        for row in rows
        if row_verified(row)
    ]
    return {
        "ok": not blockers,
        "blockers": sorted(set(blockers)),
        "verified_success_count": len(verified_successes),
        "verified_successes": verified_successes,
        "verification_failures": verification_failures,
        "rollback_failures": rollback_failures,
        "apply_returncode": apply_run.get("returncode"),
        "apply_ok": bool(apply_run.get("ok")),
    }


def materialize_governed_transaction_feedback(
    *,
    state_dir: Path,
    packet: dict[str, Any],
    operation: dict[str, Any],
    apply_result: dict[str, Any],
    user: str,
    source: str,
    target: str,
    rollback_attempted: bool,
    verification_passed: bool,
    evidence_class: str = "CONTROLLED_PRODUCTION",
) -> dict[str, Any]:
    if not apply_result.get("applied"):
        return {
            "materialized": False,
            "reason": "apply_not_executed",
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }
    packet_id = str(packet.get("packet_id") or "")
    selected_move_hash = str((packet.get("expected") or {}).get("selected_move_hash") or "")
    operation_terminal_state = str(operation.get("terminal_state") or "")
    rows = [row for row in (apply_result.get("results") or []) if isinstance(row, dict)]
    if not rows:
        rows = [{
            "user_ip": user,
            "from": source,
            "to": target,
            "rc": 0 if verification_passed else 1,
            "verify_rc": 0 if verification_passed else 1,
            "rollback_attempted": rollback_attempted,
        }]
    per_user_feedback: list[dict[str, Any]] = []
    record_keys: set[str] = set()
    for row in rows:
        row_user = str(row.get("user_ip") or user or "")
        row_source = str(row.get("from") or source or "")
        row_target = str(row.get("to") or target or "")
        row_rollback_attempted = bool(row.get("rollback_attempted") or row.get("rollback_rc") is not None)
        row_verification_passed = (
            row.get("rc") in (None, 0)
            and row.get("verify_rc") in (None, 0)
            and row.get("service_verify_rc") in (None, 0)
            and not row_rollback_attempted
        )
        row_rollback_verdict = str(row.get("rollback_verdict") or operation.get("rollback_verdict") or ("NOT_REQUIRED" if not row_rollback_attempted else ""))
        terminal_outcome_classification = str(row.get("terminal_outcome_classification") or "")
        if not terminal_outcome_classification:
            if row_verification_passed:
                terminal_outcome_classification = "SUCCESS"
            elif row_rollback_verdict in {"ROLLBACK_COMPLETED", "ROLLED_BACK"}:
                terminal_outcome_classification = "ROLLBACK_SUCCESS"
            elif row_rollback_attempted:
                terminal_outcome_classification = "ROLLBACK_FAILURE"
            else:
                terminal_outcome_classification = "APPLY_FAILURE"
        execution_result = {
            "success": terminal_outcome_classification == "SUCCESS",
            "result": "applied" if terminal_outcome_classification == "SUCCESS" else terminal_outcome_classification.lower(),
            "terminal_state": operation_terminal_state,
            "terminal_reason": str(operation.get("terminal_reason") or ""),
            "terminal_outcome_classification": terminal_outcome_classification,
            "packet_id": packet_id,
            "decision_id": str(packet.get("decision_id") or ""),
            "operation_id": str(packet.get("operation_id") or operation.get("operation_id") or ""),
            "selected_move_hash": selected_move_hash,
            "selected_moves": [{"user": row_user, "from": row_source, "target": row_target, "to": row_target}],
            "apply_result": {"applied": True, "results": [row]},
            "runtime_mutation_performed": True,
            "users_moved": 1,
        }
        verification_result = {
            "success": bool(row_verification_passed),
            "result": "verified" if row_verification_passed else "failed",
            "packet_id": packet_id,
            "verification_passed": bool(row_verification_passed),
            "user_outcome": {
                "user": row_user,
                "source_channel": row_source,
                "target_channel": row_target,
                "connected": bool(row_verification_passed),
            },
            "service_outcome": {
                "target_channel": row_target,
                "status": "ok" if row_verification_passed else "failed",
            },
        }
        rollback_result = {
            "rollback_required": bool(row_rollback_attempted),
            "rollback_verdict": row_rollback_verdict,
            "terminal_outcome_classification": terminal_outcome_classification,
        }
        contract = operator_execution_feedback.execution_feedback_contract(
            user=row_user,
            source_channel=row_source,
            target_channel=row_target,
            execution_result=execution_result,
            verification_result=verification_result,
            rollback_result=rollback_result,
            recommendation_hash=selected_move_hash,
            prediction_expected=1.0,
            prediction_actual=1.0 if row_verification_passed else 0.0,
            audit_reference=packet_id,
            closure_reference=str(operation.get("operation_id") or packet.get("operation_id") or packet_id),
            packet_id=packet_id,
            evidence_class=evidence_class,
            decision_trace_id=str(packet.get("decision_id") or ""),
            input_snapshot_identity=str((packet.get("expected") or {}).get("snapshot_bundle_hash") or ""),
            expected_terminal=terminal_outcome_classification,
        )
        records = operator_execution_feedback.materialized_feedback_records(contract)
        append_jsonl(state_dir / "execution-events.jsonl", records["outcome"])
        append_jsonl(state_dir / "runtime-trust.jsonl", records["trust"])
        append_jsonl(state_dir / "execution-events.jsonl", records["prediction"])
        append_jsonl(state_dir / "proposal-records.jsonl", records["recommendation"])
        append_jsonl(state_dir / "closure-records.jsonl", records["closure"])
        record_keys.update(records)
        per_user_feedback.append({
            "user": row_user,
            "source": row_source,
            "target": row_target,
            "feedback_id": contract.get("feedback_id", ""),
            "outcome_status": contract.get("outcome_status", ""),
            "terminal_outcome_classification": contract.get("terminal_outcome_classification", ""),
            "outcome_quality": (contract.get("outcome_quality") or {}).get("outcome_quality", ""),
            "learning_value": (contract.get("outcome_quality") or {}).get("learning_value", ""),
            "knowledge_gained": bool((contract.get("knowledge_growth") or {}).get("knowledge_gained")),
        })
    first = per_user_feedback[0] if per_user_feedback else {}
    return {
        "materialized": True,
        "feedback_id": first.get("feedback_id", ""),
        "outcome_status": first.get("outcome_status", ""),
        "terminal_outcome_classification": first.get("terminal_outcome_classification", ""),
        "outcome_quality": first.get("outcome_quality", ""),
        "learning_value": first.get("learning_value", ""),
        "knowledge_gained": any(bool(row.get("knowledge_gained")) for row in per_user_feedback),
        "per_user_feedback": per_user_feedback,
        "records_written": sorted(record_keys),
        "runtime_mutation_performed": False,
        "users_moved": len(rows),
    }


def l3_packet_constraints_ok(
    packet: dict[str, Any],
    transition: dict[str, Any],
    max_users: int,
    *,
    authorized_l3_budget: int = 1,
) -> dict[str, Any]:
    constraints = packet.get("constraints") if isinstance(packet.get("constraints"), dict) else {}
    expected = packet.get("expected") if isinstance(packet.get("expected"), dict) else {}
    users = [str(item) for item in (constraints.get("allowed_users") or []) if str(item)]
    targets = [str(item) for item in (constraints.get("allowed_targets") or []) if str(item)]
    selected_count = int(expected.get("selected_move_count") or 0)
    moves = transition.get("selected_moves") if isinstance(transition.get("selected_moves"), list) else []
    requested = max(1, int(max_users))
    authorized = max(1, int(authorized_l3_budget))
    errors: list[str] = []
    if requested > authorized:
        errors.append("l3_validation_requested_users_above_authorized_budget")
    if selected_count < 1:
        errors.append("selected_move_count_missing")
    if selected_count > authorized:
        errors.append("selected_move_count_above_authorized_budget")
    if selected_count > requested:
        errors.append("selected_move_count_above_requested_max_users")
    if len(users) != selected_count:
        errors.append("user_scope_mismatch_selected_move_count")
    if not targets:
        errors.append("target_scope_missing")
    if len(targets) > selected_count:
        errors.append("target_scope_exceeds_selected_move_count")
    if len(moves) != selected_count:
        errors.append("transition_selected_move_count_mismatch")
    for move in moves:
        if str(move.get("move_type") or "") != "failover":
            errors.append("transition_move_type_not_failover")
    return {
        "ok": not errors,
        "errors": errors,
        "users": users,
        "targets": targets,
        "selected_move_count": selected_count,
        "requested_max_users": requested,
        "authorized_l3_budget": authorized,
        "transition_status": str(transition.get("status") or ""),
    }


