def resolved_l3_requested_max_users(args: argparse.Namespace) -> dict[str, Any]:
    """Resolve the Matrix cohort ceiling from the current Authority owner.

    ``--max-users 0`` is a dynamic binding, not an unlimited value.  It reads
    the exact audited standing policy and fails closed to one when that owner
    is absent or invalid.
    """
    requested = int(getattr(args, "max_users", 0) or 0)
    if requested > 0:
        return {
            "max_users": requested,
            "source": "explicit_cli_ceiling",
            "standing_policy_valid": False,
        }
    policy_root = read_json(Path(args.policy_file), {})
    contract = policy_root.get("delegated_autonomy_policy")
    validation = operator_execution.validate_standing_delegated_operational_policy(
        contract if isinstance(contract, dict) else {},
        audit_records=live_policy_lineage_records(args),
    )
    policy = validation.get("policy") if isinstance(validation.get("policy"), dict) else {}
    max_users = int(policy.get("max_users_per_action") or 1) if validation.get("ok") else 1
    return {
        "max_users": max(1, max_users),
        "source": "audited_standing_policy" if validation.get("ok") else "fail_closed_tier1",
        "standing_policy_valid": bool(validation.get("ok")),
        "standing_policy_contract_id": str((contract or {}).get("contract_id") or "") if isinstance(contract, dict) else "",
        "blockers": list(validation.get("errors") or []),
    }


def transaction_packet_constraints_ok(packet: dict[str, Any], cycle: dict[str, Any], max_users: int) -> dict[str, Any]:
    constraints = packet.get("constraints") if isinstance(packet.get("constraints"), dict) else {}
    expected = packet.get("expected") if isinstance(packet.get("expected"), dict) else {}
    action_class = str(
        ((cycle.get("action_class_runtime_enablement") or {}).get("current_action_class"))
        or ((cycle.get("runtime_capability_view") or {}).get("runtime_capability"))
        or ""
    )
    users = [str(item) for item in (constraints.get("allowed_users") or []) if str(item)]
    targets = [str(item) for item in (constraints.get("allowed_targets") or []) if str(item)]
    selected_count = int(expected.get("selected_move_count") or 0)
    errors: list[str] = []
    expected_action_class = operator_execution.SERVICE_FAILURE_DELEGATED_ACTION_CLASSES.get(max_users, "")
    if action_class != expected_action_class:
        errors.append("action_class_changed")
    if max_users not in operator_execution.SERVICE_FAILURE_DELEGATED_ACTION_CLASSES:
        errors.append("transaction_max_users_not_engineering_qualified")
    if selected_count < 1 or selected_count > max_users:
        errors.append("selected_move_count_outside_authorized_tier")
    if len(users) != selected_count:
        errors.append("user_scope_mismatch")
    if not targets or len(targets) > selected_count:
        errors.append("target_scope_mismatch")
    return {
        "ok": not errors,
        "errors": errors,
        "action_class": action_class,
        "users": users,
        "targets": targets,
        "selected_move_count": selected_count,
    }


def autoswitch_apply_timeout_seconds(max_users: int) -> int:
    users = max(1, int(max_users or 1))
    # A live Matrix verification includes fresh service/route probes and
    # Learning closure after the route write.  Ninety seconds was shorter than
    # one observed single-user production verification and could kill the
    # consumer after mutation but before it emitted its terminal payload.
    return min(3600, max(330, 300 + users * 30))


