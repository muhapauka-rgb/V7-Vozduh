def bind_availability_first_controlled_selection(
    plan: dict[str, Any],
    *,
    expected_users: list[str],
    source: str,
    target: str,
    allocation_fingerprint: str,
) -> dict[str, Any]:
    """Bind controlled certification identities to the existing plan.

    A healthy controlled source correctly produces no ordinary emergency
    failover move.  Availability-first certification is a different approved
    action-class context: the target still comes from the existing Planner,
    while the exact certification identities come from the governed stage
    allocation.  Reuse each Planner decision row so snapshot/source semantics
    remain canonical; do not manufacture an incident or natural evidence.
    """
    plan = plan if isinstance(plan, dict) else {}
    users = sorted({str(value) for value in expected_users if str(value)})
    source = str(source or "")
    target = str(target or "")
    allocation_fingerprint = str(allocation_fingerprint or "")
    blockers: list[str] = []
    if not users:
        blockers.append("availability_first_expected_users_missing")
    if not source:
        blockers.append("availability_first_source_missing")
    if not target:
        blockers.append("availability_first_target_missing")
    if source and source == target:
        blockers.append("availability_first_source_target_collision")
    if len(allocation_fingerprint) != 64:
        blockers.append("availability_first_allocation_fingerprint_invalid")

    decisions = [
        row for row in (plan.get("decisions") or [])
        if isinstance(row, dict)
    ]
    by_identity = {
        (
            str(row.get("user_ip") or row.get("user") or ""),
            str(row.get("current_egress") or row.get("from") or ""),
        ): row
        for row in decisions
    }
    selected: list[dict[str, Any]] = []
    for user in users:
        decision = by_identity.get((user, source))
        if not isinstance(decision, dict):
            blockers.append(
                f"availability_first_planner_identity_missing:{user}"
            )
            continue
        row = copy.deepcopy(decision)
        row.update({
            "user_ip": user,
            "current_egress": source,
            "recommended_egress": target,
            # Reuse the canonical bounded switch primitive.  Evidence
            # provenance below keeps this distinct from a natural incident.
            "move_type": "failover",
            "action": "switch",
            "availability_first_controlled_assignment": {
                "schema_version": (
                    "v7.availability-first-controlled-selection.v1"
                ),
                "event_provenance": "CONTROLLED_CERTIFICATION",
                "natural_production_credit": False,
                "source": source,
                "target": target,
                "allocation_fingerprint": allocation_fingerprint,
                "ordinary_user": False,
            },
        })
        selected.append(row)
    if blockers:
        return {
            "ok": False,
            "status": "STOP_SAFE",
            "blockers": sorted(set(blockers)),
            "plan": plan,
        }

    bound = copy.deepcopy(plan)
    bound["selected_moves"] = selected
    summary = (
        bound.get("summary")
        if isinstance(bound.get("summary"), dict)
        else {}
    )
    summary.update({
        "selected_moves": len(selected),
        "selected_move_count": len(selected),
        "execution_mode": "availability_first_controlled_certification",
        "availability_first_controlled_assignment": True,
    })
    bound["summary"] = summary
    safety = (
        bound.get("safety")
        if isinstance(bound.get("safety"), dict)
        else {}
    )
    safety["availability_first_controlled_selection"] = {
        "schema_version": "v7.availability-first-controlled-selection.v1",
        "status": "BOUND",
        "owner": (
            "tools/v7-users-autoswitch existing Planner decisions + "
            "tools/v7-governed-canary-dry-run-cycle existing action-class "
            "consumer"
        ),
        "users": users,
        "source": source,
        "target": target,
        "allocation_fingerprint": allocation_fingerprint,
        "event_provenance": "CONTROLLED_CERTIFICATION",
        "natural_production_credit": False,
        "ordinary_user_effect": "FORBIDDEN",
        "new_planner_created": False,
        "new_owner_created": False,
    }
    bound["safety"] = safety
    return {
        "ok": True,
        "status": "BOUND",
        "blockers": [],
        "plan": bound,
        "selected_users": users,
    }


def availability_first_selected_scope(
    selected: dict[str, Any],
) -> dict[str, list[str]]:
    """Read the canonical selected-move scope from its constraints contract."""
    selected = selected if isinstance(selected, dict) else {}
    constraints = (
        selected.get("constraints")
        if isinstance(selected.get("constraints"), dict)
        else {}
    )
    return {
        "users": sorted(
            str(value)
            for value in (constraints.get("allowed_users") or [])
            if str(value)
        ),
        "targets": sorted(
            str(value)
            for value in (constraints.get("allowed_targets") or [])
            if str(value)
        ),
    }


def selected_moves_from_planner_payload(payload: dict[str, Any]) -> list[dict[str, Any]]:
    safety = payload.get("safety") if isinstance(payload.get("safety"), dict) else {}
    barrier = safety.get("restore_barrier") if isinstance(safety.get("restore_barrier"), dict) else {}
    rows = payload.get("selected_moves") if isinstance(payload.get("selected_moves"), list) else []
    if not rows:
        rows = barrier.get("approved_candidate_moves_before_guard") if isinstance(barrier.get("approved_candidate_moves_before_guard"), list) else []
    if not rows:
        rows = payload.get("decisions") if isinstance(payload.get("decisions"), list) else []
    moves: list[dict[str, Any]] = []
    for row in rows:
        if not isinstance(row, dict):
            continue
        user = str(row.get("user_ip") or row.get("user") or "")
        current = str(row.get("current_egress") or row.get("from") or "")
        target = str(row.get("recommended_egress") or row.get("to") or "")
        action = str(row.get("action") or "switch")
        if user and current and target and current != target and action in {"switch", "move", ""}:
            move = {
                "user": user,
                "from": current,
                "to": target,
                "confidence": row.get("confidence", row.get("score", 0.0)),
                "risk": row.get("risk", 0.0),
                "recommendation_hash": row.get("recommendation_hash", ""),
            }
            for key in SELECTED_MOVE_SEMANTIC_FIELDS:
                if key in row:
                    move[key] = copy.deepcopy(row.get(key))
            moves.append(move)
    return moves


def merge_planner_moves_into_surface(
    surface: dict[str, Any],
    moves: list[dict[str, Any]],
    *,
    replace_existing: bool = False,
) -> dict[str, Any]:
    out = dict(surface)
    batch = dict(out.get("batch_preview") or {})
    if batch.get("users_to_move") and not replace_existing:
        return out
    if replace_existing:
        batch["users_to_move"] = []
        batch["planner_observe_authoritative"] = True
        batch["stale_snapshot_candidates_retained"] = False
    if not moves:
        out["batch_preview"] = batch
        return out
    users_by_ip = dict(out.get("users_by_ip") or {})
    for move in moves:
        user = str(move.get("user") or "")
        existing = dict(users_by_ip.get(user) or {})
        existing.update({
            "user": user,
            "current_channel": move.get("from", ""),
            "recommended_channel": move.get("to", ""),
            "confidence": move.get("confidence", existing.get("confidence", 0.0)),
            "trust": existing.get("trust", 0.0),
            "prediction": existing.get("prediction", {}),
            "risk": move.get("risk", existing.get("risk", 0.0)),
            "recommendation_hash": move.get("recommendation_hash") or existing.get("recommendation_hash", ""),
            "reasons": existing.get("reasons") or ["planner observe selected governed canary candidate"],
        })
        users_by_ip[user] = existing
    batch["users_to_move"] = moves
    out["users_by_ip"] = users_by_ip
    out["batch_preview"] = batch
    return out


def candidate_channel(row: dict[str, Any]) -> str:
    return str(
        row.get("channel")
        or row.get("egress")
        or row.get("target")
        or row.get("recommended_channel")
        or row.get("to")
        or ""
    )


def numeric_value(value: Any, default: float = 0.0) -> float:
    try:
        return float(value)
    except (TypeError, ValueError):
        return default


def blocked_a4_transaction_candidate(
    *,
    blocked_transaction_identities: set[tuple[str, str, str, str]] | None,
    user: str,
    source: str,
    target: str,
) -> bool:
    if not blocked_transaction_identities:
        return False
    return any(
        identity_user == user and identity_source == source and identity_target == target
        for _packet_id, identity_user, identity_source, identity_target in blocked_transaction_identities
    )


def select_a4_gap_reducing_candidate(
    *,
    surface: dict[str, Any],
    snapshot_root: Path,
    required_a4_candidate_keys: set[tuple[str, str]],
    blocked_transaction_identities: set[tuple[str, str, str, str]] | None = None,
) -> dict[str, Any]:
    snapshot = read_snapshot_family(snapshot_root, "candidate-suitability-summary")
    candidate_rows = snapshot.payload.get("items") if isinstance(snapshot.payload.get("items"), list) else []
    users_by_ip = surface.get("users_by_ip") if isinstance(surface.get("users_by_ip"), dict) else {}
    missing_keys = {
        (str(user), str(channel))
        for user, channel in (required_a4_candidate_keys or set())
        if str(user) and str(channel)
    }
    eligible_rows: list[dict[str, Any]] = []
    gap_rows: list[dict[str, Any]] = []
    skipped: list[dict[str, Any]] = []
    source_hash = json.dumps(snapshot.payload.get("source_hashes") or {}, sort_keys=True, ensure_ascii=True)

    for row in candidate_rows:
        if not isinstance(row, dict):
            continue
        user = str(row.get("user") or "")
        source = users_by_ip.get(user) if isinstance(users_by_ip.get(user), dict) else {}
        current = str(source.get("current_channel") or source.get("current") or "")
        for candidate in row.get("candidates") if isinstance(row.get("candidates"), list) else [row]:
            if not isinstance(candidate, dict):
                continue
            target = candidate_channel(candidate)
            key = (user, target)
            reason = ""
            if not user or not target:
                reason = "candidate_key_incomplete"
            elif not current:
                reason = "current_channel_unknown"
            elif target == current:
                reason = "candidate_is_current_state"
            elif candidate.get("eligible", candidate.get("policy_eligible", True)) is False:
                reason = "candidate_not_eligible"
            elif candidate.get("policy_eligible", True) is False:
                reason = "candidate_policy_ineligible"
            elif key not in missing_keys:
                reason = "candidate_not_missing_a4_evidence"
            elif blocked_a4_transaction_candidate(
                blocked_transaction_identities=blocked_transaction_identities,
                user=user,
                source=current,
                target=target,
            ):
                reason = "duplicate_transaction_candidate"

            entry = {
                "user": user,
                "source": current,
                "target": target,
                "candidate_key": {"user": user, "target": target},
                "missing_a4_evidence": key in missing_keys,
                "eligible": reason in {"", "candidate_not_missing_a4_evidence"},
                "skip_reason": reason,
                "evidence_value": 1 if key in missing_keys and not reason else 0,
                "suitability_score": numeric_value(candidate.get("suitability_score"), 0.0),
                "confidence": numeric_value(candidate.get("confidence"), 0.0),
                "risk": numeric_value(candidate.get("risk"), numeric_value((candidate.get("reason_breakdown") or {}).get("risk"), 0.0) if isinstance(candidate.get("reason_breakdown"), dict) else 0.0),
            }
            if reason == "candidate_not_missing_a4_evidence":
                eligible_rows.append(entry)
            elif reason:
                skipped.append(entry)
                continue
            else:
                eligible_rows.append(entry)
                gap_rows.append({
                    **entry,
                    "candidate": candidate,
                    "surface_user": source,
                })

    gap_rows.sort(
        key=lambda entry: (
            -int(entry.get("evidence_value") or 0),
            numeric_value(entry.get("risk"), 0.0),
            -numeric_value(entry.get("confidence"), 0.0),
            -numeric_value(entry.get("suitability_score"), 0.0),
            str(entry.get("user") or ""),
            str(entry.get("target") or ""),
        )
    )
    selected = gap_rows[0] if gap_rows else {}
    return {
        "schema_version": "v7.a4.goal-directed-candidate-selection.v1",
        "owner": "tools/v7-governed-canary-dry-run-cycle",
        "candidate_snapshot_family": "candidate-suitability-summary",
        "missing_candidate_keys_count": len(missing_keys),
        "eligible_candidate_count": len(eligible_rows),
        "gap_reducing_candidate_count": len(gap_rows),
        "selection_status": "SELECTED" if selected else "NO_SAFE_GAP_REDUCING_A4_CANDIDATE",
        "selected_candidate": {
            "user": selected.get("user", ""),
            "source": selected.get("source", ""),
            "target": selected.get("target", ""),
            "evidence_value": selected.get("evidence_value", 0),
            "suitability_score": selected.get("suitability_score", 0.0),
            "confidence": selected.get("confidence", 0.0),
            "risk": selected.get("risk", 0.0),
        } if selected else {},
        "skipped_candidates": skipped[:50],
        "source_hash": source_hash,
        "runtime_mutation_performed": False,
        "apply_executed": False,
        "users_moved": 0,
        "runtime_automation_enabled": False,
        "authority_expanded": False,
    }


def merge_a4_gap_candidate_into_surface(surface: dict[str, Any], selection: dict[str, Any]) -> dict[str, Any]:
    selected = selection.get("selected_candidate") if isinstance(selection.get("selected_candidate"), dict) else {}
    user = str(selected.get("user") or "")
    source = str(selected.get("source") or "")
    target = str(selected.get("target") or "")
    if not user or not source or not target or source == target:
        return surface
    out = dict(surface)
    users_by_ip = dict(out.get("users_by_ip") or {})
    existing = dict(users_by_ip.get(user) or {})
    recommendation_hash = operator_decision_surface.recommendation_fingerprint(
        user,
        source,
        target,
        str(selection.get("source_hash") or ""),
    )
    existing.update({
        "user": user,
        "current_channel": source,
        "recommended_channel": target,
        "move_type": str(selected.get("move_type") or "governed_canary"),
        "confidence": selected.get("confidence", existing.get("confidence", 0.0)),
        "trust": existing.get("trust", 0.0),
        "prediction": existing.get("prediction", {}),
        "risk": selected.get("risk", existing.get("risk", 0.0)),
        "recommendation_hash": recommendation_hash,
        "source_hash": str(selection.get("source_hash") or existing.get("source_hash") or ""),
        "reasons": ["A4 goal-directed selection chose a missing evidence candidate"],
    })
    semantic_binding = selected.get(
        "availability_first_controlled_assignment"
    )
    if isinstance(semantic_binding, dict) and semantic_binding:
        existing["availability_first_controlled_assignment"] = (
            copy.deepcopy(semantic_binding)
        )
    users_by_ip[user] = existing
    out["users_by_ip"] = users_by_ip
    out["batch_preview"] = {
        **dict(out.get("batch_preview") or {}),
        "users_to_move": [{
            "user": user,
            "from": source,
            "to": target,
            "move_type": str(selected.get("move_type") or "governed_canary"),
            "confidence": selected.get("confidence", 0.0),
            "risk": selected.get("risk", 0.0),
            "recommendation_hash": recommendation_hash,
            "a4_goal_directed": True,
            "evidence_value": selected.get("evidence_value", 1),
            **(
                {
                    "availability_first_controlled_assignment": (
                        copy.deepcopy(semantic_binding)
                    )
                }
                if isinstance(semantic_binding, dict) and semantic_binding
                else {}
            ),
        }],
    }
    out["a4_goal_directed_selection"] = selection
    return out


def controlled_certification_setup_selection(
    *,
    users: list[dict[str, Any]],
    egress: list[dict[str, Any]],
    user: str,
    source: str,
    certification_identity_mode: str = "HISTORICAL_POOL",
    allow_same_campaign_occupants: bool = False,
) -> dict[str, Any]:
    """Admit one historical dedicated identity for bounded pool preparation."""
    blockers: list[str] = []
    try:
        address = ipaddress.ip_address(user)
        if certification_identity_mode == "HISTORICAL_POOL":
            legacy_pool = ipaddress.ip_network("10.7.0.16/28")
            extended_pool = ipaddress.ip_network("10.7.0.32/27")
            if address not in legacy_pool and address not in extended_pool:
                blockers.append(
                    "identity_not_in_durable_legacy_certification_pool"
                )
        elif certification_identity_mode != "REGISTRY_MARKED":
            blockers.append("unknown_certification_identity_mode")
    except ValueError:
        blockers.append("certification_user_ip_invalid")
    user_rows = [row for row in users if str(row.get("ip") or "") == user]
    source_rows = [row for row in egress if str(row.get("id") or "") == source]
    if len(user_rows) != 1:
        blockers.append("certification_user_registry_identity_not_unique")
    if len(source_rows) != 1:
        blockers.append("controlled_source_registry_identity_not_unique")
    user_row = user_rows[0] if len(user_rows) == 1 else {}
    source_row = source_rows[0] if len(source_rows) == 1 else {}
    if (
        certification_identity_mode == "REGISTRY_MARKED"
        and not bool_value(user_row.get("certification_user"))
    ):
        blockers.append("identity_not_marked_by_certification_registry_owner")
    if str(user_row.get("enabled") or "1").lower() not in {"1", "true", "yes"}:
        blockers.append("certification_user_not_enabled")
    current = str(user_row.get("current") or "")
    if not current or current == source:
        blockers.append("certification_user_not_on_distinct_restorable_source")
    if str(source_row.get("controlled_certification_source") or "").lower() not in {"1", "true", "yes"}:
        blockers.append("target_not_existing_controlled_certification_source")
    if str(source_row.get("enabled") or "").lower() not in {"1", "true", "yes"}:
        blockers.append("controlled_certification_source_not_enabled")
    unrelated = [
        row for row in users
        if bool_value(row.get("enabled", "1"))
        and str(row.get("current") or "") == source
        and str(row.get("ip") or "") != user
    ]
    subject_group = str(user_row.get("certification_group") or "")
    same_campaign_continuation = bool(
        allow_same_campaign_occupants
        and subject_group
        and unrelated
        and all(
            bool_value(row.get("certification_user"))
            and str(row.get("certification_group") or "")
            == subject_group
            for row in unrelated
        )
    )
    if unrelated and not same_campaign_continuation:
        blockers.append("controlled_source_has_other_assigned_users")
    source_hash = operator_execution.sha256_json({
        "user": user,
        "current": current,
        "source": source,
        "user_row": user_row,
        "source_row": source_row,
    })
    return {
        "schema_version": "v7.controlled-certification-setup-selection.v1",
        "selection_status": "SELECTED" if not blockers else "STOP_SAFE",
        "blockers": blockers,
        "selected_candidate": {
            "user": user,
            "source": current,
            "target": source,
            "evidence_value": 0,
            "suitability_score": 100.0,
            "confidence": 100.0,
            "risk": 0.0,
        } if not blockers else {},
        "source_hash": source_hash,
        "evidence_class": "ENGINEERING_SETUP",
        "ordinary_customer_used": False,
        "authority_scope": "ONE_EXISTING_DEDICATED_IDENTITY_TO_ONE_EXISTING_CONTROLLED_SOURCE",
        "max_users": 1,
        "same_campaign_continuation": same_campaign_continuation,
    }


def controlled_certification_cleanup_selection(
    *,
    users: list[dict[str, Any]],
    egress: list[dict[str, Any]],
    user: str,
    source: str,
    target: str,
    campaign_reset: bool = False,
    controlled_source: str = "",
    availability_first_reset: bool = False,
    availability_first_target: str = "",
    availability_first_allocation_fingerprint: str = "",
) -> dict[str, Any]:
    """Admit only exact pre-state restoration after a consumed controlled run."""
    blockers: list[str] = []
    user_rows = [row for row in users if str(row.get("ip") or "") == user]
    source_rows = [row for row in egress if str(row.get("id") or "") == source]
    target_rows = [row for row in egress if str(row.get("id") or "") == target]
    if len(user_rows) != 1:
        blockers.append("cleanup_user_registry_identity_not_unique")
    if len(source_rows) != 1:
        blockers.append("cleanup_source_registry_identity_not_unique")
    if len(target_rows) != 1:
        blockers.append("cleanup_target_registry_identity_not_unique")
    user_row = user_rows[0] if len(user_rows) == 1 else {}
    source_row = source_rows[0] if len(source_rows) == 1 else {}
    target_row = target_rows[0] if len(target_rows) == 1 else {}
    if str(user_row.get("certification_user") or "").lower() not in {"1", "true", "yes"}:
        blockers.append("cleanup_subject_not_certification_user")
    if str(user_row.get("current") or "") != source:
        blockers.append("cleanup_user_not_on_registered_rollback_source")
    if campaign_reset:
        if (
            str(target_row.get("id") or "") != controlled_source
            or str(
                target_row.get("controlled_certification_source") or ""
            ).lower() not in {"1", "true", "yes"}
        ):
            blockers.append(
                "campaign_reset_target_not_exact_controlled_source"
            )
        if availability_first_reset:
            if len(str(availability_first_allocation_fingerprint or "")) != 64:
                blockers.append(
                    "availability_first_reset_allocation_fingerprint_invalid"
                )
            if str(source_row.get("id") or "") != availability_first_target:
                blockers.append(
                    "availability_first_reset_current_source_changed"
                )
            if bool_value(
                source_row.get("controlled_certification_source")
            ):
                # Availability-first allocation may legitimately use an
                # already isolated controlled-certification channel as its
                # execution target.  The exact Packet/lease still binds this
                # source.  Admit baseline restoration only when every enabled
                # occupant is a certification identity from the same campaign
                # group; an ordinary or cross-campaign occupant fails closed.
                source_occupants = [
                    row
                    for row in users
                    if bool_value(row.get("enabled", "1"))
                    and str(row.get("current") or "") == source
                ]
                subject_group = str(
                    user_row.get("certification_group") or ""
                )
                if any(
                    not bool_value(row.get("certification_user"))
                    for row in source_occupants
                ):
                    blockers.append(
                        "availability_first_reset_source_has_ordinary_user"
                    )
                if subject_group and any(
                    str(row.get("certification_group") or "")
                    != subject_group
                    for row in source_occupants
                ):
                    blockers.append(
                        "availability_first_reset_source_crosses_campaign"
                    )
        elif (
            str(source_row.get("role") or "").upper() != "EXECUTION_ONLY"
            or str(source_row.get("reservation_owner") or "")
            != "operator_execution_governance"
            or not bool_value(source_row.get("execution_reserved"))
        ):
            blockers.append(
                "campaign_reset_current_source_not_exact_execution_target"
            )
    else:
        if str(
            source_row.get("controlled_certification_source") or ""
        ).lower() not in {"1", "true", "yes"}:
            blockers.append("cleanup_source_not_controlled_certification_source")
    if str(source_row.get("enabled") or "").lower() not in {"1", "true", "yes"}:
        blockers.append("cleanup_source_not_enabled")
    if not campaign_reset and str(
        target_row.get("enabled") or "1"
    ).lower() not in {"1", "true", "yes"}:
        blockers.append("cleanup_target_not_enabled")
    if not target or source == target:
        blockers.append("cleanup_target_not_distinct")
    source_hash = operator_execution.sha256_json({
        "user": user,
        "source": source,
        "target": target,
        "user_row": user_row,
        "source_row": source_row,
        "target_row": target_row,
    })
    return {
        "schema_version": "v7.controlled-certification-cleanup-selection.v1",
        "selection_status": "SELECTED" if not blockers else "STOP_SAFE",
        "blockers": blockers,
        "selected_candidate": {
            "user": user,
            "source": source,
            "target": target,
            "move_type": "failover",
            "evidence_value": 0,
            "suitability_score": 100.0,
            "confidence": 100.0,
            "risk": 0.0,
            **(
                {
                    "availability_first_controlled_assignment": {
                        "schema_version": (
                            "v7.availability-first-controlled-selection.v1"
                        ),
                        "event_provenance": "CONTROLLED_CERTIFICATION",
                        "natural_production_credit": False,
                        "source": source,
                        "target": target,
                        "allocation_fingerprint": str(
                            availability_first_allocation_fingerprint or ""
                        ),
                        "ordinary_user": False,
                        "baseline_reset": True,
                        "controlled_baseline_source": target,
                    }
                }
                if availability_first_reset
                else {}
            ),
        } if not blockers else {},
        "source_hash": source_hash,
        "evidence_class": "ENGINEERING_CLEANUP",
        "ordinary_customer_used": False,
        "authority_scope": (
            "RESTORE_EXACT_APPROVED_CONTROLLED_CAMPAIGN_BASELINE"
            if campaign_reset
            else "RESTORE_EXACT_APPROVED_PRE_STATE"
        ),
        "max_users": 1,
        "campaign_reset": campaign_reset,
        "availability_first_reset_source_isolated": bool(
            availability_first_reset
            and not any(
                item in blockers
                for item in (
                    "availability_first_reset_source_has_ordinary_user",
                    "availability_first_reset_source_crosses_campaign",
                )
            )
        ),
    }


def controlled_engineering_authority_selection(
    *,
    request: dict[str, Any],
    users: list[dict[str, Any]],
    egress: list[dict[str, Any]],
) -> dict[str, Any]:
    """Project the exact approved R2 subject into the existing decision surface."""
    blockers: list[str] = []
    subject = request.get("subject") if isinstance(request.get("subject"), dict) else {}
    scope = request.get("scope") if isinstance(request.get("scope"), dict) else {}
    condition = request.get("controlled_condition") if isinstance(request.get("controlled_condition"), dict) else {}
    user = str(subject.get("user_ip") or "")
    source = str(scope.get("source_egress") or "")
    target = str(scope.get("target_egress") or "")
    required_services = [
        str(service).strip()
        for service in (scope.get("required_services") or [])
        if str(service).strip()
    ]
    user_rows = [row for row in users if str(row.get("ip") or "") == user]
    source_rows = [row for row in egress if str(row.get("id") or "") == source]
    target_rows = [row for row in egress if str(row.get("id") or "") == target]
    if len(user_rows) != 1:
        blockers.append("engineering_authority_user_registry_identity_not_unique")
    if len(source_rows) != 1:
        blockers.append("engineering_authority_source_registry_identity_not_unique")
    if len(target_rows) != 1:
        blockers.append("engineering_authority_target_registry_identity_not_unique")
    user_row = user_rows[0] if len(user_rows) == 1 else {}
    source_row = source_rows[0] if len(source_rows) == 1 else {}
    target_row = target_rows[0] if len(target_rows) == 1 else {}
    if subject.get("certification_user") is not True or subject.get("ordinary_customer") is not False:
        blockers.append("engineering_authority_subject_class_invalid")
    if str(user_row.get("certification_user") or "").lower() not in {"1", "true", "yes"}:
        blockers.append("engineering_authority_subject_not_registered_certification_user")
    if str(user_row.get("current") or "") != source:
        blockers.append("engineering_authority_subject_not_on_exact_source")
    if str(source_row.get("controlled_certification_source") or "").lower() not in {"1", "true", "yes"}:
        blockers.append("engineering_authority_source_not_controlled_certification_source")
    if str(source_row.get("enabled") or "1").lower() in {"1", "true", "yes"}:
        blockers.append("engineering_authority_controlled_source_not_activated")
    if str(target_row.get("enabled") or "1").lower() not in {"1", "true", "yes"}:
        blockers.append("engineering_authority_target_not_enabled")
    if target != "vless" or str(target_row.get("interface") or "") != str(scope.get("target_interface") or ""):
        blockers.append("engineering_authority_target_binding_invalid")
    if str(source_row.get("interface") or "") != str(scope.get("source_interface") or ""):
        blockers.append("engineering_authority_source_interface_mismatch")
    if str(condition.get("name") or "") != "CONTROLLED_SOURCE_FAILURE_WITH_REAL_SERVICE_MATRIX_VERIFIER_CONTENTION":
        blockers.append("engineering_authority_condition_not_exact")
    if not required_services:
        blockers.append("engineering_authority_required_services_missing")
    unrelated = [
        str(row.get("ip") or "") for row in users
        if str(row.get("current") or "") == source and str(row.get("ip") or "") != user
    ]
    if unrelated:
        blockers.append("engineering_authority_source_has_unrelated_users")
    source_hash = operator_execution.sha256_json({
        "request_id": request.get("request_id"),
        "contract_hash": request.get("contract_hash"),
        "user_row": user_row,
        "source_row": source_row,
        "target_row": target_row,
    })
    return {
        "schema_version": "v7.controlled-engineering-authority-selection.v1",
        "selection_status": "SELECTED" if not blockers else "STOP_SAFE",
        "blockers": blockers,
        "selected_candidate": {
            "user": user,
            "source": source,
            "target": target,
            "move_type": "failover",
            "important_services": required_services,
            "evidence_value": 1,
            "suitability_score": 100.0,
            "confidence": 100.0,
            "risk": 0.0,
        } if not blockers else {},
        "source_hash": source_hash,
        "evidence_class": "CONTROLLED_PRODUCTION",
        "authority_scope": "EXACT_ONE_USE_R2_CONTRACT",
        "ordinary_customer_used": False,
        "max_users": 1,
    }


def controlled_certification_repair_preflight(
    args: argparse.Namespace,
    *,
    state_dir: Path,
    audit_dir: Path,
    lease_file: Path,
) -> dict[str, Any]:
    """Read-only proof that a fresh repair-generation run can enter setup.

    This deliberately validates the clean pre-state, before moving the
    certification identity or activating the controlled source.  The exact
    activated state is still re-read by the normal admission and autoswitch
    verifier after setup.
    """
    request = read_json(Path(args.engineering_authority_request_file), {})
    policy = read_json(Path(args.engineering_authority_repair_continuation_policy_file), {})
    continuation = operator_execution.validate_engineering_authority_repair_continuation(policy, request)
    decision = str(continuation.get("decision") or "")
    request_validation = operator_execution.validate_engineering_authority_request(
        request,
        decision=decision,
        expected_request_id=str(args.engineering_authority_request_id or ""),
        expected_contract_hash=str(args.engineering_authority_contract_hash or ""),
    )
    blockers: list[str] = []
    if not continuation.get("ok"):
        blockers.extend(continuation.get("errors") or ["repair_continuation_invalid"])
    if not request_validation.get("ok"):
        blockers.extend(request_validation.get("errors") or ["engineering_authority_request_invalid"])

    control = operator_execution.autonomous_execution_control_state(Path(args.execution_control_file))
    if not control.get("valid") or control.get("state") != "OPEN":
        blockers.append("autonomous_execution_control_not_open")
    lease_state = operator_execution.execution_lease_state(operator_execution.load_execution_lease(lease_file))
    if lease_state.get("active"):
        blockers.append("active_execution_lease_exists")

    subject = request.get("subject") if isinstance(request.get("subject"), dict) else {}
    scope = request.get("scope") if isinstance(request.get("scope"), dict) else {}
    user = str(subject.get("user_ip") or "")
    source = str(scope.get("source_egress") or "")
    initial = str(subject.get("initial_egress") or "")
    users = read_registry(state_dir / "users.registry")
    egress = read_registry(state_dir / "egress.registry")
    setup = controlled_certification_setup_selection(users=users, egress=egress, user=user, source=source)
    if setup.get("selection_status") != "SELECTED":
        blockers.extend(setup.get("blockers") or ["controlled_certification_setup_not_ready"])
    user_rows = [row for row in users if str(row.get("ip") or "") == user]
    if len(user_rows) == 1 and str(user_rows[0].get("current") or "") != initial:
        blockers.append("certification_user_not_on_exact_initial_egress")
    target_rows = [row for row in egress if str(row.get("id") or "") == initial]
    if len(target_rows) != 1 or str(target_rows[0].get("enabled") or "1").lower() not in {"1", "true", "yes"}:
        blockers.append("exact_initial_egress_not_ready")

    records = operator_execution.read_audit_records(audit_dir / "operator-execution-audit.jsonl")
    if operator_execution.engineering_authority_replay_seen(records, str(request.get("request_id") or "")):
        blockers.append("engineering_authority_request_already_consumed")
    return {
        "schema_version": "v7.controlled-certification-repair-preflight.v1",
        "final_verdict": "CONTROLLED_CERTIFICATION_PREFLIGHT_READY" if not blockers else "STOP_SAFE",
        "read_only": True,
        "blockers": sorted(set(blockers)),
        "request_id": str(request.get("request_id") or ""),
        "contract_hash": str(request.get("contract_hash") or ""),
        "repair_continuation": continuation,
        "request_validation": request_validation,
        "setup_selection": setup,
        "execution_control": control,
        "execution_lease_state": lease_state,
        "runtime_mutation_performed": False,
        "routing_mutation_performed": False,
        "restore_barrier_written_now": False,
        "apply_executed": False,
        "users_moved": 0,
        "rollback_attempted": False,
        "authority_expanded": False,
    }


def approved_controlled_certification_substrate_binding(
    *,
    audit_store: Path,
    request_id: str,
    request_hash: str,
    required_subscopes: set[str],
) -> dict[str, Any]:
    """Bind setup/campaign work to one exact existing Authority decision."""
    records = operator_execution.read_audit_records(audit_store)
    status = operator_execution.controlled_certification_substrate_authority_status(
        records,
    )
    request = status.get("request") if isinstance(status.get("request"), dict) else {}
    scope = request.get("scope") if isinstance(request.get("scope"), dict) else {}
    admitted = set(str(item) for item in (status.get("admitted_subscopes") or []))
    blockers: list[str] = []
    if str(status.get("status") or "") != "APPROVED":
        blockers.append("controlled_substrate_authority_not_approved")
    if str(status.get("request_id") or "") != str(request_id or ""):
        blockers.append("controlled_substrate_request_id_mismatch")
    if str(status.get("request_hash") or "") != str(request_hash or ""):
        blockers.append("controlled_substrate_request_hash_mismatch")
    if str(status.get("decision") or "") != (
        operator_execution.CONTROLLED_CERTIFICATION_SUBSTRATE_APPROVAL
    ):
        blockers.append("controlled_substrate_decision_not_exact_approval")
    missing = sorted(set(required_subscopes) - admitted)
    if missing:
        blockers.extend(
            f"controlled_substrate_subscope_not_admitted:{item}"
            for item in missing
        )
    if str(request.get("active_program") or "") != (
        "V7_SERVICE_FAILURE_AUTOMATION_EVOLUTION_PROGRAM_V1"
    ):
        blockers.append("controlled_substrate_active_program_mismatch")
    if not str(scope.get("source_id") or ""):
        blockers.append("controlled_substrate_source_missing")
    if scope.get("certification_only") is not True:
        blockers.append("controlled_substrate_certification_only_required")
    if scope.get("ordinary_customer_involvement") is not False:
        blockers.append("controlled_substrate_ordinary_customer_scope_forbidden")
    if int(scope.get("max_concurrent_transactions") or 0) != 1:
        blockers.append("controlled_substrate_concurrency_not_one")
    if list(scope.get("campaign_stages") or []) != [5, 10, 25, 48]:
        blockers.append("controlled_substrate_campaign_stages_changed")
    return {
        "schema_version": "v7.controlled-certification-substrate-binding.v1",
        "ok": not blockers,
        "blockers": sorted(set(blockers)),
        "request_id": str(status.get("request_id") or ""),
        "request_hash": str(status.get("request_hash") or ""),
        "decision_id": str(status.get("decision_id") or ""),
        "source_id": str(scope.get("source_id") or ""),
        "scope": scope,
        "request": request,
        "admitted_subscopes": sorted(admitted),
        "new_authority_created": False,
        "authority_expanded": False,
    }


def _controlled_substrate_owned_identity_rows(
    *,
    leases_file: Path,
    users: list[dict[str, Any]],
    name_prefix: str,
) -> tuple[list[dict[str, Any]], list[str]]:
    leases = read_registry(leases_file)
    users_by_ip = {
        str(row.get("ip") or ""): row
        for row in users
        if str(row.get("ip") or "")
    }
    owned: list[dict[str, Any]] = []
    blockers: list[str] = []
    for lease in leases:
        name = str(lease.get("user") or "")
        if not name.startswith(name_prefix):
            continue
        ip = str(lease.get("ip") or "")
        row = users_by_ip.get(ip, {})
        if str(lease.get("status") or "") != "active":
            blockers.append(f"controlled_substrate_owned_lease_not_active:{name}")
        if not row:
            blockers.append(f"controlled_substrate_owned_user_missing:{name}")
        owned.append({
            "name": name,
            "device": str(lease.get("device") or ""),
            "ip": ip,
            "lease": lease,
            "user": row,
        })
    owned.sort(key=lambda row: str(row.get("name") or ""))
    return owned, blockers


def provision_approved_controlled_certification_substrate(
    args: argparse.Namespace,
    *,
    state_dir: Path,
    audit_dir: Path,
) -> dict[str, Any]:
    """Provision the approved dedicated pool through existing owners only.

    Identity and assignment truth remain in IPAM/users/egress registries.  This
    consumer stores only one compact append-only completion receipt.
    """
    audit_store = Path(args.operator_execution_audit_store)
    request_id = str(args.controlled_certification_substrate_request_id or "")
    request_hash = str(args.controlled_certification_substrate_request_hash or "")
    binding = approved_controlled_certification_substrate_binding(
        audit_store=audit_store,
        request_id=request_id,
        request_hash=request_hash,
        required_subscopes={
            "IDENTITY_PROVISIONING",
            "CERTIFICATION_CLASSIFICATION_AND_ASSIGNMENT",
        },
    )
    if not binding.get("ok"):
        return transaction_stop(
            "controlled_substrate_authority_binding_invalid",
            controlled_substrate_binding=binding,
        )
    source = str(binding.get("source_id") or "")
    scope = binding.get("scope") if isinstance(binding.get("scope"), dict) else {}
    target_total = int(scope.get("target_total_certification_identities") or 0)
    max_new = int(scope.get("max_new_certification_identities") or 0)
    identity_strategy = str(scope.get("identity_strategy") or "")
    reuse_existing_pool = identity_strategy == "REUSE_EXISTING_VALID_POOL"
    if (
        target_total != 48
        or (
            reuse_existing_pool and max_new != 0
        )
        or (
            not reuse_existing_pool and max_new != 48
        )
    ):
        return transaction_stop(
            "controlled_substrate_identity_ceiling_changed",
            target_total=target_total,
            max_new=max_new,
        )
    name_prefix = f"cert-t48-{request_hash[:8]}-"
    group = f"t48-{request_hash[:12]}"
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", source):
        return transaction_stop("controlled_substrate_source_id_unsafe")
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", group):
        return transaction_stop("controlled_substrate_group_unsafe")

    egress = read_registry(state_dir / "egress.registry")
    source_rows = [row for row in egress if str(row.get("id") or "") == source]
    if len(source_rows) != 1:
        return transaction_stop("controlled_substrate_source_not_unique")
    source_row = source_rows[0]
    if str(source_row.get("enabled") or "1").lower() not in {
        "1", "true", "yes",
    }:
        return transaction_stop("controlled_substrate_source_not_enabled")

    users = read_registry(state_dir / "users.registry")
    controlled_target = str(scope.get("controlled_target_id") or "")
    if reuse_existing_pool:
        eligible_existing = [
            row for row in users
            if str(row.get("current") or "") == source
            and str(row.get("enabled") or "1").lower()
            in {"1", "true", "yes"}
            and str(row.get("certification_user") or "").lower()
            in {"1", "true", "yes"}
        ]
        ordinary_on_source = [
            row for row in users
            if str(row.get("current") or "") == source
            and str(row.get("enabled") or "1").lower()
            in {"1", "true", "yes"}
            and str(row.get("certification_user") or "").lower()
            not in {"1", "true", "yes"}
        ]
        target_rows = [
            row for row in egress
            if str(row.get("id") or "") == controlled_target
        ]
        users_on_target = [
            row for row in users
            if str(row.get("current") or "") == controlled_target
            and str(row.get("enabled") or "1").lower()
            in {"1", "true", "yes"}
        ]
        reuse_blockers = []
        if len(eligible_existing) != target_total:
            reuse_blockers.append(
                "controlled_substrate_reuse_identity_count_mismatch"
            )
        if ordinary_on_source:
            reuse_blockers.append(
                "controlled_substrate_reuse_source_contains_ordinary_users"
            )
        if not controlled_target or len(target_rows) != 1:
            reuse_blockers.append(
                "controlled_substrate_reuse_target_not_unique"
            )
        if users_on_target:
            reuse_blockers.append(
                "controlled_substrate_reuse_target_not_empty"
            )
        if reuse_blockers:
            return transaction_stop(
                "controlled_substrate_reuse_preflight_failed",
                blockers=sorted(set(reuse_blockers)),
                source=source,
                controlled_target=controlled_target,
                existing_certification_identity_count=len(eligible_existing),
                ordinary_user_count=len(ordinary_on_source),
                target_user_count=len(users_on_target),
            )
        identity_fingerprint = operator_execution.sha256_json(sorted(
            str(row.get("ip") or "") for row in eligible_existing
        ))
        if (
            args.confirm_controlled_certification_substrate_provisioning
            != "PROVISION_APPROVED_CONTROLLED_CERTIFICATION_SUBSTRATE"
        ):
            return {
                "schema_version": "v7.controlled-certification-substrate-consumer.v1",
                "final_verdict": "CONTROLLED_CERTIFICATION_EXISTING_POOL_REUSE_PREFLIGHT_READY",
                "read_only": True,
                "request_id": request_id,
                "request_hash": request_hash,
                "decision_id": str(binding.get("decision_id") or ""),
                "source": source,
                "controlled_target": controlled_target,
                "target_total": target_total,
                "existing_owned_identities": len(eligible_existing),
                "identities_to_create": 0,
                "ordinary_customer_count": 0,
                "raw_identity_list_stored": False,
                "controlled_substrate_binding": binding,
                "runtime_mutation_performed": False,
                "routing_mutation_performed": False,
                "users_moved": 0,
                "authority_expanded": False,
            }
        with operator_execution.current_action_class_contract_policy_lock(
            audit_store,
        ):
            records = operator_execution.read_audit_records(audit_store)
            prior = [
                row for row in records
                if row.get("record_type") == CONTROLLED_SUBSTRATE_EFFECT_RECORD_TYPE
                and str(row.get("authority_request_id") or "") == request_id
                and str(row.get("authority_request_hash") or "") == request_hash
                and str(row.get("effect_class") or "")
                == "EXISTING_POOL_REUSED_AND_CONTROLLED_TARGET_ADMITTED"
            ]
            if prior:
                return {
                    "schema_version": "v7.controlled-certification-substrate-consumer.v1",
                    "final_verdict": "CONTROLLED_CERTIFICATION_SUBSTRATE_ALREADY_CONSUMED",
                    "request_id": request_id,
                    "request_hash": request_hash,
                    "source": source,
                    "controlled_target": controlled_target,
                    "receipt_id": str(prior[-1].get("receipt_id") or ""),
                    "audit_write": False,
                    "runtime_mutation_performed": False,
                    "routing_mutation_performed": False,
                    "users_moved": 0,
                    "authority_expanded": False,
                }
            receipt_id = "cpsfx_" + operator_execution.sha256_json({
                "request_id": request_id,
                "request_hash": request_hash,
                "source": source,
                "controlled_target": controlled_target,
                "identity_fingerprint": identity_fingerprint,
            })[:24]
            receipt = operator_execution.append_record(audit_store, {
                "schema_version": "v7.controlled-certification-substrate-effect.v1",
                "record_type": CONTROLLED_SUBSTRATE_EFFECT_RECORD_TYPE,
                "receipt_id": receipt_id,
                "effect_class": "EXISTING_POOL_REUSED_AND_CONTROLLED_TARGET_ADMITTED",
                "authority_request_id": request_id,
                "authority_request_hash": request_hash,
                "authority_decision_id": str(binding.get("decision_id") or ""),
                "source_id": source,
                "controlled_target_id": controlled_target,
                "identity_count": len(eligible_existing),
                "identity_fingerprint": identity_fingerprint,
                "raw_identity_list_stored": False,
                "ordinary_customer_count": 0,
                "created_at": datetime.now(timezone.utc).isoformat(),
            })
        return {
            "schema_version": "v7.controlled-certification-substrate-consumer.v1",
            "final_verdict": "CONTROLLED_CERTIFICATION_EXISTING_POOL_REUSED",
            "request_id": request_id,
            "request_hash": request_hash,
            "decision_id": str(binding.get("decision_id") or ""),
            "source": source,
            "controlled_target": controlled_target,
            "target_total": target_total,
            "eligible_identity_count": len(eligible_existing),
            "identity_fingerprint": identity_fingerprint,
            "created_count": 0,
            "classified_count": 0,
            "ordinary_customer_count": 0,
            "raw_identity_list_stored": False,
            "receipt_id": str(receipt.get("receipt_id") or receipt_id),
            "audit_write": True,
            "identity_creation": 0,
            "assignment_change": 0,
            "classification_change": 0,
            "controlled_condition": False,
            "candidate_created": False,
            "packet_created": False,
            "lease_created": False,
            "runtime_apply": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
            "authority_expanded": False,
            "production_maturity_change": False,
        }
    leases_file = Path(args.ipam_leases_file)
    owned, owned_blockers = _controlled_substrate_owned_identity_rows(
        leases_file=leases_file,
        users=users,
        name_prefix=name_prefix,
    )
    owned_ips = {str(row.get("ip") or "") for row in owned}
    unrelated = [
        str(row.get("ip") or "")
        for row in users
        if str(row.get("current") or "") == source
        and str(row.get("enabled") or "1").lower() in {"1", "true", "yes"}
        and str(row.get("ip") or "") not in owned_ips
        and str(row.get("certification_user") or "").lower()
        not in {"1", "true", "yes"}
    ]
    blockers = list(owned_blockers)
    if unrelated:
        blockers.append(
            "controlled_substrate_source_contains_non_certification_users"
        )
    if len(owned) > target_total:
        blockers.append("controlled_substrate_owned_identity_count_above_scope")
    if blockers:
        return transaction_stop(
            "controlled_substrate_preflight_failed",
            blockers=sorted(set(blockers)),
            source=source,
            owned_identity_count=len(owned),
            unrelated_user_count=len(unrelated),
        )
    if (
        args.confirm_controlled_certification_substrate_provisioning
        != "PROVISION_APPROVED_CONTROLLED_CERTIFICATION_SUBSTRATE"
    ):
        return {
            "schema_version": "v7.controlled-certification-substrate-consumer.v1",
            "final_verdict": "CONTROLLED_CERTIFICATION_SUBSTRATE_PREFLIGHT_READY",
            "read_only": True,
            "request_id": request_id,
            "request_hash": request_hash,
            "decision_id": str(binding.get("decision_id") or ""),
            "source": source,
            "target_total": target_total,
            "existing_owned_identities": len(owned),
            "identities_to_create": target_total - len(owned),
            "ordinary_customer_count": 0,
            "raw_identity_list_stored": False,
            "controlled_substrate_binding": binding,
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
            "authority_expanded": False,
        }

    created_count = 0
    classified_count = 0
    with operator_execution.current_action_class_contract_policy_lock(
        audit_store,
    ):
        records = operator_execution.read_audit_records(audit_store)
        prior = [
            row for row in records
            if row.get("record_type") == CONTROLLED_SUBSTRATE_EFFECT_RECORD_TYPE
            and str(row.get("authority_request_id") or "") == request_id
            and str(row.get("authority_request_hash") or "") == request_hash
            and str(row.get("effect_class") or "") == (
                "IDENTITY_POOL_PROVISIONED_AND_CLASSIFIED"
            )
        ]
        if prior:
            return {
                "schema_version": "v7.controlled-certification-substrate-consumer.v1",
                "final_verdict": "CONTROLLED_CERTIFICATION_SUBSTRATE_ALREADY_CONSUMED",
                "request_id": request_id,
                "request_hash": request_hash,
                "source": source,
                "receipt_id": str(prior[-1].get("receipt_id") or ""),
                "audit_write": False,
                "runtime_mutation_performed": False,
                "routing_mutation_performed": False,
                "users_moved": 0,
                "authority_expanded": False,
            }
        for index in range(1, target_total + 1):
            name = f"{name_prefix}{index:02d}"
            users = read_registry(state_dir / "users.registry")
            owned, owned_blockers = _controlled_substrate_owned_identity_rows(
                leases_file=leases_file,
                users=users,
                name_prefix=name_prefix,
            )
            if owned_blockers:
                return transaction_stop(
                    "controlled_substrate_owned_identity_drift",
                    blockers=owned_blockers,
                    completed_identity_count=len(owned),
                )
            matches = [row for row in owned if row.get("name") == name]
            if len(matches) > 1:
                return transaction_stop(
                    "controlled_substrate_owned_identity_duplicate",
                    identity_name=name,
                )
            if not matches:
                proc = subprocess.run(
                    [
                        str(args.identity_provisioner),
                        "--name", name,
                        "--device", name,
                        "--egress", source,
                        "--apply", "--confirm", "CREATE_IPAM_USER",
                    ],
                    text=True,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    timeout=240,
                    check=False,
                )
                if proc.returncode != 0:
                    return transaction_stop(
                        "controlled_substrate_identity_provisioning_failed",
                        identity_index=index,
                        returncode=proc.returncode,
                        output_tail=(proc.stdout or "")[-2000:],
                        created_count=created_count,
                    )
                parsed_ip = ""
                for line in (proc.stdout or "").splitlines():
                    if line.startswith("ip="):
                        parsed_ip = line.split("=", 1)[1].strip()
                if not parsed_ip:
                    return transaction_stop(
                        "controlled_substrate_identity_provisioning_receipt_invalid",
                        identity_index=index,
                        created_count=created_count,
                    )
                created_count += 1
                identity_ip = parsed_ip
            else:
                identity_ip = str(matches[0].get("ip") or "")
            user_rows = [
                row for row in read_registry(state_dir / "users.registry")
                if str(row.get("ip") or "") == identity_ip
            ]
            if len(user_rows) != 1:
                return transaction_stop(
                    "controlled_substrate_created_user_not_unique",
                    identity_index=index,
                )
            user_row = user_rows[0]
            if str(user_row.get("current") or "") != source:
                return transaction_stop(
                    "controlled_substrate_created_user_assignment_mismatch",
                    identity_index=index,
                )
            is_classified = (
                str(user_row.get("certification_user") or "").lower()
                in {"1", "true", "yes"}
                and str(user_row.get("certification_group") or "") == group
            )
            if not is_classified:
                marker = subprocess.run(
                    [
                        str(args.egress_state_owner),
                        source, "certification-scope",
                        "--certification-users", identity_ip,
                        "--certification-group", group,
                        "--apply",
                    ],
                    text=True,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    timeout=240,
                    check=False,
                )
                if marker.returncode != 0:
                    return transaction_stop(
                        "controlled_substrate_classification_failed",
                        identity_index=index,
                        returncode=marker.returncode,
                        output_tail=(marker.stdout or "")[-2000:],
                        created_count=created_count,
                        classified_count=classified_count,
                    )
                classified_count += 1

        users = read_registry(state_dir / "users.registry")
        owned, owned_blockers = _controlled_substrate_owned_identity_rows(
            leases_file=leases_file,
            users=users,
            name_prefix=name_prefix,
        )
        final_blockers = list(owned_blockers)
        eligible = []
        for row in owned:
            user_row = row.get("user") if isinstance(row.get("user"), dict) else {}
            if (
                str(user_row.get("current") or "") == source
                and str(user_row.get("enabled") or "1").lower()
                in {"1", "true", "yes"}
                and str(user_row.get("certification_user") or "").lower()
                in {"1", "true", "yes"}
                and str(user_row.get("certification_group") or "") == group
            ):
                eligible.append(str(row.get("ip") or ""))
        current_non_cert = [
            str(row.get("ip") or "")
            for row in users
            if str(row.get("current") or "") == source
            and str(row.get("enabled") or "1").lower()
            in {"1", "true", "yes"}
            and str(row.get("certification_user") or "").lower()
            not in {"1", "true", "yes"}
        ]
        if len(eligible) != target_total:
            final_blockers.append(
                "controlled_substrate_final_eligible_count_mismatch"
            )
        if current_non_cert:
            final_blockers.append(
                "controlled_substrate_final_non_certification_users_present"
            )
        if final_blockers:
            return transaction_stop(
                "controlled_substrate_final_verification_failed",
                blockers=sorted(set(final_blockers)),
                eligible_count=len(eligible),
                non_certification_count=len(current_non_cert),
            )
        identity_fingerprint = operator_execution.sha256_json(sorted(eligible))
        receipt_id = "cpsfx_" + operator_execution.sha256_json({
            "request_id": request_id,
            "request_hash": request_hash,
            "decision_id": binding.get("decision_id"),
            "source": source,
            "identity_fingerprint": identity_fingerprint,
            "identity_count": len(eligible),
        })[:24]
        receipt = operator_execution.append_record(audit_store, {
            "schema_version": "v7.controlled-certification-substrate-effect.v1",
            "record_type": CONTROLLED_SUBSTRATE_EFFECT_RECORD_TYPE,
            "receipt_id": receipt_id,
            "effect_class": "IDENTITY_POOL_PROVISIONED_AND_CLASSIFIED",
            "authority_request_id": request_id,
            "authority_request_hash": request_hash,
            "authority_decision_id": str(binding.get("decision_id") or ""),
            "source_id": source,
            "identity_count": len(eligible),
            "identity_fingerprint": identity_fingerprint,
            "raw_identity_list_stored": False,
            "ordinary_customer_count": 0,
            "created_at": datetime.now(timezone.utc).isoformat(),
        })
    return {
        "schema_version": "v7.controlled-certification-substrate-consumer.v1",
        "final_verdict": "CONTROLLED_CERTIFICATION_SUBSTRATE_PROVISIONED",
        "request_id": request_id,
        "request_hash": request_hash,
        "decision_id": str(binding.get("decision_id") or ""),
        "source": source,
        "target_total": target_total,
        "eligible_identity_count": target_total,
        "identity_fingerprint": identity_fingerprint,
        "created_count": created_count,
        "classified_count": classified_count,
        "ordinary_customer_count": 0,
        "raw_identity_list_stored": False,
        "receipt_id": str(receipt.get("receipt_id") or receipt_id),
        "audit_write": True,
        "identity_creation": created_count,
        "assignment_change": created_count,
        "classification_change": classified_count,
        "controlled_condition": False,
        "candidate_created": False,
        "packet_created": False,
        "lease_created": False,
        "runtime_apply": created_count > 0,
        "routing_mutation_performed": created_count > 0,
        "users_moved": 0,
        "authority_expanded": False,
        "production_maturity_change": False,
    }


def decision_records(state_dir: Path, event_dir: Path, audit_dir: Path) -> list[dict[str, Any]]:
    paths = [
        event_dir / "switch-history.jsonl",
        event_dir / "rollback-history.jsonl",
        audit_dir / "audit.jsonl",
        audit_dir / "operator-execution-audit.jsonl",
        audit_dir / "operator-runtime-governance-actions.jsonl",
        state_dir / "execution-events.jsonl",
        state_dir / "runtime-trust.jsonl",
        state_dir / "proposal-records.jsonl",
        state_dir / "proposals.jsonl",
        state_dir / "closure-records.jsonl",
    ]
    rows: list[dict[str, Any]] = []
    for path in paths:
        rows.extend(read_jsonl_family(path))
    return rows


