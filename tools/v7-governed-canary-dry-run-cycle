        "ok": False,
        "verdict": "EXECUTION_LEASE_NOT_CREATED",
        "reason": reason,
        "execution_allowed_now": False,
        **extra,
    }


def transaction_stop(reason: str, *, cycle: dict[str, Any] | None = None, **extra: Any) -> dict[str, Any]:
    return {
        "schema_version": "v7.governed-execution-transaction.v1",
        "transaction_status": "STOP_SAFE",
        "final_verdict": "GOVERNED_TRANSACTION_STOPPED",
        "stop_reason": reason,
        "runtime_mutation_performed": False,
        "restore_barrier_written_now": False,
        "apply_executed": False,
        "users_moved": 0,
        "runtime_automation_enabled": False,
        "authority_expanded": False,
        "new_architecture_created": False,
        "new_authority_created": False,
        "new_runtime_path_created": False,
        "new_governance_created": False,
        "new_owner_created": False,
        "new_backlog_item_created": False,
        "cycle": cycle or {},
        **extra,
    }


def compact_transaction_result(result: dict[str, Any]) -> dict[str, Any]:
    """Emit a bounded lifecycle receipt for a caller that already has owners.

    The full in-process cycle may include large diagnostic snapshots.  Matrix
    needs only the terminal and immutable owner pointers; Packet, execution,
    outcome and Learning remain durably owned by their existing stores.
    """
    result = result if isinstance(result, dict) else {}
    receipt = {
        "schema_version": "v7.governed-execution-transaction-receipt.v1",
        "full_cycle_embedded": False,
        "evidence_owners": {
            "packet_and_lease": "operator-execution-lease.json",
            "execution_and_outcome": "execution-events.jsonl",
            "governance": "operator-execution-audit.jsonl + governance-lifecycle.jsonl",
            "learning": "closure-records.jsonl",
        },
    }
    for key in (
        "final_verdict", "transaction_status", "stop_reason", "fresh_packet_id",
        "decision_id", "operation_id", "selected_move_hash", "user", "source",
        "target", "users", "sources", "targets", "requested_max_users",
        "one_execution_attempt", "runtime_mutation_performed",
        "restore_barrier_written_now", "apply_executed", "verification_result",
        "rollback_attempted", "rollback_result", "a4_evidence_updated",
        "users_moved", "runtime_automation_enabled", "authority_expanded",
        "production_proven", "error", "stop_detail",
        "execution_timing",
    ):
        if key in result:
            receipt[key] = result.get(key)
    downstream = result.get("downstream_proof_diagnostic")
    if isinstance(downstream, dict) and downstream:
        receipt["downstream_proof_diagnostic"] = {
            key: downstream.get(key)
            for key in (
                "apply_command_ok", "apply_returncode", "apply_timed_out",
                "child_final_verdict", "child_transaction_status",
                "child_stop_reason", "child_stop_detail", "proof_blockers",
                "capability_production_proven",
            )
            if downstream.get(key) not in (None, "", [], {})
            or key in {"apply_command_ok", "apply_timed_out"}
        }
    partial_apply = result.get("partial_apply_reconciliation")
    if isinstance(partial_apply, dict) and partial_apply:
        receipt["partial_apply_reconciliation"] = {
            key: partial_apply.get(key)
            for key in (
                "schema_version",
                "status",
                "operation_id",
                "packet_id",
                "user",
                "source",
                "target",
                "current_egress",
                "verification_complete",
                "rollback_required",
                "child_timed_out",
                "child_returncode",
                "terminal_reason",
            )
            if partial_apply.get(key) not in (None, "", [], {})
        }
    cycle = result.get("cycle")
    if isinstance(cycle, dict) and cycle:
        candidate = (
            cycle.get("candidate")
            if isinstance(cycle.get("candidate"), dict)
            else {}
        )
        packet_preview = (
            cycle.get("packet_preview")
            if isinstance(cycle.get("packet_preview"), dict)
            else {}
        )
        safety_gates = (
            (cycle.get("dry_run") or {}).get("safety_gates")
            if isinstance((cycle.get("dry_run") or {}).get("safety_gates"), dict)
            else {}
        )
        receipt["packet_preparation_diagnostic"] = {
            "cycle_stop_reason": str(cycle.get("stop_reason") or ""),
            "cycle_stop_detail": str(cycle.get("stop_detail") or ""),
            "candidate_user": str(candidate.get("user") or ""),
            "candidate_source": str(
                candidate.get("current_channel") or ""
            ),
            "candidate_target": str(
                candidate.get("recommended_channel") or ""
            ),
            "packet_preview_status": str(
                packet_preview.get("status") or ""
            ),
            "packet_binding_blockers": list(
                packet_preview.get("binding_blockers") or []
            )[:12],
            "safety_hard_stop": bool(safety_gates.get("hard_stop")),
            "safety_blockers": list(
                safety_gates.get("hard_stop_blockers") or []
            )[:12],
        }
    policy_binding = result.get("standing_delegated_policy_binding")
    if isinstance(policy_binding, dict):
        receipt["standing_delegated_policy_binding"] = {
            key: policy_binding.get(key)
            for key in (
                "contract_id", "contract_hash", "max_users_per_action",
                "max_concurrent_transactions", "action_class", "expires_at",
            )
            if policy_binding.get(key) not in (None, "", [], {})
        }
        campaign_binding = policy_binding.get(
            "controlled_certification_campaign_binding"
        )
        if isinstance(campaign_binding, dict):
            receipt["standing_delegated_policy_binding"][
                "controlled_certification_campaign_binding"
            ] = {
                key: campaign_binding.get(key)
                for key in (
                    "required",
                    "ok",
                    "request_id",
                    "request_hash",
                    "decision_id",
                    "source_id",
                    "stage",
                )
                if campaign_binding.get(key) not in (None, "", [], {})
            }
    binding = result.get("service_failure_causal_binding")
    if isinstance(binding, dict):
        receipt["service_failure_causal_binding"] = {
            key: binding.get(key)
            for key in (
                "automation_obligation_id", "omp_consumption_id",
                "source_incident_id", "source_event_id", "observation_generation",
                "source_channel", "event_type", "event_provenance", "source_scope",
            )
            if binding.get(key) not in (None, "", [], {})
        }
    feedback = result.get("feedback_materialization")
    if isinstance(feedback, dict):
        receipt["feedback_materialization"] = {
            key: feedback.get(key)
            for key in ("materialized", "feedback_id", "outcome_id", "learning_record_id", "reason")
            if feedback.get(key) not in (None, "", [], {})
        }
    learning = result.get("l3_learning_closure")
    if isinstance(learning, dict):
        closure = (
            learning.get("execution_closure_verification")
            if isinstance(
                learning.get("execution_closure_verification"),
                dict,
            )
            else {}
        )
        capability = (
            learning.get("capability_state")
            if isinstance(learning.get("capability_state"), dict)
            else {}
        )
        receipt["l3_learning_closure"] = {
            "active": bool(learning.get("active")),
            "materialized": bool(learning.get("materialized")),
            "reason": str(learning.get("reason") or ""),
            "operation_id": str(learning.get("operation_id") or ""),
            "records": dict(learning.get("records") or {}),
            "capability_state": {
                key: capability.get(key)
                for key in (
                    "state",
                    "validated",
                    "production_proven",
                    "omp_consumable",
                    "runtime_ready_for_next_incident",
                )
                if capability.get(key) not in (None, "", [], {})
            },
            "execution_closure_verification": {
                "behavior_chain_status": str(
                    closure.get("behavior_chain_status") or ""
                ),
                "terminal_consumer_verified": bool(
                    closure.get("terminal_consumer_verified")
                ),
                "operation_id": str(closure.get("operation_id") or ""),
                "terminal_outcome": str(
                    closure.get("terminal_outcome") or ""
                ),
            },
        }
    return receipt


def governed_execution_timing_projection(
    *,
    transaction_started_ns: int,
    planner_completed_ns: int,
    packet_completed_ns: int,
    clearance_completed_ns: int,
    apply_completed_ns: int,
    feedback_completed_ns: int,
    affected_users: int,
) -> dict[str, Any]:
    """Bind monotonic critical-path spans to the existing Runtime Time owner.

    UTC timestamps remain audit/order metadata.  Durations are calculated only
    from one process-local monotonic clock and are never reconstructed by
    subtracting wall clocks.  The projection is compact and embedded in the
    existing transaction receipt; it is not a new ledger or truth source.
    """
    points = [
        transaction_started_ns,
        planner_completed_ns,
        packet_completed_ns,
        clearance_completed_ns,
        apply_completed_ns,
        feedback_completed_ns,
    ]
    if any(point < transaction_started_ns for point in points) or points != sorted(points):
        return {
            "schema_version": "v7.governed-execution-timing.v1",
            "status": "INVALID_MONOTONIC_SEQUENCE",
            "clock_source": "time.monotonic_ns",
            "durable_owner": "existing governed transaction receipt",
        }

    def duration_ms(start: int, end: int) -> float:
        return round(max(0, end - start) / 1_000_000.0, 3)

    spans = [
        {
            "stage": "planner",
            "duration_ms": duration_ms(transaction_started_ns, planner_completed_ns),
        },
        {
            "stage": "packet_and_lease",
            "duration_ms": duration_ms(planner_completed_ns, packet_completed_ns),
        },
        {
            "stage": "restore_barrier",
            "duration_ms": duration_ms(packet_completed_ns, clearance_completed_ns),
        },
        {
            # The existing autoswitch child owns route apply plus its mandatory
            # live verification.  Do not fabricate a finer split until that
            # producer exposes one.
            "stage": "apply_and_verification",
            "duration_ms": duration_ms(clearance_completed_ns, apply_completed_ns),
        },
        {
            "stage": "feedback_and_learning",
            "duration_ms": duration_ms(apply_completed_ns, feedback_completed_ns),
        },
    ]
    total_ms = duration_ms(transaction_started_ns, feedback_completed_ns)
    ordered = sorted(spans, key=lambda row: float(row["duration_ms"]), reverse=True)
    users = max(1, int(affected_users or 1))
    span_by_stage = {str(row["stage"]): float(row["duration_ms"]) for row in spans}
    existing_owner_analysis = (
        operator_execution_pipeline.execution_performance_foundation(
            planner_result={
                "stage": "planner",
                "duration_ms": span_by_stage["planner"],
                "operation": {"selected_move_count": users},
            },
            contracts=[
                {
                    "contract_id": "current-transaction-packet-and-lease",
                    "stage": "packet",
                    "duration_ms": span_by_stage["packet_and_lease"],
                    "selected_move_count": users,
                },
                {
                    "contract_id": "current-transaction-restore-barrier",
                    "stage": "restore_barrier",
                    "duration_ms": span_by_stage["restore_barrier"],
                },
            ],
            events=[
                {
                    "event_id": "current-transaction-apply-and-verification",
                    "event_type": "APPLY_COMPLETED",
                    "duration_ms": span_by_stage["apply_and_verification"],
                },
                {
                    "event_id": "current-transaction-feedback-and-learning",
                    "event_type": "FEEDBACK_MATERIALIZED",
                    "duration_ms": span_by_stage["feedback_and_learning"],
                },
            ],
        )
    )
    requested_metrics = existing_owner_analysis.get("requested_metrics") or {}
    slow_metrics = sorted(
        (
            {
                "metric": name,
                "value_ms": float(metric.get("value") or 0.0),
                "threshold_ms": float(
                    operator_execution_pipeline.SLOW_PATH_THRESHOLDS_MS.get(name)
                    or 0.0
                ),
            }
            for name, metric in requested_metrics.items()
            if isinstance(metric, dict)
            and metric.get("available")
            and float(metric.get("value") or 0.0)
            > float(operator_execution_pipeline.SLOW_PATH_THRESHOLDS_MS.get(name) or 0.0)
        ),
        key=lambda row: row["value_ms"],
        reverse=True,
    )
    return {
        "schema_version": "v7.governed-execution-timing.v1",
        "status": "MONOTONIC_BREAKDOWN_CONSUMED",
        "clock_source": "time.monotonic_ns",
        "wall_clock_used_for_elapsed": False,
        "unit": "milliseconds",
        "spans": spans,
        "total_duration_ms": total_ms,
        "per_user_duration_ms": round(total_ms / users, 3),
        "dominant_stage": str((ordered[0] if ordered else {}).get("stage") or "NONE"),
        "dominant_duration_ms": float((ordered[0] if ordered else {}).get("duration_ms") or 0.0),
        "analysis_consumer": "admin_core.operator_execution_pipeline.execution_performance_foundation",
        "analysis_schema_version": str(existing_owner_analysis.get("schema_version") or ""),
        "available_metrics": list(existing_owner_analysis.get("available_metrics") or []),
        "missing_metrics": list(existing_owner_analysis.get("missing_metrics") or []),
        "slow_paths": slow_metrics[:3],
        "durable_owner": "existing governed transaction receipt",
        "bounded_rows_per_transaction": len(spans),
        "raw_identity_list_stored": False,
    }


def controlled_topology_cli_output(
    result: dict[str, Any],
    *,
    compact: bool,
) -> dict[str, Any]:
    """Preserve topology-owner effects in the compact Matrix receipt."""
    output = (
        compact_transaction_result(result.get("transaction") or {})
        if compact
        and result.get("final_verdict")
        == "ONE_IDENTITY_AUTONOMOUS_CONTROLLED_TOPOLOGY_TRIAL_PROVEN"
        else dict(result)
    )
    output["controlled_topology_final_verdict"] = result.get("final_verdict")
    output["controlled_topology_manifest_hash"] = result.get("manifest_hash")
    output["controlled_topology_trial_identity"] = result.get("trial_identity")
    output["controlled_topology_source"] = result.get("source")
    output["controlled_topology_target"] = result.get("target")
    for key in (
        "reservation_mutation_performed",
