def bounded_delegated_policy_admission(
    packet_preview: dict[str, Any],
    cycle: dict[str, Any],
    *,
    live_policy_contract: dict[str, Any] | None = None,
    authority_audit_records: list[dict[str, Any]] | None = None,
) -> dict[str, Any]:
    contract_validation = operator_execution.validate_standing_delegated_operational_policy(
        live_policy_contract or {},
        audit_records=authority_audit_records,
    )
    policy = autonomy_trust_acceleration.build_delegated_autonomy_policy_preview(
        contract_validation.get("policy") if contract_validation.get("ok") else {},
    )
    selected_count = int(packet_preview.get("selected_move_count") or len(packet_preview.get("allowed_users") or []))
    authorized_max_users = int(policy.get("max_users_per_action") or 0)
    action_class = operator_execution.SERVICE_FAILURE_DELEGATED_ACTION_CLASSES.get(
        authorized_max_users,
        "UNKNOWN_ACTION_CLASS",
    )
    blockers = list(contract_validation.get("errors") or [])
    exact_requirements = {
        "policy_state": "APPROVED",
        "current_mode": "DELEGATED_AUTONOMY",
        "max_users_per_action": authorized_max_users,
        "max_concurrent_transactions": 1,
        "candidate_selection": "EXISTING_PLANNER_ONLY",
        "candidate_identity": "FRESH_ONLY",
        "packet_generation": "FRESH_IMMEDIATELY_BEFORE_EXECUTION",
        "packet_reuse": "FORBIDDEN",
        "historical_identity_reuse": "FORBIDDEN",
        "operator_candidate_approval_required": False,
        "operator_packet_approval_required": False,
        "operator_hash_approval_required": False,
        "self_expansion_allowed": False,
        "final_safe_mode": "OPEN",
    }
    for field, expected in exact_requirements.items():
        if policy.get(field) != expected:
            blockers.append(f"POLICY_{field.upper()}_MISMATCH")
    if action_class not in set(policy.get("allowed_action_classes") or []):
        blockers.append("ACTION_CLASS_NOT_ALLOWED")
    if (
        authorized_max_users not in operator_execution.SERVICE_FAILURE_DELEGATED_ACTION_CLASSES
        or selected_count < 1
        or selected_count > authorized_max_users
    ):
        blockers.append("BLAST_RADIUS_OUTSIDE_AUTHORIZED_TIER")
    if cycle.get("stop_reason") != "AUTHORITY_BOUNDARY" or packet_preview.get("status") != "PACKET_PREVIEW_READY":
        blockers.append("LIVE_MACHINE_GATES_NOT_READY")
    if not packet_preview.get("operation_id") or not packet_preview.get("decision_id"):
        blockers.append("FRESH_OPERATION_IDENTITY_MISSING")
    if not packet_preview.get("selected_move_hash"):
        blockers.append("SELECTED_MOVE_BINDING_MISSING")
    if not packet_preview.get("source_hashes") or not packet_preview.get("snapshot_bundle_hash"):
        blockers.append("OPERATION_SCOPED_SOURCE_BINDING_MISSING")
    rollback = packet_preview.get("rollback_manifest_preview") or {}
    if not rollback.get("items"):
        blockers.append("ROLLBACK_MANIFEST_MISSING")
    rollback_items = rollback.get("items") if isinstance(rollback.get("items"), list) else []
    source = str((rollback_items[0] if rollback_items else {}).get("rollback_target") or "")
    event_rows = (
        (cycle.get("event_consumer") or {}).get("events")
        if isinstance(cycle.get("event_consumer"), dict)
        else []
    )
    qualifying_event = {}
    allowed_event_types = {
        "external_channel_unavailability",
        "service_failure",
        "service_matrix_regression",
        "service_regression",
        "channel_quality_regression",
        # The existing Service Matrix has a distinct causal event for a
        # continuing failed episode.  It is a fresh observation generation of
        # the same incident, not a second outage and not a reused Candidate.
        "SERVICE_FAILURE_OBSERVED",
        "SERVICE_FAILURE_REVALIDATED",
    }
    now = datetime.now(timezone.utc)
    for raw_event in reversed(event_rows if isinstance(event_rows, list) else []):
        if not isinstance(raw_event, dict):
            continue
        # Event JSONL producers use their canonical field names (for example
        # ``channel`` and ``observed_at``).  The governed-cycle contract uses
        # the existing normalized projection (``object`` and ``timestamp``).
        # Normalize at this consumer boundary so a real fresh Matrix
        # revalidation cannot disappear merely because the two existing
        # owners name the same facts differently.  This does not grant any
        # execution permission: every provenance, identity, freshness,
        # Candidate, Packet and live gate below remains mandatory.
        event = events.normalize_regression_event(raw_event)
        if str(event.get("event_type") or "") not in allowed_event_types:
            continue
        if source and str(event.get("object") or "") != source:
            continue
        event_type = str(event.get("event_type") or "")
        if event_type in {"SERVICE_FAILURE_OBSERVED", "SERVICE_FAILURE_REVALIDATED"}:
            # Only accept the existing Matrix capture-only evidence contract.
            # A hand-written event, missing incident identity, or a different
            # provenance cannot manufacture the delegated-action trigger.
            if not bool(event.get("capture_only")):
                continue
            if str(event.get("event_provenance") or "") != "EXTERNAL_UNATTRIBUTED":
                continue
            if not str(event.get("source_incident_id") or ""):
                continue
            if event_type == "SERVICE_FAILURE_REVALIDATED" and not str(event.get("observation_generation") or ""):
                continue
            if event_type == "SERVICE_FAILURE_OBSERVED" and not str(event.get("failure_episode_id") or ""):
                continue
        try:
            observed = datetime.fromisoformat(str(event.get("timestamp") or "").replace("Z", "+00:00"))
            if observed.tzinfo is None:
                observed = observed.replace(tzinfo=timezone.utc)
            age_seconds = (now - observed.astimezone(timezone.utc)).total_seconds()
        except (TypeError, ValueError):
            continue
        if 0 <= age_seconds <= 1800:
            qualifying_event = event
            break
    if not qualifying_event:
        blockers.append("FRESH_MATCHING_SERVICE_FAILURE_EVENT_MISSING")
    blockers = list(dict.fromkeys(blockers))
    authority = {
        "authority_basis": "DELEGATED_AUTONOMY_POLICY",
        "policy_id": str(policy.get("policy_id") or ""),
        "policy_scope_hash": str(policy.get("policy_scope_hash") or ""),
        "normalized_scope": dict(policy.get("normalized_scope") or {}),
        "policy_state": str(policy.get("policy_state") or ""),
        "current_mode": str(policy.get("current_mode") or ""),
        "action_class": action_class,
        "max_users_per_transaction": int(policy.get("max_users_per_action") or 0),
        "max_concurrent_transactions": int(policy.get("max_concurrent_transactions") or 0),
        "candidate_identity": str(policy.get("candidate_identity") or ""),
        "packet_reuse": str(policy.get("packet_reuse") or ""),
        "self_expansion_allowed": bool(policy.get("self_expansion_allowed")),
        "engineering_authority_source": "V7_OMP_BOUNDED_DELEGATED_AUTONOMY_AND_PACKET_APPROVAL_RETIREMENT_V1",
        "standing_policy_contract": copy.deepcopy(contract_validation.get("contract") or {}),
        "authority_audit_verified": not bool(contract_validation.get("errors")),
    }
    return {
        "schema_version": "v7.bounded-delegated-policy-admission.v1",
        "allowed": not blockers,
        "blockers": blockers,
        "policy": policy,
        "authority": authority,
        "candidate_approval_required": False,
        "packet_approval_required": False,
        "hash_approval_required": False,
        "live_machine_gates_preserved": True,
        "qualifying_service_failure_event": qualifying_event,
    }


def packet_materialization_authority(
    *,
    delegated_mode: bool,
    setup_mode: bool,
    delegated_admission: dict[str, Any],
) -> dict[str, Any] | None:
    """Return only authority contracts understood by the canonical packet owner.

    Controlled-certification setup is explicitly operator-authorized and keeps
    the packet owner's existing dual-confirmation contract.  It must not be
    mislabeled as delegated autonomy merely to share the same execution path.
    """
    if delegated_mode and not setup_mode:
        authority = (
            delegated_admission.get("authority")
            or delegated_admission.get("delegated_policy_authority")
        )
        return authority if isinstance(authority, dict) and authority else None
    return None


def controlled_topology_standing_execution_binding(
    args: argparse.Namespace,
    *,
    state_dir: Path,
) -> dict[str, Any]:
    """Revalidate one topology manifest through its existing Planner and policy owners."""
    policy_root = read_json(Path(args.policy_file), {})
    contract = (
        policy_root.get("delegated_autonomy_policy")
        if isinstance(policy_root.get("delegated_autonomy_policy"), dict)
        else {}
    )
    validation = operator_execution.validate_standing_delegated_operational_policy(
        contract,
        audit_records=live_policy_lineage_records(args),
    )
    policy = validation.get("policy") if isinstance(validation.get("policy"), dict) else {}
    scopes = (
        policy.get("action_class_scopes")
        if isinstance(policy.get("action_class_scopes"), dict)
        else {}
    )
    topology_scope = (
        scopes.get(operator_execution.CONTROLLED_TOPOLOGY_DELEGATED_ACTION_CLASS)
        if isinstance(
            scopes.get(operator_execution.CONTROLLED_TOPOLOGY_DELEGATED_ACTION_CLASS),
            dict,
        )
        else {}
    )
    blockers = list(validation.get("errors") or [])
    expected_contract_id = str(
        getattr(args, "expected_standing_policy_contract_id", "") or ""
    )
    expected_contract_hash = str(
        getattr(args, "expected_standing_policy_contract_hash", "") or ""
    )
    expected_manifest_hash = str(
        getattr(args, "expected_controlled_topology_manifest_hash", "") or ""
    )
    expected_user = str(getattr(args, "controlled_topology_user", "") or "")
    expected_source = str(getattr(args, "controlled_topology_source", "") or "")
    expected_target = str(getattr(args, "controlled_topology_target", "") or "")
    if str(contract.get("contract_id") or "") != expected_contract_id:
        blockers.append("controlled_topology_contract_id_changed")
    if str(contract.get("contract_hash") or "") != expected_contract_hash:
        blockers.append("controlled_topology_contract_hash_changed")
    if str(policy.get("policy_profile") or "") not in {
        operator_execution.CONTROLLED_TOPOLOGY_STANDING_POLICY_PROFILE,
        operator_execution.AVAILABILITY_FIRST_STANDING_POLICY_PROFILE,
    }:
        blockers.append("controlled_topology_policy_profile_not_active")
    if (
        operator_execution.CONTROLLED_TOPOLOGY_DELEGATED_ACTION_CLASS
        not in set(policy.get("allowed_action_classes") or [])
    ):
        blockers.append("controlled_topology_action_class_not_allowed")
    if list(topology_scope.get("allowed_actions") or []) != [
        "REBIND_CONTROLLED_CERTIFICATION_SOURCE"
    ]:
        blockers.append("controlled_topology_action_scope_changed")
    if int(topology_scope.get("max_users_per_transaction") or 0) != 1:
        blockers.append("controlled_topology_max_users_not_one")
    if int(topology_scope.get("max_concurrent_transactions") or 0) != 1:
        blockers.append("controlled_topology_concurrency_not_one")
    if not bool(topology_scope.get("certification_identities_only")):
        blockers.append("controlled_topology_certification_only_missing")
    if bool(topology_scope.get("ordinary_assignment_mutation_allowed")):
        blockers.append("controlled_topology_ordinary_assignment_allowed")
    if int(topology_scope.get("ordinary_identity_delta") or 0) != 0:
        blockers.append("controlled_topology_ordinary_identity_delta_nonzero")
    if int(topology_scope.get("ordinary_route_delta") or 0) != 0:
        blockers.append("controlled_topology_ordinary_route_delta_nonzero")
    if not all(
        (expected_manifest_hash, expected_user, expected_source, expected_target)
    ):
        blockers.append("controlled_topology_expected_identity_incomplete")

    planner_command = [
        str(getattr(args, "controlled_topology_planner", "") or "v7-users-autoswitch"),
        "--controlled-source-topology-diagnostic",
        "--state-dir",
        str(state_dir),
        "--policy-file",
        str(args.policy_file),
        "--action-class-audit-store",
        str(args.operator_execution_audit_store),
    ]
    try:
        proc = subprocess.run(
            planner_command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=180,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        proc = None
        diagnostic: dict[str, Any] = {}
        blockers.append(f"controlled_topology_planner_unavailable:{type(exc).__name__}")
    else:
        try:
            parsed = json.loads(proc.stdout or "")
            diagnostic = parsed if isinstance(parsed, dict) else {}
        except json.JSONDecodeError:
            diagnostic = {}
        if proc.returncode != 0:
            blockers.append("controlled_topology_planner_failed")
    preflight = (
        diagnostic.get("production_preflight")
        if isinstance(diagnostic.get("production_preflight"), dict)
        else {}
    )
    manifest = (
        preflight.get("manifest")
        if isinstance(preflight.get("manifest"), dict)
        else {}
    )
    admission = (
        diagnostic.get("standing_policy_admission")
        if isinstance(diagnostic.get("standing_policy_admission"), dict)
        else {}
    )
    if diagnostic.get("status") != "CONTROLLED_SOURCE_TOPOLOGY_PRODUCTION_PREFLIGHT_READY":
        blockers.append("controlled_topology_preflight_not_ready")
    if (
        admission.get("status")
        != "AUTO_ADMITTED_BY_STANDING_DELEGATED_CONTROLLED_TOPOLOGY_POLICY"
        or admission.get("ok") is not True
    ):
        blockers.append("controlled_topology_standing_policy_not_admitted")
    if str(admission.get("contract_id") or "") != expected_contract_id:
        blockers.append("controlled_topology_admission_contract_id_changed")
    if str(admission.get("contract_hash") or "") != expected_contract_hash:
        blockers.append("controlled_topology_admission_contract_hash_changed")
    for actual, expected, reason in (
        (
            manifest.get("manifest_hash"),
            expected_manifest_hash,
            "controlled_topology_manifest_hash_changed",
        ),
        (
            manifest.get("trial_identity"),
            expected_user,
            "controlled_topology_trial_identity_changed",
        ),
        (
            manifest.get("existing_source"),
            expected_source,
            "controlled_topology_existing_source_changed",
        ),
        (
            manifest.get("selected_source_or_draft"),
            expected_target,
            "controlled_topology_selected_target_changed",
        ),
    ):
        if str(actual or "") != str(expected or ""):
            blockers.append(reason)
    if int(manifest.get("trial_identity_count") or 0) != 1:
        blockers.append("controlled_topology_trial_count_not_one")
    if str(manifest.get("expected_ordinary_assignment_delta") or "") != "NONE":
        blockers.append("controlled_topology_ordinary_assignment_delta_changed")
    if str(manifest.get("expected_ordinary_route_delta") or "") != "NONE":
        blockers.append("controlled_topology_ordinary_route_delta_changed")

    users = read_registry(state_dir / "users.registry")
    egress = read_registry(state_dir / "egress.registry")
    user_rows = [row for row in users if str(row.get("ip") or "") == expected_user]
    target_rows = [
        row for row in egress if str(row.get("id") or "") == expected_target
    ]
    if len(user_rows) != 1:
        blockers.append("controlled_topology_user_identity_not_unique")
    else:
        user_row = user_rows[0]
        if not bool_value(user_row.get("certification_user")):
            blockers.append("controlled_topology_user_not_certification_identity")
        if str(user_row.get("current") or "") != expected_source:
            blockers.append("controlled_topology_user_source_changed")
    if len(target_rows) != 1:
        blockers.append("controlled_topology_target_identity_not_unique")
    target_assigned = [
        row for row in users
        if bool_value(row.get("enabled", "1"))
        and str(row.get("current") or "") == expected_target
    ]
    manifest_group = str(manifest.get("certification_group") or "")
    continuing_target = bool(
        target_assigned
        and manifest.get("reservation_mode")
        == "RENEW_AND_CONTINUE_SAME_CAMPAIGN_CERTIFICATION_SOURCE"
        and manifest_group
        and all(
            bool_value(row.get("certification_user"))
            and str(row.get("certification_group") or "")
            == manifest_group
            for row in target_assigned
        )
        and len(target_rows) == 1
        and bool_value(target_rows[0].get("controlled_certification_source"))
        and str(target_rows[0].get("reservation_owner") or "")
        == "operator_execution_governance"
    )
    if target_assigned and not continuing_target:
        blockers.append(
            "controlled_topology_target_not_empty_same_campaign_continuation"
        )

    authority = {
        "authority_basis": "DELEGATED_AUTONOMY_POLICY",
        "policy_id": str(policy.get("policy_id") or ""),
        "policy_scope_hash": str(contract.get("policy_scope_hash") or ""),
        "normalized_scope": (
            autonomy_trust_acceleration.normalized_delegated_autonomy_scope(
                policy
            )
        ),
        "policy_state": str(policy.get("policy_state") or ""),
        "current_mode": str(policy.get("current_mode") or ""),
        "engineering_authority_source": (
            "V7_SERVICE_FAILURE_AUTOMATION_EVOLUTION_PROGRAM_V1"
        ),
        "action_class": (
            operator_execution.CONTROLLED_TOPOLOGY_DELEGATED_ACTION_CLASS
        ),
        "max_users_per_transaction": 1,
        "max_concurrent_transactions": 1,
        "candidate_identity": "FRESH_ONLY",
        "packet_reuse": "FORBIDDEN",
        "self_expansion_allowed": False,
        "standing_policy_contract": copy.deepcopy(contract),
        "topology_manifest": copy.deepcopy(manifest),
        "authority_audit_verified": bool(validation.get("ok")),
    }
    return {
        "schema_version": "v7.controlled-topology-standing-execution-binding.v1",
        "allowed": not blockers,
        "ok": not blockers,
        "blockers": sorted(set(blockers)),
        "contract_id": str(contract.get("contract_id") or ""),
        "contract_hash": str(contract.get("contract_hash") or ""),
        "policy_scope_hash": str(contract.get("policy_scope_hash") or ""),
        "manifest": manifest,
        "diagnostic_status": str(diagnostic.get("status") or ""),
        "authority": authority,
        "planner_command": planner_command,
        "runtime_mutation_performed": False,
        "users_moved": 0,
    }


def controlled_certification_evidence_scope(state_dir: Path, *, user: str, source: str) -> bool:
    users = {str(row.get("ip") or ""): row for row in read_registry(state_dir / "users.registry")}
    sources = {str(row.get("id") or ""): row for row in read_registry(state_dir / "egress.registry")}
    user_row = users.get(str(user or ""), {})
    source_row = sources.get(str(source or ""), {})
    return (
        str(user_row.get("certification_user") or "").lower() in {"1", "true", "yes"}
        and str(source_row.get("controlled_certification_source") or "").lower() in {"1", "true", "yes"}
    )


def attach_l3_operation_scoped_binding(
    plan: dict[str, Any],
    *,
    state_dir: Path,
    snapshot_root: Path,
) -> dict[str, Any]:
    selected = operator_execution.selected_moves_from_plan(plan)
    moves = selected.get("moves") if isinstance(selected.get("moves"), list) else []
    if not moves:
        return {
            "status": "STOP_SAFE",
            "reason": "l3_operation_scoped_binding_requires_selected_moves",
            "selected_move_count": len(moves),
        }
    if len(moves) == 1:
        binding = operation_scoped_binding.read_binding(
            state_dir=state_dir,
            snapshot_root=snapshot_root,
            selected=moves[0],
        )
    else:
        binding = operation_scoped_binding.read_cohort_binding(
            state_dir=state_dir,
            snapshot_root=snapshot_root,
            selected_moves=moves,
        )
    if binding.get("status") != "BOUND":
        return binding
    safety = plan.setdefault("safety", {})
    atomic = safety.setdefault("atomic_execution_envelope", {})
    atomic["source_bundle"] = {
        "schema_version": operation_scoped_binding.SCHEMA_VERSION,
        "source_hashes": dict(binding.get("source_hashes") or {}),
        "hash": str(binding.get("source_bundle_hash") or ""),
    }
    atomic["source_bundle_hash"] = str(binding.get("source_bundle_hash") or "")
    atomic["snapshot_bundle_hash"] = str(binding.get("snapshot_bundle_hash") or "")
    atomic["operation_scoped_binding"] = binding
    rebound = operator_execution.selected_moves_from_plan(plan)
    atomic["envelope_id"] = str(rebound.get("atomic_execution_envelope_id") or "")
    atomic["envelope_hash"] = str(rebound.get("atomic_execution_envelope_hash") or "")
    atomic["runtime_snapshot_hash"] = str(rebound.get("runtime_snapshot_hash") or "")
    atomic["selected_move_hash"] = str(rebound.get("selected_move_hash") or "")
    atomic["selected_move_count"] = int(rebound.get("selected_move_count") or 0)
    return binding


def standing_delegated_cohort_execution_binding(args: argparse.Namespace) -> dict[str, Any]:
    """Bind an automatic cohort execution to the exact Matrix-read contract."""
    root = read_json(Path(args.policy_file), {})
    contract = root.get("delegated_autonomy_policy")
    contract = contract if isinstance(contract, dict) else {}
    validation = operator_execution.validate_standing_delegated_operational_policy(
        contract,
        audit_records=live_policy_lineage_records(args),
    )
    policy = validation.get("policy") if isinstance(validation.get("policy"), dict) else {}
    requested_max_users = int(getattr(args, "max_users", 0) or 0)
    availability_mode = bool(
        getattr(args, "execute_availability_first_standing_stage", False)
        or getattr(args, "_availability_first_stage_request", None)
    )
    expected_contract_id = str(getattr(args, "expected_standing_policy_contract_id", "") or "")
    expected_contract_hash = str(getattr(args, "expected_standing_policy_contract_hash", "") or "")
    action_class = (
        operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
        if availability_mode
        else operator_execution.SERVICE_FAILURE_DELEGATED_ACTION_CLASSES.get(
            requested_max_users,
            "",
        )
    )
    blockers = list(validation.get("errors") or [])
    state_dir = Path(getattr(args, "state_dir", DEFAULT_STATE_DIR))
    approved_source = str(getattr(args, "approved_source", "") or "")
    source_row = next((
        row for row in read_registry(state_dir / "egress.registry")
        if str(row.get("id") or "") == approved_source
    ), {})
    controlled_source = bool_value(
        source_row.get("controlled_certification_source")
    )
    campaign_binding: dict[str, Any] = {
        "required": controlled_source,
        "ok": not controlled_source,
        "blockers": [],
    }
    if controlled_source and availability_mode:
        # The availability-first standing envelope is an independently
        # approved action class.  The older exact controlled-certification
        # campaign remains lineage, but its expiry must not revoke the newer
        # standing policy or recreate per-stage approval.  Fresh source,
        # target, allocation, Packet and lease checks remain mandatory below.
        source_assignments = [
            row
            for row in read_registry(state_dir / "users.registry")
            if str(row.get("enabled") or "1").lower()
            in {"1", "true", "yes"}
            and str(row.get("current") or "") == approved_source
        ]
        ordinary_on_source = [
            row
            for row in source_assignments
            if str(row.get("certification_user") or "").lower()
            not in {"1", "true", "yes"}
        ]
        source_blockers: list[str] = []
        if not source_row:
            source_blockers.append(
                "availability_first_controlled_source_missing"
            )
        if not controlled_source:
            source_blockers.append(
                "availability_first_source_not_controlled_certification_source"
            )
        if ordinary_on_source:
            source_blockers.append(
                "availability_first_controlled_source_contains_ordinary_users"
            )
        campaign_binding = {
            "schema_version": (
                "v7.availability-first-standing-source-binding.v1"
            ),
            "required": True,
            "ok": not source_blockers,
            "blockers": sorted(set(source_blockers)),
            "authority_basis": (
                operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
            ),
            "source_id": approved_source,
            "certification_users_on_source": (
                len(source_assignments) - len(ordinary_on_source)
            ),
            "ordinary_users_on_source": len(ordinary_on_source),
            "historical_campaign_request_id": str(
                getattr(
                    args,
                    "controlled_certification_campaign_request_id",
                    "",
                )
                or ""
            ),
            "historical_campaign_request_hash": str(
                getattr(
                    args,
                    "controlled_certification_campaign_request_hash",
                    "",
                )
                or ""
            ),
            "historical_campaign_is_authority": False,
            "self_expansion_allowed": False,
        }
        blockers.extend(source_blockers)
    elif controlled_source:
        campaign_request_id = str(
            getattr(
                args,
                "controlled_certification_campaign_request_id",
                "",
            ) or ""
        )
        campaign_request_hash = str(
            getattr(
                args,
                "controlled_certification_campaign_request_hash",
                "",
            ) or ""
        )
        campaign_stage = int(
            getattr(args, "controlled_certification_campaign_stage", 0) or 0
        )
        campaign_binding = approved_controlled_certification_substrate_binding(
            audit_store=Path(args.operator_execution_audit_store),
            request_id=campaign_request_id,
            request_hash=campaign_request_hash,
            required_subscopes={
                "CONTROLLED_SOURCE_CONDITION",
                "PROGRESSIVE_CAMPAIGN_EXECUTION",
            },
        )
        campaign_scope = (
            campaign_binding.get("scope")
            if isinstance(campaign_binding.get("scope"), dict)
            else {}
        )
        campaign_blockers = list(campaign_binding.get("blockers") or [])
        if str(campaign_binding.get("source_id") or "") != approved_source:
            campaign_blockers.append(
                "controlled_campaign_source_changed_after_matrix_admission"
            )
        if availability_mode:
            availability_request = (
                getattr(args, "_availability_first_stage_request", None)
                if isinstance(
                    getattr(args, "_availability_first_stage_request", None),
                    dict,
                )
                else {}
            )
            availability_stage = int(
                availability_request.get("stage")
                or getattr(args, "availability_first_stage", 0)
                or 0
            )
            if (
                availability_stage
                not in operator_execution.AVAILABILITY_FIRST_LADDER
            ):
                campaign_blockers.append(
                    "availability_first_stage_not_in_standing_ladder"
                )
            if not 0 < requested_max_users <= availability_stage:
                campaign_blockers.append(
                    "availability_first_subtransaction_scope_invalid"
                )
        else:
            if campaign_stage not in set(
                int(item)
                for item in (campaign_scope.get("campaign_stages") or [])
            ):
                campaign_blockers.append(
                    "controlled_campaign_stage_not_approved"
                )
            if campaign_stage != requested_max_users:
                campaign_blockers.append(
                    "controlled_campaign_stage_transaction_limit_mismatch"
                )
        campaign_binding = {
            **campaign_binding,
            "required": True,
            "ok": not campaign_blockers,
            "blockers": sorted(set(campaign_blockers)),
            "stage": (
                int(
                    (
                        getattr(
                            args,
                            "_availability_first_stage_request",
                            {},
                        )
                        or {}
                    ).get("stage")
                    or getattr(args, "availability_first_stage", 0)
                    or 0
                )
                if availability_mode
                else campaign_stage
            ),
            "policy_ceiling": int(policy.get("max_users_per_action") or 0),
            "stage_is_narrower_than_policy_ceiling": (
                0 < campaign_stage
                < int(policy.get("max_users_per_action") or 0)
            ),
            "self_expansion_allowed": False,
        }
        blockers.extend(campaign_blockers)
    if not expected_contract_id or str(contract.get("contract_id") or "") != expected_contract_id:
        blockers.append("standing_policy_contract_id_changed_after_matrix_admission")
    if not expected_contract_hash or str(contract.get("contract_hash") or "") != expected_contract_hash:
        blockers.append("standing_policy_contract_hash_changed_after_matrix_admission")
    if (
        int(policy.get("max_users_per_action") or 0) != requested_max_users
        and not (
            controlled_source
            and campaign_binding.get("ok")
            and 0 < requested_max_users
            <= int(policy.get("max_users_per_action") or 0)
        )
    ):
        blockers.append("standing_policy_max_users_changed_after_matrix_admission")
    if int(policy.get("max_concurrent_transactions") or 0) != 1:
        blockers.append("standing_policy_concurrency_not_one")
    if action_class not in set(policy.get("allowed_action_classes") or []):
        blockers.append("standing_policy_action_class_not_allowed")
    if (
        not availability_mode
        and requested_max_users
        not in operator_execution.SERVICE_FAILURE_DELEGATED_ACTION_CLASSES
    ):
        blockers.append("standing_policy_tier_not_engineering_qualified")
    availability_scope: dict[str, Any] = {}
    availability_request: dict[str, Any] = {}
    if availability_mode:
        if (
            str(policy.get("policy_profile") or "")
            != operator_execution.AVAILABILITY_FIRST_STANDING_POLICY_PROFILE
        ):
            blockers.append(
                "availability_first_standing_policy_profile_not_active"
            )
        scopes = (
            policy.get("action_class_scopes")
            if isinstance(policy.get("action_class_scopes"), dict)
            else {}
        )
        availability_scope = (
            scopes.get(
                operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
            )
            if isinstance(
                scopes.get(
                    operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
                ),
                dict,
            )
            else {}
        )
        availability_request = (
            getattr(args, "_availability_first_stage_request", None)
            if isinstance(
                getattr(args, "_availability_first_stage_request", None),
                dict,
            )
            else {}
        )
        expected_target = str(
            availability_request.get("target_id")
            or getattr(args, "availability_first_target", "")
            or ""
        )
        expected_allocation_fingerprint = str(
            availability_request.get("allocation_fingerprint")
            or getattr(
                args,
                "expected_availability_first_allocation_fingerprint",
                "",
            )
            or ""
        )
        expected_subset_fingerprint = str(
            availability_request.get("subset_fingerprint")
            or getattr(
                args,
                "expected_availability_first_subset_fingerprint",
                "",
            )
            or ""
        )
        if int(
            availability_scope.get("max_users_per_transaction") or 0
        ) < requested_max_users:
            blockers.append(
                "availability_first_subtransaction_above_policy_ceiling"
            )
        if int(
            availability_scope.get("max_concurrent_transactions") or 0
        ) != 1:
            blockers.append("availability_first_concurrency_not_one")
        if not bool(
            availability_scope.get("certification_identities_only")
        ):
            blockers.append(
                "availability_first_certification_only_scope_missing"
            )
        if not all(
            (
                expected_target,
                expected_allocation_fingerprint,
                expected_subset_fingerprint,
            )
        ):
            blockers.append(
                "availability_first_exact_allocation_binding_incomplete"
            )
    policy_preview = autonomy_trust_acceleration.build_delegated_autonomy_policy_preview(
        policy if validation.get("ok") else {},
    )
    delegated_policy_authority = {
        "authority_basis": "DELEGATED_AUTONOMY_POLICY",
        "policy_id": str(policy_preview.get("policy_id") or ""),
        "policy_scope_hash": str(policy_preview.get("policy_scope_hash") or ""),
        "normalized_scope": dict(policy_preview.get("normalized_scope") or {}),
        "policy_state": str(policy_preview.get("policy_state") or ""),
        "current_mode": str(policy_preview.get("current_mode") or ""),
        "action_class": action_class,
        "max_users_per_transaction": requested_max_users,
        "max_concurrent_transactions": int(policy.get("max_concurrent_transactions") or 0),
        "candidate_identity": str(policy.get("candidate_identity") or ""),
        "packet_reuse": str(policy.get("packet_reuse") or ""),
        "self_expansion_allowed": bool(policy.get("self_expansion_allowed")),
        "engineering_authority_source": "V7_SERVICE_FAILURE_AUTOMATION_EVOLUTION_PROGRAM_V1",
        "standing_policy_contract": copy.deepcopy(contract),
        "authority_audit_verified": bool(validation.get("ok")),
        "controlled_certification_target_id": (
            str(
                availability_request.get("target_id")
                or getattr(args, "availability_first_target", "")
                or ""
            )
            if availability_mode
            else str(
                (
                    campaign_binding.get("scope")
                    if isinstance(campaign_binding.get("scope"), dict)
                    else {}
                ).get("controlled_target_id") or ""
            )
        ),
        "availability_first_allocation_fingerprint": str(
            availability_request.get("allocation_fingerprint")
            or getattr(
                args,
                "expected_availability_first_allocation_fingerprint",
                "",
            )
            or ""
        ),
        "availability_first_subset_fingerprint": str(
            availability_request.get("subset_fingerprint")
            or getattr(
                args,
                "expected_availability_first_subset_fingerprint",
                "",
            )
            or ""
        ),
    }
    return {
        "schema_version": "v7.standing-delegated-cohort-execution-binding.v1",
        "ok": not blockers,
        "blockers": sorted(set(blockers)),
        "contract_id": str(contract.get("contract_id") or ""),
        "contract_hash": str(contract.get("contract_hash") or ""),
        "expires_at": str(contract.get("expires_at") or ""),
        "max_users_per_action": int(policy.get("max_users_per_action") or 0),
        "max_concurrent_transactions": int(policy.get("max_concurrent_transactions") or 0),
        "action_class": action_class,
        "authority_audit_verified": bool(validation.get("ok")),
        "self_expansion_allowed": bool(policy.get("self_expansion_allowed")),
        "delegated_policy_authority": delegated_policy_authority,
        "controlled_certification_campaign_binding": campaign_binding,
        "availability_first": availability_mode,
        "availability_first_stage_request": availability_request,
        "availability_first_scope": availability_scope,
    }


def service_failure_obligation_execution_binding(
    args: argparse.Namespace,
    *,
    state_dir: Path,
    event_dir: Path,
) -> dict[str, Any]:
    """Bind cohort execution to one current consumed incident obligation.

    Matrix owns selection of the current obligation.  This executor independently
    re-reads the durable obligation, its OMP receipt, and a fresh capture-only
    observation before allowing the existing planner to materialize anything.
    """
    expected_obligation_id = str(
        getattr(args, "expected_service_failure_obligation_id", "") or ""
    )
    expected_incident_id = str(
        getattr(args, "expected_service_failure_incident_id", "") or ""
    )
    expected_scope_fingerprint = str(
        getattr(args, "expected_service_failure_scope_fingerprint", "") or ""
    )
    expected_source = str(getattr(args, "approved_source", "") or "")
    blockers: list[str] = []
    for value, reason in (
        (expected_obligation_id, "service_failure_obligation_id_missing"),
        (expected_incident_id, "service_failure_incident_id_missing"),
        (expected_scope_fingerprint, "service_failure_scope_fingerprint_missing"),
        (expected_source, "service_failure_source_missing"),
    ):
        if not value:
            blockers.append(reason)

    closure_rows = read_jsonl_family(state_dir / "closure-records.jsonl", limit=20000)
    obligations = [
        row for row in closure_rows
        if str(row.get("object_type") or "") == "service_failure_automation_obligation"
        and str(row.get("automation_obligation_id") or row.get("object_id") or "")
        == expected_obligation_id
    ]
    obligation = obligations[-1] if obligations else {}
    scope = (
        obligation.get("current_source_scope")
        if isinstance(obligation.get("current_source_scope"), dict)
        else {}
    )
    if not obligation:
        blockers.append("service_failure_obligation_not_durable")
    else:
        if str(obligation.get("closure_state") or "") != "READY_FOR_OMP_CONSUMPTION":
            blockers.append("service_failure_obligation_not_ready")
        if str(obligation.get("source_incident_id") or "") != expected_incident_id:
            blockers.append("service_failure_obligation_incident_mismatch")
        if str(obligation.get("channel") or "") != expected_source:
            blockers.append("service_failure_obligation_source_mismatch")
        if str(scope.get("affected_scope_fingerprint") or "") != expected_scope_fingerprint:
            blockers.append("service_failure_obligation_scope_fingerprint_mismatch")
        if int(scope.get("affected_scope_count") or 0) <= 0:
            blockers.append("service_failure_obligation_affected_scope_empty")
        if int(scope.get("unresolved_scope_count") or 0) <= 0:
            blockers.append("service_failure_obligation_unresolved_scope_empty")
        if str(obligation.get("stop_safe_classification") or "") != (
            "STOP_SAFE_FRESH_EVENT_REVALIDATION_REQUIRED"
        ):
            blockers.append("service_failure_obligation_not_actionable")

    consumptions = [
        row for row in closure_rows
        if str(row.get("object_type") or "") == "service_failure_automation_omp_consumption"
        and str(row.get("automation_obligation_id") or "") == expected_obligation_id
        and str(row.get("source_incident_id") or "") == expected_incident_id
    ]
    consumption = consumptions[-1] if consumptions else {}
    if not consumption:
        blockers.append("service_failure_obligation_omp_consumption_missing")
    else:
        if str(consumption.get("closure_state") or "") != "OMP_CONSUMED":
            blockers.append("service_failure_obligation_not_omp_consumed")
        if bool(consumption.get("runtime_mutation_performed")):
            blockers.append("service_failure_obligation_consumption_mutated_runtime")
        if bool(consumption.get("routing_mutation_performed")):
            blockers.append("service_failure_obligation_consumption_mutated_routing")
        if int(consumption.get("users_moved") or 0) != 0:
            blockers.append("service_failure_obligation_consumption_moved_users")

    allowed_types = {"SERVICE_FAILURE_OBSERVED", "SERVICE_FAILURE_REVALIDATED"}
    matching_events: list[dict[str, Any]] = []
    now = datetime.now(timezone.utc)
    for raw in read_jsonl_family(event_dir / "service-failure-events.jsonl", limit=20000):
        event = events.normalize_regression_event(raw)
        if str(event.get("event_type") or "") not in allowed_types:
            continue
        if str(event.get("source_incident_id") or "") != expected_incident_id:
            continue
        if str(event.get("object") or "") != expected_source:
            continue
        if not bool(event.get("capture_only")):
            continue
        if str(event.get("event_provenance") or "") != "EXTERNAL_UNATTRIBUTED":
            continue
        event_scope = event.get("source_scope") if isinstance(event.get("source_scope"), dict) else {}
        if str(event_scope.get("affected_scope_fingerprint") or "") != expected_scope_fingerprint:
            continue
        if int(event_scope.get("affected_scope_count") or 0) <= 0:
            continue
        try:
            observed = datetime.fromisoformat(
                str(event.get("timestamp") or "").replace("Z", "+00:00")
            )
            if observed.tzinfo is None:
                observed = observed.replace(tzinfo=timezone.utc)
            age_seconds = (now - observed.astimezone(timezone.utc)).total_seconds()
        except (TypeError, ValueError):
            continue
        if 0 <= age_seconds <= 1800:
            matching_events.append(event)
    event = matching_events[-1] if matching_events else {}
    if not event:
        blockers.append("fresh_matching_service_failure_event_missing")

    source_event_id = str(event.get("event_id") or "")
    return {
        "schema_version": "v7.service-failure-causal-binding.v1",
        "status": "BOUND" if not blockers else "STOP_SAFE",
        "ok": not blockers,
        "blockers": sorted(set(blockers)),
        "automation_obligation_id": expected_obligation_id,
        "omp_consumption_id": str(consumption.get("object_id") or ""),
        "source_incident_id": expected_incident_id,
        "source_event_id": source_event_id,
        "source_event_ids": [source_event_id] if source_event_id else [],
        "event_type": str(event.get("event_type") or ""),
        "event_provenance": str(event.get("event_provenance") or ""),
        "observation_generation": str(event.get("observation_generation") or ""),
        "source_channel": expected_source,
        "source_scope": dict(event.get("source_scope") or {}),
        "obligation_scope": dict(scope),
    }


def _execute_l3_production_validation_inner(args: argparse.Namespace, *, state_dir: Path, event_dir: Path, snapshot_root: Path, audit_dir: Path, lease_file: Path) -> dict[str, Any]:
    transaction_started_ns = time.monotonic_ns()
    if args.confirm_l3_production_validation != "EXECUTE_L3_PRODUCTION_VALIDATION_APPROVED":
        return transaction_stop("l3_production_validation_confirmation_required")
    requested_tier = resolved_l3_requested_max_users(args)
    requested_max_users = int(requested_tier["max_users"])
    availability_mode = bool(
        getattr(args, "execute_availability_first_standing_stage", False)
        or getattr(args, "_availability_first_stage_request", None)
    )
    availability_request = (
        getattr(args, "_availability_first_stage_request", None)
        if isinstance(
            getattr(args, "_availability_first_stage_request", None),
            dict,
        )
        else {}
    )

    control_file = Path(getattr(args, "execution_control_file", operator_execution.DEFAULT_AUTONOMOUS_EXECUTION_CONTROL_FILE))
    initial_control = operator_execution.autonomous_execution_control_state(control_file)
    if not initial_control.get("valid") or initial_control.get("state") not in {"OPEN", "CLOSED"}:
        return transaction_stop("autonomous_execution_control_invalid_pre_lease", execution_control=initial_control)

    existing_lease = operator_execution.load_execution_lease(lease_file)
    existing_state = operator_execution.execution_lease_state(existing_lease)
    if existing_state.get("active"):
        return transaction_stop("active_execution_lease_exists", execution_lease_state=existing_state)

    restore_barrier_file = Path(args.restore_barrier_file) if args.restore_barrier_file else state_dir / "autoswitch-restore-barrier.json"
    restore_barrier_preflight_reset = reset_completed_restore_barrier_for_fresh_l3_validation(
        restore_barrier_file,
        existing_state if isinstance(existing_state, dict) else {},
    )
    if restore_barrier_preflight_reset.get("reason") == "restore_barrier_preflight_reset_failed":
        return transaction_stop(
            "l3_restore_barrier_preflight_reset_failed",
            restore_barrier_preflight_reset=restore_barrier_preflight_reset,
        )
    l3_plan_run = run_l3_production_validation_plan(
        state_dir=state_dir,
        event_dir=event_dir,
        snapshot_root=snapshot_root,
        restore_barrier_file=restore_barrier_file,
        max_users=requested_max_users,
        source=str(args.approved_source or ""),
        target=str(
            (
                getattr(args, "_standing_delegated_policy_authority", {})
                or {}
            ).get("controlled_certification_target_id") or ""
        ),
        # Availability-first is independently admitted by its current standing
        # Action Class contract.  The older controlled-campaign identity is
        # lineage only and may bind a different source/execution-only target;
        # passing it here would incorrectly re-activate that stale admission
        # contract.  The legacy controlled-campaign path remains strict.
        campaign_request_id=(
            ""
            if availability_mode
            else str(
                getattr(
                    args,
                    "controlled_certification_campaign_request_id",
                    "",
                )
                or ""
            )
        ),
        campaign_request_hash=(
            ""
            if availability_mode
            else str(
                getattr(
                    args,
                    "controlled_certification_campaign_request_hash",
                    "",
                )
                or ""
            )
        ),
        pre_planner_refresh_command=str(args.pre_planner_refresh_command or "v7-intelligence-snapshot-refresh"),
    )
    plan = l3_plan_run.get("payload") if isinstance(l3_plan_run.get("payload"), dict) else {}
    if not plan:
        return transaction_stop("l3_production_validation_plan_unavailable", l3_plan_run=l3_plan_run)
    availability_selection_binding: dict[str, Any] = {}
    if availability_mode:
        availability_selection_binding = (
            bind_availability_first_controlled_selection(
                plan,
                expected_users=[
                    str(value)
                    for value in (
                        availability_request.get("expected_users") or []
                    )
                    if str(value)
                ],
                source=str(args.approved_source or ""),
                target=str(
                    availability_request.get("target_id")
                    or (
                        getattr(
                            args,
                            "_standing_delegated_policy_authority",
                            {},
                        )
                        or {}
                    ).get("controlled_certification_target_id")
                    or ""
                ),
                allocation_fingerprint=str(
                    availability_request.get("allocation_fingerprint") or ""
                ),
            )
        )
        if availability_selection_binding.get("ok") is not True:
            return transaction_stop(
                "availability_first_planner_selection_binding_blocked",
                availability_selection_binding=(
                    availability_selection_binding
                ),
                l3_plan_run=l3_plan_run,
            )
        plan = (
            availability_selection_binding.get("plan")
            if isinstance(
                availability_selection_binding.get("plan"),
                dict,
            )
            else {}
        )
        l3_plan_run["payload"] = plan
    planner_completed_ns = time.monotonic_ns()
    authorized_budget = authorized_l3_budget_from_plan(plan)
    authorized_l3_budget = int(authorized_budget.get("authorized_l3_budget") or 1)
    if requested_max_users > authorized_l3_budget:
        return transaction_stop(
            "l3_production_validation_requested_users_above_authorized_budget",
            l3_plan_run=l3_plan_run,
            requested_max_users=requested_max_users,
            authorized_l3_budget=authorized_budget,
        )

    transition = operator_execution_pipeline.l3_production_validation_runtime_action_transition(plan, max_users=requested_max_users)
    if not transition.get("ok"):
        return transaction_stop(
            "l3_production_validation_transition_blocked",
            l3_plan_run=l3_plan_run,
            transition=transition,
            authorized_l3_budget=authorized_budget,
            availability_selection_binding=(
                availability_selection_binding
            ),
        )

    if initial_control.get("state") == "OPEN":
        operation_binding = attach_l3_operation_scoped_binding(
            plan,
            state_dir=state_dir,
            snapshot_root=snapshot_root,
        )
        if operation_binding.get("status") != "BOUND":
            return transaction_stop(
                "l3_operation_scoped_binding_incomplete",
                operation_scoped_binding=operation_binding,
            )
        selected = operator_execution.selected_moves_from_plan(plan)
        auto_window_blockers = []
        selected_count = int(selected.get("selected_move_count") or 0)
        tier_allowed = (
            0 < requested_max_users
            <= int(availability_request.get("stage") or 0)
            <= operator_execution.AVAILABILITY_FIRST_LADDER[-1]
            if availability_mode
            else requested_max_users
            in operator_execution.SERVICE_FAILURE_DELEGATED_ACTION_CLASSES
        )
        if (
            not tier_allowed
            or selected_count < 1
            or selected_count > requested_max_users
        ):
            auto_window_blockers.append("l3_auto_window_outside_authorized_tier")
        if availability_mode:
            selected_moves = operator_execution.selected_moves_from_plan(plan)
            selected_scope = availability_first_selected_scope(
                selected_moves
            )
            expected_users = sorted(
                str(value)
                for value in (
                    availability_request.get("expected_users") or []
                )
                if str(value)
            )
            actual_users = selected_scope["users"]
            actual_targets = selected_scope["targets"]
            expected_target = str(
                availability_request.get("target_id") or ""
            )
            if actual_users != expected_users:
                auto_window_blockers.append(
                    "availability_first_selected_cohort_changed"
                )
            if actual_targets != [expected_target]:
                auto_window_blockers.append(
                    "availability_first_selected_target_changed"
                )
            subset_fingerprint = operator_execution.sha256_json({
                "stage": int(availability_request.get("stage") or 0),
                "target_id": expected_target,
                "users": expected_users,
            })
            if subset_fingerprint != str(
                availability_request.get("subset_fingerprint") or ""
            ):
                auto_window_blockers.append(
                    "availability_first_subset_fingerprint_changed"
                )
        for field in ("selected_move_hash", "source_bundle_hash", "snapshot_bundle_hash"):
            if not str(selected.get(field) or ""):
                auto_window_blockers.append(f"l3_auto_window_{field}_missing")
        if auto_window_blockers:
            return transaction_stop(
                "l3_operation_scoped_control_binding_incomplete",
                blockers=auto_window_blockers,
                selected_move_count=int(selected.get("selected_move_count") or 0),
            )
        controlled_window = operator_execution.build_autonomous_execution_control_state(
            False,
            actor=str(args.approval_author or "operator"),
            reason="l3_production_validation_one_operation_window",
            operation_id="l3-production-validation-pending",
            selected_move_hash=str(selected.get("selected_move_hash") or ""),
            action_class="EMERGENCY_FAILOVER",
            source_bundle_hash=str(selected.get("source_bundle_hash") or ""),
            snapshot_bundle_hash=str(selected.get("snapshot_bundle_hash") or ""),
            max_users=requested_max_users,
        )
        try:
            packet = operator_execution.packet_from_plan(
                plan,
                approval_author=args.approval_author,
                approval_reviewer=args.approval_reviewer,
                ttl_seconds=args.ttl_seconds,
                breaker_generation=str(controlled_window.get("generation") or ""),
                delegated_policy_authority=copy.deepcopy(
                    getattr(args, "_standing_delegated_policy_authority", {}) or {},
                ),
                service_failure_causal_binding=copy.deepcopy(
                    getattr(args, "_service_failure_causal_binding", {}) or {},
                ),
            )
        except Exception as exc:
            return transaction_stop("l3_packet_materialization_failed", l3_plan_run=l3_plan_run, transition=transition, error=str(exc))
        controlled_window["operation_id"] = str(packet.get("operation_id") or "")
        operator_execution.write_json_atomic(control_file, controlled_window)
        args._l3_controlled_window_generation = str(controlled_window.get("generation") or "")
        args._l3_controlled_window_operation_id = str(controlled_window.get("operation_id") or "")
        preflight_control = operator_execution.autonomous_execution_control_decision(
            control_file,
            mutation_kind="forward",
            action_class="EMERGENCY_FAILOVER",
            expected_generation=str(controlled_window.get("generation") or ""),
            operation_id=str(packet.get("operation_id") or ""),
            selected_move_hash=str((packet.get("expected") or {}).get("selected_move_hash") or ""),
            source_bundle_hash=str((packet.get("expected") or {}).get("source_bundle_hash") or ""),
            snapshot_bundle_hash=str((packet.get("expected") or {}).get("snapshot_bundle_hash") or ""),
            max_users=requested_max_users,
        )
        if not preflight_control.get("allowed_forward_mutation"):
            return transaction_stop("autonomous_execution_control_denied_pre_lease", execution_control=preflight_control)
    else:
        preflight_control = operator_execution.autonomous_execution_control_decision(
            control_file,
            mutation_kind="forward",
            action_class="EMERGENCY_FAILOVER",
            operation_id="l3-production-validation",
        )
        if not preflight_control.get("allowed_forward_mutation"):
            return transaction_stop("autonomous_execution_control_denied_pre_lease", execution_control=preflight_control)
        try:
            packet = operator_execution.packet_from_plan(
                plan,
                approval_author=args.approval_author,
                approval_reviewer=args.approval_reviewer,
                ttl_seconds=args.ttl_seconds,
                breaker_generation=str(preflight_control.get("generation") or ""),
                delegated_policy_authority=copy.deepcopy(
                    getattr(args, "_standing_delegated_policy_authority", {}) or {},
                ),
                service_failure_causal_binding=copy.deepcopy(
                    getattr(args, "_service_failure_causal_binding", {}) or {},
                ),
            )
        except Exception as exc:
            return transaction_stop("l3_packet_materialization_failed", l3_plan_run=l3_plan_run, transition=transition, error=str(exc))

    try:
        packet_identity = operator_execution.packet_identity(packet)
    except Exception as exc:
        return transaction_stop("l3_packet_identity_invalid", l3_plan_run=l3_plan_run, transition=transition, error=str(exc))

    constraints = l3_packet_constraints_ok(
        packet,
        transition,
        requested_max_users,
        authorized_l3_budget=authorized_l3_budget,
    )
    if not constraints.get("ok"):
        return transaction_stop(
            "l3_transaction_scope_invalid",
            l3_plan_run=l3_plan_run,
            transition=transition,
            packet=operator_execution.redact(packet),
            constraints=constraints,
            authorized_l3_budget=authorized_budget,
        )

    users = constraints["users"]
    targets = constraints["targets"]
    rollback_items = (packet.get("rollback_manifest") or {}).get("items") or []
    sources = [str(item.get("rollback_target") or "") for item in rollback_items if isinstance(item, dict) and str(item.get("rollback_target") or "")]
    user = users[0] if users else ""
    target = targets[0] if targets else ""
    source = sources[0] if sources else ""
    lease = operator_execution.create_execution_lease_from_packet(packet, source_preview=plan)
    lease_create_result = operator_execution.write_execution_lease(lease_file, lease)
    if not lease_create_result.get("ok"):
        return transaction_stop(
            "l3_execution_lease_not_created",
            l3_plan_run=l3_plan_run,
            transition=transition,
            execution_lease_create_result=lease_create_result,
        )
    packet_completed_ns = time.monotonic_ns()

    audit_store = audit_dir / "operator-execution-audit.jsonl"
    lifecycle_store = audit_dir / "governance-lifecycle.jsonl"
    clearance_result = operator_execution.execute_packet(
        packet,
        audit_store,
        state_dir,
        mode="runtime_action",
        planner_snapshot=plan,
        restore_barrier_file=restore_barrier_file,
        lifecycle_store=lifecycle_store,
    )
    if not clearance_result.get("execution_allowed_now"):
        terminal = operator_execution.finish_execution_lease(
            lease_file,
            status="OPERATOR_CANCELLED",
            reason="l3_transaction_stop_safe_before_apply",
            operation={"terminal_state": "STOP_SAFE", "terminal_reason": "restore_barrier_clearance_denied", "apply_result": {"applied": False, "results": []}},
        )
        return transaction_stop(
            "l3_restore_barrier_clearance_denied",
            l3_plan_run=l3_plan_run,
            transition=transition,
            packet=operator_execution.redact(packet),
            execution_lease_create_result=lease_create_result,
            clearance_result=clearance_result,
            lease_terminalization=terminal,
        )
    clearance_completed_ns = time.monotonic_ns()

    pre_apply_control = operator_execution.autonomous_execution_control_decision(
        control_file,
        mutation_kind="forward",
        action_class="EMERGENCY_FAILOVER",
        expected_generation=str(packet_identity.get("breaker_generation") or ""),
        operation_id=str(packet_identity.get("operation_id") or ""),
        selected_move_hash=str(packet_identity.get("selected_move_hash") or ""),
        source_bundle_hash=str(packet_identity.get("source_bundle_hash") or ""),
        snapshot_bundle_hash=str(packet_identity.get("snapshot_bundle_hash") or ""),
        max_users=requested_max_users,
    )
    if not pre_apply_control.get("allowed_forward_mutation"):
        terminal = operator_execution.finish_execution_lease(
            lease_file,
            status="OPERATOR_CANCELLED",
            reason="autonomous_execution_control_denied_pre_apply",
            operation={"terminal_state": "STOP_SAFE", "terminal_reason": "execution_control_changed", "apply_result": {"applied": False, "results": []}},
        )
        return transaction_stop(
            "autonomous_execution_control_denied_pre_apply",
            execution_control=pre_apply_control,
            lease_terminalization=terminal,
        )

    campaign_target = str(
        (
            getattr(args, "_standing_delegated_policy_authority", {})
            or {}
        ).get("controlled_certification_target_id") or ""
    )
    apply_run = run_autoswitch_apply(
        state_dir=state_dir,
        event_dir=event_dir,
        snapshot_root=snapshot_root,
        restore_barrier_file=restore_barrier_file,
        user=user if constraints["selected_move_count"] == 1 else "",
        source=source if (
            constraints["selected_move_count"] == 1 or campaign_target
        ) else "",
        target=campaign_target or (
            target if constraints["selected_move_count"] == 1 else ""
        ),
        max_users=requested_max_users,
        packet_id=str(packet_identity.get("packet_id") or ""),
        operation_id=str(packet_identity.get("operation_id") or ""),
        selected_move_hash=str(packet_identity.get("selected_move_hash") or ""),
        authority_generation=str(packet_identity.get("authority_generation") or ""),
        breaker_generation=str(packet_identity.get("breaker_generation") or ""),
        source_bundle_hash=str(packet_identity.get("source_bundle_hash") or ""),
        snapshot_bundle_hash=str(packet_identity.get("snapshot_bundle_hash") or ""),
        execution_control_file=str(control_file),
        emergency_failover_autonomy=True,
        campaign_request_id=str(
            ""
            if availability_mode
            else (
                getattr(
                    args,
                    "controlled_certification_campaign_request_id",
                    "",
                )
                or ""
            )
        ),
        campaign_request_hash=str(
            ""
            if availability_mode
            else (
                getattr(
                    args,
                    "controlled_certification_campaign_request_hash",
                    "",
                )
                or ""
            )
        ),
        campaign_target=(
            "" if availability_mode else campaign_target
        ),
    )
    apply_completed_ns = time.monotonic_ns()
    apply_payload = apply_run.get("payload") if isinstance(apply_run.get("payload"), dict) else {}
    reported_apply = (
        apply_payload.get("apply_result")
        if isinstance(apply_payload.get("apply_result"), dict)
        else {}
    )
    reported_results = (
        reported_apply.get("results")
        if isinstance(reported_apply.get("results"), list)
        else []
    )
    # The child can exit without its terminal JSON after the existing route
    # owner has already committed the write (timeout, signal, truncated output
    # or another post-write consumer failure).  Bind that state to the same
    # partial-apply reconciliation used for timeouts.  Current route truth is
    # only enough to prove that mutation needs reconciliation; it is never
    # promoted to verified Outcome/Learning evidence here.
    terminal_proof_missing = bool(
        not reported_apply.get("applied")
        and not reported_results
    )
    if apply_run.get("timed_out") or terminal_proof_missing:
        current_user = next(
            (
                row
                for row in read_registry(state_dir / "users.registry")
                if str(row.get("ip") or "") == user
            ),
            {},
        )
        current_egress = str(current_user.get("current") or "")
        mutation_observed = bool(
            user
            and target
            and source
            and current_egress == target
            and current_egress != source
        )
        if mutation_observed:
            partial_reason = (
                "autoswitch_apply_timeout_after_route_mutation"
                if apply_run.get("timed_out")
                else "autoswitch_apply_terminal_missing_after_route_mutation"
            )
            apply_payload = {
                "operation": {
                    "operation_id": str(
                        packet_identity.get("operation_id") or ""
                    ),
                    "terminal_state": "PARTIAL_APPLY_UNVERIFIED",
                    "terminal_reason": partial_reason,
                    "rollback_verdict": "REQUIRED_BY_FRESH_RECONCILIATION",
                },
                "apply_result": {
                    "applied": True,
                    "results": [
                        {
                            "user_ip": user,
                            "from": source,
                            "to": target,
                            "rc": 0,
                            "verify_rc": 1,
                            "verification_reason": (
                                "consumer_timed_out_before_terminal_proof"
                            ),
                            "rollback_attempted": False,
                        }
                    ],
                },
                "l3_learning_closure": {},
            }
            apply_run["partial_apply_reconciliation"] = {
                "schema_version": (
                    "v7.autoswitch-timeout-route-reconciliation.v1"
                ),
                "status": "PARTIAL_APPLY_OBSERVED",
                "operation_id": str(
                    packet_identity.get("operation_id") or ""
                ),
                "packet_id": str(packet_identity.get("packet_id") or ""),
                "user": user,
                "source": source,
                "target": target,
                "current_egress": current_egress,
                "verification_complete": False,
                "rollback_required": True,
                "child_timed_out": bool(apply_run.get("timed_out")),
                "child_returncode": apply_run.get("returncode"),
                "terminal_reason": partial_reason,
            }
    operation = dict(apply_payload.get("operation") or {})
    operation["apply_result"] = apply_payload.get("apply_result") if isinstance(apply_payload.get("apply_result"), dict) else {}
    terminal_status = lease_terminal_status_from_apply(apply_payload)
    lease_terminalization = operator_execution.finish_execution_lease(
        lease_file,
        status=terminal_status,
        reason=str(operation.get("terminal_reason") or "l3_production_validation_complete"),
        operation=operation,
    )
    apply_result = apply_payload.get("apply_result") if isinstance(apply_payload.get("apply_result"), dict) else {}
    results = apply_result.get("results") if isinstance(apply_result.get("results"), list) else []
    l3_learning = apply_payload.get("l3_learning_closure") if isinstance(apply_payload.get("l3_learning_closure"), dict) else {}
    capability_state = l3_learning.get("capability_state") if isinstance(l3_learning.get("capability_state"), dict) else {}
    production_proof_quality = l3_production_validation_proof_quality(apply_run, apply_payload)
    production_proven = bool(capability_state.get("production_proven")) and bool(production_proof_quality.get("ok"))
    downstream_proof_diagnostic = {
        "apply_command_ok": bool(apply_run.get("ok")),
        "apply_returncode": apply_run.get("returncode"),
        "apply_timed_out": bool(apply_run.get("timed_out")),
        "child_final_verdict": str(
            apply_payload.get("final_verdict") or ""
        ),
        "child_transaction_status": str(
            apply_payload.get("transaction_status")
            or apply_payload.get("status")
            or ""
        ),
        "child_stop_reason": str(
            apply_payload.get("stop_reason")
            or apply_payload.get("reason")
            or ""
        ),
        "child_stop_detail": str(
            apply_payload.get("stop_detail") or ""
        ),
        "proof_blockers": list(
            production_proof_quality.get("blockers") or []
        )[:12],
        "capability_production_proven": bool(
            capability_state.get("production_proven")
        ),
    }
    verification_passed = bool(results) and all(
        int(row.get("verify_rc", 1)) == 0
        and (row.get("service_verify_rc") is None or int(row.get("service_verify_rc", 1)) == 0)
        for row in results
        if isinstance(row, dict)
    )
    rollback_attempted = any(bool(row.get("rollback_attempted")) for row in results if isinstance(row, dict))
    controlled_evidence = controlled_certification_evidence_scope(state_dir, user=user, source=source)
    feedback_materialization = (
        materialize_governed_transaction_feedback(
            state_dir=state_dir,
            packet=packet,
            operation=operation,
            apply_result=apply_result,
            user=user,
            source=source,
            target=target,
            rollback_attempted=rollback_attempted,
            verification_passed=verification_passed,
            evidence_class="CONTROLLED_PRODUCTION",
        )
        if controlled_evidence
        else {"materialized": False, "reason": "not_controlled_certification_scope"}
    )
    feedback_completed_ns = time.monotonic_ns()
    execution_timing = governed_execution_timing_projection(
        transaction_started_ns=transaction_started_ns,
        planner_completed_ns=planner_completed_ns,
        packet_completed_ns=packet_completed_ns,
        clearance_completed_ns=clearance_completed_ns,
        apply_completed_ns=apply_completed_ns,
        feedback_completed_ns=feedback_completed_ns,
        affected_users=max(1, len(users)),
    )
    return {
        "schema_version": "v7.l3-production-validation-execution.v1",
        "transaction_status": "COMPLETED" if production_proven else "STOP_SAFE",
        "final_verdict": "L3_PRODUCTION_PROVEN" if production_proven else "STOP_SAFE",
        "stop_reason": "" if production_proven else "l3_production_validation_downstream_proof_failed",
        "fresh_packet_id": packet.get("packet_id", ""),
        "decision_id": packet.get("decision_id", ""),
        "operation_id": packet.get("operation_id", ""),
        "selected_move_hash": (packet.get("expected") or {}).get("selected_move_hash", ""),
        "user": user,
        "users": users,
        "source": source,
        "sources": sorted(set(sources)),
        "target": target,
        "targets": targets,
        "requested_max_users": requested_max_users,
        "requested_tier_resolution": requested_tier,
        "authorized_l3_budget": authorized_budget,
        "one_execution_attempt": constraints["selected_move_count"] == 1,
        "runtime_mutation_performed": bool(apply_result.get("applied")),
        "restore_barrier_written_now": bool((clearance_result.get("clearance_result") or {}).get("ok")),
        "apply_executed": bool(apply_result.get("applied")),
        "verification_result": "PASS" if verification_passed else ("NOT_RUN" if not results else "FAIL"),
        "rollback_attempted": rollback_attempted,
        "rollback_result": operation.get("rollback_verdict", "NOT_REQUIRED"),
        "controlled_certification_evidence": controlled_evidence,
        "feedback_materialization": feedback_materialization,
        "production_proof_quality": production_proof_quality,
        "downstream_proof_diagnostic": downstream_proof_diagnostic,
        "partial_apply_reconciliation": (
            apply_run.get("partial_apply_reconciliation") or {}
        ),
        "l3_learning_closure": l3_learning,
        "capability_state": capability_state,
        "production_proven": production_proven,
        "certified": bool(capability_state.get("certified")),
        "active_capability": bool(capability_state.get("active_capability")),
        "users_moved": int(production_proof_quality.get("verified_success_count") or 0) if apply_result.get("applied") else 0,
        "runtime_automation_enabled": False,
        "authority_expanded": False,
        "new_architecture_created": False,
        "new_authority_created": False,
        "new_runtime_path_created": False,
        "new_governance_created": False,
        "new_owner_created": False,
        "new_backlog_item_created": False,
        "transition": transition,
        "l3_plan_run": l3_plan_run,
        "operation_scoped_binding": (
            ((plan.get("safety") or {}).get("atomic_execution_envelope") or {}).get("operation_scoped_binding") or {}
        ),
        "restore_barrier_preflight_reset": restore_barrier_preflight_reset,
        "execution_lease_create_result": lease_create_result,
        "clearance_result": clearance_result,
        "autoswitch_apply": apply_run,
        "lease_terminalization": lease_terminalization,
        "execution_timing": execution_timing,
    }


def execute_l3_production_validation(args: argparse.Namespace, *, state_dir: Path, event_dir: Path, snapshot_root: Path, audit_dir: Path, lease_file: Path) -> dict[str, Any]:
    args._l3_controlled_window_generation = ""
    args._l3_controlled_window_operation_id = ""
    result: dict[str, Any] = {}
    try:
        result = _execute_l3_production_validation_inner(
            args,
            state_dir=state_dir,
            event_dir=event_dir,
            snapshot_root=snapshot_root,
            audit_dir=audit_dir,
            lease_file=lease_file,
        )
        return result
    finally:
        generation = str(getattr(args, "_l3_controlled_window_generation", "") or "")
        operation_id = str(getattr(args, "_l3_controlled_window_operation_id", "") or "")
        if generation and operation_id:
            finalization = operator_execution.finalize_autonomous_execution_control_window(
                Path(getattr(args, "execution_control_file", operator_execution.DEFAULT_AUTONOMOUS_EXECUTION_CONTROL_FILE)),
                actor="l3-production-validation-finalizer",
                reason=str(result.get("final_verdict") or result.get("stop_reason") or "l3_production_validation_complete"),
                expected_generation=generation,
                operation_id=operation_id,
            )
            result["controlled_window_finalization"] = finalization
            result["safe_mode_final_state"] = str((finalization.get("after") or {}).get("state") or "")


def _execute_governed_transaction_with_guards_inner(
    args: argparse.Namespace,
    *,
    state_dir: Path,
    event_dir: Path,
    snapshot_root: Path,
    audit_dir: Path,
    lease_file: Path,
    required_a4_candidate_keys: set[tuple[str, str]] | None = None,
    blocked_transaction_identities: set[tuple[str, str, str, str]] | None = None,
) -> dict[str, Any]:
    topology_mode = bool(
        getattr(args, "execute_controlled_topology_standing_transaction", False)
    )
    availability_mode = bool(
        getattr(args, "execute_availability_first_standing_stage", False)
        or getattr(args, "_availability_first_stage_request", None)
    )
    delegated_mode = bool(
        getattr(args, "execute_bounded_delegated_transaction", False)
        or topology_mode
        or availability_mode
    )
    engineering_authority_request_file = str(getattr(args, "engineering_authority_request_file", "") or "")
    engineering_authority_request: dict[str, Any] = {}
    engineering_authority_decision = str(getattr(args, "engineering_authority_decision", "") or "")
    engineering_authority_decision_provenance: dict[str, Any] = {}
    if engineering_authority_request_file:
        engineering_authority_request = read_json(Path(engineering_authority_request_file), {})
        repair_policy_file = str(getattr(args, "engineering_authority_repair_continuation_policy_file", "") or "")
        if not engineering_authority_decision and repair_policy_file:
            repair_policy = read_json(Path(repair_policy_file), {})
            engineering_authority_decision_provenance = operator_execution.validate_engineering_authority_repair_continuation(
                repair_policy,
                engineering_authority_request,
            )
            if not engineering_authority_decision_provenance.get("ok"):
                return transaction_stop(
                    "engineering_authority_repair_continuation_denied",
                    validation=engineering_authority_decision_provenance,
                )
            engineering_authority_decision = str(engineering_authority_decision_provenance.get("decision") or "")
        request_validation = operator_execution.validate_engineering_authority_request(
            engineering_authority_request,
            decision=engineering_authority_decision,
            expected_request_id=str(getattr(args, "engineering_authority_request_id", "") or ""),
            expected_contract_hash=str(getattr(args, "engineering_authority_contract_hash", "") or ""),
        )
        if not request_validation.get("ok"):
            return transaction_stop("engineering_authority_request_invalid", validation=request_validation)
    setup_request = getattr(args, "_certification_setup_request", None)
    setup_mode = isinstance(setup_request, dict) and bool(setup_request)
    cleanup_request = getattr(args, "_certification_cleanup_request", None)
    cleanup_mode = isinstance(cleanup_request, dict) and bool(cleanup_request)
    availability_first_reset = bool(
        cleanup_mode
        and bool_value(
            cleanup_request.get("availability_first_reset")
        )
    )
    topology_request = getattr(args, "_controlled_topology_standing_request", None)
    topology_mode = (
        topology_mode
        and isinstance(topology_request, dict)
        and bool(topology_request)
    )
    support_mode = setup_mode or cleanup_mode or topology_mode
    if not delegated_mode and not support_mode and args.confirm_governed_transaction != "EXECUTE_GOVERNED_TRANSACTION_APPROVED":
        return transaction_stop("transaction_confirmation_required")
    policy_binding: dict[str, Any] = {}
    if (delegated_mode or availability_first_reset) and (
        int(args.max_users) > 1 or availability_mode
    ):
        policy_binding = standing_delegated_cohort_execution_binding(args)
        if not policy_binding.get("ok"):
            return transaction_stop(
                "standing_delegated_cohort_policy_binding_invalid",
                standing_delegated_policy_binding=policy_binding,
            )
        causal_binding = (
            {
                "schema_version": (
                    "v7.availability-first-controlled-causal-binding.v1"
                ),
                "status": "BOUND",
                "ok": True,
                "source_channel": str(args.approved_source or ""),
                "allocation_fingerprint": str(
                    (
                        getattr(
                            args,
                            "_availability_first_stage_request",
                            {},
                        )
                        or {}
                    ).get("allocation_fingerprint")
                    or ""
                ),
                "evidence_class": "CONTROLLED_PRODUCTION",
                "natural_l8_credit": False,
            }
            if availability_mode
            else service_failure_obligation_execution_binding(
                args,
                state_dir=state_dir,
                event_dir=event_dir,
            )
        )
        if not causal_binding.get("ok"):
            return transaction_stop(
                "standing_delegated_cohort_service_failure_binding_invalid",
                standing_delegated_policy_binding=policy_binding,
                service_failure_causal_binding=causal_binding,
            )
        if availability_first_reset:
            # The standing policy admits the exact baseline restoration, but
            # the existing single-user cleanup owner must materialize it.
            # Sending this support request through the ordinary cohort path
            # bypasses cleanup selection and creates a circular failed retry.
            # Normalize the cohort binding into the authority shape consumed
            # by the canonical Packet owner. The binding owner deliberately
            # names this field ``delegated_policy_authority``; leaving it only
            # under that name makes packet materialization fail after preview.
            delegated_admission = {
                **policy_binding,
                "allowed": True,
                "authority": copy.deepcopy(
                    policy_binding.get("delegated_policy_authority") or {}
                ),
            }
        else:
            cohort_args = argparse.Namespace(**vars(args))
            # This is an internal compatibility gate on the existing L3
            # cohort executor. Authority comes only from the audited standing
            # contract above; this value neither grants nor expands Authority.
            cohort_args.confirm_l3_production_validation = "EXECUTE_L3_PRODUCTION_VALIDATION_APPROVED"
            cohort_args._standing_delegated_policy_authority = copy.deepcopy(
                policy_binding.get("delegated_policy_authority") or {},
            )
            cohort_args._service_failure_causal_binding = (
                {}
                if availability_mode
                else copy.deepcopy(causal_binding)
            )
            cohort_args._availability_first_causal_binding = (
                copy.deepcopy(causal_binding)
                if availability_mode
                else {}
            )
            result = execute_l3_production_validation(
                cohort_args,
                state_dir=state_dir,
                event_dir=event_dir,
                snapshot_root=snapshot_root,
                audit_dir=audit_dir,
                lease_file=lease_file,
            )
            result["standing_delegated_policy_binding"] = policy_binding
            result["runtime_automation_enabled"] = True
            return result
    if int(args.max_users) != 1:
        return transaction_stop("transaction_max_users_must_be_one")

    control_file = Path(getattr(args, "execution_control_file", operator_execution.DEFAULT_AUTONOMOUS_EXECUTION_CONTROL_FILE))
    preflight_state = operator_execution.autonomous_execution_control_state(control_file)
    if not preflight_state.get("valid") or preflight_state.get("state") != "OPEN":
        return transaction_stop("autonomous_execution_control_not_open_at_start", execution_control=preflight_state)

    existing_lease = operator_execution.load_execution_lease(lease_file)
    existing_state = operator_execution.execution_lease_state(existing_lease)
    if existing_state.get("active"):
        return transaction_stop("active_execution_lease_exists", execution_lease_state=existing_state)

    users = read_registry(state_dir / "users.registry")
    egress = read_registry(state_dir / "egress.registry")
    runtime_state = read_json(state_dir / "v7-state.json", {})
    records = decision_records(state_dir, event_dir, audit_dir)
    events = event_rows(event_dir, args.max_events)
    surface = operator_decision_surface.build_operator_decision_surface(
        snapshot_root=snapshot_root,
        users=users,
        egress=egress,
        runtime_state=runtime_state,
        decision_records=records,
    )
    shadow_history = read_jsonl_family(state_dir / "shadow-autonomy-decisions.jsonl")
    inventory = autonomy_trust_acceleration.build_acceleration_inventory(
        snapshot_root=snapshot_root,
        decision_surface=surface,
        shadow_history=shadow_history,
        decision_records=records,
        event_rows=events,
    )
    surface["knowledge_quality_read_model"] = inventory.get("knowledge_quality_read_model", {})
    surface["decision_outcome_learning"] = inventory.get("decision_outcome_learning", {})
    availability_reset_snapshot_refresh: dict[str, Any] = {}
    if availability_first_reset:
        # A serialized cohort reset changes route-backed risk/blast/overview
        # inputs after every member.  Reusing the preceding member's
        # snapshots makes the next exact cleanup Packet fail permanently with
        # snapshot_mismatch.  Consume the existing snapshot writer before
        # every reset child, then rebuild the same decision surface from that
        # fresh generation.  This is observation-state maintenance only; it
        # grants no Authority and performs no routing mutation.
        availability_reset_snapshot_refresh = (
            refresh_controlled_topology_execution_snapshots(
                args,
                state_dir=state_dir,
                event_dir=event_dir,
                snapshot_root=snapshot_root,
            )
        )
        if not availability_reset_snapshot_refresh.get("ok"):
            return transaction_stop(
                "availability_first_baseline_snapshot_refresh_failed",
                snapshot_refresh=availability_reset_snapshot_refresh,
            )
        surface = operator_decision_surface.build_operator_decision_surface(
            snapshot_root=snapshot_root,
            users=users,
            egress=egress,
            runtime_state=runtime_state,
            decision_records=records,
        )
        inventory = autonomy_trust_acceleration.build_acceleration_inventory(
            snapshot_root=snapshot_root,
            decision_surface=surface,
            shadow_history=shadow_history,
            decision_records=records,
            event_rows=events,
        )
        surface["knowledge_quality_read_model"] = inventory.get(
            "knowledge_quality_read_model",
            {},
        )
        surface["decision_outcome_learning"] = inventory.get(
            "decision_outcome_learning",
            {},
        )
    topology_policy_binding: dict[str, Any] = {}
    if topology_mode:
        topology_policy_binding = copy.deepcopy(
            getattr(args, "_controlled_topology_policy_binding", {}) or {}
        )
        if not topology_policy_binding.get("allowed"):
            return transaction_stop(
                "controlled_topology_standing_policy_binding_invalid",
                controlled_topology_binding=topology_policy_binding,
            )
        surface["controlled_execution_gate_profile"] = (
            "CONTROLLED_CERTIFICATION_TOPOLOGY"
        )
    elif availability_first_reset:
        # This is the exact standing-policy-bound restoration of an already
        # moved certification identity, not a new risk-taking recommendation.
        # Keep snapshot, identity, route, target, rollback and execution gates,
        # while reusing the existing controlled-certification profile so
        # per-user Learning/trust floors cannot strand a verified cohort away
        # from its baseline.
        surface["controlled_execution_gate_profile"] = (
            "CONTROLLED_CERTIFICATION_TOPOLOGY"
        )
    planner_observe = {"skipped": True}
    if not args.skip_planner_observe and not support_mode:
        planner_observe = run_planner_observe(
            state_dir,
            event_dir,
            snapshot_root,
            1,
            refresh_snapshots=delegated_mode,
        )
        if delegated_mode and planner_observe.get("ok"):
            # The existing autoswitch owner refreshes intelligence snapshots
            # before planner load.  Re-read the decision surface afterwards;
            # reusing the pre-refresh surface would manufacture a permanent
            # snapshot_mismatch and make every standing-policy cycle STOP_SAFE.
            surface = operator_decision_surface.build_operator_decision_surface(
                snapshot_root=snapshot_root,
                users=users,
                egress=egress,
                runtime_state=runtime_state,
                decision_records=records,
            )
            inventory = autonomy_trust_acceleration.build_acceleration_inventory(
                snapshot_root=snapshot_root,
                decision_surface=surface,
                shadow_history=shadow_history,
                decision_records=records,
                event_rows=events,
            )
            surface["knowledge_quality_read_model"] = inventory.get("knowledge_quality_read_model", {})
            surface["decision_outcome_learning"] = inventory.get("decision_outcome_learning", {})
        moves = selected_moves_from_planner_payload(planner_observe.get("payload", {}))
        surface = merge_planner_moves_into_surface(surface, moves, replace_existing=True)
    a4_goal_directed_selection = {}
    certification_setup_selection = {}
    certification_cleanup_selection = {}
    engineering_authority_selection = {}
    if setup_mode or topology_mode:
        exact_request = setup_request if setup_mode else topology_request
        certification_setup_selection = controlled_certification_setup_selection(
            users=users,
            egress=egress,
            user=str(exact_request.get("user") or ""),
            source=str(exact_request.get("target") or exact_request.get("source") or ""),
            certification_identity_mode=(
                "REGISTRY_MARKED" if topology_mode else "HISTORICAL_POOL"
            ),
            allow_same_campaign_occupants=topology_mode,
        )
        if certification_setup_selection.get("selection_status") != "SELECTED":
            return transaction_stop(
                (
                    "CONTROLLED_TOPOLOGY_STANDING_SELECTION_NOT_ADMITTED"
                    if topology_mode
                    else "CONTROLLED_CERTIFICATION_SETUP_NOT_ADMITTED"
                ),
                certification_setup_selection=certification_setup_selection,
            )
        surface = merge_a4_gap_candidate_into_surface(surface, certification_setup_selection)
    elif cleanup_mode:
        certification_cleanup_selection = controlled_certification_cleanup_selection(
            users=users,
            egress=egress,
            user=str(cleanup_request.get("user") or ""),
            source=str(cleanup_request.get("source") or ""),
            target=str(cleanup_request.get("target") or ""),
            campaign_reset=bool_value(
                cleanup_request.get("campaign_reset")
            ),
            controlled_source=str(
                cleanup_request.get("controlled_source") or ""
            ),
            availability_first_reset=bool_value(
                cleanup_request.get("availability_first_reset")
            ),
            availability_first_target=str(
                cleanup_request.get("availability_first_target") or ""
            ),
            availability_first_allocation_fingerprint=str(
                cleanup_request.get("availability_first_allocation_fingerprint")
                or ""
            ),
        )
        if certification_cleanup_selection.get("selection_status") != "SELECTED":
            return transaction_stop(
                "CONTROLLED_CERTIFICATION_CLEANUP_NOT_ADMITTED",
                certification_cleanup_selection=certification_cleanup_selection,
            )
        surface = merge_a4_gap_candidate_into_surface(surface, certification_cleanup_selection)
    elif engineering_authority_request:
        engineering_authority_selection = controlled_engineering_authority_selection(
            request=engineering_authority_request,
            users=users,
            egress=egress,
        )
        if engineering_authority_selection.get("selection_status") != "SELECTED":
            return transaction_stop(
                "CONTROLLED_ENGINEERING_AUTHORITY_CANDIDATE_NOT_ADMITTED",
                engineering_authority_selection=engineering_authority_selection,
                planner_observe=planner_observe,
            )
        surface = merge_a4_gap_candidate_into_surface(surface, engineering_authority_selection)
    if required_a4_candidate_keys is not None:
        a4_goal_directed_selection = select_a4_gap_reducing_candidate(
            surface=surface,
            snapshot_root=snapshot_root,
            required_a4_candidate_keys=required_a4_candidate_keys,
            blocked_transaction_identities=blocked_transaction_identities,
        )
        if a4_goal_directed_selection.get("selection_status") != "SELECTED":
            return transaction_stop(
                "NO_SAFE_GAP_REDUCING_A4_CANDIDATE",
                a4_goal_directed_selection=a4_goal_directed_selection,
                planner_observe=planner_observe,
            )
        surface = merge_a4_gap_candidate_into_surface(surface, a4_goal_directed_selection)

    attach_controlled_execution_source_binding(surface, state_dir=state_dir, snapshot_root=snapshot_root)

    cycle = operator_execution_pipeline.governed_canary_knowledge_gated_dry_run_cycle(
        events=events,
        decision_surface=surface,
        execution_lease=None,
        max_users=1,
    )
    packet_preview = cycle.get("packet_preview") if isinstance(cycle.get("packet_preview"), dict) else {}
    if support_mode:
        packet_preview["_v7_evidence_class"] = (
            "CONTROLLED_PRODUCTION_TOPOLOGY"
            if topology_mode
            else ("ENGINEERING_SETUP" if setup_mode else "ENGINEERING_CLEANUP")
        )
        packet_preview["_v7_certification_setup"] = (
            certification_setup_selection
            if setup_mode or topology_mode
            else certification_cleanup_selection
        )
    if cycle.get("stop_reason") != "AUTHORITY_BOUNDARY" or packet_preview.get("status") != "PACKET_PREVIEW_READY":
        return transaction_stop("packet_not_ready", cycle=cycle, planner_observe=planner_observe)

    preview_identity = operator_execution.preview_packet_identity(packet_preview)
    delegated_admission = {}
    approved_identity = {}
    engineering_authority = {}
    if topology_mode:
        delegated_admission = topology_policy_binding
    elif support_mode:
        if availability_first_reset:
            delegated_admission = policy_binding
        else:
            delegated_admission = {
                "schema_version": "v7.controlled-certification-setup-authority.v1",
                "allowed": True,
                "blockers": [],
                "authority": {
                    "authority_basis": "OPERATOR_ENGINEERING_AUTHORITY",
                    "engineering_authority_source": "EXPLICIT_POLYGON_L7_MISSION_CONTINUATION" if setup_mode else "EXACT_CONTRACT_REQUIRED_CLEANUP",
                    "action_class": "single-user governed candidate failover",
                    "max_users_per_transaction": 1,
                    "max_concurrent_transactions": 1,
                    "candidate_identity": "FRESH_ONLY",
                    "packet_reuse": "FORBIDDEN",
                    "self_expansion_allowed": False,
                    "scope": (certification_setup_selection if setup_mode else certification_cleanup_selection).get("authority_scope"),
                },
            }
        if (
            not availability_first_reset
            and cleanup_mode
            and bool_value(cleanup_request.get("campaign_reset"))
        ):
            delegated_admission["authority"][
                "authority_basis"
            ] = "CONTROLLED_CERTIFICATION_CAMPAIGN_APPROVAL"
            delegated_admission["authority"][
                "engineering_authority_source"
            ] = "EXACT_APPROVED_CONTROLLED_CERTIFICATION_CAMPAIGN"
    elif delegated_mode:
        policy_root = read_json(Path(args.policy_file), {})
        delegated_admission = bounded_delegated_policy_admission(
            packet_preview,
            cycle,
            live_policy_contract=(
                policy_root.get("delegated_autonomy_policy")
                if isinstance(policy_root.get("delegated_autonomy_policy"), dict)
                else {}
            ),
            authority_audit_records=live_policy_lineage_records(args),
        )
        if not delegated_admission.get("allowed"):
            return transaction_stop("delegated_policy_admission_denied", cycle=cycle, delegated_policy_admission=delegated_admission)
        if engineering_authority_request_file:
            try:
                engineering_authority = operator_execution.engineering_authority_binding_from_preview(
                    engineering_authority_request,
                    packet_preview,
                    decision=engineering_authority_decision,
                    expected_request_id=str(getattr(args, "engineering_authority_request_id", "") or ""),
                    expected_contract_hash=str(getattr(args, "engineering_authority_contract_hash", "") or ""),
                )
                if engineering_authority_decision_provenance:
                    engineering_authority["decision_provenance"] = engineering_authority_decision_provenance
            except Exception as exc:
                return transaction_stop("engineering_authority_binding_failed", cycle=cycle, error=str(exc))
    else:
        approved_identity = approved_identity_from_args(args)
        preview_binding = operator_execution.approved_packet_binding_status(preview_identity, approved_identity)
        if not preview_binding.get("ok"):
            return transaction_stop("approved_packet_binding_failed", cycle=cycle, approved_packet_binding=preview_binding)

    runtime_action_class = controlled_engineering_action_class(
        engineering_authority,
        availability_first_reset=availability_first_reset,
    )
    qualifying_service_failure_event = (
        delegated_admission.get("qualifying_service_failure_event")
        if isinstance(delegated_admission.get("qualifying_service_failure_event"), dict) else {}
    )
    service_failure_causal_binding: dict[str, Any] = {}
    if str(qualifying_service_failure_event.get("event_type") or "") in {
        "SERVICE_FAILURE_OBSERVED", "SERVICE_FAILURE_REVALIDATED",
    }:
        source_event_id = str(qualifying_service_failure_event.get("event_id") or "")
        service_failure_causal_binding = {
            "schema_version": "v7.service-failure-causal-binding.v1",
            "source_incident_id": str(qualifying_service_failure_event.get("source_incident_id") or ""),
            "source_event_id": source_event_id,
            "source_event_ids": [source_event_id] if source_event_id else [],
            "event_type": str(qualifying_service_failure_event.get("event_type") or ""),
            "event_provenance": str(qualifying_service_failure_event.get("event_provenance") or ""),
            "observation_generation": str(qualifying_service_failure_event.get("observation_generation") or ""),
            "source_channel": str(qualifying_service_failure_event.get("object") or ""),
            "source_scope": (
                dict(qualifying_service_failure_event.get("source_scope") or {})
                if isinstance(qualifying_service_failure_event.get("source_scope"), dict)
                else {}
            ),
        }
    source_hashes = packet_preview.get("source_hashes") if isinstance(packet_preview.get("source_hashes"), dict) else {}
    source_bundle_hash = operator_execution.sha256_json(source_hashes) if source_hashes else ""
    controlled_window = operator_execution.build_autonomous_execution_control_state(
        False,
        actor=(str((delegated_admission.get("authority") or {}).get("policy_id") or (delegated_admission.get("authority") or {}).get("authority_basis") or "delegated-policy") if (delegated_mode or support_mode) else str(args.approval_author or "operator")),
        reason="governed_one_operation_window",
        operation_id=str(packet_preview.get("operation_id") or ""),
        selected_move_hash=str(packet_preview.get("selected_move_hash") or ""),
        action_class=runtime_action_class,
        source_bundle_hash=source_bundle_hash,
        snapshot_bundle_hash=str(packet_preview.get("snapshot_bundle_hash") or ""),
        max_users=1,
    )
    operator_execution.write_json_atomic(control_file, controlled_window)
    args._controlled_window_generation = str(controlled_window.get("generation") or "")
    args._controlled_window_operation_id = str(controlled_window.get("operation_id") or "")
    preflight_control = operator_execution.autonomous_execution_control_decision(
        control_file,
        mutation_kind="forward",
        action_class=runtime_action_class,
        expected_generation=str(controlled_window.get("generation") or ""),
        operation_id=str(packet_preview.get("operation_id") or ""),
        selected_move_hash=str(packet_preview.get("selected_move_hash") or ""),
        source_bundle_hash=source_bundle_hash,
        snapshot_bundle_hash=str(packet_preview.get("snapshot_bundle_hash") or ""),
        max_users=1,
    )
    if not preflight_control.get("allowed_forward_mutation"):
        return transaction_stop("autonomous_execution_control_denied_pre_lease", execution_control=preflight_control)

    try:
        packet = operator_execution.packet_from_preview(
            packet_preview,
            approval_author=args.approval_author,
            approval_reviewer=args.approval_reviewer,
            ttl_seconds=args.ttl_seconds,
            breaker_generation=str(preflight_control.get("generation") or ""),
            require_execution_binding=True,
            delegated_policy_authority=packet_materialization_authority(
                delegated_mode=delegated_mode,
                # Topology execution is admitted by the audited standing
                # delegated policy.  Only explicit operator setup/cleanup
                # keeps the historical dual-confirmation packet contract.
                setup_mode=(
                    setup_mode
                    or (cleanup_mode and not availability_first_reset)
                ),
                delegated_admission=delegated_admission,
            ),
            engineering_authority=engineering_authority,
            service_failure_causal_binding=(service_failure_causal_binding or None),
        )
    except Exception as exc:
        return transaction_stop("packet_materialization_failed", cycle=cycle, error=str(exc))

    approved_materialized_identity = dict(preview_identity if (delegated_mode or support_mode) else approved_identity)
    approved_materialized_identity["breaker_generation"] = str(preflight_control.get("generation") or "")
    packet_binding = operator_execution.approved_packet_binding_status(
        operator_execution.packet_identity(packet),
        approved_materialized_identity,
    )
    if not packet_binding.get("ok"):
        return transaction_stop("fresh_packet_materialization_changed_identity", cycle=cycle, packet_binding=packet_binding)

    constraints = transaction_packet_constraints_ok(packet, cycle, int(args.max_users))
    if not constraints.get("ok"):
        return transaction_stop("transaction_scope_invalid", cycle=cycle, constraints=constraints)

    user = constraints["users"][0]
    target = constraints["targets"][0]
    source = ((packet.get("rollback_manifest") or {}).get("items") or [{}])[0].get("rollback_target", "")
    packet_identity = operator_execution.packet_identity(packet)
    identity = (str(packet.get("packet_id") or ""), user, str(source or ""), target)
    if blocked_transaction_identities is not None and identity in blocked_transaction_identities:
        return transaction_stop(
            "duplicate_transaction_candidate",
            cycle=cycle,
            packet=operator_execution.redact(packet),
            transaction_identity={
                "packet_id": identity[0],
                "user": identity[1],
                "source": identity[2],
                "target": identity[3],
            },
            duplicate_guard_stage="pre_lease_pre_restore_barrier_pre_apply",
        )
    if required_a4_candidate_keys is not None and (user, target) not in required_a4_candidate_keys:
        return transaction_stop(
            "candidate_not_missing_a4_evidence",
            cycle=cycle,
            packet=operator_execution.redact(packet),
            candidate_key={"user": user, "target": target},
            evidence_guard_stage="pre_lease_pre_restore_barrier_pre_apply",
        )

    lease = operator_execution.create_execution_lease_from_packet(packet, source_preview=packet_preview)
    lease_create_result = operator_execution.write_execution_lease(lease_file, lease)
    if not lease_create_result.get("ok"):
        return transaction_stop("execution_lease_not_created", cycle=cycle, execution_lease_create_result=lease_create_result)

    restore_barrier_file = Path(args.restore_barrier_file) if args.restore_barrier_file else state_dir / "autoswitch-restore-barrier.json"
    audit_store = audit_dir / "operator-execution-audit.jsonl"
    lifecycle_store = audit_dir / "governance-lifecycle.jsonl"
    clearance_result = operator_execution.execute_packet(
        packet,
        audit_store,
        state_dir,
        mode="runtime_action",
        restore_barrier_file=restore_barrier_file,
        lifecycle_store=lifecycle_store,
        execution_lease_id=str(lease.get("lease_id") or ""),
    )
    if not clearance_result.get("execution_allowed_now"):
        terminal = operator_execution.finish_execution_lease(
            lease_file,
            status="OPERATOR_CANCELLED",
            reason="transaction_stop_safe_before_apply",
            operation={"terminal_state": "STOP_SAFE", "terminal_reason": "restore_barrier_clearance_denied", "apply_result": {"applied": False, "results": []}},
        )
        return transaction_stop(
            "restore_barrier_clearance_denied",
            cycle=cycle,
            packet=operator_execution.redact(packet),
            execution_lease_create_result=lease_create_result,
            clearance_result=clearance_result,
            lease_terminalization=terminal,
        )

    pre_apply_control = operator_execution.autonomous_execution_control_decision(
        control_file,
        mutation_kind="forward",
        action_class=runtime_action_class,
        expected_generation=str(packet_identity.get("breaker_generation") or ""),
        operation_id=str(packet_identity.get("operation_id") or ""),
        selected_move_hash=str(packet_identity.get("selected_move_hash") or ""),
        source_bundle_hash=str(packet_identity.get("source_bundle_hash") or ""),
        snapshot_bundle_hash=str(packet_identity.get("snapshot_bundle_hash") or ""),
        max_users=1,
    )
    if not pre_apply_control.get("allowed_forward_mutation"):
        terminal = operator_execution.finish_execution_lease(
            lease_file,
            status="OPERATOR_CANCELLED",
            reason="autonomous_execution_control_denied_pre_apply",
            operation={"terminal_state": "STOP_SAFE", "terminal_reason": "execution_control_changed", "apply_result": {"applied": False, "results": []}},
        )
        return transaction_stop("autonomous_execution_control_denied_pre_apply", execution_control=pre_apply_control, lease_terminalization=terminal)

    apply_options = controlled_engineering_apply_options(
        engineering_authority,
        availability_first_reset=availability_first_reset,
    )
    apply_run = run_autoswitch_apply(
        state_dir=state_dir,
        event_dir=event_dir,
        snapshot_root=snapshot_root,
        restore_barrier_file=restore_barrier_file,
        user=user,
        source=source,
        target=target,
        packet_id=str(packet_identity.get("packet_id") or ""),
        operation_id=str(packet_identity.get("operation_id") or ""),
        selected_move_hash=str(packet_identity.get("selected_move_hash") or ""),
        authority_generation=str(packet_identity.get("authority_generation") or ""),
        breaker_generation=str(packet_identity.get("breaker_generation") or ""),
        source_bundle_hash=str(packet_identity.get("source_bundle_hash") or ""),
        snapshot_bundle_hash=str(packet_identity.get("snapshot_bundle_hash") or ""),
        execution_control_file=str(control_file),
        **apply_options,
    )
    if topology_mode:
        apply_run = recover_controlled_topology_apply_terminal(
            apply_run,
            state_dir=state_dir,
            event_dir=event_dir,
            audit_store=audit_store,
            restore_barrier_file=restore_barrier_file,
            user=user,
            source=source,
            target=target,
            packet_id=str(packet_identity.get("packet_id") or ""),
            operation_id=str(packet_identity.get("operation_id") or ""),
        )
    apply_payload = apply_run.get("payload") if isinstance(apply_run.get("payload"), dict) else {}
    operation = dict(apply_payload.get("operation") or {})
    operation["apply_result"] = apply_payload.get("apply_result") if isinstance(apply_payload.get("apply_result"), dict) else {}
    terminal_status = lease_terminal_status_from_apply(apply_payload)
    lease_terminalization = operator_execution.finish_execution_lease(
        lease_file,
        status=terminal_status,
        reason=str(operation.get("terminal_reason") or "governed_transaction_complete"),
        operation=operation,
    )
    apply_result = apply_payload.get("apply_result") if isinstance(apply_payload.get("apply_result"), dict) else {}
    results = apply_result.get("results") if isinstance(apply_result.get("results"), list) else []
    rollback_attempted = any(bool(row.get("rollback_attempted")) for row in results if isinstance(row, dict))
    verification_passed = all(int(row.get("verify_rc", 1)) == 0 for row in results if isinstance(row, dict)) and bool(results)
    feedback_materialization = materialize_governed_transaction_feedback(
        state_dir=state_dir,
        packet=packet,
        operation=operation,
        apply_result=apply_result,
        user=user,
        source=source,
        target=target,
        rollback_attempted=rollback_attempted,
        verification_passed=verification_passed,
        evidence_class=(
            "CONTROLLED_PRODUCTION_TOPOLOGY"
            if topology_mode
            else (
                "ENGINEERING_SETUP"
                if setup_mode
                else ("ENGINEERING_CLEANUP" if cleanup_mode else "CONTROLLED_PRODUCTION")
            )
        ),
        service_failure_causal_binding=(packet.get("service_failure_causal_binding") if isinstance(packet.get("service_failure_causal_binding"), dict) else None),
    )
    apply_stop_reason = ""
    apply_stop_detail = ""
    if not apply_result.get("applied"):
        apply_stop_reason = str(
            operation.get("terminal_reason")
            or apply_payload.get("stop_reason")
            or apply_payload.get("final_verdict")
            or apply_run.get("error")
            or (
                f"autoswitch_apply_returncode_{int(apply_run.get('returncode') or 0)}"
                if int(apply_run.get("returncode") or 0) != 0
                else "autoswitch_apply_not_applied"
            )
        )
        atomic_validation = (
            apply_result.get("atomic_execution_envelope_validation")
            if isinstance(
                apply_result.get("atomic_execution_envelope_validation"),
                dict,
            )
            else {}
        )
        apply_stop_detail = str(
            apply_result.get("unsafe_blocker")
            or ",".join(
                f"source_hash:{item}"
                for item in (
                    atomic_validation.get("source_hash_mismatches") or []
                )
            )
            or ",".join(
                str(item)
                for item in (
                    (
                        atomic_validation.get("state")
                        if isinstance(
                            atomic_validation.get("state"), dict
                        )
                        else {}
                    ).get("mismatches")
                    or []
                )
            )
            or atomic_validation.get("reason")
            or ""
        )
    return {
        "schema_version": "v7.governed-execution-transaction.v1",
        "transaction_status": "COMPLETED" if apply_result.get("applied") else "STOP_SAFE",
        "final_verdict": "GOVERNED_TRANSACTION_COMPLETED" if apply_result.get("applied") else "GOVERNED_TRANSACTION_STOPPED",
        "stop_reason": apply_stop_reason,
        "stop_detail": apply_stop_detail,
        "fresh_packet_id": packet.get("packet_id", ""),
        "decision_id": packet.get("decision_id", ""),
        "operation_id": packet.get("operation_id", ""),
        "selected_move_hash": (packet.get("expected") or {}).get("selected_move_hash", ""),
        "user": user,
        "source": source,
        "target": target,
        "one_execution_attempt": True,
        "runtime_mutation_performed": bool(apply_result.get("applied")),
        "restore_barrier_written_now": bool((clearance_result.get("clearance_result") or {}).get("ok")),
        "apply_executed": bool(apply_result.get("applied")),
        "verification_result": "PASS" if verification_passed else ("NOT_RUN" if not results else "FAIL"),
        "rollback_attempted": rollback_attempted,
        "rollback_result": operation.get("rollback_verdict", "NOT_REQUIRED" if not rollback_attempted else ""),
        "feedback_materialization": feedback_materialization,
        "service_failure_causal_binding": service_failure_causal_binding,
        "a4_evidence_updated": bool(feedback_materialization.get("materialized")),
        "users_moved": len(results) if apply_result.get("applied") else 0,
        "runtime_automation_enabled": delegated_mode,
        "delegated_policy_admission": delegated_admission,
        "engineering_authority": operator_execution.redact(engineering_authority),
        "candidate_approval_required": not delegated_mode,
        "packet_approval_required": not delegated_mode,
        "hash_approval_required": not delegated_mode,
        "authority_expanded": False,
        "new_architecture_created": False,
        "new_authority_created": False,
        "new_runtime_path_created": False,
        "new_governance_created": False,
        "new_owner_created": False,
        "new_backlog_item_created": False,
        "cycle": cycle,
        "planner_observe": planner_observe,
        "a4_goal_directed_selection": a4_goal_directed_selection,
        "certification_setup_selection": certification_setup_selection,
        "certification_cleanup_selection": certification_cleanup_selection,
        "controlled_topology_standing_selection": (
            certification_setup_selection if topology_mode else {}
        ),
        "engineering_authority_selection": engineering_authority_selection,
        "execution_lease_create_result": lease_create_result,
        "clearance_result": clearance_result,
        "autoswitch_apply": apply_run,
        "lease_terminalization": lease_terminalization,
    }


def _key_value_process_output(output: str) -> dict[str, str]:
    values: dict[str, str] = {}
    for line in str(output or "").splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip()
    return values


def refresh_controlled_topology_execution_snapshots(
    args: argparse.Namespace,
    *,
    state_dir: Path,
    event_dir: Path,
    snapshot_root: Path,
) -> dict[str, Any]:
    """Consume the existing snapshot owner after reservation changes its source."""
    command = [
        str(
            getattr(args, "pre_planner_refresh_command", "")
            or snapshot_refresh_executable()
        ),
        "--state-dir",
        str(state_dir),
        "--event-dir",
        str(event_dir),
        "--out-dir",
        str(snapshot_root),
        "--pretty",
    ]
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=240,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "ok": False,
            "command": command,
            "returncode": None,
            "error": f"{type(exc).__name__}:{exc}",
        }
    try:
        parsed = json.loads(proc.stdout or "")
        result = parsed if isinstance(parsed, dict) else {}
    except json.JSONDecodeError:
        result = {}
    return {
        "ok": proc.returncode == 0,
        "command": command,
        "returncode": proc.returncode,
        "result": result,
        "output_tail": (proc.stdout or "")[-2000:] if proc.returncode != 0 else "",
    }


def execute_controlled_topology_standing_transaction(
    args: argparse.Namespace,
    *,
    state_dir: Path,
    event_dir: Path,
    snapshot_root: Path,
    audit_dir: Path,
    lease_file: Path,
) -> dict[str, Any]:
    """Reserve one empty target and reuse the generic governed transaction."""
    binding = controlled_topology_standing_execution_binding(
        args,
        state_dir=state_dir,
    )
    if not binding.get("allowed"):
        return {
            **transaction_stop(
                "controlled_topology_standing_execution_not_admitted",
                blockers=list(binding.get("blockers") or []),
            ),
            "controlled_topology_binding": binding,
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }
    manifest = (
        binding.get("manifest")
        if isinstance(binding.get("manifest"), dict)
        else {}
    )
    user = str(manifest.get("trial_identity") or "")
    source = str(manifest.get("existing_source") or "")
    target = str(manifest.get("selected_source_or_draft") or "")
    manifest_hash = str(manifest.get("manifest_hash") or "")
    egress_lines = [
        line
        for line in (state_dir / "egress.registry")
        .read_text(encoding="utf-8", errors="replace")
        .splitlines()
        if line.startswith(f"id={target} ")
    ]
    if len(egress_lines) != 1:
        return {
            **transaction_stop("controlled_topology_target_registry_identity_changed"),
            "controlled_topology_binding": binding,
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }
    expected_egress_fingerprint = operator_execution.sha256_bytes(
        egress_lines[0].encode("utf-8")
    )
    reservation_id = "ctres_" + operator_execution.sha256_json(
        {
            "contract_id": binding.get("contract_id"),
            "manifest_hash": manifest_hash,
            "user": user,
            "source": source,
            "target": target,
        }
    )[:24]
    reservation_expiry = (
        datetime.now(timezone.utc) + timedelta(minutes=30)
    ).isoformat()
    certification_group = str(
        manifest.get("certification_group")
        or "ctop-" + manifest_hash[:12]
    )
    reserve_command = [
        str(getattr(args, "egress_state_owner", "") or "v7-egress-set-state"),
        target,
        "certification-reserve",
        "--certification-group",
        certification_group,
        "--reservation-id",
        reservation_id,
        "--reservation-expires-at",
        reservation_expiry,
        "--expected-egress-fingerprint",
        expected_egress_fingerprint,
        "--apply",
        "--confirm",
        "RESERVE_CONTROLLED_CERTIFICATION_SOURCE",
    ]
    reserve_env = dict(os.environ)
    reserve_env["V7_STATE_DIR"] = str(state_dir)
    try:
        reserve_proc = subprocess.run(
            reserve_command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=180,
            env=reserve_env,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            **transaction_stop("controlled_topology_reservation_owner_failed"),
            "controlled_topology_binding": binding,
            "reservation_error": f"{type(exc).__name__}:{exc}",
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }
    reserve_result = _key_value_process_output(reserve_proc.stdout or "")
    reserved = (
        reserve_proc.returncode == 0
        and reserve_result.get("ACTION") == "controlled_source_reserved"
    )
    if not reserved:
        return {
            **transaction_stop("controlled_topology_reservation_not_applied"),
            "controlled_topology_binding": binding,
            "reservation_command": reserve_command,
            "reservation_returncode": reserve_proc.returncode,
            "reservation_result": reserve_result,
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }

    snapshot_refresh = refresh_controlled_topology_execution_snapshots(
        args,
        state_dir=state_dir,
        event_dir=event_dir,
        snapshot_root=snapshot_root,
    )
    if snapshot_refresh.get("ok"):
        transaction_args = copy.copy(args)
        transaction_args._controlled_topology_standing_request = {
            "user": user,
            "source": source,
            "target": target,
            "manifest_hash": manifest_hash,
        }
        transaction_args._controlled_topology_policy_binding = binding
        transaction_args.execute_bounded_delegated_transaction = True
        transaction_args.execute_controlled_topology_standing_transaction = True
        transaction_args.skip_planner_observe = True
        transaction_args.max_users = 1
        transaction = execute_governed_transaction_with_guards(
            transaction_args,
            state_dir=state_dir,
            event_dir=event_dir,
            snapshot_root=snapshot_root,
            audit_dir=audit_dir,
            lease_file=lease_file,
        )
    else:
        transaction = transaction_stop(
            "controlled_topology_post_reservation_snapshot_refresh_failed",
            snapshot_refresh=snapshot_refresh,
        )
    passed = (
        transaction.get("final_verdict") == "GOVERNED_TRANSACTION_COMPLETED"
        and transaction.get("verification_result") == "PASS"
        and int(transaction.get("users_moved") or 0) == 1
    )
    release_result: dict[str, Any] = {}
    if not passed:
        current_lines = [
            line
            for line in (state_dir / "egress.registry")
            .read_text(encoding="utf-8", errors="replace")
            .splitlines()
            if line.startswith(f"id={target} ")
        ]
        restore_backup = str(reserve_result.get("restore_backup") or "")
        if len(current_lines) == 1 and restore_backup:
            release_command = [
                str(
                    getattr(args, "egress_state_owner", "")
                    or "v7-egress-set-state"
                ),
                target,
                "certification-release",
                "--reservation-id",
                reservation_id,
                "--expected-egress-fingerprint",
                operator_execution.sha256_bytes(
                    current_lines[0].encode("utf-8")
                ),
                "--restore-backup",
                restore_backup,
                "--apply",
                "--confirm",
                "RELEASE_CONTROLLED_CERTIFICATION_SOURCE",
            ]
            try:
                release_proc = subprocess.run(
                    release_command,
                    text=True,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    check=False,
                    timeout=180,
                    env=reserve_env,
                )
                release_result = {
                    "command": release_command,
                    "returncode": release_proc.returncode,
                    "result": _key_value_process_output(
                        release_proc.stdout or ""
                    ),
                }
            except (OSError, subprocess.TimeoutExpired) as exc:
                release_result = {
                    "command": release_command,
                    "returncode": None,
                    "error": f"{type(exc).__name__}:{exc}",
                }
    route_verification = scoped_user_route_check(state_dir, user)
    final_pass = passed and route_verification.get("passed") is True
    selection = (
        transaction.get("certification_setup_selection")
        if isinstance(transaction.get("certification_setup_selection"), dict)
        else {}
    )
    transaction_blockers = list(selection.get("blockers") or [])
    cycle = (
        transaction.get("cycle")
        if isinstance(transaction.get("cycle"), dict)
        else {}
    )
    if not transaction_blockers and transaction.get("error"):
        transaction_blockers.append(str(transaction.get("error") or ""))
    if not transaction_blockers and cycle.get("stop_reason"):
        transaction_blockers.append(
            ":".join(
                part
                for part in (
                    str(cycle.get("stop_reason") or ""),
                    str(cycle.get("stop_detail") or ""),
                )
                if part
            )
        )
    release_applied = (
        bool(release_result)
        and int(release_result.get("returncode") or 0) == 0
        and str((release_result.get("result") or {}).get("ACTION") or "")
        == "controlled_source_released"
    )
    return {
        "schema_version": "v7.controlled-topology-standing-transaction.v1",
        "final_verdict": (
            "ONE_IDENTITY_AUTONOMOUS_CONTROLLED_TOPOLOGY_TRIAL_PROVEN"
            if final_pass
            else "STOP_SAFE"
        ),
        "transaction": transaction,
        "controlled_topology_binding": binding,
        "reservation": {
            "reservation_id": reservation_id,
            "reservation_expires_at": reservation_expiry,
            "target": target,
            "returncode": reserve_proc.returncode,
            "result": reserve_result,
        },
        "reservation_release": release_result,
        "post_reservation_snapshot_refresh": snapshot_refresh,
        "reservation_mutation_performed": True,
        "reservation_released_after_stop": bool(not passed and release_applied),
        "route_verification": route_verification,
        "trial_identity": user,
        "source": source,
        "target": target,
        "manifest_hash": manifest_hash,
        "fresh_packet_id": str(transaction.get("fresh_packet_id") or ""),
        "feedback_materialization": (
            transaction.get("feedback_materialization")
            if isinstance(transaction.get("feedback_materialization"), dict)
            else {}
        ),
        "verification_result": str(
            transaction.get("verification_result") or ""
        ),
        "stop_reason": (
            str(transaction.get("stop_reason") or "")
            if not final_pass
            else ""
        ),
        "blockers": transaction_blockers,
        "rollback_result": str(transaction.get("rollback_result") or ""),
        "runtime_mutation_performed": bool(
            transaction.get("runtime_mutation_performed")
        ),
        "users_moved": int(transaction.get("users_moved") or 0),
        "ordinary_users_moved": 0,
        "authority_expanded": False,
        "production_maturity_changed": False,
    }


def _availability_first_ordinary_assignment_projection(
    state_dir: Path,
) -> dict[str, Any]:
    rows = [
        row
        for row in read_registry(state_dir / "users.registry")
        if str(row.get("enabled") or "1").lower()
        in {"1", "true", "yes"}
        and str(row.get("certification_user") or "").lower()
        not in {"1", "true", "yes"}
    ]
    semantic = [
        {
            "ip": str(row.get("ip") or ""),
            "current": str(row.get("current") or ""),
            "group": str(row.get("group") or ""),
        }
        for row in sorted(rows, key=lambda item: str(item.get("ip") or ""))
    ]
    route_semantic = [
        {
            "ip": str(row.get("ip") or ""),
            "assign_hash": operator_execution.sha256_file(
                state_dir / f"user-{str(row.get('ip') or '')}.assign"
            ),
        }
        for row in sorted(rows, key=lambda item: str(item.get("ip") or ""))
    ]
    return {
        "count": len(semantic),
        "assignment_fingerprint": operator_execution.sha256_json(
            semantic
        ),
        "route_fingerprint": operator_execution.sha256_json(
            route_semantic
        ),
    }


def _availability_first_topology_diagnostic(
    args: argparse.Namespace,
    *,
    state_dir: Path,
) -> dict[str, Any]:
    command = [
        str(
            getattr(args, "controlled_topology_planner", "")
            or "v7-users-autoswitch"
        ),
        "--controlled-source-topology-diagnostic",
        "--state-dir",
        str(state_dir),
        "--policy-file",
        str(args.policy_file),
        "--action-class-audit-store",
        str(args.operator_execution_audit_store),
    ]
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=180,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "ok": False,
            "command": command,
            "blockers": [
                f"availability_first_planner_unavailable:{type(exc).__name__}"
            ],
        }
    try:
        parsed = json.loads(proc.stdout or "")
        diagnostic = parsed if isinstance(parsed, dict) else {}
    except json.JSONDecodeError:
        diagnostic = {}
    return {
        "ok": proc.returncode == 0 and bool(diagnostic),
        "command": command,
        "returncode": proc.returncode,
        "diagnostic": diagnostic,
        "blockers": (
            []
            if proc.returncode == 0 and diagnostic
            else ["availability_first_planner_failed_or_invalid_json"]
        ),
        "output_tail": (
            ""
            if proc.returncode == 0 and diagnostic
            else (proc.stdout or "")[-2000:]
        ),
    }


def availability_first_forward_evidence_status(
    state_dir: Path,
    *,
    packet_id: str,
    operation_id: str,
    user: str,
    source: str,
    target: str,
) -> dict[str, Any]:
    """Read exact forward Outcome/Replay/Learning from existing owners."""
    outcomes = intelligence_workers.read_jsonl_tail(
        state_dir / "execution-events.jsonl",
        limit=512,
        max_bytes=4_000_000,
    )
    closures = intelligence_workers.read_jsonl_tail(
        state_dir / "closure-records.jsonl",
        limit=512,
        max_bytes=4_000_000,
    )
    outcome = next(
        (
            row
            for row in reversed(outcomes)
            if str(row.get("schema_version") or "")
            == "v7.execution-outcome-record.v1"
            and str(row.get("packet_id") or "") == packet_id
            and str(row.get("decision_trace_id") or "") == operation_id
            and str(row.get("user") or "") == user
            and str(row.get("source_channel") or "") == source
            and str(row.get("target_channel") or "") == target
        ),
        {},
    )
    closure = next(
        (
            row
            for row in reversed(closures)
            if str(row.get("schema_version") or "")
            == "v7.execution-feedback-closure.v1"
            and str(row.get("packet_id") or "") == packet_id
            and str(row.get("closure_state") or "") == "CLOSED"
        ),
        {},
    )
    quality = (
        outcome.get("outcome_quality")
        if isinstance(outcome.get("outcome_quality"), dict)
        else {}
    )
    learning = (
        outcome.get("learning_record")
        if isinstance(outcome.get("learning_record"), dict)
        else {}
    )
    growth = (
        outcome.get("knowledge_growth")
        if isinstance(outcome.get("knowledge_growth"), dict)
        else {}
    )
    outcome_ok = bool(
        str(outcome.get("terminal_outcome_classification") or "")
        == "SUCCESS"
        and str(outcome.get("outcome_status") or "") == "success"
        and quality.get("verification_complete") is True
    )
    replay_ok = bool(
        str(outcome.get("input_snapshot_identity") or "")
        and str(outcome.get("decision_trace_id") or "") == operation_id
        and str(outcome.get("closure_reference") or "")
        and closure
        and str(closure.get("terminal_outcome_classification") or "")
        == "SUCCESS"
    )
    learning_ok = bool(
        str(learning.get("learning_record_id") or "")
        and growth.get("knowledge_gained") is True
    )
    blockers = []
    if not outcome_ok:
        blockers.append("forward_outcome_not_consumed")
    if not replay_ok:
        blockers.append("forward_replay_lineage_not_consumed")
    if not learning_ok:
        blockers.append("forward_learning_not_consumed")
    return {
        "schema_version": (
            "v7.availability-first-forward-evidence-status.v1"
        ),
        "ok": not blockers,
        "blockers": blockers,
        "packet_id": packet_id,
        "operation_id": operation_id,
        "feedback_id": str(outcome.get("feedback_id") or ""),
        "outcome_id": str(outcome.get("feedback_id") or ""),
        "learning_record_id": str(
            learning.get("learning_record_id") or ""
        ),
        "outcome_consumed": outcome_ok,
        "replay_consumed": replay_ok,
        "learning_consumed": learning_ok,
        "owner_paths": [
            "execution-events.jsonl",
            "closure-records.jsonl",
        ],
    }


def availability_first_partial_apply_recovery_context(
    args: argparse.Namespace,
    *,
    state_dir: Path,
    event_dir: Path,
    lease_file: Path,
) -> dict[str, Any]:
    """Bind an interrupted availability apply to current owner truth.

    A single Matrix-owned recovery may reset several already verified cohort
    members serially.  The forward audit is append-only for that invocation;
    retain it on the shallow-copied execution arguments instead of repeatedly
    parsing the full historical audit between members.  Route, registry,
    policy and evidence checks deliberately remain fresh on every call.
    """
    summary = read_json(
        state_dir / "service-matrix-refresh-summary.json",
        {},
    )
    current_routes = {
        str(row.get("ip") or ""): str(row.get("current") or "")
        for row in read_registry(state_dir / "users.registry")
        if row.get("ip")
    }
    availability: dict[str, Any] = {}
    result: dict[str, Any] = {}
    packet: dict[str, Any] = {}
    cohort_packets: list[dict[str, Any]] = []
    projection_source = ""
    recovery_mode = ""
    audit_containment_recovery = False
    cached_audit_records = getattr(
        args,
        "_availability_first_recovery_forward_audit_records",
        None,
    )
    if isinstance(cached_audit_records, list) and all(
        isinstance(row, dict) for row in cached_audit_records
    ):
        audit_records = cached_audit_records
    else:
        audit_records = live_runtime_lineage_records(args)
        # This is invocation-local lineage cache only, never a durable owner
        # or a substitute for fresh live gates. copy.copy(args) preserves it
        # while the same recovery Mission drains its exact pending members.
        args._availability_first_recovery_forward_audit_records = (
            audit_records
        )
    contract_root = read_json(Path(args.policy_file), {})
    contract = (
        contract_root.get("delegated_autonomy_policy")
        if isinstance(
            contract_root.get("delegated_autonomy_policy"),
            dict,
        )
        else {}
    )
    campaign_status = (
        operator_execution.availability_first_campaign_stage_status(
            audit_records,
            contract=contract,
        )
    )
    completed_stages = {
        int(value)
        for value in (campaign_status.get("completed_stages") or [])
    }
    latest_forward_by_user: dict[str, dict[str, str]] = {}
    for audit_row in audit_records:
        if (
            not isinstance(audit_row, dict)
            or audit_row.get("runtime_action_performed") is not True
            or str(audit_row.get("clearance_verdict") or "")
            != "RESTORE_BARRIER_CLEARANCE_WRITTEN"
        ):
            continue
        checks = (
            audit_row.get("checks")
            if isinstance(audit_row.get("checks"), dict)
            else {}
        )
        for move in checks.get("moves") or []:
            if not isinstance(move, dict):
                continue
            semantic = (
                move.get("availability_first_controlled_assignment")
                if isinstance(
                    move.get(
                        "availability_first_controlled_assignment"
                    ),
                    dict,
                )
                else {}
            )
            if semantic.get("baseline_reset") is True:
                continue
            user = str(move.get("user_ip") or move.get("user") or "")
            source = str(semantic.get("source") or "")
            target = str(semantic.get("target") or "")
            actual_source = str(
                move.get("current_egress") or move.get("from") or ""
            )
            actual_target = str(
                move.get("recommended_egress") or move.get("to") or ""
            )
            # Older reset attempts could carry a stale forward semantic before
            # baseline_reset was propagated through every Packet consumer.
            # When the executed move exposes its direction, it is authoritative
            # for classifying the audit row: a reverse move must never replace
            # the original forward lineage for this user.
            if (
                actual_source
                and actual_target
                and (actual_source != source or actual_target != target)
            ):
                continue
            if not all((user, source, target)):
                continue
            latest_forward_by_user[user] = {
                "packet_id": str(audit_row.get("packet_id") or ""),
                "operation_id": str(
                    audit_row.get("operation_id") or ""
                ),
                "source": source,
                "target": target,
            }

    cached_projection_rows = getattr(
        args,
        "_availability_first_recovery_forward_projection_rows",
        None,
    )
    if isinstance(cached_projection_rows, list) and all(
        isinstance(item, tuple)
        and len(item) == 2
        and isinstance(item[0], str)
        and isinstance(item[1], dict)
        for item in cached_projection_rows
    ):
        projection_rows = cached_projection_rows
    else:
        projection_rows: list[tuple[str, dict[str, Any]]] = []
        recovered_projection = (
            availability_first_interrupted_cohort_audit_projection(
                state_dir=state_dir,
                event_dir=event_dir,
                audit_records=audit_records,
                completed_stages=completed_stages,
            )
        )
        if recovered_projection:
            projection_rows.append((
                "append_only_execution_audit", recovered_projection,
            ))
        if isinstance(summary, dict):
            projection_rows.append(("current_summary", summary))
        for path in sorted(
            event_dir.glob("service-matrix-refresh-*.jsonl"),
            reverse=True,
        )[:RECENT_MATRIX_EVENT_FILE_LIMIT]:
            for row in reversed(
                intelligence_workers.read_jsonl_tail(
                    path,
                    limit=RECENT_MATRIX_EVENT_ROW_LIMIT,
                    max_bytes=RECENT_MATRIX_EVENT_BYTE_LIMIT,
                )
            ):
                if isinstance(row, dict):
                    projection_rows.append((
                        "append_only_matrix_event", row,
                    ))
        # The parent writes its next summary only after this stage terminal.
        # These rows are immutable forward lineage for one recovery run;
        # route, registry, policy and Outcome checks below stay fresh.
        args._availability_first_recovery_forward_projection_rows = (
            projection_rows
        )

    for source_kind, projection in projection_rows:
        candidate = (
            projection.get(
                "availability_first_standing_policy_action"
            )
            if isinstance(
                projection.get(
                    "availability_first_standing_policy_action"
                ),
                dict,
            )
            else {}
        )
        candidate_result = (
            candidate.get("consumer_result")
            if isinstance(candidate.get("consumer_result"), dict)
            else {}
        )
        candidate_packets = [
            row
            for row in (candidate_result.get("packet_set") or [])
            if isinstance(row, dict)
        ]
        circuit_breaker = (
            candidate_result.get("circuit_breaker")
            if isinstance(
                candidate_result.get("circuit_breaker"),
                dict,
            )
            else {}
        )
        candidate_stage = int(
            candidate_result.get("stage")
            or candidate.get("stage")
            or 0
        )
        if candidate_stage in completed_stages:
            continue
        cohort_has_incomplete_member = bool(
            candidate_stage > 1
            and len(candidate_packets) > 0
            and len(candidate_packets) <= candidate_stage
            and any(
                str(item.get("final_verdict") or "")
                != "L3_PRODUCTION_PROVEN"
                or str(item.get("verification_result") or "") != "PASS"
                or int(item.get("users_moved") or 0) != 1
                for item in candidate_packets
            )
        )
        audit_containment_cohort = bool(
            candidate_result.get("containment_only") is True
            and candidate_result.get(
                "recovered_from_existing_owner_truth"
            ) is True
            and candidate_stage > 1
            and len(candidate_packets) > 0
            and len(candidate_packets) <= candidate_stage
        )
        for candidate_packet in candidate_packets:
            candidate_user = str(candidate_packet.get("user") or "")
            candidate_target = str(candidate_packet.get("target") or "")
            candidate_source = str(candidate_packet.get("source") or "")
            candidate_packet_id = str(
                candidate_packet.get("fresh_packet_id") or ""
            )
            candidate_operation_id = str(
                candidate_packet.get("operation_id") or ""
            )
            latest_forward = latest_forward_by_user.get(
                candidate_user,
                {},
            )
            latest_forward_matches = bool(
                latest_forward
                and latest_forward.get("packet_id")
                == candidate_packet_id
                and latest_forward.get("operation_id")
                == candidate_operation_id
                and latest_forward.get("source") == candidate_source
                and latest_forward.get("target") == candidate_target
            )
            partial_apply = bool(
                str(candidate_packet.get("stop_reason") or "")
                == "l3_production_validation_downstream_proof_failed"
            )
            verified_stage_baseline_pending = bool(
                str(candidate_packet.get("final_verdict") or "")
                == "L3_PRODUCTION_PROVEN"
                and str(candidate_packet.get("verification_result") or "")
                == "PASS"
                and int(candidate_packet.get("users_moved") or 0) == 1
                and str(circuit_breaker.get("reason") or "")
                == "availability_first_baseline_reset_failed"
            )
            partial_cohort_baseline_pending = bool(
                cohort_has_incomplete_member
                and (
                    verified_stage_baseline_pending
                    or audit_containment_cohort
                )
            )
            if (
                candidate.get("status") == "STOP_SAFE"
                and (
                    partial_apply
                    or verified_stage_baseline_pending
                    or partial_cohort_baseline_pending
                )
                and candidate_user
                and candidate_packet.get("containment_required")
                    is not False
                and current_routes.get(candidate_user) == candidate_target
                and latest_forward_matches
            ):
                availability = candidate
                result = candidate_result
                packet = candidate_packet
                cohort_packets = candidate_packets
                projection_source = source_kind
                recovery_mode = (
                    "PARTIAL_COHORT_BASELINE_PENDING"
                    if partial_cohort_baseline_pending
                    else
                    "VERIFIED_STAGE_BASELINE_PENDING"
                    if verified_stage_baseline_pending
                    else "PARTIAL_APPLY_BASELINE_PENDING"
                )
                audit_containment_recovery = audit_containment_cohort
                break
        if packet:
            break
    if not packet:
        return {"pending": False, "blockers": []}
    user = str(packet.get("user") or "")
    source = str(packet.get("source") or "")
    target = str(packet.get("target") or "")
    packet_id = str(packet.get("fresh_packet_id") or "")
    operation_id = str(packet.get("operation_id") or "")
    stage = int(result.get("stage") or availability.get("stage") or 0)
    blockers: list[str] = []
    lease = operator_execution.load_execution_lease(lease_file)
    immutable = (
        lease.get("immutable_packet_identity")
        if isinstance(lease.get("immutable_packet_identity"), dict)
        else {}
    )
    if recovery_mode == "PARTIAL_APPLY_BASELINE_PENDING":
        for actual, expected, reason in (
            (immutable.get("packet_id"), packet_id, "partial_packet_changed"),
            (
                immutable.get("operation_id"),
                operation_id,
                "partial_operation_changed",
            ),
            (immutable.get("user"), user, "partial_user_changed"),
            (immutable.get("source"), source, "partial_source_changed"),
            (immutable.get("target"), target, "partial_target_changed"),
        ):
            if not expected or str(actual or "") != expected:
                blockers.append(reason)
    user_rows = [
        row
        for row in read_registry(state_dir / "users.registry")
        if str(row.get("ip") or "") == user
    ]
    if len(user_rows) != 1:
        blockers.append("partial_user_identity_not_unique")
        user_row: dict[str, Any] = {}
    else:
        user_row = user_rows[0]
    if not bool_value(user_row.get("certification_user")):
        blockers.append("partial_user_not_certification_identity")
    if str(user_row.get("current") or "") != target:
        return {"pending": False, "blockers": []}
    egress = read_registry(state_dir / "egress.registry")
    source_row = next(
        (row for row in egress if str(row.get("id") or "") == source),
        {},
    )
    target_row = next(
        (row for row in egress if str(row.get("id") or "") == target),
        {},
    )
    if not bool_value(
        source_row.get("controlled_certification_source")
    ):
        blockers.append("partial_source_not_controlled")
    if not bool_value(source_row.get("enabled")):
        blockers.append("partial_controlled_source_not_enabled")
    if not target_row or not bool_value(target_row.get("enabled")):
        blockers.append("partial_shared_target_not_enabled")
    matching_audit = next(
        (
            row
            for row in reversed(audit_records)
            if str(row.get("operation_id") or "") == operation_id
            and str(row.get("packet_id") or "") == packet_id
            and row.get("runtime_action_performed") is True
            and str(row.get("clearance_verdict") or "")
            == "RESTORE_BARRIER_CLEARANCE_WRITTEN"
        ),
        {},
    )
    lease_selected_moves = (
        (
            (lease.get("packet") or {}).get("approved_plan_lock")
            or {}
        ).get("selected_moves")
        or []
    )
    audit_checks = (
        matching_audit.get("checks")
        if isinstance(matching_audit.get("checks"), dict)
        else {}
    )
    audit_moves = [
        row
        for row in (audit_checks.get("moves") or [])
        if isinstance(row, dict)
    ]
    selected_moves = (
        audit_moves
        if recovery_mode in {
            "VERIFIED_STAGE_BASELINE_PENDING",
            "PARTIAL_COHORT_BASELINE_PENDING",
        }
        else lease_selected_moves
    )
    selected_move = (
        selected_moves[0]
        if len(selected_moves) == 1
        and isinstance(selected_moves[0], dict)
        else {}
    )
    semantic = (
        selected_move.get("availability_first_controlled_assignment")
        if isinstance(
            selected_move.get("availability_first_controlled_assignment"),
            dict,
        )
        else {}
    )
    allocation_fingerprint = str(
        (semantic or {}).get("allocation_fingerprint") or ""
    )
    if (
        str((semantic or {}).get("source") or "") != source
        or str((semantic or {}).get("target") or "") != target
        or not allocation_fingerprint
        or bool((semantic or {}).get("natural_production_credit"))
        or bool((semantic or {}).get("ordinary_user"))
    ):
        blockers.append("partial_availability_semantic_invalid")
    if not matching_audit:
        blockers.append("partial_restore_clearance_lineage_missing")
    try:
        switch_rows = [
            json.loads(line)
            for line in (
                event_dir / "switch-history.jsonl"
            ).read_text(
                encoding="utf-8",
                errors="replace",
            ).splitlines()[-2000:]
            if line.strip()
        ]
    except (OSError, json.JSONDecodeError):
        switch_rows = []
    if not any(
        str(row.get("user_ip") or "") == user
        and str(row.get("from") or "") == source
        and str(row.get("to") or "") == target
        for row in switch_rows
        if isinstance(row, dict)
    ):
        blockers.append("partial_switch_lineage_missing")
    validation = (
        operator_execution.validate_standing_delegated_operational_policy(
            contract,
            audit_records=audit_records,
        )
    )
    policy = (
        validation.get("policy")
        if isinstance(validation.get("policy"), dict)
        else {}
    )
    scopes = (
        policy.get("action_class_scopes")
        if isinstance(policy.get("action_class_scopes"), dict)
        else {}
    )
    availability_scope = (
        scopes.get(
            operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
        )
        if isinstance(
            scopes.get(
                operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
            ),
            dict,
        )
        else {}
    )
    if not validation.get("ok"):
        blockers.extend(validation.get("errors") or [])
    if (
        "RESTORE_CONTROLLED_CERTIFICATION_BASELINE"
        not in set(availability_scope.get("allowed_actions") or [])
    ):
        blockers.append("partial_baseline_reset_not_in_policy")
    if stage not in operator_execution.AVAILABILITY_FIRST_LADDER:
        blockers.append("partial_stage_not_in_ladder")
    forward_evidence = (
        availability_first_forward_evidence_status(
            state_dir,
            packet_id=packet_id,
            operation_id=operation_id,
            user=user,
            source=source,
            target=target,
        )
        if recovery_mode in {
            "VERIFIED_STAGE_BASELINE_PENDING",
            "PARTIAL_COHORT_BASELINE_PENDING",
        }
        else {}
    )
    if (
        recovery_mode == "VERIFIED_STAGE_BASELINE_PENDING"
        or audit_containment_recovery
    ):
        cohort_users = [
            str(row.get("user") or "")
            for row in cohort_packets
        ]
        expected_cohort_count = (
            len(cohort_packets)
            if audit_containment_recovery
            else stage
        )
        cohort_exact = bool(
            stage > 0
            and 0 < expected_cohort_count <= stage
            and len(cohort_packets) == expected_cohort_count
            and len(set(cohort_users)) == expected_cohort_count
            and all(cohort_users)
        )
        if cohort_exact:
            registry_by_user = {
                str(row.get("ip") or ""): row
                for row in read_registry(state_dir / "users.registry")
                if row.get("ip")
            }
            for cohort_packet in cohort_packets:
                cohort_user = str(cohort_packet.get("user") or "")
                cohort_source = str(cohort_packet.get("source") or "")
                cohort_target = str(cohort_packet.get("target") or "")
                cohort_packet_id = str(
                    cohort_packet.get("fresh_packet_id") or ""
                )
                cohort_operation_id = str(
                    cohort_packet.get("operation_id") or ""
                )
                cohort_row = registry_by_user.get(cohort_user, {})
                cohort_current_route = current_routes.get(cohort_user)
                cohort_route_owned = bool(
                    cohort_current_route in {
                        cohort_source,
                        cohort_target,
                    }
                    or (
                        cohort_packet.get(
                            "superseded_by_later_route"
                        ) is True
                        and cohort_current_route
                        == str(
                            cohort_packet.get("current_route") or ""
                        )
                        and str(
                            cohort_packet.get(
                                "superseding_switch_at"
                            ) or ""
                        )
                    )
                )
                if (
                    cohort_source != source
                    or not cohort_route_owned
                    or not bool_value(
                        cohort_row.get("certification_user")
                    )
                    or not cohort_packet_id
                    or not cohort_operation_id
                    or not any(
                        str(row.get("packet_id") or "")
                        == cohort_packet_id
                        and str(row.get("operation_id") or "")
                        == cohort_operation_id
                        and row.get("runtime_action_performed") is True
                        and str(row.get("clearance_verdict") or "")
                        == "RESTORE_BARRIER_CLEARANCE_WRITTEN"
                        for row in audit_records
                    )
                ):
                    cohort_exact = False
                    break
        if not cohort_exact:
            blockers.append(
                "verified_stage_recovery_requires_exact_cohort_projection"
            )
    if (
        recovery_mode == "VERIFIED_STAGE_BASELINE_PENDING"
        and not forward_evidence.get("ok")
    ):
        blockers.extend(
            forward_evidence.get("blockers")
            or ["verified_stage_forward_evidence_incomplete"]
        )
    recovered_target_fingerprint = operator_execution.sha256_json({
        "packet_id": packet_id,
        "target": target,
        "snapshot_bundle_hash": str(
            (
                audit_checks.get("snapshot_bundle_hash")
                if recovery_mode in {
                    "VERIFIED_STAGE_BASELINE_PENDING",
                    "PARTIAL_COHORT_BASELINE_PENDING",
                }
                else immutable.get("snapshot_bundle_hash")
            )
            or ""
        ),
        "allocation_fingerprint": allocation_fingerprint,
    })
    recovered_capacity_fingerprint = operator_execution.sha256_json({
        "packet_id": packet_id,
        "source_bundle_hash": str(
            (
                audit_checks.get("source_bundle_hash")
                if recovery_mode in {
                    "VERIFIED_STAGE_BASELINE_PENDING",
                    "PARTIAL_COHORT_BASELINE_PENDING",
                }
                else immutable.get("source_bundle_hash")
            )
            or ""
        ),
        "selected_move_hash": str(
            (
                audit_checks.get("selected_move_hash")
                if recovery_mode in {
                    "VERIFIED_STAGE_BASELINE_PENDING",
                    "PARTIAL_COHORT_BASELINE_PENDING",
                }
                else immutable.get("selected_move_hash")
            )
            or ""
        ),
        "max_users": int(
            (
                audit_checks.get("max_users")
                if recovery_mode in {
                    "VERIFIED_STAGE_BASELINE_PENDING",
                    "PARTIAL_COHORT_BASELINE_PENDING",
                }
                else immutable.get("max_users")
            )
            or 1
        ),
    })
    return {
        "schema_version": (
            "v7.availability-first-partial-apply-recovery-context.v1"
        ),
        "pending": True,
        "ok": not blockers,
        "blockers": sorted(set(str(item) for item in blockers)),
        "stage": stage,
        "user": user,
        "source": source,
        "target": target,
        "packet_id": packet_id,
        "operation_id": operation_id,
        "allocation_fingerprint": allocation_fingerprint,
        "contract_id": str(contract.get("contract_id") or ""),
        "contract_hash": str(contract.get("contract_hash") or ""),
        "ordinary_user": False,
        "natural_l8_credit": False,
        "projection_source": projection_source,
        "recovery_mode": recovery_mode,
        "cohort_packet_count": len(cohort_packets),
        "cohort_projection_exact": bool(
            (
                recovery_mode != "PARTIAL_COHORT_BASELINE_PENDING"
                or audit_containment_recovery
            )
            and (
                recovery_mode not in {
                    "VERIFIED_STAGE_BASELINE_PENDING",
                    "PARTIAL_COHORT_BASELINE_PENDING",
                }
                or "verified_stage_recovery_requires_exact_cohort_projection"
                    not in blockers
            )
        ),
        "production_outcome_credit": False,
        "forward_evidence": forward_evidence,
        "recovered_allocation": [{
            "target_id": target,
            "allocated_users": 1,
            "capacity_reservation": 1,
            "target_fingerprint": recovered_target_fingerprint,
            "capacity_bounds_fingerprint": (
                recovered_capacity_fingerprint
            ),
            "recovery_owner": (
                "immutable Packet identity + existing Outcome/closure owners"
            ),
        }],
    }


def exact_switch_after_clearance(
    audit_row: dict[str, Any],
    switch_rows: list[dict[str, Any]],
    *,
    user: str,
    source: str,
    target: str,
) -> dict[str, Any]:
    """Return the exact route commit produced after one clearance audit."""
    try:
        clearance_at = datetime.fromisoformat(
            str(audit_row.get("created_at") or "").replace(
                "Z", "+00:00"
            )
        )
    except ValueError:
        return {}
    for switch in switch_rows:
        if not isinstance(switch, dict):
            continue
        try:
            switch_at = datetime.fromisoformat(
                str(switch.get("ts") or "").replace("Z", "+00:00")
            )
        except ValueError:
            continue
        if (
            str(switch.get("user_ip") or "") == user
            and str(switch.get("from") or "") == source
            and str(switch.get("to") or "") == target
            and clearance_at <= switch_at
            and switch_at - clearance_at <= timedelta(minutes=5)
        ):
            return switch
    return {}


def availability_first_interrupted_cohort_audit_projection(
    *,
    state_dir: Path,
    event_dir: Path,
    audit_records: list[dict[str, Any]],
    completed_stages: set[int],
    expected_stage: int = 0,
    expected_target: str = "",
    campaign_next_stage: int = 0,
) -> dict[str, Any]:
    """Recover a timed-out stage from existing append-only owners.

    A Matrix parent may hit its wall-clock budget after child Packets have
    already committed execution.  Reconstruct an exact next-stage cohort
    whose common allocation fingerprint, restore clearance, switch lineage
    and current routes agree.  Outcome/Replay/Learning may be incomplete: in
    that case the projection authorizes containment only and never grants
    production evidence credit.  This is read-only and never replays action.
    """
    target_bound_mode = bool(expected_target)
    stage = int(expected_stage or 0)
    if stage <= 0:
        stage = next(
            (
                value
                for value in operator_execution.AVAILABILITY_FIRST_LADDER
                if value not in completed_stages
            ),
            0,
        )
    if stage <= 0 or (
        not target_bound_mode and stage <= 1
    ):
        return {}
    completed_receipt_times = [
        str(row.get("created_at") or "")
        for row in audit_records
        if (
            isinstance(row, dict)
            and str(row.get("effect_class") or "")
            == "AVAILABILITY_FIRST_CAMPAIGN_STAGE_CONSUMED"
            and int(row.get("campaign_stage") or 0) in completed_stages
            and str(row.get("created_at") or "")
        )
    ]
    if not completed_receipt_times:
        return {}
    cutoff = max(completed_receipt_times)
    grouped: dict[str, dict[str, dict[str, Any]]] = {}
    for audit_row in audit_records:
        if (
            not isinstance(audit_row, dict)
            or str(audit_row.get("created_at") or "") <= cutoff
            or audit_row.get("runtime_action_performed") is not True
            or str(audit_row.get("clearance_verdict") or "")
            != "RESTORE_BARRIER_CLEARANCE_WRITTEN"
        ):
            continue
        checks = (
            audit_row.get("checks")
            if isinstance(audit_row.get("checks"), dict)
            else {}
        )
        moves = [
            row for row in (checks.get("moves") or [])
            if isinstance(row, dict)
        ]
        if len(moves) != 1:
            continue
        move = moves[0]
        semantic = move.get("availability_first_controlled_assignment")
        semantic = semantic if isinstance(semantic, dict) else {}
        if semantic.get("baseline_reset") is True:
            continue
        fingerprint = str(
            semantic.get("allocation_fingerprint") or ""
        )
        user = str(move.get("user_ip") or move.get("user") or "")
        source = str(semantic.get("source") or "")
        target = str(semantic.get("target") or "")
        actual_source = str(
            move.get("current_egress") or move.get("from") or ""
        )
        actual_target = str(
            move.get("recommended_egress") or move.get("to") or ""
        )
        if (
            actual_source
            and actual_target
            and (actual_source != source or actual_target != target)
        ):
            continue
        if not all((fingerprint, user, source, target)):
            continue
        grouped.setdefault(fingerprint, {})[user] = {
            "audit": audit_row,
            "move": move,
            "source": source,
            "target": target,
        }

    routes_by_user = {
        str(row.get("ip") or ""): row
        for row in read_registry(state_dir / "users.registry")
        if row.get("ip")
    }
    switch_rows = intelligence_workers.read_jsonl_tail(
        event_dir / "switch-history.jsonl",
        limit=2048,
        max_bytes=RECENT_MATRIX_EVENT_BYTE_LIMIT,
    )
    candidates: list[tuple[str, str, list[dict[str, Any]]]] = []
    for fingerprint, members in grouped.items():
        if not (0 < len(members) <= stage):
            continue
        member_targets = {
            str(member.get("target") or "")
            for member in members.values()
        }
        if (
            target_bound_mode
            and member_targets != {expected_target}
        ):
            continue
        packets: list[dict[str, Any]] = []
        exact = True
        latest_at = ""
        for user, member in sorted(members.items()):
            audit_row = member["audit"]
            source = str(member["source"] or "")
            target = str(member["target"] or "")
            user_row = routes_by_user.get(user) or {}
            packet_id = str(audit_row.get("packet_id") or "")
            operation_id = str(audit_row.get("operation_id") or "")
            evidence = availability_first_forward_evidence_status(
                state_dir,
                packet_id=packet_id,
                operation_id=operation_id,
                user=user,
                source=source,
                target=target,
            )
            forward_switch = exact_switch_after_clearance(
                audit_row,
                switch_rows,
                user=user,
                source=source,
                target=target,
            )
            current_route = str(user_row.get("current") or "")
            superseding_switch = {}
            if not forward_switch or current_route not in {source, target}:
                lineage_after = str(
                    forward_switch.get("ts")
                    or audit_row.get("created_at")
                    or ""
                )
                superseding_switch = next(
                    (
                        row
                        for row in switch_rows
                        if isinstance(row, dict)
                        and str(row.get("user_ip") or "") == user
                        and str(row.get("to") or "") == current_route
                        and str(row.get("ts") or "") > lineage_after
                    ),
                    {},
                )
            if (
                not bool_value(user_row.get("certification_user"))
                or (
                    current_route not in {source, target}
                    and not superseding_switch
                )
                or not packet_id
                or not operation_id
                or (not forward_switch and not superseding_switch)
            ):
                exact = False
                break
            latest_at = max(
                latest_at,
                str(audit_row.get("created_at") or ""),
            )
            forward_effect_proven = bool(forward_switch)
            evidence_ok = bool(
                forward_effect_proven and evidence.get("ok") is True
            )
            packets.append({
                "final_verdict": (
                    "L3_PRODUCTION_PROVEN"
                    if evidence_ok
                    else "GOVERNED_TRANSACTION_STOPPED"
                ),
                "transaction_status": (
                    "COMPLETED" if evidence_ok else "STOP_SAFE"
                ),
                "stop_reason": (
                    "" if evidence_ok else
                    "l3_production_validation_downstream_proof_failed"
                ),
                "fresh_packet_id": packet_id,
                "operation_id": operation_id,
                "user": user,
                "users": [user],
                "source": source,
                "target": target,
                "target_id": target,
                "current_route": current_route,
                "containment_required": bool(
                    forward_effect_proven and current_route == target
                ),
                "baseline_restored": current_route == source,
                "superseded_by_later_route": bool(superseding_switch),
                "effect_not_proven": not forward_effect_proven,
                "superseding_switch_at": str(
                    superseding_switch.get("ts") or ""
                ),
                "users_moved": 1 if evidence_ok else 0,
                "runtime_mutation_performed": forward_effect_proven,
                "verification_result": (
                    "PASS" if evidence_ok else "STOP_SAFE"
                ),
                "rollback_result": "NOT_REQUIRED",
                "feedback_id": str(evidence.get("feedback_id") or ""),
                "outcome_id": str(evidence.get("outcome_id") or ""),
                "learning_record_id": str(
                    evidence.get("learning_record_id") or ""
                ),
                "recovered_from_existing_owner_truth": True,
                "production_outcome_credit": evidence_ok,
                "evidence_blockers": list(
                    evidence.get("blockers") or []
                ),
            })
        if exact and 0 < len(packets) <= stage:
            candidates.append((latest_at, fingerprint, packets))
    if not candidates:
        return {}
    _, fingerprint, packets = max(candidates, key=lambda item: item[0])
    return {
        "availability_first_standing_policy_action": {
            "schema_version": (
                "v7.availability-first-matrix-consumer.v1"
            ),
            "status": "STOP_SAFE",
            "ok": True,
            "action_attempted": True,
            "action_completed": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "stage": stage,
            "consumer_result": {
                "final_verdict": (
                    "AVAILABILITY_FIRST_STANDING_STAGE_STOPPED"
                ),
                "transaction_status": "STOP_SAFE",
                "stop_reason": (
                    "availability_first_parent_timeout_after_"
                    "committed_child_outcomes"
                ),
                "stage": stage,
                "target_bound_trial": target_bound_mode,
                "target_bound_trial_target": (
                    expected_target if target_bound_mode else ""
                ),
                "campaign_next_stage": (
                    int(campaign_next_stage or 0)
                    if target_bound_mode else 0
                ),
                "planned_stage_size": stage,
                "executed_member_count": len(packets),
                "partial_execution_cohort": len(packets) < stage,
                "packet_set": packets,
                "circuit_breaker": {
                    "tripped": True,
                    "remaining_subsets_stopped": True,
                    "reason": "availability_first_baseline_reset_failed",
                },
                "durable_successor": (
                    "EXISTING_MATRIX_FRESH_PARTIAL_APPLY_RECONCILIATION"
                ),
                "recovered_from_existing_owner_truth": True,
                "containment_only": any(
                    item.get("production_outcome_credit") is not True
                    for item in packets
                ),
                "production_outcome_credit": all(
                    item.get("production_outcome_credit") is True
                    for item in packets
                ),
                "allocation_fingerprint": fingerprint,
            },
        },
    }


def availability_first_restored_cohort_receipt_recovery_context(
    args: argparse.Namespace,
    *,
    state_dir: Path,
    event_dir: Path,
) -> dict[str, Any]:
    """Recover a multi-packet stage after every member reached baseline.

    Matrix deliberately serializes a stage into fresh one-user Packets.  A
    reset may therefore finish across several natural Matrix invocations.  The
    stage receipt is recoverable only when the original immutable cohort, each
    exact reset child, current route truth, switch lineage and existing
    Outcome/Replay/Learning owners all agree.  This function is read-only and
    never creates execution evidence.
    """
    summary = read_json(
        state_dir / "service-matrix-refresh-summary.json",
        {},
    )
    projections: list[dict[str, Any]] = []
    if isinstance(summary, dict):
        projections.append(summary)
    for path in sorted(
        event_dir.glob("service-matrix-refresh-*.jsonl"),
        reverse=True,
    )[:RECENT_MATRIX_EVENT_FILE_LIMIT]:
        projections.extend(reversed(
            intelligence_workers.read_jsonl_tail(
                path,
                limit=RECENT_MATRIX_EVENT_ROW_LIMIT,
                max_bytes=RECENT_MATRIX_EVENT_BYTE_LIMIT,
            )
        ))

    reset_markers: dict[tuple[str, str], dict[str, Any]] = {}
    for projection in projections:
        if not isinstance(projection, dict):
            continue
        action = projection.get(
            "availability_first_standing_policy_action"
        )
        action = action if isinstance(action, dict) else {}
        result = action.get("consumer_result")
        result = result if isinstance(result, dict) else {}
        forward = result.get("partial_apply_recovery")
        forward = forward if isinstance(forward, dict) else {}
        reset = result.get("reset_transaction")
        reset = reset if isinstance(reset, dict) else {}
        reconciliation = result.get("baseline_reset_reconciliation")
        reconciliation = (
            reconciliation if isinstance(reconciliation, dict) else {}
        )
        key = (
            str(forward.get("packet_id") or ""),
            str(forward.get("operation_id") or ""),
        )
        if (
            action.get("status") == "STOP_SAFE"
            and forward.get("ok") is True
            and reconciliation.get("ok") is True
            and all(key)
            and str(reset.get("fresh_packet_id") or "")
            and str(reset.get("operation_id") or "")
            and str(reset.get("user") or "")
            == str(forward.get("user") or "")
            and str(reset.get("source") or "")
            == str(forward.get("target") or "")
            and str(reset.get("target") or "")
            == str(forward.get("source") or "")
        ):
            reset_markers.setdefault(
                key,
                {
                    "forward": forward,
                    "reset": reset,
                    "reconciliation": reconciliation,
                },
            )

    routes_by_user = {
        str(row.get("ip") or ""): row
        for row in read_registry(state_dir / "users.registry")
        if row.get("ip")
    }
    audits = live_runtime_lineage_records(args)
    policy_root = read_json(Path(args.policy_file), {})
    contract = (
        policy_root.get("delegated_autonomy_policy")
        if isinstance(
            policy_root.get("delegated_autonomy_policy"),
            dict,
        )
        else {}
    )
    campaign_status = (
        operator_execution.availability_first_campaign_stage_status(
            audits,
            contract=contract,
        )
    )
    completed_stages = {
        int(value)
        for value in (campaign_status.get("completed_stages") or [])
    }
    recovered_projection = (
        availability_first_interrupted_cohort_audit_projection(
            state_dir=state_dir,
            event_dir=event_dir,
            audit_records=audits,
            completed_stages=completed_stages,
            expected_stage=int(
                getattr(args, "availability_first_stage", 0) or 0
            ),
            expected_target=str(
                getattr(
                    args,
                    "availability_first_target_bound_trial_target",
                    "",
                )
                or ""
            ),
            campaign_next_stage=int(
                campaign_status.get("next_stage") or 0
            ),
        )
    )
    if recovered_projection:
        # Prefer the original immutable Matrix stage projection.  The audit
        # reconstruction is a bounded fallback and may intentionally omit
        # Outcome/Replay/Learning pointers that the original stage receipt
        # already consumed.  Letting that smaller projection shadow the
        # original creates a false incomplete-evidence terminal after a long
        # cohort has already returned to baseline.
        projections.append(recovered_projection)
    switch_rows = intelligence_workers.read_jsonl_tail(
        event_dir / "switch-history.jsonl",
        limit=2048,
        max_bytes=RECENT_MATRIX_EVENT_BYTE_LIMIT,
    )

    def audit_for(packet_id: str, operation_id: str) -> dict[str, Any]:
        return next(
            (
                row for row in reversed(audits)
                if str(row.get("packet_id") or "") == packet_id
                and str(row.get("operation_id") or "") == operation_id
                and row.get("runtime_action_performed") is True
                and str(row.get("clearance_verdict") or "")
                == "RESTORE_BARRIER_CLEARANCE_WRITTEN"
            ),
            {},
        )

    def reset_audit_after_forward(
        *,
        packet_id: str,
        operation_id: str,
        user: str,
        source: str,
        target: str,
    ) -> tuple[dict[str, Any], dict[str, Any]]:
        """Bind the first exact reverse audit after the latest assignment.

        An interrupted parent may have persisted a reverse transaction under
        an older projection even though a later stage supplied the assignment
        that was actually current.  Append-only execution order, exact move
        semantics and current route truth are authoritative.  A later forward
        assignment supersedes the requested forward and prevents attribution
        of its subsequent reset to the older Packet.
        """
        forward_index = next(
            (
                index
                for index, row in enumerate(audits)
                if str(row.get("packet_id") or "") == packet_id
                and str(row.get("operation_id") or "") == operation_id
            ),
            -1,
        )
        if forward_index < 0:
            return {}, {}
        latest_reverse: tuple[dict[str, Any], dict[str, Any]] = ({}, {})
        for row in audits[forward_index + 1:]:
            if (
                not isinstance(row, dict)
                or row.get("runtime_action_performed") is not True
                or str(row.get("clearance_verdict") or "")
                != "RESTORE_BARRIER_CLEARANCE_WRITTEN"
            ):
                continue
            checks = (
                row.get("checks")
                if isinstance(row.get("checks"), dict)
                else {}
            )
            moves = [
                move for move in (checks.get("moves") or [])
                if isinstance(move, dict)
            ]
            for move in moves:
                move_user = str(
                    move.get("user_ip") or move.get("user") or ""
                )
                semantic = move.get(
                    "availability_first_controlled_assignment"
                )
                semantic = semantic if isinstance(semantic, dict) else {}
                if (
                    move_user == user
                    and str(semantic.get("source") or "") == source
                    and str(semantic.get("target") or "") == target
                ):
                    return {}, {}
                if (
                    move_user == user
                    and str(
                        move.get("current_egress")
                        or move.get("source")
                        or ""
                    )
                    == target
                    and str(
                        move.get("recommended_egress")
                        or move.get("target")
                        or ""
                    )
                    == source
                ):
                    latest_reverse = (row, move)
                    if exact_switch_after_clearance(
                        row,
                        switch_rows,
                        user=user,
                        source=target,
                        target=source,
                    ):
                        return row, move
        return latest_reverse

    for projection in projections:
        if not isinstance(projection, dict):
            continue
        action = projection.get(
            "availability_first_standing_policy_action"
        )
        action = action if isinstance(action, dict) else {}
        result = action.get("consumer_result")
        result = result if isinstance(result, dict) else {}
        circuit_breaker = result.get("circuit_breaker")
        circuit_breaker = (
            circuit_breaker if isinstance(circuit_breaker, dict) else {}
        )
        target_bound_mode = bool(result.get("target_bound_trial"))
        target_bound_target = str(
            result.get("target_bound_trial_target") or ""
        )
        stage = int(result.get("stage") or action.get("stage") or 0)
        packets = [
            row for row in (result.get("packet_set") or [])
            if isinstance(row, dict)
        ]
        users = [str(row.get("user") or "") for row in packets]
        if (
            action.get("status") != "STOP_SAFE"
            or str(circuit_breaker.get("reason") or "")
            != "availability_first_baseline_reset_failed"
            or stage <= 0
            or (not target_bound_mode and stage <= 1)
            or stage not in operator_execution.AVAILABILITY_FIRST_LADDER
            or (not target_bound_mode and stage in completed_stages)
            or len(packets) != stage
            or len(set(users)) != stage
            or not all(users)
            or any(
                str(row.get("final_verdict") or "")
                != "L3_PRODUCTION_PROVEN"
                or str(row.get("verification_result") or "") != "PASS"
                or int(row.get("users_moved") or 0) != 1
                for row in packets
            )
        ):
            continue
        # An outstanding member must first be consumed by the existing
        # partial-reset path.  Receipt reconciliation is eligible only after
        # the whole original cohort is back on its exact baseline.
        if any(
            str((routes_by_user.get(str(row.get("user") or "")) or {}).get(
                "current"
            ) or "")
            != str(row.get("source") or "")
            for row in packets
        ):
            continue

        blockers: list[str] = []
        recovered_packets: list[dict[str, Any]] = []
        reset_reconciliations: list[dict[str, Any]] = []
        allocation_fingerprints: set[str] = set()
        allocation_by_target: dict[str, list[dict[str, Any]]] = {}
        for packet in packets:
            user = str(packet.get("user") or "")
            source = str(packet.get("source") or "")
            target = str(packet.get("target") or "")
            packet_id = str(packet.get("fresh_packet_id") or "")
            operation_id = str(packet.get("operation_id") or "")
            key = (packet_id, operation_id)
            marker = reset_markers.get(key) or {}
            reset = marker.get("reset")
            reset = reset if isinstance(reset, dict) else {}
            reset_audit, reset_move = reset_audit_after_forward(
                packet_id=packet_id,
                operation_id=operation_id,
                user=user,
                source=source,
                target=target,
            )
            reset_packet_id = str(
                reset_audit.get("packet_id")
                or reset.get("fresh_packet_id")
                or ""
            )
            reset_operation_id = str(
                reset_audit.get("operation_id")
                or reset.get("operation_id")
                or ""
            )
            row = routes_by_user.get(user) or {}
            if not all(
                (
                    user,
                    source,
                    target,
                    packet_id,
                    operation_id,
                    reset_packet_id,
                    reset_operation_id,
                )
            ):
                blockers.append("restored_cohort_identity_incomplete")
                continue
            if not bool_value(row.get("certification_user")):
                blockers.append(
                    "restored_cohort_subject_not_certification_identity"
                )
            route = scoped_user_route_check(state_dir, user)
            if route.get("passed") is not True:
                blockers.append(
                    "restored_cohort_current_route_not_verified"
                )

            forward_audit = audit_for(packet_id, operation_id)
            if not reset_audit:
                reset_audit = audit_for(
                    reset_packet_id,
                    reset_operation_id,
                )
            forward_moves = (
                (forward_audit.get("checks") or {}).get("moves")
                if isinstance(forward_audit.get("checks"), dict)
                else []
            ) or []
            reset_moves = (
                (reset_audit.get("checks") or {}).get("moves")
                if isinstance(reset_audit.get("checks"), dict)
                else []
            ) or []
            forward_move = (
                forward_moves[0]
                if len(forward_moves) == 1
                and isinstance(forward_moves[0], dict)
                else {}
            )
            if not reset_move:
                reset_move = (
                    reset_moves[0]
                    if len(reset_moves) == 1
                    and isinstance(reset_moves[0], dict)
                    else {}
                )
            semantic = forward_move.get(
                "availability_first_controlled_assignment"
            )
            semantic = semantic if isinstance(semantic, dict) else {}
            allocation_fingerprint = str(
                semantic.get("allocation_fingerprint") or ""
            )
            if (
                str(packet.get("final_verdict") or "")
                != "L3_PRODUCTION_PROVEN"
                or str(packet.get("verification_result") or "") != "PASS"
                or int(packet.get("users_moved") or 0) != 1
                or str(forward_move.get("user_ip") or "") != user
                or str(forward_move.get("current_egress") or "") != source
                or str(forward_move.get("recommended_egress") or "")
                != target
                or str(semantic.get("source") or "") != source
                or str(semantic.get("target") or "") != target
                or not allocation_fingerprint
                or bool(semantic.get("ordinary_user"))
                or bool(semantic.get("natural_production_credit"))
            ):
                blockers.append(
                    "restored_cohort_forward_audit_binding_invalid"
                )
            else:
                allocation_fingerprints.add(allocation_fingerprint)
            if (
                str(reset_move.get("user_ip") or "") != user
                or str(reset_move.get("current_egress") or "") != target
                or str(reset_move.get("recommended_egress") or "") != source
            ):
                blockers.append(
                    "restored_cohort_reset_audit_binding_invalid"
                )

            switch_bound = bool(exact_switch_after_clearance(
                reset_audit,
                switch_rows,
                user=user,
                source=target,
                target=source,
            ))
            if not switch_bound:
                blockers.append(
                    "restored_cohort_reset_switch_lineage_missing"
                )

            projected_evidence_consumed = bool(
                result.get("outcome_consumed") is True
                and result.get("replay_consumed") is True
                and result.get("learning_consumed") is True
                and str(packet.get("feedback_id") or "")
                and str(packet.get("outcome_id") or "")
                and str(packet.get("learning_record_id") or "")
                and str(packet.get("final_verdict") or "")
                == "L3_PRODUCTION_PROVEN"
                and str(packet.get("verification_result") or "") == "PASS"
                and int(packet.get("users_moved") or 0) == 1
            )
            evidence = (
                {
                    "ok": True,
                    "blockers": [],
                    "feedback_id": str(packet.get("feedback_id") or ""),
                    "outcome_id": str(packet.get("outcome_id") or ""),
                    "learning_record_id": str(
                        packet.get("learning_record_id") or ""
                    ),
                    "outcome_consumed": True,
                    "replay_consumed": True,
                    "learning_consumed": True,
                    "projection_reused": True,
                    "projection_owner": (
                        "immutable Matrix stage receipt + existing "
                        "Outcome/Replay/Learning owners"
                    ),
                }
                if projected_evidence_consumed
                else availability_first_forward_evidence_status(
                    state_dir,
                    packet_id=packet_id,
                    operation_id=operation_id,
                    user=user,
                    source=source,
                    target=target,
                )
            )
            if not evidence.get("ok"):
                blockers.extend(
                    evidence.get("blockers")
                    or ["restored_cohort_forward_evidence_incomplete"]
                )
            recovered_packets.append({
                **packet,
                "feedback_id": str(evidence.get("feedback_id") or ""),
                "outcome_id": str(evidence.get("outcome_id") or ""),
                "learning_record_id": str(
                    evidence.get("learning_record_id") or ""
                ),
                "recovered_from_existing_owner_truth": True,
            })
            reset_reconciliations.append({
                "ok": bool(
                    route.get("passed") is True and switch_bound
                ),
                "mode": (
                    "POST_CLEARANCE_ROUTE_COMMIT_RECONCILED_"
                    "FROM_EXISTING_OWNERS"
                ),
                "user": user,
                "current_egress": source,
                "packet_id": reset_packet_id,
                "operation_id": reset_operation_id,
                "switch_lineage": switch_bound,
                "natural_l8_credit": False,
                "production_outcome_credit": False,
            })
            allocation_by_target.setdefault(target, []).append({
                "packet_id": packet_id,
                "operation_id": operation_id,
                "selected_move_hash": str(
                    (forward_audit.get("checks") or {}).get(
                        "selected_move_hash"
                    )
                    or ""
                ),
            })

        if len(allocation_fingerprints) != 1:
            blockers.append(
                "restored_cohort_allocation_fingerprint_mismatch"
            )
        allocation_fingerprint = next(
            iter(allocation_fingerprints),
            "",
        )
        validation = (
            operator_execution.validate_standing_delegated_operational_policy(
                contract,
                audit_records=audits,
            )
        )
        policy = (
            validation.get("policy")
            if isinstance(validation.get("policy"), dict)
            else {}
        )
        scopes = (
            policy.get("action_class_scopes")
            if isinstance(policy.get("action_class_scopes"), dict)
            else {}
        )
        availability_scope = scopes.get(
            operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
        )
        availability_scope = (
            availability_scope
            if isinstance(availability_scope, dict)
            else {}
        )
        if not validation.get("ok"):
            blockers.extend(validation.get("errors") or [])
        if (
            "RESTORE_CONTROLLED_CERTIFICATION_BASELINE"
            not in set(availability_scope.get("allowed_actions") or [])
        ):
            blockers.append(
                "restored_cohort_baseline_reset_not_in_policy"
            )

        recovered_allocation = []
        for target, members in allocation_by_target.items():
            recovered_allocation.append({
                "target_id": target,
                "allocated_users": len(members),
                "capacity_reservation": len(members),
                "target_fingerprint": operator_execution.sha256_json({
                    "target": target,
                    "packet_ids": [
                        item["packet_id"] for item in members
                    ],
                    "allocation_fingerprint": allocation_fingerprint,
                }),
                "capacity_bounds_fingerprint": (
                    operator_execution.sha256_json({
                        "target": target,
                        "selected_move_hashes": [
                            item["selected_move_hash"] for item in members
                        ],
                        "allocated_users": len(members),
                    })
                ),
                "recovery_owner": (
                    "existing Packet audit + Outcome/closure + route owners"
                ),
            })
        return {
            "schema_version": (
                "v7.availability-first-restored-cohort-receipt-"
                "recovery.v1"
            ),
            "pending": True,
            "ok": not blockers,
            "blockers": sorted(set(str(item) for item in blockers)),
            "stage": stage,
            "target_bound_trial": target_bound_mode,
            "target_bound_trial_target": target_bound_target,
            "campaign_next_stage": int(
                result.get("campaign_next_stage")
                or campaign_status.get("next_stage")
                or 0
            ),
            "source": str(packets[0].get("source") or ""),
            "packet_set": recovered_packets,
            "reset_reconciliations": reset_reconciliations,
            "allocation_fingerprint": allocation_fingerprint,
            "contract_id": str(contract.get("contract_id") or ""),
            "contract_hash": str(contract.get("contract_hash") or ""),
            "recovered_allocation": recovered_allocation,
            "natural_l8_credit": False,
            "production_outcome_credit": False,
        }
    return {"pending": False, "blockers": []}


def availability_first_restored_stage_receipt_recovery_context(
    args: argparse.Namespace,
    *,
    state_dir: Path,
    event_dir: Path,
) -> dict[str, Any]:
    """Recover a missing Stage-1 receipt after its baseline was restored.

    This is a read-only reconciliation across existing owners.  It is used
    only when the forward transaction, reverse clearance, reverse route commit,
    Outcome/Replay/Learning and current route all agree but an interrupted
    parent failed to append the stage receipt.  It never replays either move.
    """
    cohort = availability_first_restored_cohort_receipt_recovery_context(
        args,
        state_dir=state_dir,
        event_dir=event_dir,
    )
    if cohort.get("pending"):
        return cohort

    summary = read_json(
        state_dir / "service-matrix-refresh-summary.json",
        {},
    )
    projections: list[dict[str, Any]] = []
    if isinstance(summary, dict):
        projections.append(summary)
    for path in sorted(
        event_dir.glob("service-matrix-refresh-*.jsonl"),
        reverse=True,
    )[:RECENT_MATRIX_EVENT_FILE_LIMIT]:
        projections.extend(reversed(
            intelligence_workers.read_jsonl_tail(
                path,
                limit=RECENT_MATRIX_EVENT_ROW_LIMIT,
                max_bytes=RECENT_MATRIX_EVENT_BYTE_LIMIT,
            )
        ))
    marker: dict[str, Any] = {}
    for projection in projections:
        if not isinstance(projection, dict):
            continue
        action = projection.get(
            "availability_first_standing_policy_action"
        )
        action = action if isinstance(action, dict) else {}
        result = action.get("consumer_result")
        result = result if isinstance(result, dict) else {}
        forward = result.get("partial_apply_recovery")
        forward = forward if isinstance(forward, dict) else {}
        reset = result.get("reset_transaction")
        reset = reset if isinstance(reset, dict) else {}
        if (
            action.get("status") == "STOP_SAFE"
            and forward.get("ok") is True
            and int(forward.get("stage") or result.get("stage") or 0) == 1
            and str(forward.get("user") or "")
            and str(forward.get("source") or "")
            and str(forward.get("target") or "")
            and str(forward.get("packet_id") or "")
            and str(forward.get("operation_id") or "")
            and str(reset.get("fresh_packet_id") or "")
            and str(reset.get("operation_id") or "")
            and str(reset.get("user") or "") == str(forward.get("user") or "")
            and str(reset.get("source") or "")
            == str(forward.get("target") or "")
            and str(reset.get("target") or "")
            == str(forward.get("source") or "")
        ):
            marker = {
                "forward": forward,
                "reset": reset,
                "projection_updated": str(
                    projection.get("updated") or ""
                ),
            }
            break
    if not marker:
        return {"pending": False, "blockers": []}

    forward = marker["forward"]
    reset = marker["reset"]
    user = str(forward.get("user") or "")
    source = str(forward.get("source") or "")
    target = str(forward.get("target") or "")
    forward_packet_id = str(forward.get("packet_id") or "")
    forward_operation_id = str(forward.get("operation_id") or "")
    reset_packet_id = str(reset.get("fresh_packet_id") or "")
    reset_operation_id = str(reset.get("operation_id") or "")
    blockers: list[str] = []

    routes = {
        str(row.get("ip") or ""): str(row.get("current") or "")
        for row in read_registry(state_dir / "users.registry")
        if row.get("ip")
    }
    if routes.get(user) != source:
        return {"pending": False, "blockers": []}
    route = scoped_user_route_check(state_dir, user)
    if route.get("passed") is not True:
        blockers.append("restored_stage_current_route_not_verified")

    audits = live_runtime_lineage_records(args)
    forward_audit = next(
        (
            row for row in reversed(audits)
            if str(row.get("packet_id") or "") == forward_packet_id
            and str(row.get("operation_id") or "")
            == forward_operation_id
            and row.get("runtime_action_performed") is True
            and str(row.get("clearance_verdict") or "")
            == "RESTORE_BARRIER_CLEARANCE_WRITTEN"
        ),
        {},
    )
    reset_audit = next(
        (
            row for row in reversed(audits)
            if str(row.get("packet_id") or "") == reset_packet_id
            and str(row.get("operation_id") or "") == reset_operation_id
            and row.get("runtime_action_performed") is True
            and str(row.get("clearance_verdict") or "")
            == "RESTORE_BARRIER_CLEARANCE_WRITTEN"
        ),
        {},
    )
    forward_moves = (
        (forward_audit.get("checks") or {}).get("moves")
        if isinstance(forward_audit.get("checks"), dict)
        else []
    ) or []
    reset_moves = (
        (reset_audit.get("checks") or {}).get("moves")
        if isinstance(reset_audit.get("checks"), dict)
        else []
    ) or []
    forward_move = (
        forward_moves[0]
        if len(forward_moves) == 1
        and isinstance(forward_moves[0], dict)
        else {}
    )
    reset_move = (
        reset_moves[0]
        if len(reset_moves) == 1
        and isinstance(reset_moves[0], dict)
        else {}
    )
    semantic = forward_move.get(
        "availability_first_controlled_assignment"
    )
    semantic = semantic if isinstance(semantic, dict) else {}
    allocation_fingerprint = str(
        semantic.get("allocation_fingerprint") or ""
    )
    if (
        str(forward_move.get("user_ip") or "") != user
        or str(forward_move.get("current_egress") or "") != source
        or str(forward_move.get("recommended_egress") or "") != target
        or str(semantic.get("source") or "") != source
        or str(semantic.get("target") or "") != target
        or not allocation_fingerprint
        or bool(semantic.get("ordinary_user"))
        or bool(semantic.get("natural_production_credit"))
    ):
        blockers.append("restored_stage_forward_audit_binding_invalid")
    if (
        str(reset_move.get("user_ip") or "") != user
        or str(reset_move.get("current_egress") or "") != target
        or str(reset_move.get("recommended_egress") or "") != source
    ):
        blockers.append("restored_stage_reset_audit_binding_invalid")

    try:
        clearance_at = datetime.fromisoformat(
            str(reset_audit.get("created_at") or "").replace("Z", "+00:00")
        )
    except ValueError:
        clearance_at = None
    switch_bound = False
    for row in intelligence_workers.read_jsonl_tail(
        event_dir / "switch-history.jsonl",
        limit=256,
        max_bytes=RECENT_MATRIX_EVENT_BYTE_LIMIT,
    ):
        if not isinstance(row, dict) or clearance_at is None:
            continue
        try:
            switch_at = datetime.fromisoformat(
                str(row.get("ts") or "").replace("Z", "+00:00")
            )
        except ValueError:
            continue
        if (
            str(row.get("user_ip") or "") == user
            and str(row.get("from") or "") == target
            and str(row.get("to") or "") == source
            and clearance_at <= switch_at
            and switch_at - clearance_at <= timedelta(minutes=5)
        ):
            switch_bound = True
            break
    if not switch_bound:
        blockers.append("restored_stage_reset_switch_lineage_missing")

    forward_evidence = availability_first_forward_evidence_status(
        state_dir,
        packet_id=forward_packet_id,
        operation_id=forward_operation_id,
        user=user,
        source=source,
        target=target,
    )
    if not forward_evidence.get("ok"):
        blockers.extend(
            forward_evidence.get("blockers")
            or ["restored_stage_forward_evidence_incomplete"]
        )

    policy_root = read_json(Path(args.policy_file), {})
    contract = (
        policy_root.get("delegated_autonomy_policy")
        if isinstance(
            policy_root.get("delegated_autonomy_policy"),
            dict,
        )
        else {}
    )
    campaign_status = (
        operator_execution.availability_first_campaign_stage_status(
            audits,
            contract=contract,
        )
    )
    if (
        campaign_status.get("ok") is True
        and 1 in {
            int(value)
            for value in (campaign_status.get("completed_stages") or [])
        }
    ):
        return {
            "pending": False,
            "blockers": [],
            "reason": "restored_stage_receipt_already_consumed",
            "receipt_id": str(
                (campaign_status.get("receipt_ids") or [""])[0]
            ),
        }
    validation = (
        operator_execution.validate_standing_delegated_operational_policy(
            contract,
            audit_records=audits,
        )
    )
    policy = (
        validation.get("policy")
        if isinstance(validation.get("policy"), dict)
        else {}
    )
    availability_scope = (
        (policy.get("action_class_scopes") or {}).get(
            operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
        )
        if isinstance(policy.get("action_class_scopes"), dict)
        else {}
    )
    availability_scope = (
        availability_scope
        if isinstance(availability_scope, dict)
        else {}
    )
    if not validation.get("ok"):
        blockers.extend(validation.get("errors") or [])
    if (
        "RESTORE_CONTROLLED_CERTIFICATION_BASELINE"
        not in set(availability_scope.get("allowed_actions") or [])
    ):
        blockers.append("restored_stage_baseline_reset_not_in_policy")

    recovered_target_fingerprint = operator_execution.sha256_json({
        "packet_id": forward_packet_id,
        "target": target,
        "allocation_fingerprint": allocation_fingerprint,
    })
    recovered_capacity_fingerprint = operator_execution.sha256_json({
        "packet_id": forward_packet_id,
        "selected_move_hash": str(
            (forward_audit.get("checks") or {}).get(
                "selected_move_hash"
            )
            or ""
        ),
        "allocation_fingerprint": allocation_fingerprint,
    })
    return {
        "schema_version": (
            "v7.availability-first-restored-stage-receipt-recovery.v1"
        ),
        "pending": True,
        "ok": not blockers,
        "blockers": sorted(set(str(item) for item in blockers)),
        "stage": 1,
        "user": user,
        "source": source,
        "target": target,
        "packet_id": forward_packet_id,
        "operation_id": forward_operation_id,
        "reset_packet_id": reset_packet_id,
        "reset_operation_id": reset_operation_id,
        "allocation_fingerprint": allocation_fingerprint,
        "contract_id": str(contract.get("contract_id") or ""),
        "contract_hash": str(contract.get("contract_hash") or ""),
        "route_check": route,
        "switch_lineage": switch_bound,
        "forward_evidence": forward_evidence,
        "recovered_allocation": [{
            "target_id": target,
            "allocated_users": 1,
            "capacity_reservation": 1,
            "target_fingerprint": recovered_target_fingerprint,
            "capacity_bounds_fingerprint": (
                recovered_capacity_fingerprint
            ),
            "recovery_owner": (
                "existing Packet audit + Outcome/closure + route owners"
            ),
        }],
        "natural_l8_credit": False,
        "production_outcome_credit": False,
    }


def execute_availability_first_standing_stage(
    args: argparse.Namespace,
    *,
    state_dir: Path,
    event_dir: Path,
    snapshot_root: Path,
    audit_dir: Path,
    lease_file: Path,
) -> dict[str, Any]:
    """Run one exact ladder stage as a serialized packet-set.

    The allocation is derived from the existing Planner and remains immutable
    for this invocation.  Each target subset receives a fresh Candidate,
    Packet and lease through the existing cohort executor.  The single active
    lease plus a fresh pre-apply capacity check is the existing-owner capacity
    reservation; no second reservation registry is introduced.
    """
    mission_started_ns = time.monotonic_ns()
    performance_timeline: list[dict[str, Any]] = []

    def record_phase(
        phase: str,
        started_ns: int,
        *,
        owner: str,
        status: str = "PASS",
        member: str = "",
        cohort_size: int = 0,
        subset_fingerprint: str = "",
        packet_id: str = "",
        operation_id: str = "",
    ) -> None:
        completed_ns = time.monotonic_ns()
        performance_timeline.append({
            "phase": phase,
            "owner": owner,
            "status": status,
            "member_id": member,
            "cohort_size": max(0, int(cohort_size or 0)),
            "subset_fingerprint": subset_fingerprint,
            "packet_id": packet_id,
            "operation_id": operation_id,
            "completed_at": datetime.now(timezone.utc).isoformat(),
            "started_offset_us": max(
                0, (started_ns - mission_started_ns) // 1_000
            ),
            "duration_us": max(0, (completed_ns - started_ns) // 1_000),
        })

    restored_started_ns = time.monotonic_ns()
    restored = availability_first_restored_stage_receipt_recovery_context(
        args,
        state_dir=state_dir,
        event_dir=event_dir,
    )
    record_phase(
        "restored_receipt_reconciliation",
        restored_started_ns,
        owner="existing Packet/audit/route/Outcome owners",
        status="PENDING" if restored.get("pending") else "NO_WORK",
    )
    if restored.get("pending"):
        if not restored.get("ok"):
            return {
                **transaction_stop(
                    "availability_first_restored_stage_receipt_not_admitted",
                    blockers=restored.get("blockers") or [],
                ),
                "restored_stage_receipt_recovery": restored,
                "durable_successor": (
                    "EXISTING_MATRIX_FRESH_RESTORED_STAGE_RECONCILIATION"
                ),
                "performance_timeline": performance_timeline,
            }
        forward_evidence = restored.get("forward_evidence") or {}
        recovered_packets = [
            row for row in (restored.get("packet_set") or [])
            if isinstance(row, dict)
        ]
        if not recovered_packets:
            recovered_packets = [{
                "final_verdict": "L3_PRODUCTION_PROVEN",
                "transaction_status": "COMPLETED",
                "fresh_packet_id": str(restored.get("packet_id") or ""),
                "operation_id": str(restored.get("operation_id") or ""),
                "user": str(restored.get("user") or ""),
                "users": [str(restored.get("user") or "")],
                "source": str(restored.get("source") or ""),
                "target": str(restored.get("target") or ""),
                "target_id": str(restored.get("target") or ""),
                "users_moved": 1,
                "runtime_mutation_performed": True,
                "verification_result": "PASS",
                "rollback_result": "NOT_REQUIRED",
                "feedback_id": str(
                    forward_evidence.get("feedback_id") or ""
                ),
                "outcome_id": str(
                    forward_evidence.get("outcome_id") or ""
                ),
                "learning_record_id": str(
                    forward_evidence.get("learning_record_id") or ""
                ),
                "recovered_from_existing_owner_truth": True,
            }]
        recovered_allocation = [
            row
            for row in (restored.get("recovered_allocation") or [])
            if isinstance(row, dict)
        ]
        execution_allocation_fingerprint = (
            operator_execution.sha256_json({
                "standing_policy_contract_id": str(
                    restored.get("contract_id") or ""
                ),
                "stage": int(restored.get("stage") or 0),
                "planner_allocation_fingerprint": str(
                    restored.get("allocation_fingerprint") or ""
                ),
                "subsets": recovered_allocation,
            })
        )
        return {
            "schema_version": (
                "v7.availability-first-restored-target-bound-receipt.v1"
                if restored.get("target_bound_trial")
                else "v7.availability-first-restored-stage-receipt.v1"
            ),
            "transaction_status": "COMPLETED",
            "final_verdict": (
                "AVAILABILITY_FIRST_TARGET_BOUND_TRIAL_COMPLETED"
                if restored.get("target_bound_trial")
                else "AVAILABILITY_FIRST_STANDING_STAGE_COMPLETED"
            ),
            "stop_reason": "",
            "stage": int(restored.get("stage") or 0),
            "target_bound_trial": bool(
                restored.get("target_bound_trial")
            ),
            "target_bound_trial_target": str(
                restored.get("target_bound_trial_target") or ""
            ),
            "campaign_next_stage": int(
                restored.get("campaign_next_stage") or 0
            ),
            "source": str(restored.get("source") or ""),
            "standing_policy_contract_id": str(
                restored.get("contract_id") or ""
            ),
            "standing_policy_contract_hash": str(
                restored.get("contract_hash") or ""
            ),
            "planner_allocation_fingerprint": str(
                restored.get("allocation_fingerprint") or ""
            ),
            "execution_allocation_fingerprint": (
                execution_allocation_fingerprint
            ),
            "allocation": recovered_allocation,
            "packet_set": recovered_packets,
            "packet_set_fingerprint": (
                operator_execution.sha256_json(recovered_packets)
            ),
            "restored_stage_receipt_recovery": restored,
            "baseline_reset_verified": True,
            "baseline_reset_reconciliation": {
                "ok": True,
                "mode": (
                    "POST_CLEARANCE_ROUTE_COMMIT_RECONCILED_"
                    "FROM_EXISTING_OWNERS"
                ),
                "current_egress": str(restored.get("source") or ""),
                "packet_id": str(
                    restored.get("reset_packet_id") or ""
                ),
                "operation_id": str(
                    restored.get("reset_operation_id") or ""
                ),
                "switch_lineage": True,
                "natural_l8_credit": False,
                "production_outcome_credit": False,
            },
            "baseline_reset_reconciliations": (
                restored.get("reset_reconciliations") or []
            ),
            "allocation_immutable": True,
            "capacity_reservation_verified": True,
            "outcome_consumed": True,
            "replay_consumed": True,
            "learning_consumed": True,
            "per_user_verification_passed": True,
            "per_target_verification_passed": True,
            "aggregate_verification_passed": True,
            "ordinary_user_protection_passed": True,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "authority_expanded": False,
            "production_maturity_change": False,
            "natural_l8_credit": False,
            "durable_successor": (
                "EXISTING_MATRIX_RECOMPUTE_AVAILABILITY_FIRST_NEXT_STAGE"
            ),
            "performance_timeline": performance_timeline,
            "stage_total_duration_us": max(
                0, (time.monotonic_ns() - mission_started_ns) // 1_000
            ),
        }
    partial_started_ns = time.monotonic_ns()
    partial = availability_first_partial_apply_recovery_context(
        args,
        state_dir=state_dir,
        event_dir=event_dir,
        lease_file=lease_file,
    )
    record_phase(
        "partial_apply_reconciliation",
        partial_started_ns,
        owner="existing rotated execution audit + route/Outcome owners",
        status="PENDING" if partial.get("pending") else "NO_WORK",
    )
    if partial.get("pending"):
        if not partial.get("ok"):
            return {
                **transaction_stop(
                    "availability_first_partial_apply_recovery_not_admitted",
                    blockers=partial.get("blockers") or [],
                ),
                "partial_apply_recovery": partial,
                "durable_successor": (
                    "EXISTING_MATRIX_FRESH_PARTIAL_APPLY_RECONCILIATION"
                ),
                "performance_timeline": performance_timeline,
            }
        stage = int(partial.get("stage") or 0)
        user = str(partial.get("user") or "")
        target = str(partial.get("target") or "")
        source = str(partial.get("source") or "")
        reset_args = copy.copy(args)
        reset_args._certification_cleanup_request = {
            "user": user,
            "source": target,
            "target": source,
            "campaign_reset": True,
            "controlled_source": source,
            "availability_first_reset": True,
            "availability_first_target": target,
            "availability_first_allocation_fingerprint": str(
                partial.get("allocation_fingerprint") or ""
            ),
        }
        reset_args.skip_planner_observe = True
        reset_args.execute_bounded_delegated_transaction = False
        reset_args.execute_availability_first_standing_stage = False
        reset_args.max_users = 1
        reset_args.approved_source = source
        reset_args.availability_first_target = target
        reset_args.expected_standing_policy_contract_id = str(
            partial.get("contract_id") or ""
        )
        reset_args.expected_standing_policy_contract_hash = str(
            partial.get("contract_hash") or ""
        )
        reset_args._availability_first_stage_request = {
            "stage": stage,
            "target_id": target,
            "expected_users": [user],
            "subset_fingerprint": operator_execution.sha256_json({
                "stage": stage,
                "target_id": target,
                "users": [user],
            }),
            "allocation_fingerprint": str(
                partial.get("allocation_fingerprint") or ""
            ),
        }
        reset_args.engineering_authority_request_file = ""
        reset_started_ns = time.monotonic_ns()
        reset = execute_governed_transaction_with_guards(
            reset_args,
            state_dir=state_dir,
            event_dir=event_dir,
            snapshot_root=snapshot_root,
            audit_dir=audit_dir,
            lease_file=lease_file,
        )
        record_phase(
            "reset_transaction",
            reset_started_ns,
            owner="existing governed transaction owner",
            status=str(reset.get("final_verdict") or "UNKNOWN"),
            member=user,
            packet_id=str(reset.get("fresh_packet_id") or ""),
            operation_id=str(reset.get("operation_id") or ""),
        )
        reset_verify_started_ns = time.monotonic_ns()
        reset_truth = availability_first_baseline_reset_truth(
            reset,
            state_dir=state_dir,
            event_dir=event_dir,
            user=user,
            baseline_source=source,
            execution_target=target,
        )
        record_phase(
            "reset_verification",
            reset_verify_started_ns,
            owner="existing route and baseline verification owners",
            status="PASS" if reset_truth.get("ok") else "STOP_SAFE",
            member=user,
        )
        reset_complete = bool(reset_truth.get("ok"))
        forward_evidence = (
            partial.get("forward_evidence")
            if isinstance(partial.get("forward_evidence"), dict)
            else {}
        )
        recovered_stage_complete = bool(
            reset_complete
            and stage == 1
            and str(partial.get("recovery_mode") or "")
            == "VERIFIED_STAGE_BASELINE_PENDING"
            and forward_evidence.get("ok") is True
        )
        recovered_allocation = [
            row
            for row in (partial.get("recovered_allocation") or [])
            if isinstance(row, dict)
        ]
        recovered_packet = {
            "final_verdict": "L3_PRODUCTION_PROVEN",
            "transaction_status": "COMPLETED",
            "fresh_packet_id": str(partial.get("packet_id") or ""),
            "operation_id": str(partial.get("operation_id") or ""),
            "user": user,
            "users": [user],
            "source": source,
            "target": target,
            "target_id": target,
            "users_moved": 1,
            "runtime_mutation_performed": True,
            "verification_result": "PASS",
            "rollback_result": "NOT_REQUIRED",
            "feedback_id": str(
                forward_evidence.get("feedback_id") or ""
            ),
            "outcome_id": str(
                forward_evidence.get("outcome_id") or ""
            ),
            "learning_record_id": str(
                forward_evidence.get("learning_record_id") or ""
            ),
            "recovered_from_existing_owner_truth": True,
        }
        execution_allocation_fingerprint = (
            operator_execution.sha256_json({
                "standing_policy_contract_id": str(
                    partial.get("contract_id") or ""
                ),
                "stage": stage,
                "planner_allocation_fingerprint": str(
                    partial.get("allocation_fingerprint") or ""
                ),
                "subsets": recovered_allocation,
            })
        )
        recovery_depth = int(
            getattr(args, "_availability_first_recovery_depth", 0)
            or 0
        )
        if reset_complete and stage > 1 and recovery_depth < stage:
            successor_args = copy.copy(args)
            successor_args._availability_first_recovery_depth = (
                recovery_depth + 1
            )
            successor_args._availability_first_recovery_only = True
            successor_args._availability_first_allow_lineage_refresh = True
            successor_started_ns = time.monotonic_ns()
            successor = execute_availability_first_standing_stage(
                successor_args,
                state_dir=state_dir,
                event_dir=event_dir,
                snapshot_root=snapshot_root,
                audit_dir=audit_dir,
                lease_file=lease_file,
            )
            record_phase(
                "internal_successor",
                successor_started_ns,
                owner="same Matrix-owned Stage Mission",
                status=str(successor.get("final_verdict") or "UNKNOWN"),
            )
            prior_reconciliations = [
                row
                for row in (
                    successor.get(
                        "serial_baseline_reset_reconciliations"
                    )
                    or []
                )
                if isinstance(row, dict)
            ]
            return {
                **successor,
                "serial_baseline_reset_reconciliations": [
                    {
                        "stage": stage,
                        "user": user,
                        "packet_id": str(
                            partial.get("packet_id") or ""
                        ),
                        "operation_id": str(
                            partial.get("operation_id") or ""
                        ),
                        "reset_transaction": compact_transaction_result(
                            reset
                        ),
                        "baseline_reset_reconciliation": reset_truth,
                    },
                    *prior_reconciliations,
                ],
                "serial_baseline_reset_count": (
                    1
                    + int(
                        successor.get(
                            "serial_baseline_reset_count"
                        )
                        or 0
                    )
                ),
                "performance_timeline": [
                    *performance_timeline,
                    *(
                        successor.get("performance_timeline")
                        if isinstance(
                            successor.get("performance_timeline"), list
                        )
                        else []
                    ),
                ],
                "stage_total_duration_us": max(
                    0, (time.monotonic_ns() - mission_started_ns) // 1_000
                ),
            }
        return {
            "schema_version": (
                "v7.availability-first-partial-apply-reconciliation.v1"
            ),
            "transaction_status": (
                "COMPLETED" if recovered_stage_complete else "STOP_SAFE"
            ),
            "final_verdict": (
                "AVAILABILITY_FIRST_STANDING_STAGE_COMPLETED"
                if recovered_stage_complete
                else "AVAILABILITY_FIRST_PARTIAL_APPLY_BASELINE_RECONCILED"
                if reset_complete
                else "AVAILABILITY_FIRST_STANDING_STAGE_STOPPED"
            ),
            "stop_reason": (
                ""
                if recovered_stage_complete
                else "fresh_retry_required_after_partial_apply_reconciliation"
                if reset_complete
                else "availability_first_partial_apply_recovery_failed"
            ),
            "stage": stage,
            "source": source,
            "standing_policy_contract_id": str(
                partial.get("contract_id") or ""
            ),
            "standing_policy_contract_hash": str(
                partial.get("contract_hash") or ""
            ),
            "planner_allocation_fingerprint": str(
                partial.get("allocation_fingerprint") or ""
            ),
            "execution_allocation_fingerprint": (
                execution_allocation_fingerprint
            ),
            "allocation": recovered_allocation,
            "packet_set": (
                [recovered_packet] if recovered_stage_complete else []
            ),
            "packet_set_fingerprint": (
                operator_execution.sha256_json([recovered_packet])
                if recovered_stage_complete
                else ""
            ),
            "partial_apply_recovery": partial,
            "reset_transaction": compact_transaction_result(reset),
            "baseline_reset_verified": reset_complete,
            "baseline_reset_reconciliation": reset_truth,
            "allocation_immutable": recovered_stage_complete,
            "capacity_reservation_verified": recovered_stage_complete,
            "outcome_consumed": bool(
                recovered_stage_complete
                and forward_evidence.get("outcome_consumed")
            ),
            "replay_consumed": bool(
                recovered_stage_complete
                and forward_evidence.get("replay_consumed")
            ),
            "learning_consumed": bool(
                recovered_stage_complete
                and forward_evidence.get("learning_consumed")
            ),
            "per_user_verification_passed": recovered_stage_complete,
            "per_target_verification_passed": recovered_stage_complete,
            "aggregate_verification_passed": recovered_stage_complete,
            "ordinary_user_protection_passed": recovered_stage_complete,
            "runtime_mutation_performed": bool(
                reset.get("runtime_mutation_performed")
            ),
            "users_moved": int(reset.get("users_moved") or 0),
            "authority_expanded": False,
            "production_maturity_change": False,
            "natural_l8_credit": False,
            "durable_successor": (
                "EXISTING_MATRIX_RECOMPUTE_AVAILABILITY_FIRST_NEXT_STAGE"
                if recovered_stage_complete
                else "EXISTING_MATRIX_FRESH_REVALIDATION_AFTER_COOLDOWN"
                if reset_complete
                else "EXISTING_MATRIX_FRESH_PARTIAL_APPLY_RECONCILIATION"
            ),
            "performance_timeline": performance_timeline,
            "stage_total_duration_us": max(
                0, (time.monotonic_ns() - mission_started_ns) // 1_000
            ),
        }
    if bool(
        getattr(args, "_availability_first_recovery_only", False)
    ):
        if bool(
            getattr(
                args,
                "_availability_first_allow_lineage_refresh",
                False,
            )
        ):
            refresh_args = copy.copy(args)
            refresh_args._availability_first_allow_lineage_refresh = False
            refresh_count = int(
                getattr(
                    args,
                    "_availability_first_lineage_refresh_count",
                    0,
                )
                or 0
            )
            refresh_args._availability_first_lineage_refresh_count = (
                refresh_count + 1
            )
            for cache_name in (
                "_live_runtime_lineage_records",
                "_availability_first_recovery_forward_audit_records",
                "_availability_first_recovery_forward_projection_rows",
            ):
                if hasattr(refresh_args, cache_name):
                    delattr(refresh_args, cache_name)
            refresh_started_ns = time.monotonic_ns()
            refreshed = execute_availability_first_standing_stage(
                refresh_args,
                state_dir=state_dir,
                event_dir=event_dir,
                snapshot_root=snapshot_root,
                audit_dir=audit_dir,
                lease_file=lease_file,
            )
            record_phase(
                "allocation_lineage_refresh_successor",
                refresh_started_ns,
                owner="existing bounded rotated execution lineage owner",
                status=str(
                    refreshed.get("final_verdict") or "UNKNOWN"
                ),
            )
            return {
                **refreshed,
                "allocation_lineage_refresh_count": (
                    refresh_count
                    + 1
                    + int(
                        refreshed.get(
                            "allocation_lineage_refresh_count"
                        )
                        or 0
                    )
                ),
                "performance_timeline": [
                    *performance_timeline,
                    *(
                        refreshed.get("performance_timeline")
                        if isinstance(
                            refreshed.get("performance_timeline"), list
                        )
                        else []
                    ),
                ],
                "stage_total_duration_us": max(
                    0,
                    (time.monotonic_ns() - mission_started_ns) // 1_000,
                ),
            }
        return {
            **transaction_stop(
                "availability_first_recovery_lineage_not_ready",
                blockers=[
                    "availability_first_recovery_requires_exact_"
                    "pending_or_restored_cohort"
                ],
            ),
            "durable_successor": (
                "EXISTING_MATRIX_FRESH_PARTIAL_APPLY_RECONCILIATION"
            ),
            "performance_timeline": performance_timeline,
        }
    planner_started_ns = time.monotonic_ns()
    planner = _availability_first_topology_diagnostic(
        args,
        state_dir=state_dir,
    )
    record_phase(
        "planner_and_allocation",
        planner_started_ns,
        owner="existing topology/Planner consumer",
        status=str(planner.get("status") or "UNKNOWN"),
    )
    diagnostic = (
        planner.get("diagnostic")
        if isinstance(planner.get("diagnostic"), dict)
        else {}
    )
    admission = (
        diagnostic.get("availability_first_standing_policy_admission")
        if isinstance(
            diagnostic.get("availability_first_standing_policy_admission"),
            dict,
        )
        else {}
    )
    projection = (
        diagnostic.get("shared_production_target_capacity_projection")
        if isinstance(
            diagnostic.get("shared_production_target_capacity_projection"),
            dict,
        )
        else {}
    )
    campaign = (
        projection.get("availability_campaign")
        if isinstance(projection.get("availability_campaign"), dict)
        else {}
    )
    target_bound_trial_target = str(
        getattr(
            args,
            "availability_first_target_bound_trial_target",
            "",
        )
        or ""
    )
    target_bound_trial = (
        projection.get("target_growth_trial")
        if isinstance(projection.get("target_growth_trial"), dict)
        else {}
    )
    target_bound_mode = bool(target_bound_trial_target)
    # The shared capacity projection is the live owner of the executable
    # stage.  The nested campaign row is progress history and can lag one
    # consumed stage during atomic successor publication.  A supplied Matrix
    # stage must therefore be compared to the canonical current_stage, not to
    # the historical row, or a valid Stage-N+1 dispatch is rejected as stale.
    current_stage = int(
        projection.get("current_stage")
        or campaign.get("next_stage")
        or 0
    )
    stage = int(
        getattr(args, "availability_first_stage", 0)
        or current_stage
        or 0
    )
    allocation = (
        target_bound_trial
        if target_bound_mode
        else (
            (projection.get("stage_allocations") or {}).get(str(stage), {})
            if isinstance(projection.get("stage_allocations"), dict)
            else {}
        )
    )
    allocation_rows = [
        row
        for row in (
            allocation.get("immutable_allocation_projection") or []
        )
        if isinstance(row, dict)
    ]
    expected_fingerprint = str(
        getattr(
            args,
            "expected_availability_first_allocation_fingerprint",
            "",
        )
        or ""
    )
    blockers = list(planner.get("blockers") or [])
    if (
        not target_bound_mode
        and diagnostic.get("status")
        != "CONTROLLED_TOPOLOGY_AVAILABILITY_FIRST_AUTO_ADMITTED"
    ):
        blockers.append("availability_first_topology_not_auto_admitted")
    if admission.get("ok") is not True:
        blockers.extend(admission.get("blockers") or [])
    if stage not in operator_execution.AVAILABILITY_FIRST_LADDER:
        blockers.append("availability_first_stage_not_in_ladder")
    if (
        not target_bound_mode
        and current_stage != stage
    ):
        blockers.append("availability_first_stage_not_current")
    if target_bound_mode and (
        target_bound_trial.get("status") != "TARGET_BOUND_TRIAL_READY"
        or target_bound_trial.get("feasible") is not True
        or str(target_bound_trial.get("target_id") or "")
        != target_bound_trial_target
        or int(target_bound_trial.get("trial_scope") or 0) != stage
        or int(target_bound_trial.get("campaign_next_stage") or 0)
        != int(campaign.get("next_stage") or 0)
    ):
        blockers.append(
            "availability_first_target_bound_trial_not_current"
        )
    if not allocation.get("feasible") or not allocation_rows:
        blockers.append("availability_first_exact_allocation_not_feasible")
    allocation_fingerprint = str(
        allocation.get("allocation_fingerprint") or ""
    )
    if (
        expected_fingerprint
        and expected_fingerprint != allocation_fingerprint
    ):
        blockers.append("availability_first_allocation_changed")
    if sum(
        int(row.get("allocated_users") or 0)
        for row in allocation_rows
    ) != stage:
        blockers.append("availability_first_allocation_scope_mismatch")
    source_value = (
        (
            diagnostic.get(
                "CONTROLLED_CERTIFICATION_CAMPAIGN_TOPOLOGY_PLAN"
            )
            or {}
        ).get("controlled_source")
        or ""
    )
    source = str(
        source_value.get("source_id")
        if isinstance(source_value, dict)
        else source_value
    )
    current_campaign = (
        diagnostic.get("current_campaign")
        if isinstance(diagnostic.get("current_campaign"), dict)
        else {}
    )
    campaign_identity_accounting = (
        diagnostic.get("campaign_identity_accounting")
        if isinstance(diagnostic.get("campaign_identity_accounting"), dict)
        else {}
    )
    if campaign_identity_accounting.get("status") != "ACCOUNTED":
        blockers.append("availability_first_campaign_identity_accounting_not_accounted")
    if not source:
        blockers.append("availability_first_controlled_source_missing")
    users = [
        row
        for row in read_registry(state_dir / "users.registry")
        if str(row.get("enabled") or "1").lower()
        in {"1", "true", "yes"}
        and str(row.get("certification_user") or "").lower()
        in {"1", "true", "yes"}
        and str(row.get("current") or "") == source
    ]
    users = sorted(users, key=lambda row: str(row.get("ip") or ""))
    if len(users) < stage:
        blockers.append("availability_first_source_cohort_too_small")
    selected_users = [
        str(row.get("ip") or "") for row in users[:stage]
    ]
    if any(not user for user in selected_users):
        blockers.append("availability_first_certification_identity_missing")
    ordinary_before = _availability_first_ordinary_assignment_projection(
        state_dir
    )
    if blockers:
        return {
            **transaction_stop(
                "availability_first_standing_stage_not_admitted",
                blockers=sorted(set(str(item) for item in blockers)),
            ),
            "stage": stage,
            "allocation_fingerprint": allocation_fingerprint,
            "planner": planner,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "performance_timeline": performance_timeline,
            "stage_total_duration_us": max(
                0, (time.monotonic_ns() - mission_started_ns) // 1_000
            ),
        }

    offset = 0
    packet_set: list[dict[str, Any]] = []
    moved_users: list[str] = []
    execution_allocation: list[dict[str, Any]] = []
    circuit_breaker = {
        "tripped": False,
        "remaining_subsets_stopped": False,
        "reason": "NONE",
    }
    for row in allocation_rows:
        target = str(row.get("target_id") or "")
        count = int(row.get("allocated_users") or 0)
        subset = selected_users[offset:offset + count]
        offset += count
        subset_fingerprint = operator_execution.sha256_json({
            "stage": stage,
            "target_id": target,
            "users": subset,
        })
        execution_allocation.append({
            "target_id": target,
            "allocated_users": count,
            "subset_fingerprint": subset_fingerprint,
            "capacity_reservation": int(
                row.get("capacity_reservation") or count
            ),
            "capacity_bounds_fingerprint": str(
                row.get("capacity_bounds_fingerprint") or ""
            ),
            "target_fingerprint": str(
                row.get("target_fingerprint") or ""
            ),
        })
        subset_failed = False
        # Reuse the existing cohort-capable L3 execution primitive.  The
        # standing contract already bounds max users per transaction and keeps
        # max concurrency=1; the canonical Packet contains per-user rollback
        # items and the child verifier returns one result per user.  Running a
        # complete Planner/Packet/apply lifecycle once per member added no
        # safety and multiplied Stage-25 latency.  One fresh Packet per exact
        # immutable allocation subset preserves every live gate without
        # expanding Authority.
        transaction_args = copy.copy(args)
        transaction_args.execute_bounded_delegated_transaction = True
        transaction_args.execute_availability_first_standing_stage = True
        transaction_args.max_users = len(subset)
        transaction_args.approved_source = source
        transaction_args.availability_first_target = target
        transaction_args.expected_standing_policy_contract_id = str(
            admission.get("contract_id") or ""
        )
        transaction_args.expected_standing_policy_contract_hash = str(
            admission.get("contract_hash") or ""
        )
        transaction_args.controlled_certification_campaign_request_id = str(
            current_campaign.get("request_id") or ""
        )
        transaction_args.controlled_certification_campaign_request_hash = str(
            current_campaign.get("request_hash") or ""
        )
        transaction_args.controlled_certification_campaign_stage = 0
        transaction_args._availability_first_stage_request = {
            "stage": stage,
            "target_id": target,
            "expected_users": list(subset),
            "subset_fingerprint": subset_fingerprint,
            "allocation_fingerprint": allocation_fingerprint,
            "inventory_fingerprint": str(
                projection.get("inventory_fingerprint")
                or diagnostic.get("inventory_fingerprint")
                or ""
            ),
        }
        transaction_started_ns = time.monotonic_ns()
        transaction = execute_governed_transaction_with_guards(
            transaction_args,
            state_dir=state_dir,
            event_dir=event_dir,
            snapshot_root=snapshot_root,
            audit_dir=audit_dir,
            lease_file=lease_file,
        )
        compact = compact_transaction_result(transaction)
        record_phase(
            "cohort_governed_transaction",
            transaction_started_ns,
            owner="existing Candidate/Packet/lease/apply/verification owner",
            status=str(transaction.get("final_verdict") or "UNKNOWN"),
            cohort_size=len(subset),
            subset_fingerprint=subset_fingerprint,
            packet_id=str(compact.get("fresh_packet_id") or ""),
            operation_id=str(compact.get("operation_id") or ""),
        )
        passed = (
            transaction.get("final_verdict")
            in {
                "GOVERNED_TRANSACTION_COMPLETED",
                "L3_PRODUCTION_PROVEN",
            }
            and str(transaction.get("verification_result") or "") == "PASS"
            and int(transaction.get("users_moved") or 0) == len(subset)
        )
        for user in subset:
            evidence_started_ns = time.monotonic_ns()
            evidence = availability_first_forward_evidence_status(
                state_dir,
                packet_id=str(compact.get("fresh_packet_id") or ""),
                operation_id=str(compact.get("operation_id") or ""),
                user=user,
                source=source,
                target=target,
            )
            record_phase(
                "member_outcome_replay_learning",
                evidence_started_ns,
                owner="existing Outcome/Replay/Learning owners",
                status="PASS" if evidence.get("ok") else "STOP_SAFE",
                member=user,
                packet_id=str(compact.get("fresh_packet_id") or ""),
                operation_id=str(compact.get("operation_id") or ""),
            )
            packet_set.append({
                **compact,
                "target_id": target,
                "subset_fingerprint": subset_fingerprint,
                "cohort_packet": True,
                "cohort_size": len(subset),
                "cohort_member": user,
                "feedback_id": str(evidence.get("feedback_id") or ""),
                "outcome_id": str(evidence.get("outcome_id") or ""),
                "learning_record_id": str(
                    evidence.get("learning_record_id") or ""
                ),
                "outcome_consumed": bool(
                    evidence.get("outcome_consumed")
                ),
                "replay_consumed": bool(
                    evidence.get("replay_consumed")
                ),
                "learning_consumed": bool(
                    evidence.get("learning_consumed")
                ),
                "evidence_blockers": list(
                    evidence.get("blockers") or []
                ),
            })
            if passed and evidence.get("ok"):
                moved_users.append(user)
        if not passed or any(
            not bool(row.get("outcome_consumed"))
            or not bool(row.get("replay_consumed"))
            or not bool(row.get("learning_consumed"))
            for row in packet_set[-len(subset):]
        ):
            if transaction.get("runtime_mutation_performed"):
                current_routes = {
                    str(item.get("ip") or ""): str(item.get("current") or "")
                    for item in read_registry(state_dir / "users.registry")
                }
                for user in subset:
                    if current_routes.get(user) == target and user not in moved_users:
                        moved_users.append(user)
            circuit_breaker = {
                "tripped": True,
                "remaining_subsets_stopped": True,
                "reason": str(
                    transaction.get("stop_reason")
                    or transaction.get("final_verdict")
                    or "availability_first_subset_failed"
                ),
            }
            subset_failed = True
        if subset_failed:
            break

    ordinary_after_apply = (
        _availability_first_ordinary_assignment_projection(state_dir)
    )
    ordinary_unchanged = (
        ordinary_after_apply == ordinary_before
    )
    post_apply_started_ns = time.monotonic_ns()
    post_apply_planner = _availability_first_topology_diagnostic(
        args,
        state_dir=state_dir,
    )
    record_phase(
        "aggregate_target_verification",
        post_apply_started_ns,
        owner="existing topology/quality/capacity owners",
        status=str(post_apply_planner.get("status") or "UNKNOWN"),
    )
    post_apply_diagnostic = (
        post_apply_planner.get("diagnostic")
        if isinstance(post_apply_planner.get("diagnostic"), dict)
        else {}
    )
    post_apply_campaign_identity_accounting = (
        post_apply_diagnostic.get("campaign_identity_accounting")
        if isinstance(post_apply_diagnostic.get("campaign_identity_accounting"), dict)
        else {}
    )
    post_apply_targets = {
        str(row.get("target_id") or ""): row
        for row in (
            (
                post_apply_diagnostic.get(
                    "shared_production_target_capacity_projection"
                )
                or {}
            ).get("targets")
            or post_apply_diagnostic.get("targets")
            or []
        )
        if isinstance(row, dict) and str(row.get("target_id") or "")
    }
    target_verification = []
    for item in execution_allocation:
        target_id = str(item.get("target_id") or "")
        target_row = post_apply_targets.get(target_id) or {}
        availability = (
            target_row.get("shared_target_availability")
            if isinstance(
                target_row.get("shared_target_availability"),
                dict,
            )
            else {}
        )
        quality = (
            target_row.get("quality")
            if isinstance(target_row.get("quality"), dict)
            else {}
        )
        passed = bool(
            target_row
            and availability.get("state")
            in {"HEALTHY", "DEGRADED_USABLE", "LAST_RESORT_USABLE"}
            and quality.get("fresh") is True
            and not availability.get("hard_reasons")
        )
        target_verification.append({
            "target_id": target_id,
            "passed": passed,
            "availability_classification": str(
                availability.get("state") or ""
            ),
            "quality_fingerprint": operator_execution.sha256_json(
                quality
            ),
            "capacity_fingerprint": operator_execution.sha256_json(
                target_row.get("capacity") or {}
            ),
        })
    target_verification_passed = bool(
        target_verification
        and all(row.get("passed") for row in target_verification)
    )
    if not ordinary_unchanged:
        circuit_breaker = {
            "tripped": True,
            "remaining_subsets_stopped": True,
            "reason": "ordinary_assignment_fingerprint_changed",
        }
    if post_apply_campaign_identity_accounting.get("status") != "ACCOUNTED":
        circuit_breaker = {
            "tripped": True,
            "remaining_subsets_stopped": True,
            "reason": "availability_first_campaign_identity_accounting_not_accounted_after_apply",
        }

    reset_transactions: list[dict[str, Any]] = []
    reset_reconciliations: list[dict[str, Any]] = []
    reset_ok = len(moved_users) == stage
    if moved_users:
        current_rows = {
            str(row.get("ip") or ""): row
            for row in read_registry(state_dir / "users.registry")
        }
        for user in reversed(moved_users):
            current_target = str(
                (current_rows.get(user) or {}).get("current") or ""
            )
            if not current_target or current_target == source:
                continue
            reset_args = copy.copy(args)
            reset_args._certification_cleanup_request = {
                "user": user,
                "source": current_target,
                "target": source,
                "campaign_reset": True,
                "controlled_source": source,
                "availability_first_reset": True,
                "availability_first_target": current_target,
            }
            reset_args.skip_planner_observe = True
            reset_args.execute_bounded_delegated_transaction = False
            reset_args.execute_availability_first_standing_stage = False
            reset_args.max_users = 1
            reset_args.approved_source = source
            reset_args.availability_first_target = current_target
            reset_args.expected_standing_policy_contract_id = str(
                admission.get("contract_id") or ""
            )
            reset_args.expected_standing_policy_contract_hash = str(
                admission.get("contract_hash") or ""
            )
            reset_args._availability_first_stage_request = {
                "stage": stage,
                "target_id": current_target,
                "expected_users": [user],
                "subset_fingerprint": operator_execution.sha256_json({
                    "stage": stage,
                    "target_id": current_target,
                    "users": [user],
                }),
                "allocation_fingerprint": allocation_fingerprint,
            }
            reset_args.engineering_authority_request_file = ""
            reset_started_ns = time.monotonic_ns()
            reset = execute_governed_transaction_with_guards(
                reset_args,
                state_dir=state_dir,
                event_dir=event_dir,
                snapshot_root=snapshot_root,
                audit_dir=audit_dir,
                lease_file=lease_file,
            )
            record_phase(
                "member_reset_transaction",
                reset_started_ns,
                owner="existing governed reset owner",
                status=str(reset.get("final_verdict") or "UNKNOWN"),
                member=user,
                packet_id=str(reset.get("fresh_packet_id") or ""),
                operation_id=str(reset.get("operation_id") or ""),
            )
            reset_transactions.append(compact_transaction_result(reset))
            reset_verify_started_ns = time.monotonic_ns()
            reset_truth = availability_first_baseline_reset_truth(
                reset,
                state_dir=state_dir,
                event_dir=event_dir,
                user=user,
                baseline_source=source,
                execution_target=current_target,
            )
            record_phase(
                "member_reset_verification",
                reset_verify_started_ns,
                owner="existing route and baseline verification owners",
                status="PASS" if reset_truth.get("ok") else "STOP_SAFE",
                member=user,
            )
            reset_reconciliations.append(reset_truth)
            if not reset_truth.get("ok"):
                reset_ok = False
                circuit_breaker = {
                    "tripped": True,
                    "remaining_subsets_stopped": True,
                    "reason": "availability_first_baseline_reset_failed",
                }
                break
        after_reset = {
            str(row.get("ip") or ""): str(row.get("current") or "")
            for row in read_registry(state_dir / "users.registry")
        }
        reset_ok = reset_ok and all(
            after_reset.get(user) == source for user in moved_users
        )

    ordinary_final = _availability_first_ordinary_assignment_projection(
        state_dir
    )
    ordinary_final_unchanged = ordinary_final == ordinary_before
    complete = bool(
        len(moved_users) == stage
        and len(packet_set) == stage
        and not circuit_breaker["tripped"]
        and ordinary_unchanged
        and target_verification_passed
        and ordinary_final_unchanged
        and reset_ok
    )
    execution_allocation_fingerprint = operator_execution.sha256_json({
        "standing_policy_contract_id": admission.get("contract_id"),
        "stage": stage,
        "planner_allocation_fingerprint": allocation_fingerprint,
        "subsets": execution_allocation,
    })
    outcome_consumed = bool(
        packet_set
        and all(
            row.get("outcome_consumed") is True
            for row in packet_set
        )
    )
    replay_consumed = bool(
        packet_set
        and all(
            row.get("replay_consumed") is True
            for row in packet_set
        )
    )
    learning_consumed = bool(
        packet_set
        and all(
            row.get("learning_consumed") is True
            for row in packet_set
        )
    )
    evidence_complete = (
        outcome_consumed and replay_consumed and learning_consumed
    )
    complete = complete and evidence_complete
    return {
        "schema_version": (
            "v7.availability-first-target-bound-trial-result.v1"
            if target_bound_mode
            else "v7.availability-first-standing-stage.v1"
        ),
        "transaction_status": "COMPLETED" if complete else "STOP_SAFE",
        "final_verdict": (
            "AVAILABILITY_FIRST_TARGET_BOUND_TRIAL_COMPLETED"
            if complete and target_bound_mode
            else "AVAILABILITY_FIRST_STANDING_STAGE_COMPLETED"
            if complete
            else "AVAILABILITY_FIRST_STANDING_STAGE_STOPPED"
        ),
        "stage": stage,
        "target_bound_trial": target_bound_mode,
        "target_bound_trial_target": target_bound_trial_target,
        "campaign_next_stage": int(campaign.get("next_stage") or 0),
        "source": source,
        "standing_policy_contract_id": str(
            admission.get("contract_id") or ""
        ),
        "standing_policy_contract_hash": str(
            admission.get("contract_hash") or ""
        ),
        "planner_allocation_fingerprint": allocation_fingerprint,
        "execution_allocation_fingerprint": (
            execution_allocation_fingerprint
        ),
        "inventory_fingerprint": str(
            diagnostic.get("inventory_fingerprint") or ""
        ),
        "campaign_identity_accounting_before": campaign_identity_accounting,
        "campaign_identity_accounting_after": (
            post_apply_campaign_identity_accounting
        ),
        "allocation": execution_allocation,
        "packet_set": packet_set,
        "packet_set_fingerprint": operator_execution.sha256_json(packet_set),
        "users_moved": len(moved_users),
        "runtime_mutation_performed": bool(moved_users),
        "per_user_verification_passed": complete,
        "per_target_verification_passed": target_verification_passed,
        "aggregate_verification_passed": complete,
        "ordinary_user_protection_passed": (
            ordinary_unchanged and ordinary_final_unchanged
        ),
        "capacity_reservation_verified": bool(
            complete
            and all(
                row.get("capacity_reservation")
                == row.get("allocated_users")
                for row in execution_allocation
            )
        ),
        "allocation_immutable": bool(
            allocation_fingerprint
            and expected_fingerprint in {"", allocation_fingerprint}
        ),
        "outcome_consumed": outcome_consumed,
        "replay_consumed": replay_consumed,
        "learning_consumed": learning_consumed,
        "baseline_reset_verified": reset_ok,
        "reset_transactions": reset_transactions,
        "baseline_reset_reconciliations": reset_reconciliations,
        "ordinary_assignment_before": ordinary_before,
        "ordinary_assignment_after_apply": ordinary_after_apply,
        "ordinary_assignment_final": ordinary_final,
        "target_verification": target_verification,
        "circuit_breaker": circuit_breaker,
        "final_safe_mode": "OPEN",
        "authority_expanded": False,
        "production_maturity_change": False,
        "natural_l8_credit": False,
        "durable_successor": (
            "EXISTING_MATRIX_RECOMPUTE_AVAILABILITY_FIRST_TARGET_BOUND"
            if complete and target_bound_mode
            else "EXISTING_MATRIX_RECOMPUTE_AVAILABILITY_FIRST_NEXT_STAGE"
            if complete
            else "EXISTING_MATRIX_FRESH_REVALIDATION_AFTER_EXACT_STOP_SAFE"
        ),
        "performance_timeline": performance_timeline,
        "stage_total_duration_us": max(
            0, (time.monotonic_ns() - mission_started_ns) // 1_000
        ),
    }


def prepare_controlled_certification_condition(
    args: argparse.Namespace,
    *,
    state_dir: Path,
    event_dir: Path,
    snapshot_root: Path,
    audit_dir: Path,
    lease_file: Path,
) -> dict[str, Any]:
    if args.confirm_controlled_certification_condition != "PREPARE_CONTROLLED_CERTIFICATION_CONDITION_APPROVED":
        return transaction_stop("controlled_certification_condition_confirmation_required")
    if int(args.max_users) != 1:
        return transaction_stop("controlled_certification_condition_max_users_must_be_one")
    transaction_args = copy.copy(args)
    transaction_args._certification_setup_request = {
        "user": str(args.certification_user or ""),
        "source": str(args.certification_source or ""),
    }
    transaction_args.skip_planner_observe = True
    transaction_args.execute_bounded_delegated_transaction = False
    transaction = execute_governed_transaction_with_guards(
        transaction_args,
        state_dir=state_dir,
        event_dir=event_dir,
        snapshot_root=snapshot_root,
        audit_dir=audit_dir,
        lease_file=lease_file,
    )
    if transaction.get("final_verdict") != "GOVERNED_TRANSACTION_COMPLETED" or transaction.get("verification_result") != "PASS":
        return {
            **transaction_stop("controlled_certification_setup_transaction_failed"),
            "setup_transaction": transaction,
        }
    marker_command = [
        "v7-egress-set-state", str(args.certification_source), "certification-scope",
        "--certification-users", str(args.certification_user),
        "--certification-group", "polygon-l7-canary", "--apply",
    ]
    marker = subprocess.run(marker_command, text=True, capture_output=True, timeout=180, check=False)
    route = scoped_user_route_check(state_dir, str(args.certification_user))
    passed = marker.returncode == 0 and route.get("passed")
    return {
        "schema_version": "v7.controlled-certification-condition-preparation.v1",
        "final_verdict": "CONTROLLED_CERTIFICATION_CONDITION_PREPARED" if passed else "STOP_SAFE",
        "setup_transaction": transaction,
        "marker_owner": "v7-egress-set-state certification-scope",
        "marker_returncode": marker.returncode,
        "marker_output": marker.stdout[-3000:],
        "route_verification": route,
        "certification_user": str(args.certification_user),
        "controlled_source": str(args.certification_source),
        "evidence_class": "ENGINEERING_SETUP_NOT_L7_EVIDENCE",
        "ordinary_customer_used": False,
        "users_moved": 1,
        "runtime_mutation_performed": True,
        "authority_expanded_beyond_exact_setup": False,
        "daemon_or_timer_enabled": False,
    }


def cleanup_controlled_certification_condition(
    args: argparse.Namespace,
    *,
    state_dir: Path,
    event_dir: Path,
    snapshot_root: Path,
    audit_dir: Path,
    lease_file: Path,
) -> dict[str, Any]:
    if args.confirm_controlled_certification_cleanup != "CLEANUP_CONTROLLED_CERTIFICATION_CONDITION_APPROVED":
        return transaction_stop("controlled_certification_cleanup_confirmation_required")
    request = read_json(Path(args.engineering_authority_request_file), {})
    validation = operator_execution.validate_engineering_authority_request(
        request,
        decision=str(args.engineering_authority_decision or ""),
        expected_request_id=str(args.engineering_authority_request_id or ""),
        expected_contract_hash=str(args.engineering_authority_contract_hash or ""),
    )
    if not validation.get("ok"):
        return transaction_stop("controlled_certification_cleanup_request_invalid", validation=validation)
    records = operator_execution.read_audit_records(audit_dir / "operator-execution-audit.jsonl")
    if not operator_execution.engineering_authority_replay_seen(records, validation.get("request_id")):
        return transaction_stop("controlled_certification_cleanup_before_authority_consumption")
    subject = request.get("subject") if isinstance(request.get("subject"), dict) else {}
    scope = request.get("scope") if isinstance(request.get("scope"), dict) else {}
    transaction_args = copy.copy(args)
    transaction_args._certification_cleanup_request = {
        "user": str(subject.get("user_ip") or ""),
        "source": str(scope.get("source_egress") or ""),
        "target": str(subject.get("initial_egress") or ""),
    }
    transaction_args.skip_planner_observe = True
    transaction_args.execute_bounded_delegated_transaction = False
    transaction_args.engineering_authority_request_file = ""
    transaction = execute_governed_transaction_with_guards(
        transaction_args,
        state_dir=state_dir,
        event_dir=event_dir,
        snapshot_root=snapshot_root,
        audit_dir=audit_dir,
        lease_file=lease_file,
    )
    passed = transaction.get("final_verdict") == "GOVERNED_TRANSACTION_COMPLETED" and transaction.get("verification_result") == "PASS"
    return {
        "schema_version": "v7.controlled-certification-condition-cleanup.v1",
        "final_verdict": "CONTROLLED_CERTIFICATION_CLEANUP_COMPLETE" if passed else "STOP_SAFE",
        "cleanup_transaction": transaction,
        "certification_user": str(subject.get("user_ip") or ""),
        "controlled_source": str(scope.get("source_egress") or ""),
        "restored_initial_egress": str(subject.get("initial_egress") or ""),
        "evidence_class": "ENGINEERING_CLEANUP_NOT_L7_EVIDENCE",
        "users_moved": 1 if passed else 0,
        "authority_expanded": False,
    }


def reset_approved_controlled_certification_campaign_stage(
    args: argparse.Namespace,
    *,
    state_dir: Path,
    event_dir: Path,
    snapshot_root: Path,
    audit_dir: Path,
    lease_file: Path,
) -> dict[str, Any]:
    """Restore one completed campaign cohort through existing packet owners."""
    if (
        args.confirm_controlled_certification_campaign_reset
        != "RESET_APPROVED_CONTROLLED_CERTIFICATION_CAMPAIGN_STAGE"
    ):
        return transaction_stop(
            "controlled_certification_campaign_reset_confirmation_required"
        )
    binding = approved_controlled_certification_substrate_binding(
        audit_store=Path(args.operator_execution_audit_store),
        request_id=str(
            args.controlled_certification_campaign_request_id or ""
        ),
        request_hash=str(
            args.controlled_certification_campaign_request_hash or ""
        ),
        required_subscopes={
            "CONTROLLED_SOURCE_CONDITION",
            "PROGRESSIVE_CAMPAIGN_EXECUTION",
        },
    )
    scope = (
        binding.get("scope")
        if isinstance(binding.get("scope"), dict)
        else {}
    )
    stage = int(args.controlled_certification_campaign_stage or 0)
    blockers = list(binding.get("blockers") or [])
    if stage not in {
        int(item) for item in (scope.get("campaign_stages") or [])
    }:
        blockers.append("campaign_reset_stage_not_approved")
    if int(scope.get("max_concurrent_transactions") or 0) != 1:
        blockers.append("campaign_reset_concurrency_not_one")
    source = str(scope.get("source_id") or "")
    target = str(scope.get("controlled_target_id") or "")
    users = read_registry(state_dir / "users.registry")
    target_users = [
        row
        for row in users
        if str(row.get("current") or "") == target
        and str(row.get("enabled") or "1").lower()
        in {"1", "true", "yes"}
    ]
    ordinary = [
        row
        for row in target_users
        if str(row.get("certification_user") or "").lower()
        not in {"1", "true", "yes"}
    ]
    if ordinary:
        blockers.append("campaign_reset_target_contains_ordinary_user")
    if len(target_users) != stage:
        blockers.append("campaign_reset_target_cohort_size_mismatch")
    if blockers:
        return transaction_stop(
            "controlled_certification_campaign_reset_not_admitted",
            blockers=sorted(set(blockers)),
            campaign_stage=stage,
            target_user_count=len(target_users),
            ordinary_user_count=len(ordinary),
            controlled_campaign_binding=binding,
        )

    transactions: list[dict[str, Any]] = []
    for row in sorted(
        target_users,
        key=lambda item: str(item.get("ip") or ""),
    ):
        transaction_args = copy.copy(args)
        transaction_args._certification_cleanup_request = {
            "user": str(row.get("ip") or ""),
            "source": target,
            "target": source,
            "campaign_reset": True,
            "controlled_source": source,
        }
        transaction_args.skip_planner_observe = True
        transaction_args.execute_bounded_delegated_transaction = False
        transaction_args.engineering_authority_request_file = ""
        transaction = execute_governed_transaction_with_guards(
            transaction_args,
            state_dir=state_dir,
            event_dir=event_dir,
            snapshot_root=snapshot_root,
            audit_dir=audit_dir,
            lease_file=lease_file,
        )
        transactions.append(compact_transaction_result(transaction))
        if (
            transaction.get("final_verdict")
            != "GOVERNED_TRANSACTION_COMPLETED"
            or transaction.get("verification_result") != "PASS"
        ):
            return {
                **transaction_stop(
                    "controlled_certification_campaign_reset_transaction_failed"
                ),
                "campaign_stage": stage,
                "completed_reset_members": len(transactions) - 1,
                "transactions": transactions,
                "circuit_breaker": {
                    "tripped": True,
                    "remaining_forward_mutations_stopped": True,
                },
            }

    after = read_registry(state_dir / "users.registry")
    remaining_target = [
        row
        for row in after
        if str(row.get("current") or "") == target
        and str(row.get("enabled") or "1").lower()
        in {"1", "true", "yes"}
    ]
    restored = [
        row
        for row in after
        if str(row.get("current") or "") == source
        and str(row.get("enabled") or "1").lower()
        in {"1", "true", "yes"}
        and str(row.get("certification_user") or "").lower()
        in {"1", "true", "yes"}
    ]
    passed = not remaining_target and len(transactions) == stage
    return {
        "schema_version": "v7.controlled-certification-campaign-reset.v1",
        "final_verdict": (
            "CONTROLLED_CERTIFICATION_CAMPAIGN_STAGE_RESET_COMPLETE"
            if passed
            else "STOP_SAFE"
        ),
        "campaign_stage": stage,
        "source": source,
        "target": target,
        "reset_member_count": len(transactions),
        "restored_certification_user_count": len(restored),
        "target_user_count_after": len(remaining_target),
        "transactions": transactions,
        "circuit_breaker": {
            "tripped": not passed,
            "remaining_forward_mutations_stopped": not passed,
        },
        "final_safe_mode": "OPEN",
        "ordinary_customer_count": 0,
        "raw_identity_list_stored": False,
        "runtime_mutation_performed": passed,
        "routing_mutation_performed": passed,
        "users_moved": len(transactions) if passed else 0,
        "authority_expanded": False,
        "production_maturity_change": False,
        "errors": [] if passed else [
            "controlled_certification_campaign_reset_postcondition_failed"
        ],
    }


def execute_governed_transaction_with_guards(
    args: argparse.Namespace,
    *,
    state_dir: Path,
    event_dir: Path,
    snapshot_root: Path,
    audit_dir: Path,
    lease_file: Path,
    required_a4_candidate_keys: set[tuple[str, str]] | None = None,
    blocked_transaction_identities: set[tuple[str, str, str, str]] | None = None,
) -> dict[str, Any]:
    control_file = Path(getattr(args, "execution_control_file", operator_execution.DEFAULT_AUTONOMOUS_EXECUTION_CONTROL_FILE))
    result: dict[str, Any] = {}
    try:
        args._controlled_window_generation = ""
        args._controlled_window_operation_id = ""
        initial_state = operator_execution.autonomous_execution_control_state(control_file)
        if not initial_state.get("valid") or initial_state.get("state") != "OPEN":
            recovery = operator_execution.finalize_autonomous_execution_control_window(
                control_file,
                actor="governed-execution-recovery",
                reason="stale_or_invalid_controlled_window_recovered_before_fresh_run",
                force_fail_closed_open=True,
            )
            result = transaction_stop(
                "stale_or_invalid_controlled_window_recovered_open",
                controlled_window_recovery=recovery,
            )
            return result
        result = _execute_governed_transaction_with_guards_inner(
            args,
            state_dir=state_dir,
            event_dir=event_dir,
            snapshot_root=snapshot_root,
            audit_dir=audit_dir,
            lease_file=lease_file,
            required_a4_candidate_keys=required_a4_candidate_keys,
            blocked_transaction_identities=blocked_transaction_identities,
        )
        return result
    except (Exception, KeyboardInterrupt) as exc:
        result = transaction_stop("governed_transaction_internal_exception", error=f"{type(exc).__name__}:{exc}")
        return result
    finally:
        state = operator_execution.autonomous_execution_control_state(control_file)
        owned_generation = str(getattr(args, "_controlled_window_generation", "") or "")
        owned_operation_id = str(getattr(args, "_controlled_window_operation_id", "") or "")
        if owned_generation and owned_operation_id:
            finalization = operator_execution.finalize_autonomous_execution_control_window(
                control_file,
                expected_generation=owned_generation,
                operation_id=owned_operation_id,
                actor="governed-execution-finalizer",
                reason=str(result.get("stop_reason") or result.get("final_verdict") or "governed_transaction_terminal"),
            )
            result["controlled_window_finalization"] = finalization
            result["safe_mode_final_state"] = str((finalization.get("after") or {}).get("state") or "UNKNOWN")
            if not finalization.get("final_open"):
                recovery = operator_execution.finalize_autonomous_execution_control_window(
                    control_file,
                    actor="governed-execution-recovery",
                    reason="controlled_window_identity_changed_force_open",
                    force_fail_closed_open=True,
                )
                result["controlled_window_recovery"] = recovery
                result["safe_mode_final_state"] = str((recovery.get("after") or {}).get("state") or "UNKNOWN")
                if not recovery.get("final_open"):
                    result["transaction_status"] = "STOP_SAFE"
                    result["final_verdict"] = "UNSAFE_IMPLEMENTATION"
                    result["stop_reason"] = "controlled_window_final_open_failed"
        else:
            result["controlled_window_finalization"] = {
                "ok": bool(state.get("valid") and state.get("state") == "OPEN"),
                "idempotent": True,
                "final_open": bool(state.get("valid") and state.get("state") == "OPEN"),
                "after": state,
            }
            result["safe_mode_final_state"] = str(state.get("state") or "UNKNOWN")


def current_a4_missing_candidate_keys(snapshot_root: Path, records: list[dict[str, Any]]) -> set[tuple[str, str]]:
    snapshot = read_snapshot_family(snapshot_root, "candidate-suitability-summary")
    candidate_rows = snapshot.payload.get("items") if isinstance(snapshot.payload.get("items"), list) else []
    candidate_keys = intelligence_workers._candidate_keys(candidate_rows)
    consumed_outcomes = intelligence_workers.build_candidate_outcome_rows(candidate_rows, records)
    consumed_keys = {
        (str(row.get("user") or ""), str(row.get("channel") or row.get("egress") or row.get("target") or ""))
        for row in consumed_outcomes
        if isinstance(row, dict)
    }
    consumed_keys = {(user, channel) for user, channel in consumed_keys if user and channel}
    return candidate_keys - consumed_keys


def a4_collection_input_status(state_dir: Path, event_dir: Path, snapshot_root: Path, audit_dir: Path) -> dict[str, Any]:
    candidate_snapshot = Path(read_snapshot_family(snapshot_root, "candidate-suitability-summary").path)
    required_paths = [
        state_dir,
        state_dir / "users.registry",
        state_dir / "egress.registry",
        candidate_snapshot,
    ]
    evidence_paths = [
        event_dir / "switch-history.jsonl",
        audit_dir / "audit.jsonl",
        audit_dir / "operator-execution-audit.jsonl",
        audit_dir / "operator-runtime-governance-actions.jsonl",
        state_dir / "execution-events.jsonl",
        state_dir / "runtime-trust.jsonl",
        state_dir / "proposal-records.jsonl",
        state_dir / "proposals.jsonl",
        state_dir / "closure-records.jsonl",
        event_dir / "rollback-history.jsonl",
    ]
    missing_required = [str(path) for path in required_paths if not path.exists()]
    available_evidence = [str(path) for path in evidence_paths if path.exists()]
    return {
        "runtime_state_available": not missing_required and bool(available_evidence),
        "missing_required_inputs": missing_required,
        "available_evidence_sources": available_evidence,
        "required_evidence_source_count": len(evidence_paths),
        "owner": "tools/v7-governed-canary-dry-run-cycle",
    }


def collection_stop(reason: str, *, transactions: list[dict[str, Any]] | None = None, **extra: Any) -> dict[str, Any]:
    transactions = transactions or []
    successful = [
        row for row in transactions
        if row.get("final_verdict") == "GOVERNED_TRANSACTION_COMPLETED"
        and row.get("verification_result") == "PASS"
        and row.get("a4_evidence_updated")
    ]
    return {
        "schema_version": "v7.a4-bounded-evidence-collection.v1",
        "collection_status": "STOP_SAFE",
        "final_verdict": "A4_BOUNDED_EVIDENCE_COLLECTION_STOPPED",
        "stop_reason": reason,
        "successful_outcomes": len(successful),
        "transactions_attempted": len(transactions),
        "transactions": transactions,
        "runtime_automation_enabled": False,
        "authority_expanded": False,
        "temporary_authority_consumed": bool(transactions),
        "new_architecture_created": False,
        "new_authority_created": False,
        "new_runtime_path_created": False,
        "new_governance_created": False,
        "new_owner_created": False,
        "new_backlog_item_created": False,
        **extra,
    }


def execute_a4_bounded_evidence_collection(
    args: argparse.Namespace,
    *,
    state_dir: Path,
    event_dir: Path,
    snapshot_root: Path,
    audit_dir: Path,
    lease_file: Path,
) -> dict[str, Any]:
    if args.confirm_a4_bounded_evidence_collection != "EXECUTE_A4_BOUNDED_EVIDENCE_COLLECTION_APPROVED":
        return collection_stop("collection_confirmation_required")
    if int(args.max_users) != 1:
        return collection_stop("collection_max_users_must_be_one")
    max_outcomes = int(args.max_evidence_outcomes)
    if max_outcomes <= 0:
        return collection_stop("max_evidence_outcomes_must_be_positive")

    input_status = a4_collection_input_status(state_dir, event_dir, snapshot_root, audit_dir)
    if not input_status["runtime_state_available"]:
        return collection_stop(
            "runtime_state_unavailable",
            runtime_state_available=False,
            input_status=input_status,
            transactions=[],
        )

    transactions: list[dict[str, Any]] = []
    seen_candidates: set[tuple[str, str, str, str]] = set()
    while len(transactions) < max_outcomes:
        missing_candidate_keys = current_a4_missing_candidate_keys(
            snapshot_root,
            decision_records(state_dir, event_dir, audit_dir),
        )
        if not missing_candidate_keys:
            return collection_stop("no_missing_a4_candidate_outcomes", transactions=transactions)
        transaction_args = copy.copy(args)
        transaction_args.confirm_governed_transaction = "EXECUTE_GOVERNED_TRANSACTION_APPROVED"
        transaction_args.execute_governed_transaction = True
        result = execute_governed_transaction_with_guards(
            transaction_args,
            state_dir=state_dir,
            event_dir=event_dir,
            snapshot_root=snapshot_root,
            audit_dir=audit_dir,
            lease_file=lease_file,
            required_a4_candidate_keys=missing_candidate_keys,
            blocked_transaction_identities=seen_candidates,
        )
        transactions.append(result)
        if result.get("final_verdict") != "GOVERNED_TRANSACTION_COMPLETED":
            return collection_stop(
                str(result.get("stop_reason") or "transaction_stop_safe"),
                transactions=transactions,
            )
        identity = (
            str(result.get("fresh_packet_id") or ""),
            str(result.get("user") or ""),
            str(result.get("source") or ""),
            str(result.get("target") or ""),
        )
        seen_candidates.add(identity)
        if int(result.get("users_moved") or 0) != 1:
            return collection_stop("transaction_user_count_not_one", transactions=transactions)
        if result.get("verification_result") != "PASS":
            return collection_stop("transaction_verification_failed", transactions=transactions)
        if not result.get("a4_evidence_updated"):
            return collection_stop("transaction_feedback_not_materialized", transactions=transactions)
        if result.get("runtime_automation_enabled") or result.get("authority_expanded"):
            return collection_stop("transaction_scope_expanded", transactions=transactions)

    return {
        "schema_version": "v7.a4-bounded-evidence-collection.v1",
        "collection_status": "COMPLETED",
        "final_verdict": "A4_BOUNDED_EVIDENCE_COLLECTION_COMPLETED",
        "successful_outcomes": len(transactions),
        "max_evidence_outcomes": max_outcomes,
        "transactions_attempted": len(transactions),
        "transactions": transactions,
        "one_user_per_transaction": True,
        "stop_on_first_failed_gate": True,
        "runtime_automation_enabled": False,
        "authority_expanded": False,
        "temporary_authority_consumed": True,
        "new_architecture_created": False,
        "new_authority_created": False,
        "new_runtime_path_created": False,
        "new_governance_created": False,
        "new_owner_created": False,
        "new_backlog_item_created": False,
    }


