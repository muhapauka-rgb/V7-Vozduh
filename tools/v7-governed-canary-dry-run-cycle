def execute_l3_production_validation(args: argparse.Namespace, *, state_dir: Path, event_dir: Path, snapshot_root: Path, audit_dir: Path, lease_file: Path) -> dict[str, Any]:
    args._l3_controlled_window_generation = ""
    args._l3_controlled_window_operation_id = ""
    result: dict[str, Any] = {}
    try:
        result = _execute_l3_production_validation_inner(
            args,
            state_dir=state_dir,
            event_dir=event_dir,
            snapshot_root=snapshot_root,
            audit_dir=audit_dir,
            lease_file=lease_file,
        )
        return result
    finally:
        generation = str(getattr(args, "_l3_controlled_window_generation", "") or "")
        operation_id = str(getattr(args, "_l3_controlled_window_operation_id", "") or "")
        if generation and operation_id:
            finalization = operator_execution.finalize_autonomous_execution_control_window(
                Path(getattr(args, "execution_control_file", operator_execution.DEFAULT_AUTONOMOUS_EXECUTION_CONTROL_FILE)),
                actor="l3-production-validation-finalizer",
                reason=str(result.get("final_verdict") or result.get("stop_reason") or "l3_production_validation_complete"),
                expected_generation=generation,
                operation_id=operation_id,
            )
            result["controlled_window_finalization"] = finalization
            result["safe_mode_final_state"] = str((finalization.get("after") or {}).get("state") or "")


def _execute_governed_transaction_with_guards_inner(
    args: argparse.Namespace,
    *,
    state_dir: Path,
    event_dir: Path,
    snapshot_root: Path,
    audit_dir: Path,
    lease_file: Path,
    required_a4_candidate_keys: set[tuple[str, str]] | None = None,
    blocked_transaction_identities: set[tuple[str, str, str, str]] | None = None,
) -> dict[str, Any]:
    delegated_mode = bool(getattr(args, "execute_bounded_delegated_transaction", False))
    setup_request = getattr(args, "_certification_setup_request", None)
    setup_mode = isinstance(setup_request, dict) and bool(setup_request)
    if not delegated_mode and not setup_mode and args.confirm_governed_transaction != "EXECUTE_GOVERNED_TRANSACTION_APPROVED":
        return transaction_stop("transaction_confirmation_required")
    if int(args.max_users) != 1:
        return transaction_stop("transaction_max_users_must_be_one")

    control_file = Path(getattr(args, "execution_control_file", operator_execution.DEFAULT_AUTONOMOUS_EXECUTION_CONTROL_FILE))
    preflight_state = operator_execution.autonomous_execution_control_state(control_file)
    if not preflight_state.get("valid") or preflight_state.get("state") != "OPEN":
        return transaction_stop("autonomous_execution_control_not_open_at_start", execution_control=preflight_state)

    existing_lease = operator_execution.load_execution_lease(lease_file)
    existing_state = operator_execution.execution_lease_state(existing_lease)
    if existing_state.get("active"):
        return transaction_stop("active_execution_lease_exists", execution_lease_state=existing_state)

    users = read_registry(state_dir / "users.registry")
    egress = read_registry(state_dir / "egress.registry")
    runtime_state = read_json(state_dir / "v7-state.json", {})
    records = decision_records(state_dir, event_dir, audit_dir)
    events = event_rows(event_dir, args.max_events)
    surface = operator_decision_surface.build_operator_decision_surface(
        snapshot_root=snapshot_root,
        users=users,
        egress=egress,
        runtime_state=runtime_state,
        decision_records=records,
    )
    shadow_history = read_jsonl_family(state_dir / "shadow-autonomy-decisions.jsonl")
    inventory = autonomy_trust_acceleration.build_acceleration_inventory(
        snapshot_root=snapshot_root,
        decision_surface=surface,
        shadow_history=shadow_history,
        decision_records=records,
        event_rows=events,
    )
    surface["knowledge_quality_read_model"] = inventory.get("knowledge_quality_read_model", {})
    surface["decision_outcome_learning"] = inventory.get("decision_outcome_learning", {})
    planner_observe = {"skipped": True}
    if not args.skip_planner_observe and not setup_mode:
        planner_observe = run_planner_observe(state_dir, event_dir, snapshot_root, 1)
        moves = selected_moves_from_planner_payload(planner_observe.get("payload", {}))
        surface = merge_planner_moves_into_surface(surface, moves, replace_existing=True)
    a4_goal_directed_selection = {}
    certification_setup_selection = {}
    if setup_mode:
        certification_setup_selection = controlled_certification_setup_selection(
            users=users,
            egress=egress,
            user=str(setup_request.get("user") or ""),
            source=str(setup_request.get("source") or ""),
        )
        if certification_setup_selection.get("selection_status") != "SELECTED":
            return transaction_stop(
                "CONTROLLED_CERTIFICATION_SETUP_NOT_ADMITTED",
                certification_setup_selection=certification_setup_selection,
            )
        surface = merge_a4_gap_candidate_into_surface(surface, certification_setup_selection)
    if required_a4_candidate_keys is not None:
        a4_goal_directed_selection = select_a4_gap_reducing_candidate(
            surface=surface,
            snapshot_root=snapshot_root,
            required_a4_candidate_keys=required_a4_candidate_keys,
            blocked_transaction_identities=blocked_transaction_identities,
        )
        if a4_goal_directed_selection.get("selection_status") != "SELECTED":
            return transaction_stop(
                "NO_SAFE_GAP_REDUCING_A4_CANDIDATE",
                a4_goal_directed_selection=a4_goal_directed_selection,
                planner_observe=planner_observe,
            )
        surface = merge_a4_gap_candidate_into_surface(surface, a4_goal_directed_selection)

    attach_controlled_execution_source_binding(surface, state_dir=state_dir, snapshot_root=snapshot_root)

    cycle = operator_execution_pipeline.governed_canary_knowledge_gated_dry_run_cycle(
        events=events,
        decision_surface=surface,
        execution_lease=None,
        max_users=1,
    )
    packet_preview = cycle.get("packet_preview") if isinstance(cycle.get("packet_preview"), dict) else {}
    if setup_mode:
        packet_preview["_v7_evidence_class"] = "ENGINEERING_SETUP"
        packet_preview["_v7_certification_setup"] = certification_setup_selection
    if cycle.get("stop_reason") != "AUTHORITY_BOUNDARY" or packet_preview.get("status") != "PACKET_PREVIEW_READY":
        return transaction_stop("packet_not_ready", cycle=cycle, planner_observe=planner_observe)

    preview_identity = operator_execution.preview_packet_identity(packet_preview)
    delegated_admission = {}
    approved_identity = {}
    if setup_mode:
        delegated_admission = {
            "schema_version": "v7.controlled-certification-setup-authority.v1",
            "allowed": True,
            "blockers": [],
            "authority": {
                "authority_basis": "OPERATOR_ENGINEERING_AUTHORITY",
                "engineering_authority_source": "EXPLICIT_POLYGON_L7_MISSION_CONTINUATION",
                "action_class": "single-user governed candidate failover",
                "max_users_per_transaction": 1,
                "max_concurrent_transactions": 1,
                "candidate_identity": "FRESH_ONLY",
                "packet_reuse": "FORBIDDEN",
                "self_expansion_allowed": False,
                "scope": certification_setup_selection.get("authority_scope"),
            },
        }
    elif delegated_mode:
        delegated_admission = bounded_delegated_policy_admission(packet_preview, cycle)
        if not delegated_admission.get("allowed"):
            return transaction_stop("delegated_policy_admission_denied", cycle=cycle, delegated_policy_admission=delegated_admission)
    else:
        approved_identity = approved_identity_from_args(args)
        preview_binding = operator_execution.approved_packet_binding_status(preview_identity, approved_identity)
        if not preview_binding.get("ok"):
            return transaction_stop("approved_packet_binding_failed", cycle=cycle, approved_packet_binding=preview_binding)

    source_hashes = packet_preview.get("source_hashes") if isinstance(packet_preview.get("source_hashes"), dict) else {}
    source_bundle_hash = operator_execution.sha256_json(source_hashes) if source_hashes else ""
    controlled_window = operator_execution.build_autonomous_execution_control_state(
        False,
        actor=(str((delegated_admission.get("authority") or {}).get("policy_id") or (delegated_admission.get("authority") or {}).get("authority_basis") or "delegated-policy") if (delegated_mode or setup_mode) else str(args.approval_author or "operator")),
        reason="governed_one_operation_window",
        operation_id=str(packet_preview.get("operation_id") or ""),
        selected_move_hash=str(packet_preview.get("selected_move_hash") or ""),
        action_class="USER_SWITCH",
        source_bundle_hash=source_bundle_hash,
        snapshot_bundle_hash=str(packet_preview.get("snapshot_bundle_hash") or ""),
        max_users=1,
    )
    operator_execution.write_json_atomic(control_file, controlled_window)
    args._controlled_window_generation = str(controlled_window.get("generation") or "")
    args._controlled_window_operation_id = str(controlled_window.get("operation_id") or "")
    preflight_control = operator_execution.autonomous_execution_control_decision(
        control_file,
        mutation_kind="forward",
        action_class="USER_SWITCH",
        expected_generation=str(controlled_window.get("generation") or ""),
        operation_id=str(packet_preview.get("operation_id") or ""),
        selected_move_hash=str(packet_preview.get("selected_move_hash") or ""),
        source_bundle_hash=source_bundle_hash,
        snapshot_bundle_hash=str(packet_preview.get("snapshot_bundle_hash") or ""),
        max_users=1,
    )
    if not preflight_control.get("allowed_forward_mutation"):
        return transaction_stop("autonomous_execution_control_denied_pre_lease", execution_control=preflight_control)

    try:
        packet = operator_execution.packet_from_preview(
            packet_preview,
            approval_author=args.approval_author,
            approval_reviewer=args.approval_reviewer,
            ttl_seconds=args.ttl_seconds,
            breaker_generation=str(preflight_control.get("generation") or ""),
            require_execution_binding=True,
            delegated_policy_authority=packet_materialization_authority(
                delegated_mode=delegated_mode,
                setup_mode=setup_mode,
                delegated_admission=delegated_admission,
            ),
        )
    except Exception as exc:
        return transaction_stop("packet_materialization_failed", cycle=cycle, error=str(exc))

    approved_materialized_identity = dict(preview_identity if (delegated_mode or setup_mode) else approved_identity)
    approved_materialized_identity["breaker_generation"] = str(preflight_control.get("generation") or "")
    packet_binding = operator_execution.approved_packet_binding_status(
        operator_execution.packet_identity(packet),
        approved_materialized_identity,
    )
    if not packet_binding.get("ok"):
        return transaction_stop("fresh_packet_materialization_changed_identity", cycle=cycle, packet_binding=packet_binding)

    constraints = transaction_packet_constraints_ok(packet, cycle, int(args.max_users))
    if not constraints.get("ok"):
        return transaction_stop("transaction_scope_invalid", cycle=cycle, constraints=constraints)

    user = constraints["users"][0]
    target = constraints["targets"][0]
    source = ((packet.get("rollback_manifest") or {}).get("items") or [{}])[0].get("rollback_target", "")
    packet_identity = operator_execution.packet_identity(packet)
    identity = (str(packet.get("packet_id") or ""), user, str(source or ""), target)
    if blocked_transaction_identities is not None and identity in blocked_transaction_identities:
        return transaction_stop(
            "duplicate_transaction_candidate",
            cycle=cycle,
            packet=operator_execution.redact(packet),
            transaction_identity={
                "packet_id": identity[0],
                "user": identity[1],
                "source": identity[2],
                "target": identity[3],
            },
            duplicate_guard_stage="pre_lease_pre_restore_barrier_pre_apply",
        )
    if required_a4_candidate_keys is not None and (user, target) not in required_a4_candidate_keys:
        return transaction_stop(
            "candidate_not_missing_a4_evidence",
            cycle=cycle,
            packet=operator_execution.redact(packet),
            candidate_key={"user": user, "target": target},
            evidence_guard_stage="pre_lease_pre_restore_barrier_pre_apply",
        )

    lease = operator_execution.create_execution_lease_from_packet(packet, source_preview=packet_preview)
    lease_create_result = operator_execution.write_execution_lease(lease_file, lease)
    if not lease_create_result.get("ok"):
        return transaction_stop("execution_lease_not_created", cycle=cycle, execution_lease_create_result=lease_create_result)

    restore_barrier_file = Path(args.restore_barrier_file) if args.restore_barrier_file else state_dir / "autoswitch-restore-barrier.json"
    audit_store = audit_dir / "operator-execution-audit.jsonl"
    lifecycle_store = audit_dir / "governance-lifecycle.jsonl"
    clearance_result = operator_execution.execute_packet(
        packet,
        audit_store,
        state_dir,
        mode="runtime_action",
        restore_barrier_file=restore_barrier_file,
        lifecycle_store=lifecycle_store,
    )
    if not clearance_result.get("execution_allowed_now"):
        terminal = operator_execution.finish_execution_lease(
            lease_file,
            status="OPERATOR_CANCELLED",
            reason="transaction_stop_safe_before_apply",
            operation={"terminal_state": "STOP_SAFE", "terminal_reason": "restore_barrier_clearance_denied", "apply_result": {"applied": False, "results": []}},
        )
        return transaction_stop(
            "restore_barrier_clearance_denied",
            cycle=cycle,
            packet=operator_execution.redact(packet),
            execution_lease_create_result=lease_create_result,
            clearance_result=clearance_result,
            lease_terminalization=terminal,
        )

    pre_apply_control = operator_execution.autonomous_execution_control_decision(
        control_file,
        mutation_kind="forward",
        action_class="USER_SWITCH",
        expected_generation=str(packet_identity.get("breaker_generation") or ""),
        operation_id=str(packet_identity.get("operation_id") or ""),
        selected_move_hash=str(packet_identity.get("selected_move_hash") or ""),
        source_bundle_hash=str(packet_identity.get("source_bundle_hash") or ""),
        snapshot_bundle_hash=str(packet_identity.get("snapshot_bundle_hash") or ""),
        max_users=1,
    )
    if not pre_apply_control.get("allowed_forward_mutation"):
        terminal = operator_execution.finish_execution_lease(
            lease_file,
            status="OPERATOR_CANCELLED",
            reason="autonomous_execution_control_denied_pre_apply",
            operation={"terminal_state": "STOP_SAFE", "terminal_reason": "execution_control_changed", "apply_result": {"applied": False, "results": []}},
        )
        return transaction_stop("autonomous_execution_control_denied_pre_apply", execution_control=pre_apply_control, lease_terminalization=terminal)

    apply_run = run_autoswitch_apply(
        state_dir=state_dir,
        event_dir=event_dir,
        snapshot_root=snapshot_root,
        restore_barrier_file=restore_barrier_file,
        user=user,
        source=source,
        target=target,
        packet_id=str(packet_identity.get("packet_id") or ""),
        operation_id=str(packet_identity.get("operation_id") or ""),
        selected_move_hash=str(packet_identity.get("selected_move_hash") or ""),
        authority_generation=str(packet_identity.get("authority_generation") or ""),
        breaker_generation=str(packet_identity.get("breaker_generation") or ""),
        source_bundle_hash=str(packet_identity.get("source_bundle_hash") or ""),
        snapshot_bundle_hash=str(packet_identity.get("snapshot_bundle_hash") or ""),
        execution_control_file=str(control_file),
    )
    apply_payload = apply_run.get("payload") if isinstance(apply_run.get("payload"), dict) else {}
    operation = dict(apply_payload.get("operation") or {})
    operation["apply_result"] = apply_payload.get("apply_result") if isinstance(apply_payload.get("apply_result"), dict) else {}
    terminal_status = lease_terminal_status_from_apply(apply_payload)
    lease_terminalization = operator_execution.finish_execution_lease(
        lease_file,
        status=terminal_status,
        reason=str(operation.get("terminal_reason") or "governed_transaction_complete"),
        operation=operation,
    )
    apply_result = apply_payload.get("apply_result") if isinstance(apply_payload.get("apply_result"), dict) else {}
    results = apply_result.get("results") if isinstance(apply_result.get("results"), list) else []
    rollback_attempted = any(bool(row.get("rollback_attempted")) for row in results if isinstance(row, dict))
    verification_passed = all(int(row.get("verify_rc", 1)) == 0 for row in results if isinstance(row, dict)) and bool(results)
    feedback_materialization = materialize_governed_transaction_feedback(
        state_dir=state_dir,
        packet=packet,
        operation=operation,
        apply_result=apply_result,
        user=user,
        source=source,
        target=target,
        rollback_attempted=rollback_attempted,
        verification_passed=verification_passed,
        evidence_class="ENGINEERING_SETUP" if setup_mode else "CONTROLLED_PRODUCTION",
    )
    return {
        "schema_version": "v7.governed-execution-transaction.v1",
        "transaction_status": "COMPLETED" if apply_result.get("applied") else "STOP_SAFE",
        "final_verdict": "GOVERNED_TRANSACTION_COMPLETED" if apply_result.get("applied") else "GOVERNED_TRANSACTION_STOPPED",
        "fresh_packet_id": packet.get("packet_id", ""),
        "decision_id": packet.get("decision_id", ""),
        "operation_id": packet.get("operation_id", ""),
        "selected_move_hash": (packet.get("expected") or {}).get("selected_move_hash", ""),
        "user": user,
        "source": source,
        "target": target,
        "one_execution_attempt": True,
        "runtime_mutation_performed": bool(apply_result.get("applied")),
        "restore_barrier_written_now": bool((clearance_result.get("clearance_result") or {}).get("ok")),
        "apply_executed": bool(apply_result.get("applied")),
        "verification_result": "PASS" if verification_passed else ("NOT_RUN" if not results else "FAIL"),
        "rollback_attempted": rollback_attempted,
        "rollback_result": operation.get("rollback_verdict", "NOT_REQUIRED" if not rollback_attempted else ""),
        "feedback_materialization": feedback_materialization,
        "a4_evidence_updated": bool(feedback_materialization.get("materialized")),
        "users_moved": len(results) if apply_result.get("applied") else 0,
        "runtime_automation_enabled": delegated_mode,
        "delegated_policy_admission": delegated_admission,
        "candidate_approval_required": not delegated_mode,
        "packet_approval_required": not delegated_mode,
        "hash_approval_required": not delegated_mode,
        "authority_expanded": False,
        "new_architecture_created": False,
        "new_authority_created": False,
        "new_runtime_path_created": False,
        "new_governance_created": False,
        "new_owner_created": False,
        "new_backlog_item_created": False,
        "cycle": cycle,
        "planner_observe": planner_observe,
        "a4_goal_directed_selection": a4_goal_directed_selection,
        "certification_setup_selection": certification_setup_selection,
        "execution_lease_create_result": lease_create_result,
        "clearance_result": clearance_result,
        "autoswitch_apply": apply_run,
        "lease_terminalization": lease_terminalization,
    }


def prepare_controlled_certification_condition(
    args: argparse.Namespace,
    *,
    state_dir: Path,
    event_dir: Path,
    snapshot_root: Path,
    audit_dir: Path,
    lease_file: Path,
) -> dict[str, Any]:
    if args.confirm_controlled_certification_condition != "PREPARE_CONTROLLED_CERTIFICATION_CONDITION_APPROVED":
        return transaction_stop("controlled_certification_condition_confirmation_required")
    if int(args.max_users) != 1:
        return transaction_stop("controlled_certification_condition_max_users_must_be_one")
    transaction_args = copy.copy(args)
    transaction_args._certification_setup_request = {
        "user": str(args.certification_user or ""),
        "source": str(args.certification_source or ""),
    }
    transaction_args.skip_planner_observe = True
    transaction_args.execute_bounded_delegated_transaction = False
    transaction = execute_governed_transaction_with_guards(
        transaction_args,
        state_dir=state_dir,
        event_dir=event_dir,
        snapshot_root=snapshot_root,
        audit_dir=audit_dir,
        lease_file=lease_file,
    )
    if transaction.get("final_verdict") != "GOVERNED_TRANSACTION_COMPLETED" or transaction.get("verification_result") != "PASS":
        return {
            **transaction_stop("controlled_certification_setup_transaction_failed"),
            "setup_transaction": transaction,
        }
    marker_command = [
        "v7-egress-set-state", str(args.certification_source), "certification-scope",
        "--certification-users", str(args.certification_user),
        "--certification-group", "polygon-l7-canary", "--apply",
    ]
    marker = subprocess.run(marker_command, text=True, capture_output=True, timeout=180, check=False)
    route = scoped_user_route_check(state_dir, str(args.certification_user))
    passed = marker.returncode == 0 and route.get("passed")
    return {
        "schema_version": "v7.controlled-certification-condition-preparation.v1",
        "final_verdict": "CONTROLLED_CERTIFICATION_CONDITION_PREPARED" if passed else "STOP_SAFE",
        "setup_transaction": transaction,
        "marker_owner": "v7-egress-set-state certification-scope",
        "marker_returncode": marker.returncode,
        "marker_output": marker.stdout[-3000:],
        "route_verification": route,
        "certification_user": str(args.certification_user),
        "controlled_source": str(args.certification_source),
        "evidence_class": "ENGINEERING_SETUP_NOT_L7_EVIDENCE",
        "ordinary_customer_used": False,
        "users_moved": 1,
        "runtime_mutation_performed": True,
        "authority_expanded_beyond_exact_setup": False,
        "daemon_or_timer_enabled": False,
    }


def execute_governed_transaction_with_guards(
    args: argparse.Namespace,
    *,
    state_dir: Path,
    event_dir: Path,
    snapshot_root: Path,
    audit_dir: Path,
    lease_file: Path,
    required_a4_candidate_keys: set[tuple[str, str]] | None = None,
    blocked_transaction_identities: set[tuple[str, str, str, str]] | None = None,
) -> dict[str, Any]:
    control_file = Path(getattr(args, "execution_control_file", operator_execution.DEFAULT_AUTONOMOUS_EXECUTION_CONTROL_FILE))
    result: dict[str, Any] = {}
    try:
        args._controlled_window_generation = ""
        args._controlled_window_operation_id = ""
        initial_state = operator_execution.autonomous_execution_control_state(control_file)
        if not initial_state.get("valid") or initial_state.get("state") != "OPEN":
            recovery = operator_execution.finalize_autonomous_execution_control_window(
                control_file,
                actor="governed-execution-recovery",
                reason="stale_or_invalid_controlled_window_recovered_before_fresh_run",
                force_fail_closed_open=True,
            )
            result = transaction_stop(
                "stale_or_invalid_controlled_window_recovered_open",
                controlled_window_recovery=recovery,
            )
            return result
        result = _execute_governed_transaction_with_guards_inner(
            args,
            state_dir=state_dir,
            event_dir=event_dir,
            snapshot_root=snapshot_root,
            audit_dir=audit_dir,
            lease_file=lease_file,
            required_a4_candidate_keys=required_a4_candidate_keys,
            blocked_transaction_identities=blocked_transaction_identities,
        )
        return result
    except (Exception, KeyboardInterrupt) as exc:
        result = transaction_stop("governed_transaction_internal_exception", error=f"{type(exc).__name__}:{exc}")
        return result
    finally:
        state = operator_execution.autonomous_execution_control_state(control_file)
        owned_generation = str(getattr(args, "_controlled_window_generation", "") or "")
        owned_operation_id = str(getattr(args, "_controlled_window_operation_id", "") or "")
        if owned_generation and owned_operation_id:
            finalization = operator_execution.finalize_autonomous_execution_control_window(
                control_file,
                expected_generation=owned_generation,
                operation_id=owned_operation_id,
                actor="governed-execution-finalizer",
                reason=str(result.get("stop_reason") or result.get("final_verdict") or "governed_transaction_terminal"),
            )
            result["controlled_window_finalization"] = finalization
            result["safe_mode_final_state"] = str((finalization.get("after") or {}).get("state") or "UNKNOWN")
            if not finalization.get("final_open"):
                recovery = operator_execution.finalize_autonomous_execution_control_window(
                    control_file,
                    actor="governed-execution-recovery",
                    reason="controlled_window_identity_changed_force_open",
                    force_fail_closed_open=True,
                )
                result["controlled_window_recovery"] = recovery
                result["safe_mode_final_state"] = str((recovery.get("after") or {}).get("state") or "UNKNOWN")
                if not recovery.get("final_open"):
                    result["transaction_status"] = "STOP_SAFE"
                    result["final_verdict"] = "UNSAFE_IMPLEMENTATION"
                    result["stop_reason"] = "controlled_window_final_open_failed"
        else:
            result["controlled_window_finalization"] = {
                "ok": bool(state.get("valid") and state.get("state") == "OPEN"),
                "idempotent": True,
                "final_open": bool(state.get("valid") and state.get("state") == "OPEN"),
                "after": state,
            }
            result["safe_mode_final_state"] = str(state.get("state") or "UNKNOWN")


def current_a4_missing_candidate_keys(snapshot_root: Path, records: list[dict[str, Any]]) -> set[tuple[str, str]]:
    snapshot = read_snapshot_family(snapshot_root, "candidate-suitability-summary")
    candidate_rows = snapshot.payload.get("items") if isinstance(snapshot.payload.get("items"), list) else []
    candidate_keys = intelligence_workers._candidate_keys(candidate_rows)
    consumed_outcomes = intelligence_workers.build_candidate_outcome_rows(candidate_rows, records)
    consumed_keys = {
        (str(row.get("user") or ""), str(row.get("channel") or row.get("egress") or row.get("target") or ""))
        for row in consumed_outcomes
        if isinstance(row, dict)
    }
    consumed_keys = {(user, channel) for user, channel in consumed_keys if user and channel}
    return candidate_keys - consumed_keys


def a4_collection_input_status(state_dir: Path, event_dir: Path, snapshot_root: Path, audit_dir: Path) -> dict[str, Any]:
    candidate_snapshot = Path(read_snapshot_family(snapshot_root, "candidate-suitability-summary").path)
    required_paths = [
        state_dir,
        state_dir / "users.registry",
        state_dir / "egress.registry",
        candidate_snapshot,
    ]
    evidence_paths = [
        event_dir / "switch-history.jsonl",
        audit_dir / "audit.jsonl",
        audit_dir / "operator-execution-audit.jsonl",
        audit_dir / "operator-runtime-governance-actions.jsonl",
        state_dir / "execution-events.jsonl",
        state_dir / "runtime-trust.jsonl",
        state_dir / "proposal-records.jsonl",
        state_dir / "proposals.jsonl",
        state_dir / "closure-records.jsonl",
        event_dir / "rollback-history.jsonl",
    ]
    missing_required = [str(path) for path in required_paths if not path.exists()]
    available_evidence = [str(path) for path in evidence_paths if path.exists()]
    return {
        "runtime_state_available": not missing_required and bool(available_evidence),
        "missing_required_inputs": missing_required,
        "available_evidence_sources": available_evidence,
        "required_evidence_source_count": len(evidence_paths),
        "owner": "tools/v7-governed-canary-dry-run-cycle",
    }


def collection_stop(reason: str, *, transactions: list[dict[str, Any]] | None = None, **extra: Any) -> dict[str, Any]:
    transactions = transactions or []
    successful = [
        row for row in transactions
        if row.get("final_verdict") == "GOVERNED_TRANSACTION_COMPLETED"
        and row.get("verification_result") == "PASS"
        and row.get("a4_evidence_updated")
    ]
    return {
        "schema_version": "v7.a4-bounded-evidence-collection.v1",
        "collection_status": "STOP_SAFE",
        "final_verdict": "A4_BOUNDED_EVIDENCE_COLLECTION_STOPPED",
        "stop_reason": reason,
        "successful_outcomes": len(successful),
        "transactions_attempted": len(transactions),
        "transactions": transactions,
        "runtime_automation_enabled": False,
        "authority_expanded": False,
        "temporary_authority_consumed": bool(transactions),
        "new_architecture_created": False,
        "new_authority_created": False,
        "new_runtime_path_created": False,
        "new_governance_created": False,
        "new_owner_created": False,
        "new_backlog_item_created": False,
        **extra,
    }


def execute_a4_bounded_evidence_collection(
    args: argparse.Namespace,
    *,
    state_dir: Path,
    event_dir: Path,
    snapshot_root: Path,
    audit_dir: Path,
    lease_file: Path,
) -> dict[str, Any]:
    if args.confirm_a4_bounded_evidence_collection != "EXECUTE_A4_BOUNDED_EVIDENCE_COLLECTION_APPROVED":
        return collection_stop("collection_confirmation_required")
    if int(args.max_users) != 1:
        return collection_stop("collection_max_users_must_be_one")
    max_outcomes = int(args.max_evidence_outcomes)
    if max_outcomes <= 0:
        return collection_stop("max_evidence_outcomes_must_be_positive")

    input_status = a4_collection_input_status(state_dir, event_dir, snapshot_root, audit_dir)
    if not input_status["runtime_state_available"]:
        return collection_stop(
            "runtime_state_unavailable",
            runtime_state_available=False,
            input_status=input_status,
            transactions=[],
        )

    transactions: list[dict[str, Any]] = []
    seen_candidates: set[tuple[str, str, str, str]] = set()
    while len(transactions) < max_outcomes:
        missing_candidate_keys = current_a4_missing_candidate_keys(
            snapshot_root,
            decision_records(state_dir, event_dir, audit_dir),
        )
        if not missing_candidate_keys:
            return collection_stop("no_missing_a4_candidate_outcomes", transactions=transactions)
        transaction_args = copy.copy(args)
        transaction_args.confirm_governed_transaction = "EXECUTE_GOVERNED_TRANSACTION_APPROVED"
        transaction_args.execute_governed_transaction = True
        result = execute_governed_transaction_with_guards(
            transaction_args,
            state_dir=state_dir,
            event_dir=event_dir,
            snapshot_root=snapshot_root,
            audit_dir=audit_dir,
            lease_file=lease_file,
            required_a4_candidate_keys=missing_candidate_keys,
            blocked_transaction_identities=seen_candidates,
        )
        transactions.append(result)
        if result.get("final_verdict") != "GOVERNED_TRANSACTION_COMPLETED":
            return collection_stop(
                str(result.get("stop_reason") or "transaction_stop_safe"),
                transactions=transactions,
            )
        identity = (
            str(result.get("fresh_packet_id") or ""),
            str(result.get("user") or ""),
            str(result.get("source") or ""),
            str(result.get("target") or ""),
        )
        seen_candidates.add(identity)
        if int(result.get("users_moved") or 0) != 1:
            return collection_stop("transaction_user_count_not_one", transactions=transactions)
        if result.get("verification_result") != "PASS":
            return collection_stop("transaction_verification_failed", transactions=transactions)
        if not result.get("a4_evidence_updated"):
            return collection_stop("transaction_feedback_not_materialized", transactions=transactions)
        if result.get("runtime_automation_enabled") or result.get("authority_expanded"):
            return collection_stop("transaction_scope_expanded", transactions=transactions)

    return {
        "schema_version": "v7.a4-bounded-evidence-collection.v1",
        "collection_status": "COMPLETED",
        "final_verdict": "A4_BOUNDED_EVIDENCE_COLLECTION_COMPLETED",
        "successful_outcomes": len(transactions),
        "max_evidence_outcomes": max_outcomes,
        "transactions_attempted": len(transactions),
        "transactions": transactions,
        "one_user_per_transaction": True,
        "stop_on_first_failed_gate": True,
        "runtime_automation_enabled": False,
        "authority_expanded": False,
        "temporary_authority_consumed": True,
        "new_architecture_created": False,
        "new_authority_created": False,
        "new_runtime_path_created": False,
        "new_governance_created": False,
        "new_owner_created": False,
        "new_backlog_item_created": False,
    }


