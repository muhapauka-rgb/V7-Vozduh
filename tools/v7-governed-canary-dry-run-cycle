def to_int(value: Any, default: int = 0) -> int:
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


def bool_value(value: Any) -> bool:
    """Use the registry boolean convention shared by existing V7 owners."""
    return str(value).strip().lower() in {
        "1", "true", "yes", "on", "enabled",
    }


def read_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return default


def append_jsonl(path: Path, row: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(row, ensure_ascii=True, separators=(",", ":")) + "\n")


def live_policy_lineage_records(args: argparse.Namespace) -> list[dict[str, Any]]:
    """Reuse one bounded immutable Authority/receipt projection per Mission."""
    cached = getattr(args, "_live_policy_lineage_records", None)
    if isinstance(cached, list) and all(isinstance(row, dict) for row in cached):
        return cached
    records = operator_execution.read_live_execution_lineage_records(
        Path(args.operator_execution_audit_store)
    )
    args._live_policy_lineage_records = records
    return records


def live_runtime_lineage_records(args: argparse.Namespace) -> list[dict[str, Any]]:
    """Reuse bounded rotated runtime lineage only during one recovery Mission."""
    cached = getattr(args, "_live_runtime_lineage_records", None)
    if isinstance(cached, list) and all(isinstance(row, dict) for row in cached):
        return cached
    audit_store = Path(args.operator_execution_audit_store)
    records = operator_execution.read_live_execution_lineage_records(
        audit_store,
        include_runtime_actions=True,
    )
    # The active segment can also contain current in-flight rows outside the
    # compact recovery classes.  Merge it once so recovery never trades fresh
    # owner truth for rotated truth.  Record hashes keep the projection exact
    # and deterministic when the active rows were already selected above.
    seen = {
        str(row.get("record_hash") or operator_execution.sha256_json(row))
        for row in records
    }
    for row in operator_execution.read_audit_records(audit_store):
        if not isinstance(row, dict):
            continue
        identity = str(
            row.get("record_hash") or operator_execution.sha256_json(row)
        )
        if identity in seen:
            continue
        seen.add(identity)
        records.append(row)
    args._live_runtime_lineage_records = records
    return records


def scoped_user_route_check(state_dir: Path, user: str) -> dict[str, Any]:
    """Reuse v7-user-route-check against exactly one registry identity."""
    rows = [
        line for line in (state_dir / "users.registry").read_text(encoding="utf-8").splitlines()
        if line.startswith(f"ip={user} ")
    ]
    if len(rows) != 1:
        return {"passed": False, "returncode": None, "reason": "user_registry_identity_not_unique"}
    with tempfile.TemporaryDirectory(prefix="v7-route-check-") as tmp:
        scoped = Path(tmp)
        (scoped / "users.registry").write_text(rows[0] + "\n", encoding="utf-8")
        for name in ("egress.registry", f"user-{user}.assign"):
            source = state_dir / name
            if source.exists():
                (scoped / name).symlink_to(source)
        env = dict(os.environ)
        env["V7_STATE_DIR"] = str(scoped)
        try:
            completed = subprocess.run(
                ["v7-user-route-check"], text=True, capture_output=True,
                timeout=180, check=False, env=env,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            return {"passed": False, "returncode": None, "reason": str(exc)}
    return {
        "passed": completed.returncode == 0,
        "returncode": completed.returncode,
        "reason": "exact_user_route_verified" if completed.returncode == 0 else "exact_user_route_verification_failed",
        "output_tail": completed.stdout[-2000:],
    }


def availability_first_baseline_reset_truth(
    result: dict[str, Any],
    *,
    state_dir: Path,
    event_dir: Path,
    user: str,
    baseline_source: str,
    execution_target: str,
) -> dict[str, Any]:
    """Reconcile baseline cleanup without creating certification evidence.

    A cleanup child may lose its terminal payload after the route owner
    committed the reverse move.  Normal success remains the preferred proof.
    The fallback accepts only the fresh partial-apply identity, current route
    truth, the scoped route verifier and the existing switch-history owner.
    It proves cleanup/containment only and never creates Outcome or L7 credit.
    """
    current = next(
        (
            str(row.get("current") or "")
            for row in read_registry(state_dir / "users.registry")
            if str(row.get("ip") or "") == user
        ),
        "",
    )
    normal = bool(
        result.get("final_verdict") == "GOVERNED_TRANSACTION_COMPLETED"
        and str(result.get("verification_result") or "") == "PASS"
        and current == baseline_source
    )
    if normal:
        return {
            "ok": True,
            "mode": "VERIFIED_CHILD_TERMINAL",
            "current_egress": current,
            "natural_l8_credit": False,
            "production_outcome_credit": False,
        }
    partial = (
        result.get("partial_apply_reconciliation")
        if isinstance(
            result.get("partial_apply_reconciliation"),
            dict,
        )
        else {}
    )
    identity_ok = bool(
        str(partial.get("status") or "") == "PARTIAL_APPLY_OBSERVED"
        and str(partial.get("user") or "") == user
        and str(partial.get("source") or "") == execution_target
        and str(partial.get("target") or "") == baseline_source
        and str(partial.get("current_egress") or "") == baseline_source
        and str(partial.get("packet_id") or "")
        == str(result.get("fresh_packet_id") or "")
        and str(partial.get("operation_id") or "")
        == str(result.get("operation_id") or "")
        and result.get("restore_barrier_written_now") is True
        and result.get("apply_executed") is True
    )
    route = (
        scoped_user_route_check(state_dir, user)
        if identity_ok and current == baseline_source
        else {
            "passed": False,
            "reason": "partial_reset_identity_or_current_route_mismatch",
        }
    )
    switch_rows = intelligence_workers.read_jsonl_tail(
        event_dir / "switch-history.jsonl",
        limit=256,
        max_bytes=RECENT_MATRIX_EVENT_BYTE_LIMIT,
    )
    barrier = read_json(
        state_dir / "autoswitch-restore-barrier.json",
        {},
    )
    post_clearance_identity_ok = bool(
        str(result.get("final_verdict") or "")
        == "GOVERNED_TRANSACTION_STOPPED"
        and str(result.get("user") or "") == user
        and str(result.get("source") or "") == execution_target
        and str(result.get("target") or "") == baseline_source
        and str(result.get("fresh_packet_id") or "")
        and str(result.get("operation_id") or "")
        and str(barrier.get("packet_id") or "")
        == str(result.get("fresh_packet_id") or "")
        and str(barrier.get("operation_id") or "")
        == str(result.get("operation_id") or "")
        and list(barrier.get("allowed_users") or []) == [user]
        and list(barrier.get("allowed_targets") or []) == [baseline_source]
    )
    try:
        clearance_at = datetime.fromisoformat(
            str(barrier.get("created_at") or "").replace("Z", "+00:00")
        )
    except ValueError:
        clearance_at = None
    temporally_bound_switch = False
    if clearance_at is not None:
        for row in switch_rows:
            if not isinstance(row, dict):
                continue
            try:
                switch_at = datetime.fromisoformat(
                    str(row.get("ts") or "").replace("Z", "+00:00")
                )
            except ValueError:
                continue
            if (
                str(row.get("user_ip") or "") == user
                and str(row.get("from") or "") == execution_target
                and str(row.get("to") or "") == baseline_source
                and clearance_at <= switch_at
                and switch_at - clearance_at <= timedelta(minutes=5)
            ):
                temporally_bound_switch = True
                break
    if (
        post_clearance_identity_ok
        and current == baseline_source
        and route.get("passed") is not True
    ):
        route = scoped_user_route_check(state_dir, user)
    switch_lineage = any(
        str(row.get("user_ip") or "") == user
        and str(row.get("from") or "") == execution_target
        and str(row.get("to") or "") == baseline_source
        for row in switch_rows
        if isinstance(row, dict)
    )
    ok = bool(
        identity_ok
        and current == baseline_source
        and route.get("passed") is True
        and switch_lineage
    )
    post_clearance_reconciled = bool(
        post_clearance_identity_ok
        and current == baseline_source
        and route.get("passed") is True
        and temporally_bound_switch
    )
    ok = bool(ok or post_clearance_reconciled)
    return {
        "ok": ok,
        "mode": (
            "PARTIAL_CHILD_TERMINAL_RECONCILED_FROM_EXISTING_OWNERS"
            if identity_ok and ok
            else "POST_CLEARANCE_ROUTE_COMMIT_RECONCILED_FROM_EXISTING_OWNERS"
            if post_clearance_reconciled
            else "BASELINE_RESET_NOT_PROVEN"
        ),
        "current_egress": current,
        "packet_id": str(partial.get("packet_id") or ""),
        "operation_id": str(partial.get("operation_id") or ""),
        "route_check": route,
        "switch_lineage": switch_lineage,
        "temporally_bound_switch": temporally_bound_switch,
        "post_clearance_identity_ok": post_clearance_identity_ok,
        "natural_l8_credit": False,
        "production_outcome_credit": False,
    }


def materialize_due_delayed_observations(
    state_dir: Path,
    *,
    max_observations: int = 10,
    minimum_age_seconds: int = 3600,
    now: datetime | None = None,
) -> dict[str, Any]:
    """Append verified delayed observations through the existing outcome store."""
    now = now or datetime.now(timezone.utc)
    event_path = state_dir / "execution-events.jsonl"
    records = read_jsonl_family(event_path, limit=10000)
    lease = read_json(state_dir / "operator-execution-lease.json", {})
    lease_identity = lease.get("immutable_packet_identity") if isinstance(lease.get("immutable_packet_identity"), dict) else {}
    lease_packet = lease.get("packet") if isinstance(lease.get("packet"), dict) else {}
    lease_expected = lease_packet.get("expected") if isinstance(lease_packet.get("expected"), dict) else {}
    existing_ids = {
        str(row.get("delayed_observation_id") or "")
        for row in records if row.get("delayed_observation_id")
    }
    registry = {str(row.get("ip") or ""): row for row in read_registry(state_dir / "users.registry")}
    candidates: dict[str, dict[str, Any]] = {}
    for row in records:
        if str(row.get("schema_version") or "") != "v7.execution-outcome-record.v1":
            continue
        terminal = str(row.get("terminal_outcome_classification") or "").upper()
        if terminal not in {"SUCCESS", "ROLLBACK_SUCCESS"}:
            continue
        packet_id = str(row.get("packet_id") or "")
        feedback_id = str(row.get("feedback_id") or "")
        identity = packet_id or feedback_id
        if not identity:
            continue
        candidates[identity] = row

    written = []
    skipped = []
    for identity, row in sorted(candidates.items()):
        if len(written) >= max(1, int(max_observations)):
            break
        user = str(row.get("user") or "")
        source = str(row.get("source_channel") or "")
        target = str(row.get("target_channel") or "")
        observed_raw = str(row.get("outcome_observed_at") or row.get("created_at") or "")
        try:
            observed = datetime.fromisoformat(observed_raw.replace("Z", "+00:00"))
        except ValueError:
            skipped.append({"identity": identity, "reason": "outcome_time_invalid"})
            continue
        elapsed = max(0, int((now - observed).total_seconds()))
        terminal = str(row.get("terminal_outcome_classification") or "").upper()
        observation_id = "delobs_" + operator_execution.sha256_json({
            "identity": identity, "window": "1h", "terminal": terminal,
        })[:24]
        if observation_id in existing_ids:
            skipped.append({"identity": identity, "reason": "already_materialized"})
            continue
        if elapsed < minimum_age_seconds:
            skipped.append({"identity": identity, "reason": "not_due", "elapsed_seconds": elapsed})
            continue
        current = str((registry.get(user) or {}).get("current") or "")
        route = scoped_user_route_check(state_dir, user)
        if current != target or not route.get("passed"):
            skipped.append({
                "identity": identity,
                "reason": "steady_state_not_verified",
                "current": current,
                "target": target,
                "route_check": route,
            })
            continue
        packet_id = str(row.get("packet_id") or "")
        lease_matches = packet_id and packet_id == str(lease_identity.get("packet_id") or "")
        snapshot_identity = str(row.get("input_snapshot_identity") or "")
        decision_trace_id = str(
            row.get("decision_trace_id")
            or row.get("closure_reference")
            or row.get("decision_id")
            or ""
        )
        if lease_matches:
            snapshot_identity = snapshot_identity or str(
                lease_identity.get("snapshot_bundle_hash") or lease_expected.get("snapshot_bundle_hash") or ""
            )
            decision_trace_id = decision_trace_id or str(
                lease_identity.get("decision_id") or lease_packet.get("decision_id") or ""
            )
        if not snapshot_identity or not decision_trace_id:
            skipped.append({"identity": identity, "reason": "replay_identity_missing"})
            continue
        delayed = {
            "schema_version": "v7.execution-delayed-observation.v1",
            "delayed_observation_id": observation_id,
            "feedback_id": str(row.get("feedback_id") or ""),
            "packet_id": packet_id,
            "decision_id": str(row.get("decision_id") or decision_trace_id),
            "decision_trace_id": decision_trace_id,
            "input_snapshot_identity": snapshot_identity,
            "closure_reference": str(row.get("closure_reference") or ""),
            "recommendation_id": str(row.get("recommendation_id") or ""),
            "user": user,
            "source_channel": source,
            "target_channel": target,
            "selected_moves": row.get("selected_moves") or [{"user": user, "from": source, "to": target}],
            "evidence_class": str(row.get("evidence_class") or "CONTROLLED_PRODUCTION"),
            "execution_outcome": {
                "applied": True,
                "success": terminal == "SUCCESS",
                "result": "rollback_success" if terminal == "ROLLBACK_SUCCESS" else "success",
                "terminal_state": "ROLLED_BACK" if terminal == "ROLLBACK_SUCCESS" else "APPLIED",
            },
            "verification_result": {"verification_passed": True, "current_channel": current, "route_check": route},
            "terminal_outcome_classification": terminal,
            "expected_terminal": terminal,
            "outcome_status": "rollback_success" if terminal == "ROLLBACK_SUCCESS" else "success",
            "outcome_observed_at": now.isoformat(),
            "stability_window_seconds": elapsed,
            "delayed_5m_observation": True,
            "delayed_1h_observation": True,
            "steady_state_terminal": True,
            "observation_owner": "admin_core.operator_execution_feedback + v7-user-route-check",
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "apply_executed": False,
            "users_moved": 0,
        }
        append_jsonl(event_path, delayed)
        existing_ids.add(observation_id)
        written.append(delayed)
    return {
        "schema_version": "v7.execution-delayed-observation-consumer.v1",
        "final_verdict": "PASS",
        "observations_written": len(written),
        "written": written,
        "skipped": skipped,
        "owner_store": str(event_path),
        "new_store_created": False,
        "runtime_mutation_performed": False,
        "routing_mutation_performed": False,
        "apply_executed": False,
        "users_moved": 0,
        "authority_expanded": False,
    }


def read_registry(path: Path) -> list[dict[str, str]]:
    try:
        return registry_readers.parse_registry_lines(path.read_text(encoding="utf-8").splitlines())
    except OSError:
        return []


def jsonl_family_paths(path: Path) -> list[Path]:
    candidates: list[tuple[int, Path]] = []
    try:
        matches = list(path.parent.glob(f"{path.name}.*"))
    except OSError:
        matches = []
    for item in matches:
        suffix = item.name.removeprefix(f"{path.name}.")
        if suffix.isdigit():
            candidates.append((int(suffix), item))
    ordered = [item for _, item in sorted(candidates, key=lambda pair: pair[0], reverse=True)]
    ordered.append(path)
    seen: set[str] = set()
    unique: list[Path] = []
    for item in ordered:
        key = str(item)
        if key not in seen:
            seen.add(key)
            unique.append(item)
    return unique


def read_jsonl_family(path: Path, limit: int = 5000) -> list[dict[str, Any]]:
    """Read bounded JSONL without materializing an unbounded periodic journal."""
    rows: deque[dict[str, Any]] = deque(maxlen=max(1, int(limit)))
    for item in jsonl_family_paths(path):
        try:
            opener = gzip.open if item.suffix == ".gz" else open
            with opener(item, "rt", encoding="utf-8", errors="replace") as handle:
                for line in handle:
                    if not line.strip():
                        continue
                    try:
                        parsed = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if not isinstance(parsed, dict):
                        continue
                    # Legacy Matrix lifecycle rows could contain a complete
                    # recursively embedded child response.  They are never an
                    # execution authority; retain an honest compact receipt so
                    # old journal growth cannot exhaust the live consumer.
                    if item.name.startswith("service-matrix-refresh-") and len(line) > 65536:
                        parsed = {
                            "schema_version": "v7.legacy-service-matrix-refresh-projection.v1",
                            "updated": parsed.get("updated"),
                            "status": parsed.get("status", "OK"),
                            "total": parsed.get("total"),
                            "ok_count": parsed.get("ok_count"),
                            "next_output": parsed.get("next_output", ""),
                            "capture_only": True,
                            "candidate_or_execution_forbidden": True,
                            "source_file": item.name,
                        }
                    rows.append(parsed)
        except OSError:
            continue
    return list(rows)


def default_audit_dir(state_dir: Path) -> Path:
    if len(state_dir.parents) > 1 and state_dir.name == "state" and state_dir.parent.name == "egress":
        return state_dir.parents[1] / "audit"
    return state_dir.parent / "audit"


def event_source_paths(event_dir: Path) -> list[Path]:
    paths = [
        event_dir / "telegram-sentinel.jsonl",
        event_dir / "service-matrix.jsonl",
        event_dir / "quality-regressions.jsonl",
        event_dir / "events.jsonl",
        event_dir / "l3-wake-events.jsonl",
        event_dir / "service-failure-events.jsonl",
        event_dir / "runtime-wake-events.jsonl",
        event_dir / "governance-lifecycle.jsonl",
    ]
    for pattern in ("telegram-sentinel-*.jsonl", "service-matrix-refresh-*.jsonl"):
        try:
            paths.extend(sorted(event_dir.glob(pattern))[-3:])
        except OSError:
            pass
    return list(dict.fromkeys(paths))


def event_rows(event_dir: Path, limit: int) -> list[dict[str, Any]]:
    paths = event_source_paths(event_dir)
    per_source_limit = max(100, int(limit) // max(1, len(paths)))
    rows: list[dict[str, Any]] = []
    for path in paths:
        rows.extend(read_jsonl_family(path, limit=per_source_limit))
    limit = max(0, int(limit))
    if len(rows) <= limit:
        return rows

    # Retain a bounded, latest-per-semantic-source projection before filling
    # the remainder by recency.  A busy unrelated channel must not be able to
    # push a still-fresh VLESS (or any other channel) revalidation outside the
    # executor's input window.  This is not a new store or selector: it is the
    # existing JSONL reader preserving one most-recent producer fact for each
    # (event type, affected object) within its existing bounded read budget.
    # The downstream admission still accepts only an exact source-matching,
    # fresh, provenance-bound event.
    selected: list[tuple[int, dict[str, Any]]] = []
    seen_semantic_sources: set[tuple[str, str]] = set()
    for index in range(len(rows) - 1, -1, -1):
        row = rows[index]
        if not isinstance(row, dict):
            continue
        event_type = str(row.get("event_type") or row.get("type") or "")
        affected_object = str(
            row.get("channel")
            or row.get("egress")
            or row.get("object")
            or row.get("user")
            or row.get("component")
            or ""
        )
        key = (event_type, affected_object)
        if key in seen_semantic_sources:
            continue
        seen_semantic_sources.add(key)
        selected.append((index, row))
        if len(selected) >= limit:
            break

    selected_indexes = {index for index, _ in selected}
    if len(selected) < limit:
        for index in range(len(rows) - 1, -1, -1):
            if index in selected_indexes or not isinstance(rows[index], dict):
                continue
            selected.append((index, rows[index]))
            selected_indexes.add(index)
            if len(selected) >= limit:
                break
    return [row for _, row in sorted(selected)]


def planner_observe_executable() -> Path:
    repo_tool = ROOT / "tools" / "v7-users-autoswitch"
    if repo_tool.exists():
        return repo_tool
    runtime_peer = Path(__file__).resolve().with_name("v7-users-autoswitch")
    if runtime_peer.exists():
        return runtime_peer
    return repo_tool


def snapshot_refresh_executable() -> Path:
    repo_tool = ROOT / "tools" / "v7-intelligence-snapshot-refresh"
    if repo_tool.exists():
        return repo_tool
    runtime_peer = Path(__file__).resolve().with_name("v7-intelligence-snapshot-refresh")
    if runtime_peer.exists():
        return runtime_peer
    return Path("v7-intelligence-snapshot-refresh")


def run_planner_observe(
    state_dir: Path,
    event_dir: Path,
    snapshot_root: Path,
    max_users: int,
    *,
    refresh_snapshots: bool = False,
) -> dict[str, Any]:
    command = [
        str(planner_observe_executable()),
        "--mode",
        "observe",
        "--max-selected-moves",
        str(max(1, int(max_users))),
        "--state-dir",
        str(state_dir),
        "--event-dir",
        str(event_dir),
        "--intelligence-snapshot-root",
        str(snapshot_root),
        "--pretty",
    ]
    if refresh_snapshots:
        command.extend([
            "--pre-planner-refresh",
            "write",
            "--pre-planner-refresh-command",
            str(snapshot_refresh_executable()),
