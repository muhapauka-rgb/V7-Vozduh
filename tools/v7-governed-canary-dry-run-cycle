def bounded_delegated_policy_admission(packet_preview: dict[str, Any], cycle: dict[str, Any]) -> dict[str, Any]:
    policy = autonomy_trust_acceleration.build_delegated_autonomy_policy_preview()
    selected_count = int(packet_preview.get("selected_move_count") or len(packet_preview.get("allowed_users") or []))
    action_class = "single-user governed candidate failover" if selected_count == 1 else "UNKNOWN_ACTION_CLASS"
    blockers = []
    exact_requirements = {
        "policy_state": "APPROVED",
        "current_mode": "DELEGATED_AUTONOMY",
        "max_users_per_action": 1,
        "max_concurrent_transactions": 1,
        "candidate_selection": "EXISTING_PLANNER_ONLY",
        "candidate_identity": "FRESH_ONLY",
        "packet_generation": "FRESH_IMMEDIATELY_BEFORE_EXECUTION",
        "packet_reuse": "FORBIDDEN",
        "historical_identity_reuse": "FORBIDDEN",
        "operator_candidate_approval_required": False,
        "operator_packet_approval_required": False,
        "operator_hash_approval_required": False,
        "self_expansion_allowed": False,
        "final_safe_mode": "OPEN",
    }
    for field, expected in exact_requirements.items():
        if policy.get(field) != expected:
            blockers.append(f"POLICY_{field.upper()}_MISMATCH")
    if action_class not in set(policy.get("allowed_action_classes") or []):
        blockers.append("ACTION_CLASS_NOT_ALLOWED")
    if selected_count != 1:
        blockers.append("BLAST_RADIUS_NOT_EXACTLY_ONE_USER")
    if cycle.get("stop_reason") != "AUTHORITY_BOUNDARY" or packet_preview.get("status") != "PACKET_PREVIEW_READY":
        blockers.append("LIVE_MACHINE_GATES_NOT_READY")
    if not packet_preview.get("operation_id") or not packet_preview.get("decision_id"):
        blockers.append("FRESH_OPERATION_IDENTITY_MISSING")
    if not packet_preview.get("selected_move_hash"):
        blockers.append("SELECTED_MOVE_BINDING_MISSING")
    if not packet_preview.get("source_hashes") or not packet_preview.get("snapshot_bundle_hash"):
        blockers.append("OPERATION_SCOPED_SOURCE_BINDING_MISSING")
    rollback = packet_preview.get("rollback_manifest_preview") or {}
    if not rollback.get("items"):
        blockers.append("ROLLBACK_MANIFEST_MISSING")
    blockers = list(dict.fromkeys(blockers))
    authority = {
        "authority_basis": "DELEGATED_AUTONOMY_POLICY",
        "policy_id": str(policy.get("policy_id") or ""),
        "policy_scope_hash": str(policy.get("policy_scope_hash") or ""),
        "normalized_scope": dict(policy.get("normalized_scope") or {}),
        "policy_state": str(policy.get("policy_state") or ""),
        "current_mode": str(policy.get("current_mode") or ""),
        "action_class": action_class,
        "max_users_per_transaction": int(policy.get("max_users_per_action") or 0),
        "max_concurrent_transactions": int(policy.get("max_concurrent_transactions") or 0),
        "candidate_identity": str(policy.get("candidate_identity") or ""),
        "packet_reuse": str(policy.get("packet_reuse") or ""),
        "self_expansion_allowed": bool(policy.get("self_expansion_allowed")),
        "engineering_authority_source": "V7_OMP_BOUNDED_DELEGATED_AUTONOMY_AND_PACKET_APPROVAL_RETIREMENT_V1",
    }
    return {
        "schema_version": "v7.bounded-delegated-policy-admission.v1",
        "allowed": not blockers,
        "blockers": blockers,
        "policy": policy,
        "authority": authority,
        "candidate_approval_required": False,
        "packet_approval_required": False,
        "hash_approval_required": False,
        "live_machine_gates_preserved": True,
    }


def packet_materialization_authority(
    *,
    delegated_mode: bool,
    setup_mode: bool,
    delegated_admission: dict[str, Any],
) -> dict[str, Any] | None:
    """Return only authority contracts understood by the canonical packet owner.

    Controlled-certification setup is explicitly operator-authorized and keeps
    the packet owner's existing dual-confirmation contract.  It must not be
    mislabeled as delegated autonomy merely to share the same execution path.
    """
    if delegated_mode and not setup_mode:
        authority = delegated_admission.get("authority")
        return authority if isinstance(authority, dict) and authority else None
    return None


def controlled_certification_evidence_scope(state_dir: Path, *, user: str, source: str) -> bool:
    users = {str(row.get("ip") or ""): row for row in read_registry(state_dir / "users.registry")}
    sources = {str(row.get("id") or ""): row for row in read_registry(state_dir / "egress.registry")}
    user_row = users.get(str(user or ""), {})
    source_row = sources.get(str(source or ""), {})
    return (
        str(user_row.get("certification_user") or "").lower() in {"1", "true", "yes"}
        and str(source_row.get("controlled_certification_source") or "").lower() in {"1", "true", "yes"}
    )


def _execute_l3_production_validation_inner(args: argparse.Namespace, *, state_dir: Path, event_dir: Path, snapshot_root: Path, audit_dir: Path, lease_file: Path) -> dict[str, Any]:
    if args.confirm_l3_production_validation != "EXECUTE_L3_PRODUCTION_VALIDATION_APPROVED":
        return transaction_stop("l3_production_validation_confirmation_required")
    requested_max_users = max(1, int(args.max_users))

    control_file = Path(getattr(args, "execution_control_file", operator_execution.DEFAULT_AUTONOMOUS_EXECUTION_CONTROL_FILE))
    initial_control = operator_execution.autonomous_execution_control_state(control_file)
    if not initial_control.get("valid") or initial_control.get("state") not in {"OPEN", "CLOSED"}:
        return transaction_stop("autonomous_execution_control_invalid_pre_lease", execution_control=initial_control)

    existing_lease = operator_execution.load_execution_lease(lease_file)
    existing_state = operator_execution.execution_lease_state(existing_lease)
    if existing_state.get("active"):
        return transaction_stop("active_execution_lease_exists", execution_lease_state=existing_state)

    restore_barrier_file = Path(args.restore_barrier_file) if args.restore_barrier_file else state_dir / "autoswitch-restore-barrier.json"
    restore_barrier_preflight_reset = reset_completed_restore_barrier_for_fresh_l3_validation(
        restore_barrier_file,
        existing_state if isinstance(existing_state, dict) else {},
    )
    if restore_barrier_preflight_reset.get("reason") == "restore_barrier_preflight_reset_failed":
        return transaction_stop(
            "l3_restore_barrier_preflight_reset_failed",
            restore_barrier_preflight_reset=restore_barrier_preflight_reset,
        )
    l3_plan_run = run_l3_production_validation_plan(
        state_dir=state_dir,
        event_dir=event_dir,
        snapshot_root=snapshot_root,
        restore_barrier_file=restore_barrier_file,
        max_users=requested_max_users,
        source=str(args.approved_source or ""),
        pre_planner_refresh_command=str(args.pre_planner_refresh_command or "v7-intelligence-snapshot-refresh"),
    )
    plan = l3_plan_run.get("payload") if isinstance(l3_plan_run.get("payload"), dict) else {}
    if not plan:
        return transaction_stop("l3_production_validation_plan_unavailable", l3_plan_run=l3_plan_run)
    authorized_budget = authorized_l3_budget_from_plan(plan)
    authorized_l3_budget = int(authorized_budget.get("authorized_l3_budget") or 1)
    if requested_max_users > authorized_l3_budget:
        return transaction_stop(
            "l3_production_validation_requested_users_above_authorized_budget",
            l3_plan_run=l3_plan_run,
            requested_max_users=requested_max_users,
            authorized_l3_budget=authorized_budget,
        )

    transition = operator_execution_pipeline.l3_production_validation_runtime_action_transition(plan, max_users=requested_max_users)
    if not transition.get("ok"):
        return transaction_stop(
            "l3_production_validation_transition_blocked",
            l3_plan_run=l3_plan_run,
            transition=transition,
            authorized_l3_budget=authorized_budget,
        )

    if initial_control.get("state") == "OPEN":
        selected = operator_execution.selected_moves_from_plan(plan)
        auto_window_blockers = []
        if requested_max_users != 1 or int(selected.get("selected_move_count") or 0) != 1:
            auto_window_blockers.append("l3_auto_window_requires_exactly_one_user")
        for field in ("selected_move_hash", "source_bundle_hash", "snapshot_bundle_hash"):
            if not str(selected.get(field) or ""):
                auto_window_blockers.append(f"l3_auto_window_{field}_missing")
        if auto_window_blockers:
            return transaction_stop(
                "l3_operation_scoped_control_binding_incomplete",
                blockers=auto_window_blockers,
                selected_move_count=int(selected.get("selected_move_count") or 0),
            )
        controlled_window = operator_execution.build_autonomous_execution_control_state(
            False,
            actor=str(args.approval_author or "operator"),
            reason="l3_production_validation_one_operation_window",
            operation_id="l3-production-validation-pending",
            selected_move_hash=str(selected.get("selected_move_hash") or ""),
            action_class="EMERGENCY_FAILOVER",
            source_bundle_hash=str(selected.get("source_bundle_hash") or ""),
            snapshot_bundle_hash=str(selected.get("snapshot_bundle_hash") or ""),
            max_users=1,
        )
        try:
            packet = operator_execution.packet_from_plan(
                plan,
                approval_author=args.approval_author,
                approval_reviewer=args.approval_reviewer,
                ttl_seconds=args.ttl_seconds,
                breaker_generation=str(controlled_window.get("generation") or ""),
            )
        except Exception as exc:
            return transaction_stop("l3_packet_materialization_failed", l3_plan_run=l3_plan_run, transition=transition, error=str(exc))
        controlled_window["operation_id"] = str(packet.get("operation_id") or "")
        operator_execution.write_json_atomic(control_file, controlled_window)
        args._l3_controlled_window_generation = str(controlled_window.get("generation") or "")
        args._l3_controlled_window_operation_id = str(controlled_window.get("operation_id") or "")
        preflight_control = operator_execution.autonomous_execution_control_decision(
            control_file,
            mutation_kind="forward",
            action_class="EMERGENCY_FAILOVER",
            expected_generation=str(controlled_window.get("generation") or ""),
            operation_id=str(packet.get("operation_id") or ""),
            selected_move_hash=str((packet.get("expected") or {}).get("selected_move_hash") or ""),
            source_bundle_hash=str((packet.get("expected") or {}).get("source_bundle_hash") or ""),
            snapshot_bundle_hash=str((packet.get("expected") or {}).get("snapshot_bundle_hash") or ""),
            max_users=1,
        )
        if not preflight_control.get("allowed_forward_mutation"):
            return transaction_stop("autonomous_execution_control_denied_pre_lease", execution_control=preflight_control)
    else:
        preflight_control = operator_execution.autonomous_execution_control_decision(
            control_file,
            mutation_kind="forward",
            action_class="EMERGENCY_FAILOVER",
            operation_id="l3-production-validation",
        )
        if not preflight_control.get("allowed_forward_mutation"):
            return transaction_stop("autonomous_execution_control_denied_pre_lease", execution_control=preflight_control)
        try:
            packet = operator_execution.packet_from_plan(
                plan,
                approval_author=args.approval_author,
                approval_reviewer=args.approval_reviewer,
                ttl_seconds=args.ttl_seconds,
                breaker_generation=str(preflight_control.get("generation") or ""),
            )
        except Exception as exc:
            return transaction_stop("l3_packet_materialization_failed", l3_plan_run=l3_plan_run, transition=transition, error=str(exc))

    try:
        packet_identity = operator_execution.packet_identity(packet)
    except Exception as exc:
        return transaction_stop("l3_packet_identity_invalid", l3_plan_run=l3_plan_run, transition=transition, error=str(exc))

    constraints = l3_packet_constraints_ok(
        packet,
        transition,
        requested_max_users,
        authorized_l3_budget=authorized_l3_budget,
    )
    if not constraints.get("ok"):
        return transaction_stop(
            "l3_transaction_scope_invalid",
            l3_plan_run=l3_plan_run,
            transition=transition,
            packet=operator_execution.redact(packet),
            constraints=constraints,
            authorized_l3_budget=authorized_budget,
        )

    users = constraints["users"]
    targets = constraints["targets"]
    rollback_items = (packet.get("rollback_manifest") or {}).get("items") or []
    sources = [str(item.get("rollback_target") or "") for item in rollback_items if isinstance(item, dict) and str(item.get("rollback_target") or "")]
    user = users[0] if users else ""
    target = targets[0] if targets else ""
    source = sources[0] if sources else ""
    lease = operator_execution.create_execution_lease_from_packet(packet, source_preview=plan)
    lease_create_result = operator_execution.write_execution_lease(lease_file, lease)
    if not lease_create_result.get("ok"):
        return transaction_stop(
            "l3_execution_lease_not_created",
            l3_plan_run=l3_plan_run,
            transition=transition,
            execution_lease_create_result=lease_create_result,
        )

    audit_store = audit_dir / "operator-execution-audit.jsonl"
    lifecycle_store = audit_dir / "governance-lifecycle.jsonl"
    clearance_result = operator_execution.execute_packet(
        packet,
        audit_store,
        state_dir,
        mode="runtime_action",
        planner_snapshot=plan,
        restore_barrier_file=restore_barrier_file,
        lifecycle_store=lifecycle_store,
    )
    if not clearance_result.get("execution_allowed_now"):
        terminal = operator_execution.finish_execution_lease(
            lease_file,
            status="OPERATOR_CANCELLED",
            reason="l3_transaction_stop_safe_before_apply",
            operation={"terminal_state": "STOP_SAFE", "terminal_reason": "restore_barrier_clearance_denied", "apply_result": {"applied": False, "results": []}},
        )
        return transaction_stop(
            "l3_restore_barrier_clearance_denied",
            l3_plan_run=l3_plan_run,
            transition=transition,
            packet=operator_execution.redact(packet),
            execution_lease_create_result=lease_create_result,
            clearance_result=clearance_result,
            lease_terminalization=terminal,
        )

    pre_apply_control = operator_execution.autonomous_execution_control_decision(
        control_file,
        mutation_kind="forward",
        action_class="EMERGENCY_FAILOVER",
        expected_generation=str(packet_identity.get("breaker_generation") or ""),
        operation_id=str(packet_identity.get("operation_id") or ""),
    )
    if not pre_apply_control.get("allowed_forward_mutation"):
        terminal = operator_execution.finish_execution_lease(
            lease_file,
            status="OPERATOR_CANCELLED",
            reason="autonomous_execution_control_denied_pre_apply",
            operation={"terminal_state": "STOP_SAFE", "terminal_reason": "execution_control_changed", "apply_result": {"applied": False, "results": []}},
        )
        return transaction_stop(
            "autonomous_execution_control_denied_pre_apply",
            execution_control=pre_apply_control,
            lease_terminalization=terminal,
        )

    apply_run = run_autoswitch_apply(
        state_dir=state_dir,
        event_dir=event_dir,
        snapshot_root=snapshot_root,
        restore_barrier_file=restore_barrier_file,
        user=user if constraints["selected_move_count"] == 1 else "",
        source=source if constraints["selected_move_count"] == 1 else "",
        target=target if constraints["selected_move_count"] == 1 else "",
        max_users=requested_max_users,
        packet_id=str(packet_identity.get("packet_id") or ""),
        operation_id=str(packet_identity.get("operation_id") or ""),
        selected_move_hash=str(packet_identity.get("selected_move_hash") or ""),
        authority_generation=str(packet_identity.get("authority_generation") or ""),
        breaker_generation=str(packet_identity.get("breaker_generation") or ""),
        execution_control_file=str(control_file),
        emergency_failover_autonomy=True,
    )
    apply_payload = apply_run.get("payload") if isinstance(apply_run.get("payload"), dict) else {}
    operation = dict(apply_payload.get("operation") or {})
    operation["apply_result"] = apply_payload.get("apply_result") if isinstance(apply_payload.get("apply_result"), dict) else {}
    terminal_status = lease_terminal_status_from_apply(apply_payload)
    lease_terminalization = operator_execution.finish_execution_lease(
        lease_file,
        status=terminal_status,
        reason=str(operation.get("terminal_reason") or "l3_production_validation_complete"),
        operation=operation,
    )
    apply_result = apply_payload.get("apply_result") if isinstance(apply_payload.get("apply_result"), dict) else {}
    results = apply_result.get("results") if isinstance(apply_result.get("results"), list) else []
    l3_learning = apply_payload.get("l3_learning_closure") if isinstance(apply_payload.get("l3_learning_closure"), dict) else {}
    capability_state = l3_learning.get("capability_state") if isinstance(l3_learning.get("capability_state"), dict) else {}
    production_proof_quality = l3_production_validation_proof_quality(apply_run, apply_payload)
    production_proven = bool(capability_state.get("production_proven")) and bool(production_proof_quality.get("ok"))
    verification_passed = bool(results) and all(
        int(row.get("verify_rc", 1)) == 0
        and (row.get("service_verify_rc") is None or int(row.get("service_verify_rc", 1)) == 0)
        for row in results
        if isinstance(row, dict)
    )
    rollback_attempted = any(bool(row.get("rollback_attempted")) for row in results if isinstance(row, dict))
    controlled_evidence = controlled_certification_evidence_scope(state_dir, user=user, source=source)
    feedback_materialization = (
        materialize_governed_transaction_feedback(
            state_dir=state_dir,
            packet=packet,
            operation=operation,
            apply_result=apply_result,
            user=user,
            source=source,
            target=target,
            rollback_attempted=rollback_attempted,
            verification_passed=verification_passed,
            evidence_class="CONTROLLED_PRODUCTION",
        )
        if controlled_evidence
        else {"materialized": False, "reason": "not_controlled_certification_scope"}
    )
    return {
        "schema_version": "v7.l3-production-validation-execution.v1",
        "transaction_status": "COMPLETED" if production_proven else "STOP_SAFE",
        "final_verdict": "L3_PRODUCTION_PROVEN" if production_proven else "STOP_SAFE",
        "stop_reason": "" if production_proven else "l3_production_validation_downstream_proof_failed",
        "fresh_packet_id": packet.get("packet_id", ""),
        "decision_id": packet.get("decision_id", ""),
        "operation_id": packet.get("operation_id", ""),
        "selected_move_hash": (packet.get("expected") or {}).get("selected_move_hash", ""),
        "user": user,
        "users": users,
        "source": source,
        "sources": sorted(set(sources)),
        "target": target,
        "targets": targets,
        "requested_max_users": requested_max_users,
        "authorized_l3_budget": authorized_budget,
        "one_execution_attempt": constraints["selected_move_count"] == 1,
        "runtime_mutation_performed": bool(apply_result.get("applied")),
        "restore_barrier_written_now": bool((clearance_result.get("clearance_result") or {}).get("ok")),
        "apply_executed": bool(apply_result.get("applied")),
        "verification_result": "PASS" if verification_passed else ("NOT_RUN" if not results else "FAIL"),
        "rollback_attempted": rollback_attempted,
        "rollback_result": operation.get("rollback_verdict", "NOT_REQUIRED"),
        "controlled_certification_evidence": controlled_evidence,
