@contextlib.contextmanager
def service_matrix_read_lock(state_dir: Path, timeout_sec: int = MATRIX_GENERATION_LOCK_TIMEOUT_SECONDS):
    """Reuse the canonical Matrix writer lock for a bounded generation read."""
    lock_path = state_dir / "service-matrix.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600)
    started = time.monotonic()
    acquired = False
    try:
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                acquired = True
                break
            except BlockingIOError:
                if time.monotonic() - started >= max(1, int(timeout_sec or 1)):
                    raise TimeoutError("service_matrix_generation_lock_timeout")
                time.sleep(0.02)
        yield {"path": str(lock_path), "acquired": True}
    finally:
        if acquired:
            fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def capture_matrix_generation(
    *,
    state_dir: Path,
    service_matrix_file: Path,
    freshness_limit_seconds: int = 120,
) -> tuple[dict[str, Any], dict[str, Any]]:
    """Capture one complete Matrix generation without creating another truth source."""
    started = time.monotonic_ns()
    with service_matrix_read_lock(state_dir):
        matrix = read_json(service_matrix_file, {"items": {}})
        if not isinstance(matrix, dict):
            matrix = {"items": {}}
        content_fingerprint = sha256_json(matrix)
        items = matrix.get("items") if isinstance(matrix.get("items"), dict) else {}
        identity_generations = {
            str(egress_id): str(row.get("egress_identity_generation") or "")
            for egress_id, row in items.items()
            if isinstance(row, dict)
        }
        config_generations = {
            str(egress_id): str(row.get("egress_config_generation") or "")
            for egress_id, row in items.items()
            if isinstance(row, dict)
        }
        updated = str(matrix.get("updated") or "")
        generation_id = "matrixgen_" + sha256_json({
            "content_fingerprint": content_fingerprint,
            "updated": updated,
            "identity_generations": identity_generations,
            "config_generations": config_generations,
        })[:32]
    captured_at = datetime.now(timezone.utc).isoformat()
    generation = {
        "schema": "v7.canonical-matrix-generation-handoff.v1",
        "generation_id": generation_id,
        "content_fingerprint": content_fingerprint,
        "source_egress": sorted(str(item) for item in items),
        "source_identity_generations": identity_generations,
        "topology_config_generations": config_generations,
        "measured_at": updated or captured_at,
        "captured_at": captured_at,
        "freshness_limit_seconds": max(1, int(freshness_limit_seconds)),
        "owner": "tools/v7-service-matrix-test + tools/v7-service-matrix-refresh-all",
        "writer_paused_for_benchmark": False,
        "second_health_truth": False,
    }
    handoff = {
        "schema": "v7.stable-matrix-generation-handoff.v1",
        "generation": generation,
        "matrix": matrix,
        "capture_wall_ms": round((time.monotonic_ns() - started) / 1_000_000.0, 3),
        "lock_hold_wall_ms": round((time.monotonic_ns() - started) / 1_000_000.0, 3),
    }
    return matrix, handoff


def matrix_service_projection(matrix: dict[str, Any]) -> dict[str, Any]:
    """Return the bounded service facts that may not drift after handoff."""
    items = matrix.get("items") if isinstance(matrix, dict) else {}
    if not isinstance(items, dict):
        return {}
    projection: dict[str, Any] = {}
    for egress_id, row in sorted(items.items(), key=lambda pair: str(pair[0])):
        if not isinstance(row, dict):
            continue
        projection[str(egress_id)] = {
            "services": row.get("services") if isinstance(row.get("services"), dict) else {},
            "status": row.get("status"),
            "ok_count": row.get("ok_count"),
            "total": row.get("total"),
            "count": row.get("count"),
            "egress_identity_generation": row.get("egress_identity_generation"),
            "egress_config_generation": row.get("egress_config_generation"),
        }
    return projection


def matrix_generation_freshness(generation: dict[str, Any]) -> tuple[bool, str, float]:
    measured_at = str(generation.get("measured_at") or "")
    try:
        parsed = datetime.fromisoformat(measured_at.replace("Z", "+00:00"))
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=timezone.utc)
        age_seconds = max(0.0, (datetime.now(timezone.utc) - parsed.astimezone(timezone.utc)).total_seconds())
    except (TypeError, ValueError):
        return False, "matrix_generation_measured_at_invalid", -1.0
    limit = max(1, int(generation.get("freshness_limit_seconds") or 0))
    if limit <= 0 or age_seconds > limit:
        return False, "matrix_generation_stale", age_seconds
    return True, "fresh", age_seconds


def load_inputs(
    *,
    state_dir: Path,
    service_matrix_file: Path,
    quality_summary_file: Path,
    service_preferences_file: Path,
    audit_paths: list[Path],
    feedback_paths: list[Path] | None = None,
    switch_history_file: Path,
    rollback_history_file: Path,
    history_record_limit: int = JSONL_FAMILY_READ_LIMIT,
    history_read_bytes: int = JSONL_FAMILY_READ_BYTES,
    service_matrix_override: dict[str, Any] | None = None,
) -> dict[str, Any]:
    audit_records = []
    for path in audit_paths:
        audit_records.extend(read_jsonl_family(
            path, limit=history_record_limit, max_bytes=history_read_bytes,
        ))
    for path in feedback_paths or []:
        audit_records.extend(read_jsonl_family(
            path, limit=history_record_limit, max_bytes=history_read_bytes,
        ))
    users = read_registry(state_dir / "users.registry")
    egress = read_registry(state_dir / "egress.registry")
    return {
        "service_matrix": (
            service_matrix_override
            if isinstance(service_matrix_override, dict)
            else read_json(service_matrix_file, {"items": {}})
        ),
        "quality_summary": read_json(quality_summary_file, {"items": {}}),
        "service_preferences": read_json(service_preferences_file, {}),
        "audit_records": audit_records,
        "switch_records": read_jsonl_family(
            switch_history_file, limit=history_record_limit, max_bytes=history_read_bytes,
        ),
        "rollback_records": read_jsonl_family(
            rollback_history_file, limit=history_record_limit, max_bytes=history_read_bytes,
        ),
        "runtime_state": read_json(state_dir / "v7-state.json", {}),
        "users_registry": users,
        "egress_registry": egress,
    }


def jsonl_family_paths(path: Path) -> list[Path]:
    """Return rotated JSONL family paths in oldest-to-newest order.

    Runtime log rotation keeps real governed evidence in files such as
    `execution-events.jsonl.1`. These are the same evidence store family, not
    a new truth source, so normal snapshot refresh must consume them.
    """
    base = Path(path)
    candidates: list[tuple[int, Path]] = []
    parent = base.parent
    try:
        matches = list(parent.glob(f"{base.name}.*"))
    except OSError:
        matches = []
    for item in matches:
        suffix = item.name.removeprefix(f"{base.name}.")
        if suffix.isdigit():
            candidates.append((int(suffix), item))
    ordered = [item for _, item in sorted(candidates, key=lambda pair: pair[0], reverse=True)]
    ordered.append(base)
    seen: set[str] = set()
    unique: list[Path] = []
    for item in ordered:
        key = str(item)
        if key in seen:
            continue
        seen.add(key)
        unique.append(item)
    return unique


def read_jsonl_family(
    path: Path,
    *,
    limit: int = JSONL_FAMILY_READ_LIMIT,
    max_bytes: int = JSONL_FAMILY_READ_BYTES,
) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    for item in jsonl_family_paths(path):
        rows.extend(read_jsonl_tail(item, limit=limit, max_bytes=max_bytes))
    return rows[-limit:]


def source_hashes_for_inputs(inputs: dict[str, Any]) -> dict[str, str]:
    return {
        "service_matrix": sha256_json(inputs.get("service_matrix") or {}),
        "quality_summary": sha256_json(inputs.get("quality_summary") or {}),
        "service_preferences": sha256_json(inputs.get("service_preferences") or {}),
    }


def service_snapshot_hashes(result) -> dict[str, str]:
    payload = result.snapshots.get("service-scores") or {}
    hashes = payload.get("source_hashes") if isinstance(payload, dict) else {}
    return dict(hashes) if isinstance(hashes, dict) else {}


def source_consistency_errors(
    result,
    latest_inputs: dict[str, Any],
    *,
    stable_matrix_hash: str = "",
) -> list[str]:
    expected = source_hashes_for_inputs(latest_inputs)
    if stable_matrix_hash:
        expected["service_matrix"] = stable_matrix_hash
    actual = service_snapshot_hashes(result)
    errors = []
    for key, value in expected.items():
        if actual.get(key) and actual.get(key) != value:
            errors.append(f"source_changed_during_snapshot_build:{key}")
    return errors


def build_current_state_snapshots(
    *,
    inputs: dict[str, Any],
    current_state_user: str = "",
) -> WorkerRunResult:
    """Build only the required current-state projection for a bounded setup.

    Prediction, learning and broad pool projections remain owned by the
    ordinary Engineering refresh.  The governed selection owner does require
    a fresh candidate-suitability projection to bind its exact user/target
    check to the same service/trust/risk generation, so that single current
    projection is included without rebuilding the other advisory surfaces.
    """
    started = time.perf_counter()
    generated_at = datetime.now(timezone.utc).isoformat()
    snapshots = build_service_score_snapshots(
        service_matrix=inputs["service_matrix"],
        quality_summary=inputs["quality_summary"],
        service_preferences=inputs["service_preferences"],
        generated_at=generated_at,
    )
    trust = build_trust_snapshot(
        audit_records=inputs["audit_records"],
        switch_records=inputs["switch_records"],
        rollback_records=inputs["rollback_records"],
        generated_at=generated_at,
    )
    snapshots["trust-summaries"] = trust
    risk = build_risk_snapshot(
        service_scores_snapshot=snapshots["service-scores"],
        channel_service_scores_snapshot=snapshots["channel-service-scores"],
        quality_summary=inputs["quality_summary"],
        generated_at=generated_at,
    )
    snapshots["risk-summaries"] = risk
    snapshots["blast-radius-summaries"] = build_blast_radius_snapshot(
        trust_summary_snapshot=trust,
        risk_summary_snapshot=risk,
        total_users=len(inputs["users_registry"]),
        affected_candidates=0,
        generated_at=generated_at,
    )
    candidate_users = inputs["users_registry"]
    if current_state_user:
        candidate_users = [
            row for row in candidate_users
            if str(row.get("ip") or row.get("user") or "") == current_state_user
        ]
    snapshots["candidate-suitability-summary"] = build_candidate_suitability_snapshot(
        service_matrix=inputs["service_matrix"],
        quality_summary=inputs["quality_summary"],
        service_preferences=inputs["service_preferences"],
        users_registry=candidate_users,
        egress_registry=inputs["egress_registry"],
        trust_summary_snapshot=trust,
        risk_summary_snapshot=risk,
        blast_radius_snapshot=snapshots["blast-radius-summaries"],
        generated_at=generated_at,
    )
    snapshots["best-available-pool"] = build_best_available_pool_snapshot(
        candidate_suitability_snapshot=snapshots["candidate-suitability-summary"],
        runtime_state=inputs["runtime_state"],
        egress_registry=inputs["egress_registry"],
        generated_at=generated_at,
    )
    statuses = {
        name: {
            "schema": payload.get("schema"),
            "freshness_state": payload.get("freshness_state"),
            "confidence": payload.get("confidence"),
            "runtime_behavior": "ALLOW",
            "warnings": payload.get("warnings", []),
        }
        for name, payload in snapshots.items()
    }
    snapshots["overview-summary"] = build_overview_snapshot(
        runtime_state=inputs["runtime_state"],
        users_registry=inputs["users_registry"],
        egress_registry=inputs["egress_registry"],
        snapshot_statuses=statuses,
        generated_at=generated_at,
    )
    warnings: list[str] = []
    for name, payload in snapshots.items():
        validation = validate_snapshot(payload, name)
        if not validation.ok:
            warnings.extend(f"{name}:{error}" for error in validation.errors)
    sizes = {
        name: len(json.dumps(payload, ensure_ascii=False, sort_keys=True).encode("utf-8"))
        for name, payload in snapshots.items()
    }
    return WorkerRunResult(
        snapshots=snapshots,
        metrics={
            "elapsed_ms": round((time.perf_counter() - started) * 1000.0, 3),
            "snapshot_count": len(snapshots),
            "snapshot_sizes": sizes,
            "total_snapshot_bytes": sum(sizes.values()),
            "max_snapshot_bytes": max(sizes.values()) if sizes else 0,
            "candidate_scope": {
                "mode": "EXACT_USER" if current_state_user else "ALL_ENABLED_USERS",
                "requested_user": current_state_user or None,
                "candidate_user_count": len(candidate_users),
            },
        },
        warnings=warnings,
    )


def build_stable_snapshot_run(
    *,
    state_dir: Path,
    service_matrix_file: Path,
    quality_summary_file: Path,
    service_preferences_file: Path,
    audit_paths: list[Path],
    feedback_paths: list[Path] | None = None,
    switch_history_file: Path,
    rollback_history_file: Path,
    total_users: int,
    affected_candidates: int,
    max_source_retries: int,
    source_retry_sleep_sec: float,
    history_record_limit: int = JSONL_FAMILY_READ_LIMIT,
    history_read_bytes: int = JSONL_FAMILY_READ_BYTES,
    current_state_window: bool = False,
    current_state_user: str = "",
    stable_matrix_generation_handoff: bool = False,
) -> tuple[Any, dict[str, Any]]:
    attempts = max(1, int(max_source_retries) + 1)
    last_errors: list[str] = []
    last_result = None
    stable_matrix: dict[str, Any] | None = None
    matrix_handoff: dict[str, Any] = {}
    stable_generation_age_seconds = -1.0
    if stable_matrix_generation_handoff:
        try:
            stable_matrix, matrix_handoff = capture_matrix_generation(
                state_dir=state_dir,
                service_matrix_file=service_matrix_file,
            )
        except TimeoutError as exc:
            return None, {
                "source_stable": False,
                "source_consistency_attempts": 0,
                "source_consistency_errors": [str(exc)],
                "stable_matrix_generation_handoff": {
                    "status": "STOP_SAFE",
                    "blocker": str(exc),
                },
            }
        generation = dict(matrix_handoff.get("generation") or {})
        fresh, freshness_reason, freshness_age = matrix_generation_freshness(generation)
        stable_generation_age_seconds = freshness_age
        if not fresh:
            return None, {
                "source_stable": False,
                "source_consistency_attempts": 0,
                "source_consistency_errors": [freshness_reason],
                "stable_matrix_generation_handoff": {
                    "status": "STOP_SAFE",
                    "generation": generation,
                    "freshness_age_seconds": round(freshness_age, 3),
                    "consumer_reads_one_completed_generation": False,
                },
            }
    for attempt in range(1, attempts + 1):
        inputs = load_inputs(
            state_dir=state_dir,
            service_matrix_file=service_matrix_file,
            quality_summary_file=quality_summary_file,
            service_preferences_file=service_preferences_file,
            audit_paths=audit_paths,
            feedback_paths=feedback_paths or [],
            switch_history_file=switch_history_file,
            rollback_history_file=rollback_history_file,
            history_record_limit=history_record_limit,
            history_read_bytes=history_read_bytes,
            service_matrix_override=stable_matrix,
        )
        result = (
            build_current_state_snapshots(
                inputs=inputs,
                current_state_user=current_state_user,
            )
            if current_state_window
            else build_all_snapshots(
                service_matrix=inputs["service_matrix"],
                quality_summary=inputs["quality_summary"],
                service_preferences=inputs["service_preferences"],
                audit_records=inputs["audit_records"],
                switch_records=inputs["switch_records"],
                rollback_records=inputs["rollback_records"],
                runtime_state=inputs["runtime_state"],
                users_registry=inputs["users_registry"],
                egress_registry=inputs["egress_registry"],
                total_users=total_users or len(inputs["users_registry"]),
                affected_candidates=affected_candidates,
            )
        )
        latest_inputs = load_inputs(
            state_dir=state_dir,
            service_matrix_file=service_matrix_file,
            quality_summary_file=quality_summary_file,
            service_preferences_file=service_preferences_file,
            audit_paths=[],
            feedback_paths=feedback_paths or [],
            switch_history_file=switch_history_file,
            rollback_history_file=rollback_history_file,
            history_record_limit=history_record_limit,
            history_read_bytes=history_read_bytes,
        )
        stable_hash = (
            str((matrix_handoff.get("generation") or {}).get("content_fingerprint") or "")
            if stable_matrix_generation_handoff else ""
        )
        last_errors = source_consistency_errors(
            result,
            latest_inputs,
            stable_matrix_hash=stable_hash,
        )
        last_result = result
        if not last_errors:
            status = {
                "source_stable": True,
                "source_consistency_attempts": attempt,
                "source_consistency_errors": [],
            }
            if stable_matrix_generation_handoff:
                current_matrix_path_ok = service_matrix_file.exists()
                current_matrix = latest_inputs.get("service_matrix") or {}
                current_hash = sha256_json(current_matrix)
                generation = dict(matrix_handoff.get("generation") or {})
                generation["writer_advanced_during_build"] = bool(
                    current_hash and stable_hash and current_hash != stable_hash
                )
                if not current_matrix_path_ok:
                    status["source_stable"] = False
                    status["source_consistency_errors"] = [
                        "stable_matrix_generation_source_unavailable"
                    ]
                    status["stable_matrix_generation_handoff"] = {
                        "status": "STOP_SAFE",
                        "generation": generation,
                        "consumer_reads_one_completed_generation": False,
                        "mixed_matrix_generation_read": False,
                    }
                    return result, status
                if matrix_service_projection(current_matrix) != matrix_service_projection(stable_matrix or {}):
                    status["source_stable"] = False
                    status["source_consistency_errors"] = [
                        "required_service_state_changed_after_matrix_generation"
                    ]
                    status["stable_matrix_generation_handoff"] = {
                        "status": "STOP_SAFE",
                        "generation": generation,
                        "consumer_reads_one_completed_generation": False,
                        "mixed_matrix_generation_read": False,
                    }
                    return result, status
                status["stable_matrix_generation_handoff"] = {
                    "status": "PASS",
                    "generation": generation,
                    "freshness_age_seconds": round(stable_generation_age_seconds, 3),
                    "capture_wall_ms": matrix_handoff.get("capture_wall_ms", 0),
                    "lock_hold_wall_ms": matrix_handoff.get("lock_hold_wall_ms", 0),
                    "consumer_reads_one_completed_generation": True,
                    "mixed_matrix_generation_read": False,
                }
                for payload in result.snapshots.values():
                    if isinstance(payload, dict):
                        payload["matrix_generation"] = generation
            return result, status
        if attempt < attempts and source_retry_sleep_sec > 0:
            time.sleep(source_retry_sleep_sec)
    return last_result, {
        "source_stable": False,
        "source_consistency_attempts": attempts,
        "source_consistency_errors": last_errors,
        **(
            {
                "stable_matrix_generation_handoff": {
                    "status": "BLOCKED",
                    "generation": matrix_handoff.get("generation") or {},
                    "consumer_reads_one_completed_generation": False,
                }
            }
            if stable_matrix_generation_handoff else {}
        ),
    }


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    if args.current_state_user and not args.current_state_window:
        raise SystemExit("--current-state-user requires --current-state-window")
    state_dir = Path(args.state_dir)
    event_dir = Path(args.event_dir)
    service_matrix_file = Path(args.service_matrix_file) if args.service_matrix_file else state_dir / "service-matrix.json"
    quality_summary_file = Path(args.quality_summary_file) if args.quality_summary_file else state_dir / "egress-quality-summary.json"
    service_preferences_file = Path(args.service_preferences_file) if args.service_preferences_file else state_dir / "service-preferences.json"
    switch_history_file = Path(args.switch_history_file) if args.switch_history_file else event_dir / "switch-history.jsonl"
    rollback_history_file = Path(args.rollback_history_file) if args.rollback_history_file else event_dir / "rollback-history.jsonl"
    execution_events_file = Path(args.execution_events_file) if args.execution_events_file else state_dir / "execution-events.jsonl"
    runtime_trust_file = Path(args.runtime_trust_file) if args.runtime_trust_file else state_dir / "runtime-trust.jsonl"
    proposal_records_file = Path(args.proposal_records_file) if args.proposal_records_file else state_dir / "proposal-records.jsonl"
    closure_records_file = Path(args.closure_records_file) if args.closure_records_file else state_dir / "closure-records.jsonl"
    audit_dir = Path(args.audit_dir) if args.audit_dir else default_audit_dir(state_dir)
    audit_paths = [Path(path) for path in args.audit_log]
    if not audit_paths:
        audit_paths.extend([
            switch_history_file,
            audit_dir / "audit.jsonl",
            audit_dir / "operator-execution-audit.jsonl",
            audit_dir / "operator-runtime-governance-actions.jsonl",
        ])
    feedback_paths = [Path(path) for path in args.feedback_log]
    if not feedback_paths:
        feedback_paths.extend([
            execution_events_file,
            runtime_trust_file,
            proposal_records_file,
            state_dir / "proposals.jsonl",
            closure_records_file,
        ])
    history_record_limit = (
        CURRENT_STATE_HISTORY_RECORD_LIMIT
        if args.current_state_window
        else JSONL_FAMILY_READ_LIMIT
    )
    history_read_bytes = (
        CURRENT_STATE_HISTORY_READ_BYTES
        if args.current_state_window
        else JSONL_FAMILY_READ_BYTES
    )

    result, source_status = build_stable_snapshot_run(
        state_dir=state_dir,
        service_matrix_file=service_matrix_file,
        quality_summary_file=quality_summary_file,
        service_preferences_file=service_preferences_file,
        audit_paths=audit_paths,
        feedback_paths=feedback_paths,
        switch_history_file=switch_history_file,
        rollback_history_file=rollback_history_file,
        total_users=args.total_users,
        affected_candidates=args.affected_candidates,
        max_source_retries=args.max_source_retries,
        source_retry_sleep_sec=args.source_retry_sleep_sec,
        history_record_limit=history_record_limit,
        history_read_bytes=history_read_bytes,
        current_state_window=bool(args.current_state_window),
        current_state_user=(args.current_state_user if args.current_state_window else ""),
        stable_matrix_generation_handoff=bool(args.stable_matrix_generation_handoff),
    )
    written = (
        {}
        if args.dry_run or not source_status["source_stable"] or result is None
        else write_snapshots(Path(args.out_dir), result.snapshots)
    )
    warnings = list(result.warnings) if result is not None else []
    if not source_status["source_stable"]:
        warnings.extend(source_status["source_consistency_errors"])
    payload = {
        "schema": "v7.intelligence-snapshot-refresh-result.v1",
        "dry_run": bool(args.dry_run),
        "history_window": {
            "mode": (
                "CURRENT_STATE_BOUNDED"
                if args.current_state_window
                else "EXTENDED_EVIDENCE"
            ),
            "record_limit": history_record_limit,
            "read_bytes_limit": history_read_bytes,
            "historical_evidence_retained_in_canonical_stores": True,
            "candidate_scope": (
                "EXACT_USER" if args.current_state_user else "ALL_ENABLED_USERS"
            ),
        },
        **source_status,
        "snapshot_count": len(result.snapshots) if result is not None else 0,
        "written": written,
        "metrics": result.metrics if result is not None else {},
        "warnings": warnings,
        "audit_inputs": [str(path) for path in audit_paths],
        "feedback_inputs": [str(path) for path in feedback_paths],
        "runtime_behavior_changed": False,
        "governance_behavior_changed": False,
        "users_moved": False,
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=True))
    return 0 if source_status["source_stable"] else 2


if __name__ == "__main__":
    raise SystemExit(main())
