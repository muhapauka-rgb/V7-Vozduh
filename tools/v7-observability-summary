DEFAULT_STATE_DIR = Path("/opt/v7/egress/state")
DEFAULT_POLICY_FILE = Path("/etc/v7/policy.json")
DEFAULT_ORG_POLICY_FILE = Path("/etc/v7/org-egress-policy.json")
SAFE_ID_RE = re.compile(r"^[A-Za-z0-9_.:-]{1,64}$")


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def parse_ts(value: Any) -> float:
    text = str(value or "").strip()
    if not text:
        return 0.0
    try:
        return datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return 0.0


def age_seconds(value: Any) -> int | None:
    ts = parse_ts(value)
    if ts <= 0:
        return None
    return max(0, int(time.time() - ts))


def read_json(path: Path, default: Any) -> tuple[Any, str]:
    try:
        return json.loads(path.read_text(encoding="utf-8")), ""
    except FileNotFoundError:
        return default, "missing"
    except json.JSONDecodeError as exc:
        return default, f"json_error:line={exc.lineno}:{exc.msg}"
    except OSError as exc:
        return default, f"read_error:{exc}"


def parse_kv_line(line: str) -> dict[str, str]:
    row: dict[str, str] = {}
    for part in line.strip().split():
        if "=" not in part:
            continue
        key, value = part.split("=", 1)
        row[key.strip()] = value.strip()
    return row


def read_registry(path: Path) -> tuple[list[dict[str, str]], str]:
    try:
        rows = []
        for raw in path.read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            row = parse_kv_line(line)
            if row:
                rows.append(row)
        return rows, ""
    except FileNotFoundError:
        return [], "missing"
    except OSError as exc:
        return [], f"read_error:{exc}"


def bool_enabled(value: Any, default: bool = True) -> bool:
    if value is None or value == "":
        return default
    return str(value).strip().lower() in {"1", "true", "yes", "on", "enabled"}


def status_rank(status: str) -> int:
    order = {
        "healthy": 0,
        "ok": 0,
        "advisory": 1,
        "recovering": 1,
        "warm": 2,
        "unknown": 3,
        "degraded": 4,
        "high": 4,
        "full": 5,
        "unstable": 5,
        "overloaded": 5,
        "maintenance": 5,
        "quarantined": 5,
        "blocked": 6,
    }
    return order.get(status, 4)


def worst_status(statuses: list[str]) -> str:
    if not statuses:
        return "unknown"
    return max(statuses, key=status_rank)


def severity_for(status: str) -> str:
    if status == "blocked":
        return "blocker"
    if status in {"unstable", "overloaded", "full"}:
        return "critical"
    if status in {"degraded", "maintenance", "quarantined", "unknown", "high"}:
        return "warning"
    if status in {"recovering", "advisory", "warm"}:
        return "info"
    return "ok"


@dataclass
class Group:
    status: str
    reason: str
    affected: int = 0
    suggested_action: str = "no action required"

    def as_dict(self) -> dict[str, Any]:
        return {
            "status": self.status,
            "severity": severity_for(self.status),
            "reason": self.reason,
            "affected": self.affected,
            "suggested_action": self.suggested_action,
        }


