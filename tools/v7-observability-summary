#!/usr/bin/env python3
"""Read-only V7 observability summary.

Builds a compact operator-first snapshot from existing state files. This tool
does not run probes, write state, change routing, trigger autoswitch, or mutate
runtime.
"""

from __future__ import annotations

import argparse
