#!/usr/bin/env python3
"""End-to-end safe sync gate for V7 source, GitHub, and production provenance."""

from __future__ import annotations

import v7_sync_lib as sync


def main() -> int:
    parser = sync.argparse.ArgumentParser(description=__doc__)
    sync.add_common_flags(parser)
    sync.add_apply_flags(parser, confirmation=sync.RELEASE_SYNC_CONFIRMATION)
    parser.add_argument("--message", "-m", required=True, help="commit message for the sync")
    parser.add_argument(
        "--allow-runtime-critical",
        action="store_true",
        help="explicitly allow runtime-critical files in the commit stage",
    )
    args = parser.parse_args()
    result = sync.release_sync_plan(
        apply=args.apply,
        message=args.message,
        confirm=args.confirm,
        allow_runtime_critical=args.allow_runtime_critical,
    )
    return sync.emit(result, as_json=args.json)


if __name__ == "__main__":
    raise SystemExit(main())
