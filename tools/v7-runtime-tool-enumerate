#!/usr/bin/env python3
"""Read-only runtime tool enumerator for V7.

Intended to run on the VPS or against a copied manifest. It never imports,
deletes, syncs, chmods, chowns, restarts services, or mutates runtime state.
"""

import argparse
import hashlib
import json
import os
import stat
import subprocess
from pathlib import Path


DEFAULT_RELEASE_PRODUCTION_ONLY = Path("releases/v7-runtime-20260523T174503Z/production-only-tools.json")
DEFAULT_RUNTIME_DIRS = [Path("/usr/local/bin")]
REFERENCE_ROOTS = [
    Path("/usr/local/bin"),
    Path("/etc/systemd/system"),
    Path("/opt/v7"),
]


def sha256_file(path):
    digest = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def mode_string(mode):
    return oct(stat.S_IMODE(mode))[2:].zfill(4)


def safe_stat(path):
    try:
        st = path.stat()
        return {
            "exists": True,
            "size": st.st_size,
            "mode": mode_string(st.st_mode),
            "mtime_epoch": int(st.st_mtime),
            "executable": bool(st.st_mode & 0o111),
            "sha256": sha256_file(path) if path.is_file() else "",
            "error": "",
        }
    except OSError as exc:
        return {"exists": False, "size": None, "mode": None, "mtime_epoch": None, "executable": False, "sha256": "", "error": str(exc)}


def repo_names(repo_root):
    names = set()
    for area in ("tools", "hardening", "systemd", "admin"):
        root = repo_root / area
        if not root.exists():
            continue
        for path in root.iterdir():
            if path.is_file() and (path.name.startswith("v7") or path.name == "v7-admin-api"):
                names.add(path.name)
    return names


def load_production_only(path):
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return set(), {}
    names = {row.get("tool") for row in data.get("known_deeper_inspection_entries", []) if row.get("tool")}
    return names, data


def systemd_refs_for(name):
    refs = []
    root = Path("/etc/systemd/system")
    if not root.exists():
        return refs
    try:
        for path in root.rglob("*"):
            if not path.is_file():
                continue
            try:
                text = path.read_text(encoding="utf-8", errors="ignore")
            except OSError:
                continue
            if name in text:
                refs.append(str(path))
    except OSError:
        pass
    return sorted(set(refs))[:20]


def grep_reference_count(name):
    roots = [str(path) for path in REFERENCE_ROOTS if path.exists()]
    if not roots:
        return {"count": 0, "sample": [], "error": ""}
    try:
        result = subprocess.run(
            ["grep", "-RIl", "--", name, *roots],
            check=False,
            capture_output=True,
            text=True,
            timeout=20,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        return {"count": 0, "sample": [], "error": str(exc)}
    lines = [line for line in result.stdout.splitlines() if line]
    return {"count": len(lines), "sample": lines[:20], "error": result.stderr.strip()[:300]}


def guess_class(name, referenced, systemd_ref):
    lower = name.lower()
    if systemd_ref:
        return "authoritative_runtime"
    if any(token in lower for token in ("switch", "rebalance", "reconcile", "route")):
        return "repo_missing_critical"
    if any(token in lower for token in ("identity", "profile", "user-rotate", "reissue")):
        return "repo_missing_critical"
    if any(token in lower for token in ("policy", "direct", "ru", "dnsmasq")):
        return "repo_missing_critical"
    if any(token in lower for token in ("backup", "rollback")):
        return "repo_missing_noncritical"
    if any(token in lower for token in ("check", "dry-run", "review", "summary", "report", "diag", "test")):
        return "operator_local_helper" if not referenced else "repo_missing_noncritical"
    if referenced:
        return "runtime_local_pending_lineage"
    return "legacy_runtime_drift"


def criticality_for(name, cls):
    lower = name.lower()
    if cls == "authoritative_runtime":
        return "runtime-critical"
    if any(token in lower for token in ("killswitch", "route-check", "user-switch")):
        return "datapath-critical"
    if "autoswitch" in lower or "rebalance" in lower:
        return "autoswitch-critical"
    if "provision" in lower or "egress" in lower:
        return "provisioning-critical"
    if "identity" in lower or "profile" in lower or "rotate-key" in lower or "reissue" in lower:
        return "identity-critical"
    if any(token in lower for token in ("summary", "diag", "check", "review", "test")):
        return "observability-only"
    if any(token in lower for token in ("backup", "rollback")):
        return "rollback-only"
    if cls == "legacy_runtime_drift":
        return "dormant/legacy"
    return "operator-convenience"


def release_relevance_for(cls, criticality):
    if cls in {"authoritative_runtime", "repo_missing_critical"}:
        return "must_be_release_owned"
    if criticality in {"datapath-critical", "autoswitch-critical", "provisioning-critical", "identity-critical", "rollback-only"}:
        return "must_be_release_owned"
    if cls == "legacy_runtime_drift":
        return "safe_archive_candidate_future"
    if cls == "operator_local_helper":
        return "operator_only_optional"
    return "runtime_local_allowed"


def confidence_for(repo_present, systemd_ref, referenced, cls):
    if repo_present and systemd_ref:
        return "high"
    if systemd_ref or (referenced and cls != "legacy_runtime_drift"):
        return "medium"
    if repo_present:
        return "medium"
    if cls == "legacy_runtime_drift":
        return "low"
    return "unknown"


def enumerate_tools(args):
    repo_root = Path(args.repo_root).resolve()
    repo = repo_names(repo_root)
    known_names, prod = load_production_only(Path(args.production_only))
    rows = []
    for root in [Path(p) for p in args.runtime_dir]:
        if not root.exists():
            continue
        for path in sorted(root.glob("v7*")):
            if not path.is_file():
                continue
            info = safe_stat(path)
            name = path.name
            systemd = systemd_refs_for(name) if args.references else []
            refs = grep_reference_count(name) if args.references else {"count": 0, "sample": [], "error": ""}
            referenced = bool(systemd or refs.get("count", 0))
            repo_present = name in repo
            production_only = not repo_present
            cls = guess_class(name, referenced, bool(systemd))
            criticality = criticality_for(name, cls)
            rows.append({
                "basename": name,
                "path": str(path),
                "sha256": info["sha256"],
                "size": info["size"],
                "mode": info["mode"],
                "mtime_epoch": info["mtime_epoch"],
                "executable": info["executable"],
                "repo_present": repo_present,
                "production_only": production_only,
                "known_deeper_inspection_entry": name in known_names,
                "systemd_references": systemd,
                "reference_count": refs.get("count", 0),
                "reference_sample": refs.get("sample", []),
                "governance_class": cls,
                "runtime_criticality": criticality,
                "release_relevance": release_relevance_for(cls, criticality),
                "provenance_confidence": confidence_for(repo_present, bool(systemd), referenced, cls),
            })
    production_only_rows = [row for row in rows if row["production_only"]]
    return {
        "schema_version": 1,
        "tool": "v7-runtime-tool-enumerate",
        "mode": "read_only",
        "runtime_dirs": [str(Path(p)) for p in args.runtime_dir],
        "production_only_snapshot": str(Path(args.production_only)),
        "summary": {
            "total_v7_tools": len(rows),
            "repo_present": sum(1 for row in rows if row["repo_present"]),
            "production_only": len(production_only_rows),
            "known_deeper_inspection_entries_found": sum(1 for row in rows if row["known_deeper_inspection_entry"]),
            "must_be_release_owned": sum(1 for row in production_only_rows if row["release_relevance"] == "must_be_release_owned"),
            "operator_only_optional": sum(1 for row in production_only_rows if row["release_relevance"] == "operator_only_optional"),
            "safe_archive_candidate_future": sum(1 for row in production_only_rows if row["release_relevance"] == "safe_archive_candidate_future"),
        },
        "tools": rows,
        "production_only_tools": production_only_rows,
        "not_found_reason": "" if rows else "No runtime tools found in supplied runtime dirs. Run on VPS or provide mounted/copied runtime directory.",
        "non_mutation_guarantee": ["no import", "no delete", "no sync", "no chmod/chown", "no service restart"],
    }


def print_pretty(report):
    s = report["summary"]
    print("V7 runtime tool enumeration (read-only)")
    print(f"total_v7_tools={s['total_v7_tools']} production_only={s['production_only']} repo_present={s['repo_present']}")
    print(f"known_deeper_inspection_entries_found={s['known_deeper_inspection_entries_found']}")
    print(f"must_be_release_owned={s['must_be_release_owned']} operator_only_optional={s['operator_only_optional']} safe_archive_candidate_future={s['safe_archive_candidate_future']}")
    if report.get("not_found_reason"):
        print(f"warning={report['not_found_reason']}")


def main():
    parser = argparse.ArgumentParser(description="Read-only V7 runtime tool enumerator")
    parser.add_argument("--repo-root", default=".")
    parser.add_argument("--production-only", default=str(DEFAULT_RELEASE_PRODUCTION_ONLY))
    parser.add_argument("--runtime-dir", action="append", default=[str(path) for path in DEFAULT_RUNTIME_DIRS])
    parser.add_argument("--references", action="store_true", help="Scan local runtime reference roots; read-only but can be slower")
    parser.add_argument("--pretty", action="store_true")
    args = parser.parse_args()
    report = enumerate_tools(args)
    if args.pretty:
        print_pretty(report)
    else:
        print(json.dumps(report, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
