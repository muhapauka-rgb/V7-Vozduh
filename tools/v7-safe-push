#!/usr/bin/env python3
"""Fail-closed helper for pushing the canonical V7 branch."""

from __future__ import annotations

import sys

import v7_sync_lib as sync


def main() -> int:
    parser = sync.argparse.ArgumentParser(description=__doc__)
    sync.add_common_flags(parser)
    parser.add_argument("--apply", action="store_true", help="push HEAD to the canonical remote branch")
    args = parser.parse_args()
    result = sync.safe_push_plan(apply=args.apply, argv=sys.argv[1:])
    return sync.emit(result, as_json=args.json)


if __name__ == "__main__":
    raise SystemExit(main())
