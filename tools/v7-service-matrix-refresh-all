def resolve_profile_service_subset(state_dir: Path, profile_user: str) -> list[str]:
    """Reuse the existing per-user service preference contract for a shadow wake."""
    user = str(profile_user or "").strip()
    if not user:
        return []
    prefs = read_json(state_dir / "service-preferences.json", {})
    if not isinstance(prefs, dict):
        return []
    row = (prefs.get("users") or {}).get(user)
    if not isinstance(row, dict):
        return []
    values = row.get("required_services") or row.get("services") or []
    if isinstance(values, str):
        values = [item.strip() for item in values.split(",") if item.strip()]
    if not isinstance(values, list):
        return []
    return sorted({str(item).strip() for item in values if str(item).strip() and str(item).strip().lower() != "all"})


def select_probe_rows(
    rows: list[dict[str, str]], exact_egresses: str,
) -> tuple[list[dict[str, str]], list[str]]:
    """Resolve the normal enabled subset plus a bounded controlled exception.

    A deliberately disabled certification-only source is the existing
    controlled-condition owner's fault stimulus.  Excluding it from the
    ordinary full refresh leaves its last healthy Matrix row in place, so the
    Matrix cannot observe the condition it is meant to confirm.  Include only
    that already-marked source in the *default* full refresh.  Explicit subset
    callers retain their enabled-only contract, and ordinary disabled channels
    remain excluded.
    """
    requested = sorted(set(
        item.strip() for item in str(exact_egresses or "").split(",") if item.strip()
    ))
    if any(not SAFE_EGRESS_RE.fullmatch(item) for item in requested):
        raise ValueError("invalid_exact_egress_subset")
    enabled_by_id = {
        str(row.get("id") or ""): row
        for row in rows
        if bool_value(row.get("enabled"), default=True) and str(row.get("id") or "")
    }
    missing = sorted(set(requested) - set(enabled_by_id))
    if missing:
        raise ValueError("exact_egress_subset_not_enabled:" + ",".join(missing))
    if requested:
        return [enabled_by_id[item] for item in requested], requested
    controlled_disabled = {
        str(row.get("id") or ""): row
        for row in rows
        if (
            str(row.get("id") or "")
            and not bool_value(row.get("enabled"), default=True)
            and bool_value(row.get("controlled_certification_source"))
            and str(row.get("type") or "") == "interface"
        )
    }
    return list({**enabled_by_id, **controlled_disabled}.values()), requested


def select_staggered_deep_rows(
    rows: list[dict[str, str]],
    matrix: dict[str, Any],
    *,
    now_epoch: float,
    horizon_seconds: int,
    slot_seconds: int,
) -> tuple[list[dict[str, str]], dict[str, Any]]:
    """Select one fair restart-stable slice from the existing Matrix inventory.

    Sorting canonical egress ids and assigning ``index % slot_count`` gives
    every slice either floor(N/S) or ceil(N/S) rows.  There is no cursor,
    queue, cache or catch-up state to lose on restart.  A missed slice remains
    visibly stale through the existing per-egress Matrix timestamps; it is not
    replayed as a burst.
    """
    horizon = max(60, min(int(horizon_seconds or 900), 86_400))
    slot = max(1, min(int(slot_seconds or 60), horizon))
    slot_count = max(1, (horizon + slot - 1) // slot)
    slot_index = int(max(0.0, now_epoch) // slot) % slot_count
    ordered = sorted(rows, key=lambda row: str(row.get("id") or ""))
    selected = [
        row for index, row in enumerate(ordered)
        if index % slot_count == slot_index
    ]
    items = matrix.get("items") if isinstance(matrix.get("items"), dict) else {}
    stale: list[str] = []
    for row in ordered:
        egress_id = str(row.get("id") or "")
        item = items.get(egress_id) if isinstance(items.get(egress_id), dict) else {}
        observed = str(item.get("checked_at") or item.get("updated") or "")
        try:
            observed_epoch = datetime.fromisoformat(observed.replace("Z", "+00:00")).timestamp()
            age = max(0.0, now_epoch - observed_epoch)
        except (TypeError, ValueError):
            age = None
        if age is None or age > horizon:
            stale.append(egress_id)
    schedule = {
        "schema_version": "v7.matrix-staggered-deep-schedule.v1",
        "owner": "tools/v7-service-matrix-refresh-all",
        "canonical_writer": "tools/v7-service-matrix-test",
        "horizon_seconds": horizon,
        "slot_seconds": slot,
        "slot_count": slot_count,
        "slot_index": slot_index,
        "inventory_count": len(ordered),
        "selected_count": len(selected),
        "maximum_slice_size": (len(ordered) + slot_count - 1) // slot_count,
        "selected_egresses": [str(row.get("id") or "") for row in selected],
        "stale_egresses": stale,
        "stale_count": len(stale),
        "missed_horizon_behavior": "REMAIN_STALE_NO_CATCH_UP_BURST",
        "restart_behavior": "RECOMPUTE_DETERMINISTIC_SLICE_NO_CURSOR",
        "new_state_store_created": False,
        "routing_mutation_performed": False,
        "users_moved": 0,
    }
    return selected, schedule


def _prepared_projection_candidates(value: Any, *, node_limit: int = 4096) -> list[dict[str, Any]]:
    """Find compact Planner projections in an existing Matrix summary.

    The summary is already a bounded projection owned by Matrix. This walker
    is deliberately node-bounded and read-only; it does not reconstruct the
    Planner world model or scan users at incident time.
    """
    candidates: list[dict[str, Any]] = []
    pending = [value]
    visited = 0
    while pending and visited < max(1, int(node_limit)):
        current = pending.pop()
        visited += 1
        if isinstance(current, dict):
            if str(current.get("schema_version") or "") == (
                "v7.prepared-class-decision-projection.v1"
            ):
                candidates.append(current)
            nested = current.get("prepared_class_decisions")
            if isinstance(nested, dict):
                candidates.append(nested)
            pending.extend(current.values())
        elif isinstance(current, list):
            pending.extend(current)
    return candidates


def select_prepared_hot_target_rows(
    rows: list[dict[str, str]], projection_surface: Any,
) -> tuple[list[dict[str, str]], dict[str, Any]]:
    """Resolve exact pre-ready targets selected by the existing Planner.

    This is only a probe-scope adapter. It never ranks or invents a target,
    and a missing/disabled target remains visible instead of widening to the
    full inventory.
    """
    candidates = _prepared_projection_candidates(projection_surface)
    candidates.sort(key=lambda row: str(row.get("produced_at") or ""))
    projection = candidates[-1] if candidates else {}
    hot = (
        projection.get("hot_target_set")
        if isinstance(projection.get("hot_target_set"), dict)
        else {}
    )
    contracts = [
        row for row in (hot.get("contracts") or [])
        if isinstance(row, dict) and str(row.get("target_id") or "")
    ]
    by_target: dict[str, set[str]] = {}
    for contract in contracts:
        target_id = str(contract.get("target_id") or "")
        services = {
            str(item).strip()
            for item in (contract.get("critical_services") or [])
            if str(item).strip() and str(item).strip().lower() != "all"
        }
        # A path-only profile has an intentionally empty application-service
        # set.  It still needs the already selected target in the pre-ready
        # PATH role; dropping it here recreated the broad incident-time target
        # fallback for exactly the cheapest profile class.
        by_target.setdefault(target_id, set()).update(services)
    enabled = {
        str(row.get("id") or ""): row
        for row in rows
        if str(row.get("id") or "")
        and bool_value(row.get("enabled"), default=True)
    }
    missing = sorted(set(by_target) - set(enabled))
    selected: list[dict[str, str]] = []
    for target_id in sorted(set(by_target) & set(enabled)):
        selected.append({
            **enabled[target_id],
            "_prepared_services": ",".join(sorted(by_target[target_id])),
        })
    status = "PREPARED_HOT_TARGET_SCOPE_READY"
    blockers: list[str] = []
    if not projection:
        status = "PREPARED_PROJECTION_MISSING"
        blockers.append("prepared_projection_missing")
    elif str(projection.get("status") or "") != "PREPARED_CLASS_DECISION_AVAILABLE":
        status = "PREPARED_PROJECTION_NOT_READY"
        blockers.append("prepared_projection_not_ready")
    elif not contracts or not by_target:
        status = "NO_3S_TARGET_CAPACITY"
        blockers.append("pre_ready_hot_target_missing")
    if missing:
        status = "PREPARED_TARGET_IDENTITY_STALE"
        blockers.append("prepared_target_missing_or_disabled")
    return selected, {
        "schema_version": "v7.matrix-prepared-hot-target-probe-scope.v1",
        "status": status,
        "ok": not blockers,
        "owner": "tools/v7-users-autoswitch.AutoswitchPlanner.plan",
        "consumer": "tools/v7-service-matrix-refresh-all",
        "projection_produced_at": str(projection.get("produced_at") or ""),
        "prepared_class_count": int(projection.get("class_count") or 0),
        "declared_contract_count": len(contracts),
        "deduplicated_target_count": len(by_target),
        "selected_target_count": len(selected),
        "selected_targets": [str(row.get("id") or "") for row in selected],
        "missing_targets": missing,
        "blockers": blockers,
        "manual_server_selection": False,
        "world_model_rebuilt": False,
        "user_registry_scanned": False,
        "full_matrix_fallback_preserved": True,
        "routing_mutation_performed": False,
        "users_moved": 0,
    }


def run_service_failure_automation_advisory(
    consumer: str,
    *,
    state_dir: Path,
    event_dir: Path,
    timeout_sec: int = 45,
    matrix_comparative_preflight: bool = False,
) -> dict[str, Any]:
    """Invoke the existing autoswitch owner in bounded advisory-only mode."""
    command = [
        consumer,
        "--consume-service-failure-automation-only",
        "--state-dir",
        str(state_dir),
        "--event-dir",
        str(event_dir),
    ]
    if matrix_comparative_preflight:
        command.append("--matrix-comparative-preflight")
    started_at = now_iso()
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(5, min(int(timeout_sec or 45), 120)),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.service-failure-automation-advisory-liveness.v1",
            "status": "FAILED",
            "ok": False,
            "started_at": started_at,
            "error": str(exc),
            "command": command,
        }
    output = proc.stdout or ""
    try:
        parsed = json.loads(output)
    except json.JSONDecodeError:
        parsed = {}
    return {
        "schema_version": "v7.service-failure-automation-advisory-liveness.v1",
        "status": "PASS" if proc.returncode == 0 and isinstance(parsed, dict) and parsed.get("ok") else "FAILED",
        "ok": proc.returncode == 0 and isinstance(parsed, dict) and parsed.get("ok") is True,
        "started_at": started_at,
        "completed_at": now_iso(),
        "command": command,
        "returncode": proc.returncode,
        "consumer_result": parsed,
        "output_tail": output[-2000:],
    }


def refresh_prepared_class_projection(
    consumer: str,
    *,
    state_dir: Path,
    summary_file: Path,
    lock_timeout_sec: int,
    timeout_sec: int = 45,
) -> dict[str, Any]:
    """Persist one compact Planner projection in the existing Matrix summary.

    Planning happens outside the writer lock. Only the bounded projection is
    merged under the existing Matrix lock; no incident, Candidate, Packet,
    lease, route or user effect is created by this role.
    """
    command = [
        consumer,
        "--prepared-class-projection-only",
        "--state-dir", str(state_dir),
        "--event-dir", str(state_dir.parent / "events"),
    ]
    started_ns = time.monotonic_ns()
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(5, min(int(timeout_sec or 45), 120)),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.matrix-prepared-projection-refresh.v1",
            "status": "STOP_SAFE",
            "ok": False,
            "blockers": [f"prepared_projection_owner_failed:{type(exc).__name__}"],
            "routing_mutation_performed": False,
            "users_moved": 0,
        }
    try:
        parsed = json.loads(proc.stdout or "{}")
    except json.JSONDecodeError:
        parsed = {}
    projection = (
        parsed.get("prepared_class_decisions")
        if isinstance(parsed.get("prepared_class_decisions"), dict)
        else {}
    )
    freshness = (
        parsed.get("prepared_class_decision_freshness")
        if isinstance(parsed.get("prepared_class_decision_freshness"), dict)
        else {}
    )
    if (
        proc.returncode != 0
        or str(projection.get("schema_version") or "")
        != "v7.prepared-class-decision-projection.v1"
        or str(freshness.get("status") or "")
        != "PREPARED_CLASS_DECISION_FRESH"
    ):
        return {
            "schema_version": "v7.matrix-prepared-projection-refresh.v1",
            "status": "STOP_SAFE",
            "ok": False,
            "returncode": proc.returncode,
            "blockers": ["prepared_projection_not_fresh_or_unavailable"],
            "routing_mutation_performed": False,
            "users_moved": 0,
        }
    lock_started_ns = time.monotonic_ns()
    try:
        with service_matrix_writer_lock(state_dir, lock_timeout_sec):
            lock_acquired_ns = time.monotonic_ns()
            summary = read_json(summary_file, {})
            if not isinstance(summary, dict):
                summary = {}
            summary["prepared_class_decisions"] = projection
            summary["prepared_class_decision_freshness"] = freshness
            summary["prepared_projection_updated"] = now_iso()
            write_json_atomic(summary_file, summary)
            lock_released_ns = time.monotonic_ns()
    except TimeoutError:
        return {
            "schema_version": "v7.matrix-prepared-projection-refresh.v1",
            "status": "STOP_SAFE_MATRIX_LOCK_TIMEOUT",
            "ok": False,
            "blockers": ["service_matrix_lock_timeout"],
            "routing_mutation_performed": False,
            "users_moved": 0,
        }
    return {
        "schema_version": "v7.matrix-prepared-projection-refresh.v1",
        "status": "PASS",
        "ok": True,
        "prepared_class_count": int(projection.get("class_count") or 0),
        "prepared_target_contract_count": len(
            ((projection.get("hot_target_set") or {}).get("contracts") or [])
        ),
        "projection_produced_at": str(projection.get("produced_at") or ""),
        "planner_elapsed_ms": round((lock_started_ns - started_ns) / 1_000_000, 3),
        "lock_wait_ms": round((lock_acquired_ns - lock_started_ns) / 1_000_000, 3),
        "lock_hold_ms": round((lock_released_ns - lock_acquired_ns) / 1_000_000, 3),
        "summary_file": str(summary_file),
        "existing_matrix_summary_reused": True,
        "incident_obligation_materialized": False,
        "candidate_created": False,
        "packet_created": False,
        "lease_created": False,
        "routing_mutation_performed": False,
        "users_moved": 0,
    }


def prepared_projection_refresh_due(
    summary: Any,
    *,
    now_epoch: Optional[float] = None,
) -> dict[str, Any]:
    """Decide cheaply whether the existing Planner projection needs work.

    PATH observations deliberately do not invalidate target selection; their
    exact readiness is read from canonical Matrix at incident time.  Starting
    the Planner subprocess after every one-second PATH probe therefore adds
    load but no safety.  Rebuild only a missing/expired projection here. All
    other stable-input changes remain caught by the established 30-second
    Planner role and again fail closed by the incident consumer.
    """
    root = summary if isinstance(summary, dict) else {}
    projection = (
        root.get("prepared_class_decisions")
        if isinstance(root.get("prepared_class_decisions"), dict)
        else {}
    )
    produced_at = str(projection.get("produced_at") or "")
    try:
        produced_epoch = datetime.fromisoformat(
            produced_at.replace("Z", "+00:00")
        ).timestamp()
    except (TypeError, ValueError):
        produced_epoch = 0.0
    maximum_reuse_seconds = int(
        projection.get("maximum_reuse_seconds") or 0
    )
    age_seconds = max(
        0.0,
        float(time.time() if now_epoch is None else now_epoch) - produced_epoch,
    ) if produced_epoch else -1.0
    reasons: list[str] = []
    if str(projection.get("schema_version") or "") != (
        "v7.prepared-class-decision-projection.v1"
    ):
        reasons.append("prepared_projection_missing")
    if maximum_reuse_seconds <= 0:
        reasons.append("prepared_projection_reuse_contract_missing")
    elif age_seconds < 0 or age_seconds >= maximum_reuse_seconds:
        reasons.append("periodic_quality_rerank_due")
    return {
        "due": bool(reasons),
        "reasons": reasons,
        "age_seconds": round(age_seconds, 3) if age_seconds >= 0 else None,
        "maximum_reuse_seconds": maximum_reuse_seconds,
    }


def run_service_failure_omp_consumer(*, timeout_sec: int = 45) -> dict[str, Any]:
    """Consume the already-materialized obligation through the standard OMP entrypoint.

    Production deploys the evidence owner but deliberately not the source CPS
    corpus.  This narrow existing-owner command persists the consumption
    receipt in production; the canonical source CPS is reconciled only from
    that owner-backed receipt by its source owner.
    """
    command = ["v7-truth-check", "--consume-service-failure-automation-only", "--json"]
    started_at = now_iso()
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(10, min(int(timeout_sec or 45), 180)),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.service-failure-omp-consumer-liveness.v1",
            "status": "FAILED", "ok": False, "started_at": started_at,
            "error": str(exc), "command": command,
        }
    output = proc.stdout or ""
    try:
        parsed = json.loads(output)
    except json.JSONDecodeError:
        parsed = {}
    passed = (
        proc.returncode == 0
        and isinstance(parsed, dict)
        and parsed.get("final_verdict") in {
            "PASS",
            "BOUNDED_CONTINUATION",
            "NO_PENDING_OBLIGATION",
        }
    )
    return {
        "schema_version": "v7.service-failure-omp-consumer-liveness.v1",
        "status": "PASS" if passed else "FAILED",
        "ok": passed,
        "started_at": started_at,
        "completed_at": now_iso(),
        "command": command,
        "returncode": proc.returncode,
        "consumer_result": parsed,
        "output_tail": output[-2000:],
    }


def _consumer_projection(payload: Any) -> dict[str, Any]:
    """Keep a lifecycle receipt compact while leaving full truth with its owner.

    Matrix refresh is an observation/wake producer, not an outcome registry.
    Its child consumers already persist their complete facts in the existing
    event, execution and closure owners.  Re-embedding whole child responses
    here caused each periodic refresh to grow the next refresh's input.
    """
    value = payload if isinstance(payload, dict) else {}
    result = value.get("consumer_result")
    result = result if isinstance(result, dict) else {}
    # CT-M0F is a direct existing Matrix consumer rather than the generic
    # wrapper used by the older campaign lanes.  Without this adaptation its
    # durable Matrix receipt retained neither its terminal nor the exact
    # predicate path that explains why a fresh sample was or was not admitted.
    if (
        not result
        and str(value.get("schema_version") or "").startswith(
            "v7.ct-m0f-standing-validation-matrix-consumer."
        )
    ):
        result = value
    compact_result = {
        key: result.get(key)
        for key in (
            "final_verdict", "status", "next_output", "legal_terminal",
            "receipt_id", "obligation_id", "frontier_id", "packet_id",
            "feedback_id", "outcome_id", "transaction_status", "stop_reason",
            "stop_detail", "error",
            "blockers", "stage", "baseline_reset_verified",
            "target_bound_trial", "target_bound_trial_target",
            "campaign_next_stage", "completion_kind",
            "outcome_consumed", "replay_consumed", "learning_consumed",
            "durable_successor",
        )
        if result.get(key) not in (None, "", [], {})
    }
    execution_timing = result.get("execution_timing")
    if not isinstance(execution_timing, dict) or not execution_timing:
        # CT-M0F may execute and close a sample in one bounded Matrix
        # invocation. Its governed execution receipt then lives in the
        # existing lifecycle step list while the top-level result describes
        # the closure successor. Retain the newest receipt without copying
        # the step payload or creating another telemetry store.
        for step in reversed(result.get("steps") or []):
            if not isinstance(step, dict):
                continue
            child = step.get("result")
            if not isinstance(child, dict):
                continue
            candidate_timing = child.get("execution_timing")
            if isinstance(candidate_timing, dict) and candidate_timing:
                execution_timing = candidate_timing
                break
    if isinstance(execution_timing, dict) and execution_timing:
        # This is already the governed caller's bounded monotonic receipt.
        # Preserve it in the existing Matrix lifecycle projection so a failed
        # latency sample can be attributed without replaying an apply or
        # creating another metrics/state owner.
        compact_result["execution_timing"] = execution_timing
    prepared = result.get("prepared_class_decisions") or value.get("prepared_class_decisions")
    if isinstance(prepared, dict) and prepared:
        compact_result["prepared_class_decisions"] = prepared
    prepared_freshness = result.get("prepared_class_decision_freshness") or value.get("prepared_class_decision_freshness")
    if isinstance(prepared_freshness, dict) and prepared_freshness:
        compact_result["prepared_class_decision_freshness"] = prepared_freshness
    bounded_closure = result.get("bounded_closure_reconciliation") or value.get("bounded_closure_reconciliation")
    if isinstance(bounded_closure, dict) and bounded_closure:
        compact_result["bounded_closure_reconciliation"] = bounded_closure
    # The Autoswitch owner already produces a bounded monotonic performance
    # timeline.  Preserve only its scalar advisory spans in the existing
    # Matrix lifecycle projection: this makes the observed cost attributable
    # without re-embedding child state, raw history or a new metrics store.
    timing = result.get("performance_timeline") or value.get("performance_timeline")
    if isinstance(timing, dict):
        spans = timing.get("spans") if isinstance(timing.get("spans"), list) else []
        advisory_spans = [
            {
                key: row.get(key)
                for key in (
                    "stage", "parent", "owner", "clock_source", "duration_ms",
                    "status", "critical_path",
                )
                if row.get(key) not in (None, "", [], {})
            }
            for row in spans
            if isinstance(row, dict)
            and (
                str(row.get("parent") or "") in {
                    "service_failure_advisory",
                    "service_failure_advisory_materialization",
                }
                or str(row.get("stage") or "").startswith("advisory_")
            )
        ]
        if advisory_spans:
            compact_result["advisory_performance_timeline"] = {
                "schema_version": str(timing.get("schema_version") or ""),
                "clock_source": str(timing.get("clock_source") or ""),
                "owner": str(timing.get("owner") or ""),
                "spans": advisory_spans,
            }
        # Passive consumption has an independent, existing read-only timing
        # result. Keep its three scalar spans in the same compact receipt so
        # its cost can be compared without retaining raw event/state payloads.
        passive_spans = [
            {
                key: row.get(key)
                for key in ("stage", "owner", "clock_source", "duration_ms")
                if row.get(key) not in (None, "", [], {})
            }
            for row in spans
            if isinstance(row, dict)
            and str(row.get("stage") or "").startswith("passive_")
        ]
        if passive_spans:
            compact_result["passive_performance_timeline"] = {
                "schema_version": str(timing.get("schema_version") or ""),
                "spans": passive_spans,
            }
    sample_preparation = (
        result.get("sample_preparation_receipt")
        or value.get("sample_preparation_receipt")
    )
    if isinstance(sample_preparation, dict) and sample_preparation:
        predicates = sample_preparation.get("predicates")
        predicates = predicates if isinstance(predicates, dict) else {}
        source_selection = sample_preparation.get("source_selection")
        source_selection = (
            source_selection if isinstance(source_selection, dict) else {}
        )
        compact_result["ct_m0f_sample_preparation"] = {
            "schema_version": str(sample_preparation.get("schema_version") or ""),
            "phase": str(sample_preparation.get("phase") or ""),
            "contract_id": str(sample_preparation.get("contract_id") or ""),
            "reservation_id": str(sample_preparation.get("reservation_id") or ""),
            "terminal": str(sample_preparation.get("terminal") or ""),
            "blockers": list(sample_preparation.get("blockers") or [])[:12],
            "next_required_consumer": str(
                sample_preparation.get("next_required_consumer") or ""
            ),
            "source_selection": {
                key: source_selection.get(key)
                for key in (
                    "state", "selection_mode", "source", "user", "target",
                    "binding_fingerprint",
                )
                if source_selection.get(key) not in (None, "", [], {})
            },
            "predicates": {
                name: predicate
                for name, predicate in predicates.items()
                if isinstance(predicate, dict)
            },
        }
    # The governed executor already emits a compact terminal cohort-policy
    # binding.  Retain its bounded reason here too: Matrix owns this lifecycle
    # projection, while the full Packet/lease and execution evidence remains
    # with the existing specialized owners.  Without this pointer a normal
    # STOP_SAFE terminal is reduced to a name, forcing a later investigation
    # to replay or infer a policy gate that was already proven.
    cohort_binding = result.get("standing_delegated_policy_binding")
    cohort_binding = cohort_binding if isinstance(cohort_binding, dict) else {}
    compact_cohort_binding = {
        key: cohort_binding.get(key)
        for key in (
            "ok",
            "blockers",
            "max_users_per_action",
            "max_concurrent_transactions",
            "action_class",
            "authority_audit_verified",
            "self_expansion_allowed",
        )
        if key in cohort_binding
        and (
            cohort_binding.get(key) not in (None, "", [], {})
            or key in {"ok", "authority_audit_verified", "self_expansion_allowed"}
        )
    }
    if compact_cohort_binding:
        compact_result["standing_delegated_policy_binding"] = (
            compact_cohort_binding
        )
    # A Planner subprocess that returns no plan is a terminal pre-Packet
    # condition. Keep its already bounded diagnostic in the existing Matrix
    # receipt; this avoids re-running the expensive Planner merely to learn
    # whether it failed, timed out or returned an empty result.
    planner_plan_availability = result.get("planner_plan_availability")
    planner_plan_availability = (
        planner_plan_availability
        if isinstance(planner_plan_availability, dict)
        else {}
    )
    compact_planner_plan_availability = {
        key: planner_plan_availability.get(key)
        for key in ("ok", "returncode", "error", "stderr_tail", "stdout_tail")
        if key in planner_plan_availability
        and (
            planner_plan_availability.get(key) not in (None, "", [], {})
            or key == "ok"
        )
    }
    if compact_planner_plan_availability:
        compact_result["planner_plan_availability"] = (
            compact_planner_plan_availability
        )
    ordinary_pre_packet_scope = result.get("ordinary_pre_packet_scope")
    ordinary_pre_packet_scope = (
        ordinary_pre_packet_scope
        if isinstance(ordinary_pre_packet_scope, dict)
        else {}
    )
    compact_ordinary_pre_packet_scope = {
        key: ordinary_pre_packet_scope.get(key)
        for key in (
            "valid",
            "selected_count",
            "requested_max_users",
            "certification_selected_count",
        )
        if key in ordinary_pre_packet_scope
    }
    if compact_ordinary_pre_packet_scope:
        compact_result["ordinary_pre_packet_scope"] = (
            compact_ordinary_pre_packet_scope
        )
    # Keep the terminal handoff from the existing route/apply consumer
    # inspectable without embedding its payload.  A parent
    # ``l3_production_validation_downstream_proof_failed`` is otherwise too
    # coarse to distinguish an apply timeout from a verification or rollback
    # gate, and would force a repeat of an already-expensive execution merely
    # to identify the responsible owner.
    downstream = result.get("downstream_proof_diagnostic")
    downstream = downstream if isinstance(downstream, dict) else {}
    compact_downstream = {
        key: downstream.get(key)
        for key in (
            "apply_command_ok", "apply_returncode", "apply_timed_out",
            "child_final_verdict", "child_transaction_status",
            "child_stop_reason", "child_stop_detail", "proof_blockers",
            "route_apply_failure_count", "route_apply_failure_reasons",
            "verification_failure_count", "verification_failure_reasons",
            "route_verification_failure_categories",
            "route_verification_scopes",
            "rollback_failure_count", "capability_production_proven",
        )
        if downstream.get(key) not in (None, "", [], {})
        or key in {"apply_command_ok", "apply_timed_out"}
    }
    if compact_downstream:
        compact_result["downstream_proof_diagnostic"] = compact_downstream
    for key in (
        "performance_benchmark",
        "campaign_stage_credit",
        "stage_48_optimized_runtime_ready",
        "stage_48_execution_permitted",
    ):
        if key in result:
            compact_result[key] = result.get(key)
    if result.get("performance_benchmark") is True:
        compact_result["cohort_execution_timings"] = [
            row
            for row in (result.get("cohort_execution_timings") or [])
            if isinstance(row, dict)
        ]
        compact_result["performance_timeline"] = [
            row
            for row in (result.get("performance_timeline") or [])
            if isinstance(row, dict)
        ]
    # A target-bound trial has a verified scope (often 5 or 10) but is not a
    # campaign-stage receipt for that number.  Retain both identities in the
    # compact Matrix projection so transient runtime work cannot be mistaken
    # for a duplicate of an already consumed campaign stage.
    if result.get("performance_benchmark") is True:
        compact_result["execution_scope_kind"] = (
            "PERFORMANCE_BENCHMARK_NO_STAGE_CREDIT"
        )
        compact_result["benchmark_scope"] = int(
            result.get("stage") or 0
        )
        compact_result["campaign_stage"] = 0
    elif result.get("target_bound_trial") is True:
        compact_result["execution_scope_kind"] = "TARGET_BOUND_TRIAL"
        compact_result["trial_scope"] = int(result.get("stage") or 0)
        compact_result["campaign_stage"] = int(
            result.get("campaign_next_stage") or 0
        )
    elif result.get("stage") not in (None, "", 0):
        compact_result["execution_scope_kind"] = "CAMPAIGN_STAGE"
        compact_result["campaign_stage"] = int(result.get("stage") or 0)
    # Availability-first stages may stop inside one governed subset after the
    # outer stage has already passed admission.  Preserve the bounded terminal
    # and circuit-breaker reason so the next Matrix/OMP consumer can identify
    # the exact failed gate without replaying a production action.  The full
    # cycle and diagnostics remain with their existing specialized owners.
    circuit_breaker = result.get("circuit_breaker")
    circuit_breaker = (
        circuit_breaker if isinstance(circuit_breaker, dict) else {}
    )
    compact_circuit_breaker = {
        key: circuit_breaker.get(key)
        for key in (
            "tripped", "remaining_subsets_stopped", "reason",
        )
        if circuit_breaker.get(key) not in (None, "", [], {})
    }
    if compact_circuit_breaker:
        compact_result["circuit_breaker"] = compact_circuit_breaker
    packet_set = result.get("packet_set")
    packet_set = packet_set if isinstance(packet_set, list) else []
    compact_packet_set = [
        {
            key: row.get(key)
            for key in (
                "final_verdict", "transaction_status", "stop_reason",
                "fresh_packet_id", "decision_id", "operation_id",
                "user", "users", "source", "target", "target_id",
                "users_moved", "runtime_mutation_performed",
                "verification_result", "rollback_result",
                "feedback_id", "outcome_id", "learning_record_id",
            )
            if row.get(key) not in (None, "", [], {})
        }
        for row in packet_set
        if isinstance(row, dict)
    ]
    for compact_packet, packet in zip(compact_packet_set, packet_set):
        downstream = packet.get("downstream_proof_diagnostic")
        if isinstance(downstream, dict) and downstream:
            compact_packet["downstream_proof_diagnostic"] = {
                key: downstream.get(key)
                for key in (
                    "apply_command_ok", "apply_returncode",
                    "apply_timed_out", "child_final_verdict",
                    "child_transaction_status", "child_stop_reason",
                    "child_stop_detail", "proof_blockers",
                    "route_apply_failure_count", "route_apply_failure_reasons",
                    "verification_failure_count", "verification_failure_reasons",
                    "route_verification_failure_categories", "rollback_failure_count",
                    "route_verification_scopes",
                    "capability_production_proven",
                )
                if downstream.get(key) not in (None, "", [], {})
                or key in {"apply_command_ok", "apply_timed_out"}
            }
    compact_packet_set = [row for row in compact_packet_set if row]
    if compact_packet_set:
        compact_result["packet_set"] = compact_packet_set
    partial = result.get("partial_apply_recovery")
    partial = partial if isinstance(partial, dict) else {}
    compact_partial = {
        key: partial.get(key)
        for key in (
            "pending", "ok", "blockers", "stage", "user", "source",
            "target", "packet_id", "operation_id", "projection_source",
            "recovery_mode", "cohort_packet_count",
            "cohort_projection_exact", "performance_benchmark",
            "campaign_stage_credit",
        )
        if partial.get(key) not in (None, "", [], {})
    }
    if compact_partial:
        compact_result["partial_apply_recovery"] = compact_partial
    reset = result.get("reset_transaction")
    reset = reset if isinstance(reset, dict) else {}
    compact_reset = {
        key: reset.get(key)
        for key in (
            "final_verdict", "transaction_status", "stop_reason", "stop_detail",
            "fresh_packet_id", "operation_id", "user", "source", "target",
            "runtime_mutation_performed", "verification_result",
            "rollback_result", "users_moved",
        )
        if reset.get(key) not in (None, "", [], {})
    }
