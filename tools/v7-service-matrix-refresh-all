def controlled_certification_matrix_binding(
    *,
    audit_store: Path,
    source: str,
    now: Optional[datetime] = None,
    target_selection_diagnostic: Optional[dict[str, Any]] = None,
) -> dict[str, Any]:
    """Project the next approved controlled stage from the existing audit owner."""
    records = operator_execution.read_live_execution_lineage_records(
        audit_store
    )
    status = operator_execution.controlled_certification_substrate_authority_status(
        records,
        now=now,
    )
    request = (
        status.get("request")
        if isinstance(status.get("request"), dict)
        else {}
    )
    scope = (
        request.get("scope")
        if isinstance(request.get("scope"), dict)
        else {}
    )
    request_id = str(status.get("request_id") or "")
    request_hash = str(status.get("request_hash") or "")
    validation = (
        operator_execution.validate_controlled_certification_substrate_authority_request(
            request,
            decision=operator_execution.CONTROLLED_CERTIFICATION_SUBSTRATE_APPROVAL,
            expected_request_id=request_id,
            expected_request_hash=request_hash,
            now=now,
        )
        if request
        else {"ok": False, "errors": ["controlled_campaign_request_missing"]}
    )
    admitted = set(str(item) for item in (status.get("admitted_subscopes") or []))
    blockers = list(validation.get("errors") or [])
    if status.get("status") != "APPROVED":
        blockers.append("controlled_campaign_not_approved")
    if str(status.get("decision") or "") != (
        operator_execution.CONTROLLED_CERTIFICATION_SUBSTRATE_APPROVAL
    ):
        blockers.append("controlled_campaign_decision_not_exact")
    if not {
        "CONTROLLED_SOURCE_CONDITION",
        "PROGRESSIVE_CAMPAIGN_EXECUTION",
    }.issubset(admitted):
        blockers.append("controlled_campaign_execution_subscopes_not_admitted")
    if str(scope.get("source_id") or "") != str(source or ""):
        blockers.append("controlled_campaign_source_mismatch")
    if int(scope.get("max_concurrent_transactions") or 0) != 1:
        blockers.append("controlled_campaign_concurrency_not_one")
    stages = [int(item) for item in (scope.get("campaign_stages") or [])]
    if stages != [5, 10, 25, 48]:
        blockers.append("controlled_campaign_stage_contract_changed")
    progress = operator_execution.controlled_certification_campaign_stage_status(
        records,
        request_id=request_id,
        request_hash=request_hash,
        now=now,
    )
    if not progress.get("ok"):
        blockers.extend(progress.get("blockers") or [])
    diagnostic = (
        target_selection_diagnostic
        if isinstance(target_selection_diagnostic, dict)
        else {}
    )
    diagnostic_status = str(diagnostic.get("status") or "")
    if diagnostic and (
        not diagnostic.get("ok")
        or diagnostic_status != "CURRENT_EXACT_TARGET_VALID"
    ):
        blockers.append(
            "controlled_campaign_target_full_live_admission_failed"
        )
    completed = list(progress.get("completed_stages") or [])
    next_stage = int(progress.get("next_stage") or 0)
    return {
        "schema_version": "v7.controlled-certification-matrix-binding.v1",
        "active": not blockers and next_stage > 0,
        "completed": not blockers and next_stage == 0 and bool(stages),
        "ok": not blockers,
        "blockers": sorted(set(blockers)),
        "request_id": request_id,
        "request_hash": request_hash,
        "decision_id": str(status.get("decision_id") or ""),
        "expires_at": str(status.get("expires_at") or ""),
        "source": str(scope.get("source_id") or ""),
        "target": str(scope.get("controlled_target_id") or ""),
        "stages": stages,
        "completed_stages": completed,
        "controlled_production_proven_max": int(
            progress.get("controlled_production_proven_max") or 0
        ),
        "stage_receipt_ids": list(progress.get("receipt_ids") or []),
        "next_stage": next_stage,
        "max_concurrent_transactions": int(
            scope.get("max_concurrent_transactions") or 0
        ),
        "ordinary_customer_involvement": bool(
            scope.get("ordinary_customer_involvement")
        ),
        "authority_expanded": False,
        "target_selection_status": diagnostic_status,
        "target_inventory_fingerprint": str(
            diagnostic.get("inventory_fingerprint") or ""
        ),
        "target_reselection_required": diagnostic_status in {
            "EXACT_TARGET_REBIND_AUTHORITY_REQUIRED",
            "BETTER_TARGET_SELECTED_INSIDE_APPROVED_ENVELOPE",
            "MULTI_TARGET_ALLOCATION_READY",
            "MULTI_TARGET_EXECUTION_AUTHORITY_REQUIRED",
        },
        "target_selection_next_consumer": (
            "existing Authority owner"
            if diagnostic_status in {
                "EXACT_TARGET_REBIND_AUTHORITY_REQUIRED",
                "MULTI_TARGET_EXECUTION_AUTHORITY_REQUIRED",
            }
            else "existing Matrix -> OMP -> CPS continuation chain"
            if diagnostic_status
            else ""
        ),
    }


def read_controlled_target_selection_diagnostic(
    *,
    state_dir: Path,
    policy_file: Path,
    audit_store: Path,
) -> dict[str, Any]:
    """Call the existing autoswitch owner in its read-only diagnostic mode."""
    command = [
        default_passive_consumer_path(),
        "--controlled-target-selection-diagnostic",
        "--state-dir",
        str(state_dir),
        "--policy-file",
        str(policy_file),
        "--action-class-audit-store",
        str(audit_store),
    ]
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=120,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.controlled-campaign-target-selection-diagnostic.v1",
            "status": "STOP_SAFE_TARGET_DIAGNOSTIC_CALLER_FAILED",
            "ok": False,
            "error": f"{type(exc).__name__}:{exc}",
        }
    try:
        payload = json.loads(proc.stdout or "{}")
    except json.JSONDecodeError:
        payload = {}
    if proc.returncode != 0 or not isinstance(payload, dict):
        return {
            "schema_version": "v7.controlled-campaign-target-selection-diagnostic.v1",
            "status": "STOP_SAFE_TARGET_DIAGNOSTIC_CALLER_FAILED",
            "ok": False,
            "returncode": proc.returncode,
            "output_tail": (proc.stdout or "")[-2000:],
        }
    return payload


def read_prepared_controlled_target_selection_diagnostic(
    planner: str,
    *,
    state_dir: Path,
    event_dir: Path,
    policy_file: Path,
    audit_store: Path,
    current_source_scope: Optional[dict[str, Any]] = None,
    validated_projection_context: Optional[dict[str, Any]] = None,
) -> dict[str, Any]:
    """Reuse the current Planner hot-target projection on the incident path.

    The projection is validated by its existing owner first.  This adapter
    then intersects only that already-ranked target set with the current
    registry, current Matrix path evidence and current capacity.  It never
    ranks a new target; any stale/missing fact returns an empty diagnostic so
    the established full diagnostic remains the fail-closed backstop.
    """
    diagnostic_started_ns = time.monotonic_ns()
    summary_read_completed_ns = diagnostic_started_ns
    owner_validation_started_ns = diagnostic_started_ns
    owner_validation_completed_ns = diagnostic_started_ns
    owner_invocation = "NOT_STARTED"

    def timed(result: dict[str, Any]) -> dict[str, Any]:
        """Attach diagnostic-only timings to the existing selection result.

        The Matrix remains the writer and the Planner remains the prepared
        projection owner.  These fields only split the formerly combined
        incident-time validation interval so a later optimisation can prove
        which owner call, file read or target intersection it removes.
        """
        completed_ns = time.monotonic_ns()
        result["performance_timeline"] = {
            "schema_version": "v7.prepared-controlled-target-diagnostic-timing.v1",
            "clock_source": "time.monotonic_ns",
            "summary_read_ms": round(
                (summary_read_completed_ns - diagnostic_started_ns) / 1_000_000.0,
                3,
            ),
            "owner_validation_ms": round(
                (owner_validation_completed_ns - owner_validation_started_ns) / 1_000_000.0,
                3,
            ),
            "target_intersection_ms": round(
                (completed_ns - owner_validation_completed_ns) / 1_000_000.0,
                3,
            ),
            "total_ms": round(
                (completed_ns - diagnostic_started_ns) / 1_000_000.0,
                3,
            ),
            "owner_invocation": owner_invocation,
            "diagnostic_only": True,
            "runtime_behavior_changed": False,
        }
        return result

    # Freshness is evaluated at incident-validation entry.  Loading and
    # validating the existing owner can itself cross the three-second PATH
    # boundary; measuring at the end made fresh pre-T0 evidence invalidate
    # itself and synchronously rebuilt the world model after T0.  The Planner
    # still revalidates mutable target facts immediately before apply.
    incident_validation_epoch = time.time()
    summary = read_json(
        state_dir / "service-matrix-refresh-summary.json", {},
    )
    summary_read_completed_ns = time.monotonic_ns()
    if not isinstance(summary, dict) or not isinstance(
        summary.get("prepared_class_decisions"), dict,
    ):
        return timed({
            "ok": False,
            "status": "PREPARED_TARGET_PROJECTION_MISSING",
            "blockers": ["prepared_projection_missing"],
        })
    payload: dict[str, Any] = {}
    returncode = 2
    validated_context = (
        validated_projection_context
        if isinstance(validated_projection_context, dict)
        else {}
    )
    context_projection = validated_context.get("prepared_class_decisions")
    context_freshness = validated_context.get(
        "prepared_class_decision_freshness"
    )
    if (
        validated_context.get("owner_validation_status")
        == "PREPARED_CLASS_DECISION_FRESH"
        and isinstance(context_projection, dict)
        and bool(context_projection)
        and isinstance(context_freshness, dict)
        and str(context_freshness.get("status") or "")
        == "PREPARED_CLASS_DECISION_FRESH"
    ):
        # The same Matrix invocation already asked the official Planner owner
        # to validate this exact projection.  A bounded refresh below changes
        # only PATH facts for targets declared by that projection.  Reusing
        # the process-local result avoids invalidating it merely because that
        # owned refresh advanced the Matrix generation.  Registry, Matrix,
        # capacity and target identity are still reread below, and the Planner
        # performs its normal final mutable-state validation before apply.
        payload = {
            "ok": True,
            "prepared_class_decisions": context_projection,
            "prepared_class_decision_freshness": context_freshness,
            "prepared_projection_reuse": {
                "ok": True,
                "status": "SAME_INVOCATION_OWNER_VALIDATION_REUSED",
                "runtime_mutation_performed": False,
            },
        }
        owner_invocation = "SAME_INVOCATION_OWNER_VALIDATION_REUSED"
        returncode = 0
    else:
        try:
            owner_invocation = "IN_PROCESS_EXISTING_PLANNER_OWNER"
            module = in_process_autoswitch_module(planner)
            owner_args = in_process_autoswitch_args(
                module,
                state_dir=state_dir,
                event_dir=event_dir,
                policy_file=policy_file,
                audit_store=audit_store,
            )
            reuse = module.reuse_current_prepared_class_projection(owner_args)
            if reuse.get("ok"):
                payload = {
                    "ok": True,
                    "prepared_class_decisions": reuse.get(
                        "prepared_class_decisions"
                    ) or {},
                    "prepared_class_decision_freshness": reuse.get(
                        "prepared_class_decision_freshness"
                    ) or {},
                    "prepared_projection_reuse": reuse,
                }
                returncode = 0
        except Exception:
            # Fail over to the same executable owner.  This is availability of
            # an invocation mechanism, never a bypass of its validation result.
            payload = {}
    if not payload:
        owner_invocation = "EXISTING_PLANNER_SUBPROCESS_FALLBACK"
        command = [
            planner,
            "--prepared-class-projection-only",
            "--state-dir", str(state_dir),
            "--event-dir", str(event_dir),
            "--policy-file", str(policy_file),
            "--action-class-audit-store", str(audit_store),
        ]
        try:
            proc = subprocess.run(
                command,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=15,
            )
            payload = json.loads(proc.stdout or "{}")
            returncode = proc.returncode
        except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError) as exc:
            owner_validation_completed_ns = time.monotonic_ns()
            return timed({
                "ok": False,
                "status": "PREPARED_TARGET_PROJECTION_UNAVAILABLE",
                "blockers": [f"prepared_projection_owner_failed:{type(exc).__name__}"],
            })
    owner_validation_completed_ns = time.monotonic_ns()
    projection = (
        payload.get("prepared_class_decisions")
        if isinstance(payload, dict)
        and isinstance(payload.get("prepared_class_decisions"), dict)
        else {}
    )
    freshness = (
        payload.get("prepared_class_decision_freshness")
        if isinstance(payload, dict)
        and isinstance(payload.get("prepared_class_decision_freshness"), dict)
        else {}
    )
    if (
        returncode != 0
        or payload.get("ok") is not True
        or str(freshness.get("status") or "")
        != "PREPARED_CLASS_DECISION_FRESH"
    ):
        return timed({
            "ok": False,
            "status": "PREPARED_TARGET_PROJECTION_STALE",
            "blockers": list(
                (payload.get("prepared_projection_reuse") or {}).get(
                    "blockers"
                )
                or ["prepared_projection_not_fresh"]
            ),
        })

    current_scope = (
        current_source_scope
        if isinstance(current_source_scope, dict)
        else current_failed_source_scope(event_dir, state_dir)
    )
    current_failed = sorted({
        str(row.get("channel") or "")
        for row in (
            current_scope.get("certification_only_active_sources") or []
        )
        if isinstance(row, dict)
        and bool(row.get("source_currently_failed"))
        and str(row.get("channel") or "")
    })
    selected_source = current_failed[0] if current_failed else ""
    incident_reference_epoch = 0.0
    for source_row in (
        current_scope.get("certification_only_active_sources") or []
    ):
        if not isinstance(source_row, dict) or str(
            source_row.get("channel") or ""
        ) != selected_source:
            continue
        binding_event = (
            source_row.get("binding_event")
            if isinstance(source_row.get("binding_event"), dict)
            else {}
        )
        source_scope = (
            binding_event.get("source_scope")
            if isinstance(binding_event.get("source_scope"), dict)
            else {}
        )
        incident_observed_at = str(
            binding_event.get("observed_at")
            or source_scope.get("observed_at")
            or ""
        )
        try:
            incident_reference_epoch = max(
                incident_reference_epoch,
                datetime.fromisoformat(
                    incident_observed_at.replace("Z", "+00:00")
                ).timestamp(),
            )
        except (TypeError, ValueError):
            continue
    classes = [
        row for row in (projection.get("classes") or [])
        if isinstance(row, dict)
        and str(row.get("source_channel") or "") == selected_source
    ]
    declared_targets: list[str] = []
    for row in classes:
        for target in row.get("hot_targets") or []:
            target_id = str(
                (target or {}).get("target_id")
                if isinstance(target, dict) else ""
            )
            if target_id and target_id not in declared_targets:
                declared_targets.append(target_id)

    hot_target_set = (
        projection.get("hot_target_set")
        if isinstance(projection.get("hot_target_set"), dict)
        else {}
    )
    declared_capacity: dict[str, int] = {}
    for contract in hot_target_set.get("contracts") or []:
        if not isinstance(contract, dict):
            continue
        target_id = str(contract.get("target_id") or "")
        if target_id not in declared_targets:
            continue
        declared_capacity[target_id] = max(
            declared_capacity.get(target_id, 0),
            int(contract.get("target_safe_additional_capacity") or 0),
        )

    egress_rows = {
        str(row.get("id") or ""): row
        for row in parse_registry(state_dir / "egress.registry")
        if str(row.get("id") or "")
    }
    matrix = read_json(state_dir / "service-matrix.json", {})
    matrix_items = (
        matrix.get("items")
        if isinstance(matrix, dict)
        and isinstance(matrix.get("items"), dict)
        else {}
    )
    targets: list[dict[str, Any]] = []
    rejected: list[str] = []
    for target_id in declared_targets:
        registry = egress_rows.get(target_id) or {}
        observed = matrix_items.get(target_id)
        observed = observed if isinstance(observed, dict) else {}
        # The one-second prepared-target PATH owner intentionally updates only
        # ``path_evidence_updated``; ``checked_at`` belongs to the slower full
        # service pass.  Using the latter here discarded fresh pre-ready path
        # proof and forced a full target/world-model diagnostic at every hard
        # incident.  Required-service freshness remains owned and checked by
        # the dedicated Telegram/other-service lanes and again by Planner at
        # use; this timestamp is only the PATH eligibility clock.
        observed_at = str(
            observed.get("path_evidence_updated")
            or observed.get("checked_at")
            or observed.get("updated")
            or ""
        )
        try:
            observed_epoch = datetime.fromisoformat(
                observed_at.replace("Z", "+00:00")
            ).timestamp()
            # A target proven fresh when T0 was confirmed remains legitimate
            # input to this incident even if Python/Authority validation runs
            # for several seconds afterwards.  Evidence refreshed after T0 is
            # measured at validation entry.  Planner/apply still revalidates
            # the mutable target immediately before route mutation.
            freshness_reference_epoch = (
                incident_reference_epoch
                if (
                    incident_reference_epoch > 0
                    and observed_epoch <= incident_reference_epoch
                )
                else incident_validation_epoch
            )
            age_seconds = max(
                0.0,
                freshness_reference_epoch - observed_epoch,
            )
        except (TypeError, ValueError):
            age_seconds = -1.0
            freshness_reference_epoch = 0.0
        path = (
            observed.get("path_evidence")
            if isinstance(observed.get("path_evidence"), dict)
            else {}
        )
        components = (
            path.get("component_status")
            if isinstance(path.get("component_status"), dict)
            else {}
        )
        path_ok = bool(
            components
            and all(
                str(value or "").upper() == "PASS"
                for value in components.values()
            )
        )
        status_ok = str(observed.get("status") or "").upper() in {
            "OK", "DEGRADED",
        }
        free_capacity = max(0, declared_capacity.get(target_id, 0))
        admitted = bool(
            registry
            and bool_value(registry.get("enabled", "1"), default=True)
            and not bool_value(registry.get("canary_reserved"))
            and target_id != selected_source
            and status_ok
            and path_ok
            and 0.0 <= age_seconds <= 3.0
            and free_capacity >= 1
        )
        if not admitted:
            rejected.append(target_id)
            continue
        health = {
            "ok": True,
            "observation_fingerprint": hashlib.sha256(
                json.dumps(
                    {
                        "target": target_id,
                        "observed_at": observed_at,
                        "path_fingerprint": path.get("path_fingerprint"),
                    },
                    sort_keys=True,
                    separators=(",", ":"),
                ).encode("utf-8")
            ).hexdigest(),
        }
        targets.append({
            "target_id": target_id,
            "health": health,
            "shared_target_technically_eligible": True,
            "ordinary_planner_eligible": True,
            "controlled_rebind_eligible": False,
            "controlled_only_contract": False,
            "verification_supported": True,
            "rollback_containment_supported": True,
            "shared_target_availability": {
                "state": "HEALTHY",
                "policy_boundary": "NONE",
                "hard_reasons": [],
            },
            "capacity": {
                "target_safe_additional_capacity": free_capacity,
            },
            "prepared_projection_owner": str(
                projection.get("owner") or ""
            ),
            "prepared_projection_produced_at": str(
                projection.get("produced_at") or ""
            ),
            "matrix_path_age_seconds": round(age_seconds, 3),
            "matrix_path_freshness_reference": (
                "CONFIRMED_T0"
                if freshness_reference_epoch == incident_reference_epoch
                and incident_reference_epoch > 0
                else "INCIDENT_VALIDATION_ENTRY"
            ),
        })
    result = {
        "schema_version": (
            "v7.prepared-controlled-target-selection-diagnostic.v1"
        ),
        "status": (
            "PREPARED_CONTROLLED_TARGET_READY"
            if targets else "PREPARED_CONTROLLED_TARGET_STOP_SAFE"
        ),
        "ok": bool(targets),
        "targets": targets,
        "selection": {
            "selected_target_id": str(
                (targets[0] if targets else {}).get("target_id") or ""
            ),
        },
        "selected_source_id": selected_source,
        "declared_target_count": len(declared_targets),
        "rejected_targets": rejected,
        "world_model_rebuilt": False,
        "manual_server_selection": False,
        "full_diagnostic_fallback_required": not bool(targets),
        "runtime_mutation_performed": False,
        "users_moved": 0,
    }
    # Private, process-local hand-off used only when this exact invocation
    # refreshes rejected declared PATH facts.  The caller removes it before
    # any diagnostic is persisted or passed to another owner.
    result["_validated_projection_context"] = {
        "owner_validation_status": "PREPARED_CLASS_DECISION_FRESH",
        "prepared_class_decisions": projection,
        "prepared_class_decision_freshness": freshness,
    }
    return timed(result)


def refresh_rejected_prepared_target_paths(
    diagnostic: dict[str, Any],
    *,
    state_dir: Path,
    lock_timeout_sec: int = 5,
) -> dict[str, Any]:
    """Refresh PATH only for targets already declared by the Planner.

    This is the bounded incident-time counterpart of the pre-ready PATH role.
    It cannot discover, rank or widen the target set: the input must be the
    exact rejected set from a current prepared projection.  The canonical
    Matrix owner performs the observation and durable write.  Any incomplete
    scope or failed observation leaves the established full diagnostic as the
    fail-closed backstop.
    """
    rejected = sorted({
        str(target_id or "")
        for target_id in (diagnostic.get("rejected_targets") or [])
        if SAFE_EGRESS_RE.fullmatch(str(target_id or ""))
    })
    declared_count = int(diagnostic.get("declared_target_count") or 0)
    selected_source = str(diagnostic.get("selected_source_id") or "")
    eligible = bool(
        str(diagnostic.get("status") or "")
        == "PREPARED_CONTROLLED_TARGET_STOP_SAFE"
        and declared_count > 0
        and rejected
        and len(rejected) <= declared_count
    )
    if not eligible:
        return {
            "schema_version": "v7.exact-prepared-target-path-refresh.v1",
            "status": "NOT_APPLICABLE",
            "ok": False,
            "requested_targets": rejected,
            "refreshed_targets": [],
            "target_scope_widened": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
        }

    registry_rows = {
        str(row.get("id") or ""): row
        for row in parse_registry(state_dir / "egress.registry")
        if str(row.get("id") or "") in rejected
        and str(row.get("id") or "") != selected_source
        and bool_value(row.get("enabled", "1"), default=True)
    }
    rows: list[dict[str, str]] = []
    for target_id in rejected:
        registry_row = registry_rows.get(target_id)
        if not registry_row:
            continue
        row = dict(registry_row)
        row["_prepared_services"] = ""
        rows.append(row)
    resolved = [str(row.get("id") or "") for row in rows]
    if resolved != rejected:
        return {
            "schema_version": "v7.exact-prepared-target-path-refresh.v1",
            "status": "STOP_SAFE_EXACT_PREPARED_TARGET_SCOPE_UNRESOLVED",
            "ok": False,
            "requested_targets": rejected,
            "refreshed_targets": [],
            "missing_targets": sorted(set(rejected) - set(resolved)),
            "target_scope_widened": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
        }

    results, timing = run_prepared_path_rows_in_process(
        rows,
        checker=default_checker_path(),
        state_dir=state_dir,
        concurrency=min(16, len(rows)),
        lock_timeout_sec=int(lock_timeout_sec),
    )
    refreshed = sorted({
        str(row.get("egress") or "")
        for row in results
        if isinstance(row, dict) and row.get("ok") is True
    })
    ok = refreshed == rejected
    return {
        "schema_version": "v7.exact-prepared-target-path-refresh.v1",
        "status": (
            "EXACT_PREPARED_TARGET_PATH_REFRESH_PASS"
            if ok else "STOP_SAFE_EXACT_PREPARED_TARGET_PATH_REFRESH_FAILED"
        ),
        "ok": ok,
        "requested_targets": rejected,
        "refreshed_targets": refreshed,
        "results": results,
        "performance_timeline": timing,
        "target_scope_widened": False,
        "world_model_rebuilt": False,
        "manual_server_selection": False,
        "routing_mutation_performed": False,
        "users_moved": 0,
    }


def consume_approved_controlled_source_topology(
    planner: str,
    *,
    state_dir: Path,
    policy_file: Path,
    audit_store: Path,
) -> dict[str, Any]:
    """Deliver an independently approved topology provision to its owner.

    The Matrix is only the existing wake/consumer.  The planner performs all
    admission, exact-once and reservation checks, so this wrapper cannot turn
    an absent or mismatched approval into a registry mutation.
    """
    command = [
        planner,
        "--consume-approved-controlled-source-topology",
        "--state-dir", str(state_dir),
        "--policy-file", str(policy_file),
        "--action-class-audit-store", str(audit_store),
    ]
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=180,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.controlled-source-topology-matrix-consumer.v1",
            "status": "STOP_SAFE_CONSUMER_UNAVAILABLE",
            "ok": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "error": f"{type(exc).__name__}:{exc}",
        }
    try:
        result = json.loads(proc.stdout or "{}")
    except json.JSONDecodeError:
        result = {}
    if not isinstance(result, dict):
        result = {}
    return {
        "schema_version": "v7.controlled-source-topology-matrix-consumer.v1",
        "status": str(result.get("status") or "STOP_SAFE_INVALID_CONSUMER_RESULT"),
        "ok": bool(result.get("ok")),
        "returncode": proc.returncode,
        "runtime_mutation_performed": bool(
            result.get("runtime_mutation_performed")
        ),
        "registry_write": bool(result.get("registry_write")),
        "routing_mutation": bool(result.get("routing_mutation")),
        "users_moved": int(result.get("users_moved") or 0),
        "consumer_result": result,
        "output_tail": (proc.stdout or "")[-2000:]
        if not result.get("ok") else "",
    }


def record_controlled_campaign_stage_consumption(
    *,
    audit_store: Path,
    binding: dict[str, Any],
    result: dict[str, Any],
    reset_result: dict[str, Any],
) -> dict[str, Any]:
    """Append one exact stage receipt through the existing audit owner."""
    stage = int(binding.get("next_stage") or 0)
    feedback = (
        result.get("feedback_materialization")
        if isinstance(result.get("feedback_materialization"), dict)
        else {}
    )
    reset_payload = (
        reset_result.get("consumer_result")
        if isinstance(reset_result.get("consumer_result"), dict)
        else {}
    )
    semantic = {
        "request_id": str(binding.get("request_id") or ""),
        "request_hash": str(binding.get("request_hash") or ""),
        "stage": stage,
        "packet_id": str(
            result.get("fresh_packet_id")
            or result.get("packet_id")
            or ""
        ),
        "outcome_id": str(
            result.get("outcome_id")
            or feedback.get("outcome_id")
            or ((result.get("l3_learning_closure") or {}).get("outcome_id"))
            or ""
        ),
        "reset_receipt_id": str(
            reset_payload.get("receipt_id")
            or reset_payload.get("operation_id")
            or ""
        ),
    }
    learning = (
        result.get("l3_learning_closure")
        if isinstance(result.get("l3_learning_closure"), dict)
        else {}
    )
    closure = (
        learning.get("execution_closure_verification")
        if isinstance(
            learning.get("execution_closure_verification"),
            dict,
        )
        else {}
    )
    records = (
        learning.get("records")
        if isinstance(learning.get("records"), dict)
        else {}
    )
    outcome_consumed = bool(
        feedback.get("materialized")
        and feedback.get("outcome_id")
    )
    learning_consumed = bool(
        (
            learning.get("materialized")
            or learning.get("reason") == "already_materialized"
        )
        and (
            records.get("closure")
            or learning.get("reason") == "already_materialized"
        )
    )
    replay_consumed = bool(
        closure.get("terminal_consumer_verified")
        and closure.get("behavior_chain_status") == "COMPLETE"
    )
    cohort_verified = (
        int(result.get("users_moved") or 0) == stage
        and bool(result.get("apply_executed"))
        and str(result.get("final_verdict") or "")
        in {"GOVERNED_TRANSACTION_COMPLETED", "L3_PRODUCTION_PROVEN"}
    )
    baseline_reset_verified = (
        bool(reset_result.get("ok"))
        and int(reset_payload.get("target_user_count_after", -1)) == 0
        and int(reset_payload.get("ordinary_customer_count") or 0) == 0
        and int(reset_payload.get("users_moved") or 0) == stage
        and str(reset_payload.get("final_safe_mode") or "") == "OPEN"
    )
    if not (
        outcome_consumed
        and learning_consumed
        and replay_consumed
        and cohort_verified
        and baseline_reset_verified
    ):
        return {
            "receipt_id": "",
            "audit_write": False,
            "duplicate_suppressed": False,
            "blockers": [
                name
                for name, passed in (
                    ("controlled_campaign_outcome_not_consumed", outcome_consumed),
                    ("controlled_campaign_learning_not_consumed", learning_consumed),
                    ("controlled_campaign_replay_not_consumed", replay_consumed),
                    ("controlled_campaign_cohort_not_verified", cohort_verified),
                    (
                        "controlled_campaign_baseline_reset_not_verified",
                        baseline_reset_verified,
                    ),
                )
                if not passed
            ],
        }
    receipt_id = "cpsstage_" + operator_execution.sha256_json(semantic)[:24]
    with operator_execution.current_action_class_contract_policy_lock(
        audit_store
    ):
        records = operator_execution.read_live_execution_lineage_records(
            audit_store
        )
        prior = [
            row
            for row in records
            if row.get("record_type")
            == CONTROLLED_CAMPAIGN_EFFECT_RECORD_TYPE
            and row.get("effect_class")
            == CONTROLLED_CAMPAIGN_STAGE_EFFECT_CLASS
            and str(row.get("authority_request_id") or "")
            == str(binding.get("request_id") or "")
            and int(row.get("campaign_stage") or 0) == stage
        ]
        if prior:
            return {
                "receipt_id": str(prior[-1].get("receipt_id") or ""),
                "audit_write": False,
                "duplicate_suppressed": True,
            }
        row = operator_execution.append_record(audit_store, {
            "schema_version": "v7.controlled-certification-campaign-stage.v1",
            "record_type": CONTROLLED_CAMPAIGN_EFFECT_RECORD_TYPE,
            "effect_class": CONTROLLED_CAMPAIGN_STAGE_EFFECT_CLASS,
            "receipt_id": receipt_id,
            "authority_request_id": str(binding.get("request_id") or ""),
            "authority_request_hash": str(binding.get("request_hash") or ""),
            "authority_decision_id": str(binding.get("decision_id") or ""),
            "campaign_stage": stage,
            "source_id": str(binding.get("source") or ""),
            "target_id": str(binding.get("target") or ""),
            "packet_id": semantic["packet_id"],
            "outcome_id": semantic["outcome_id"],
            "outcome_consumed": outcome_consumed,
            "replay_consumed": replay_consumed,
            "learning_consumed": learning_consumed,
            "cohort_verified": cohort_verified,
            "baseline_reset_verified": baseline_reset_verified,
            "reset_receipt_id": semantic["reset_receipt_id"],
            "ordinary_customer_count": 0,
            "raw_identity_list_stored": False,
            "created_at": now_iso(),
        })
    return {
        "receipt_id": str(row.get("receipt_id") or receipt_id),
        "audit_write": True,
        "duplicate_suppressed": False,
    }


def record_availability_first_stage_consumption(
    *,
    audit_store: Path,
    result: dict[str, Any],
) -> dict[str, Any]:
    """Append one exact availability-first stage receipt to the same owner."""
    stage = int(result.get("stage") or 0)
    contract_id = str(
        result.get("standing_policy_contract_id") or ""
    )
    contract_hash = str(
        result.get("standing_policy_contract_hash") or ""
    )
    required = (
        "allocation_immutable",
        "capacity_reservation_verified",
        "outcome_consumed",
        "replay_consumed",
        "learning_consumed",
        "per_user_verification_passed",
        "per_target_verification_passed",
        "aggregate_verification_passed",
        "ordinary_user_protection_passed",
        "baseline_reset_verified",
    )
    blockers = [
        name
        for name in required
        if result.get(name) is not True
    ]
    if (
        result.get("final_verdict")
        != "AVAILABILITY_FIRST_STANDING_STAGE_COMPLETED"
    ):
        blockers.append("availability_first_stage_not_complete")
    if stage not in operator_execution.AVAILABILITY_FIRST_LADDER:
        blockers.append("availability_first_stage_not_in_ladder")
    if not contract_id or not contract_hash:
        blockers.append("availability_first_contract_identity_missing")
    if blockers:
        return {
            "receipt_id": "",
            "audit_write": False,
            "duplicate_suppressed": False,
            "blockers": sorted(set(blockers)),
        }
    semantic = {
        "contract_id": contract_id,
        "contract_hash": contract_hash,
        "stage": stage,
        "execution_allocation_fingerprint": str(
            result.get("execution_allocation_fingerprint") or ""
        ),
        "packet_set_fingerprint": str(
            result.get("packet_set_fingerprint") or ""
        ),
    }
    receipt_id = "afstage_" + operator_execution.sha256_json(
        semantic
    )[:24]
    with operator_execution.current_action_class_contract_policy_lock(
        audit_store
    ):
        rows = operator_execution.read_live_execution_lineage_records(
            audit_store
        )
        prior = [
            row
            for row in rows
            if row.get("record_type")
            == CONTROLLED_CAMPAIGN_EFFECT_RECORD_TYPE
            and row.get("effect_class")
            == AVAILABILITY_FIRST_CAMPAIGN_STAGE_EFFECT_CLASS
            and str(row.get("standing_policy_contract_id") or "")
            == contract_id
            and int(row.get("campaign_stage") or 0) == stage
        ]
        if prior:
            return {
                "receipt_id": str(prior[-1].get("receipt_id") or ""),
                "audit_write": False,
