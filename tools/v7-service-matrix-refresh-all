    return {
        "schema_version": "v7.service-failure-automation-advisory-liveness.v1",
        "status": "PASS" if proc.returncode == 0 and isinstance(parsed, dict) and parsed.get("ok") else "FAILED",
        "ok": proc.returncode == 0 and isinstance(parsed, dict) and parsed.get("ok") is True,
        "started_at": started_at,
        "completed_at": now_iso(),
        "command": command,
        "returncode": proc.returncode,
        "consumer_result": parsed,
        "output_tail": output[-2000:],
    }


def run_service_failure_omp_consumer(*, timeout_sec: int = 45) -> dict[str, Any]:
    """Consume the already-materialized obligation through the standard OMP entrypoint.

    Production deploys the evidence owner but deliberately not the source CPS
    corpus.  This narrow existing-owner command persists the consumption
    receipt in production; the canonical source CPS is reconciled only from
    that owner-backed receipt by its source owner.
    """
    command = ["v7-truth-check", "--consume-service-failure-automation-only", "--json"]
    started_at = now_iso()
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(10, min(int(timeout_sec or 45), 180)),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.service-failure-omp-consumer-liveness.v1",
            "status": "FAILED", "ok": False, "started_at": started_at,
            "error": str(exc), "command": command,
        }
    output = proc.stdout or ""
    try:
        parsed = json.loads(output)
    except json.JSONDecodeError:
        parsed = {}
    passed = (
        proc.returncode == 0
        and isinstance(parsed, dict)
        and parsed.get("final_verdict") in {
            "PASS",
            "BOUNDED_CONTINUATION",
            "NO_PENDING_OBLIGATION",
        }
    )
    return {
        "schema_version": "v7.service-failure-omp-consumer-liveness.v1",
        "status": "PASS" if passed else "FAILED",
        "ok": passed,
        "started_at": started_at,
        "completed_at": now_iso(),
        "command": command,
        "returncode": proc.returncode,
        "consumer_result": parsed,
        "output_tail": output[-2000:],
    }


def _consumer_projection(payload: Any) -> dict[str, Any]:
    """Keep a lifecycle receipt compact while leaving full truth with its owner.

    Matrix refresh is an observation/wake producer, not an outcome registry.
    Its child consumers already persist their complete facts in the existing
    event, execution and closure owners.  Re-embedding whole child responses
    here caused each periodic refresh to grow the next refresh's input.
    """
    value = payload if isinstance(payload, dict) else {}
    result = value.get("consumer_result")
    result = result if isinstance(result, dict) else {}
    # CT-M0F is a direct existing Matrix consumer rather than the generic
    # wrapper used by the older campaign lanes.  Without this adaptation its
    # durable Matrix receipt retained neither its terminal nor the exact
    # predicate path that explains why a fresh sample was or was not admitted.
    if (
        not result
        and str(value.get("schema_version") or "").startswith(
            "v7.ct-m0f-standing-validation-matrix-consumer."
        )
    ):
        result = value
    compact_result = {
        key: result.get(key)
        for key in (
            "final_verdict", "status", "next_output", "legal_terminal",
            "receipt_id", "obligation_id", "frontier_id", "packet_id",
            "feedback_id", "outcome_id", "transaction_status", "stop_reason",
            "stop_detail", "error",
            "blockers", "stage", "baseline_reset_verified",
            "target_bound_trial", "target_bound_trial_target",
            "campaign_next_stage", "completion_kind",
            "outcome_consumed", "replay_consumed", "learning_consumed",
            "durable_successor",
        )
        if result.get(key) not in (None, "", [], {})
    }
    prepared = result.get("prepared_class_decisions") or value.get("prepared_class_decisions")
    if isinstance(prepared, dict) and prepared:
        compact_result["prepared_class_decisions"] = prepared
    prepared_freshness = result.get("prepared_class_decision_freshness") or value.get("prepared_class_decision_freshness")
    if isinstance(prepared_freshness, dict) and prepared_freshness:
        compact_result["prepared_class_decision_freshness"] = prepared_freshness
    bounded_closure = result.get("bounded_closure_reconciliation") or value.get("bounded_closure_reconciliation")
    if isinstance(bounded_closure, dict) and bounded_closure:
        compact_result["bounded_closure_reconciliation"] = bounded_closure
    # The Autoswitch owner already produces a bounded monotonic performance
    # timeline.  Preserve only its scalar advisory spans in the existing
    # Matrix lifecycle projection: this makes the observed cost attributable
    # without re-embedding child state, raw history or a new metrics store.
    timing = result.get("performance_timeline") or value.get("performance_timeline")
    if isinstance(timing, dict):
        spans = timing.get("spans") if isinstance(timing.get("spans"), list) else []
        advisory_spans = [
            {
                key: row.get(key)
                for key in (
                    "stage", "parent", "owner", "clock_source", "duration_ms",
                    "status", "critical_path",
                )
                if row.get(key) not in (None, "", [], {})
            }
            for row in spans
            if isinstance(row, dict)
            and (
                str(row.get("parent") or "") in {
                    "service_failure_advisory",
                    "service_failure_advisory_materialization",
                }
                or str(row.get("stage") or "").startswith("advisory_")
            )
        ]
        if advisory_spans:
            compact_result["advisory_performance_timeline"] = {
                "schema_version": str(timing.get("schema_version") or ""),
                "clock_source": str(timing.get("clock_source") or ""),
                "owner": str(timing.get("owner") or ""),
                "spans": advisory_spans,
            }
        # Passive consumption has an independent, existing read-only timing
        # result. Keep its three scalar spans in the same compact receipt so
        # its cost can be compared without retaining raw event/state payloads.
        passive_spans = [
            {
                key: row.get(key)
                for key in ("stage", "owner", "clock_source", "duration_ms")
                if row.get(key) not in (None, "", [], {})
            }
            for row in spans
            if isinstance(row, dict)
            and str(row.get("stage") or "").startswith("passive_")
        ]
        if passive_spans:
            compact_result["passive_performance_timeline"] = {
                "schema_version": str(timing.get("schema_version") or ""),
                "spans": passive_spans,
            }
    sample_preparation = (
        result.get("sample_preparation_receipt")
        or value.get("sample_preparation_receipt")
    )
    if isinstance(sample_preparation, dict) and sample_preparation:
        predicates = sample_preparation.get("predicates")
        predicates = predicates if isinstance(predicates, dict) else {}
        source_selection = sample_preparation.get("source_selection")
        source_selection = (
            source_selection if isinstance(source_selection, dict) else {}
        )
        compact_result["ct_m0f_sample_preparation"] = {
            "schema_version": str(sample_preparation.get("schema_version") or ""),
            "phase": str(sample_preparation.get("phase") or ""),
            "contract_id": str(sample_preparation.get("contract_id") or ""),
            "reservation_id": str(sample_preparation.get("reservation_id") or ""),
            "terminal": str(sample_preparation.get("terminal") or ""),
            "blockers": list(sample_preparation.get("blockers") or [])[:12],
            "next_required_consumer": str(
                sample_preparation.get("next_required_consumer") or ""
            ),
            "source_selection": {
                key: source_selection.get(key)
                for key in (
                    "state", "selection_mode", "source", "user", "target",
                    "binding_fingerprint",
                )
                if source_selection.get(key) not in (None, "", [], {})
            },
            "predicates": {
                name: predicate
                for name, predicate in predicates.items()
                if isinstance(predicate, dict)
            },
        }
    # The governed executor already emits a compact terminal cohort-policy
    # binding.  Retain its bounded reason here too: Matrix owns this lifecycle
    # projection, while the full Packet/lease and execution evidence remains
    # with the existing specialized owners.  Without this pointer a normal
    # STOP_SAFE terminal is reduced to a name, forcing a later investigation
    # to replay or infer a policy gate that was already proven.
    cohort_binding = result.get("standing_delegated_policy_binding")
    cohort_binding = cohort_binding if isinstance(cohort_binding, dict) else {}
    compact_cohort_binding = {
        key: cohort_binding.get(key)
        for key in (
            "ok",
            "blockers",
            "max_users_per_action",
            "max_concurrent_transactions",
            "action_class",
            "authority_audit_verified",
            "self_expansion_allowed",
        )
        if key in cohort_binding
        and (
            cohort_binding.get(key) not in (None, "", [], {})
            or key in {"ok", "authority_audit_verified", "self_expansion_allowed"}
        )
    }
    if compact_cohort_binding:
        compact_result["standing_delegated_policy_binding"] = (
            compact_cohort_binding
        )
    # A Planner subprocess that returns no plan is a terminal pre-Packet
    # condition. Keep its already bounded diagnostic in the existing Matrix
    # receipt; this avoids re-running the expensive Planner merely to learn
    # whether it failed, timed out or returned an empty result.
    planner_plan_availability = result.get("planner_plan_availability")
    planner_plan_availability = (
        planner_plan_availability
        if isinstance(planner_plan_availability, dict)
        else {}
    )
    compact_planner_plan_availability = {
        key: planner_plan_availability.get(key)
        for key in ("ok", "returncode", "error", "stderr_tail", "stdout_tail")
        if key in planner_plan_availability
        and (
            planner_plan_availability.get(key) not in (None, "", [], {})
            or key == "ok"
        )
    }
    if compact_planner_plan_availability:
        compact_result["planner_plan_availability"] = (
            compact_planner_plan_availability
        )
    ordinary_pre_packet_scope = result.get("ordinary_pre_packet_scope")
    ordinary_pre_packet_scope = (
        ordinary_pre_packet_scope
        if isinstance(ordinary_pre_packet_scope, dict)
        else {}
    )
    compact_ordinary_pre_packet_scope = {
        key: ordinary_pre_packet_scope.get(key)
        for key in (
            "valid",
            "selected_count",
            "requested_max_users",
            "certification_selected_count",
        )
        if key in ordinary_pre_packet_scope
    }
    if compact_ordinary_pre_packet_scope:
        compact_result["ordinary_pre_packet_scope"] = (
            compact_ordinary_pre_packet_scope
        )
    # Keep the terminal handoff from the existing route/apply consumer
    # inspectable without embedding its payload.  A parent
    # ``l3_production_validation_downstream_proof_failed`` is otherwise too
    # coarse to distinguish an apply timeout from a verification or rollback
    # gate, and would force a repeat of an already-expensive execution merely
    # to identify the responsible owner.
    downstream = result.get("downstream_proof_diagnostic")
    downstream = downstream if isinstance(downstream, dict) else {}
    compact_downstream = {
        key: downstream.get(key)
        for key in (
            "apply_command_ok", "apply_returncode", "apply_timed_out",
            "child_final_verdict", "child_transaction_status",
            "child_stop_reason", "child_stop_detail", "proof_blockers",
            "route_apply_failure_count", "route_apply_failure_reasons",
            "verification_failure_count", "verification_failure_reasons",
            "route_verification_failure_categories",
            "route_verification_scopes",
            "rollback_failure_count", "capability_production_proven",
        )
        if downstream.get(key) not in (None, "", [], {})
        or key in {"apply_command_ok", "apply_timed_out"}
    }
    if compact_downstream:
        compact_result["downstream_proof_diagnostic"] = compact_downstream
    for key in (
        "performance_benchmark",
        "campaign_stage_credit",
        "stage_48_optimized_runtime_ready",
        "stage_48_execution_permitted",
    ):
        if key in result:
            compact_result[key] = result.get(key)
    if result.get("performance_benchmark") is True:
        compact_result["cohort_execution_timings"] = [
            row
            for row in (result.get("cohort_execution_timings") or [])
            if isinstance(row, dict)
        ]
        compact_result["performance_timeline"] = [
            row
            for row in (result.get("performance_timeline") or [])
            if isinstance(row, dict)
        ]
    # A target-bound trial has a verified scope (often 5 or 10) but is not a
    # campaign-stage receipt for that number.  Retain both identities in the
    # compact Matrix projection so transient runtime work cannot be mistaken
    # for a duplicate of an already consumed campaign stage.
    if result.get("performance_benchmark") is True:
        compact_result["execution_scope_kind"] = (
            "PERFORMANCE_BENCHMARK_NO_STAGE_CREDIT"
        )
        compact_result["benchmark_scope"] = int(
            result.get("stage") or 0
        )
        compact_result["campaign_stage"] = 0
    elif result.get("target_bound_trial") is True:
        compact_result["execution_scope_kind"] = "TARGET_BOUND_TRIAL"
        compact_result["trial_scope"] = int(result.get("stage") or 0)
        compact_result["campaign_stage"] = int(
            result.get("campaign_next_stage") or 0
        )
    elif result.get("stage") not in (None, "", 0):
        compact_result["execution_scope_kind"] = "CAMPAIGN_STAGE"
        compact_result["campaign_stage"] = int(result.get("stage") or 0)
    # Availability-first stages may stop inside one governed subset after the
    # outer stage has already passed admission.  Preserve the bounded terminal
    # and circuit-breaker reason so the next Matrix/OMP consumer can identify
    # the exact failed gate without replaying a production action.  The full
    # cycle and diagnostics remain with their existing specialized owners.
    circuit_breaker = result.get("circuit_breaker")
    circuit_breaker = (
        circuit_breaker if isinstance(circuit_breaker, dict) else {}
    )
    compact_circuit_breaker = {
        key: circuit_breaker.get(key)
        for key in (
            "tripped", "remaining_subsets_stopped", "reason",
        )
        if circuit_breaker.get(key) not in (None, "", [], {})
    }
    if compact_circuit_breaker:
        compact_result["circuit_breaker"] = compact_circuit_breaker
    packet_set = result.get("packet_set")
    packet_set = packet_set if isinstance(packet_set, list) else []
    compact_packet_set = [
        {
            key: row.get(key)
            for key in (
                "final_verdict", "transaction_status", "stop_reason",
                "fresh_packet_id", "decision_id", "operation_id",
                "user", "users", "source", "target", "target_id",
                "users_moved", "runtime_mutation_performed",
                "verification_result", "rollback_result",
                "feedback_id", "outcome_id", "learning_record_id",
            )
            if row.get(key) not in (None, "", [], {})
        }
        for row in packet_set
        if isinstance(row, dict)
    ]
    for compact_packet, packet in zip(compact_packet_set, packet_set):
        downstream = packet.get("downstream_proof_diagnostic")
        if isinstance(downstream, dict) and downstream:
            compact_packet["downstream_proof_diagnostic"] = {
                key: downstream.get(key)
                for key in (
                    "apply_command_ok", "apply_returncode",
                    "apply_timed_out", "child_final_verdict",
                    "child_transaction_status", "child_stop_reason",
                    "child_stop_detail", "proof_blockers",
                    "route_apply_failure_count", "route_apply_failure_reasons",
                    "verification_failure_count", "verification_failure_reasons",
                    "route_verification_failure_categories", "rollback_failure_count",
                    "route_verification_scopes",
                    "capability_production_proven",
                )
                if downstream.get(key) not in (None, "", [], {})
                or key in {"apply_command_ok", "apply_timed_out"}
            }
    compact_packet_set = [row for row in compact_packet_set if row]
    if compact_packet_set:
        compact_result["packet_set"] = compact_packet_set
    partial = result.get("partial_apply_recovery")
    partial = partial if isinstance(partial, dict) else {}
    compact_partial = {
        key: partial.get(key)
        for key in (
            "pending", "ok", "blockers", "stage", "user", "source",
            "target", "packet_id", "operation_id", "projection_source",
            "recovery_mode", "cohort_packet_count",
            "cohort_projection_exact", "performance_benchmark",
            "campaign_stage_credit",
        )
        if partial.get(key) not in (None, "", [], {})
    }
    if compact_partial:
        compact_result["partial_apply_recovery"] = compact_partial
    reset = result.get("reset_transaction")
    reset = reset if isinstance(reset, dict) else {}
    compact_reset = {
        key: reset.get(key)
        for key in (
            "final_verdict", "transaction_status", "stop_reason", "stop_detail",
            "fresh_packet_id", "operation_id", "user", "source", "target",
            "runtime_mutation_performed", "verification_result",
            "rollback_result", "users_moved",
        )
        if reset.get(key) not in (None, "", [], {})
    }
    if compact_reset:
        compact_result["reset_transaction"] = compact_reset
        reset_diagnostic = reset.get("packet_preparation_diagnostic")
        if isinstance(reset_diagnostic, dict):
            compact_result["reset_transaction"][
                "packet_preparation_diagnostic"
            ] = {
                key: reset_diagnostic.get(key)
                for key in (
                    "cycle_stop_reason", "cycle_stop_detail",
                    "candidate_user", "candidate_source",
                    "candidate_target", "packet_preview_status",
                    "packet_binding_blockers", "safety_hard_stop",
                    "safety_blockers",
                )
                if reset_diagnostic.get(key) not in (None, "", [], {})
            }
    reset_rows = [
        row for row in (result.get("reset_transactions") or [])
        if isinstance(row, dict)
    ]
    compact_reset_rows = [
        {
            key: row.get(key)
            for key in (
                "final_verdict", "transaction_status", "stop_reason",
                "stop_detail", "fresh_packet_id", "operation_id", "user",
                "source", "target", "runtime_mutation_performed",
                "verification_result", "rollback_result", "users_moved",
            )
            if row.get(key) not in (None, "", [], {})
        }
        for row in reset_rows
    ]
    compact_reset_rows = [row for row in compact_reset_rows if row]
    if compact_reset_rows:
        compact_result["reset_transactions"] = compact_reset_rows
    reset_reconciliations = [
        row for row in (result.get("baseline_reset_reconciliations") or [])
        if isinstance(row, dict)
    ]
    if reset_reconciliations:
        compact_result["baseline_reset_reconciliations"] = [
            {
                key: row.get(key)
                for key in (
                    "ok", "mode", "current_egress", "packet_id",
                    "operation_id", "switch_lineage", "natural_l8_credit",
                    "production_outcome_credit",
                )
                if row.get(key) not in (None, "", [], {})
            }
            for row in reset_reconciliations
        ]
    reset_reconciliation = result.get("baseline_reset_reconciliation")
    reset_reconciliation = (
        reset_reconciliation
        if isinstance(reset_reconciliation, dict)
        else {}
    )
    compact_reset_reconciliation = {
        key: reset_reconciliation.get(key)
        for key in (
            "ok", "mode", "current_egress", "packet_id", "operation_id",
            "switch_lineage", "natural_l8_credit",
            "production_outcome_credit",
        )
        if reset_reconciliation.get(key) not in (None, "", [], {})
    }
    if compact_reset_reconciliation:
        compact_result["baseline_reset_reconciliation"] = (
            compact_reset_reconciliation
        )
    timeline = [
        row for row in (result.get("performance_timeline") or [])
        if isinstance(row, dict)
    ]
    compact_timeline = [
        {
            key: row.get(key)
            for key in (
                "phase", "owner", "status", "member_id", "packet_id",
                "operation_id", "completed_at", "started_offset_us",
                "duration_us",
            )
            if row.get(key) not in (None, "", [], {})
        }
        for row in timeline[-256:]
    ]
    if compact_timeline:
        compact_result["performance_timeline"] = compact_timeline
        compact_result["performance_timeline_truncated"] = (
            len(timeline) > len(compact_timeline)
        )
    if result.get("stage_total_duration_us") not in (None, ""):
        compact_result["stage_total_duration_us"] = int(
            result.get("stage_total_duration_us") or 0
        )
    if result.get("serial_baseline_reset_count") not in (None, ""):
        compact_result["serial_baseline_reset_count"] = int(
            result.get("serial_baseline_reset_count") or 0
        )
    if result.get("allocation_lineage_refresh_count") not in (None, ""):
        compact_result["allocation_lineage_refresh_count"] = int(
            result.get("allocation_lineage_refresh_count") or 0
        )
    reset_reconciliations = [
        {
            key: row.get(key)
            for key in (
                "ok", "mode", "current_egress", "packet_id",
                "operation_id", "switch_lineage",
                "natural_l8_credit", "production_outcome_credit",
            )
            if row.get(key) not in (None, "", [], {})
        }
        for row in (result.get("baseline_reset_reconciliations") or [])
        if isinstance(row, dict)
    ]
    reset_reconciliations = [
        row for row in reset_reconciliations if row
    ]
    if reset_reconciliations:
        compact_result["baseline_reset_reconciliations"] = (
            reset_reconciliations
        )
    # A governed executor keeps the full Outcome with the execution owner,
    # but its bounded receipt deliberately nests this one immutable pointer.
    # Preserve the pointer (not the nested payload) so the Matrix lifecycle
    # can prove which existing post-action consumer owns the next step.
    feedback = result.get("feedback_materialization")
    feedback = feedback if isinstance(feedback, dict) else {}
    for key in ("feedback_id", "outcome_id", "learning_record_id"):
        if feedback.get(key) not in (None, "", [], {}):
            compact_result.setdefault(key, feedback.get(key))
    causal = result.get("service_failure_causal_binding")
    causal = causal if isinstance(causal, dict) else {}
    compact_causal = {
        key: causal.get(key)
        for key in (
            "automation_obligation_id", "omp_consumption_id",
            "source_incident_id", "source_event_id", "observation_generation",
            "source_channel", "event_type", "event_provenance",
        )
        if causal.get(key) not in (None, "", [], {})
    }
    projected = {
        key: value.get(key)
        for key in (
            "schema_version", "status", "ok", "started_at", "completed_at",
            "returncode", "action_attempted", "action_completed",
            "runtime_mutation_performed", "users_moved", "reason", "error",
            "reservation_mutation_performed",
            "reservation_released_after_stop", "stop_reason",
            "contract_id", "contract_hash", "admitted_max_users",
            "max_concurrent_transactions", "blockers", "source",
            "target", "trial_identity", "manifest_hash",
            "stage", "diagnostic_status", "receipt_id",
            "performance_benchmark", "performance_gate_receipt_id",
            "completion_kind", "stage_48_optimized_runtime_ready",
            "stage_48_execution_permitted", "campaign_stage_credit",
            "durable_successor", "completed_stages_this_invocation",
            "source_incident_id", "automation_obligation_id",
            "affected_scope", "unresolved_scope",
        )
        if value.get(key) not in (None, "", [], {})
    } | ({"consumer_result": compact_result} if compact_result else {})
    stage_consumption = value.get("stage_consumption")
    stage_consumption = (
        stage_consumption
        if isinstance(stage_consumption, dict)
        else {}
    )
    compact_stage_consumption = {
        key: stage_consumption.get(key)
        for key in (
            "receipt_id", "audit_write", "duplicate_suppressed",
            "blockers",
        )
        if stage_consumption.get(key) not in (None, "", [], {})
    }
    if compact_stage_consumption:
        projected["stage_consumption"] = compact_stage_consumption
    successor_probe = value.get("successor_probe")
    successor_probe = (
        successor_probe if isinstance(successor_probe, dict) else {}
    )
    compact_successor_probe = {
        key: successor_probe.get(key)
        for key in (
            "status", "ok", "stage", "diagnostic_status",
            "blockers", "durable_successor",
        )
        if successor_probe.get(key) not in (None, "", [], {})
    }
    if compact_successor_probe:
        projected["successor_probe"] = compact_successor_probe
    if compact_causal:
        projected["service_failure_causal_binding"] = compact_causal
    return projected


def compact_refresh_projection(payload: dict[str, Any]) -> dict[str, Any]:
    """Project one refresh lifecycle without recursively storing child output.

    Complete decision, packet, execution, verification, replay and Learning
    evidence remains with the existing specialized owners.  This projection
    retains only the Matrix caller/consumer receipt and explicit pointers.
    """
    results = [
        {
            key: row.get(key)
            for key in ("egress", "status", "ok", "rc", "ok_count", "total", "elapsed_sec")
            if row.get(key) not in (None, "", [], {})
        }
        for row in (payload.get("results") or [])
        if isinstance(row, dict)
    ]
    projection = {
        "schema_version": "v7.service-matrix-refresh-lifecycle-projection.v1",
        "updated": payload.get("updated"),
        "elapsed_sec": payload.get("elapsed_sec"),
        "total": payload.get("total"),
        "ok_count": payload.get("ok_count"),
        "status": payload.get("status", "OK"),
        "results": results,
        "passive_failure_capture": payload.get("passive_failure_capture") or {},
        "current_failed_source_scope": payload.get("current_failed_source_scope") or {},
        "omp_product_frontiers": list(payload.get("omp_product_frontiers") or ()),
        "omp_product_frontier_owner": payload.get("omp_product_frontier_owner", ""),
        "next_output": payload.get("next_output", ""),
        "evidence_owners": {
            "matrix": "service-matrix.json",
            "passive_events": "service-failure-events.jsonl",
            "execution": "execution-events.jsonl",
            "outcome_and_omp": "closure-records.jsonl",
        },
        "capture_only": True,
        "candidate_or_execution_forbidden": True,
        "full_child_payload_embedded": False,
    }
    for key in (
        "passive_event_consumer", "service_failure_automation_advisory",
        "service_failure_omp_consumer", "service_failure_post_action_passive_consumer",
        "service_failure_post_action_omp_consumer",
        "bounded_delegated_service_failure_action",
        "availability_first_standing_policy_action",
        "controlled_topology_standing_policy_action",
        "ct_m0f_standing_validation_campaign",
    ):
        if key in payload:
            projection[key] = _consumer_projection(payload.get(key))
    return projection


def append_event(event_dir: Path, payload: dict[str, Any]) -> None:
    try:
        event_dir.mkdir(parents=True, exist_ok=True)
        path = event_dir / f"service-matrix-refresh-{datetime.now(timezone.utc).strftime('%Y%m%d')}.jsonl"
        with path.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(compact_refresh_projection(payload), ensure_ascii=False, sort_keys=True) + "\n")
    except OSError:
        pass


def current_failed_source_scope(event_dir: Path, state_dir: Path) -> dict[str, Any]:
    """Read the latest canonical source denominators for the fast consumer.

    This is deliberately a compact projection of the existing Matrix event
    log, not a second incident store.  The 30-second planner consumer must not
    run the complete advisory/action chain for a failed source which currently
    has no users to protect.  A later ordinary Matrix generation remains the
    owner of any fresh revalidation.
    """
    path = event_dir / "service-failure-events.jsonl"
    latest_by_incident: dict[tuple[str, str], dict[str, Any]] = {}
    rows = intelligence_workers.read_jsonl_tail(
        path,
        limit=CURRENT_SCOPE_EVENT_ROW_LIMIT,
        max_bytes=CURRENT_SCOPE_EVENT_BYTE_LIMIT,
    )
    for row in rows:
        if str(row.get("event_type") or "") not in {
            "SERVICE_FAILURE_OBSERVED", "SERVICE_FAILURE_REVALIDATED",
        }:
            continue
        channel = str(row.get("channel") or "")
        if channel:
            incident_id = str(row.get("source_incident_id") or "")
            # A long-lived source can have an older current hard failure and
            # a newer stale/recovered episode.  Keep the event identity with
            # the current Matrix row's source-incident id rather than letting
            # a later unrelated event silently replace it by channel.
            latest_by_incident[(channel, incident_id)] = row
    try:
        user_rows = [
            parse_kv_line(line)
            for line in (state_dir / "users.registry").read_text(
                encoding="utf-8", errors="replace"
            ).splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        ]
    except OSError:
        user_rows = []
    current_users = {
        str(row.get("current") or "")
        for row in user_rows
        if bool_value(row.get("enabled"), default=True) and str(row.get("current") or "")
    }
    matrix = read_json(state_dir / "service-matrix.json", {})
    matrix_items = matrix.get("items") if isinstance(matrix, dict) and isinstance(matrix.get("items"), dict) else {}
    active = []
    certification_only_active = []
    for (channel, _incident_id), row in sorted(latest_by_incident.items()):
        scope = row.get("source_scope") if isinstance(row.get("source_scope"), dict) else {}
        ordinary_users = [
            user for user in user_rows
            if bool_value(user.get("enabled"), default=True)
            and str(user.get("current") or "") == channel
            and not bool_value(user.get("certification_user"), default=False)
        ]
        certification_users = [
            user for user in user_rows
            if bool_value(user.get("enabled"), default=True)
            and str(user.get("current") or "") == channel
            and bool_value(user.get("certification_user"), default=False)
        ]
        source_row = matrix_items.get(channel) if isinstance(matrix_items.get(channel), dict) else {}
        services = source_row.get("services") if isinstance(source_row.get("services"), dict) else {}
        source_currently_failed = any(
            isinstance(service, dict)
            and (
                str(service.get("failure_state") or "").startswith("OBSERVED")
                or service.get("ok") is False
            )
            for service in services.values()
        )
        ordinary_scope = (
            scope.get("ordinary_production_scope")
            if isinstance(scope.get("ordinary_production_scope"), dict)
            else scope
        )
        count = len(ordinary_users)
        row_projection = {
                "channel": channel,
                "source_incident_id": str(row.get("source_incident_id") or ""),
                "affected_scope_count": count,
                "source_scope_fingerprint": str(
                    ordinary_scope.get("affected_scope_fingerprint") or ""
                ),
                "event_id": str(row.get("event_id") or ""),
                "source_currently_failed": source_currently_failed,
                "scope_classification": str(
                    scope.get("scope_classification") or "LEGACY_UNPARTITIONED"
                ),
                "controlled_certification_scope_count": len(certification_users),
            }
        if count:
            active.append(row_projection)
        elif certification_users and source_currently_failed:
            certification_only_active.append(row_projection)
    active = [row for row in active if row["source_currently_failed"]]
    return {
        "owner": "tools/v7-service-matrix-test.update_matrix",
        "active": bool(active),
        "active_sources": active,
        "certification_only_active_sources": certification_only_active,
        # An ordinary failover action must not be attempted for this scope,
        # but the passive consumer/advisory must still reconcile the durable
        # certification-only terminal so an older ordinary drain cannot remain
        # current in CPS.
        "requires_scope_reconciliation": bool(certification_only_active),
        "latest_source_count": len(latest_by_incident),
        "current_assigned_sources": sorted(current_users),
        "decision": (
            "PROCEED_EXISTING_SERVICE_FAILURE_LIFECYCLE"
            if active else
            "RECONCILE_CONTROLLED_CERTIFICATION_SCOPE_ONLY"
            if certification_only_active else
            "NO_ACTION_CURRENT_FAILED_SOURCE_SCOPE_EMPTY"
        ),
    }


def direct_service_failure_handoff_for_scope(
    *, state_dir: Path, source_scope: dict[str, Any],
) -> tuple[dict[str, Any], dict[str, Any]]:
    """Read one already-durable direct L3 handoff for the current Matrix scope.

    This is a reader over existing Matrix/L3/closure owners. It does not
    materialize a new incident or relax the exact source/scope identity check.
    """
    active_sources = (
        source_scope.get("active_sources")
        if isinstance(source_scope.get("active_sources"), list)
        else []
    )
    direct_source = (
        active_sources[0]
        if len(active_sources) == 1 and isinstance(active_sources[0], dict)
        else {}
    )
    handoff = service_failure_direct_execution_handoff(
        state_dir=state_dir,
        source_incident_id=str(direct_source.get("source_incident_id") or ""),
        source_scope_fingerprint=str(direct_source.get("source_scope_fingerprint") or ""),
    )
    obligation = (
        handoff.get("obligation")
        if handoff.get("final_verdict") == "READY"
        and isinstance(handoff.get("obligation"), dict)
        else {}
    )
    return handoff, obligation


def ordinary_direct_handoff_ready_for_passive_deferral(
    *,
    event_only: bool,
    source_scope: dict[str, Any],
    obligation: dict[str, Any],
    skip_passive_consumer: bool,
) -> bool:
    """Allow an exact ordinary handoff to precede unrelated certification tail.

    `requires_scope_reconciliation` is intentionally global: a separate
    certification-only source still needs its durable passive terminal.  It is
    not, by itself, a dependency of an identity-bound ordinary L3 handoff.
    The existing executor remains the final selected-identity/Packet fence.
    """
    active_sources = (
        source_scope.get("active_sources")
        if isinstance(source_scope.get("active_sources"), list)
        else []
    )
    direct_source = (
        active_sources[0]
        if len(active_sources) == 1 and isinstance(active_sources[0], dict)
        else {}
    )
    return bool(
        event_only
        and obligation
        and str(obligation.get("stop_safe_classification") or "")
        == "STOP_SAFE_FRESH_EVENT_REVALIDATION_REQUIRED"
        and int(obligation.get("bounded_recommendation_users") or 0) > 0
        and str(direct_source.get("scope_classification") or "")
        in {"ORDINARY_ONLY", "MIXED_ORDINARY_AND_CERTIFICATION"}
        and not skip_passive_consumer
    )


def should_defer_certification_tail(
    *,
    event_only: bool,
    current_scope: dict[str, Any],
    bounded_action: dict[str, Any],
) -> bool:
    """Keep non-actionable certification work out of an active ordinary drain.

    Availability-first, controlled-topology, and CT-M0F are existing
    certification lanes. They cannot make a current ordinary incident
    actionable after the governed action has already failed closed, and they
    must not delay the next Matrix observation while ordinary users remain on
    the failed source. Their durable frontier and explicit existing-owner
    re-entry remain intact; this helper merely controls synchronous placement.
    """
    if event_only or not bool(current_scope.get("active")):
        return False
    statuses = {
        "STOP_SAFE_CURRENT_INCIDENT_NOT_ACTIONABLE",
        "STOP_SAFE_CURRENT_SOURCE_SCOPE_EMPTY",
        "STOP_SAFE_NO_CURRENT_SERVICE_FAILURE_OBLIGATION",
    }
    return (
        str(bounded_action.get("status") or "") in statuses
        and not bool(bounded_action.get("action_completed"))
    )


def sha256_json(payload: Any) -> str:
    return hashlib.sha256(json.dumps(payload, ensure_ascii=True, sort_keys=True, default=str).encode("utf-8")).hexdigest()


def enabled_users_on_egress(state_dir: Path, egress_id: str) -> list[str]:
    users: list[str] = []
    try:
        lines = (state_dir / "users.registry").read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return users
    for line in lines:
        row = parse_kv_line(line)
        if row.get("current") == egress_id and bool_value(row.get("enabled"), default=True) and row.get("ip"):
            users.append(str(row["ip"]))
    return sorted(set(users))


def latest_history_failure_episode(state_dir: Path, channel: str) -> Optional[dict[str, Any]]:
    """Return the latest persisted failure episode for one canonical channel.

    This deliberately reads the existing egress-history owner.  An operator may
    report a short external outage only after it has recovered; a fresh matrix
    refresh alone would then be unable to prove that real, already-observed
    condition without inventing a new failure.
    """
    path = state_dir / "egress-history.jsonl"
    rows: list[dict[str, Any]] = []
    try:
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines()[-5000:]:
            parsed = json.loads(line)
            if isinstance(parsed, dict) and f"{channel}_code" in parsed:
                rows.append(parsed)
    except (OSError, json.JSONDecodeError):
        return None
    failed_indexes = [
        index for index, row in enumerate(rows)
        if not str(row.get(f"{channel}_code") or "").startswith("2")
    ]
    if not failed_indexes:
        return None
    last = failed_indexes[-1]
    first = last
    while first > 0 and not str(rows[first - 1].get(f"{channel}_code") or "").startswith("2"):
        first -= 1
    recovered_at = ""
    for row in rows[last + 1:]:
        if str(row.get(f"{channel}_code") or "").startswith("2"):
            recovered_at = str(row.get("time") or "")
            break
    episode = rows[first:last + 1]
    return {
        "history_path": str(path.name),
        "observed_at": str(rows[first].get("time") or ""),
        "last_failed_at": str(rows[last].get("time") or ""),
        "recovered_at": recovered_at,
        "failure_count": len(episode),
        "failure_codes": sorted({str(row.get(f"{channel}_code") or "") for row in episode}),
        "history_hash": sha256_json(episode),
    }


def append_passive_failure_capture(
    event_dir: Path,
    *,
    state_dir: Path,
    matrix: dict[str, Any],
    refresh_payload: dict[str, Any],
    provenance: str,
    trigger_reference: str,
    declared_channel: str = "",
) -> list[dict[str, Any]]:
    """Append one source-bound observation record per declared external failure.

    This is deliberately a capture-only projection.  It must never become an
    execution wake, an L7 transaction, or natural-L8 credit on its own.
    """
    if not provenance:
        return []
    if provenance == "OPERATOR_INDUCED":
        # An operator-induced incident is source-bound to the declared canonical
        # channel.  Never reinterpret whichever channel happens to be unhealthy
        # at refresh time as that reported incident.
        channel = str(declared_channel or "")
        registry = parse_registry(state_dir / "egress.registry")
        if not channel or not any(row.get("id") == channel for row in registry):
            return []
        affected_users = enabled_users_on_egress(state_dir, channel)
        episode = latest_history_failure_episode(state_dir, channel)
        if not affected_users or not episode:
            return []
        source_hashes = {
            "egress_history_episode": str(episode["history_hash"]),
            "egress_registry": sha256_json(registry),
            "users_on_source": sha256_json(affected_users),
        }
        identity = {
            "schema_version": "v7.passive-production-failure-capture.v1",
            "channel": channel,
            "provenance": provenance,
            "trigger_reference": trigger_reference,
            "observed_at": episode["observed_at"],
            "source_hashes": source_hashes,
        }
        row = {
            **identity,
            "event_id": "pevt_" + sha256_json(identity)[:24],
            "event_type": "external_channel_unavailability",
            "producer": "tools/v7-service-matrix-refresh-all",
            "source_files": ["egress-history.jsonl", "service-matrix.json", "egress.registry", "users.registry"],
            "affected_users": affected_users,
            "history_episode": episode,
            "capture_matrix_hash": sha256_json(matrix),
            "capture_only": True,
            "execution_forbidden": True,
            "candidate_packet_lease_forbidden": True,
            "natural_production_credit": False,
            "l7_credit": False,
            "synthetic_event": False,
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
        }
        event_dir.mkdir(parents=True, exist_ok=True)
        path = event_dir / "service-failure-events.jsonl"
        existing_ids: set[str] = set()
        try:
            for line in path.read_text(encoding="utf-8", errors="replace").splitlines()[-2000:]:
                parsed = json.loads(line)
                if isinstance(parsed, dict) and parsed.get("event_id"):
                    existing_ids.add(str(parsed["event_id"]))
        except (OSError, json.JSONDecodeError):
            pass
        if row["event_id"] in existing_ids:
            return []
        with path.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")
        return [row]
    items = matrix.get("items") if isinstance(matrix.get("items"), dict) else {}
    rows: list[dict[str, Any]] = []
    for result in refresh_payload.get("results") or []:
        if not isinstance(result, dict) or bool(result.get("ok")):
            continue
        egress_id = str(result.get("egress") or "")
        item = items.get(egress_id) if isinstance(items.get(egress_id), dict) else {}
        services = item.get("services") if isinstance(item.get("services"), dict) else {}
        failed_services = sorted(
            str(name) for name, service in services.items()
            if isinstance(service, dict)
            and (service.get("ok") is False or str(service.get("status") or "").upper() in {"FAIL", "ERROR", "DOWN", "NOT_STARTED"})
        )
        affected_users = enabled_users_on_egress(state_dir, egress_id)
        if not egress_id or not failed_services or not affected_users:
            continue
        source_hashes = {
            "service_matrix": sha256_json(item),
            "egress_registry": sha256_json(parse_registry(state_dir / "egress.registry")),
            "users_on_source": sha256_json(affected_users),
        }
        identity = {
            "schema_version": "v7.passive-production-failure-capture.v1",
            "channel": egress_id,
            "failed_services": failed_services,
            "provenance": provenance,
            "trigger_reference": trigger_reference,
            "source_hashes": source_hashes,
        }
        event_id = "pevt_" + sha256_json(identity)[:24]
        rows.append({
            **identity,
            "event_id": event_id,
            "event_type": "external_channel_unavailability",
            "observed_at": str(item.get("updated") or refresh_payload.get("updated") or now_iso()),
            "producer": "tools/v7-service-matrix-refresh-all",
            "source_files": ["service-matrix.json", "egress.registry", "users.registry"],
            "affected_users": affected_users,
            "capture_only": True,
            "execution_forbidden": True,
            "candidate_packet_lease_forbidden": True,
            "natural_production_credit": False,
            "l7_credit": False,
            "synthetic_event": False,
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
        })
    if not rows:
        return []
    event_dir.mkdir(parents=True, exist_ok=True)
    path = event_dir / "service-failure-events.jsonl"
    existing_ids: set[str] = set()
    try:
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines()[-2000:]:
            parsed = json.loads(line)
            if isinstance(parsed, dict) and parsed.get("event_id"):
                existing_ids.add(str(parsed["event_id"]))
    except (OSError, json.JSONDecodeError):
        pass
    new_rows = [row for row in rows if row["event_id"] not in existing_ids]
    if new_rows:
        with path.open("a", encoding="utf-8") as fh:
            for row in new_rows:
                fh.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")
    return new_rows


