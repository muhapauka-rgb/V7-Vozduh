        "--lock-acquired-marker",
        default="",
        help="Write an owner-backed marker after this lifecycle invocation acquires the writer lock.",
    )
    parser.add_argument("--pretty", action="store_true")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    started = time.time()
    state_dir = Path(args.state_dir)
    event_only = bool(args.consume_existing_service_failure_events_only)
    registry_rows = parse_registry(state_dir / "egress.registry")
    try:
        rows, requested_egresses = select_probe_rows(registry_rows, args.egresses)
    except ValueError as exc:
        detail = str(exc)
        error, _, missing = detail.partition(":")
        payload = {"error": error}
        if missing:
            payload["missing_egresses"] = missing.split(",")
        print(json.dumps(payload, ensure_ascii=False))
        return 2
    service_subset = str(args.services or "").strip()
    profile_user = str(args.shadow_trigger_profile_user or "").strip()
    if service_subset and profile_user:
        print(json.dumps({
            "error": "shadow_service_subset_sources_mutually_exclusive",
        }, ensure_ascii=False))
        return 2
    if profile_user:
        resolved_profile_services = resolve_profile_service_subset(state_dir, profile_user)
        if not resolved_profile_services:
            print(json.dumps({
                "error": "profile_service_subset_missing_or_empty",
                "profile_user": profile_user,
            }, ensure_ascii=False))
            return 2
        service_subset = ",".join(resolved_profile_services)
    if event_only and (requested_egresses or service_subset):
        print(json.dumps({
            "error": "probe_subset_invalid_in_event_consumption_only_mode",
        }, ensure_ascii=False))
        return 2
    if args.staggered_deep and (
        not args.matrix_observation_only
        or event_only
        or requested_egresses
        or bool(service_subset)
    ):
        print(json.dumps({
            "error": (
                "staggered_deep_requires_full_scope_observation_only_"
                "without_explicit_subset"
            ),
        }, ensure_ascii=False))
        return 2
    if args.prepared_hot_targets and (
        not args.matrix_observation_only
        or args.staggered_deep
        or event_only
        or requested_egresses
        or bool(service_subset)
    ):
        print(json.dumps({
            "error": (
                "prepared_hot_targets_require_observation_only_without_"
                "explicit_subset_or_deep"
            ),
        }, ensure_ascii=False))
        return 2
    shadow_trigger_requested = any(
        str(value or "").strip()
        for value in (
            args.shadow_trigger_source,
            args.shadow_trigger_class,
            args.shadow_trigger_id,
        )
    )
    shadow_trigger: dict[str, Any] = {}
    shadow_persistence_samples = max(0, int(args.shadow_failure_persistence_samples or 0))
    shadow_persistence_window = max(0, int(args.shadow_failure_persistence_window_seconds or 0))
    if (shadow_persistence_samples or shadow_persistence_window) and (
        not args.matrix_observation_only or not shadow_trigger_requested
    ):
        print(json.dumps({
            "error": "shadow_persistence_override_requires_observation_only_shadow_trigger",
        }, ensure_ascii=False))
        return 2
    if shadow_trigger_requested:
        trigger_source = str(args.shadow_trigger_source or "").strip()
        trigger_class = str(args.shadow_trigger_class or "").strip()
        trigger_id = str(args.shadow_trigger_id or "").strip()
        trigger_services = [item.strip() for item in service_subset.split(",") if item.strip()]
        if not args.matrix_observation_only:
            print(json.dumps({
                "error": "shadow_trigger_requires_matrix_observation_only",
            }, ensure_ascii=False))
            return 2
        if len(requested_egresses) != 1 or not trigger_source or trigger_source != requested_egresses[0]:
            print(json.dumps({
                "error": "shadow_trigger_requires_exact_single_source",
                "requested_egresses": requested_egresses,
                "trigger_source": trigger_source,
            }, ensure_ascii=False))
            return 2
        if not trigger_services or "all" in {item.lower() for item in trigger_services}:
            print(json.dumps({
                "error": "shadow_trigger_requires_exact_service_subset",
            }, ensure_ascii=False))
            return 2
        if not trigger_class or not trigger_id:
            print(json.dumps({
                "error": "shadow_trigger_requires_class_and_id",
            }, ensure_ascii=False))
            return 2
        shadow_trigger = build_shadow_trigger_contract(
            source=trigger_source,
            failure_class=trigger_class,
            trigger_id=trigger_id,
            egresses=requested_egresses,
            services=trigger_services,
            profile_user=profile_user,
        )
        shadow_trigger["controlled_persistence_override"] = {
            "samples": shadow_persistence_samples or 3,
            "window_seconds": shadow_persistence_window or 180,
            "production_default_changed": False,
        }
    # Probes are read/network work.  They must not hold the shared Matrix
    # writer lock; every existing ``v7-service-matrix-test`` invocation takes
    # that lock only for its own atomic durable update.  This preserves writer
    # serialization while allowing the fast failure producer to publish during
    # a long full refresh.
    deep_schedule: dict[str, Any] = {}
    prepared_hot_target_scope: dict[str, Any] = {}
    if args.staggered_deep:
        rows, deep_schedule = select_staggered_deep_rows(
            rows,
            read_json(state_dir / "service-matrix.json", {}),
            now_epoch=time.time(),
            horizon_seconds=int(args.deep_horizon_seconds),
            slot_seconds=int(args.deep_slot_seconds),
        )
    elif args.prepared_hot_targets:
        projection_file = (
            Path(args.prepared_projection_file)
            if str(args.prepared_projection_file or "").strip()
            else state_dir / "service-matrix-refresh-summary.json"
        )
        rows, prepared_hot_target_scope = select_prepared_hot_target_rows(
            rows, read_json(projection_file, {}),
        )

    def execute_row(row: dict[str, str]) -> dict[str, Any]:
        row_services = (
            str(row.get("_prepared_services") or "")
            if args.prepared_hot_targets else service_subset
        )
        row_timeout = (
            max(1, min(int(args.prepared_hot_target_timeout_sec or 1), 5))
            if args.prepared_hot_targets else max(3, min(int(args.timeout), 30))
        )
        return run_one(
            row["id"], row_timeout, args.checker,
            state_dir, row_services,
            shadow_persistence_samples,
            shadow_persistence_window,
            event_dir=Path(args.event_dir),
        )

    if event_only:
        results = []
    elif args.staggered_deep and rows:
        concurrency = max(1, min(int(args.deep_concurrency or 16), 128, len(rows)))
        with concurrent.futures.ThreadPoolExecutor(max_workers=concurrency) as executor:
            results = list(executor.map(execute_row, rows))
        deep_schedule["concurrency_cap"] = concurrency
        deep_schedule["fast_priority_contract"] = (
            "SEPARATE_HEALTH_ROLE; PER_EGRESS_WRITES_USE_EXISTING_SHORT_LOCK; "
            "NO_DEEP_BACKLOG"
        )
    elif args.prepared_hot_targets and rows:
        concurrency = max(
            1,
            min(
                int(args.prepared_hot_target_concurrency or 16),
                128,
                len(rows),
            ),
        )
        with concurrent.futures.ThreadPoolExecutor(max_workers=concurrency) as executor:
            results = list(executor.map(execute_row, rows))
        prepared_hot_target_scope["concurrency_cap"] = concurrency
        prepared_hot_target_scope["timeout_seconds_per_service"] = max(
            1, min(int(args.prepared_hot_target_timeout_sec or 1), 5)
        )
    else:
        results = [execute_row(row) for row in rows]
    writer_locks = [
        row.get("service_matrix_lock")
        for row in results
        if isinstance(row.get("service_matrix_lock"), dict)
    ]
    acquired_writes = [row for row in writer_locks if row.get("held")]
    if args.lock_acquired_marker and acquired_writes:
        write_json_atomic(Path(args.lock_acquired_marker), {
            "schema_version": "v7.service-matrix-lock-acquisition.v1",
            "owner": "tools/v7-service-matrix-refresh-all",
            "pid": os.getpid(),
            "acquired_at": now_iso(),
            "lock_path": str(state_dir / "service-matrix.lock"),
            "scope": "per_egress_durable_write",
            "writer_lock_acquisition_count": len(acquired_writes),
            "runtime_behavior_changed": False,
            "users_moved": False,
        })
    payload = {
        "schema_version": 1,
        "updated": now_iso(),
        "elapsed_sec": round(time.time() - started, 3),
        "total": len(results),
        "ok_count": sum(1 for row in results if row.get("ok")),
        "results": results,
        "service_matrix_lock": {
            "held": bool(acquired_writes),
            "scope": "per_egress_durable_write",
            "path": str(state_dir / "service-matrix.lock"),
            "writer_lock_acquisition_count": len(acquired_writes),
            "writer_lock_timeout_count": sum(
                1 for row in writer_locks if str(row.get("status") or "") == "LOCK_TIMEOUT"
            ),
            "runtime_behavior_changed": False,
            "users_moved": False,
        },
        "mode": (
            "EXISTING_EVENT_CONSUMPTION_ONLY" if event_only
            else "STAGGERED_DEEP_REFRESH" if args.staggered_deep
            else "PREPARED_HOT_TARGET_REFRESH" if args.prepared_hot_targets
            else "BOUNDED_EXACT_SUBSET_REFRESH" if requested_egresses or service_subset
            else "FULL_MATRIX_REFRESH"
        ),
        "probe_selection": {
            "egresses": requested_egresses or [str(row.get("id") or "") for row in rows],
            "services": [item.strip() for item in service_subset.split(",") if item.strip()] or ["all"],
            "role_selection_owner": (
                "EXISTING_MATRIX_DETERMINISTIC_DEEP_SLICER"
                if args.staggered_deep
                else "EXISTING_PLANNER_PREPARED_PROJECTION"
                if args.prepared_hot_targets
                else "EXTERNAL_EXISTING_MATRIX_CALLER"
            ),
            "full_matrix_fallback_preserved": True,
        },
    }
    if deep_schedule:
        payload["deep_schedule"] = deep_schedule
    if prepared_hot_target_scope:
        payload["prepared_hot_target_scope"] = prepared_hot_target_scope
    if shadow_trigger:
        payload["shadow_trigger"] = shadow_trigger
    if args.matrix_observation_only:
        payload["mode"] = (
            "STAGGERED_DEEP_OBSERVATION_ONLY"
            if args.staggered_deep else "MATRIX_OBSERVATION_ONLY"
        )
        if args.prepared_hot_targets:
            payload["mode"] = "PREPARED_HOT_TARGET_OBSERVATION_ONLY"
        payload["observation_only"] = {
            "owner": "tools/v7-service-matrix-refresh-all",
            "canonical_matrix_write_preserved": True,
            "passive_event_emitted": False,
            "downstream_consumer_invoked": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
        }
        print(json.dumps(payload, ensure_ascii=False, indent=2 if args.pretty else None))
        return 0
    summary_file = Path(args.summary_file) if args.summary_file else state_dir / "service-matrix-refresh-summary.json"
    if args.event_provenance == "OPERATOR_INDUCED" and not str(args.event_trigger_reference or "").strip():
        print(json.dumps({"error": "operator_induced_event_trigger_reference_required"}, ensure_ascii=False))
        return 2
    if args.event_provenance == "OPERATOR_INDUCED" and not str(args.event_channel or "").strip():
        print(json.dumps({"error": "operator_induced_event_channel_required"}, ensure_ascii=False))
        return 2
    matrix = read_json(state_dir / "service-matrix.json", {})
    capture_rows = append_passive_failure_capture(
        Path(args.event_dir),
        state_dir=state_dir,
        matrix=matrix,
        refresh_payload=payload,
        provenance=str(args.event_provenance or ""),
        trigger_reference=str(args.event_trigger_reference or "").strip(),
        declared_channel=str(args.event_channel or "").strip(),
    )
    payload["passive_failure_capture"] = {
        "emitted_event_ids": [row["event_id"] for row in capture_rows],
        "event_provenance": str(args.event_provenance or ""),
        "capture_only": True,
        "execution_forbidden": True,
        "natural_production_credit": False,
    }
    # Reuse an already materialized exact L3 handoff before passive
    # reconciliation. A new or ambiguous incident retains the original
    # passive-first path, so no fast path can invent a Candidate or bypass
    # current-scope reconciliation.
    source_scope = current_failed_source_scope(Path(args.event_dir), state_dir)
    direct_handoff, direct_service_failure_obligation = (
        direct_service_failure_handoff_for_scope(
            state_dir=state_dir,
            source_scope=source_scope,
        )
    )
    defer_passive_consumer_until_after_direct_execution = (
        ordinary_direct_handoff_ready_for_passive_deferral(
            event_only=event_only,
            source_scope=source_scope,
            obligation=direct_service_failure_obligation,
            skip_passive_consumer=bool(args.skip_passive_consumer),
        )
    )
    # A known certification-only source is not an ordinary customer failure.
    # It must never enter the ordinary passive/OMP path.  Its existing CT-M0F
    # consumer has an independently observed Runtime memory ceiling, so the
    # Matrix owner records a bounded STOP_SAFE instead of re-waking a process
    # that the kernel has already had to terminate.  The source/target binding
    # and executor pre-apply gates remain available for the next bounded
    # Polygon memory correction; no route action is attempted from this state.
    if (
        args.runtime_hot_path_only
        and not source_scope.get("active")
        and source_scope.get("certification_only_active_sources")
    ):
        payload["current_failed_source_scope"] = source_scope
        payload["ct_m0f_standing_validation_campaign"] = {
            "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
            "status": "STOP_SAFE_CONTROLLED_CONSUMER_RUNTIME_MEMORY_LIMIT",
            "ok": True,
            "action_attempted": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "blockers": ["existing_controlled_consumer_runtime_memory_limit"],
            "next_required_consumer": "bounded Polygon memory correction through existing CT-M0F owners",
        }
        ct_m0f_action = payload["ct_m0f_standing_validation_campaign"]
        payload["passive_event_consumer"] = {
            "schema_version": "v7.passive-consumer-liveness.v1",
            "status": "DEFERRED_TO_EXISTING_CONTROLLED_OWNER",
            "ok": bool(ct_m0f_action.get("ok")),
            "reason": "certification_only_scope_waits_for_bounded_existing_consumer_memory_correction",
            "runtime_mutation_performed": bool(
                ct_m0f_action.get("runtime_mutation_performed")
            ),
        }
        payload["service_failure_omp_consumer"] = {
            "schema_version": "v7.service-failure-omp-consumer-liveness.v1",
            "status": "DEFERRED_OUTSIDE_RUNTIME_HOT_PATH",
            "ok": True,
            "reason": "certification_only_scope_is_not_an_ordinary_runtime_handoff",
        }
        payload["next_output"] = str(
            ct_m0f_action.get("status")
            or "STOP_SAFE_CONTROLLED_CERTIFICATION_CONSUMER_NO_TERMINAL"
        )
        compact_payload = compact_refresh_projection(payload)
        write_json_atomic(summary_file, compact_payload)
        append_event(Path(args.event_dir), payload)
        print(json.dumps(compact_payload, ensure_ascii=False, indent=2 if args.pretty else None))
        return 0
    if args.skip_passive_consumer:
        payload["passive_event_consumer"] = {
            "schema_version": "v7.passive-consumer-liveness.v1",
            "status": "SKIPPED_EXPLICITLY",
            "ok": False,
            "omp_repair_frontier": {
                "frontier_id": "V7_PASSIVE_SERVICE_EVENT_CONSUMER_REPAIR",
                "last_responsible_producer": "tools/v7-service-matrix-refresh-all",
                "missing_consumer": "tools/v7-users-autoswitch --consume-passive-events-only",
                "exact_missing_artifact": "passive consumer terminal",
                "forbidden_effects": "NONE",
            },
        }
    elif defer_passive_consumer_until_after_direct_execution:
        payload["passive_event_consumer"] = {
            "schema_version": "v7.passive-consumer-liveness.v1",
            "status": "DEFERRED_UNTIL_AFTER_DIRECT_EXECUTION",
            "ok": True,
            "reason": "existing_matrix_l3_closure_handoff_is_exact_and_ready",
            "runtime_mutation_performed": False,
        }
    else:
        payload["passive_event_consumer"] = run_passive_consumer(
            str(args.passive_consumer),
            state_dir=state_dir,
            event_dir=Path(args.event_dir),
            timeout_sec=int(args.passive_consumer_timeout_sec),
        )
    consumer_payload = (
        (payload.get("passive_event_consumer") or {}).get("consumer_result") or {}
    )
    consumer_result = (
        consumer_payload.get("result")
        if isinstance(consumer_payload.get("result"), dict)
        else {}
    )
    payload["omp_product_frontiers"] = list(
        consumer_result.get("omp_frontiers") or ()
    )
    # The fast consumer is deliberately invoked by the already-active planner
    # timer.  It sees no new network condition and must therefore exit before
    # advisory planning when no failed source presently owns a user scope.
    # This prevents a source with zero users from turning a 4-second sentinel
    # revalidation stream into repeated expensive work.
    if not defer_passive_consumer_until_after_direct_execution:
        # Passive reconciliation may have materialized the first current L3
        # handoff. Re-read only through the same existing Matrix/L3 owners.
        source_scope = current_failed_source_scope(Path(args.event_dir), state_dir)
        direct_handoff, direct_service_failure_obligation = (
            direct_service_failure_handoff_for_scope(
                state_dir=state_dir,
                source_scope=source_scope,
            )
        )
    payload["current_failed_source_scope"] = source_scope
    if event_only and not source_scope["active"] and not source_scope.get("requires_scope_reconciliation"):
        payload["next_output"] = source_scope["decision"]
        compact_payload = compact_refresh_projection(payload)
        write_json_atomic(summary_file, compact_payload)
        append_event(Path(args.event_dir), payload)
        print(json.dumps(compact_payload, ensure_ascii=False, indent=2 if args.pretty else None))
        return 0
    # A validated existing-L3 handoff is already an exact Runtime input for
    # the existing executor.  Check it immediately after passive capture so
    # advisory history/reconciliation cannot add its measured ~49-second
    # background cost ahead of an eligible client move.  If it is absent or
    # ambiguous, retain the existing advisory producer and its fail-closed
    # semantics unchanged.
    payload["service_failure_direct_execution_handoff"] = direct_handoff
    if direct_service_failure_obligation:
        payload["service_failure_automation_advisory"] = {
            "schema_version": "v7.service-failure-automation-advisory-liveness.v1",
            "status": "NOT_REQUIRED_DIRECT_L3_HANDOFF_READY",
            "ok": True,
            "reason": "existing_l3_projection_proves_current_exact_handoff",
        }
    elif args.skip_service_failure_automation_advisory:
        payload["service_failure_automation_advisory"] = {
            "schema_version": "v7.service-failure-automation-advisory-liveness.v1",
            "status": "SKIPPED_EXPLICITLY",
            "ok": False,
            "reason": "explicit_skip",
        }
    else:
        payload["service_failure_automation_advisory"] = run_service_failure_automation_advisory(
            str(args.passive_consumer),
            state_dir=state_dir,
            event_dir=Path(args.event_dir),
            # This owner performs bounded durable reconciliation.  Its result
            # is never on the packet/apply hot path, but an occasional lock or
            # current-scope reconciliation must not cut it off before the
            # already durable current obligation can reach the existing OMP
            # receipt consumer.
            timeout_sec=max(90, int(args.passive_consumer_timeout_sec) + 15),
            matrix_comparative_preflight=bool(args.matrix_comparative_preflight),
        )
    advisory_result = (
        (payload.get("service_failure_automation_advisory") or {}).get("consumer_result") or {}
    )
    fresh_service_failure_obligation = service_failure_obligation_from_advisory(
        advisory_result
    )
    if fresh_service_failure_obligation:
        payload["service_failure_direct_execution_handoff"] = {
            "schema_version": "v7.service-failure-direct-execution-handoff.v1",
            "final_verdict": "FRESH_ADVISORY_OBLIGATION_PREFERRED",
            "runtime_mutation_performed": False,
        }
    service_failure_obligation = (
        fresh_service_failure_obligation or direct_service_failure_obligation
    )
    # A fresh advisory obligation is passed directly to the existing governed
    # executor below.  OMP is its exact-once receipt/evidence consumer, not
    # the producer of that object, so do not put the receipt wait in front of
    # fresh failure execution.  The receipt-bound handoff branch (no fresh
    # obligation) deliberately retains its existing ordering.
    defer_omp_receipt_until_after_fresh_execution = bool(
        fresh_service_failure_obligation
        and not args.skip_service_failure_omp_consumer
        and (payload.get("passive_event_consumer") or {}).get("ok") is True
    )
    if args.skip_service_failure_omp_consumer:
        payload["service_failure_omp_consumer"] = {
            "schema_version": "v7.service-failure-omp-consumer-liveness.v1",
            "status": "SKIPPED_EXPLICITLY", "ok": False, "reason": "explicit_skip",
        }
    elif defer_omp_receipt_until_after_fresh_execution:
        payload["service_failure_omp_consumer"] = {
            "schema_version": "v7.service-failure-omp-consumer-liveness.v1",
            "status": "DEFERRED_UNTIL_AFTER_FRESH_EXECUTION",
            "ok": True,
            "reason": "fresh_advisory_obligation_passed_directly_to_existing_executor",
        }
    elif direct_service_failure_obligation:
        payload["service_failure_omp_consumer"] = {
            "schema_version": "v7.service-failure-omp-consumer-liveness.v1",
            "status": "NOT_REQUIRED_DIRECT_L3_HANDOFF_READY",
            "ok": True,
            "reason": "existing_l3_projection_proves_current_exact_handoff",
        }
    elif (payload.get("passive_event_consumer") or {}).get("ok") is True:
        # OMP is Engineering-plane receipt/evidence machinery.  It must never
        # become a synchronous fallback between a failure and an executor
        # attempt.  Without a fresh obligation or an existing exact L3
        # handoff, fail closed below; a later Engineering consumer may record
        # evidence, but it cannot unblock this Runtime decision.
        payload["service_failure_omp_consumer"] = {
            "schema_version": "v7.service-failure-omp-consumer-liveness.v1",
            "status": "DEFERRED_OUTSIDE_RUNTIME_HOT_PATH",
            "ok": True,
            "reason": "no_fresh_or_direct_l3_handoff; runtime_fails_closed_without_omp_fallback",
        }
    else:
        payload["service_failure_omp_consumer"] = {
            "schema_version": "v7.service-failure-omp-consumer-liveness.v1",
            "status": "NOT_REQUIRED_NO_NEW_OBLIGATION", "ok": True,
        }
    # An OMP-consumed receipt is historical/engineering evidence, not a
    # Runtime handoff.  Keep its compatibility reader available to its
    # existing Engineering owner, but do not consult it here: a stale or
    # missing direct L3 handoff must fail closed rather than wait for OMP.
    payload["service_failure_execution_handoff"] = {
        "schema_version": "v7.service-failure-automation-execution-handoff.v1",
        "owner": "existing closure-records + l3-runtime-state owners",
        "final_verdict": (
            "FRESH_ADVISORY_OBLIGATION_PREFERRED"
            if fresh_service_failure_obligation
            else "DIRECT_L3_HANDOFF_PREFERRED"
            if direct_service_failure_obligation
            else "STOP_SAFE_DIRECT_L3_HANDOFF_REQUIRED"
        ),
        "reason": (
            "fresh_advisory_obligation_available"
            if fresh_service_failure_obligation
            else "existing_l3_projection_proves_current_exact_handoff"
            if direct_service_failure_obligation
            else str(
                (payload.get("service_failure_direct_execution_handoff") or {}).get("reason")
                or "no_current_direct_l3_handoff"
            )
        ),
        "runtime_mutation_performed": False,
    }
    if args.skip_bounded_delegated_service_failure_action:
        payload["bounded_delegated_service_failure_action"] = {
            "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
            "status": "SKIPPED_EXPLICITLY",
            "ok": False,
            "reason": "explicit_skip",
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }
    else:
        payload["bounded_delegated_service_failure_action"] = run_bounded_delegated_service_failure_action(
            str(args.governed_executor),
            state_dir=state_dir,
            event_dir=Path(args.event_dir),
            policy_file=Path(args.policy_file),
            operator_execution_audit_store=Path(
                args.operator_execution_audit_store
            ),
            service_failure_obligation=service_failure_obligation,
            timeout_sec=int(args.passive_consumer_timeout_sec) + 180,
        )
        bounded_action = payload["bounded_delegated_service_failure_action"]
        if args.runtime_hot_path_only:
            # Candidate/Packet/lease/barrier/apply stay entirely with the
            # existing governed executor above.  Everything below is
            # Engineering/controlled-tail work and must never extend the
            # synchronous Runtime invocation after that attempt.
            payload["runtime_hot_path_completion"] = {
                "status": "DIRECT_ACTION_ATTEMPT_COMPLETE",
                "runtime_mutation_performed": bool(
                    bounded_action.get("runtime_mutation_performed")
                ),
                "users_moved": int(bounded_action.get("users_moved") or 0),
                "engineering_tail": "DEFERRED_OUTSIDE_RUNTIME_HOT_PATH",
            }
            payload["next_output"] = "RUNTIME_HOT_PATH_ACTION_ATTEMPT_COMPLETE"
            compact_payload = compact_refresh_projection(payload)
            write_json_atomic(summary_file, compact_payload)
            append_event(Path(args.event_dir), payload)
            print(json.dumps(compact_payload, ensure_ascii=False, indent=2 if args.pretty else None))
            return 0
        if defer_passive_consumer_until_after_direct_execution:
            # This is the same existing consumer which previously ran before
            # the direct handoff. Its durable history/state reconciliation now
            # follows the bounded outcome instead of charging the measured
            # 8–14 seconds to a client already covered by an exact handoff.
            payload["passive_event_consumer"] = run_passive_consumer(
                str(args.passive_consumer),
                state_dir=state_dir,
                event_dir=Path(args.event_dir),
                timeout_sec=int(args.passive_consumer_timeout_sec),
            )
            payload["passive_event_consumer"][
                "deferred_until_after_direct_execution"
            ] = True
        if defer_omp_receipt_until_after_fresh_execution:
            # Preserve the existing receipt exactly once, but do it after the
            # fresh governed attempt.  It cannot change the already supplied
            # obligation, Packet/lease/barrier contract or executor result.
            payload["service_failure_omp_consumer"] = run_service_failure_omp_consumer(
                timeout_sec=int(args.passive_consumer_timeout_sec) + 30,
            )
            payload["service_failure_omp_consumer"][
                "receipt_deferred_until_after_fresh_execution"
            ] = True
        certification_tail_deferred = should_defer_certification_tail(
            event_only=event_only,
            current_scope=(
                payload.get("current_failed_source_scope")
                if isinstance(payload.get("current_failed_source_scope"), dict)
                else {}
            ),
            bounded_action=bounded_action,
        )
        # Controlled-topology preparation belongs to the separate CT-M0F
        # certification lane.  An event-only consumer must first exhaust the
        # current service-failure action path; otherwise every fast failure can
        # silently start a full controlled-certification diagnostic (and its
        # nested Matrix refresh) before the real incident is drained.
        payload["controlled_source_topology_provision"] = (
            {
                "schema_version": "v7.controlled-source-topology-matrix-consumer.v1",
                "status": "DEFERRED_TO_CT_M0F_CERTIFICATION_LANE",
                "ok": True,
                "runtime_mutation_performed": False,
                "users_moved": 0,
                "reason": (
                    "event_only_service_failure_consumer_preserves_hot_path"
                    if event_only else
                    "active_ordinary_scope_stop_safe_preserves_next_matrix_observation"
                ),
            }
            if event_only or certification_tail_deferred
            else consume_approved_controlled_source_topology(
                str(args.passive_consumer),
                state_dir=state_dir,
                policy_file=Path(args.policy_file),
                audit_store=Path(args.operator_execution_audit_store),
            )
        )
        availability_fallback_statuses = {
            "STOP_SAFE_CURRENT_INCIDENT_NOT_ACTIONABLE",
            "STOP_SAFE_CURRENT_SOURCE_SCOPE_EMPTY",
            "STOP_SAFE_NO_CURRENT_SERVICE_FAILURE_OBLIGATION",
        }
        if (
            not event_only
            and not certification_tail_deferred
            and
            bounded_action.get("status") in availability_fallback_statuses
            and not bounded_action.get("action_completed")
        ):
            payload[
                "availability_first_standing_policy_action"
            ] = run_availability_first_standing_policy_stage(
                str(args.passive_consumer),
                str(args.governed_executor),
                state_dir=state_dir,
                event_dir=Path(args.event_dir),
                policy_file=Path(args.policy_file),
                audit_store=Path(args.operator_execution_audit_store),
                timeout_sec=int(args.passive_consumer_timeout_sec) + 1800,
                max_successive_stages=len(
                    operator_execution.AVAILABILITY_FIRST_LADDER
                ),
            )
            availability_action = payload[
                "availability_first_standing_policy_action"
            ]
        availability_action = (
            payload.get("availability_first_standing_policy_action")
            if isinstance(
                payload.get("availability_first_standing_policy_action"),
                dict,
            )
            else {}
        )
        if (
            not event_only
            and not certification_tail_deferred
            and
            bounded_action.get("status") in availability_fallback_statuses
            and not bounded_action.get("action_completed")
            and not availability_action.get("action_completed")
        ):
            payload[
                "controlled_topology_standing_policy_action"
            ] = run_controlled_topology_standing_policy_action(
                str(args.passive_consumer),
                str(args.governed_executor),
                state_dir=state_dir,
                event_dir=Path(args.event_dir),
                policy_file=Path(args.policy_file),
                audit_store=Path(args.operator_execution_audit_store),
                timeout_sec=int(args.passive_consumer_timeout_sec) + 360,
                max_successive_rebindings=48,
            )
        topology_action = (
            payload.get("controlled_topology_standing_policy_action")
            if isinstance(
                payload.get("controlled_topology_standing_policy_action"),
                dict,
            )
            else {}
        )
        if (
            not event_only
            and not certification_tail_deferred
            and topology_action.get("action_completed")
        ):
            payload[
                "availability_first_pre_topology_action"
            ] = availability_action
            payload[
                "availability_first_standing_policy_action"
            ] = run_availability_first_standing_policy_stage(
                str(args.passive_consumer),
                str(args.governed_executor),
                state_dir=state_dir,
                event_dir=Path(args.event_dir),
                policy_file=Path(args.policy_file),
                audit_store=Path(args.operator_execution_audit_store),
                timeout_sec=int(args.passive_consumer_timeout_sec) + 1800,
                max_successive_stages=len(
                    operator_execution.AVAILABILITY_FIRST_LADDER
                ),
            )
            availability_action = payload[
                "availability_first_standing_policy_action"
            ]
        if not event_only and not certification_tail_deferred and not (
            bounded_action.get("action_completed")
            or availability_action.get("action_completed")
            or topology_action.get("action_completed")
        ):
            payload[
                "ct_m0f_standing_validation_campaign"
            ] = run_ct_m0f_standing_validation_campaign(
                str(args.governed_executor),
                str(args.passive_consumer),
                state_dir=state_dir,
                event_dir=Path(args.event_dir),
                policy_file=Path(args.policy_file),
                audit_store=Path(args.operator_execution_audit_store),
                timeout_sec=int(args.passive_consumer_timeout_sec) + 900,
            )
        ct_m0f_action = (
            payload.get("ct_m0f_standing_validation_campaign")
            if isinstance(
                payload.get("ct_m0f_standing_validation_campaign"), dict
            )
            else {}
        )
        any_action_completed = bool(
            bounded_action.get("action_completed")
            or availability_action.get("action_completed")
            or topology_action.get("action_completed")
            or ct_m0f_action.get("action_completed")
        )
        if any_action_completed:
            # The first passive/L3 pass precedes the bounded action.  Its
            # packet-bound Outcome is appended only after that pass, so run
            # the same existing consumer once more before asking OMP to
            # select the successor.  This is reconciliation only: it cannot
            # create a Candidate/Packet/lease or mutate routing.
            payload["service_failure_post_action_passive_consumer"] = (
                payload["passive_event_consumer"]
                if defer_passive_consumer_until_after_direct_execution
                else run_passive_consumer(
                    str(args.passive_consumer),
                    state_dir=state_dir,
                    event_dir=Path(args.event_dir),
                    timeout_sec=int(args.passive_consumer_timeout_sec),
                )
            )
            payload["service_failure_post_action_omp_consumer"] = run_service_failure_omp_consumer(
                timeout_sec=int(args.passive_consumer_timeout_sec) + 30,
            )
            campaign_binding = (
                bounded_action.get(
                    "controlled_certification_campaign"
                )
                if isinstance(
                    bounded_action.get(
                        "controlled_certification_campaign"
                    ),
                    dict,
                )
                else {}
            )
            if campaign_binding.get("active"):
                payload[
                    "controlled_certification_campaign_stage_reset"
                ] = run_controlled_certification_campaign_reset(
                    str(args.governed_executor),
                    state_dir=state_dir,
                    event_dir=Path(args.event_dir),
                    policy_file=Path(args.policy_file),
                    audit_store=Path(
                        args.operator_execution_audit_store
                    ),
                    binding=campaign_binding,
                    timeout_sec=int(
                        args.passive_consumer_timeout_sec
                    ) + 900,
                )
                post_passive_ok = bool(
                    payload[
                        "service_failure_post_action_passive_consumer"
                    ].get("ok")
                )
                post_omp_ok = bool(
                    payload[
                        "service_failure_post_action_omp_consumer"
                    ].get("ok")
                )
                reset_ok = bool(
                    payload[
                        "controlled_certification_campaign_stage_reset"
                    ].get("ok")
                )
                if post_passive_ok and post_omp_ok and reset_ok:
                    stage_consumption = (
                        record_controlled_campaign_stage_consumption(
                            audit_store=Path(
                                args.operator_execution_audit_store
                            ),
                            binding=campaign_binding,
                            result=bounded_action.get("consumer_result") or {},
                            reset_result=payload[
                                "controlled_certification_campaign_stage_reset"
                            ],
                        )
                    )
                else:
                    stage_consumption = {
                        "audit_write": False,
                        "blockers": [
                            name
                            for name, passed in (
                                (
                                    "post_action_passive_consumer_failed",
                                    post_passive_ok,
                                ),
                                (
                                    "post_action_omp_consumer_failed",
                                    post_omp_ok,
                                ),
                                (
                                    "campaign_stage_reset_failed",
                                    reset_ok,
                                ),
                            )
                            if not passed
                        ],
                    }
                bounded_action["controlled_certification_stage_consumption"] = (
                    stage_consumption
                )
    payload["omp_product_frontier_owner"] = "OMP_EXISTING_PRODUCT_ENGINEERING_FRONTIER"
    payload["next_output"] = (
        "OMP_PRODUCT_FRONTIER_MATERIALIZED"
        if payload["omp_product_frontiers"] else
        "NO_NEW_MATERIAL_INCIDENT_OR_ALREADY_CONSUMED"
    )
    compact_payload = compact_refresh_projection(payload)
    write_json_atomic(summary_file, compact_payload)
    append_event(Path(args.event_dir), payload)
    print(json.dumps(compact_payload, ensure_ascii=False, indent=2 if args.pretty else None))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
