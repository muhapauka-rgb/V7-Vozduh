def controlled_certification_matrix_binding(
    *,
    audit_store: Path,
    source: str,
    now: Optional[datetime] = None,
    target_selection_diagnostic: Optional[dict[str, Any]] = None,
) -> dict[str, Any]:
    """Project the next approved controlled stage from the existing audit owner."""
    records = operator_execution.read_live_execution_lineage_records(
        audit_store
    )
    status = operator_execution.controlled_certification_substrate_authority_status(
        records,
        now=now,
    )
    request = (
        status.get("request")
        if isinstance(status.get("request"), dict)
        else {}
    )
    scope = (
        request.get("scope")
        if isinstance(request.get("scope"), dict)
        else {}
    )
    request_id = str(status.get("request_id") or "")
    request_hash = str(status.get("request_hash") or "")
    validation = (
        operator_execution.validate_controlled_certification_substrate_authority_request(
            request,
            decision=operator_execution.CONTROLLED_CERTIFICATION_SUBSTRATE_APPROVAL,
            expected_request_id=request_id,
            expected_request_hash=request_hash,
            now=now,
        )
        if request
        else {"ok": False, "errors": ["controlled_campaign_request_missing"]}
    )
    admitted = set(str(item) for item in (status.get("admitted_subscopes") or []))
    blockers = list(validation.get("errors") or [])
    if status.get("status") != "APPROVED":
        blockers.append("controlled_campaign_not_approved")
    if str(status.get("decision") or "") != (
        operator_execution.CONTROLLED_CERTIFICATION_SUBSTRATE_APPROVAL
    ):
        blockers.append("controlled_campaign_decision_not_exact")
    if not {
        "CONTROLLED_SOURCE_CONDITION",
        "PROGRESSIVE_CAMPAIGN_EXECUTION",
    }.issubset(admitted):
        blockers.append("controlled_campaign_execution_subscopes_not_admitted")
    if str(scope.get("source_id") or "") != str(source or ""):
        blockers.append("controlled_campaign_source_mismatch")
    if int(scope.get("max_concurrent_transactions") or 0) != 1:
        blockers.append("controlled_campaign_concurrency_not_one")
    stages = [int(item) for item in (scope.get("campaign_stages") or [])]
    if stages != [5, 10, 25, 48]:
        blockers.append("controlled_campaign_stage_contract_changed")
    progress = operator_execution.controlled_certification_campaign_stage_status(
        records,
        request_id=request_id,
        request_hash=request_hash,
        now=now,
    )
    if not progress.get("ok"):
        blockers.extend(progress.get("blockers") or [])
    diagnostic = (
        target_selection_diagnostic
        if isinstance(target_selection_diagnostic, dict)
        else {}
    )
    diagnostic_status = str(diagnostic.get("status") or "")
    if diagnostic and (
        not diagnostic.get("ok")
        or diagnostic_status != "CURRENT_EXACT_TARGET_VALID"
    ):
        blockers.append(
            "controlled_campaign_target_full_live_admission_failed"
        )
    completed = list(progress.get("completed_stages") or [])
    next_stage = int(progress.get("next_stage") or 0)
    return {
        "schema_version": "v7.controlled-certification-matrix-binding.v1",
        "active": not blockers and next_stage > 0,
        "completed": not blockers and next_stage == 0 and bool(stages),
        "ok": not blockers,
        "blockers": sorted(set(blockers)),
        "request_id": request_id,
        "request_hash": request_hash,
        "decision_id": str(status.get("decision_id") or ""),
        "expires_at": str(status.get("expires_at") or ""),
        "source": str(scope.get("source_id") or ""),
        "target": str(scope.get("controlled_target_id") or ""),
        "stages": stages,
        "completed_stages": completed,
        "controlled_production_proven_max": int(
            progress.get("controlled_production_proven_max") or 0
        ),
        "stage_receipt_ids": list(progress.get("receipt_ids") or []),
        "next_stage": next_stage,
        "max_concurrent_transactions": int(
            scope.get("max_concurrent_transactions") or 0
        ),
        "ordinary_customer_involvement": bool(
            scope.get("ordinary_customer_involvement")
        ),
        "authority_expanded": False,
        "target_selection_status": diagnostic_status,
        "target_inventory_fingerprint": str(
            diagnostic.get("inventory_fingerprint") or ""
        ),
        "target_reselection_required": diagnostic_status in {
            "EXACT_TARGET_REBIND_AUTHORITY_REQUIRED",
            "BETTER_TARGET_SELECTED_INSIDE_APPROVED_ENVELOPE",
            "MULTI_TARGET_ALLOCATION_READY",
            "MULTI_TARGET_EXECUTION_AUTHORITY_REQUIRED",
        },
        "target_selection_next_consumer": (
            "existing Authority owner"
            if diagnostic_status in {
                "EXACT_TARGET_REBIND_AUTHORITY_REQUIRED",
                "MULTI_TARGET_EXECUTION_AUTHORITY_REQUIRED",
            }
            else "existing Matrix -> OMP -> CPS continuation chain"
            if diagnostic_status
            else ""
        ),
    }


def read_controlled_target_selection_diagnostic(
    *,
    state_dir: Path,
    policy_file: Path,
    audit_store: Path,
) -> dict[str, Any]:
    """Call the existing autoswitch owner in its read-only diagnostic mode."""
    command = [
        default_passive_consumer_path(),
        "--controlled-target-selection-diagnostic",
        "--state-dir",
        str(state_dir),
        "--policy-file",
        str(policy_file),
        "--action-class-audit-store",
        str(audit_store),
    ]
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=120,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.controlled-campaign-target-selection-diagnostic.v1",
            "status": "STOP_SAFE_TARGET_DIAGNOSTIC_CALLER_FAILED",
            "ok": False,
            "error": f"{type(exc).__name__}:{exc}",
        }
    try:
        payload = json.loads(proc.stdout or "{}")
    except json.JSONDecodeError:
        payload = {}
    if proc.returncode != 0 or not isinstance(payload, dict):
        return {
            "schema_version": "v7.controlled-campaign-target-selection-diagnostic.v1",
            "status": "STOP_SAFE_TARGET_DIAGNOSTIC_CALLER_FAILED",
            "ok": False,
            "returncode": proc.returncode,
            "output_tail": (proc.stdout or "")[-2000:],
        }
    return payload


def consume_approved_controlled_source_topology(
    planner: str,
    *,
    state_dir: Path,
    policy_file: Path,
    audit_store: Path,
) -> dict[str, Any]:
    """Deliver an independently approved topology provision to its owner.

    The Matrix is only the existing wake/consumer.  The planner performs all
    admission, exact-once and reservation checks, so this wrapper cannot turn
    an absent or mismatched approval into a registry mutation.
    """
    command = [
        planner,
        "--consume-approved-controlled-source-topology",
        "--state-dir", str(state_dir),
        "--policy-file", str(policy_file),
        "--action-class-audit-store", str(audit_store),
    ]
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=180,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.controlled-source-topology-matrix-consumer.v1",
            "status": "STOP_SAFE_CONSUMER_UNAVAILABLE",
            "ok": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "error": f"{type(exc).__name__}:{exc}",
        }
    try:
        result = json.loads(proc.stdout or "{}")
    except json.JSONDecodeError:
        result = {}
    if not isinstance(result, dict):
        result = {}
    return {
        "schema_version": "v7.controlled-source-topology-matrix-consumer.v1",
        "status": str(result.get("status") or "STOP_SAFE_INVALID_CONSUMER_RESULT"),
        "ok": bool(result.get("ok")),
        "returncode": proc.returncode,
        "runtime_mutation_performed": bool(
            result.get("runtime_mutation_performed")
        ),
        "registry_write": bool(result.get("registry_write")),
        "routing_mutation": bool(result.get("routing_mutation")),
        "users_moved": int(result.get("users_moved") or 0),
        "consumer_result": result,
        "output_tail": (proc.stdout or "")[-2000:]
        if not result.get("ok") else "",
    }


def record_controlled_campaign_stage_consumption(
    *,
    audit_store: Path,
    binding: dict[str, Any],
    result: dict[str, Any],
    reset_result: dict[str, Any],
) -> dict[str, Any]:
    """Append one exact stage receipt through the existing audit owner."""
    stage = int(binding.get("next_stage") or 0)
    feedback = (
        result.get("feedback_materialization")
        if isinstance(result.get("feedback_materialization"), dict)
        else {}
    )
    reset_payload = (
        reset_result.get("consumer_result")
        if isinstance(reset_result.get("consumer_result"), dict)
        else {}
    )
    semantic = {
        "request_id": str(binding.get("request_id") or ""),
        "request_hash": str(binding.get("request_hash") or ""),
        "stage": stage,
        "packet_id": str(
            result.get("fresh_packet_id")
            or result.get("packet_id")
            or ""
        ),
        "outcome_id": str(
            result.get("outcome_id")
            or feedback.get("outcome_id")
            or ((result.get("l3_learning_closure") or {}).get("outcome_id"))
            or ""
        ),
        "reset_receipt_id": str(
            reset_payload.get("receipt_id")
            or reset_payload.get("operation_id")
            or ""
        ),
    }
    learning = (
        result.get("l3_learning_closure")
        if isinstance(result.get("l3_learning_closure"), dict)
        else {}
    )
    closure = (
        learning.get("execution_closure_verification")
        if isinstance(
            learning.get("execution_closure_verification"),
            dict,
        )
        else {}
    )
    records = (
        learning.get("records")
        if isinstance(learning.get("records"), dict)
        else {}
    )
    outcome_consumed = bool(
        feedback.get("materialized")
        and feedback.get("outcome_id")
    )
    learning_consumed = bool(
        (
            learning.get("materialized")
            or learning.get("reason") == "already_materialized"
        )
        and (
            records.get("closure")
            or learning.get("reason") == "already_materialized"
        )
    )
    replay_consumed = bool(
        closure.get("terminal_consumer_verified")
        and closure.get("behavior_chain_status") == "COMPLETE"
    )
    cohort_verified = (
        int(result.get("users_moved") or 0) == stage
        and bool(result.get("apply_executed"))
        and str(result.get("final_verdict") or "")
        in {"GOVERNED_TRANSACTION_COMPLETED", "L3_PRODUCTION_PROVEN"}
    )
    baseline_reset_verified = (
        bool(reset_result.get("ok"))
        and int(reset_payload.get("target_user_count_after", -1)) == 0
        and int(reset_payload.get("ordinary_customer_count") or 0) == 0
        and int(reset_payload.get("users_moved") or 0) == stage
        and str(reset_payload.get("final_safe_mode") or "") == "OPEN"
    )
    if not (
        outcome_consumed
        and learning_consumed
        and replay_consumed
        and cohort_verified
        and baseline_reset_verified
    ):
        return {
            "receipt_id": "",
            "audit_write": False,
            "duplicate_suppressed": False,
            "blockers": [
                name
                for name, passed in (
                    ("controlled_campaign_outcome_not_consumed", outcome_consumed),
                    ("controlled_campaign_learning_not_consumed", learning_consumed),
                    ("controlled_campaign_replay_not_consumed", replay_consumed),
                    ("controlled_campaign_cohort_not_verified", cohort_verified),
                    (
                        "controlled_campaign_baseline_reset_not_verified",
                        baseline_reset_verified,
                    ),
                )
                if not passed
            ],
        }
    receipt_id = "cpsstage_" + operator_execution.sha256_json(semantic)[:24]
    with operator_execution.current_action_class_contract_policy_lock(
        audit_store
    ):
        records = operator_execution.read_live_execution_lineage_records(
            audit_store
        )
        prior = [
            row
            for row in records
            if row.get("record_type")
            == CONTROLLED_CAMPAIGN_EFFECT_RECORD_TYPE
            and row.get("effect_class")
            == CONTROLLED_CAMPAIGN_STAGE_EFFECT_CLASS
            and str(row.get("authority_request_id") or "")
            == str(binding.get("request_id") or "")
            and int(row.get("campaign_stage") or 0) == stage
        ]
        if prior:
            return {
                "receipt_id": str(prior[-1].get("receipt_id") or ""),
                "audit_write": False,
                "duplicate_suppressed": True,
            }
        row = operator_execution.append_record(audit_store, {
            "schema_version": "v7.controlled-certification-campaign-stage.v1",
            "record_type": CONTROLLED_CAMPAIGN_EFFECT_RECORD_TYPE,
            "effect_class": CONTROLLED_CAMPAIGN_STAGE_EFFECT_CLASS,
            "receipt_id": receipt_id,
            "authority_request_id": str(binding.get("request_id") or ""),
            "authority_request_hash": str(binding.get("request_hash") or ""),
            "authority_decision_id": str(binding.get("decision_id") or ""),
            "campaign_stage": stage,
            "source_id": str(binding.get("source") or ""),
            "target_id": str(binding.get("target") or ""),
            "packet_id": semantic["packet_id"],
            "outcome_id": semantic["outcome_id"],
            "outcome_consumed": outcome_consumed,
            "replay_consumed": replay_consumed,
            "learning_consumed": learning_consumed,
            "cohort_verified": cohort_verified,
            "baseline_reset_verified": baseline_reset_verified,
            "reset_receipt_id": semantic["reset_receipt_id"],
            "ordinary_customer_count": 0,
            "raw_identity_list_stored": False,
            "created_at": now_iso(),
        })
    return {
        "receipt_id": str(row.get("receipt_id") or receipt_id),
        "audit_write": True,
        "duplicate_suppressed": False,
    }


def record_availability_first_stage_consumption(
    *,
    audit_store: Path,
    result: dict[str, Any],
) -> dict[str, Any]:
    """Append one exact availability-first stage receipt to the same owner."""
    stage = int(result.get("stage") or 0)
    contract_id = str(
        result.get("standing_policy_contract_id") or ""
    )
    contract_hash = str(
        result.get("standing_policy_contract_hash") or ""
    )
    required = (
        "allocation_immutable",
        "capacity_reservation_verified",
        "outcome_consumed",
        "replay_consumed",
        "learning_consumed",
        "per_user_verification_passed",
        "per_target_verification_passed",
        "aggregate_verification_passed",
        "ordinary_user_protection_passed",
        "baseline_reset_verified",
    )
    blockers = [
        name
        for name in required
        if result.get(name) is not True
    ]
    if (
        result.get("final_verdict")
        != "AVAILABILITY_FIRST_STANDING_STAGE_COMPLETED"
    ):
        blockers.append("availability_first_stage_not_complete")
    if stage not in operator_execution.AVAILABILITY_FIRST_LADDER:
        blockers.append("availability_first_stage_not_in_ladder")
    if not contract_id or not contract_hash:
        blockers.append("availability_first_contract_identity_missing")
    if blockers:
        return {
            "receipt_id": "",
            "audit_write": False,
            "duplicate_suppressed": False,
            "blockers": sorted(set(blockers)),
        }
    semantic = {
        "contract_id": contract_id,
        "contract_hash": contract_hash,
        "stage": stage,
        "execution_allocation_fingerprint": str(
            result.get("execution_allocation_fingerprint") or ""
        ),
        "packet_set_fingerprint": str(
            result.get("packet_set_fingerprint") or ""
        ),
    }
    receipt_id = "afstage_" + operator_execution.sha256_json(
        semantic
    )[:24]
    with operator_execution.current_action_class_contract_policy_lock(
        audit_store
    ):
        rows = operator_execution.read_live_execution_lineage_records(
            audit_store
        )
        prior = [
            row
            for row in rows
            if row.get("record_type")
            == CONTROLLED_CAMPAIGN_EFFECT_RECORD_TYPE
            and row.get("effect_class")
            == AVAILABILITY_FIRST_CAMPAIGN_STAGE_EFFECT_CLASS
            and str(row.get("standing_policy_contract_id") or "")
            == contract_id
            and int(row.get("campaign_stage") or 0) == stage
        ]
        if prior:
            return {
                "receipt_id": str(prior[-1].get("receipt_id") or ""),
                "audit_write": False,
                "duplicate_suppressed": True,
            }
        row = operator_execution.append_record(audit_store, {
            "schema_version": "v7.availability-first-campaign-stage.v1",
            "record_type": CONTROLLED_CAMPAIGN_EFFECT_RECORD_TYPE,
            "effect_class": AVAILABILITY_FIRST_CAMPAIGN_STAGE_EFFECT_CLASS,
            "receipt_id": receipt_id,
            "standing_policy_contract_id": contract_id,
            "standing_policy_contract_hash": contract_hash,
            "campaign_stage": stage,
            "planner_allocation_fingerprint": str(
                result.get("planner_allocation_fingerprint") or ""
            ),
            "execution_allocation_fingerprint": str(
                result.get("execution_allocation_fingerprint") or ""
            ),
            "packet_set_fingerprint": str(
                result.get("packet_set_fingerprint") or ""
            ),
            "target_receipts": [
                {
                    "target_id": str(item.get("target_id") or ""),
                    "verified_scope": int(
                        item.get("allocated_users") or 0
                    ),
                    "target_fingerprint": str(
                        item.get("target_fingerprint") or ""
                    ),
                    "capacity_bounds_fingerprint": str(
                        item.get("capacity_bounds_fingerprint") or ""
                    ),
                }
                for item in (result.get("allocation") or [])
                if isinstance(item, dict)
            ],
            "allocation_immutable": True,
            "capacity_reservation_verified": True,
            "outcome_consumed": True,
            "replay_consumed": True,
            "learning_consumed": True,
            "per_user_verification_passed": True,
            "per_target_verification_passed": True,
            "aggregate_verification_passed": True,
            "ordinary_user_protection_passed": True,
            "baseline_reset_verified": True,
            "ordinary_customer_count": 0,
            "raw_identity_list_stored": False,
            "natural_l8_credit": False,
            "created_at": now_iso(),
        })
    return {
        "receipt_id": str(row.get("receipt_id") or receipt_id),
        "audit_write": True,
        "duplicate_suppressed": False,
    }


def current_performance_closure_receipt(
    audit_store: Path,
    *,
    revalidation_generation: str = "",
) -> dict[str, Any]:
    rows = operator_execution.read_live_execution_lineage_records(
        audit_store, include_runtime_actions=True
    )
    seen = {str(row.get("record_hash") or "") for row in rows}
    rows.extend(
        row for row in operator_execution.read_audit_records(audit_store)
        if str(row.get("record_hash") or "") not in seen
    )
    matches = [
        row for row in rows
        if row.get("record_type") == PERFORMANCE_CLOSURE_RECORD_TYPE
        and row.get("time_optimization_loop_consumed") is True
        and row.get("baseline_reset_verified") is True
        and row.get("ordinary_user_protection_passed") is True
        and (
            not revalidation_generation
            or str(row.get("performance_revalidation_generation") or "")
            == revalidation_generation
        )
    ]
    return matches[-1] if matches else {}


def record_performance_closure_consumption(
    *, audit_store: Path, result: dict[str, Any]
) -> dict[str, Any]:
    required = (
        "allocation_immutable",
        "capacity_reservation_verified",
        "outcome_consumed",
        "replay_consumed",
        "learning_consumed",
        "per_user_verification_passed",
        "per_target_verification_passed",
        "aggregate_verification_passed",
        "ordinary_user_protection_passed",
        "baseline_reset_verified",
    )
    blockers = [name for name in required if result.get(name) is not True]
    if result.get("final_verdict") != "GOVERNED_PERFORMANCE_CLOSURE_BENCHMARK_COMPLETED":
        blockers.append("performance_closure_benchmark_not_complete")
    if result.get("campaign_stage_credit") is not False:
        blockers.append("campaign_stage_credit_must_be_false")
    timings = [
        row.get("timing") for row in (result.get("cohort_execution_timings") or [])
        if isinstance(row, dict) and isinstance(row.get("timing"), dict)
    ]
    if not timings or any(row.get("status") != "MONOTONIC_BREAKDOWN_CONSUMED" for row in timings):
        blockers.append("nested_monotonic_timing_missing")
    reset_timings = [
        row
        for row in (result.get("reset_execution_timings") or [])
        if isinstance(row, dict) and isinstance(row.get("timing"), dict)
    ]
    if not reset_timings or any(
        (row.get("timing") or {}).get("status")
        != "MONOTONIC_BREAKDOWN_CONSUMED"
        for row in reset_timings
    ):
        blockers.append("reset_nested_monotonic_timing_missing")
    if blockers:
        return {"receipt_id": "", "audit_write": False, "duplicate_suppressed": False, "blockers": sorted(set(blockers))}
    semantic = {
        "performance_revalidation_generation": (
            PERFORMANCE_REVALIDATION_GENERATION
        ),
        "contract_id": str(result.get("standing_policy_contract_id") or ""),
        "execution_allocation_fingerprint": str(result.get("execution_allocation_fingerprint") or ""),
        "packet_set_fingerprint": str(result.get("packet_set_fingerprint") or ""),
        "timing_fingerprint": operator_execution.sha256_json(timings),
        "reset_timing_fingerprint": operator_execution.sha256_json(
            reset_timings
        ),
    }
    receipt_id = "perfclose_" + operator_execution.sha256_json(semantic)[:24]
    with operator_execution.current_action_class_contract_policy_lock(audit_store):
        prior = current_performance_closure_receipt(
            audit_store,
            revalidation_generation=PERFORMANCE_REVALIDATION_GENERATION,
        )
        if prior:
            return {"receipt_id": str(prior.get("receipt_id") or ""), "audit_write": False, "duplicate_suppressed": True}
        row = operator_execution.append_record(audit_store, {
            "schema_version": "v7.governed-performance-closure-consumption.v1",
            "record_type": PERFORMANCE_CLOSURE_RECORD_TYPE,
            "performance_revalidation_generation": (
                PERFORMANCE_REVALIDATION_GENERATION
            ),
            "receipt_id": receipt_id,
            "standing_policy_contract_id": semantic["contract_id"],
            "execution_allocation_fingerprint": semantic["execution_allocation_fingerprint"],
            "packet_set_fingerprint": semantic["packet_set_fingerprint"],
            "timing_fingerprint": semantic["timing_fingerprint"],
            "execution_timings": timings,
            "reset_execution_timings": reset_timings,
            "performance_timeline": list(result.get("performance_timeline") or []),
            "time_analysis_owner": "admin_core.operator_execution_pipeline.execution_performance_foundation",
            "time_analysis_schema": str((timings[0] or {}).get("analysis_schema_version") or ""),
            "time_optimization_loop_consumed": True,
            "one_governed_transaction_fastest_safe_path_proven": True,
            "stage_48_optimized_runtime_ready": True,
            "stage_48_executed": False,
            "campaign_stage_credit": False,
            "ordinary_user_protection_passed": True,
            "baseline_reset_verified": True,
            "natural_l8_credit": False,
            "created_at": now_iso(),
        })
    return {"receipt_id": str(row.get("receipt_id") or receipt_id), "audit_write": True, "duplicate_suppressed": False}


def record_availability_first_target_bound_consumption(
    *,
    audit_store: Path,
    result: dict[str, Any],
) -> dict[str, Any]:
    """Append one compact target-growth receipt through the existing owner."""
    verified_scope = int(result.get("stage") or 0)
    target_id = str(result.get("target_bound_trial_target") or "")
    contract_id = str(result.get("standing_policy_contract_id") or "")
    contract_hash = str(result.get("standing_policy_contract_hash") or "")
    allocation = [
        row for row in (result.get("allocation") or [])
        if isinstance(row, dict)
    ]
    required = (
        "allocation_immutable",
        "capacity_reservation_verified",
        "outcome_consumed",
        "replay_consumed",
        "learning_consumed",
        "per_user_verification_passed",
        "per_target_verification_passed",
        "aggregate_verification_passed",
        "ordinary_user_protection_passed",
        "baseline_reset_verified",
    )
    blockers = [
        name for name in required if result.get(name) is not True
    ]
    if (
        result.get("final_verdict")
        != "AVAILABILITY_FIRST_TARGET_BOUND_TRIAL_COMPLETED"
    ):
        blockers.append("availability_first_target_bound_not_complete")
    if verified_scope not in operator_execution.AVAILABILITY_FIRST_LADDER:
        blockers.append("availability_first_target_bound_not_in_ladder")
    if (
        len(allocation) != 1
        or str(allocation[0].get("target_id") or "") != target_id
        or int(allocation[0].get("allocated_users") or 0)
        != verified_scope
    ):
        blockers.append("availability_first_target_bound_allocation_invalid")
    if not target_id or not contract_id or not contract_hash:
        blockers.append("availability_first_target_bound_identity_missing")
    if blockers:
        return {
            "receipt_id": "",
            "audit_write": False,
            "duplicate_suppressed": False,
            "blockers": sorted(set(blockers)),
        }
    target = allocation[0]
    semantic = {
        "contract_id": contract_id,
        "contract_hash": contract_hash,
        "target_id": target_id,
        "verified_scope": verified_scope,
        "execution_allocation_fingerprint": str(
            result.get("execution_allocation_fingerprint") or ""
        ),
        "packet_set_fingerprint": str(
            result.get("packet_set_fingerprint") or ""
        ),
    }
    receipt_id = "aftbound_" + operator_execution.sha256_json(
        semantic
    )[:24]
    with operator_execution.current_action_class_contract_policy_lock(
        audit_store
    ):
        rows = operator_execution.read_live_execution_lineage_records(
            audit_store
        )
        prior = [
            row for row in rows
            if row.get("record_type")
            == CONTROLLED_CAMPAIGN_EFFECT_RECORD_TYPE
            and row.get("effect_class")
            == AVAILABILITY_FIRST_TARGET_BOUND_EFFECT_CLASS
            and str(row.get("standing_policy_contract_id") or "")
            == contract_id
            and str(row.get("target_id") or "") == target_id
            and int(row.get("verified_scope") or 0) == verified_scope
        ]
        if prior:
            return {
                "receipt_id": str(prior[-1].get("receipt_id") or ""),
                "audit_write": False,
                "duplicate_suppressed": True,
            }
        row = operator_execution.append_record(audit_store, {
            "schema_version": (
                "v7.availability-first-target-bound-receipt.v1"
            ),
            "record_type": CONTROLLED_CAMPAIGN_EFFECT_RECORD_TYPE,
            "effect_class": AVAILABILITY_FIRST_TARGET_BOUND_EFFECT_CLASS,
            "receipt_id": receipt_id,
            "standing_policy_contract_id": contract_id,
            "standing_policy_contract_hash": contract_hash,
            "campaign_next_stage": int(
                result.get("campaign_next_stage") or 0
            ),
            "target_id": target_id,
            "verified_scope": verified_scope,
            "planner_allocation_fingerprint": str(
                result.get("planner_allocation_fingerprint") or ""
            ),
            "execution_allocation_fingerprint": str(
                result.get("execution_allocation_fingerprint") or ""
            ),
            "packet_set_fingerprint": str(
                result.get("packet_set_fingerprint") or ""
            ),
            "target_fingerprint": str(
                target.get("target_fingerprint") or ""
            ),
            "capacity_bounds_fingerprint": str(
                target.get("capacity_bounds_fingerprint") or ""
            ),
            "allocation_immutable": True,
            "capacity_reservation_verified": True,
            "outcome_consumed": True,
            "replay_consumed": True,
            "learning_consumed": True,
            "per_user_verification_passed": True,
            "per_target_verification_passed": True,
            "aggregate_verification_passed": True,
            "ordinary_user_protection_passed": True,
            "baseline_reset_verified": True,
            "ordinary_customer_count": 0,
            "raw_identity_list_stored": False,
            "natural_l8_credit": False,
            "created_at": now_iso(),
        })
    return {
        "receipt_id": str(row.get("receipt_id") or receipt_id),
        "audit_write": True,
        "duplicate_suppressed": False,
    }


def run_bounded_delegated_service_failure_action(
    executor: str,
    *,
    state_dir: Path,
    event_dir: Path,
    policy_file: Path,
    operator_execution_audit_store: Path = DEFAULT_OPERATOR_EXECUTION_AUDIT_STORE,
    service_failure_obligation: Optional[dict[str, Any]] = None,
    timeout_sec: int = 180,
) -> dict[str, Any]:
    """Close the existing event -> planner -> bounded executor consumer link.

    Absence of an active owner-issued standing contract is a normal fail-closed
    terminal.  The executor remains the sole owner of Candidate/Packet/lease,
    restore-barrier, apply, verification and final OPEN transitions.
    """
    policy_root = read_json(policy_file, {})
    contract = (
        policy_root.get("delegated_autonomy_policy")
        if isinstance(policy_root.get("delegated_autonomy_policy"), dict)
        else {}
    )
    if contract.get("status") != "ACTIVE":
        return {
            "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
            "status": "INACTIVE_NO_STANDING_POLICY",
            "ok": True,
            "action_attempted": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }
    policy = contract.get("policy") if isinstance(contract.get("policy"), dict) else {}
    per_action_law = (
        contract.get("per_action_law")
        if isinstance(contract.get("per_action_law"), dict)
        else {}
    )
    blast_radius = (
        policy.get("max_blast_radius")
        if isinstance(policy.get("max_blast_radius"), dict)
        else {}
    )
    try:
        policy_max_users = int(policy.get("max_users_per_action") or 0)
        law_max_users = int(per_action_law.get("max_users") or 0)
        blast_max_users = int(blast_radius.get("users") or 0)
        policy_concurrency = int(policy.get("max_concurrent_transactions") or 0)
        law_concurrency = int(per_action_law.get("max_concurrent_transactions") or 0)
        expires_at = datetime.fromisoformat(str(contract.get("expires_at") or "").replace("Z", "+00:00"))
        if expires_at.tzinfo is None:
            expires_at = expires_at.replace(tzinfo=timezone.utc)
    except (TypeError, ValueError):
        policy_max_users = law_max_users = blast_max_users = 0
        policy_concurrency = law_concurrency = 0
        expires_at = datetime.min.replace(tzinfo=timezone.utc)
    allowed_action_classes = [
        str(item)
        for item in (policy.get("allowed_action_classes") or [])
        if str(item)
    ]
    exact_limit_valid = (
        bool(str(contract.get("contract_id") or ""))
        and bool(str(contract.get("contract_hash") or ""))
        and expires_at > datetime.now(timezone.utc)
        and str(policy.get("policy_state") or "") == "APPROVED"
        and bool_value(policy.get("runtime_apply_enabled"))
        and not bool_value(policy.get("self_expansion_allowed"))
        and bool(allowed_action_classes)
        and policy_max_users > 0
        and policy_max_users == law_max_users == blast_max_users
        and policy_concurrency == law_concurrency == 1
    )
    if not exact_limit_valid:
        return {
            "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
            "status": "STOP_SAFE_INVALID_STANDING_POLICY_SCOPE",
            "ok": True,
            "action_attempted": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "blockers": ["standing_policy_transaction_limit_not_exactly_owner_backed"],
            "contract_id": str(contract.get("contract_id") or ""),
        }
    obligation = (
        service_failure_obligation
        if isinstance(service_failure_obligation, dict)
        else {}
    )
    source_scope = (
        obligation.get("current_source_scope")
        if isinstance(obligation.get("current_source_scope"), dict)
        else {}
    )
    source = str(obligation.get("channel") or "")
    incident_id = str(obligation.get("source_incident_id") or "")
    obligation_id = str(obligation.get("automation_obligation_id") or "")
    scope_fingerprint = str(source_scope.get("affected_scope_fingerprint") or "")
    affected_scope = int(source_scope.get("affected_scope_count") or 0)
    unresolved_scope = int(source_scope.get("unresolved_scope_count") or 0)
    recommendation_users = int(obligation.get("bounded_recommendation_users") or 0)
    classification = str(obligation.get("stop_safe_classification") or "")
    obligation_identity_valid = (
        str(obligation.get("object_type") or "") == "service_failure_automation_obligation"
        and str(obligation.get("closure_state") or "") == "READY_FOR_OMP_CONSUMPTION"
        and bool(source and incident_id and obligation_id and scope_fingerprint)
    )
    if not obligation_identity_valid:
        return {
            "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
            "status": "STOP_SAFE_NO_CURRENT_SERVICE_FAILURE_OBLIGATION",
            "ok": True,
            "action_attempted": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "blockers": ["exact_current_service_failure_obligation_missing_or_invalid"],
            "contract_id": str(contract.get("contract_id") or ""),
        }
    if affected_scope <= 0 or unresolved_scope <= 0:
        return {
            "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
            "status": "STOP_SAFE_CURRENT_SOURCE_SCOPE_EMPTY",
            "ok": True,
            "action_attempted": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "source": source,
            "source_incident_id": incident_id,
            "automation_obligation_id": obligation_id,
            "affected_scope": affected_scope,
            "unresolved_scope": unresolved_scope,
            "contract_id": str(contract.get("contract_id") or ""),
            "contract_hash": str(contract.get("contract_hash") or ""),
            "admitted_max_users": policy_max_users,
            "max_concurrent_transactions": policy_concurrency,
        }
    target_selection_diagnostic = read_controlled_target_selection_diagnostic(
        state_dir=state_dir,
        policy_file=policy_file,
        audit_store=operator_execution_audit_store,
    )
    campaign_binding = controlled_certification_matrix_binding(
        audit_store=operator_execution_audit_store,
        source=source,
        target_selection_diagnostic=target_selection_diagnostic,
    )
    ordinary_incident_actionable = (
        classification == "STOP_SAFE_FRESH_EVENT_REVALIDATION_REQUIRED"
        and recommendation_users > 0
    )
    controlled_campaign_actionable = bool(
        campaign_binding.get("active")
        and classification == "STOP_SAFE_FRESH_EVENT_REVALIDATION_REQUIRED"
        and unresolved_scope
        >= int(campaign_binding.get("next_stage") or 0)
    )
    if not (ordinary_incident_actionable or controlled_campaign_actionable):
        return {
            "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
            "status": "STOP_SAFE_CURRENT_INCIDENT_NOT_ACTIONABLE",
            "ok": True,
            "action_attempted": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "source": source,
            "source_incident_id": incident_id,
            "automation_obligation_id": obligation_id,
            "classification": classification,
            "bounded_recommendation_users": recommendation_users,
            "blockers": [
                "current_incident_has_no_owner_backed_actionable_recommendation"
            ],
            "contract_id": str(contract.get("contract_id") or ""),
            "controlled_certification_campaign": campaign_binding,
        }
    if campaign_binding.get("completed"):
        return {
            "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
            "status": "CONTROLLED_CERTIFICATION_CAMPAIGN_COMPLETE",
            "ok": True,
            "action_attempted": False,
            "action_completed": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "source": source,
            "source_incident_id": incident_id,
            "automation_obligation_id": obligation_id,
            "controlled_certification_campaign": campaign_binding,
            "durable_successor": (
                "V7_SERVICE_FAILURE_T48_M10_AUTHORITY_AND_RUNTIME_"
                "RECOMMENDATION_RECONCILIATION"
            ),
        }
    requested_max_users = (
        int(campaign_binding.get("next_stage") or 0)
        if campaign_binding.get("active")
        else policy_max_users
    )
    ordinary_execution = (
        ordinary_incident_actionable and not campaign_binding.get("active")
    )
    if ordinary_execution:
        axes = operator_execution.standing_delegated_policy_runtime_axes(contract)
        requested_max_users = min(
            requested_max_users,
            int(axes.get("ordinary_production_runtime_max") or 0),
            4,
        )
    command = [
        executor,
        "--execute-bounded-delegated-transaction",
        "--state-dir", str(state_dir),
        "--event-dir", str(event_dir),
        "--policy-file", str(policy_file),
        "--max-users", str(requested_max_users),
        "--expected-standing-policy-contract-id", str(contract.get("contract_id") or ""),
        "--expected-standing-policy-contract-hash", str(contract.get("contract_hash") or ""),
        "--expected-service-failure-obligation-id", obligation_id,
        "--expected-service-failure-incident-id", incident_id,
        "--expected-service-failure-scope-fingerprint", scope_fingerprint,
        "--approved-source", source,
        "--compact-transaction-receipt",
        "--pretty",
    ]
    if ordinary_execution:
        command.append("--ordinary-service-failure-only")
    if campaign_binding.get("active"):
        command.extend([
            "--controlled-certification-campaign-request-id",
            str(campaign_binding.get("request_id") or ""),
            "--controlled-certification-campaign-request-hash",
            str(campaign_binding.get("request_hash") or ""),
            "--controlled-certification-campaign-stage",
            str(campaign_binding.get("next_stage") or 0),
        ])
    started_at = now_iso()
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(30, min(int(timeout_sec or 180), 600)),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
            "status": "FAILED",
            "ok": False,
            "started_at": started_at,
            "completed_at": now_iso(),
            "command": command,
            "error": f"{type(exc).__name__}:{exc}",
            "action_attempted": True,
        }
    try:
        parsed = json.loads(proc.stdout or "")
    except json.JSONDecodeError:
        parsed = {}
    verdict = str(parsed.get("final_verdict") or "")
    transaction_status = str(parsed.get("transaction_status") or "")
    completed = proc.returncode == 0 and verdict in {
        "GOVERNED_TRANSACTION_COMPLETED",
        "L3_PRODUCTION_PROVEN",
    }
    stop_safe = (
        (
            verdict == "STOP_SAFE"
            or (
                verdict == "GOVERNED_TRANSACTION_STOPPED"
                and transaction_status == "STOP_SAFE"
            )
        )
        and not bool(parsed.get("apply_executed"))
        and int(parsed.get("users_moved") or 0) == 0
    )
    return {
        "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
        "status": "ACTION_COMPLETED" if completed else ("STOP_SAFE" if stop_safe else "FAILED"),
        "ok": completed or stop_safe,
        "started_at": started_at,
        "completed_at": now_iso(),
        "command": command,
        "returncode": proc.returncode,
        "consumer_result": parsed,
        "action_attempted": True,
        "action_completed": completed,
        "runtime_mutation_performed": bool(parsed.get("runtime_mutation_performed") or parsed.get("apply_executed")),
        "users_moved": int(parsed.get("users_moved") or 0),
        "contract_id": str(contract.get("contract_id") or ""),
        "contract_hash": str(contract.get("contract_hash") or ""),
        "admitted_max_users": policy_max_users,
        "requested_max_users": requested_max_users,
        "max_concurrent_transactions": policy_concurrency,
        "source": source,
        "source_incident_id": incident_id,
        "automation_obligation_id": obligation_id,
        "controlled_certification_campaign": campaign_binding,
        "controlled_certification_stage_consumption": {},
        "output_tail": (proc.stdout or "")[-2000:] if not (completed or stop_safe) else "",
    }


def run_ct_m0f_standing_validation_campaign(
    executor: str,
    planner: str,
    *,
    state_dir: Path,
    event_dir: Path,
    policy_file: Path,
    audit_store: Path,
    timeout_sec: int = 600,
    max_successive_samples: int = 8,
) -> dict[str, Any]:
    """Consume the bounded CT-M0F standing policy through existing owners.

    Matrix remains only the wake/consumer.  Candidate, Packet, lease, cutover,
    reset and evidence are produced by their existing governed owners.
    """
    policy_root = read_json(policy_file, {})
    contract = (
        policy_root.get(
            operator_execution.CT_M0F_STANDING_VALIDATION_POLICY_KEY, {}
        )
        if isinstance(policy_root, dict)
        else {}
    )
    records = operator_execution.read_live_execution_lineage_records(audit_store)
    validation = operator_execution.validate_ct_m0f_standing_validation_policy(
        contract, audit_records=records,
    )
    if not validation.get("ok"):
        return {
            "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
            "status": "INACTIVE_NO_VALID_STANDING_CT_M0F_POLICY",
            "ok": True,
            "blockers": validation.get("errors") or [],
            "action_attempted": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }

    contract_id = str(contract.get("contract_id") or "")
    contract_hash = str(contract.get("contract_hash") or "")
    steps: list[dict[str, Any]] = []

    def compact_budget(value: Any) -> dict[str, Any]:
        """Keep the admission budget observable without copying audit history."""
        budget = value if isinstance(value, dict) else {}
        return {
            key: budget.get(key)
            for key in (
                "valid_samples", "invalid_or_safety_stopped_attempts",
                "cold_valid_samples", "warm_valid_samples",
                "owner_backed_generation_count", "active_reservations",
                "next_sample_kind", "campaign_complete",
                "attempt_budget_exhausted", "valid_sample_budget_exhausted",
            )
            if key in budget
        }

    def preparation_receipt(
        phase: str,
        *,
        source_selection: Any = None,
        execution: Any = None,
        budget: Any = None,
        reservation_id: str = "",
        prior_reservation_id: str = "",
        terminal: str = "",
        blockers: Any = None,
        next_consumer: str = "",
    ) -> dict[str, Any]:
        """Project the existing CT-M0F owners' exact admission predicates.

        This is deliberately a compact Matrix lifecycle projection, not a
        second audit/outcome store.  In particular, it makes a cleanup of an
        older reservation distinguishable from preparation of a new sample.
        """
        selection = source_selection if isinstance(source_selection, dict) else {}
        child = execution if isinstance(execution, dict) else {}
        admission = child.get("ct_m0f_admission_consumption")
        admission = admission if isinstance(admission, dict) else {}
        reservation = admission.get("reservation")
        reservation = reservation if isinstance(reservation, dict) else {}
        live_reservation_id = str(reservation.get("reservation_id") or reservation_id or "")
        child_budget = admission.get("budget")
        effective_budget = child_budget if isinstance(child_budget, dict) else budget
        selection_ok = bool(selection.get("ok") is True)
        execute_started = bool(child) or phase == "FRESH_SAMPLE_EXECUTION"
        packet_id = str(reservation.get("packet_id") or "")
        lease_id = str(reservation.get("lease_id") or "")
        operation_id = str(reservation.get("operation_id") or "")
        evidence = child.get("ct_m0f_cutover_evidence")
        evidence = evidence if isinstance(evidence, dict) else {}
        return {
            "schema_version": "v7.ct-m0f-sample-preparation-receipt.v1",
            "phase": phase,
            "contract_id": contract_id,
            "source_selection": {
                "state": "PASS" if selection_ok else "NOT_EVALUATED" if not selection else "STOP_SAFE",
                "selection_mode": str(selection.get("selection_mode") or ""),
                "source": str(selection.get("selected_source_id") or ""),
                "user": str(selection.get("selected_user") or ""),
                "target": str(selection.get("selected_target_id") or ""),
                "binding_fingerprint": str(selection.get("sample_binding_fingerprint") or ""),
            },
            "predicates": {
                "previous_sample_closure": {
                    "state": "PASS" if prior_reservation_id else "NOT_REQUIRED",
                    "reservation_id": prior_reservation_id,
                },
                "sample_budget_and_kind": {
                    "state": "PASS" if effective_budget else "NOT_EMITTED_BY_EXECUTOR",
                    "budget": compact_budget(effective_budget),
                },
                "fresh_candidate_admission": {
                    "state": "PASS" if live_reservation_id else "NOT_YET_ADMITTED" if execute_started else "NOT_EVALUATED",
                    "owner": "tools/v7-users-autoswitch Planner",
                },
                "fresh_packet": {
                    "state": "PASS" if packet_id else "NOT_YET_MATERIALIZED" if execute_started else "NOT_EVALUATED",
                    "packet_id": packet_id,
                    "operation_id": operation_id,
                },
                "fresh_lease": {
                    "state": "PASS" if lease_id else "NOT_YET_MATERIALIZED" if execute_started else "NOT_EVALUATED",
                    "lease_id": lease_id,
                },
                "restore_barrier": {
                    "state": "PASS" if child.get("restore_barrier_written_now") is True else "NOT_WRITTEN" if execute_started else "NOT_EVALUATED",
                    "owner": "existing packet-bound restore-barrier owner",
                },
                "route_and_exact_client_payload": {
                    "state": (
                        "PASS" if evidence.get("status") == "CONTROL_PLANE_AND_KERNEL_PATH_CUTOVER_PASS"
                        else "NOT_YET_PROVEN" if execute_started else "NOT_EVALUATED"
                    ),
                    "time_receipt_status": str(evidence.get("status") or ""),
                },
            },
            "reservation_id": live_reservation_id,
            "terminal": terminal,
            "blockers": sorted({str(value) for value in (blockers or []) if str(value)}),
            "next_required_consumer": next_consumer,
        }

    def active_reservations() -> list[dict[str, Any]]:
        current = operator_execution.read_live_execution_lineage_records(
            audit_store
        )
        terminal_ids = {
            str(row.get("reservation_id") or "")
            for row in current
            if row.get("record_type")
            == operator_execution.CT_M0F_STANDING_VALIDATION_SAMPLE_TERMINAL_RECORD_TYPE
        }
        return [
            row for row in current
            if row.get("record_type")
            == operator_execution.CT_M0F_STANDING_VALIDATION_SAMPLE_RESERVATION_RECORD_TYPE
            and str(row.get("contract_id") or "") == contract_id
            and str(row.get("reservation_id") or "") not in terminal_ids
        ]

    def invoke(command: list[str], timeout: int) -> tuple[int, dict[str, Any], str]:
        try:
            proc = subprocess.run(
                command,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=timeout,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            return 2, {}, f"{type(exc).__name__}:{exc}"
        try:
            parsed = json.loads(proc.stdout or "{}")
        except json.JSONDecodeError:
            parsed = {}
        return proc.returncode, parsed if isinstance(parsed, dict) else {}, (proc.stdout or "")[-2000:]

    def close_active_sample(
        active: list[dict[str, Any]],
    ) -> Optional[dict[str, Any]]:
        if len(active) > 1:
            return {
                "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
                "status": "STOP_SAFE_DUPLICATE_ACTIVE_SAMPLE_RESERVATIONS",
                "ok": False,
                "steps": steps,
                "sample_preparation_receipt": preparation_receipt(
                    "ACTIVE_RESERVATION_RECONCILIATION",
                    blockers=["ct_m0f_duplicate_active_sample_reservations"],
                    next_consumer="existing sample reset/closure owner",
                ),
                "active_reservation_ids": [
                    str(row.get("reservation_id") or "") for row in active
                ],
                "runtime_mutation_performed": any(
                    bool(row.get("runtime_mutation_performed")) for row in steps
                ),
                "users_moved": 0,
            }
        if not active:
            return None
        reservation_id = str(active[0].get("reservation_id") or "")
        reset_command = [
            executor,
            "--reset-ct-m0f-standing-validation-sample",
            "--ct-m0f-standing-validation-reservation-id", reservation_id,
            "--state-dir", str(state_dir),
            "--event-dir", str(event_dir),
            "--policy-file", str(policy_file),
            "--audit-dir", str(audit_store.parent),
            "--operator-execution-audit-store", str(audit_store),
            "--pretty",
        ]
        rc, reset, output = invoke(
            reset_command, max(60, min(timeout_sec, 900))
        )
        steps.append({
            "kind": "RESET_AND_SAMPLE_CLOSURE",
            "reservation_id": reservation_id,
            "returncode": rc,
            "result": reset,
            "output_tail": "" if reset else output,
            "runtime_mutation_performed": bool(
                reset.get("runtime_mutation_performed")
            ),
        })
        if rc != 0 or str(reset.get("final_verdict") or "") not in {
            "CT_M0F_STANDING_SAMPLE_ALREADY_CLOSED",
            "CT_M0F_STANDING_SAMPLE_RESET_AND_CLOSED",
            "CT_M0F_STANDING_SAMPLE_SAFELY_RECONCILED_INVALID",
        }:
            return {
                "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
                "status": "STOP_SAFE_SAMPLE_RESET_OR_CLOSURE_FAILED",
                "ok": False,
                "steps": steps,
                "sample_preparation_receipt": preparation_receipt(
                    "ACTIVE_SAMPLE_CLOSURE",
                    budget=reset.get("budget"),
                    prior_reservation_id=reservation_id,
                    terminal=str(reset.get("final_verdict") or ""),
                    blockers=["ct_m0f_sample_reset_or_closure_failed"],
                    next_consumer="existing sample reset/closure owner",
                ),
                "runtime_mutation_performed": any(
                    bool(row.get("runtime_mutation_performed")) for row in steps
                ),
                "users_moved": 0,
            }
        budget = reset.get("budget") if isinstance(reset.get("budget"), dict) else {}
        if budget.get("campaign_complete"):
            return {
                "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
                "status": "CT_M0F_OPERATIONAL_SLO_CONSUMED",
                "ok": True,
                "steps": steps,
                "budget": budget,
                "sample_preparation_receipt": preparation_receipt(
                    "ACTIVE_SAMPLE_CLOSURE",
                    budget=budget,
                    prior_reservation_id=reservation_id,
                    terminal="CT_M0F_OPERATIONAL_SLO_CONSUMED",
                ),
                "action_completed": True,
                "runtime_mutation_performed": any(
                    bool(row.get("runtime_mutation_performed")) for row in steps
                ),
                "users_moved": 0,
            }
        if (
            budget.get("attempt_budget_exhausted")
            or budget.get("valid_sample_budget_exhausted")
        ):
            return {
                "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
                "status": "CT_M0F_VALIDATION_ATTEMPT_BUDGET_EXHAUSTED_ENGINEERING_RESIDUAL_REQUIRED",
                "ok": True,
                "steps": steps,
                "budget": budget,
                "sample_preparation_receipt": preparation_receipt(
                    "ACTIVE_SAMPLE_CLOSURE",
                    budget=budget,
                    prior_reservation_id=reservation_id,
                    terminal="CT_M0F_VALIDATION_ATTEMPT_BUDGET_EXHAUSTED_ENGINEERING_RESIDUAL_REQUIRED",
                    blockers=["ct_m0f_validation_attempt_or_valid_sample_budget_exhausted"],
                    next_consumer="OMP existing engineering frontier owner",
                ),
                "action_completed": True,
                "runtime_mutation_performed": any(
                    bool(row.get("runtime_mutation_performed")) for row in steps
                ),
                "users_moved": 0,
            }
        return {
            "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
            "status": "CT_M0F_SAMPLE_CLOSED_NEXT_ORDINARY_MATRIX_GENERATION_REQUIRED",
            "ok": True,
            "steps": steps,
            "budget": budget,
            "sample_preparation_receipt": preparation_receipt(
                "ACTIVE_SAMPLE_CLOSURE",
                budget=budget,
                prior_reservation_id=reservation_id,
                terminal="CT_M0F_SAMPLE_CLOSED_NEXT_ORDINARY_MATRIX_GENERATION_REQUIRED",
                next_consumer="next ordinary Matrix generation",
            ),
            "action_completed": True,
            "runtime_mutation_performed": any(
                bool(row.get("runtime_mutation_performed")) for row in steps
            ),
            "users_moved": 0,
            "durable_successor": "NEXT_ORDINARY_MATRIX_GENERATION_PREPARES_FRESH_SAMPLE",
        }

    active_result = close_active_sample(active_reservations())
    if active_result is not None:
        return active_result

    # The source selector and target diagnostic are existing owners but each
    # legitimately reads a broad inventory.  The selector's bounded-memory
    # contract accepts the diagnostic only as a one-shot compact file.  Keep
    # that hand-off private to this invocation: it is neither a cache nor a
    # second state source, and it makes the automatic Matrix consumer use the
    # same target decision as the manual read-only predecessor did.
    target_diagnostic = read_controlled_target_selection_diagnostic(
        state_dir=state_dir,
        policy_file=policy_file,
        audit_store=audit_store,
    )
    diagnostic_path = ""
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            prefix="v7-ct-m0f-target-",
            suffix=".json",
            delete=False,
        ) as diagnostic_file:
            json.dump(target_diagnostic, diagnostic_file, ensure_ascii=False)
            diagnostic_file.write("\n")
            diagnostic_path = diagnostic_file.name
        source_command = [
            planner,
            "--ct-m0f-standing-source-selection",
            "--state-dir", str(state_dir),
            "--policy-file", str(policy_file),
            "--action-class-audit-store", str(audit_store),
            "--ct-m0f-precomputed-target-diagnostic-file", diagnostic_path,
        ]
        source_rc, source_selection, source_output = invoke(source_command, 180)
    finally:
        if diagnostic_path:
            with contextlib.suppress(OSError):
                os.unlink(diagnostic_path)
    selected_source = str(source_selection.get("selected_source_id") or "")
    selected_user = str(source_selection.get("selected_user") or "")
    selected_target = str(source_selection.get("selected_target_id") or "")
    selection_mode = str(source_selection.get("selection_mode") or "")
    active_service_failure_binding = (
        source_selection.get("active_service_failure_binding")
        if isinstance(source_selection.get("active_service_failure_binding"), dict)
        else {}
    )
    sample_binding_fingerprint = str(
        source_selection.get("sample_binding_fingerprint") or ""
    )
    if (
        source_rc not in {0, 2}
        or source_selection.get("ok") is not True
        or not selected_source
        or not selected_user
        or not selected_target
        or len(sample_binding_fingerprint) != 64
    ):
        return {
            "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
            "status": "STOP_SAFE_CONTROLLED_SOURCE_PREDECESSOR_REQUIRED",
            "ok": bool(
                source_rc in {0, 2}
                and not source_selection.get("runtime_mutation_performed")
            ),
            "source_selection": source_selection,
            "output_tail": "" if source_selection else source_output,
            "blockers": list(source_selection.get("blockers") or [
                "ct_m0f_standing_controlled_source_selection_unavailable"
            ]),
            "sample_preparation_receipt": preparation_receipt(
                "SOURCE_SELECTION",
                source_selection=source_selection,
                blockers=list(source_selection.get("blockers") or [
                    "ct_m0f_standing_controlled_source_selection_unavailable"
                ]),
                next_consumer="existing source/target selection owner",
            ),
            "action_attempted": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }

    if selection_mode == "PREPARE_CONTROLLED_FAILURE_CONDITION":
        prepare_command = [
            executor,
            "--prepare-ct-m0f-standing-controlled-condition",
            "--ct-m0f-standing-validation-contract-id", contract_id,
            "--ct-m0f-standing-validation-contract-hash", contract_hash,
            "--state-dir", str(state_dir),
            "--event-dir", str(event_dir),
            "--policy-file", str(policy_file),
            "--audit-dir", str(audit_store.parent),
            "--operator-execution-audit-store", str(audit_store),
            "--approved-source", selected_source,
            "--ct-m0f-standing-validation-user", selected_user,
            "--ct-m0f-standing-validation-target", selected_target,
            "--ct-m0f-standing-sample-binding-fingerprint",
            sample_binding_fingerprint,
            "--max-users", "1",
            "--pretty",
        ]
        rc, prepared, output = invoke(
            prepare_command, max(120, min(timeout_sec, 900))
        )
        passed = bool(
            rc == 0
            and prepared.get("final_verdict")
            == "CT_M0F_STANDING_CONTROLLED_CONDITION_PREPARED"
        )
        return {
            "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
            "status": (
                "CT_M0F_CONTROLLED_CONDITION_PREPARED_WAITING_FRESH_MATRIX_GENERATION"
                if passed
                else "STOP_SAFE_CONTROLLED_CONDITION_PREPARATION_FAILED"
            ),
            "ok": passed,
            "source_selection": source_selection,
            "preparation": prepared,
            "sample_preparation_receipt": preparation_receipt(
                "CONTROLLED_CONDITION_PREPARATION",
                source_selection=source_selection,
                execution=prepared,
                terminal=str(prepared.get("final_verdict") or ""),
                blockers=[] if passed else [str(prepared.get("final_verdict") or "controlled_condition_preparation_failed")],
                next_consumer=(
                    "next ordinary Matrix generation"
                    if passed else "existing controlled-condition owner"
                ),
            ),
            "output_tail": "" if prepared else output,
            "action_attempted": True,
            "runtime_mutation_performed": bool(
                prepared.get("runtime_mutation_performed")
            ),
            "users_moved": int(prepared.get("users_moved") or 0),
            "durable_successor": (
                "NEXT_ORDINARY_MATRIX_GENERATION_DETECTS_CONTROLLED_FAILURE"
                if passed
                else "EXACT_EXISTING_OWNER_RECONCILIATION_REQUIRED"
            ),
        }

    if selection_mode != "EXECUTE_CONTROLLED_FAILURE_CUTOVER":
        return {
            "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
            "status": "STOP_SAFE_CONTROLLED_FAILURE_NOT_READY",
            "ok": True,
            "source_selection": source_selection,
            "sample_preparation_receipt": preparation_receipt(
                "CONTROLLED_FAILURE_SELECTION",
                source_selection=source_selection,
                blockers=["ct_m0f_standing_controlled_failure_not_ready"],
                next_consumer="existing source/target selection owner",
            ),
            "action_attempted": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }

    if active_service_failure_binding.get("requires_binding") and not active_service_failure_binding.get("ok"):
        return {
            "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
            "status": "STOP_SAFE_ACTIVE_SERVICE_FAILURE_BINDING_REQUIRED",
            "ok": True,
            "source_selection": source_selection,
            "blockers": list(active_service_failure_binding.get("blockers") or [
                "ct_m0f_active_service_failure_causal_binding_required"
            ]),
            "sample_preparation_receipt": preparation_receipt(
                "ACTIVE_SERVICE_FAILURE_BINDING",
                source_selection=source_selection,
                blockers=list(active_service_failure_binding.get("blockers") or [
                    "ct_m0f_active_service_failure_causal_binding_required"
                ]),
                next_consumer="existing service-failure binding owner",
            ),
            "action_attempted": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }

    for _ in range(max(1, int(max_successive_samples))):
        active_result = close_active_sample(active_reservations())
        if active_result is not None:
            return active_result

        execute_command = [
            executor,
            "--execute-l3-production-validation",
            "--confirm-l3-production-validation",
            "EXECUTE_L3_PRODUCTION_VALIDATION_APPROVED",
            "--ct-m0f-kernel-cutover-validation",
            "--ct-m0f-standing-validation",
            "--ct-m0f-standing-validation-contract-id", contract_id,
            "--ct-m0f-standing-validation-contract-hash", contract_hash,
            "--state-dir", str(state_dir),
            "--event-dir", str(event_dir),
            "--policy-file", str(policy_file),
            "--audit-dir", str(audit_store.parent),
            "--operator-execution-audit-store", str(audit_store),
            "--approved-source", selected_source,
            "--ct-m0f-standing-validation-user", selected_user,
            "--ct-m0f-standing-validation-target", selected_target,
            "--ct-m0f-standing-sample-binding-fingerprint",
            sample_binding_fingerprint,
            "--max-users", "1",
            "--pretty",
        ]
        if active_service_failure_binding.get("requires_binding"):
            binding_kind = str(
                active_service_failure_binding.get("binding_kind") or ""
            )
            if binding_kind:
                execute_command.extend([
                    "--expected-service-failure-binding-kind", binding_kind,
                ])
            execute_command.extend([
                "--expected-service-failure-obligation-id",
                str(active_service_failure_binding.get("automation_obligation_id") or ""),
                "--expected-service-failure-incident-id",
                str(active_service_failure_binding.get("source_incident_id") or ""),
                "--expected-service-failure-scope-fingerprint",
                str(active_service_failure_binding.get("source_scope_fingerprint") or ""),
                "--ct-m0f-source-incident-generation",
                str(active_service_failure_binding.get("source_incident_generation") or ""),
            ])
        rc, result, output = invoke(
            execute_command, max(120, min(timeout_sec, 900))
        )
        reservation = (
            (result.get("ct_m0f_admission_consumption") or {}).get("reservation")
            if isinstance(result.get("ct_m0f_admission_consumption"), dict)
            else {}
        )
        steps.append({
            "kind": "FRESH_SAMPLE_EXECUTION",
            "returncode": rc,
            "reservation_id": str((reservation or {}).get("reservation_id") or ""),
            "final_verdict": str(result.get("final_verdict") or ""),
            "stop_reason": str(result.get("stop_reason") or ""),
            "result": result,
            "output_tail": "" if result else output,
            "runtime_mutation_performed": bool(
                result.get("runtime_mutation_performed")
            ),
        })
        # A reserved sample must always flow through the durable reset/closure
        # successor, even if the child returned STOP_SAFE after its write.
        if reservation:
            continue
        return {
            "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
            "status": "STOP_SAFE_NO_SAMPLE_ADMITTED",
            "ok": bool(
                rc in {0, 2}
                and not result.get("runtime_mutation_performed")
                and int(result.get("users_moved") or 0) == 0
            ),
            "blockers": [
                str(result.get("stop_reason") or result.get("final_verdict") or "sample_not_admitted")
            ],
            "steps": steps,
            "sample_preparation_receipt": preparation_receipt(
                "FRESH_SAMPLE_EXECUTION",
                source_selection=source_selection,
                execution=result,
                terminal=str(result.get("final_verdict") or result.get("stop_reason") or ""),
                blockers=[
                    str(result.get("stop_reason") or result.get("final_verdict") or "sample_not_admitted")
                ],
                next_consumer="existing CT-M0F predicate repair/Matrix consumer",
            ),
            "action_completed": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }

    return {
        "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
        "status": "CT_M0F_BOUNDED_SUCCESSOR_LIMIT_REACHED",
        "ok": True,
        "steps": steps,
        "sample_preparation_receipt": preparation_receipt(
            "BOUNDED_SUCCESSOR_LIMIT",
            source_selection=source_selection,
            terminal="CT_M0F_BOUNDED_SUCCESSOR_LIMIT_REACHED",
            blockers=["ct_m0f_bounded_successor_limit_reached"],
            next_consumer="next ordinary Matrix generation",
        ),
        "action_completed": bool(steps),
        "runtime_mutation_performed": any(
            bool(row.get("runtime_mutation_performed")) for row in steps
        ),
        "users_moved": 0,
    }


def service_failure_obligation_from_advisory(
    advisory_result: Any,
) -> dict[str, Any]:
    """Return only a well-formed current obligation from an advisory result."""
    if not isinstance(advisory_result, dict):
        return {}
    advisory_payload = advisory_result.get("result")
    if not isinstance(advisory_payload, dict):
        return {}
    obligation = advisory_payload.get("obligation")
    return obligation if isinstance(obligation, dict) else {}


def run_controlled_certification_campaign_reset(
    executor: str,
    *,
    state_dir: Path,
    event_dir: Path,
    policy_file: Path,
    audit_store: Path,
    binding: dict[str, Any],
    timeout_sec: int = 600,
) -> dict[str, Any]:
    """Invoke the existing governed owner for the exact approved stage reset."""
    if not binding.get("active"):
        return {
            "schema_version": "v7.controlled-certification-campaign-reset-consumer.v1",
            "status": "NOT_REQUIRED",
            "ok": True,
            "action_attempted": False,
            "users_moved": 0,
        }
    command = [
        executor,
        "--reset-controlled-certification-campaign-stage",
        "--confirm-controlled-certification-campaign-reset",
        "RESET_APPROVED_CONTROLLED_CERTIFICATION_CAMPAIGN_STAGE",
        "--state-dir",
        str(state_dir),
        "--event-dir",
        str(event_dir),
        "--policy-file",
        str(policy_file),
        "--operator-execution-audit-store",
        str(audit_store),
        "--controlled-certification-campaign-request-id",
        str(binding.get("request_id") or ""),
        "--controlled-certification-campaign-request-hash",
        str(binding.get("request_hash") or ""),
        "--controlled-certification-campaign-stage",
        str(binding.get("next_stage") or 0),
    ]
    started_at = now_iso()
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(60, min(int(timeout_sec or 600), 1800)),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.controlled-certification-campaign-reset-consumer.v1",
            "status": "FAILED",
            "ok": False,
            "started_at": started_at,
            "completed_at": now_iso(),
            "command": command,
            "error": f"{type(exc).__name__}:{exc}",
            "action_attempted": True,
            "users_moved": 0,
        }
    try:
        parsed = json.loads(proc.stdout or "")
    except json.JSONDecodeError:
        parsed = {}
    passed = (
        proc.returncode == 0
        and parsed.get("final_verdict")
        == "CONTROLLED_CERTIFICATION_CAMPAIGN_STAGE_RESET_COMPLETE"
        and int(parsed.get("target_user_count_after", -1)) == 0
        and int(parsed.get("ordinary_customer_count") or 0) == 0
    )
    return {
        "schema_version": "v7.controlled-certification-campaign-reset-consumer.v1",
        "status": "RESET_COMPLETE" if passed else "STOP_SAFE",
        "ok": passed,
        "started_at": started_at,
        "completed_at": now_iso(),
        "command": command,
        "returncode": proc.returncode,
        "consumer_result": parsed,
        "action_attempted": True,
        "users_moved": int(parsed.get("users_moved") or 0),
        "runtime_mutation_performed": bool(
            parsed.get("runtime_mutation_performed")
        ),
        "authority_expanded": bool(parsed.get("authority_expanded")),
        "output_tail": (proc.stdout or "")[-2000:] if not passed else "",
    }


def _run_controlled_topology_standing_policy_action_once(
    planner: str,
    executor: str,
    *,
    state_dir: Path,
    event_dir: Path,
    policy_file: Path,
    audit_store: Path,
    timeout_sec: int = 360,
) -> dict[str, Any]:
    """Consume one auto-admitted topology manifest through existing owners."""
    planner_command = [
        planner,
        "--controlled-source-topology-diagnostic",
        "--state-dir",
        str(state_dir),
        "--policy-file",
        str(policy_file),
        "--action-class-audit-store",
        str(audit_store),
    ]
    started_at = now_iso()
    try:
        planner_proc = subprocess.run(
            planner_command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=180,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.controlled-topology-standing-consumer.v1",
            "status": "STOP_SAFE",
            "ok": True,
            "started_at": started_at,
            "completed_at": now_iso(),
            "action_attempted": False,
            "action_completed": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "blockers": [
                f"controlled_topology_planner_unavailable:{type(exc).__name__}"
            ],
        }
    try:
        parsed = json.loads(planner_proc.stdout or "")
        diagnostic = parsed if isinstance(parsed, dict) else {}
    except json.JSONDecodeError:
        diagnostic = {}
    preflight = (
        diagnostic.get("production_preflight")
        if isinstance(diagnostic.get("production_preflight"), dict)
        else {}
    )
    manifest = (
        preflight.get("manifest")
        if isinstance(preflight.get("manifest"), dict)
        else {}
    )
    admission = (
        diagnostic.get("standing_policy_admission")
        if isinstance(diagnostic.get("standing_policy_admission"), dict)
        else {}
    )
    ready = (
        planner_proc.returncode == 0
        and diagnostic.get("status")
        == "CONTROLLED_SOURCE_TOPOLOGY_PRODUCTION_PREFLIGHT_READY"
        and admission.get("status")
        == "AUTO_ADMITTED_BY_STANDING_DELEGATED_CONTROLLED_TOPOLOGY_POLICY"
        and admission.get("ok") is True
        and int(manifest.get("trial_identity_count") or 0) == 1
        and str(manifest.get("expected_ordinary_assignment_delta") or "")
        == "NONE"
        and str(manifest.get("expected_ordinary_route_delta") or "") == "NONE"
    )
    if not ready:
        return {
            "schema_version": "v7.controlled-topology-standing-consumer.v1",
            "status": "NOT_REQUIRED_OR_NOT_ADMITTED",
            "ok": True,
            "started_at": started_at,
            "completed_at": now_iso(),
            "action_attempted": False,
            "action_completed": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "diagnostic_status": str(diagnostic.get("status") or ""),
            "blockers": list(admission.get("blockers") or []),
        }
    command = [
        executor,
        "--execute-controlled-topology-standing-transaction",
        "--state-dir",
        str(state_dir),
        "--event-dir",
        str(event_dir),
        "--policy-file",
        str(policy_file),
        "--operator-execution-audit-store",
        str(audit_store),
        "--expected-standing-policy-contract-id",
        str(admission.get("contract_id") or ""),
        "--expected-standing-policy-contract-hash",
        str(admission.get("contract_hash") or ""),
        "--expected-controlled-topology-manifest-hash",
        str(manifest.get("manifest_hash") or ""),
        "--controlled-topology-user",
        str(manifest.get("trial_identity") or ""),
        "--controlled-topology-source",
        str(manifest.get("existing_source") or ""),
        "--controlled-topology-target",
        str(manifest.get("selected_source_or_draft") or ""),
        "--controlled-topology-planner",
        planner,
        "--max-users",
        "1",
        "--compact-transaction-receipt",
        "--pretty",
    ]
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(60, min(int(timeout_sec or 360), 900)),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.controlled-topology-standing-consumer.v1",
            "status": "FAILED",
            "ok": False,
            "started_at": started_at,
            "completed_at": now_iso(),
            "action_attempted": True,
            "action_completed": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "error": f"{type(exc).__name__}:{exc}",
        }
    try:
        parsed = json.loads(proc.stdout or "")
        result = parsed if isinstance(parsed, dict) else {}
    except json.JSONDecodeError:
        result = {}
    completed = (
        proc.returncode == 0
        and result.get("controlled_topology_final_verdict")
        == "ONE_IDENTITY_AUTONOMOUS_CONTROLLED_TOPOLOGY_TRIAL_PROVEN"
        and int(result.get("users_moved") or 0) == 1
    )
    stopped = (
        not completed
        and not bool(result.get("apply_executed"))
        and int(result.get("users_moved") or 0) == 0
    )
    return {
        "schema_version": "v7.controlled-topology-standing-consumer.v1",
        "status": (
            "ACTION_COMPLETED"
            if completed
            else ("STOP_SAFE" if stopped else "FAILED")
        ),
        "ok": completed or stopped,
        "started_at": started_at,
        "completed_at": now_iso(),
        "returncode": proc.returncode,
        "action_attempted": True,
        "action_completed": completed,
        "runtime_mutation_performed": bool(
            result.get("runtime_mutation_performed")
            or result.get("apply_executed")
        ),
        "reservation_mutation_performed": bool(
            result.get("reservation_mutation_performed")
        ),
        "reservation_released_after_stop": bool(
            result.get("reservation_released_after_stop")
        ),
        "stop_reason": str(result.get("stop_reason") or ""),
        "blockers": list(result.get("blockers") or []),
        "users_moved": int(result.get("users_moved") or 0),
        "contract_id": str(admission.get("contract_id") or ""),
        "contract_hash": str(admission.get("contract_hash") or ""),
        "manifest_hash": str(manifest.get("manifest_hash") or ""),
        "trial_identity": str(manifest.get("trial_identity") or ""),
        "source": str(manifest.get("existing_source") or ""),
        "target": str(manifest.get("selected_source_or_draft") or ""),
        "consumer_result": result,
        "output_tail": (proc.stdout or "")[-2000:] if not (completed or stopped) else "",
    }


def run_controlled_topology_standing_policy_action(
    planner: str,
    executor: str,
    *,
    state_dir: Path,
    event_dir: Path,
    policy_file: Path,
    audit_store: Path,
    timeout_sec: int = 360,
    max_successive_rebindings: int = 1,
) -> dict[str, Any]:
    """Consume serial same-campaign topology successors through Matrix.

    The fixed upper bound is the approved certification-pool size.  Every
    iteration re-runs the existing Planner and creates a fresh Packet/lease;
    the first safe stop ends the loop.
    """
    limit = max(1, min(int(max_successive_rebindings or 1), 48))
    attempts: list[dict[str, Any]] = []
    completed: list[dict[str, Any]] = []
    seen_users: set[str] = set()
    for _ in range(limit):
        current = _run_controlled_topology_standing_policy_action_once(
            planner,
            executor,
            state_dir=state_dir,
            event_dir=event_dir,
            policy_file=policy_file,
            audit_store=audit_store,
            timeout_sec=timeout_sec,
        )
        attempts.append(current)
        if not current.get("action_completed"):
            break
        user = str(current.get("trial_identity") or "")
        if not user or user in seen_users:
            current.update({
                "status": "STOP_SAFE",
                "ok": True,
                "action_completed": False,
                "blockers": [
                    "controlled_topology_successor_identity_repeated"
                ],
            })
            break
        seen_users.add(user)
        completed.append(current)
    if len(attempts) == 1:
        return attempts[0]
    successor = (
        attempts[-1]
        if attempts and not attempts[-1].get("action_completed")
        else {}
    )
    return {
        "schema_version": (
            "v7.controlled-topology-standing-successor-loop.v1"
        ),
        "status": (
            "ACTION_COMPLETED"
            if completed
            else str(attempts[-1].get("status") or "STOP_SAFE")
        ),
        "ok": all(row.get("ok") is True for row in attempts),
        "started_at": str(attempts[0].get("started_at") or ""),
        "completed_at": now_iso(),
        "action_attempted": any(
            row.get("action_attempted") for row in attempts
        ),
        "action_completed": bool(completed),
        "runtime_mutation_performed": any(
            row.get("runtime_mutation_performed") for row in attempts
        ),
        "reservation_mutation_performed": any(
            row.get("reservation_mutation_performed") for row in attempts
        ),
        "users_moved": sum(
            int(row.get("users_moved") or 0) for row in completed
        ),
        "completed_rebindings": [
            {
                "trial_identity": str(row.get("trial_identity") or ""),
                "source": str(row.get("source") or ""),
                "target": str(row.get("target") or ""),
                "manifest_hash": str(row.get("manifest_hash") or ""),
            }
            for row in completed
        ],
        "successor_probe": {
            key: successor.get(key)
            for key in (
                "status", "ok", "stop_reason", "blockers",
                "diagnostic_status",
            )
            if successor.get(key) not in (None, "", [], {})
        },
        "authority_expanded": False,
        "production_maturity_change": False,
        "natural_l8_credit": False,
    }


def _run_availability_first_standing_policy_stage_once(
    planner: str,
    executor: str,
    *,
    state_dir: Path,
    event_dir: Path,
    policy_file: Path,
    audit_store: Path,
    timeout_sec: int = 1800,
) -> dict[str, Any]:
    """Consume the current auto-admitted ladder stage through Matrix."""
    planner_command = [
        planner,
        "--controlled-source-topology-diagnostic",
        "--state-dir",
        str(state_dir),
        "--policy-file",
        str(policy_file),
        "--action-class-audit-store",
        str(audit_store),
    ]
    started_at = now_iso()
    try:
        planner_proc = subprocess.run(
            planner_command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=180,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.availability-first-matrix-consumer.v1",
            "status": "STOP_SAFE",
            "ok": True,
            "action_attempted": False,
            "action_completed": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "blockers": [
                f"availability_first_planner_unavailable:{type(exc).__name__}"
            ],
        }
    try:
        parsed = json.loads(planner_proc.stdout or "")
        diagnostic = parsed if isinstance(parsed, dict) else {}
    except json.JSONDecodeError:
        diagnostic = {}
    admission = (
        diagnostic.get("availability_first_standing_policy_admission")
        if isinstance(
            diagnostic.get("availability_first_standing_policy_admission"),
            dict,
        )
        else {}
    )
    projection = (
        diagnostic.get("shared_production_target_capacity_projection")
        if isinstance(
            diagnostic.get("shared_production_target_capacity_projection"),
            dict,
        )
        else {}
    )
    campaign = (
        projection.get("availability_campaign")
        if isinstance(projection.get("availability_campaign"), dict)
        else {}
    )
    completed_campaign_stages = {
        int(value)
        for value in (campaign.get("completed_stages") or [])
        if str(value).strip().isdigit()
    }
    # ``current_stage`` is the canonical projection published by the shared
    # target-capacity owner.  ``availability_campaign`` is retained as the
    # append-only campaign history/progress view and may briefly describe the
    # just-consumed predecessor.  Never let that historical nested view make
    # Matrix dispatch a stale stage after the canonical successor advanced.
    campaign_stage = int(
        projection.get("current_stage")
        or campaign.get("next_stage")
        or 0
    )
    stage_allocation = (
        (projection.get("stage_allocations") or {}).get(
            str(campaign_stage),
            {},
        )
        if isinstance(projection.get("stage_allocations"), dict)
        else {}
    )
    target_growth_trial = (
        projection.get("target_growth_trial")
        if isinstance(projection.get("target_growth_trial"), dict)
        else {}
    )
    target_bound_mode = bool(
        not stage_allocation.get("feasible")
        and target_growth_trial.get("status") == "TARGET_BOUND_TRIAL_READY"
        and target_growth_trial.get("feasible") is True
    )
    stage = int(
        target_growth_trial.get("trial_scope")
        if target_bound_mode
        else campaign_stage
        or 0
    )
    allocation = target_growth_trial if target_bound_mode else stage_allocation
    ready = bool(
        planner_proc.returncode == 0
        and admission.get("ok") is True
        and stage in operator_execution.AVAILABILITY_FIRST_LADDER
        and allocation.get("feasible") is True
        and allocation.get("allocation_fingerprint")
        and (
            target_bound_mode
            or diagnostic.get("status")
            == "CONTROLLED_TOPOLOGY_AVAILABILITY_FIRST_AUTO_ADMITTED"
        )
    )
    prior_summary = read_json(
        state_dir / "service-matrix-refresh-summary.json",
        {},
    )
    def prior_projection_stream():
        if isinstance(prior_summary, dict):
            yield prior_summary
        for path in sorted(
            event_dir.glob("service-matrix-refresh-*.jsonl"),
            reverse=True,
        )[:RECENT_MATRIX_EVENT_FILE_LIMIT]:
            yield from reversed(
                intelligence_workers.read_jsonl_tail(
                    path,
                    limit=RECENT_MATRIX_EVENT_ROW_LIMIT,
                    max_bytes=RECENT_MATRIX_EVENT_BYTE_LIMIT,
                )
            )
    try:
        current_user_rows = [
            parse_kv_line(line)
            for line in (
                state_dir / "users.registry"
            ).read_text(
                encoding="utf-8",
                errors="replace",
            ).splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        ]
    except OSError:
        current_user_rows = []
    current_routes = {
        str(row.get("ip") or ""): str(row.get("current") or "")
        for row in current_user_rows
        if row.get("ip")
    }
    prior_availability: dict[str, Any] = {}
    prior_result: dict[str, Any] = {}
    partial_apply_pending = False
    for prior_projection in prior_projection_stream():
        candidate = (
            prior_projection.get(
                "availability_first_standing_policy_action"
            )
            if isinstance(
                prior_projection.get(
                    "availability_first_standing_policy_action"
                ),
                dict,
            )
            else {}
        )
        candidate_result = (
            candidate.get("consumer_result")
            if isinstance(candidate.get("consumer_result"), dict)
            else {}
        )
        # A completion receipt is immutable campaign truth.  A historical
        # partial-reset row for that already consumed stage must never
        # override the canonical successor (for example Stage-10 -> Stage-25)
        # on every later Matrix cycle.  An incomplete current stage remains
        # eligible for the existing partial-recovery path below.
        candidate_stage = int(
            candidate_result.get("campaign_stage")
            or candidate_result.get("stage")
            or candidate.get("campaign_stage")
            or candidate.get("stage")
            or 0
        )
        if candidate_stage in completed_campaign_stages:
            continue
        candidate_packets = [
            row
            for row in (candidate_result.get("packet_set") or [])
            if isinstance(row, dict)
        ]
        circuit_breaker = (
            candidate_result.get("circuit_breaker")
            if isinstance(
                candidate_result.get("circuit_breaker"),
                dict,
            )
            else {}
        )
        for candidate_packet in candidate_packets:
            candidate_user = str(candidate_packet.get("user") or "")
            partial_or_cleanup_pending = bool(
                str(candidate_packet.get("stop_reason") or "")
                == "l3_production_validation_downstream_proof_failed"
                or (
                    str(candidate_packet.get("final_verdict") or "")
                    == "L3_PRODUCTION_PROVEN"
                    and str(candidate_packet.get("verification_result") or "")
                    == "PASS"
                    and int(candidate_packet.get("users_moved") or 0) == 1
                    and str(circuit_breaker.get("reason") or "")
                    == "availability_first_baseline_reset_failed"
                )
            )
            if (
                candidate.get("status") == "STOP_SAFE"
                and partial_or_cleanup_pending
                and candidate_user
                and current_routes.get(candidate_user)
                == str(candidate_packet.get("target") or "")
            ):
                prior_availability = candidate
                prior_result = candidate_result
                partial_apply_pending = True
                break
        if partial_apply_pending:
            break
    if partial_apply_pending:
        stage = int(
            prior_result.get("stage")
            or prior_availability.get("stage")
            or stage
            or 0
        )
    if not ready and not partial_apply_pending:
        return {
            "schema_version": "v7.availability-first-matrix-consumer.v1",
            "status": (
                "CAMPAIGN_COMPLETE"
                if campaign.get("completed")
                else "NOT_REQUIRED_OR_NOT_ADMITTED"
            ),
            "ok": True,
            "started_at": started_at,
            "completed_at": now_iso(),
            "action_attempted": False,
            "action_completed": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "stage": stage,
            "diagnostic_status": str(diagnostic.get("status") or ""),
            "blockers": sorted(set(
                list(admission.get("blockers") or [])
                + list(campaign.get("blockers") or [])
            )),
        }
    performance_gate_receipt = current_performance_closure_receipt(
        audit_store,
        revalidation_generation=PERFORMANCE_REVALIDATION_GENERATION,
    )
    performance_benchmark = bool(
        stage == 48 and not performance_gate_receipt
    )
    # The immutable performance receipt is an existing-owner prerequisite for
    # the Stage-48 action class.  It must not create a second, implicit
    # Authority boundary after the current active standing contract has
    # already admitted the exact action class, scope and serial envelope.
    # ``ready`` above is deliberately the only admission path: it validates
    # the live standing-policy contract, the fresh Planner projection and the
    # bounded allocation before the executor can materialize anything.
    #
    # Previously this branch returned a durable-looking terminal without
    # dispatching the already-approved stage.  That stranded the existing
    # Matrix consumer in a self-created wait and contradicted an active
    # max-48 contract.  The performance receipt now enables the ordinary
    # existing executor path; it grants nothing and does not widen scope.
    command = [
        executor,
        (
            "--execute-performance-closure-benchmark"
            if performance_benchmark
            else "--execute-availability-first-standing-stage"
        ),
        "--state-dir",
        str(state_dir),
        "--event-dir",
        str(event_dir),
        "--policy-file",
        str(policy_file),
        "--operator-execution-audit-store",
        str(audit_store),
        "--controlled-topology-planner",
        planner,
        "--pretty",
    ]
    if not performance_benchmark:
        command[2:2] = ["--availability-first-stage", str(stage)]
    if target_bound_mode:
        command.extend([
            "--availability-first-target-bound-trial-target",
            str(target_growth_trial.get("target_id") or ""),
        ])
    # Do not bind the executor to the wrapper's earlier live-snapshot
    # fingerprint.  Matrix/quality owners may publish a newer generation
    # between these two processes, producing an endless safe-stop TOCTOU loop.
    # The executor independently re-runs admission and materializes one fresh
    # immutable allocation immediately before Candidate/Packet creation; every
    # selected target is then revalidated by the existing live gates.
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(
                300,
                min(
                    max(int(timeout_sec or 1800), stage * 360),
                    21600,
                ),
            ),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.availability-first-matrix-consumer.v1",
            "status": "FAILED",
            "ok": False,
            "started_at": started_at,
            "completed_at": now_iso(),
            "action_attempted": True,
            "action_completed": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "stage": stage,
            "error": f"{type(exc).__name__}:{exc}",
        }
    try:
        parsed = json.loads(proc.stdout or "")
        result = parsed if isinstance(parsed, dict) else {}
    except json.JSONDecodeError:
        result = {}
    expected_verdict = (
        "GOVERNED_PERFORMANCE_CLOSURE_BENCHMARK_COMPLETED"
        if performance_benchmark
        else "AVAILABILITY_FIRST_TARGET_BOUND_TRIAL_COMPLETED"
        if target_bound_mode
        else "AVAILABILITY_FIRST_STANDING_STAGE_COMPLETED"
    )
    completed = (
        proc.returncode == 0
        and result.get("final_verdict") == expected_verdict
        and (
            int(result.get("stage") or 0) == 1
            if performance_benchmark
            else int(result.get("stage") or 0) == stage
        )
    )
    receipt = (
        (
            record_performance_closure_consumption(
                audit_store=audit_store,
                result=result,
            )
            if performance_benchmark
            else record_availability_first_target_bound_consumption(
                audit_store=audit_store,
                result=result,
            )
            if target_bound_mode
            else record_availability_first_stage_consumption(
                audit_store=audit_store,
                result=result,
            )
        )
        if completed
        else {
            "receipt_id": "",
            "audit_write": False,
            "duplicate_suppressed": False,
            "blockers": ["availability_first_stage_not_complete"],
        }
    )
    completed = completed and bool(
        receipt.get("receipt_id")
        and (
            receipt.get("audit_write")
            or receipt.get("duplicate_suppressed")
        )
    )
    stopped = (
        not completed
        and str(result.get("transaction_status") or "") == "STOP_SAFE"
    )
    return {
        "schema_version": "v7.availability-first-matrix-consumer.v1",
        "status": (
            "ACTION_COMPLETED"
            if completed
            else ("STOP_SAFE" if stopped else "FAILED")
        ),
        "ok": completed or stopped,
        "started_at": started_at,
        "completed_at": now_iso(),
        "returncode": proc.returncode,
        "action_attempted": True,
        "action_completed": completed,
        "runtime_mutation_performed": bool(
            result.get("runtime_mutation_performed")
        ),
        "users_moved": int(result.get("users_moved") or 0),
        "stage": stage,
        "performance_benchmark": performance_benchmark,
        "performance_gate_receipt_id": str(
            performance_gate_receipt.get("receipt_id") or ""
        ),
        "stage_48_optimized_runtime_ready": bool(
            stage == 48 and performance_gate_receipt
        ),
        "stage_48_execution_permitted": bool(
            stage == 48
            and performance_gate_receipt
            and ready
            and not performance_benchmark
        ),
        "completion_kind": (
            "PERFORMANCE_BENCHMARK_NO_STAGE_CREDIT"
            if performance_benchmark
            else "TARGET_BOUND_TRIAL"
            if target_bound_mode
            else "CAMPAIGN_STAGE"
        ),
        "target_bound_trial_target": str(
            target_growth_trial.get("target_id") or ""
        ) if target_bound_mode else "",
        "allocation_fingerprint": str(
            allocation.get("allocation_fingerprint") or ""
        ),
        "stage_consumption": receipt,
        "consumer_result": result,
        "durable_successor": (
            "EXISTING_MATRIX_RECOMPUTE_AVAILABILITY_FIRST_NEXT_STAGE"
            if completed
            else str(result.get("durable_successor") or "")
        ),
        "output_tail": (
            (proc.stdout or "")[-2000:]
            if not (completed or stopped)
            else ""
        ),
    }


def run_availability_first_standing_policy_stage(
    planner: str,
    executor: str,
    *,
    state_dir: Path,
    event_dir: Path,
    policy_file: Path,
    audit_store: Path,
    timeout_sec: int = 1800,
    max_successive_stages: int = 1,
) -> dict[str, Any]:
    """Consume bounded fresh ladder successors inside one Matrix generation.

    Every iteration re-enters the existing Planner and executor from durable
    receipt truth.  It does not reuse an allocation, Candidate, Packet or
    lease.  The bound is the fixed ladder length and serial execution remains
    one transaction at a time.  A first non-complete successor stops the loop.
    """
    limit = max(
        1,
        min(
            int(max_successive_stages or 1),
            len(operator_execution.AVAILABILITY_FIRST_LADDER),
        ),
    )
    attempts: list[dict[str, Any]] = []
    completed_stages: list[int] = []
    completed_successors: list[dict[str, Any]] = []
    seen_successors: set[tuple[str, int, str]] = set()
    for _ in range(limit):
        current = _run_availability_first_standing_policy_stage_once(
            planner,
            executor,
            state_dir=state_dir,
            event_dir=event_dir,
            policy_file=policy_file,
            audit_store=audit_store,
            timeout_sec=timeout_sec,
        )
        attempts.append(current)
        if not current.get("action_completed"):
            break
        stage = int(current.get("stage") or 0)
        completion_kind = str(
            current.get("completion_kind") or "CAMPAIGN_STAGE"
        )
        target_id = str(
            current.get("target_bound_trial_target") or ""
        )
        successor_identity = (completion_kind, stage, target_id)
        if (
            stage not in operator_execution.AVAILABILITY_FIRST_LADDER
            or successor_identity in seen_successors
        ):
            current.update({
                "status": "STOP_SAFE",
                "ok": True,
                "action_completed": bool(completed_stages),
                "durable_successor": (
                    "EXISTING_MATRIX_RECONCILE_DUPLICATE_STAGE_SUCCESSOR"
                ),
                "blockers": ["availability_first_stage_successor_repeated"],
            })
            break
        seen_successors.add(successor_identity)
        completed_stages.append(stage)
        completed_successors.append({
            "completion_kind": completion_kind,
            "scope": stage,
            "target_id": target_id,
            "receipt_id": str(
                (current.get("stage_consumption") or {}).get(
                    "receipt_id"
                )
                or ""
            ),
        })
    if len(attempts) == 1:
        return attempts[0]

    completed_attempts = [
        row for row in attempts if row.get("action_completed")
    ]
    last_completed = (
        completed_attempts[-1] if completed_attempts else {}
    )
    successor_probe = (
        attempts[-1]
        if attempts and not attempts[-1].get("action_completed")
        else {}
    )
    return {
        "schema_version": (
            "v7.availability-first-matrix-successor-loop.v1"
        ),
        "status": (
            "ACTION_COMPLETED"
            if completed_attempts
            else str(attempts[-1].get("status") or "STOP_SAFE")
        ),
        "ok": all(row.get("ok") is True for row in attempts),
        "started_at": str(attempts[0].get("started_at") or ""),
        "completed_at": now_iso(),
        "action_attempted": any(
            row.get("action_attempted") for row in attempts
        ),
        "action_completed": bool(completed_attempts),
        "runtime_mutation_performed": any(
            row.get("runtime_mutation_performed") for row in attempts
        ),
        "users_moved": sum(
            int(row.get("users_moved") or 0) for row in attempts
        ),
        "stage": int(last_completed.get("stage") or 0),
        "stage_consumption": last_completed.get("stage_consumption") or {},
        "consumer_result": last_completed.get("consumer_result") or {},
        "completed_stages_this_invocation": completed_stages,
        "completed_successors_this_invocation": completed_successors,
        "successor_probe": {
            key: successor_probe.get(key)
            for key in (
                "status", "ok", "stage", "diagnostic_status",
                "blockers", "durable_successor",
            )
            if successor_probe.get(key) not in (None, "", [], {})
        },
        "durable_successor": (
            str(successor_probe.get("durable_successor") or "")
            if successor_probe
            else "EXISTING_MATRIX_RECOMPUTE_AVAILABILITY_FIRST_NEXT_STAGE"
        ),
        "authority_expanded": False,
        "production_maturity_change": False,
        "natural_l8_credit": False,
    }


def run_passive_consumer(
    consumer: str,
    *,
    state_dir: Path,
    event_dir: Path,
    timeout_sec: int = 30,
) -> dict[str, Any]:
    """Consume passive events through the existing owner without runtime action."""
    command = [
        consumer,
        "--consume-passive-events-only",
        "--state-dir",
        str(state_dir),
        "--event-dir",
        str(event_dir),
    ]
    started_at = now_iso()
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(5, min(int(timeout_sec or 30), 120)),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.passive-consumer-liveness.v1",
            "status": "FAILED",
            "ok": False,
            "started_at": started_at,
            "completed_at": now_iso(),
            "command": command,
            "error": f"{type(exc).__name__}:{exc}",
            "omp_repair_frontier": {
                "frontier_id": "V7_PASSIVE_SERVICE_EVENT_CONSUMER_REPAIR",
                "last_responsible_producer": "tools/v7-service-matrix-refresh-all",
                "missing_consumer": "tools/v7-users-autoswitch --consume-passive-events-only",
                "exact_missing_artifact": "passive consumer terminal",
                "forbidden_effects": "NONE",
            },
        }
    parsed: dict[str, Any] = {}
    try:
        value = json.loads(proc.stdout or "")
        parsed = value if isinstance(value, dict) else {}
    except json.JSONDecodeError:
        parsed = {}
    ok = proc.returncode == 0 and parsed.get("status") == "PASS"
    result = {
        "schema_version": "v7.passive-consumer-liveness.v1",
        "status": "PASS" if ok else "FAILED",
        "ok": ok,
        "started_at": started_at,
        "completed_at": now_iso(),
        "command": command,
        "returncode": proc.returncode,
        "consumer_result": parsed,
    }
    if not ok:
        result["output_tail"] = (proc.stdout or "")[-2000:]
        result["omp_repair_frontier"] = {
            "frontier_id": "V7_PASSIVE_SERVICE_EVENT_CONSUMER_REPAIR",
            "last_responsible_producer": "tools/v7-service-matrix-refresh-all",
            "missing_consumer": "tools/v7-users-autoswitch --consume-passive-events-only",
            "exact_missing_artifact": "passive consumer terminal",
            "forbidden_effects": "NONE",
        }
    return result


def run_one(
    egress_id: str,
    timeout: int,
    checker: str,
    state_dir: Path,
    services: str = "",
    failure_persistence_samples: int = 0,
    failure_persistence_window_seconds: int = 0,
    event_dir: Optional[Path] = None,
) -> dict[str, Any]:
    started = time.time()
    cmd = [checker, egress_id, "all", "--timeout", str(timeout), "--state-dir", str(state_dir)]
    if str(services or "").strip():
        cmd.extend(["--services", str(services).strip()])
    if int(failure_persistence_samples or 0) > 0:
        cmd.extend(["--failure-persistence-samples", str(int(failure_persistence_samples))])
    if int(failure_persistence_window_seconds or 0) > 0:
        cmd.extend(["--failure-persistence-window-seconds", str(int(failure_persistence_window_seconds))])
    if event_dir is not None:
        cmd.extend(["--event-dir", str(event_dir)])
    try:
        proc = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False, timeout=timeout * 14)
    except subprocess.TimeoutExpired as exc:
        return {
            "egress": egress_id,
            "status": "TIMEOUT",
            "ok": False,
            "elapsed_sec": round(time.time() - started, 3),
            "output_tail": str(exc.stdout or "")[-2000:],
            "cmd": cmd,
        }
    output = proc.stdout or ""
    parsed: dict[str, Any] = {}
    try:
        parsed = json.loads(output)
    except json.JSONDecodeError:
        parsed = {}
    status = str(parsed.get("status") or ("OK" if proc.returncode == 0 else "FAIL"))
    ok = proc.returncode == 0 and status in ("OK", "WARN")
    return {
        "egress": egress_id,
        "status": status,
        "ok": ok,
        "rc": proc.returncode,
        "ok_count": parsed.get("ok_count", 0),
        "total": parsed.get("total", 0),
        "elapsed_sec": round(time.time() - started, 3),
        "output_tail": output[-2000:],
        "cmd": cmd,
        "service_matrix_lock": (
            parsed.get("service_matrix_lock")
            if isinstance(parsed.get("service_matrix_lock"), dict)
            else {}
        ),
        "service_results": {
            str(service): {
                "ok": bool(row.get("ok")),
                "status": str(row.get("status") or "UNKNOWN"),
            }
            for service, row in (parsed.get("results") or {}).items()
            if isinstance(row, dict)
        },
    }


