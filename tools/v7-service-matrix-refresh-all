    """Append one exact availability-first stage receipt to the same owner."""
    stage = int(result.get("stage") or 0)
    contract_id = str(
        result.get("standing_policy_contract_id") or ""
    )
    contract_hash = str(
        result.get("standing_policy_contract_hash") or ""
    )
    required = (
        "allocation_immutable",
        "capacity_reservation_verified",
        "outcome_consumed",
        "replay_consumed",
        "learning_consumed",
        "per_user_verification_passed",
        "per_target_verification_passed",
        "aggregate_verification_passed",
        "ordinary_user_protection_passed",
        "baseline_reset_verified",
    )
    blockers = [
        name
        for name in required
        if result.get(name) is not True
