def current_performance_closure_receipt(
    audit_store: Path,
    *,
    revalidation_generation: str = "",
) -> dict[str, Any]:
    rows = operator_execution.read_live_execution_lineage_records(
        audit_store, include_runtime_actions=True
    )
    seen = {str(row.get("record_hash") or "") for row in rows}
    rows.extend(
        row for row in operator_execution.read_audit_records(audit_store)
        if str(row.get("record_hash") or "") not in seen
    )
    matches = [
        row for row in rows
        if row.get("record_type") == PERFORMANCE_CLOSURE_RECORD_TYPE
        and row.get("time_optimization_loop_consumed") is True
        and row.get("baseline_reset_verified") is True
        and row.get("ordinary_user_protection_passed") is True
        and (
            not revalidation_generation
            or str(row.get("performance_revalidation_generation") or "")
            == revalidation_generation
        )
    ]
    return matches[-1] if matches else {}


def record_performance_closure_consumption(
    *, audit_store: Path, result: dict[str, Any]
) -> dict[str, Any]:
    required = (
        "allocation_immutable",
        "capacity_reservation_verified",
        "outcome_consumed",
        "replay_consumed",
        "learning_consumed",
        "per_user_verification_passed",
        "per_target_verification_passed",
        "aggregate_verification_passed",
        "ordinary_user_protection_passed",
        "baseline_reset_verified",
    )
    blockers = [name for name in required if result.get(name) is not True]
    if result.get("final_verdict") != "GOVERNED_PERFORMANCE_CLOSURE_BENCHMARK_COMPLETED":
        blockers.append("performance_closure_benchmark_not_complete")
    if result.get("campaign_stage_credit") is not False:
        blockers.append("campaign_stage_credit_must_be_false")
    timings = [
        row.get("timing") for row in (result.get("cohort_execution_timings") or [])
        if isinstance(row, dict) and isinstance(row.get("timing"), dict)
    ]
    if not timings or any(row.get("status") != "MONOTONIC_BREAKDOWN_CONSUMED" for row in timings):
        blockers.append("nested_monotonic_timing_missing")
    reset_timings = [
        row
        for row in (result.get("reset_execution_timings") or [])
        if isinstance(row, dict) and isinstance(row.get("timing"), dict)
    ]
    if not reset_timings or any(
        (row.get("timing") or {}).get("status")
        != "MONOTONIC_BREAKDOWN_CONSUMED"
        for row in reset_timings
    ):
        blockers.append("reset_nested_monotonic_timing_missing")
    if blockers:
        return {"receipt_id": "", "audit_write": False, "duplicate_suppressed": False, "blockers": sorted(set(blockers))}
    semantic = {
        "performance_revalidation_generation": (
            PERFORMANCE_REVALIDATION_GENERATION
        ),
        "contract_id": str(result.get("standing_policy_contract_id") or ""),
        "execution_allocation_fingerprint": str(result.get("execution_allocation_fingerprint") or ""),
        "packet_set_fingerprint": str(result.get("packet_set_fingerprint") or ""),
        "timing_fingerprint": operator_execution.sha256_json(timings),
        "reset_timing_fingerprint": operator_execution.sha256_json(
            reset_timings
        ),
    }
    receipt_id = "perfclose_" + operator_execution.sha256_json(semantic)[:24]
    with operator_execution.current_action_class_contract_policy_lock(audit_store):
        prior = current_performance_closure_receipt(
            audit_store,
            revalidation_generation=PERFORMANCE_REVALIDATION_GENERATION,
        )
        if prior:
            return {"receipt_id": str(prior.get("receipt_id") or ""), "audit_write": False, "duplicate_suppressed": True}
        row = operator_execution.append_record(audit_store, {
            "schema_version": "v7.governed-performance-closure-consumption.v1",
            "record_type": PERFORMANCE_CLOSURE_RECORD_TYPE,
            "performance_revalidation_generation": (
                PERFORMANCE_REVALIDATION_GENERATION
            ),
            "receipt_id": receipt_id,
            "standing_policy_contract_id": semantic["contract_id"],
            "execution_allocation_fingerprint": semantic["execution_allocation_fingerprint"],
            "packet_set_fingerprint": semantic["packet_set_fingerprint"],
            "timing_fingerprint": semantic["timing_fingerprint"],
            "execution_timings": timings,
            "reset_execution_timings": reset_timings,
            "performance_timeline": list(result.get("performance_timeline") or []),
            "time_analysis_owner": "admin_core.operator_execution_pipeline.execution_performance_foundation",
            "time_analysis_schema": str((timings[0] or {}).get("analysis_schema_version") or ""),
            "time_optimization_loop_consumed": True,
            "one_governed_transaction_fastest_safe_path_proven": True,
            "stage_48_optimized_runtime_ready": True,
            "stage_48_executed": False,
            "campaign_stage_credit": False,
            "ordinary_user_protection_passed": True,
            "baseline_reset_verified": True,
            "natural_l8_credit": False,
            "created_at": now_iso(),
        })
    return {"receipt_id": str(row.get("receipt_id") or receipt_id), "audit_write": True, "duplicate_suppressed": False}


def record_availability_first_target_bound_consumption(
    *,
    audit_store: Path,
    result: dict[str, Any],
) -> dict[str, Any]:
    """Append one compact target-growth receipt through the existing owner."""
    verified_scope = int(result.get("stage") or 0)
    target_id = str(result.get("target_bound_trial_target") or "")
    contract_id = str(result.get("standing_policy_contract_id") or "")
    contract_hash = str(result.get("standing_policy_contract_hash") or "")
    allocation = [
        row for row in (result.get("allocation") or [])
        if isinstance(row, dict)
    ]
    required = (
        "allocation_immutable",
        "capacity_reservation_verified",
        "outcome_consumed",
        "replay_consumed",
        "learning_consumed",
        "per_user_verification_passed",
        "per_target_verification_passed",
        "aggregate_verification_passed",
        "ordinary_user_protection_passed",
        "baseline_reset_verified",
    )
    blockers = [
        name for name in required if result.get(name) is not True
    ]
    if (
        result.get("final_verdict")
        != "AVAILABILITY_FIRST_TARGET_BOUND_TRIAL_COMPLETED"
    ):
        blockers.append("availability_first_target_bound_not_complete")
    if verified_scope not in operator_execution.AVAILABILITY_FIRST_LADDER:
        blockers.append("availability_first_target_bound_not_in_ladder")
    if (
        len(allocation) != 1
        or str(allocation[0].get("target_id") or "") != target_id
        or int(allocation[0].get("allocated_users") or 0)
        != verified_scope
    ):
        blockers.append("availability_first_target_bound_allocation_invalid")
    if not target_id or not contract_id or not contract_hash:
        blockers.append("availability_first_target_bound_identity_missing")
    if blockers:
        return {
            "receipt_id": "",
            "audit_write": False,
            "duplicate_suppressed": False,
            "blockers": sorted(set(blockers)),
        }
    target = allocation[0]
    semantic = {
        "contract_id": contract_id,
        "contract_hash": contract_hash,
        "target_id": target_id,
        "verified_scope": verified_scope,
        "execution_allocation_fingerprint": str(
            result.get("execution_allocation_fingerprint") or ""
        ),
        "packet_set_fingerprint": str(
            result.get("packet_set_fingerprint") or ""
        ),
    }
    receipt_id = "aftbound_" + operator_execution.sha256_json(
        semantic
    )[:24]
    with operator_execution.current_action_class_contract_policy_lock(
        audit_store
    ):
        rows = operator_execution.read_live_execution_lineage_records(
            audit_store
        )
        prior = [
            row for row in rows
            if row.get("record_type")
            == CONTROLLED_CAMPAIGN_EFFECT_RECORD_TYPE
            and row.get("effect_class")
            == AVAILABILITY_FIRST_TARGET_BOUND_EFFECT_CLASS
            and str(row.get("standing_policy_contract_id") or "")
            == contract_id
            and str(row.get("target_id") or "") == target_id
            and int(row.get("verified_scope") or 0) == verified_scope
        ]
        if prior:
            return {
                "receipt_id": str(prior[-1].get("receipt_id") or ""),
                "audit_write": False,
                "duplicate_suppressed": True,
            }
        row = operator_execution.append_record(audit_store, {
            "schema_version": (
                "v7.availability-first-target-bound-receipt.v1"
            ),
            "record_type": CONTROLLED_CAMPAIGN_EFFECT_RECORD_TYPE,
            "effect_class": AVAILABILITY_FIRST_TARGET_BOUND_EFFECT_CLASS,
            "receipt_id": receipt_id,
            "standing_policy_contract_id": contract_id,
            "standing_policy_contract_hash": contract_hash,
            "campaign_next_stage": int(
                result.get("campaign_next_stage") or 0
            ),
            "target_id": target_id,
            "verified_scope": verified_scope,
            "planner_allocation_fingerprint": str(
                result.get("planner_allocation_fingerprint") or ""
            ),
            "execution_allocation_fingerprint": str(
                result.get("execution_allocation_fingerprint") or ""
            ),
            "packet_set_fingerprint": str(
                result.get("packet_set_fingerprint") or ""
            ),
            "target_fingerprint": str(
                target.get("target_fingerprint") or ""
            ),
            "capacity_bounds_fingerprint": str(
                target.get("capacity_bounds_fingerprint") or ""
            ),
            "allocation_immutable": True,
            "capacity_reservation_verified": True,
            "outcome_consumed": True,
            "replay_consumed": True,
            "learning_consumed": True,
            "per_user_verification_passed": True,
            "per_target_verification_passed": True,
            "aggregate_verification_passed": True,
            "ordinary_user_protection_passed": True,
            "baseline_reset_verified": True,
            "ordinary_customer_count": 0,
            "raw_identity_list_stored": False,
            "natural_l8_credit": False,
            "created_at": now_iso(),
        })
    return {
        "receipt_id": str(row.get("receipt_id") or receipt_id),
        "audit_write": True,
        "duplicate_suppressed": False,
    }


def run_bounded_delegated_service_failure_action(
    executor: str,
    *,
    state_dir: Path,
    event_dir: Path,
    policy_file: Path,
    operator_execution_audit_store: Path = DEFAULT_OPERATOR_EXECUTION_AUDIT_STORE,
    service_failure_obligation: Optional[dict[str, Any]] = None,
    timeout_sec: int = 180,
) -> dict[str, Any]:
    """Close the existing event -> planner -> bounded executor consumer link.

    Absence of an active owner-issued standing contract is a normal fail-closed
    terminal.  The executor remains the sole owner of Candidate/Packet/lease,
    restore-barrier, apply, verification and final OPEN transitions.
    """
    policy_root = read_json(policy_file, {})
    contract = (
        policy_root.get("delegated_autonomy_policy")
        if isinstance(policy_root.get("delegated_autonomy_policy"), dict)
        else {}
    )
    if contract.get("status") != "ACTIVE":
        return {
            "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
            "status": "INACTIVE_NO_STANDING_POLICY",
            "ok": True,
            "action_attempted": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }
    policy = contract.get("policy") if isinstance(contract.get("policy"), dict) else {}
    per_action_law = (
        contract.get("per_action_law")
        if isinstance(contract.get("per_action_law"), dict)
        else {}
    )
    blast_radius = (
        policy.get("max_blast_radius")
        if isinstance(policy.get("max_blast_radius"), dict)
        else {}
    )
    try:
        policy_max_users = int(policy.get("max_users_per_action") or 0)
        law_max_users = int(per_action_law.get("max_users") or 0)
        blast_max_users = int(blast_radius.get("users") or 0)
        policy_concurrency = int(policy.get("max_concurrent_transactions") or 0)
        law_concurrency = int(per_action_law.get("max_concurrent_transactions") or 0)
        expires_at = datetime.fromisoformat(str(contract.get("expires_at") or "").replace("Z", "+00:00"))
        if expires_at.tzinfo is None:
            expires_at = expires_at.replace(tzinfo=timezone.utc)
    except (TypeError, ValueError):
        policy_max_users = law_max_users = blast_max_users = 0
        policy_concurrency = law_concurrency = 0
        expires_at = datetime.min.replace(tzinfo=timezone.utc)
    allowed_action_classes = [
        str(item)
        for item in (policy.get("allowed_action_classes") or [])
        if str(item)
    ]
    exact_limit_valid = (
        bool(str(contract.get("contract_id") or ""))
        and bool(str(contract.get("contract_hash") or ""))
        and expires_at > datetime.now(timezone.utc)
        and str(policy.get("policy_state") or "") == "APPROVED"
        and bool_value(policy.get("runtime_apply_enabled"))
        and not bool_value(policy.get("self_expansion_allowed"))
        and bool(allowed_action_classes)
        and policy_max_users > 0
        and policy_max_users == law_max_users == blast_max_users
        and policy_concurrency == law_concurrency == 1
    )
    if not exact_limit_valid:
        return {
            "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
            "status": "STOP_SAFE_INVALID_STANDING_POLICY_SCOPE",
            "ok": True,
            "action_attempted": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "blockers": ["standing_policy_transaction_limit_not_exactly_owner_backed"],
            "contract_id": str(contract.get("contract_id") or ""),
        }
    obligation = (
        service_failure_obligation
        if isinstance(service_failure_obligation, dict)
        else {}
    )
    source_scope = (
        obligation.get("current_source_scope")
        if isinstance(obligation.get("current_source_scope"), dict)
        else {}
    )
    source = str(obligation.get("channel") or "")
    incident_id = str(obligation.get("source_incident_id") or "")
    obligation_id = str(obligation.get("automation_obligation_id") or "")
    scope_fingerprint = str(source_scope.get("affected_scope_fingerprint") or "")
    affected_scope = int(source_scope.get("affected_scope_count") or 0)
    unresolved_scope = int(source_scope.get("unresolved_scope_count") or 0)
    recommendation_users = int(obligation.get("bounded_recommendation_users") or 0)
    classification = str(obligation.get("stop_safe_classification") or "")
    obligation_identity_valid = (
        str(obligation.get("object_type") or "") == "service_failure_automation_obligation"
        and str(obligation.get("closure_state") or "") == "READY_FOR_OMP_CONSUMPTION"
        and bool(source and incident_id and obligation_id and scope_fingerprint)
    )
    if not obligation_identity_valid:
        return {
            "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
            "status": "STOP_SAFE_NO_CURRENT_SERVICE_FAILURE_OBLIGATION",
            "ok": True,
            "action_attempted": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "blockers": ["exact_current_service_failure_obligation_missing_or_invalid"],
            "contract_id": str(contract.get("contract_id") or ""),
        }
    if affected_scope <= 0 or unresolved_scope <= 0:
        return {
            "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
            "status": "STOP_SAFE_CURRENT_SOURCE_SCOPE_EMPTY",
            "ok": True,
            "action_attempted": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "source": source,
            "source_incident_id": incident_id,
            "automation_obligation_id": obligation_id,
            "affected_scope": affected_scope,
            "unresolved_scope": unresolved_scope,
            "contract_id": str(contract.get("contract_id") or ""),
            "contract_hash": str(contract.get("contract_hash") or ""),
            "admitted_max_users": policy_max_users,
            "max_concurrent_transactions": policy_concurrency,
        }
    target_selection_diagnostic = read_controlled_target_selection_diagnostic(
        state_dir=state_dir,
        policy_file=policy_file,
        audit_store=operator_execution_audit_store,
    )
    campaign_binding = controlled_certification_matrix_binding(
        audit_store=operator_execution_audit_store,
        source=source,
        target_selection_diagnostic=target_selection_diagnostic,
    )
    ordinary_incident_actionable = (
        classification == "STOP_SAFE_FRESH_EVENT_REVALIDATION_REQUIRED"
        and recommendation_users > 0
    )
    controlled_campaign_actionable = bool(
        campaign_binding.get("active")
        and classification == "STOP_SAFE_FRESH_EVENT_REVALIDATION_REQUIRED"
        and unresolved_scope
        >= int(campaign_binding.get("next_stage") or 0)
    )
    if not (ordinary_incident_actionable or controlled_campaign_actionable):
        return {
            "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
            "status": "STOP_SAFE_CURRENT_INCIDENT_NOT_ACTIONABLE",
            "ok": True,
            "action_attempted": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "source": source,
            "source_incident_id": incident_id,
            "automation_obligation_id": obligation_id,
            "classification": classification,
            "bounded_recommendation_users": recommendation_users,
            "blockers": [
                "current_incident_has_no_owner_backed_actionable_recommendation"
            ],
            "contract_id": str(contract.get("contract_id") or ""),
            "controlled_certification_campaign": campaign_binding,
        }
    if campaign_binding.get("completed"):
        return {
            "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
            "status": "CONTROLLED_CERTIFICATION_CAMPAIGN_COMPLETE",
            "ok": True,
            "action_attempted": False,
            "action_completed": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "source": source,
            "source_incident_id": incident_id,
            "automation_obligation_id": obligation_id,
            "controlled_certification_campaign": campaign_binding,
            "durable_successor": (
                "V7_SERVICE_FAILURE_T48_M10_AUTHORITY_AND_RUNTIME_"
                "RECOMMENDATION_RECONCILIATION"
            ),
        }
    requested_max_users = (
        int(campaign_binding.get("next_stage") or 0)
        if campaign_binding.get("active")
        else policy_max_users
    )
    command = [
        executor,
        "--execute-bounded-delegated-transaction",
        "--state-dir", str(state_dir),
        "--event-dir", str(event_dir),
        "--policy-file", str(policy_file),
        "--max-users", str(requested_max_users),
        "--expected-standing-policy-contract-id", str(contract.get("contract_id") or ""),
        "--expected-standing-policy-contract-hash", str(contract.get("contract_hash") or ""),
        "--expected-service-failure-obligation-id", obligation_id,
        "--expected-service-failure-incident-id", incident_id,
        "--expected-service-failure-scope-fingerprint", scope_fingerprint,
        "--approved-source", source,
        "--compact-transaction-receipt",
        "--pretty",
    ]
    if campaign_binding.get("active"):
        command.extend([
            "--controlled-certification-campaign-request-id",
            str(campaign_binding.get("request_id") or ""),
            "--controlled-certification-campaign-request-hash",
            str(campaign_binding.get("request_hash") or ""),
            "--controlled-certification-campaign-stage",
            str(campaign_binding.get("next_stage") or 0),
        ])
    started_at = now_iso()
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(30, min(int(timeout_sec or 180), 600)),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
            "status": "FAILED",
            "ok": False,
            "started_at": started_at,
            "completed_at": now_iso(),
            "command": command,
            "error": f"{type(exc).__name__}:{exc}",
            "action_attempted": True,
        }
    try:
        parsed = json.loads(proc.stdout or "")
    except json.JSONDecodeError:
        parsed = {}
    verdict = str(parsed.get("final_verdict") or "")
    transaction_status = str(parsed.get("transaction_status") or "")
    completed = proc.returncode == 0 and verdict in {
        "GOVERNED_TRANSACTION_COMPLETED",
        "L3_PRODUCTION_PROVEN",
    }
    stop_safe = (
        (
            verdict == "STOP_SAFE"
            or (
                verdict == "GOVERNED_TRANSACTION_STOPPED"
                and transaction_status == "STOP_SAFE"
            )
        )
        and not bool(parsed.get("apply_executed"))
        and int(parsed.get("users_moved") or 0) == 0
    )
    return {
        "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
        "status": "ACTION_COMPLETED" if completed else ("STOP_SAFE" if stop_safe else "FAILED"),
        "ok": completed or stop_safe,
        "started_at": started_at,
        "completed_at": now_iso(),
        "command": command,
        "returncode": proc.returncode,
        "consumer_result": parsed,
        "action_attempted": True,
        "action_completed": completed,
        "runtime_mutation_performed": bool(parsed.get("runtime_mutation_performed") or parsed.get("apply_executed")),
        "users_moved": int(parsed.get("users_moved") or 0),
        "contract_id": str(contract.get("contract_id") or ""),
        "contract_hash": str(contract.get("contract_hash") or ""),
        "admitted_max_users": policy_max_users,
        "requested_max_users": requested_max_users,
        "max_concurrent_transactions": policy_concurrency,
        "source": source,
        "source_incident_id": incident_id,
        "automation_obligation_id": obligation_id,
        "controlled_certification_campaign": campaign_binding,
        "controlled_certification_stage_consumption": {},
        "output_tail": (proc.stdout or "")[-2000:] if not (completed or stop_safe) else "",
    }


def run_ct_m0f_standing_validation_campaign(
    executor: str,
    planner: str,
    *,
    state_dir: Path,
    event_dir: Path,
    policy_file: Path,
    audit_store: Path,
    timeout_sec: int = 600,
    max_successive_samples: int = 8,
) -> dict[str, Any]:
    """Consume the bounded CT-M0F standing policy through existing owners.

    Matrix remains only the wake/consumer.  Candidate, Packet, lease, cutover,
    reset and evidence are produced by their existing governed owners.
    """
    policy_root = read_json(policy_file, {})
    contract = (
        policy_root.get(
            operator_execution.CT_M0F_STANDING_VALIDATION_POLICY_KEY, {}
        )
        if isinstance(policy_root, dict)
        else {}
    )
    records = operator_execution.read_audit_records(audit_store)
    validation = operator_execution.validate_ct_m0f_standing_validation_policy(
        contract, audit_records=records,
    )
    if not validation.get("ok"):
        return {
            "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
            "status": "INACTIVE_NO_VALID_STANDING_CT_M0F_POLICY",
            "ok": True,
            "blockers": validation.get("errors") or [],
            "action_attempted": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }

    contract_id = str(contract.get("contract_id") or "")
    contract_hash = str(contract.get("contract_hash") or "")
    steps: list[dict[str, Any]] = []

    def active_reservations() -> list[dict[str, Any]]:
        current = operator_execution.read_audit_records(audit_store)
        terminal_ids = {
            str(row.get("reservation_id") or "")
            for row in current
            if row.get("record_type")
            == operator_execution.CT_M0F_STANDING_VALIDATION_SAMPLE_TERMINAL_RECORD_TYPE
        }
        return [
            row for row in current
            if row.get("record_type")
            == operator_execution.CT_M0F_STANDING_VALIDATION_SAMPLE_RESERVATION_RECORD_TYPE
            and str(row.get("contract_id") or "") == contract_id
            and str(row.get("reservation_id") or "") not in terminal_ids
        ]

    def invoke(command: list[str], timeout: int) -> tuple[int, dict[str, Any], str]:
        try:
            proc = subprocess.run(
                command,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=timeout,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            return 2, {}, f"{type(exc).__name__}:{exc}"
        try:
            parsed = json.loads(proc.stdout or "{}")
        except json.JSONDecodeError:
            parsed = {}
        return proc.returncode, parsed if isinstance(parsed, dict) else {}, (proc.stdout or "")[-2000:]

    def close_active_sample(
        active: list[dict[str, Any]],
    ) -> Optional[dict[str, Any]]:
        if len(active) > 1:
            return {
                "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
                "status": "STOP_SAFE_DUPLICATE_ACTIVE_SAMPLE_RESERVATIONS",
                "ok": False,
                "steps": steps,
                "active_reservation_ids": [
                    str(row.get("reservation_id") or "") for row in active
                ],
                "runtime_mutation_performed": any(
                    bool(row.get("runtime_mutation_performed")) for row in steps
                ),
                "users_moved": 0,
            }
        if not active:
            return None
        reservation_id = str(active[0].get("reservation_id") or "")
        reset_command = [
            executor,
            "--reset-ct-m0f-standing-validation-sample",
            "--ct-m0f-standing-validation-reservation-id", reservation_id,
            "--state-dir", str(state_dir),
            "--event-dir", str(event_dir),
            "--policy-file", str(policy_file),
            "--audit-dir", str(audit_store.parent),
            "--operator-execution-audit-store", str(audit_store),
            "--pretty",
        ]
        rc, reset, output = invoke(
            reset_command, max(60, min(timeout_sec, 900))
        )
        steps.append({
            "kind": "RESET_AND_SAMPLE_CLOSURE",
            "reservation_id": reservation_id,
            "returncode": rc,
            "result": reset,
            "output_tail": "" if reset else output,
            "runtime_mutation_performed": bool(
                reset.get("runtime_mutation_performed")
            ),
        })
        if rc != 0 or str(reset.get("final_verdict") or "") not in {
            "CT_M0F_STANDING_SAMPLE_ALREADY_CLOSED",
            "CT_M0F_STANDING_SAMPLE_RESET_AND_CLOSED",
            "CT_M0F_STANDING_SAMPLE_SAFELY_RECONCILED_INVALID",
        }:
            return {
                "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
                "status": "STOP_SAFE_SAMPLE_RESET_OR_CLOSURE_FAILED",
                "ok": False,
                "steps": steps,
                "runtime_mutation_performed": any(
                    bool(row.get("runtime_mutation_performed")) for row in steps
                ),
                "users_moved": 0,
            }
        budget = reset.get("budget") if isinstance(reset.get("budget"), dict) else {}
        if budget.get("campaign_complete"):
            return {
                "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
                "status": "CT_M0F_OPERATIONAL_SLO_CONSUMED",
                "ok": True,
                "steps": steps,
                "budget": budget,
                "action_completed": True,
                "runtime_mutation_performed": any(
                    bool(row.get("runtime_mutation_performed")) for row in steps
                ),
                "users_moved": 0,
            }
        if (
            budget.get("attempt_budget_exhausted")
            or budget.get("valid_sample_budget_exhausted")
        ):
            return {
                "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
                "status": "CT_M0F_VALIDATION_ATTEMPT_BUDGET_EXHAUSTED_ENGINEERING_RESIDUAL_REQUIRED",
                "ok": True,
                "steps": steps,
                "budget": budget,
                "action_completed": True,
                "runtime_mutation_performed": any(
                    bool(row.get("runtime_mutation_performed")) for row in steps
                ),
                "users_moved": 0,
            }
        return {
            "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
            "status": "CT_M0F_SAMPLE_CLOSED_NEXT_ORDINARY_MATRIX_GENERATION_REQUIRED",
            "ok": True,
            "steps": steps,
            "budget": budget,
            "action_completed": True,
            "runtime_mutation_performed": any(
                bool(row.get("runtime_mutation_performed")) for row in steps
            ),
            "users_moved": 0,
            "durable_successor": "NEXT_ORDINARY_MATRIX_GENERATION_PREPARES_FRESH_SAMPLE",
        }

    active_result = close_active_sample(active_reservations())
    if active_result is not None:
        return active_result

    source_command = [
        planner,
        "--ct-m0f-standing-source-selection",
        "--state-dir", str(state_dir),
        "--policy-file", str(policy_file),
        "--action-class-audit-store", str(audit_store),
    ]
    source_rc, source_selection, source_output = invoke(source_command, 180)
    selected_source = str(source_selection.get("selected_source_id") or "")
    selected_user = str(source_selection.get("selected_user") or "")
    selected_target = str(source_selection.get("selected_target_id") or "")
    selection_mode = str(source_selection.get("selection_mode") or "")
    sample_binding_fingerprint = str(
        source_selection.get("sample_binding_fingerprint") or ""
    )
    if (
        source_rc not in {0, 2}
        or source_selection.get("ok") is not True
        or not selected_source
        or not selected_user
        or not selected_target
        or len(sample_binding_fingerprint) != 64
    ):
        return {
            "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
            "status": "STOP_SAFE_CONTROLLED_SOURCE_PREDECESSOR_REQUIRED",
            "ok": bool(
                source_rc in {0, 2}
                and not source_selection.get("runtime_mutation_performed")
            ),
            "source_selection": source_selection,
            "output_tail": "" if source_selection else source_output,
            "blockers": list(source_selection.get("blockers") or [
                "ct_m0f_standing_controlled_source_selection_unavailable"
            ]),
            "action_attempted": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }

    if selection_mode == "PREPARE_CONTROLLED_FAILURE_CONDITION":
        prepare_command = [
            executor,
            "--prepare-ct-m0f-standing-controlled-condition",
            "--ct-m0f-standing-validation-contract-id", contract_id,
            "--ct-m0f-standing-validation-contract-hash", contract_hash,
            "--state-dir", str(state_dir),
            "--event-dir", str(event_dir),
            "--policy-file", str(policy_file),
            "--audit-dir", str(audit_store.parent),
            "--operator-execution-audit-store", str(audit_store),
            "--approved-source", selected_source,
            "--ct-m0f-standing-validation-user", selected_user,
            "--ct-m0f-standing-validation-target", selected_target,
            "--ct-m0f-standing-sample-binding-fingerprint",
            sample_binding_fingerprint,
            "--max-users", "1",
            "--pretty",
        ]
        rc, prepared, output = invoke(
            prepare_command, max(120, min(timeout_sec, 900))
        )
        passed = bool(
            rc == 0
            and prepared.get("final_verdict")
            == "CT_M0F_STANDING_CONTROLLED_CONDITION_PREPARED"
        )
        return {
            "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
            "status": (
                "CT_M0F_CONTROLLED_CONDITION_PREPARED_WAITING_FRESH_MATRIX_GENERATION"
                if passed
                else "STOP_SAFE_CONTROLLED_CONDITION_PREPARATION_FAILED"
            ),
            "ok": passed,
            "source_selection": source_selection,
            "preparation": prepared,
            "output_tail": "" if prepared else output,
            "action_attempted": True,
            "runtime_mutation_performed": bool(
                prepared.get("runtime_mutation_performed")
            ),
            "users_moved": int(prepared.get("users_moved") or 0),
            "durable_successor": (
                "NEXT_ORDINARY_MATRIX_GENERATION_DETECTS_CONTROLLED_FAILURE"
                if passed
                else "EXACT_EXISTING_OWNER_RECONCILIATION_REQUIRED"
            ),
        }

    if selection_mode != "EXECUTE_CONTROLLED_FAILURE_CUTOVER":
        return {
            "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
            "status": "STOP_SAFE_CONTROLLED_FAILURE_NOT_READY",
            "ok": True,
            "source_selection": source_selection,
            "action_attempted": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }

    for _ in range(max(1, int(max_successive_samples))):
        active_result = close_active_sample(active_reservations())
        if active_result is not None:
            return active_result

        execute_command = [
            executor,
            "--execute-l3-production-validation",
            "--confirm-l3-production-validation",
            "EXECUTE_L3_PRODUCTION_VALIDATION_APPROVED",
            "--ct-m0f-kernel-cutover-validation",
            "--ct-m0f-standing-validation",
            "--ct-m0f-standing-validation-contract-id", contract_id,
            "--ct-m0f-standing-validation-contract-hash", contract_hash,
            "--state-dir", str(state_dir),
            "--event-dir", str(event_dir),
            "--policy-file", str(policy_file),
            "--audit-dir", str(audit_store.parent),
            "--operator-execution-audit-store", str(audit_store),
            "--approved-source", selected_source,
            "--ct-m0f-standing-validation-user", selected_user,
            "--ct-m0f-standing-validation-target", selected_target,
            "--ct-m0f-standing-sample-binding-fingerprint",
            sample_binding_fingerprint,
            "--max-users", "1",
            "--pretty",
        ]
        rc, result, output = invoke(
            execute_command, max(120, min(timeout_sec, 900))
        )
        reservation = (
            (result.get("ct_m0f_admission_consumption") or {}).get("reservation")
            if isinstance(result.get("ct_m0f_admission_consumption"), dict)
            else {}
        )
        steps.append({
            "kind": "FRESH_SAMPLE_EXECUTION",
            "returncode": rc,
            "reservation_id": str((reservation or {}).get("reservation_id") or ""),
            "final_verdict": str(result.get("final_verdict") or ""),
            "stop_reason": str(result.get("stop_reason") or ""),
            "result": result,
            "output_tail": "" if result else output,
            "runtime_mutation_performed": bool(
                result.get("runtime_mutation_performed")
            ),
        })
        # A reserved sample must always flow through the durable reset/closure
        # successor, even if the child returned STOP_SAFE after its write.
        if reservation:
            continue
        return {
            "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
            "status": "STOP_SAFE_NO_SAMPLE_ADMITTED",
            "ok": bool(
                rc in {0, 2}
                and not result.get("runtime_mutation_performed")
                and int(result.get("users_moved") or 0) == 0
            ),
            "blockers": [
                str(result.get("stop_reason") or result.get("final_verdict") or "sample_not_admitted")
            ],
            "steps": steps,
            "action_completed": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }

    return {
        "schema_version": "v7.ct-m0f-standing-validation-matrix-consumer.v1",
        "status": "CT_M0F_BOUNDED_SUCCESSOR_LIMIT_REACHED",
        "ok": True,
        "steps": steps,
        "action_completed": bool(steps),
        "runtime_mutation_performed": any(
            bool(row.get("runtime_mutation_performed")) for row in steps
        ),
        "users_moved": 0,
    }


def service_failure_obligation_from_advisory(
    advisory_result: Any,
) -> dict[str, Any]:
    """Return only a well-formed current obligation from an advisory result."""
    if not isinstance(advisory_result, dict):
        return {}
    advisory_payload = advisory_result.get("result")
    if not isinstance(advisory_payload, dict):
        return {}
    obligation = advisory_payload.get("obligation")
    return obligation if isinstance(obligation, dict) else {}


def run_controlled_certification_campaign_reset(
    executor: str,
    *,
    state_dir: Path,
    event_dir: Path,
    policy_file: Path,
    audit_store: Path,
    binding: dict[str, Any],
    timeout_sec: int = 600,
) -> dict[str, Any]:
    """Invoke the existing governed owner for the exact approved stage reset."""
    if not binding.get("active"):
        return {
            "schema_version": "v7.controlled-certification-campaign-reset-consumer.v1",
            "status": "NOT_REQUIRED",
            "ok": True,
            "action_attempted": False,
            "users_moved": 0,
        }
    command = [
        executor,
        "--reset-controlled-certification-campaign-stage",
        "--confirm-controlled-certification-campaign-reset",
        "RESET_APPROVED_CONTROLLED_CERTIFICATION_CAMPAIGN_STAGE",
        "--state-dir",
        str(state_dir),
        "--event-dir",
        str(event_dir),
        "--policy-file",
        str(policy_file),
        "--operator-execution-audit-store",
        str(audit_store),
        "--controlled-certification-campaign-request-id",
        str(binding.get("request_id") or ""),
        "--controlled-certification-campaign-request-hash",
        str(binding.get("request_hash") or ""),
        "--controlled-certification-campaign-stage",
        str(binding.get("next_stage") or 0),
    ]
    started_at = now_iso()
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(60, min(int(timeout_sec or 600), 1800)),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.controlled-certification-campaign-reset-consumer.v1",
            "status": "FAILED",
            "ok": False,
            "started_at": started_at,
            "completed_at": now_iso(),
            "command": command,
            "error": f"{type(exc).__name__}:{exc}",
            "action_attempted": True,
            "users_moved": 0,
        }
    try:
        parsed = json.loads(proc.stdout or "")
    except json.JSONDecodeError:
        parsed = {}
    passed = (
        proc.returncode == 0
        and parsed.get("final_verdict")
        == "CONTROLLED_CERTIFICATION_CAMPAIGN_STAGE_RESET_COMPLETE"
        and int(parsed.get("target_user_count_after", -1)) == 0
        and int(parsed.get("ordinary_customer_count") or 0) == 0
    )
    return {
        "schema_version": "v7.controlled-certification-campaign-reset-consumer.v1",
        "status": "RESET_COMPLETE" if passed else "STOP_SAFE",
        "ok": passed,
        "started_at": started_at,
        "completed_at": now_iso(),
        "command": command,
        "returncode": proc.returncode,
        "consumer_result": parsed,
        "action_attempted": True,
        "users_moved": int(parsed.get("users_moved") or 0),
        "runtime_mutation_performed": bool(
            parsed.get("runtime_mutation_performed")
        ),
        "authority_expanded": bool(parsed.get("authority_expanded")),
        "output_tail": (proc.stdout or "")[-2000:] if not passed else "",
    }


def _run_controlled_topology_standing_policy_action_once(
    planner: str,
    executor: str,
    *,
    state_dir: Path,
    event_dir: Path,
    policy_file: Path,
    audit_store: Path,
    timeout_sec: int = 360,
) -> dict[str, Any]:
    """Consume one auto-admitted topology manifest through existing owners."""
    planner_command = [
        planner,
        "--controlled-source-topology-diagnostic",
        "--state-dir",
        str(state_dir),
        "--policy-file",
        str(policy_file),
        "--action-class-audit-store",
        str(audit_store),
    ]
    started_at = now_iso()
    try:
        planner_proc = subprocess.run(
            planner_command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=180,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.controlled-topology-standing-consumer.v1",
            "status": "STOP_SAFE",
            "ok": True,
            "started_at": started_at,
            "completed_at": now_iso(),
            "action_attempted": False,
            "action_completed": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "blockers": [
                f"controlled_topology_planner_unavailable:{type(exc).__name__}"
            ],
        }
    try:
        parsed = json.loads(planner_proc.stdout or "")
        diagnostic = parsed if isinstance(parsed, dict) else {}
    except json.JSONDecodeError:
        diagnostic = {}
    preflight = (
        diagnostic.get("production_preflight")
        if isinstance(diagnostic.get("production_preflight"), dict)
        else {}
    )
    manifest = (
        preflight.get("manifest")
        if isinstance(preflight.get("manifest"), dict)
        else {}
    )
    admission = (
        diagnostic.get("standing_policy_admission")
        if isinstance(diagnostic.get("standing_policy_admission"), dict)
        else {}
    )
    ready = (
        planner_proc.returncode == 0
        and diagnostic.get("status")
        == "CONTROLLED_SOURCE_TOPOLOGY_PRODUCTION_PREFLIGHT_READY"
        and admission.get("status")
        == "AUTO_ADMITTED_BY_STANDING_DELEGATED_CONTROLLED_TOPOLOGY_POLICY"
        and admission.get("ok") is True
        and int(manifest.get("trial_identity_count") or 0) == 1
        and str(manifest.get("expected_ordinary_assignment_delta") or "")
        == "NONE"
        and str(manifest.get("expected_ordinary_route_delta") or "") == "NONE"
    )
    if not ready:
        return {
            "schema_version": "v7.controlled-topology-standing-consumer.v1",
            "status": "NOT_REQUIRED_OR_NOT_ADMITTED",
            "ok": True,
            "started_at": started_at,
            "completed_at": now_iso(),
            "action_attempted": False,
            "action_completed": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "diagnostic_status": str(diagnostic.get("status") or ""),
            "blockers": list(admission.get("blockers") or []),
        }
    command = [
        executor,
        "--execute-controlled-topology-standing-transaction",
        "--state-dir",
        str(state_dir),
        "--event-dir",
        str(event_dir),
        "--policy-file",
        str(policy_file),
        "--operator-execution-audit-store",
        str(audit_store),
        "--expected-standing-policy-contract-id",
        str(admission.get("contract_id") or ""),
        "--expected-standing-policy-contract-hash",
        str(admission.get("contract_hash") or ""),
        "--expected-controlled-topology-manifest-hash",
        str(manifest.get("manifest_hash") or ""),
        "--controlled-topology-user",
        str(manifest.get("trial_identity") or ""),
        "--controlled-topology-source",
        str(manifest.get("existing_source") or ""),
        "--controlled-topology-target",
        str(manifest.get("selected_source_or_draft") or ""),
        "--controlled-topology-planner",
        planner,
        "--max-users",
        "1",
        "--compact-transaction-receipt",
        "--pretty",
    ]
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(60, min(int(timeout_sec or 360), 900)),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.controlled-topology-standing-consumer.v1",
            "status": "FAILED",
            "ok": False,
            "started_at": started_at,
            "completed_at": now_iso(),
            "action_attempted": True,
            "action_completed": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "error": f"{type(exc).__name__}:{exc}",
        }
    try:
        parsed = json.loads(proc.stdout or "")
        result = parsed if isinstance(parsed, dict) else {}
    except json.JSONDecodeError:
        result = {}
    completed = (
        proc.returncode == 0
        and result.get("controlled_topology_final_verdict")
        == "ONE_IDENTITY_AUTONOMOUS_CONTROLLED_TOPOLOGY_TRIAL_PROVEN"
        and int(result.get("users_moved") or 0) == 1
    )
    stopped = (
        not completed
        and not bool(result.get("apply_executed"))
        and int(result.get("users_moved") or 0) == 0
    )
    return {
        "schema_version": "v7.controlled-topology-standing-consumer.v1",
        "status": (
            "ACTION_COMPLETED"
            if completed
            else ("STOP_SAFE" if stopped else "FAILED")
        ),
        "ok": completed or stopped,
        "started_at": started_at,
        "completed_at": now_iso(),
        "returncode": proc.returncode,
        "action_attempted": True,
        "action_completed": completed,
        "runtime_mutation_performed": bool(
            result.get("runtime_mutation_performed")
            or result.get("apply_executed")
        ),
        "reservation_mutation_performed": bool(
            result.get("reservation_mutation_performed")
        ),
        "reservation_released_after_stop": bool(
            result.get("reservation_released_after_stop")
        ),
        "stop_reason": str(result.get("stop_reason") or ""),
        "blockers": list(result.get("blockers") or []),
        "users_moved": int(result.get("users_moved") or 0),
        "contract_id": str(admission.get("contract_id") or ""),
        "contract_hash": str(admission.get("contract_hash") or ""),
        "manifest_hash": str(manifest.get("manifest_hash") or ""),
        "trial_identity": str(manifest.get("trial_identity") or ""),
        "source": str(manifest.get("existing_source") or ""),
        "target": str(manifest.get("selected_source_or_draft") or ""),
        "consumer_result": result,
        "output_tail": (proc.stdout or "")[-2000:] if not (completed or stopped) else "",
    }


def run_controlled_topology_standing_policy_action(
    planner: str,
    executor: str,
    *,
    state_dir: Path,
    event_dir: Path,
    policy_file: Path,
    audit_store: Path,
    timeout_sec: int = 360,
    max_successive_rebindings: int = 1,
) -> dict[str, Any]:
    """Consume serial same-campaign topology successors through Matrix.

    The fixed upper bound is the approved certification-pool size.  Every
    iteration re-runs the existing Planner and creates a fresh Packet/lease;
    the first safe stop ends the loop.
    """
    limit = max(1, min(int(max_successive_rebindings or 1), 48))
    attempts: list[dict[str, Any]] = []
    completed: list[dict[str, Any]] = []
    seen_users: set[str] = set()
    for _ in range(limit):
        current = _run_controlled_topology_standing_policy_action_once(
            planner,
            executor,
            state_dir=state_dir,
            event_dir=event_dir,
            policy_file=policy_file,
            audit_store=audit_store,
            timeout_sec=timeout_sec,
        )
        attempts.append(current)
        if not current.get("action_completed"):
            break
        user = str(current.get("trial_identity") or "")
        if not user or user in seen_users:
            current.update({
                "status": "STOP_SAFE",
                "ok": True,
                "action_completed": False,
                "blockers": [
                    "controlled_topology_successor_identity_repeated"
                ],
            })
            break
        seen_users.add(user)
        completed.append(current)
    if len(attempts) == 1:
        return attempts[0]
    successor = (
        attempts[-1]
        if attempts and not attempts[-1].get("action_completed")
        else {}
    )
    return {
        "schema_version": (
            "v7.controlled-topology-standing-successor-loop.v1"
        ),
        "status": (
            "ACTION_COMPLETED"
            if completed
            else str(attempts[-1].get("status") or "STOP_SAFE")
        ),
        "ok": all(row.get("ok") is True for row in attempts),
        "started_at": str(attempts[0].get("started_at") or ""),
        "completed_at": now_iso(),
        "action_attempted": any(
            row.get("action_attempted") for row in attempts
        ),
        "action_completed": bool(completed),
        "runtime_mutation_performed": any(
            row.get("runtime_mutation_performed") for row in attempts
        ),
        "reservation_mutation_performed": any(
            row.get("reservation_mutation_performed") for row in attempts
        ),
        "users_moved": sum(
            int(row.get("users_moved") or 0) for row in completed
        ),
        "completed_rebindings": [
            {
                "trial_identity": str(row.get("trial_identity") or ""),
                "source": str(row.get("source") or ""),
                "target": str(row.get("target") or ""),
                "manifest_hash": str(row.get("manifest_hash") or ""),
            }
            for row in completed
        ],
        "successor_probe": {
            key: successor.get(key)
            for key in (
                "status", "ok", "stop_reason", "blockers",
                "diagnostic_status",
            )
            if successor.get(key) not in (None, "", [], {})
        },
        "authority_expanded": False,
        "production_maturity_change": False,
        "natural_l8_credit": False,
    }


def _run_availability_first_standing_policy_stage_once(
    planner: str,
    executor: str,
    *,
    state_dir: Path,
    event_dir: Path,
    policy_file: Path,
    audit_store: Path,
    timeout_sec: int = 1800,
) -> dict[str, Any]:
    """Consume the current auto-admitted ladder stage through Matrix."""
    planner_command = [
        planner,
        "--controlled-source-topology-diagnostic",
        "--state-dir",
        str(state_dir),
        "--policy-file",
        str(policy_file),
        "--action-class-audit-store",
        str(audit_store),
    ]
    started_at = now_iso()
    try:
        planner_proc = subprocess.run(
            planner_command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=180,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.availability-first-matrix-consumer.v1",
            "status": "STOP_SAFE",
            "ok": True,
            "action_attempted": False,
            "action_completed": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "blockers": [
                f"availability_first_planner_unavailable:{type(exc).__name__}"
            ],
        }
    try:
        parsed = json.loads(planner_proc.stdout or "")
        diagnostic = parsed if isinstance(parsed, dict) else {}
    except json.JSONDecodeError:
        diagnostic = {}
    admission = (
        diagnostic.get("availability_first_standing_policy_admission")
        if isinstance(
            diagnostic.get("availability_first_standing_policy_admission"),
            dict,
        )
        else {}
    )
    projection = (
        diagnostic.get("shared_production_target_capacity_projection")
        if isinstance(
            diagnostic.get("shared_production_target_capacity_projection"),
            dict,
        )
        else {}
    )
    campaign = (
        projection.get("availability_campaign")
        if isinstance(projection.get("availability_campaign"), dict)
        else {}
    )
    completed_campaign_stages = {
        int(value)
        for value in (campaign.get("completed_stages") or [])
        if str(value).strip().isdigit()
    }
    # ``current_stage`` is the canonical projection published by the shared
    # target-capacity owner.  ``availability_campaign`` is retained as the
    # append-only campaign history/progress view and may briefly describe the
    # just-consumed predecessor.  Never let that historical nested view make
    # Matrix dispatch a stale stage after the canonical successor advanced.
    campaign_stage = int(
        projection.get("current_stage")
        or campaign.get("next_stage")
        or 0
    )
    stage_allocation = (
        (projection.get("stage_allocations") or {}).get(
            str(campaign_stage),
            {},
        )
        if isinstance(projection.get("stage_allocations"), dict)
        else {}
    )
    target_growth_trial = (
        projection.get("target_growth_trial")
        if isinstance(projection.get("target_growth_trial"), dict)
        else {}
    )
    target_bound_mode = bool(
        not stage_allocation.get("feasible")
        and target_growth_trial.get("status") == "TARGET_BOUND_TRIAL_READY"
        and target_growth_trial.get("feasible") is True
    )
    stage = int(
        target_growth_trial.get("trial_scope")
        if target_bound_mode
        else campaign_stage
        or 0
    )
    allocation = target_growth_trial if target_bound_mode else stage_allocation
    ready = bool(
        planner_proc.returncode == 0
        and admission.get("ok") is True
        and stage in operator_execution.AVAILABILITY_FIRST_LADDER
        and allocation.get("feasible") is True
        and allocation.get("allocation_fingerprint")
        and (
            target_bound_mode
            or diagnostic.get("status")
            == "CONTROLLED_TOPOLOGY_AVAILABILITY_FIRST_AUTO_ADMITTED"
        )
    )
    prior_summary = read_json(
        state_dir / "service-matrix-refresh-summary.json",
        {},
    )
    def prior_projection_stream():
        if isinstance(prior_summary, dict):
            yield prior_summary
        for path in sorted(
            event_dir.glob("service-matrix-refresh-*.jsonl"),
            reverse=True,
        )[:RECENT_MATRIX_EVENT_FILE_LIMIT]:
            yield from reversed(
                intelligence_workers.read_jsonl_tail(
                    path,
                    limit=RECENT_MATRIX_EVENT_ROW_LIMIT,
                    max_bytes=RECENT_MATRIX_EVENT_BYTE_LIMIT,
                )
            )
    try:
        current_user_rows = [
            parse_kv_line(line)
            for line in (
                state_dir / "users.registry"
            ).read_text(
                encoding="utf-8",
                errors="replace",
            ).splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        ]
    except OSError:
        current_user_rows = []
    current_routes = {
        str(row.get("ip") or ""): str(row.get("current") or "")
        for row in current_user_rows
        if row.get("ip")
    }
    prior_availability: dict[str, Any] = {}
    prior_result: dict[str, Any] = {}
    partial_apply_pending = False
    for prior_projection in prior_projection_stream():
        candidate = (
            prior_projection.get(
                "availability_first_standing_policy_action"
            )
            if isinstance(
                prior_projection.get(
                    "availability_first_standing_policy_action"
                ),
                dict,
            )
            else {}
        )
        candidate_result = (
            candidate.get("consumer_result")
            if isinstance(candidate.get("consumer_result"), dict)
            else {}
        )
        # A completion receipt is immutable campaign truth.  A historical
        # partial-reset row for that already consumed stage must never
        # override the canonical successor (for example Stage-10 -> Stage-25)
        # on every later Matrix cycle.  An incomplete current stage remains
        # eligible for the existing partial-recovery path below.
        candidate_stage = int(
            candidate_result.get("campaign_stage")
            or candidate_result.get("stage")
            or candidate.get("campaign_stage")
            or candidate.get("stage")
            or 0
        )
        if candidate_stage in completed_campaign_stages:
            continue
        candidate_packets = [
            row
            for row in (candidate_result.get("packet_set") or [])
            if isinstance(row, dict)
        ]
        circuit_breaker = (
            candidate_result.get("circuit_breaker")
            if isinstance(
                candidate_result.get("circuit_breaker"),
                dict,
            )
            else {}
        )
        for candidate_packet in candidate_packets:
            candidate_user = str(candidate_packet.get("user") or "")
            partial_or_cleanup_pending = bool(
                str(candidate_packet.get("stop_reason") or "")
                == "l3_production_validation_downstream_proof_failed"
                or (
                    str(candidate_packet.get("final_verdict") or "")
                    == "L3_PRODUCTION_PROVEN"
                    and str(candidate_packet.get("verification_result") or "")
                    == "PASS"
                    and int(candidate_packet.get("users_moved") or 0) == 1
                    and str(circuit_breaker.get("reason") or "")
                    == "availability_first_baseline_reset_failed"
                )
            )
            if (
                candidate.get("status") == "STOP_SAFE"
                and partial_or_cleanup_pending
                and candidate_user
                and current_routes.get(candidate_user)
                == str(candidate_packet.get("target") or "")
            ):
                prior_availability = candidate
                prior_result = candidate_result
                partial_apply_pending = True
                break
        if partial_apply_pending:
            break
    if partial_apply_pending:
        stage = int(
            prior_result.get("stage")
            or prior_availability.get("stage")
            or stage
            or 0
        )
    if not ready and not partial_apply_pending:
        return {
            "schema_version": "v7.availability-first-matrix-consumer.v1",
            "status": (
                "CAMPAIGN_COMPLETE"
                if campaign.get("completed")
                else "NOT_REQUIRED_OR_NOT_ADMITTED"
            ),
            "ok": True,
            "started_at": started_at,
            "completed_at": now_iso(),
            "action_attempted": False,
            "action_completed": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "stage": stage,
            "diagnostic_status": str(diagnostic.get("status") or ""),
            "blockers": sorted(set(
                list(admission.get("blockers") or [])
                + list(campaign.get("blockers") or [])
            )),
        }
    performance_gate_receipt = current_performance_closure_receipt(
        audit_store,
        revalidation_generation=PERFORMANCE_REVALIDATION_GENERATION,
    )
    performance_benchmark = bool(
        stage == 48 and not performance_gate_receipt
    )
    # The immutable performance receipt is an existing-owner prerequisite for
    # the Stage-48 action class.  It must not create a second, implicit
    # Authority boundary after the current active standing contract has
    # already admitted the exact action class, scope and serial envelope.
    # ``ready`` above is deliberately the only admission path: it validates
    # the live standing-policy contract, the fresh Planner projection and the
    # bounded allocation before the executor can materialize anything.
    #
    # Previously this branch returned a durable-looking terminal without
    # dispatching the already-approved stage.  That stranded the existing
    # Matrix consumer in a self-created wait and contradicted an active
    # max-48 contract.  The performance receipt now enables the ordinary
    # existing executor path; it grants nothing and does not widen scope.
    command = [
        executor,
        (
            "--execute-performance-closure-benchmark"
            if performance_benchmark
            else "--execute-availability-first-standing-stage"
        ),
        "--state-dir",
        str(state_dir),
        "--event-dir",
        str(event_dir),
        "--policy-file",
        str(policy_file),
        "--operator-execution-audit-store",
        str(audit_store),
        "--controlled-topology-planner",
        planner,
        "--pretty",
    ]
    if not performance_benchmark:
        command[2:2] = ["--availability-first-stage", str(stage)]
    if target_bound_mode:
        command.extend([
            "--availability-first-target-bound-trial-target",
            str(target_growth_trial.get("target_id") or ""),
        ])
    # Do not bind the executor to the wrapper's earlier live-snapshot
    # fingerprint.  Matrix/quality owners may publish a newer generation
    # between these two processes, producing an endless safe-stop TOCTOU loop.
    # The executor independently re-runs admission and materializes one fresh
    # immutable allocation immediately before Candidate/Packet creation; every
    # selected target is then revalidated by the existing live gates.
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(
                300,
                min(
                    max(int(timeout_sec or 1800), stage * 360),
                    21600,
                ),
            ),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.availability-first-matrix-consumer.v1",
            "status": "FAILED",
            "ok": False,
            "started_at": started_at,
            "completed_at": now_iso(),
            "action_attempted": True,
            "action_completed": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
            "stage": stage,
            "error": f"{type(exc).__name__}:{exc}",
        }
    try:
        parsed = json.loads(proc.stdout or "")
        result = parsed if isinstance(parsed, dict) else {}
    except json.JSONDecodeError:
        result = {}
    expected_verdict = (
        "GOVERNED_PERFORMANCE_CLOSURE_BENCHMARK_COMPLETED"
        if performance_benchmark
        else "AVAILABILITY_FIRST_TARGET_BOUND_TRIAL_COMPLETED"
        if target_bound_mode
        else "AVAILABILITY_FIRST_STANDING_STAGE_COMPLETED"
    )
    completed = (
        proc.returncode == 0
        and result.get("final_verdict") == expected_verdict
        and (
            int(result.get("stage") or 0) == 1
            if performance_benchmark
            else int(result.get("stage") or 0) == stage
        )
    )
    receipt = (
        (
            record_performance_closure_consumption(
                audit_store=audit_store,
                result=result,
            )
            if performance_benchmark
            else record_availability_first_target_bound_consumption(
                audit_store=audit_store,
                result=result,
            )
            if target_bound_mode
            else record_availability_first_stage_consumption(
                audit_store=audit_store,
                result=result,
            )
        )
        if completed
        else {
            "receipt_id": "",
            "audit_write": False,
            "duplicate_suppressed": False,
            "blockers": ["availability_first_stage_not_complete"],
        }
    )
    completed = completed and bool(
        receipt.get("receipt_id")
        and (
            receipt.get("audit_write")
            or receipt.get("duplicate_suppressed")
        )
    )
    stopped = (
        not completed
        and str(result.get("transaction_status") or "") == "STOP_SAFE"
    )
    return {
        "schema_version": "v7.availability-first-matrix-consumer.v1",
        "status": (
            "ACTION_COMPLETED"
            if completed
            else ("STOP_SAFE" if stopped else "FAILED")
        ),
        "ok": completed or stopped,
        "started_at": started_at,
        "completed_at": now_iso(),
        "returncode": proc.returncode,
        "action_attempted": True,
        "action_completed": completed,
        "runtime_mutation_performed": bool(
            result.get("runtime_mutation_performed")
        ),
        "users_moved": int(result.get("users_moved") or 0),
        "stage": stage,
        "performance_benchmark": performance_benchmark,
        "performance_gate_receipt_id": str(
            performance_gate_receipt.get("receipt_id") or ""
        ),
        "stage_48_optimized_runtime_ready": bool(
            stage == 48 and performance_gate_receipt
        ),
        "stage_48_execution_permitted": bool(
            stage == 48
            and performance_gate_receipt
            and ready
            and not performance_benchmark
        ),
        "completion_kind": (
            "PERFORMANCE_BENCHMARK_NO_STAGE_CREDIT"
            if performance_benchmark
            else "TARGET_BOUND_TRIAL"
            if target_bound_mode
            else "CAMPAIGN_STAGE"
        ),
        "target_bound_trial_target": str(
            target_growth_trial.get("target_id") or ""
        ) if target_bound_mode else "",
        "allocation_fingerprint": str(
            allocation.get("allocation_fingerprint") or ""
        ),
        "stage_consumption": receipt,
        "consumer_result": result,
        "durable_successor": (
            "EXISTING_MATRIX_RECOMPUTE_AVAILABILITY_FIRST_NEXT_STAGE"
            if completed
            else str(result.get("durable_successor") or "")
        ),
        "output_tail": (
            (proc.stdout or "")[-2000:]
            if not (completed or stopped)
            else ""
        ),
    }


def run_availability_first_standing_policy_stage(
    planner: str,
    executor: str,
    *,
    state_dir: Path,
    event_dir: Path,
    policy_file: Path,
    audit_store: Path,
    timeout_sec: int = 1800,
    max_successive_stages: int = 1,
) -> dict[str, Any]:
    """Consume bounded fresh ladder successors inside one Matrix generation.

    Every iteration re-enters the existing Planner and executor from durable
    receipt truth.  It does not reuse an allocation, Candidate, Packet or
    lease.  The bound is the fixed ladder length and serial execution remains
    one transaction at a time.  A first non-complete successor stops the loop.
    """
    limit = max(
        1,
        min(
            int(max_successive_stages or 1),
            len(operator_execution.AVAILABILITY_FIRST_LADDER),
        ),
    )
    attempts: list[dict[str, Any]] = []
    completed_stages: list[int] = []
    completed_successors: list[dict[str, Any]] = []
    seen_successors: set[tuple[str, int, str]] = set()
    for _ in range(limit):
        current = _run_availability_first_standing_policy_stage_once(
            planner,
            executor,
            state_dir=state_dir,
            event_dir=event_dir,
            policy_file=policy_file,
            audit_store=audit_store,
            timeout_sec=timeout_sec,
        )
        attempts.append(current)
        if not current.get("action_completed"):
            break
        stage = int(current.get("stage") or 0)
        completion_kind = str(
            current.get("completion_kind") or "CAMPAIGN_STAGE"
        )
        target_id = str(
            current.get("target_bound_trial_target") or ""
        )
        successor_identity = (completion_kind, stage, target_id)
        if (
            stage not in operator_execution.AVAILABILITY_FIRST_LADDER
            or successor_identity in seen_successors
        ):
            current.update({
                "status": "STOP_SAFE",
                "ok": True,
                "action_completed": bool(completed_stages),
                "durable_successor": (
                    "EXISTING_MATRIX_RECONCILE_DUPLICATE_STAGE_SUCCESSOR"
                ),
                "blockers": ["availability_first_stage_successor_repeated"],
            })
            break
        seen_successors.add(successor_identity)
        completed_stages.append(stage)
        completed_successors.append({
            "completion_kind": completion_kind,
            "scope": stage,
            "target_id": target_id,
            "receipt_id": str(
                (current.get("stage_consumption") or {}).get(
                    "receipt_id"
                )
                or ""
            ),
        })
    if len(attempts) == 1:
        return attempts[0]

    completed_attempts = [
        row for row in attempts if row.get("action_completed")
    ]
    last_completed = (
        completed_attempts[-1] if completed_attempts else {}
    )
    successor_probe = (
        attempts[-1]
        if attempts and not attempts[-1].get("action_completed")
        else {}
    )
    return {
        "schema_version": (
            "v7.availability-first-matrix-successor-loop.v1"
        ),
        "status": (
            "ACTION_COMPLETED"
            if completed_attempts
            else str(attempts[-1].get("status") or "STOP_SAFE")
        ),
        "ok": all(row.get("ok") is True for row in attempts),
        "started_at": str(attempts[0].get("started_at") or ""),
        "completed_at": now_iso(),
        "action_attempted": any(
            row.get("action_attempted") for row in attempts
        ),
        "action_completed": bool(completed_attempts),
        "runtime_mutation_performed": any(
            row.get("runtime_mutation_performed") for row in attempts
        ),
        "users_moved": sum(
            int(row.get("users_moved") or 0) for row in attempts
        ),
        "stage": int(last_completed.get("stage") or 0),
        "stage_consumption": last_completed.get("stage_consumption") or {},
        "consumer_result": last_completed.get("consumer_result") or {},
        "completed_stages_this_invocation": completed_stages,
        "completed_successors_this_invocation": completed_successors,
        "successor_probe": {
            key: successor_probe.get(key)
            for key in (
                "status", "ok", "stage", "diagnostic_status",
                "blockers", "durable_successor",
            )
            if successor_probe.get(key) not in (None, "", [], {})
        },
        "durable_successor": (
            str(successor_probe.get("durable_successor") or "")
            if successor_probe
            else "EXISTING_MATRIX_RECOMPUTE_AVAILABILITY_FIRST_NEXT_STAGE"
        ),
        "authority_expanded": False,
        "production_maturity_change": False,
        "natural_l8_credit": False,
    }


def run_passive_consumer(
    consumer: str,
    *,
    state_dir: Path,
    event_dir: Path,
    timeout_sec: int = 30,
) -> dict[str, Any]:
    """Consume passive events through the existing owner without runtime action."""
    command = [
        consumer,
        "--consume-passive-events-only",
        "--state-dir",
        str(state_dir),
        "--event-dir",
        str(event_dir),
    ]
    started_at = now_iso()
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(5, min(int(timeout_sec or 30), 120)),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.passive-consumer-liveness.v1",
            "status": "FAILED",
            "ok": False,
            "started_at": started_at,
            "completed_at": now_iso(),
            "command": command,
            "error": f"{type(exc).__name__}:{exc}",
            "omp_repair_frontier": {
                "frontier_id": "V7_PASSIVE_SERVICE_EVENT_CONSUMER_REPAIR",
                "last_responsible_producer": "tools/v7-service-matrix-refresh-all",
                "missing_consumer": "tools/v7-users-autoswitch --consume-passive-events-only",
                "exact_missing_artifact": "passive consumer terminal",
                "forbidden_effects": "NONE",
            },
        }
    parsed: dict[str, Any] = {}
    try:
        value = json.loads(proc.stdout or "")
        parsed = value if isinstance(value, dict) else {}
    except json.JSONDecodeError:
        parsed = {}
    ok = proc.returncode == 0 and parsed.get("status") == "PASS"
    result = {
        "schema_version": "v7.passive-consumer-liveness.v1",
        "status": "PASS" if ok else "FAILED",
        "ok": ok,
        "started_at": started_at,
        "completed_at": now_iso(),
        "command": command,
        "returncode": proc.returncode,
        "consumer_result": parsed,
    }
    if not ok:
        result["output_tail"] = (proc.stdout or "")[-2000:]
        result["omp_repair_frontier"] = {
            "frontier_id": "V7_PASSIVE_SERVICE_EVENT_CONSUMER_REPAIR",
            "last_responsible_producer": "tools/v7-service-matrix-refresh-all",
            "missing_consumer": "tools/v7-users-autoswitch --consume-passive-events-only",
            "exact_missing_artifact": "passive consumer terminal",
            "forbidden_effects": "NONE",
        }
    return result


def run_one(egress_id: str, timeout: int, checker: str, state_dir: Path) -> dict[str, Any]:
    started = time.time()
    cmd = [checker, egress_id, "all", "--timeout", str(timeout), "--state-dir", str(state_dir)]
    env = dict(os.environ)
    env["V7_SERVICE_MATRIX_LOCK_HELD"] = "1"
    try:
        proc = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False, timeout=timeout * 14, env=env)
    except subprocess.TimeoutExpired as exc:
        return {
            "egress": egress_id,
            "status": "TIMEOUT",
            "ok": False,
            "elapsed_sec": round(time.time() - started, 3),
            "output_tail": str(exc.stdout or "")[-2000:],
            "cmd": cmd,
        }
    output = proc.stdout or ""
    parsed: dict[str, Any] = {}
    try:
        parsed = json.loads(output)
    except json.JSONDecodeError:
        parsed = {}
    status = str(parsed.get("status") or ("OK" if proc.returncode == 0 else "FAIL"))
    ok = proc.returncode == 0 and status in ("OK", "WARN")
    return {
        "egress": egress_id,
        "status": status,
        "ok": ok,
        "rc": proc.returncode,
        "ok_count": parsed.get("ok_count", 0),
        "total": parsed.get("total", 0),
        "elapsed_sec": round(time.time() - started, 3),
        "output_tail": output[-2000:],
        "cmd": cmd,
    }


def run_service_failure_automation_advisory(
    consumer: str,
    *,
    state_dir: Path,
    event_dir: Path,
    timeout_sec: int = 45,
) -> dict[str, Any]:
    """Invoke the existing autoswitch owner in bounded advisory-only mode."""
    command = [
        consumer,
        "--consume-service-failure-automation-only",
        "--state-dir",
        str(state_dir),
        "--event-dir",
        str(event_dir),
    ]
    started_at = now_iso()
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(5, min(int(timeout_sec or 45), 120)),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.service-failure-automation-advisory-liveness.v1",
            "status": "FAILED",
            "ok": False,
            "started_at": started_at,
            "error": str(exc),
            "command": command,
        }
    output = proc.stdout or ""
    try:
        parsed = json.loads(output)
    except json.JSONDecodeError:
        parsed = {}
    return {
        "schema_version": "v7.service-failure-automation-advisory-liveness.v1",
        "status": "PASS" if proc.returncode == 0 and isinstance(parsed, dict) and parsed.get("ok") else "FAILED",
        "ok": proc.returncode == 0 and isinstance(parsed, dict) and parsed.get("ok") is True,
        "started_at": started_at,
        "completed_at": now_iso(),
        "command": command,
        "returncode": proc.returncode,
        "consumer_result": parsed,
        "output_tail": output[-2000:],
    }


def run_service_failure_omp_consumer(*, timeout_sec: int = 45) -> dict[str, Any]:
    """Consume the already-materialized obligation through the standard OMP entrypoint.

    Production deploys the evidence owner but deliberately not the source CPS
    corpus.  This narrow existing-owner command persists the consumption
    receipt in production; the canonical source CPS is reconciled only from
    that owner-backed receipt by its source owner.
    """
    command = ["v7-truth-check", "--consume-service-failure-automation-only", "--json"]
    started_at = now_iso()
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(10, min(int(timeout_sec or 45), 180)),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.service-failure-omp-consumer-liveness.v1",
            "status": "FAILED", "ok": False, "started_at": started_at,
            "error": str(exc), "command": command,
        }
    output = proc.stdout or ""
    try:
        parsed = json.loads(output)
    except json.JSONDecodeError:
        parsed = {}
    passed = (
        proc.returncode == 0
        and isinstance(parsed, dict)
        and parsed.get("final_verdict") in {
            "PASS",
            "BOUNDED_CONTINUATION",
            "NO_PENDING_OBLIGATION",
        }
    )
    return {
        "schema_version": "v7.service-failure-omp-consumer-liveness.v1",
        "status": "PASS" if passed else "FAILED",
        "ok": passed,
        "started_at": started_at,
        "completed_at": now_iso(),
        "command": command,
        "returncode": proc.returncode,
        "consumer_result": parsed,
        "output_tail": output[-2000:],
    }


def _consumer_projection(payload: Any) -> dict[str, Any]:
    """Keep a lifecycle receipt compact while leaving full truth with its owner.

    Matrix refresh is an observation/wake producer, not an outcome registry.
    Its child consumers already persist their complete facts in the existing
    event, execution and closure owners.  Re-embedding whole child responses
    here caused each periodic refresh to grow the next refresh's input.
    """
    value = payload if isinstance(payload, dict) else {}
    result = value.get("consumer_result")
    result = result if isinstance(result, dict) else {}
    compact_result = {
        key: result.get(key)
        for key in (
            "final_verdict", "status", "next_output", "legal_terminal",
            "receipt_id", "obligation_id", "frontier_id", "packet_id",
            "feedback_id", "outcome_id", "transaction_status", "stop_reason",
            "blockers", "stage", "baseline_reset_verified",
            "target_bound_trial", "target_bound_trial_target",
            "campaign_next_stage", "completion_kind",
            "outcome_consumed", "replay_consumed", "learning_consumed",
            "durable_successor",
        )
        if result.get(key) not in (None, "", [], {})
    }
    prepared = result.get("prepared_class_decisions") or value.get("prepared_class_decisions")
    if isinstance(prepared, dict) and prepared:
        compact_result["prepared_class_decisions"] = prepared
    prepared_freshness = result.get("prepared_class_decision_freshness") or value.get("prepared_class_decision_freshness")
    if isinstance(prepared_freshness, dict) and prepared_freshness:
        compact_result["prepared_class_decision_freshness"] = prepared_freshness
    bounded_closure = result.get("bounded_closure_reconciliation") or value.get("bounded_closure_reconciliation")
    if isinstance(bounded_closure, dict) and bounded_closure:
        compact_result["bounded_closure_reconciliation"] = bounded_closure
    for key in (
        "performance_benchmark",
        "campaign_stage_credit",
        "stage_48_optimized_runtime_ready",
        "stage_48_execution_permitted",
    ):
        if key in result:
            compact_result[key] = result.get(key)
    if result.get("performance_benchmark") is True:
        compact_result["cohort_execution_timings"] = [
            row
            for row in (result.get("cohort_execution_timings") or [])
            if isinstance(row, dict)
        ]
        compact_result["performance_timeline"] = [
            row
            for row in (result.get("performance_timeline") or [])
            if isinstance(row, dict)
        ]
    # A target-bound trial has a verified scope (often 5 or 10) but is not a
    # campaign-stage receipt for that number.  Retain both identities in the
    # compact Matrix projection so transient runtime work cannot be mistaken
    # for a duplicate of an already consumed campaign stage.
    if result.get("performance_benchmark") is True:
        compact_result["execution_scope_kind"] = (
            "PERFORMANCE_BENCHMARK_NO_STAGE_CREDIT"
        )
        compact_result["benchmark_scope"] = int(
            result.get("stage") or 0
        )
        compact_result["campaign_stage"] = 0
    elif result.get("target_bound_trial") is True:
        compact_result["execution_scope_kind"] = "TARGET_BOUND_TRIAL"
        compact_result["trial_scope"] = int(result.get("stage") or 0)
        compact_result["campaign_stage"] = int(
            result.get("campaign_next_stage") or 0
        )
    elif result.get("stage") not in (None, "", 0):
        compact_result["execution_scope_kind"] = "CAMPAIGN_STAGE"
        compact_result["campaign_stage"] = int(result.get("stage") or 0)
    # Availability-first stages may stop inside one governed subset after the
    # outer stage has already passed admission.  Preserve the bounded terminal
    # and circuit-breaker reason so the next Matrix/OMP consumer can identify
    # the exact failed gate without replaying a production action.  The full
    # cycle and diagnostics remain with their existing specialized owners.
    circuit_breaker = result.get("circuit_breaker")
    circuit_breaker = (
        circuit_breaker if isinstance(circuit_breaker, dict) else {}
    )
    compact_circuit_breaker = {
        key: circuit_breaker.get(key)
        for key in (
            "tripped", "remaining_subsets_stopped", "reason",
        )
        if circuit_breaker.get(key) not in (None, "", [], {})
    }
    if compact_circuit_breaker:
        compact_result["circuit_breaker"] = compact_circuit_breaker
    packet_set = result.get("packet_set")
    packet_set = packet_set if isinstance(packet_set, list) else []
    compact_packet_set = [
        {
            key: row.get(key)
            for key in (
                "final_verdict", "transaction_status", "stop_reason",
                "fresh_packet_id", "decision_id", "operation_id",
                "user", "users", "source", "target", "target_id",
                "users_moved", "runtime_mutation_performed",
                "verification_result", "rollback_result",
                "feedback_id", "outcome_id", "learning_record_id",
            )
            if row.get(key) not in (None, "", [], {})
        }
        for row in packet_set
        if isinstance(row, dict)
    ]
    for compact_packet, packet in zip(compact_packet_set, packet_set):
        downstream = packet.get("downstream_proof_diagnostic")
        if isinstance(downstream, dict) and downstream:
            compact_packet["downstream_proof_diagnostic"] = {
                key: downstream.get(key)
                for key in (
                    "apply_command_ok", "apply_returncode",
                    "apply_timed_out", "child_final_verdict",
                    "child_transaction_status", "child_stop_reason",
                    "child_stop_detail", "proof_blockers",
                    "capability_production_proven",
                )
                if downstream.get(key) not in (None, "", [], {})
                or key in {"apply_command_ok", "apply_timed_out"}
            }
    compact_packet_set = [row for row in compact_packet_set if row]
    if compact_packet_set:
        compact_result["packet_set"] = compact_packet_set
    partial = result.get("partial_apply_recovery")
    partial = partial if isinstance(partial, dict) else {}
    compact_partial = {
        key: partial.get(key)
        for key in (
            "pending", "ok", "blockers", "stage", "user", "source",
            "target", "packet_id", "operation_id", "projection_source",
            "recovery_mode", "cohort_packet_count",
            "cohort_projection_exact", "performance_benchmark",
            "campaign_stage_credit",
        )
        if partial.get(key) not in (None, "", [], {})
    }
    if compact_partial:
        compact_result["partial_apply_recovery"] = compact_partial
    reset = result.get("reset_transaction")
    reset = reset if isinstance(reset, dict) else {}
    compact_reset = {
        key: reset.get(key)
        for key in (
            "final_verdict", "transaction_status", "stop_reason", "stop_detail",
            "fresh_packet_id", "operation_id", "user", "source", "target",
            "runtime_mutation_performed", "verification_result",
            "rollback_result", "users_moved",
        )
        if reset.get(key) not in (None, "", [], {})
    }
    if compact_reset:
        compact_result["reset_transaction"] = compact_reset
        reset_diagnostic = reset.get("packet_preparation_diagnostic")
        if isinstance(reset_diagnostic, dict):
            compact_result["reset_transaction"][
                "packet_preparation_diagnostic"
            ] = {
                key: reset_diagnostic.get(key)
                for key in (
                    "cycle_stop_reason", "cycle_stop_detail",
                    "candidate_user", "candidate_source",
                    "candidate_target", "packet_preview_status",
                    "packet_binding_blockers", "safety_hard_stop",
                    "safety_blockers",
                )
                if reset_diagnostic.get(key) not in (None, "", [], {})
            }
    reset_rows = [
        row for row in (result.get("reset_transactions") or [])
        if isinstance(row, dict)
    ]
    compact_reset_rows = [
        {
            key: row.get(key)
            for key in (
                "final_verdict", "transaction_status", "stop_reason",
                "stop_detail", "fresh_packet_id", "operation_id", "user",
                "source", "target", "runtime_mutation_performed",
                "verification_result", "rollback_result", "users_moved",
            )
            if row.get(key) not in (None, "", [], {})
        }
        for row in reset_rows
    ]
    compact_reset_rows = [row for row in compact_reset_rows if row]
    if compact_reset_rows:
        compact_result["reset_transactions"] = compact_reset_rows
    reset_reconciliations = [
        row for row in (result.get("baseline_reset_reconciliations") or [])
        if isinstance(row, dict)
    ]
    if reset_reconciliations:
        compact_result["baseline_reset_reconciliations"] = [
            {
                key: row.get(key)
                for key in (
                    "ok", "mode", "current_egress", "packet_id",
                    "operation_id", "switch_lineage", "natural_l8_credit",
                    "production_outcome_credit",
                )
                if row.get(key) not in (None, "", [], {})
            }
            for row in reset_reconciliations
        ]
    reset_reconciliation = result.get("baseline_reset_reconciliation")
    reset_reconciliation = (
        reset_reconciliation
        if isinstance(reset_reconciliation, dict)
        else {}
    )
    compact_reset_reconciliation = {
        key: reset_reconciliation.get(key)
        for key in (
            "ok", "mode", "current_egress", "packet_id", "operation_id",
            "switch_lineage", "natural_l8_credit",
            "production_outcome_credit",
        )
        if reset_reconciliation.get(key) not in (None, "", [], {})
    }
    if compact_reset_reconciliation:
        compact_result["baseline_reset_reconciliation"] = (
            compact_reset_reconciliation
        )
    timeline = [
        row for row in (result.get("performance_timeline") or [])
        if isinstance(row, dict)
    ]
    compact_timeline = [
        {
            key: row.get(key)
            for key in (
                "phase", "owner", "status", "member_id", "packet_id",
                "operation_id", "completed_at", "started_offset_us",
                "duration_us",
            )
            if row.get(key) not in (None, "", [], {})
        }
        for row in timeline[-256:]
    ]
    if compact_timeline:
        compact_result["performance_timeline"] = compact_timeline
        compact_result["performance_timeline_truncated"] = (
            len(timeline) > len(compact_timeline)
        )
    if result.get("stage_total_duration_us") not in (None, ""):
        compact_result["stage_total_duration_us"] = int(
            result.get("stage_total_duration_us") or 0
        )
    if result.get("serial_baseline_reset_count") not in (None, ""):
        compact_result["serial_baseline_reset_count"] = int(
            result.get("serial_baseline_reset_count") or 0
        )
    if result.get("allocation_lineage_refresh_count") not in (None, ""):
        compact_result["allocation_lineage_refresh_count"] = int(
            result.get("allocation_lineage_refresh_count") or 0
        )
    reset_reconciliations = [
        {
            key: row.get(key)
            for key in (
                "ok", "mode", "current_egress", "packet_id",
                "operation_id", "switch_lineage",
                "natural_l8_credit", "production_outcome_credit",
            )
            if row.get(key) not in (None, "", [], {})
        }
        for row in (result.get("baseline_reset_reconciliations") or [])
        if isinstance(row, dict)
    ]
    reset_reconciliations = [
        row for row in reset_reconciliations if row
    ]
    if reset_reconciliations:
        compact_result["baseline_reset_reconciliations"] = (
            reset_reconciliations
        )
    # A governed executor keeps the full Outcome with the execution owner,
    # but its bounded receipt deliberately nests this one immutable pointer.
    # Preserve the pointer (not the nested payload) so the Matrix lifecycle
    # can prove which existing post-action consumer owns the next step.
    feedback = result.get("feedback_materialization")
    feedback = feedback if isinstance(feedback, dict) else {}
    for key in ("feedback_id", "outcome_id", "learning_record_id"):
        if feedback.get(key) not in (None, "", [], {}):
            compact_result.setdefault(key, feedback.get(key))
    causal = result.get("service_failure_causal_binding")
    causal = causal if isinstance(causal, dict) else {}
    compact_causal = {
        key: causal.get(key)
        for key in (
            "automation_obligation_id", "omp_consumption_id",
            "source_incident_id", "source_event_id", "observation_generation",
            "source_channel", "event_type", "event_provenance",
        )
        if causal.get(key) not in (None, "", [], {})
    }
    projected = {
        key: value.get(key)
        for key in (
            "schema_version", "status", "ok", "started_at", "completed_at",
            "returncode", "action_attempted", "action_completed",
            "runtime_mutation_performed", "users_moved", "reason", "error",
            "reservation_mutation_performed",
            "reservation_released_after_stop", "stop_reason",
            "contract_id", "contract_hash", "admitted_max_users",
            "max_concurrent_transactions", "blockers", "source",
            "target", "trial_identity", "manifest_hash",
            "stage", "diagnostic_status", "receipt_id",
            "performance_benchmark", "performance_gate_receipt_id",
            "completion_kind", "stage_48_optimized_runtime_ready",
            "stage_48_execution_permitted", "campaign_stage_credit",
            "durable_successor", "completed_stages_this_invocation",
            "source_incident_id", "automation_obligation_id",
            "affected_scope", "unresolved_scope",
        )
        if value.get(key) not in (None, "", [], {})
    } | ({"consumer_result": compact_result} if compact_result else {})
    stage_consumption = value.get("stage_consumption")
    stage_consumption = (
        stage_consumption
        if isinstance(stage_consumption, dict)
        else {}
    )
    compact_stage_consumption = {
        key: stage_consumption.get(key)
        for key in (
            "receipt_id", "audit_write", "duplicate_suppressed",
            "blockers",
        )
        if stage_consumption.get(key) not in (None, "", [], {})
    }
    if compact_stage_consumption:
        projected["stage_consumption"] = compact_stage_consumption
    successor_probe = value.get("successor_probe")
    successor_probe = (
        successor_probe if isinstance(successor_probe, dict) else {}
    )
    compact_successor_probe = {
        key: successor_probe.get(key)
        for key in (
            "status", "ok", "stage", "diagnostic_status",
            "blockers", "durable_successor",
        )
        if successor_probe.get(key) not in (None, "", [], {})
    }
    if compact_successor_probe:
        projected["successor_probe"] = compact_successor_probe
    if compact_causal:
        projected["service_failure_causal_binding"] = compact_causal
    return projected


def compact_refresh_projection(payload: dict[str, Any]) -> dict[str, Any]:
    """Project one refresh lifecycle without recursively storing child output.

    Complete decision, packet, execution, verification, replay and Learning
    evidence remains with the existing specialized owners.  This projection
    retains only the Matrix caller/consumer receipt and explicit pointers.
    """
    results = [
        {
            key: row.get(key)
            for key in ("egress", "status", "ok", "rc", "ok_count", "total", "elapsed_sec")
            if row.get(key) not in (None, "", [], {})
        }
        for row in (payload.get("results") or [])
        if isinstance(row, dict)
    ]
    projection = {
        "schema_version": "v7.service-matrix-refresh-lifecycle-projection.v1",
        "updated": payload.get("updated"),
        "elapsed_sec": payload.get("elapsed_sec"),
        "total": payload.get("total"),
        "ok_count": payload.get("ok_count"),
        "status": payload.get("status", "OK"),
        "results": results,
        "passive_failure_capture": payload.get("passive_failure_capture") or {},
        "omp_product_frontiers": list(payload.get("omp_product_frontiers") or ()),
        "omp_product_frontier_owner": payload.get("omp_product_frontier_owner", ""),
        "next_output": payload.get("next_output", ""),
        "evidence_owners": {
            "matrix": "service-matrix.json",
            "passive_events": "service-failure-events.jsonl",
            "execution": "execution-events.jsonl",
            "outcome_and_omp": "closure-records.jsonl",
        },
        "capture_only": True,
        "candidate_or_execution_forbidden": True,
        "full_child_payload_embedded": False,
    }
    for key in (
        "passive_event_consumer", "service_failure_automation_advisory",
        "service_failure_omp_consumer", "service_failure_post_action_passive_consumer",
        "service_failure_post_action_omp_consumer",
        "bounded_delegated_service_failure_action",
        "availability_first_standing_policy_action",
        "controlled_topology_standing_policy_action",
        "ct_m0f_standing_validation_campaign",
    ):
        if key in payload:
            projection[key] = _consumer_projection(payload.get(key))
    return projection


def append_event(event_dir: Path, payload: dict[str, Any]) -> None:
    try:
        event_dir.mkdir(parents=True, exist_ok=True)
        path = event_dir / f"service-matrix-refresh-{datetime.now(timezone.utc).strftime('%Y%m%d')}.jsonl"
        with path.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(compact_refresh_projection(payload), ensure_ascii=False, sort_keys=True) + "\n")
    except OSError:
        pass


def sha256_json(payload: Any) -> str:
    return hashlib.sha256(json.dumps(payload, ensure_ascii=True, sort_keys=True, default=str).encode("utf-8")).hexdigest()


def enabled_users_on_egress(state_dir: Path, egress_id: str) -> list[str]:
    users: list[str] = []
    try:
        lines = (state_dir / "users.registry").read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return users
    for line in lines:
        row = parse_kv_line(line)
        if row.get("current") == egress_id and bool_value(row.get("enabled"), default=True) and row.get("ip"):
            users.append(str(row["ip"]))
    return sorted(set(users))


def latest_history_failure_episode(state_dir: Path, channel: str) -> Optional[dict[str, Any]]:
    """Return the latest persisted failure episode for one canonical channel.

    This deliberately reads the existing egress-history owner.  An operator may
    report a short external outage only after it has recovered; a fresh matrix
    refresh alone would then be unable to prove that real, already-observed
    condition without inventing a new failure.
    """
    path = state_dir / "egress-history.jsonl"
    rows: list[dict[str, Any]] = []
    try:
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines()[-5000:]:
            parsed = json.loads(line)
            if isinstance(parsed, dict) and f"{channel}_code" in parsed:
                rows.append(parsed)
    except (OSError, json.JSONDecodeError):
        return None
    failed_indexes = [
        index for index, row in enumerate(rows)
        if not str(row.get(f"{channel}_code") or "").startswith("2")
    ]
    if not failed_indexes:
        return None
    last = failed_indexes[-1]
    first = last
    while first > 0 and not str(rows[first - 1].get(f"{channel}_code") or "").startswith("2"):
        first -= 1
    recovered_at = ""
    for row in rows[last + 1:]:
        if str(row.get(f"{channel}_code") or "").startswith("2"):
            recovered_at = str(row.get("time") or "")
            break
    episode = rows[first:last + 1]
    return {
        "history_path": str(path.name),
        "observed_at": str(rows[first].get("time") or ""),
        "last_failed_at": str(rows[last].get("time") or ""),
        "recovered_at": recovered_at,
        "failure_count": len(episode),
        "failure_codes": sorted({str(row.get(f"{channel}_code") or "") for row in episode}),
        "history_hash": sha256_json(episode),
    }


def append_passive_failure_capture(
    event_dir: Path,
    *,
    state_dir: Path,
    matrix: dict[str, Any],
    refresh_payload: dict[str, Any],
    provenance: str,
    trigger_reference: str,
    declared_channel: str = "",
) -> list[dict[str, Any]]:
    """Append one source-bound observation record per declared external failure.

    This is deliberately a capture-only projection.  It must never become an
    execution wake, an L7 transaction, or natural-L8 credit on its own.
    """
    if not provenance:
        return []
    if provenance == "OPERATOR_INDUCED":
        # An operator-induced incident is source-bound to the declared canonical
        # channel.  Never reinterpret whichever channel happens to be unhealthy
        # at refresh time as that reported incident.
        channel = str(declared_channel or "")
        registry = parse_registry(state_dir / "egress.registry")
        if not channel or not any(row.get("id") == channel for row in registry):
            return []
        affected_users = enabled_users_on_egress(state_dir, channel)
        episode = latest_history_failure_episode(state_dir, channel)
        if not affected_users or not episode:
            return []
        source_hashes = {
            "egress_history_episode": str(episode["history_hash"]),
            "egress_registry": sha256_json(registry),
            "users_on_source": sha256_json(affected_users),
        }
        identity = {
            "schema_version": "v7.passive-production-failure-capture.v1",
            "channel": channel,
            "provenance": provenance,
            "trigger_reference": trigger_reference,
            "observed_at": episode["observed_at"],
            "source_hashes": source_hashes,
        }
        row = {
            **identity,
            "event_id": "pevt_" + sha256_json(identity)[:24],
            "event_type": "external_channel_unavailability",
            "producer": "tools/v7-service-matrix-refresh-all",
            "source_files": ["egress-history.jsonl", "service-matrix.json", "egress.registry", "users.registry"],
            "affected_users": affected_users,
            "history_episode": episode,
            "capture_matrix_hash": sha256_json(matrix),
            "capture_only": True,
            "execution_forbidden": True,
            "candidate_packet_lease_forbidden": True,
            "natural_production_credit": False,
            "l7_credit": False,
            "synthetic_event": False,
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
        }
        event_dir.mkdir(parents=True, exist_ok=True)
        path = event_dir / "service-failure-events.jsonl"
        existing_ids: set[str] = set()
        try:
            for line in path.read_text(encoding="utf-8", errors="replace").splitlines()[-2000:]:
                parsed = json.loads(line)
                if isinstance(parsed, dict) and parsed.get("event_id"):
                    existing_ids.add(str(parsed["event_id"]))
        except (OSError, json.JSONDecodeError):
            pass
        if row["event_id"] in existing_ids:
            return []
        with path.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")
        return [row]
    items = matrix.get("items") if isinstance(matrix.get("items"), dict) else {}
    rows: list[dict[str, Any]] = []
    for result in refresh_payload.get("results") or []:
        if not isinstance(result, dict) or bool(result.get("ok")):
            continue
        egress_id = str(result.get("egress") or "")
        item = items.get(egress_id) if isinstance(items.get(egress_id), dict) else {}
        services = item.get("services") if isinstance(item.get("services"), dict) else {}
        failed_services = sorted(
            str(name) for name, service in services.items()
            if isinstance(service, dict)
            and (service.get("ok") is False or str(service.get("status") or "").upper() in {"FAIL", "ERROR", "DOWN", "NOT_STARTED"})
        )
        affected_users = enabled_users_on_egress(state_dir, egress_id)
        if not egress_id or not failed_services or not affected_users:
            continue
        source_hashes = {
            "service_matrix": sha256_json(item),
            "egress_registry": sha256_json(parse_registry(state_dir / "egress.registry")),
            "users_on_source": sha256_json(affected_users),
        }
        identity = {
            "schema_version": "v7.passive-production-failure-capture.v1",
            "channel": egress_id,
            "failed_services": failed_services,
            "provenance": provenance,
            "trigger_reference": trigger_reference,
            "source_hashes": source_hashes,
        }
        event_id = "pevt_" + sha256_json(identity)[:24]
        rows.append({
            **identity,
            "event_id": event_id,
            "event_type": "external_channel_unavailability",
            "observed_at": str(item.get("updated") or refresh_payload.get("updated") or now_iso()),
            "producer": "tools/v7-service-matrix-refresh-all",
            "source_files": ["service-matrix.json", "egress.registry", "users.registry"],
            "affected_users": affected_users,
            "capture_only": True,
            "execution_forbidden": True,
            "candidate_packet_lease_forbidden": True,
            "natural_production_credit": False,
            "l7_credit": False,
            "synthetic_event": False,
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
        })
    if not rows:
        return []
    event_dir.mkdir(parents=True, exist_ok=True)
    path = event_dir / "service-failure-events.jsonl"
    existing_ids: set[str] = set()
    try:
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines()[-2000:]:
            parsed = json.loads(line)
            if isinstance(parsed, dict) and parsed.get("event_id"):
                existing_ids.add(str(parsed["event_id"]))
    except (OSError, json.JSONDecodeError):
        pass
    new_rows = [row for row in rows if row["event_id"] not in existing_ids]
    if new_rows:
        with path.open("a", encoding="utf-8") as fh:
            for row in new_rows:
                fh.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")
    return new_rows


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Refresh V7 service matrix for all enabled egress channels.")
    parser.add_argument("--state-dir", default=str(DEFAULT_STATE_DIR))
    parser.add_argument("--event-dir", default=str(DEFAULT_EVENT_DIR))
    parser.add_argument("--summary-file", default="")
    parser.add_argument("--checker", default=default_checker_path())
    parser.add_argument("--passive-consumer", default=default_passive_consumer_path())
    parser.add_argument("--governed-executor", default=default_governed_executor_path())
    parser.add_argument("--policy-file", default=str(DEFAULT_POLICY_FILE))
    parser.add_argument(
        "--operator-execution-audit-store",
        default=str(DEFAULT_OPERATOR_EXECUTION_AUDIT_STORE),
    )
    parser.add_argument("--passive-consumer-timeout-sec", type=int, default=30)
    parser.add_argument("--skip-service-failure-automation-advisory", action="store_true")
    parser.add_argument("--skip-service-failure-omp-consumer", action="store_true")
    parser.add_argument("--skip-bounded-delegated-service-failure-action", action="store_true")
    parser.add_argument(
        "--skip-passive-consumer",
        action="store_true",
        help="Diagnostic/test-only escape hatch; production lifecycle should keep the existing passive consumer connected.",
    )
    parser.add_argument("--timeout", type=int, default=8)
    parser.add_argument("--lock-timeout-sec", type=int, default=DEFAULT_LOCK_WAIT_SECONDS)
    parser.add_argument(
        "--event-provenance",
        choices=("OPERATOR_INDUCED", "OBSERVED_EXTERNAL_UNATTRIBUTED"),
        default="",
        help="Emit a capture-only external-failure event; never grants execution or L7/L8 credit.",
    )
    parser.add_argument("--event-trigger-reference", default="", help="Stable external trigger identity required for OPERATOR_INDUCED capture.")
    parser.add_argument("--event-channel", default="", help="Canonical affected egress id required for OPERATOR_INDUCED capture.")
    parser.add_argument(
        "--lock-acquired-marker",
        default="",
        help="Write an owner-backed marker after this lifecycle invocation acquires the writer lock.",
    )
    parser.add_argument("--pretty", action="store_true")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    started = time.time()
    state_dir = Path(args.state_dir)
    rows = [row for row in parse_registry(state_dir / "egress.registry") if bool_value(row.get("enabled"), default=True)]
    try:
        with service_matrix_writer_lock(state_dir, int(args.lock_timeout_sec)):
            if args.lock_acquired_marker:
                write_json_atomic(Path(args.lock_acquired_marker), {
                    "schema_version": "v7.service-matrix-lock-acquisition.v1",
                    "owner": "tools/v7-service-matrix-refresh-all",
                    "pid": os.getpid(),
                    "acquired_at": now_iso(),
                    "lock_path": str(state_dir / "service-matrix.lock"),
                    "runtime_behavior_changed": False,
                    "users_moved": False,
                })
            results = [run_one(row["id"], max(3, min(int(args.timeout), 30)), args.checker, state_dir) for row in rows]
            payload = {
                "schema_version": 1,
                "updated": now_iso(),
                "elapsed_sec": round(time.time() - started, 3),
                "total": len(results),
                "ok_count": sum(1 for row in results if row.get("ok")),
                "results": results,
                "service_matrix_lock": {
                    "held": True,
                    "scope": "full_refresh_batch",
                    "path": str(state_dir / "service-matrix.lock"),
                    "runtime_behavior_changed": False,
                    "users_moved": False,
                },
            }
    except TimeoutError:
        payload = {
            "schema_version": 1,
            "updated": now_iso(),
            "elapsed_sec": round(time.time() - started, 3),
            "total": len(rows),
            "ok_count": 0,
            "results": [],
            "status": "LOCK_TIMEOUT",
            "ok": False,
            "service_matrix_lock": {
                "held": False,
                "scope": "full_refresh_batch",
                "path": str(state_dir / "service-matrix.lock"),
                "timeout_sec": int(args.lock_timeout_sec),
                "runtime_behavior_changed": False,
                "users_moved": False,
            },
        }
    summary_file = Path(args.summary_file) if args.summary_file else state_dir / "service-matrix-refresh-summary.json"
    if args.event_provenance == "OPERATOR_INDUCED" and not str(args.event_trigger_reference or "").strip():
        print(json.dumps({"error": "operator_induced_event_trigger_reference_required"}, ensure_ascii=False))
        return 2
    if args.event_provenance == "OPERATOR_INDUCED" and not str(args.event_channel or "").strip():
        print(json.dumps({"error": "operator_induced_event_channel_required"}, ensure_ascii=False))
        return 2
    matrix = read_json(state_dir / "service-matrix.json", {})
    capture_rows = append_passive_failure_capture(
        Path(args.event_dir),
        state_dir=state_dir,
        matrix=matrix,
        refresh_payload=payload,
        provenance=str(args.event_provenance or ""),
        trigger_reference=str(args.event_trigger_reference or "").strip(),
        declared_channel=str(args.event_channel or "").strip(),
    )
    payload["passive_failure_capture"] = {
        "emitted_event_ids": [row["event_id"] for row in capture_rows],
        "event_provenance": str(args.event_provenance or ""),
        "capture_only": True,
        "execution_forbidden": True,
        "natural_production_credit": False,
    }
    if args.skip_passive_consumer:
        payload["passive_event_consumer"] = {
            "schema_version": "v7.passive-consumer-liveness.v1",
            "status": "SKIPPED_EXPLICITLY",
            "ok": False,
            "omp_repair_frontier": {
                "frontier_id": "V7_PASSIVE_SERVICE_EVENT_CONSUMER_REPAIR",
                "last_responsible_producer": "tools/v7-service-matrix-refresh-all",
                "missing_consumer": "tools/v7-users-autoswitch --consume-passive-events-only",
                "exact_missing_artifact": "passive consumer terminal",
                "forbidden_effects": "NONE",
            },
        }
    else:
        payload["passive_event_consumer"] = run_passive_consumer(
            str(args.passive_consumer),
            state_dir=state_dir,
            event_dir=Path(args.event_dir),
            timeout_sec=int(args.passive_consumer_timeout_sec),
        )
    consumer_payload = (
        (payload.get("passive_event_consumer") or {}).get("consumer_result") or {}
    )
    consumer_result = (
        consumer_payload.get("result")
        if isinstance(consumer_payload.get("result"), dict)
        else {}
    )
    payload["omp_product_frontiers"] = list(
        consumer_result.get("omp_frontiers") or ()
    )
    if args.skip_service_failure_automation_advisory:
        payload["service_failure_automation_advisory"] = {
            "schema_version": "v7.service-failure-automation-advisory-liveness.v1",
            "status": "SKIPPED_EXPLICITLY",
            "ok": False,
            "reason": "explicit_skip",
        }
    else:
        payload["service_failure_automation_advisory"] = run_service_failure_automation_advisory(
            str(args.passive_consumer),
            state_dir=state_dir,
            event_dir=Path(args.event_dir),
            timeout_sec=int(args.passive_consumer_timeout_sec) + 15,
        )
    advisory_result = (
        (payload.get("service_failure_automation_advisory") or {}).get("consumer_result") or {}
    )
    service_failure_obligation = service_failure_obligation_from_advisory(
        advisory_result
    )
    if args.skip_service_failure_omp_consumer:
        payload["service_failure_omp_consumer"] = {
            "schema_version": "v7.service-failure-omp-consumer-liveness.v1",
            "status": "SKIPPED_EXPLICITLY", "ok": False, "reason": "explicit_skip",
        }
    elif (payload.get("service_failure_automation_advisory") or {}).get("ok") is True:
        payload["service_failure_omp_consumer"] = run_service_failure_omp_consumer(
            timeout_sec=int(args.passive_consumer_timeout_sec) + 30,
        )
    else:
        payload["service_failure_omp_consumer"] = {
            "schema_version": "v7.service-failure-omp-consumer-liveness.v1",
            "status": "NOT_REQUIRED_NO_NEW_OBLIGATION", "ok": True,
        }
    payload["controlled_substrate_standing_policy_consumer"] = (
        consume_auto_admitted_controlled_substrate(
            str(args.governed_executor),
            state_dir=state_dir,
            event_dir=Path(args.event_dir),
            policy_file=Path(args.policy_file),
            audit_store=Path(args.operator_execution_audit_store),
        )
    )
    if args.skip_bounded_delegated_service_failure_action:
        payload["bounded_delegated_service_failure_action"] = {
            "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
            "status": "SKIPPED_EXPLICITLY",
            "ok": False,
            "reason": "explicit_skip",
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }
    else:
        payload["bounded_delegated_service_failure_action"] = run_bounded_delegated_service_failure_action(
            str(args.governed_executor),
            state_dir=state_dir,
            event_dir=Path(args.event_dir),
            policy_file=Path(args.policy_file),
            operator_execution_audit_store=Path(
                args.operator_execution_audit_store
            ),
            service_failure_obligation=service_failure_obligation,
            timeout_sec=int(args.passive_consumer_timeout_sec) + 180,
        )
        bounded_action = payload["bounded_delegated_service_failure_action"]
        availability_fallback_statuses = {
            "STOP_SAFE_CURRENT_INCIDENT_NOT_ACTIONABLE",
            "STOP_SAFE_CURRENT_SOURCE_SCOPE_EMPTY",
            "STOP_SAFE_NO_CURRENT_SERVICE_FAILURE_OBLIGATION",
        }
        if (
            bounded_action.get("status") in availability_fallback_statuses
            and not bounded_action.get("action_completed")
        ):
            payload[
                "availability_first_standing_policy_action"
            ] = run_availability_first_standing_policy_stage(
                str(args.passive_consumer),
                str(args.governed_executor),
                state_dir=state_dir,
                event_dir=Path(args.event_dir),
                policy_file=Path(args.policy_file),
                audit_store=Path(args.operator_execution_audit_store),
                timeout_sec=int(args.passive_consumer_timeout_sec) + 1800,
                max_successive_stages=len(
                    operator_execution.AVAILABILITY_FIRST_LADDER
                ),
            )
            availability_action = payload[
                "availability_first_standing_policy_action"
            ]
        availability_action = (
            payload.get("availability_first_standing_policy_action")
            if isinstance(
                payload.get("availability_first_standing_policy_action"),
                dict,
            )
            else {}
        )
        if (
            bounded_action.get("status") in availability_fallback_statuses
            and not bounded_action.get("action_completed")
            and not availability_action.get("action_completed")
        ):
            payload[
                "controlled_topology_standing_policy_action"
            ] = run_controlled_topology_standing_policy_action(
                str(args.passive_consumer),
                str(args.governed_executor),
                state_dir=state_dir,
                event_dir=Path(args.event_dir),
                policy_file=Path(args.policy_file),
                audit_store=Path(args.operator_execution_audit_store),
                timeout_sec=int(args.passive_consumer_timeout_sec) + 360,
                max_successive_rebindings=48,
            )
        topology_action = (
            payload.get("controlled_topology_standing_policy_action")
            if isinstance(
                payload.get("controlled_topology_standing_policy_action"),
                dict,
            )
            else {}
        )
        if topology_action.get("action_completed"):
            payload[
                "availability_first_pre_topology_action"
            ] = availability_action
            payload[
                "availability_first_standing_policy_action"
            ] = run_availability_first_standing_policy_stage(
                str(args.passive_consumer),
                str(args.governed_executor),
                state_dir=state_dir,
                event_dir=Path(args.event_dir),
                policy_file=Path(args.policy_file),
                audit_store=Path(args.operator_execution_audit_store),
                timeout_sec=int(args.passive_consumer_timeout_sec) + 1800,
                max_successive_stages=len(
                    operator_execution.AVAILABILITY_FIRST_LADDER
                ),
            )
            availability_action = payload[
                "availability_first_standing_policy_action"
            ]
        if not (
            bounded_action.get("action_completed")
            or availability_action.get("action_completed")
            or topology_action.get("action_completed")
        ):
            payload[
                "ct_m0f_standing_validation_campaign"
            ] = run_ct_m0f_standing_validation_campaign(
                str(args.governed_executor),
                str(args.passive_consumer),
                state_dir=state_dir,
                event_dir=Path(args.event_dir),
                policy_file=Path(args.policy_file),
                audit_store=Path(args.operator_execution_audit_store),
                timeout_sec=int(args.passive_consumer_timeout_sec) + 900,
            )
        ct_m0f_action = (
            payload.get("ct_m0f_standing_validation_campaign")
            if isinstance(
                payload.get("ct_m0f_standing_validation_campaign"), dict
            )
            else {}
        )
        any_action_completed = bool(
            bounded_action.get("action_completed")
            or availability_action.get("action_completed")
            or topology_action.get("action_completed")
            or ct_m0f_action.get("action_completed")
        )
        if any_action_completed:
            # The first passive/L3 pass precedes the bounded action.  Its
            # packet-bound Outcome is appended only after that pass, so run
            # the same existing consumer once more before asking OMP to
            # select the successor.  This is reconciliation only: it cannot
            # create a Candidate/Packet/lease or mutate routing.
            payload["service_failure_post_action_passive_consumer"] = run_passive_consumer(
                str(args.passive_consumer),
                state_dir=state_dir,
                event_dir=Path(args.event_dir),
                timeout_sec=int(args.passive_consumer_timeout_sec),
            )
            payload["service_failure_post_action_omp_consumer"] = run_service_failure_omp_consumer(
                timeout_sec=int(args.passive_consumer_timeout_sec) + 30,
            )
            campaign_binding = (
                bounded_action.get(
                    "controlled_certification_campaign"
                )
                if isinstance(
                    bounded_action.get(
                        "controlled_certification_campaign"
                    ),
                    dict,
                )
                else {}
            )
            if campaign_binding.get("active"):
                payload[
                    "controlled_certification_campaign_stage_reset"
                ] = run_controlled_certification_campaign_reset(
                    str(args.governed_executor),
                    state_dir=state_dir,
                    event_dir=Path(args.event_dir),
                    policy_file=Path(args.policy_file),
                    audit_store=Path(
                        args.operator_execution_audit_store
                    ),
                    binding=campaign_binding,
                    timeout_sec=int(
                        args.passive_consumer_timeout_sec
                    ) + 900,
                )
                post_passive_ok = bool(
                    payload[
                        "service_failure_post_action_passive_consumer"
                    ].get("ok")
                )
                post_omp_ok = bool(
                    payload[
                        "service_failure_post_action_omp_consumer"
                    ].get("ok")
                )
                reset_ok = bool(
                    payload[
                        "controlled_certification_campaign_stage_reset"
                    ].get("ok")
                )
                if post_passive_ok and post_omp_ok and reset_ok:
                    stage_consumption = (
                        record_controlled_campaign_stage_consumption(
                            audit_store=Path(
                                args.operator_execution_audit_store
                            ),
                            binding=campaign_binding,
                            result=bounded_action.get("consumer_result") or {},
                            reset_result=payload[
                                "controlled_certification_campaign_stage_reset"
                            ],
                        )
                    )
                else:
                    stage_consumption = {
                        "audit_write": False,
                        "blockers": [
                            name
                            for name, passed in (
                                (
                                    "post_action_passive_consumer_failed",
                                    post_passive_ok,
                                ),
                                (
                                    "post_action_omp_consumer_failed",
                                    post_omp_ok,
                                ),
                                (
                                    "campaign_stage_reset_failed",
                                    reset_ok,
                                ),
                            )
                            if not passed
                        ],
                    }
                bounded_action["controlled_certification_stage_consumption"] = (
                    stage_consumption
                )
    payload["omp_product_frontier_owner"] = "OMP_EXISTING_PRODUCT_ENGINEERING_FRONTIER"
    payload["next_output"] = (
        "OMP_PRODUCT_FRONTIER_MATERIALIZED"
        if payload["omp_product_frontiers"] else
        "NO_NEW_MATERIAL_INCIDENT_OR_ALREADY_CONSUMED"
    )
    compact_payload = compact_refresh_projection(payload)
    write_json_atomic(summary_file, compact_payload)
    append_event(Path(args.event_dir), payload)
    print(json.dumps(compact_payload, ensure_ascii=False, indent=2 if args.pretty else None))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
