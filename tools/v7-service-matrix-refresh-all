def matrix_runtime_entry_timing(
    *,
    environment: Optional[dict[str, str]] = None,
    module_ready_ns: Optional[int] = None,
    entry_ns: Optional[int] = None,
) -> list[dict[str, Any]]:
    """Attribute the existing T0-to-Matrix process boundary without new state.

    The source is the Matrix-owned monotonic T0 forwarded by the existing
    HARD child only for this invocation.  Invalid or absent values remain
    unmeasured rather than being invented as zero.
    """
    source = environment if environment is not None else os.environ
    try:
        t0_ns = int(str(source.get("V7_HARD_T0_MONOTONIC_NS") or "0"))
    except (TypeError, ValueError):
        return []
    current_ns = int(entry_ns or time.monotonic_ns())
    if str(source.get("V7_HARD_PERSISTENT_MATRIX_OWNER") or "") == "1":
        if t0_ns <= 0 or current_ns < t0_ns:
            return []
        spans = [
            {
                "stage": "hard_t0_to_persistent_matrix_consumer_entry",
                "duration_ms": round((current_ns - t0_ns) / 1_000_000.0, 3),
                "clock_source": "time.monotonic_ns",
                "owner": "existing v7-health owner -> loaded Matrix consumer",
                "diagnostic_only": True,
            },
        ]
        try:
            health_context = json.loads(
                str(source.get("V7_HARD_HEALTH_DISPATCH_CONTEXT") or "{}")
            )
        except (TypeError, ValueError):
            health_context = {}
        dispatch_ns = int(health_context.get("persistent_dispatch_monotonic_ns") or 0) if isinstance(health_context, dict) else 0
        if dispatch_ns >= t0_ns and dispatch_ns <= current_ns:
            spans.extend([
                {
                    "stage": "hard_t0_to_health_persistent_dispatch",
                    "duration_ms": round((dispatch_ns - t0_ns) / 1_000_000.0, 3),
                    "clock_source": "time.monotonic_ns",
                    "owner": "existing v7-health owner",
                    "health_runtime_observation": health_context,
                    "diagnostic_only": True,
                },
                {
                    "stage": "health_persistent_dispatch_to_matrix_consumer_entry",
                    "duration_ms": round((current_ns - dispatch_ns) / 1_000_000.0, 3),
                    "clock_source": "time.monotonic_ns",
                    "owner": "existing v7-health owner -> loaded Matrix consumer",
                    "diagnostic_only": True,
                },
            ])
        return spans
    ready_ns = int(module_ready_ns or MATRIX_RUNTIME_MODULE_READY_NS)
    if t0_ns <= 0 or ready_ns < t0_ns or current_ns < ready_ns:
        return []
    return [
        {
            "stage": "hard_t0_to_matrix_module_ready",
            "duration_ms": round((ready_ns - t0_ns) / 1_000_000.0, 3),
            "clock_source": "time.monotonic_ns",
            "owner": "existing HARD child -> Matrix process boundary",
            "diagnostic_only": True,
        },
        {
            "stage": "matrix_module_ready_to_controlled_consumer_entry",
            "duration_ms": round((current_ns - ready_ns) / 1_000_000.0, 3),
            "clock_source": "time.monotonic_ns",
            "owner": "existing Matrix controlled consumer entry",
            "diagnostic_only": True,
        },
    ]


def read_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return default


def write_json_atomic(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, path)


@contextlib.contextmanager
def service_matrix_writer_lock(state_dir: Path, timeout_sec: int):
    lock_path = state_dir / "service-matrix.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600)
    started = time.time()
    acquired = False
    try:
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                acquired = True
                break
            except BlockingIOError:
                if time.time() - started >= max(1, timeout_sec):
                    raise TimeoutError("service_matrix_lock_timeout")
                time.sleep(0.25)
        yield
    finally:
        if acquired:
            fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def parse_kv_line(line: str) -> dict[str, str]:
    row: dict[str, str] = {}
    for part in line.split():
        if "=" not in part:
            continue
        key, value = part.split("=", 1)
        row[key.strip()] = value.strip()
    return row


def parse_registry(path: Path) -> list[dict[str, str]]:
    rows: list[dict[str, str]] = []
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except FileNotFoundError:
        return rows
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        row = parse_kv_line(line)
        if row.get("id") and SAFE_EGRESS_RE.match(row["id"]):
            rows.append(row)
    return rows


def bool_value(value: Any, default: bool = False) -> bool:
    if value is None or value == "":
        return default
    return str(value).strip().lower() in ("1", "true", "yes", "on", "enabled")


