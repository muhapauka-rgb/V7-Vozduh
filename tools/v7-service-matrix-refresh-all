_IN_PROCESS_AUTOSWITCH_MODULE: Any = None
_IN_PROCESS_GOVERNED_MODULE: Any = None


def in_process_autoswitch_module(planner: str) -> Any:
    """Load the existing Planner/selector owner once in this Matrix run.

    This is only an invocation optimization: the loaded file, functions and
    current files remain the same canonical owners.  A load/call failure is
    handled by the established subprocess path below.
    """
    global _IN_PROCESS_AUTOSWITCH_MODULE
    if _IN_PROCESS_AUTOSWITCH_MODULE is not None:
        return _IN_PROCESS_AUTOSWITCH_MODULE
    path = Path(planner)
    if not path.exists():
        raise FileNotFoundError(str(path))
    loader = importlib.machinery.SourceFileLoader(
        "_v7_users_autoswitch_matrix_runtime",
        str(path),
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise ImportError(f"autoswitch module spec unavailable: {path}")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    _IN_PROCESS_AUTOSWITCH_MODULE = module
    return module


def in_process_autoswitch_args(
    module: Any,
    *,
    state_dir: Path,
    event_dir: Path,
    policy_file: Path,
    audit_store: Path,
) -> argparse.Namespace:
    # These two in-process read-only entrypoints consume only this bounded
    # argument surface. Building the full legacy CLI parser (hundreds of
    # unrelated flags) cost ~2.87 s on the measured failure path and changed
    # no decision. Keep the same parser defaults explicitly; subprocess/CLI
    # fallback remains unchanged if an entrypoint ever needs more.
    return argparse.Namespace(
        state_dir=str(state_dir),
        event_dir=str(event_dir),
        policy_file=str(policy_file),
        action_class_audit_store=str(audit_store),
        org_policy_file=str(module.DEFAULT_ORG_POLICY_FILE),
        safety_file=str(module.DEFAULT_SAFETY_FILE),
        controlled_source_validation_profile="campaign",
    )


def in_process_governed_module(executor: str, planner: str) -> Any:
    """Load the existing governed executor in the current Matrix process.

    The executable, parser, owners and state files remain unchanged.  This
    removes only the second Python interpreter/import cycle on the exact
    one-user CT-M0F hot path.  The caller retains the established subprocess
    fallback when loading or execution cannot be completed in process.
    """
    global _IN_PROCESS_GOVERNED_MODULE
    if _IN_PROCESS_GOVERNED_MODULE is not None:
        return _IN_PROCESS_GOVERNED_MODULE
    path = Path(executor)
    if not path.exists():
        raise FileNotFoundError(str(path))
    loader = importlib.machinery.SourceFileLoader(
        "_v7_governed_matrix_runtime", str(path),
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise ImportError(f"governed module spec unavailable: {path}")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    # Reuse the exact Autoswitch module which this Matrix invocation already
    # loaded for prepared-target validation/source selection.  This changes
    # invocation cost only; no Planner instance, decision or mutable state is
    # shared across transactions.
    module._IN_PROCESS_PLANNER_MODULE = in_process_autoswitch_module(planner)
    _IN_PROCESS_GOVERNED_MODULE = module
    return module


