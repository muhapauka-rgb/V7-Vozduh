def run_bounded_delegated_service_failure_action(
    executor: str,
    *,
    state_dir: Path,
    event_dir: Path,
    policy_file: Path,
    timeout_sec: int = 180,
) -> dict[str, Any]:
    """Close the existing event -> planner -> bounded executor consumer link.

    Absence of an active owner-issued standing contract is a normal fail-closed
    terminal.  The executor remains the sole owner of Candidate/Packet/lease,
    restore-barrier, apply, verification and final OPEN transitions.
    """
    policy_root = read_json(policy_file, {})
    contract = (
        policy_root.get("delegated_autonomy_policy")
        if isinstance(policy_root.get("delegated_autonomy_policy"), dict)
        else {}
    )
    if contract.get("status") != "ACTIVE":
        return {
            "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
            "status": "INACTIVE_NO_STANDING_POLICY",
            "ok": True,
            "action_attempted": False,
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }
    command = [
        executor,
        "--execute-bounded-delegated-transaction",
        "--state-dir", str(state_dir),
        "--event-dir", str(event_dir),
        "--policy-file", str(policy_file),
        "--max-users", "1",
        "--compact-transaction-receipt",
        "--pretty",
    ]
    started_at = now_iso()
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(30, min(int(timeout_sec or 180), 600)),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
            "status": "FAILED",
            "ok": False,
            "started_at": started_at,
            "completed_at": now_iso(),
            "command": command,
            "error": f"{type(exc).__name__}:{exc}",
            "action_attempted": True,
        }
    try:
        parsed = json.loads(proc.stdout or "")
    except json.JSONDecodeError:
        parsed = {}
    verdict = str(parsed.get("final_verdict") or "")
    transaction_status = str(parsed.get("transaction_status") or "")
    completed = proc.returncode == 0 and verdict == "GOVERNED_TRANSACTION_COMPLETED"
    stop_safe = (
        (
            verdict == "STOP_SAFE"
            or (
                verdict == "GOVERNED_TRANSACTION_STOPPED"
                and transaction_status == "STOP_SAFE"
            )
        )
        and not bool(parsed.get("apply_executed"))
        and int(parsed.get("users_moved") or 0) == 0
    )
    return {
        "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
        "status": "ACTION_COMPLETED" if completed else ("STOP_SAFE" if stop_safe else "FAILED"),
        "ok": completed or stop_safe,
        "started_at": started_at,
        "completed_at": now_iso(),
        "command": command,
        "returncode": proc.returncode,
        "consumer_result": parsed,
        "action_attempted": True,
        "action_completed": completed,
        "runtime_mutation_performed": bool(parsed.get("runtime_mutation_performed") or parsed.get("apply_executed")),
        "users_moved": int(parsed.get("users_moved") or 0),
        "output_tail": (proc.stdout or "")[-2000:] if not (completed or stop_safe) else "",
    }


def run_passive_consumer(
    consumer: str,
    *,
    state_dir: Path,
    event_dir: Path,
    timeout_sec: int = 30,
) -> dict[str, Any]:
    """Consume passive events through the existing owner without runtime action."""
    command = [
        consumer,
        "--consume-passive-events-only",
        "--state-dir",
        str(state_dir),
        "--event-dir",
        str(event_dir),
    ]
    started_at = now_iso()
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(5, min(int(timeout_sec or 30), 120)),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.passive-consumer-liveness.v1",
            "status": "FAILED",
            "ok": False,
            "started_at": started_at,
            "completed_at": now_iso(),
            "command": command,
            "error": f"{type(exc).__name__}:{exc}",
            "omp_repair_frontier": {
                "frontier_id": "V7_PASSIVE_SERVICE_EVENT_CONSUMER_REPAIR",
                "last_responsible_producer": "tools/v7-service-matrix-refresh-all",
                "missing_consumer": "tools/v7-users-autoswitch --consume-passive-events-only",
                "exact_missing_artifact": "passive consumer terminal",
                "forbidden_effects": "NONE",
            },
        }
    parsed: dict[str, Any] = {}
    try:
        value = json.loads(proc.stdout or "")
        parsed = value if isinstance(value, dict) else {}
    except json.JSONDecodeError:
        parsed = {}
    ok = proc.returncode == 0 and parsed.get("status") == "PASS"
    result = {
        "schema_version": "v7.passive-consumer-liveness.v1",
        "status": "PASS" if ok else "FAILED",
        "ok": ok,
        "started_at": started_at,
        "completed_at": now_iso(),
        "command": command,
        "returncode": proc.returncode,
        "consumer_result": parsed,
    }
    if not ok:
        result["output_tail"] = (proc.stdout or "")[-2000:]
        result["omp_repair_frontier"] = {
            "frontier_id": "V7_PASSIVE_SERVICE_EVENT_CONSUMER_REPAIR",
            "last_responsible_producer": "tools/v7-service-matrix-refresh-all",
            "missing_consumer": "tools/v7-users-autoswitch --consume-passive-events-only",
            "exact_missing_artifact": "passive consumer terminal",
            "forbidden_effects": "NONE",
        }
    return result


def run_one(egress_id: str, timeout: int, checker: str, state_dir: Path) -> dict[str, Any]:
    started = time.time()
    cmd = [checker, egress_id, "all", "--timeout", str(timeout), "--state-dir", str(state_dir)]
    env = dict(os.environ)
    env["V7_SERVICE_MATRIX_LOCK_HELD"] = "1"
    try:
        proc = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False, timeout=timeout * 14, env=env)
    except subprocess.TimeoutExpired as exc:
        return {
            "egress": egress_id,
            "status": "TIMEOUT",
            "ok": False,
            "elapsed_sec": round(time.time() - started, 3),
            "output_tail": str(exc.stdout or "")[-2000:],
            "cmd": cmd,
        }
    output = proc.stdout or ""
    parsed: dict[str, Any] = {}
    try:
        parsed = json.loads(output)
    except json.JSONDecodeError:
        parsed = {}
    status = str(parsed.get("status") or ("OK" if proc.returncode == 0 else "FAIL"))
    ok = proc.returncode == 0 and status in ("OK", "WARN")
    return {
        "egress": egress_id,
        "status": status,
        "ok": ok,
        "rc": proc.returncode,
        "ok_count": parsed.get("ok_count", 0),
        "total": parsed.get("total", 0),
        "elapsed_sec": round(time.time() - started, 3),
        "output_tail": output[-2000:],
        "cmd": cmd,
    }


def run_service_failure_automation_advisory(
    consumer: str,
    *,
    state_dir: Path,
    event_dir: Path,
    timeout_sec: int = 45,
) -> dict[str, Any]:
    """Invoke the existing autoswitch owner in bounded advisory-only mode."""
    command = [
        consumer,
        "--consume-service-failure-automation-only",
        "--state-dir",
        str(state_dir),
        "--event-dir",
        str(event_dir),
    ]
    started_at = now_iso()
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(5, min(int(timeout_sec or 45), 120)),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.service-failure-automation-advisory-liveness.v1",
            "status": "FAILED",
            "ok": False,
            "started_at": started_at,
            "error": str(exc),
            "command": command,
        }
    output = proc.stdout or ""
    try:
        parsed = json.loads(output)
    except json.JSONDecodeError:
        parsed = {}
    return {
        "schema_version": "v7.service-failure-automation-advisory-liveness.v1",
        "status": "PASS" if proc.returncode == 0 and isinstance(parsed, dict) and parsed.get("ok") else "FAILED",
        "ok": proc.returncode == 0 and isinstance(parsed, dict) and parsed.get("ok") is True,
        "started_at": started_at,
        "completed_at": now_iso(),
        "command": command,
        "returncode": proc.returncode,
        "consumer_result": parsed,
        "output_tail": output[-2000:],
    }


def run_service_failure_omp_consumer(*, timeout_sec: int = 45) -> dict[str, Any]:
    """Consume the already-materialized obligation through the standard OMP entrypoint.

    Production deploys the evidence owner but deliberately not the source CPS
    corpus.  This narrow existing-owner command persists the consumption
    receipt in production; the canonical source CPS is reconciled only from
    that owner-backed receipt by its source owner.
    """
    command = ["v7-truth-check", "--consume-service-failure-automation-only", "--json"]
    started_at = now_iso()
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(10, min(int(timeout_sec or 45), 180)),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "schema_version": "v7.service-failure-omp-consumer-liveness.v1",
            "status": "FAILED", "ok": False, "started_at": started_at,
            "error": str(exc), "command": command,
        }
    output = proc.stdout or ""
    try:
        parsed = json.loads(output)
    except json.JSONDecodeError:
        parsed = {}
    passed = (
        proc.returncode == 0
        and isinstance(parsed, dict)
        and parsed.get("final_verdict") in {
            "PASS",
            "BOUNDED_CONTINUATION",
            "NO_PENDING_OBLIGATION",
        }
    )
    return {
        "schema_version": "v7.service-failure-omp-consumer-liveness.v1",
        "status": "PASS" if passed else "FAILED",
        "ok": passed,
        "started_at": started_at,
        "completed_at": now_iso(),
        "command": command,
        "returncode": proc.returncode,
        "consumer_result": parsed,
        "output_tail": output[-2000:],
    }


def _consumer_projection(payload: Any) -> dict[str, Any]:
    """Keep a lifecycle receipt compact while leaving full truth with its owner.

    Matrix refresh is an observation/wake producer, not an outcome registry.
    Its child consumers already persist their complete facts in the existing
    event, execution and closure owners.  Re-embedding whole child responses
    here caused each periodic refresh to grow the next refresh's input.
    """
    value = payload if isinstance(payload, dict) else {}
    result = value.get("consumer_result")
    result = result if isinstance(result, dict) else {}
    compact_result = {
        key: result.get(key)
        for key in (
            "final_verdict", "status", "next_output", "legal_terminal",
            "receipt_id", "obligation_id", "frontier_id", "packet_id",
            "feedback_id", "outcome_id", "transaction_status",
        )
        if result.get(key) not in (None, "", [], {})
    }
    return {
        key: value.get(key)
        for key in (
            "schema_version", "status", "ok", "started_at", "completed_at",
            "returncode", "action_attempted", "action_completed",
            "runtime_mutation_performed", "users_moved", "reason", "error",
        )
        if value.get(key) not in (None, "", [], {})
    } | ({"consumer_result": compact_result} if compact_result else {})


def compact_refresh_projection(payload: dict[str, Any]) -> dict[str, Any]:
    """Project one refresh lifecycle without recursively storing child output.

    Complete decision, packet, execution, verification, replay and Learning
    evidence remains with the existing specialized owners.  This projection
    retains only the Matrix caller/consumer receipt and explicit pointers.
    """
    results = [
        {
            key: row.get(key)
            for key in ("egress", "status", "ok", "rc", "ok_count", "total", "elapsed_sec")
            if row.get(key) not in (None, "", [], {})
        }
        for row in (payload.get("results") or [])
        if isinstance(row, dict)
    ]
    projection = {
        "schema_version": "v7.service-matrix-refresh-lifecycle-projection.v1",
        "updated": payload.get("updated"),
        "elapsed_sec": payload.get("elapsed_sec"),
        "total": payload.get("total"),
        "ok_count": payload.get("ok_count"),
        "status": payload.get("status", "OK"),
        "results": results,
        "passive_failure_capture": payload.get("passive_failure_capture") or {},
        "omp_product_frontiers": list(payload.get("omp_product_frontiers") or ()),
        "omp_product_frontier_owner": payload.get("omp_product_frontier_owner", ""),
        "next_output": payload.get("next_output", ""),
        "evidence_owners": {
            "matrix": "service-matrix.json",
            "passive_events": "service-failure-events.jsonl",
            "execution": "execution-events.jsonl",
            "outcome_and_omp": "closure-records.jsonl",
        },
        "capture_only": True,
        "candidate_or_execution_forbidden": True,
        "full_child_payload_embedded": False,
    }
    for key in (
        "passive_event_consumer", "service_failure_automation_advisory",
        "service_failure_omp_consumer", "service_failure_post_action_omp_consumer",
        "bounded_delegated_service_failure_action",
    ):
        if key in payload:
            projection[key] = _consumer_projection(payload.get(key))
    return projection


def append_event(event_dir: Path, payload: dict[str, Any]) -> None:
    try:
        event_dir.mkdir(parents=True, exist_ok=True)
        path = event_dir / f"service-matrix-refresh-{datetime.now(timezone.utc).strftime('%Y%m%d')}.jsonl"
        with path.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(compact_refresh_projection(payload), ensure_ascii=False, sort_keys=True) + "\n")
    except OSError:
        pass


def sha256_json(payload: Any) -> str:
    return hashlib.sha256(json.dumps(payload, ensure_ascii=True, sort_keys=True, default=str).encode("utf-8")).hexdigest()


def enabled_users_on_egress(state_dir: Path, egress_id: str) -> list[str]:
    users: list[str] = []
    try:
        lines = (state_dir / "users.registry").read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return users
    for line in lines:
        row = parse_kv_line(line)
        if row.get("current") == egress_id and bool_value(row.get("enabled"), default=True) and row.get("ip"):
            users.append(str(row["ip"]))
    return sorted(set(users))


def latest_history_failure_episode(state_dir: Path, channel: str) -> Optional[dict[str, Any]]:
    """Return the latest persisted failure episode for one canonical channel.

    This deliberately reads the existing egress-history owner.  An operator may
    report a short external outage only after it has recovered; a fresh matrix
    refresh alone would then be unable to prove that real, already-observed
    condition without inventing a new failure.
    """
    path = state_dir / "egress-history.jsonl"
    rows: list[dict[str, Any]] = []
    try:
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines()[-5000:]:
            parsed = json.loads(line)
            if isinstance(parsed, dict) and f"{channel}_code" in parsed:
                rows.append(parsed)
    except (OSError, json.JSONDecodeError):
        return None
    failed_indexes = [
        index for index, row in enumerate(rows)
        if not str(row.get(f"{channel}_code") or "").startswith("2")
    ]
    if not failed_indexes:
        return None
    last = failed_indexes[-1]
    first = last
    while first > 0 and not str(rows[first - 1].get(f"{channel}_code") or "").startswith("2"):
        first -= 1
    recovered_at = ""
    for row in rows[last + 1:]:
        if str(row.get(f"{channel}_code") or "").startswith("2"):
            recovered_at = str(row.get("time") or "")
            break
    episode = rows[first:last + 1]
    return {
        "history_path": str(path.name),
        "observed_at": str(rows[first].get("time") or ""),
        "last_failed_at": str(rows[last].get("time") or ""),
        "recovered_at": recovered_at,
        "failure_count": len(episode),
        "failure_codes": sorted({str(row.get(f"{channel}_code") or "") for row in episode}),
        "history_hash": sha256_json(episode),
    }


def append_passive_failure_capture(
    event_dir: Path,
    *,
    state_dir: Path,
    matrix: dict[str, Any],
    refresh_payload: dict[str, Any],
    provenance: str,
    trigger_reference: str,
    declared_channel: str = "",
) -> list[dict[str, Any]]:
    """Append one source-bound observation record per declared external failure.

    This is deliberately a capture-only projection.  It must never become an
    execution wake, an L7 transaction, or natural-L8 credit on its own.
    """
    if not provenance:
        return []
    if provenance == "OPERATOR_INDUCED":
        # An operator-induced incident is source-bound to the declared canonical
        # channel.  Never reinterpret whichever channel happens to be unhealthy
        # at refresh time as that reported incident.
        channel = str(declared_channel or "")
        registry = parse_registry(state_dir / "egress.registry")
        if not channel or not any(row.get("id") == channel for row in registry):
            return []
        affected_users = enabled_users_on_egress(state_dir, channel)
        episode = latest_history_failure_episode(state_dir, channel)
        if not affected_users or not episode:
            return []
        source_hashes = {
            "egress_history_episode": str(episode["history_hash"]),
            "egress_registry": sha256_json(registry),
            "users_on_source": sha256_json(affected_users),
        }
        identity = {
            "schema_version": "v7.passive-production-failure-capture.v1",
            "channel": channel,
            "provenance": provenance,
            "trigger_reference": trigger_reference,
            "observed_at": episode["observed_at"],
            "source_hashes": source_hashes,
        }
        row = {
            **identity,
            "event_id": "pevt_" + sha256_json(identity)[:24],
            "event_type": "external_channel_unavailability",
            "producer": "tools/v7-service-matrix-refresh-all",
            "source_files": ["egress-history.jsonl", "service-matrix.json", "egress.registry", "users.registry"],
            "affected_users": affected_users,
            "history_episode": episode,
            "capture_matrix_hash": sha256_json(matrix),
            "capture_only": True,
            "execution_forbidden": True,
            "candidate_packet_lease_forbidden": True,
            "natural_production_credit": False,
            "l7_credit": False,
            "synthetic_event": False,
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
        }
        event_dir.mkdir(parents=True, exist_ok=True)
        path = event_dir / "service-failure-events.jsonl"
        existing_ids: set[str] = set()
        try:
            for line in path.read_text(encoding="utf-8", errors="replace").splitlines()[-2000:]:
                parsed = json.loads(line)
                if isinstance(parsed, dict) and parsed.get("event_id"):
                    existing_ids.add(str(parsed["event_id"]))
        except (OSError, json.JSONDecodeError):
            pass
        if row["event_id"] in existing_ids:
            return []
        with path.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")
        return [row]
    items = matrix.get("items") if isinstance(matrix.get("items"), dict) else {}
    rows: list[dict[str, Any]] = []
    for result in refresh_payload.get("results") or []:
        if not isinstance(result, dict) or bool(result.get("ok")):
            continue
        egress_id = str(result.get("egress") or "")
        item = items.get(egress_id) if isinstance(items.get(egress_id), dict) else {}
        services = item.get("services") if isinstance(item.get("services"), dict) else {}
        failed_services = sorted(
            str(name) for name, service in services.items()
            if isinstance(service, dict)
            and (service.get("ok") is False or str(service.get("status") or "").upper() in {"FAIL", "ERROR", "DOWN", "NOT_STARTED"})
        )
        affected_users = enabled_users_on_egress(state_dir, egress_id)
        if not egress_id or not failed_services or not affected_users:
            continue
        source_hashes = {
            "service_matrix": sha256_json(item),
            "egress_registry": sha256_json(parse_registry(state_dir / "egress.registry")),
            "users_on_source": sha256_json(affected_users),
        }
        identity = {
            "schema_version": "v7.passive-production-failure-capture.v1",
            "channel": egress_id,
            "failed_services": failed_services,
            "provenance": provenance,
            "trigger_reference": trigger_reference,
            "source_hashes": source_hashes,
        }
        event_id = "pevt_" + sha256_json(identity)[:24]
        rows.append({
            **identity,
            "event_id": event_id,
            "event_type": "external_channel_unavailability",
            "observed_at": str(item.get("updated") or refresh_payload.get("updated") or now_iso()),
            "producer": "tools/v7-service-matrix-refresh-all",
            "source_files": ["service-matrix.json", "egress.registry", "users.registry"],
            "affected_users": affected_users,
            "capture_only": True,
            "execution_forbidden": True,
            "candidate_packet_lease_forbidden": True,
            "natural_production_credit": False,
            "l7_credit": False,
            "synthetic_event": False,
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
        })
    if not rows:
        return []
    event_dir.mkdir(parents=True, exist_ok=True)
    path = event_dir / "service-failure-events.jsonl"
    existing_ids: set[str] = set()
    try:
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines()[-2000:]:
            parsed = json.loads(line)
            if isinstance(parsed, dict) and parsed.get("event_id"):
                existing_ids.add(str(parsed["event_id"]))
    except (OSError, json.JSONDecodeError):
        pass
    new_rows = [row for row in rows if row["event_id"] not in existing_ids]
    if new_rows:
        with path.open("a", encoding="utf-8") as fh:
            for row in new_rows:
                fh.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")
    return new_rows


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Refresh V7 service matrix for all enabled egress channels.")
    parser.add_argument("--state-dir", default=str(DEFAULT_STATE_DIR))
    parser.add_argument("--event-dir", default=str(DEFAULT_EVENT_DIR))
    parser.add_argument("--summary-file", default="")
    parser.add_argument("--checker", default=default_checker_path())
    parser.add_argument("--passive-consumer", default=default_passive_consumer_path())
    parser.add_argument("--governed-executor", default=default_governed_executor_path())
    parser.add_argument("--policy-file", default=str(DEFAULT_POLICY_FILE))
    parser.add_argument("--passive-consumer-timeout-sec", type=int, default=30)
    parser.add_argument("--skip-service-failure-automation-advisory", action="store_true")
    parser.add_argument("--skip-service-failure-omp-consumer", action="store_true")
    parser.add_argument("--skip-bounded-delegated-service-failure-action", action="store_true")
    parser.add_argument(
        "--skip-passive-consumer",
        action="store_true",
        help="Diagnostic/test-only escape hatch; production lifecycle should keep the existing passive consumer connected.",
    )
    parser.add_argument("--timeout", type=int, default=8)
    parser.add_argument("--lock-timeout-sec", type=int, default=DEFAULT_LOCK_WAIT_SECONDS)
    parser.add_argument(
        "--event-provenance",
        choices=("OPERATOR_INDUCED", "OBSERVED_EXTERNAL_UNATTRIBUTED"),
        default="",
        help="Emit a capture-only external-failure event; never grants execution or L7/L8 credit.",
    )
    parser.add_argument("--event-trigger-reference", default="", help="Stable external trigger identity required for OPERATOR_INDUCED capture.")
    parser.add_argument("--event-channel", default="", help="Canonical affected egress id required for OPERATOR_INDUCED capture.")
    parser.add_argument(
        "--lock-acquired-marker",
        default="",
        help="Write an owner-backed marker after this lifecycle invocation acquires the writer lock.",
    )
    parser.add_argument("--pretty", action="store_true")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    started = time.time()
    state_dir = Path(args.state_dir)
    rows = [row for row in parse_registry(state_dir / "egress.registry") if bool_value(row.get("enabled"), default=True)]
    try:
        with service_matrix_writer_lock(state_dir, int(args.lock_timeout_sec)):
            if args.lock_acquired_marker:
                write_json_atomic(Path(args.lock_acquired_marker), {
                    "schema_version": "v7.service-matrix-lock-acquisition.v1",
                    "owner": "tools/v7-service-matrix-refresh-all",
                    "pid": os.getpid(),
                    "acquired_at": now_iso(),
                    "lock_path": str(state_dir / "service-matrix.lock"),
                    "runtime_behavior_changed": False,
                    "users_moved": False,
                })
            results = [run_one(row["id"], max(3, min(int(args.timeout), 30)), args.checker, state_dir) for row in rows]
            payload = {
                "schema_version": 1,
                "updated": now_iso(),
                "elapsed_sec": round(time.time() - started, 3),
                "total": len(results),
                "ok_count": sum(1 for row in results if row.get("ok")),
                "results": results,
                "service_matrix_lock": {
                    "held": True,
                    "scope": "full_refresh_batch",
                    "path": str(state_dir / "service-matrix.lock"),
                    "runtime_behavior_changed": False,
                    "users_moved": False,
                },
            }
    except TimeoutError:
        payload = {
            "schema_version": 1,
            "updated": now_iso(),
            "elapsed_sec": round(time.time() - started, 3),
            "total": len(rows),
            "ok_count": 0,
            "results": [],
            "status": "LOCK_TIMEOUT",
            "ok": False,
            "service_matrix_lock": {
                "held": False,
                "scope": "full_refresh_batch",
                "path": str(state_dir / "service-matrix.lock"),
                "timeout_sec": int(args.lock_timeout_sec),
                "runtime_behavior_changed": False,
                "users_moved": False,
            },
        }
    summary_file = Path(args.summary_file) if args.summary_file else state_dir / "service-matrix-refresh-summary.json"
    if args.event_provenance == "OPERATOR_INDUCED" and not str(args.event_trigger_reference or "").strip():
        print(json.dumps({"error": "operator_induced_event_trigger_reference_required"}, ensure_ascii=False))
        return 2
    if args.event_provenance == "OPERATOR_INDUCED" and not str(args.event_channel or "").strip():
        print(json.dumps({"error": "operator_induced_event_channel_required"}, ensure_ascii=False))
        return 2
    matrix = read_json(state_dir / "service-matrix.json", {})
    capture_rows = append_passive_failure_capture(
        Path(args.event_dir),
        state_dir=state_dir,
        matrix=matrix,
        refresh_payload=payload,
        provenance=str(args.event_provenance or ""),
        trigger_reference=str(args.event_trigger_reference or "").strip(),
        declared_channel=str(args.event_channel or "").strip(),
    )
    payload["passive_failure_capture"] = {
        "emitted_event_ids": [row["event_id"] for row in capture_rows],
        "event_provenance": str(args.event_provenance or ""),
        "capture_only": True,
        "execution_forbidden": True,
        "natural_production_credit": False,
    }
    if args.skip_passive_consumer:
        payload["passive_event_consumer"] = {
            "schema_version": "v7.passive-consumer-liveness.v1",
            "status": "SKIPPED_EXPLICITLY",
            "ok": False,
            "omp_repair_frontier": {
                "frontier_id": "V7_PASSIVE_SERVICE_EVENT_CONSUMER_REPAIR",
                "last_responsible_producer": "tools/v7-service-matrix-refresh-all",
                "missing_consumer": "tools/v7-users-autoswitch --consume-passive-events-only",
                "exact_missing_artifact": "passive consumer terminal",
                "forbidden_effects": "NONE",
            },
        }
    else:
        payload["passive_event_consumer"] = run_passive_consumer(
            str(args.passive_consumer),
            state_dir=state_dir,
            event_dir=Path(args.event_dir),
            timeout_sec=int(args.passive_consumer_timeout_sec),
        )
    consumer_payload = (
        (payload.get("passive_event_consumer") or {}).get("consumer_result") or {}
    )
    consumer_result = (
        consumer_payload.get("result")
        if isinstance(consumer_payload.get("result"), dict)
        else {}
    )
    payload["omp_product_frontiers"] = list(
        consumer_result.get("omp_frontiers") or ()
    )
    if args.skip_service_failure_automation_advisory:
        payload["service_failure_automation_advisory"] = {
            "schema_version": "v7.service-failure-automation-advisory-liveness.v1",
            "status": "SKIPPED_EXPLICITLY",
            "ok": False,
            "reason": "explicit_skip",
        }
    else:
        payload["service_failure_automation_advisory"] = run_service_failure_automation_advisory(
            str(args.passive_consumer),
            state_dir=state_dir,
            event_dir=Path(args.event_dir),
            timeout_sec=int(args.passive_consumer_timeout_sec) + 15,
        )
    advisory_result = (
        (payload.get("service_failure_automation_advisory") or {}).get("consumer_result") or {}
    )
    advisory_payload = advisory_result.get("result") if isinstance(advisory_result, dict) else {}
    if args.skip_service_failure_omp_consumer:
        payload["service_failure_omp_consumer"] = {
            "schema_version": "v7.service-failure-omp-consumer-liveness.v1",
            "status": "SKIPPED_EXPLICITLY", "ok": False, "reason": "explicit_skip",
        }
    elif (payload.get("service_failure_automation_advisory") or {}).get("ok") is True:
        payload["service_failure_omp_consumer"] = run_service_failure_omp_consumer(
            timeout_sec=int(args.passive_consumer_timeout_sec) + 30,
        )
    else:
        payload["service_failure_omp_consumer"] = {
            "schema_version": "v7.service-failure-omp-consumer-liveness.v1",
            "status": "NOT_REQUIRED_NO_NEW_OBLIGATION", "ok": True,
        }
    if args.skip_bounded_delegated_service_failure_action:
        payload["bounded_delegated_service_failure_action"] = {
            "schema_version": "v7.service-failure-bounded-delegated-action-consumer.v1",
            "status": "SKIPPED_EXPLICITLY",
            "ok": False,
            "reason": "explicit_skip",
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }
    else:
        payload["bounded_delegated_service_failure_action"] = run_bounded_delegated_service_failure_action(
            str(args.governed_executor),
            state_dir=state_dir,
            event_dir=Path(args.event_dir),
            policy_file=Path(args.policy_file),
            timeout_sec=int(args.passive_consumer_timeout_sec) + 180,
        )
        if payload["bounded_delegated_service_failure_action"].get("action_completed"):
            payload["service_failure_post_action_omp_consumer"] = run_service_failure_omp_consumer(
                timeout_sec=int(args.passive_consumer_timeout_sec) + 30,
            )
    payload["omp_product_frontier_owner"] = "OMP_EXISTING_PRODUCT_ENGINEERING_FRONTIER"
    payload["next_output"] = (
        "OMP_PRODUCT_FRONTIER_MATERIALIZED"
        if payload["omp_product_frontiers"] else
        "NO_NEW_MATERIAL_INCIDENT_OR_ALREADY_CONSUMED"
    )
    compact_payload = compact_refresh_projection(payload)
    write_json_atomic(summary_file, compact_payload)
    append_event(Path(args.event_dir), payload)
    print(json.dumps(compact_payload, ensure_ascii=False, indent=2 if args.pretty else None))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
