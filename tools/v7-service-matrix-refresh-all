        "egresses": list(egresses),
        "services": list(services),
        "profile_user": profile_user,
        "profile_source": "state/service-preferences.json:users.<user>.services" if profile_user else "caller_exact_service_subset",
        "scope": "EXACT_CURRENT_SOURCE_AND_REQUIRED_SERVICE_SUBSET",
        "idempotent": True,
        "duplicate_suppression": "existing_matrix_episode_and_generation",
        "rate_bound": "one_explicit_shadow_invocation",
        "canonical_writer": "tools/v7-service-matrix-test",
        "observation_only": True,
        "full_matrix_fallback_preserved": True,
        "consumer_invoked": False,
        "routing_mutation_performed": False,
        "users_moved": 0,
