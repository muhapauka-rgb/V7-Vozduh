def parse_timestamp(value: Any) -> Optional[datetime]:
    text = str(value or "").strip()
    if not text:
        return None
    try:
        parsed = datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        return None
    return parsed if parsed.tzinfo else parsed.replace(tzinfo=timezone.utc)


def service_failure_observed(row: dict[str, Any]) -> bool:
    """Return whether a probe row is an actual failed observation.

    HTTP-limited rows are intentionally not transport/service failures: the
    catalog records them as `ok=True`, but retaining the explicit guard keeps
    episode semantics safe for legacy matrix producers.
    """
    status = str(row.get("status") or "").upper()
    if status in {"HTTP_LIMITED", "DEGRADED"}:
        return False
    return row.get("ok") is False or row.get("available") is False or status in {
        "DOWN", "FAIL", "ERROR", "NOT_STARTED",
    }


def service_failure_family(row: dict[str, Any]) -> str:
    """Normalize probe detail to a stable, non-secret failure family."""
    status = str(row.get("status") or "").upper()
    details = " ".join(
        str(row.get(key) or "") for key in ("reason", "error")
    )
    details += " " + " ".join(
        str(sample.get("error") or "")
        for sample in (row.get("samples") or ())
        if isinstance(sample, dict)
    )
    lowered = details.lower()
    if status == "NOT_STARTED":
        return "RUNTIME_INTERFACE_UNAVAILABLE"
    if "connection refused" in lowered:
        return "TCP_CONNECTION_REFUSED"
    if "timed out" in lowered or "timeout" in lowered:
        return "TRANSPORT_TIMEOUT"
    if "could not resolve" in lowered or "name resolution" in lowered or "dns" in lowered:
        return "DNS_FAILURE"
    if "certificate" in lowered or "tls" in lowered or "ssl" in lowered:
        return "TLS_FAILURE"
    if "reset" in lowered:
        return "CONNECTION_RESET"
    if status.startswith("TELEGRAM_DOWN"):
        return "TELEGRAM_TRANSPORT_DOWN"
    if service_failure_observed(row):
        return "SERVICE_PROBE_FAILURE"
    return "NONE"


def egress_config_generation(row: dict[str, Any]) -> str:
    """Hash an owner-declared runtime config without exposing its contents."""
    paths = [
        Path(str(row.get(key)))
        for key in ("config", "config_file", "config_path", "runtime_config")
        if str(row.get(key) or "").startswith("/")
    ]
    if str(row.get("protocol") or "").lower() == "vless":
        paths.append(Path("/etc/sing-box/config.json"))
    digests: list[tuple[str, str]] = []
    for path in sorted(set(paths), key=str):
        try:
            digests.append((str(path), hashlib.sha256(path.read_bytes()).hexdigest()))
        except OSError:
            continue
    stable = hashlib.sha256(
        json.dumps(digests, ensure_ascii=True, sort_keys=True).encode("utf-8")
    ).hexdigest()
    return f"cfg_{stable[:24]}"


def canonical_egress_identity(row: dict[str, Any], *, egress_id: str, iface: str) -> dict[str, str]:
    """Return a registry-owned, secret-free identity binding for episode IDs."""
    allowed = {
        key: str(row.get(key) or "")
        for key in ("id", "protocol", "type", "interface", "role", "provider", "generation", "enabled")
        if row.get(key) not in (None, "")
    }
    allowed.setdefault("id", egress_id)
    allowed.setdefault("interface", iface)
    config_generation = egress_config_generation(row)
    allowed["config_generation"] = config_generation
    generation = hashlib.sha256(
        json.dumps(allowed, ensure_ascii=True, sort_keys=True).encode("utf-8")
    ).hexdigest()
    return {
        "canonical_egress_id": egress_id,
        "egress_identity_generation": f"egid_{generation[:24]}",
        "egress_identity_fingerprint": generation,
        "egress_config_generation": config_generation,
    }


def _bounded_command_fingerprint(command: list[str], *, timeout: int = 3) -> dict[str, Any]:
    """Fingerprint one existing kernel/network owner without storing raw data."""
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=max(1, min(int(timeout), 5)),
        )
        output = proc.stdout or ""
        return {
            "status": "PASS" if proc.returncode == 0 else "UNAVAILABLE",
            "sha256": hashlib.sha256(output.encode("utf-8", errors="replace")).hexdigest(),
            "returncode": int(proc.returncode),
        }
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "status": "UNAVAILABLE",
            "sha256": hashlib.sha256(str(exc.__class__.__name__).encode()).hexdigest(),
            "returncode": 127,
        }


def network_path_evidence(
    state_dir: Path,
    row: dict[str, Any],
    *,
    egress_id: str,
    iface: str,
    service_ids: list[str],
) -> dict[str, Any]:
    """Project the Matrix probe path through its existing topology owners.

    The projection is embedded in the existing service-matrix row.  It stores
    hashes and semantic classes only; raw rules, addresses, firewall state and
    credentials remain with their canonical kernel/config owners.
    """
    identity = canonical_egress_identity(row, egress_id=egress_id, iface=iface)
    try:
        netns_identity = os.readlink("/proc/self/ns/net")
    except OSError:
        netns_identity = "UNKNOWN"
    resolver_path = Path("/etc/resolv.conf")
    try:
        resolver_hash = hashlib.sha256(resolver_path.read_bytes()).hexdigest()
    except OSError:
        resolver_hash = "UNAVAILABLE"
    component_commands = {
        "interface_addresses": ["ip", "-j", "-brief", "addr", "show", "dev", iface],
        "policy_rules": ["ip", "-j", "rule", "show"],
        "routing_tables": [
            "ip", "-j", "route", "show", "table", "all", "dev", iface,
        ],
        "firewall_rules": ["nft", "--stateless", "list", "ruleset"],
    }
    component_started_ns = time.monotonic_ns()
    component_timings: dict[str, float] = {}

    def fingerprint_component(item: tuple[str, list[str]]) -> tuple[str, dict[str, Any], float]:
        name, command = item
        started_ns = time.monotonic_ns()
        value = _bounded_command_fingerprint(command)
        return name, value, round((time.monotonic_ns() - started_ns) / 1_000_000.0, 3)

    # These four reads are independent projections over existing kernel/config
    # owners.  Serial execution multiplied a single slow nft/ip timeout across
    # the user verification critical path and could force an unnecessary full
    # Matrix refresh.  Bounded parallel reads preserve every fingerprint and
    # fail-closed status while paying only the slowest owner latency.
    components: dict[str, dict[str, Any]] = {}
    with ThreadPoolExecutor(max_workers=len(component_commands)) as pool:
        for name, value, duration_ms in pool.map(
            fingerprint_component,
            component_commands.items(),
        ):
            components[name] = value
            component_timings[name] = duration_ms
    component_wall_ms = round(
        (time.monotonic_ns() - component_started_ns) / 1_000_000.0,
        3,
    )
    service_set = sorted(set(str(item) for item in service_ids if str(item)))
    service_set_fingerprint = hashlib.sha256(
        json.dumps(service_set, separators=(",", ":")).encode()
    ).hexdigest()
    basis = {
        "schema_version": "v7.service-matrix-network-path.v1",
        "scope": "EGRESS_PATH_AND_CHANNEL_PROFILE",
        "channel_id": egress_id,
        "interface": iface,
        "network_namespace": netns_identity,
        "egress_identity_generation": identity["egress_identity_generation"],
        "egress_config_generation": identity["egress_config_generation"],
        "expected_egress_ip_fingerprint": hashlib.sha256(
            str(row.get("expected_ip") or "UNDECLARED").encode("utf-8")
        ).hexdigest(),
        "source_ip_class_fingerprint": components["interface_addresses"]["sha256"],
        "resolver_sha256": resolver_hash,
        "service_set_fingerprint": service_set_fingerprint,
        "matrix_schema_version": "v7.service-matrix-network-path.v1",
        # Matrix evidence is channel/path scoped.  Per-user policy rules are
        # deliberately observed but excluded from this fingerprint because a
        # successful user move changes that separate route-binding owner.  A
        # global policy-rule hash made every valid apply invalidate its own
        # Matrix evidence and forced a redundant 14-service refresh.  The
        # lightweight user route verifier remains the canonical binding proof.
        "component_hashes": {
            name: value["sha256"]
            for name, value in sorted(components.items())
            if name != "policy_rules"
        },
        "excluded_binding_components": ["policy_rules"],
    }
    return {
        **basis,
        "path_fingerprint": hashlib.sha256(
            json.dumps(basis, ensure_ascii=True, sort_keys=True, separators=(",", ":")).encode()
        ).hexdigest(),
        "measured_at": now_iso(),
        "probe_execution_context": {
            "host_scope": "CURRENT_RUNTIME_NODE",
            "process_owner": "tools/v7-service-matrix-test",
            "socket_binding": "SO_BINDTODEVICE_OR_CURL_INTERFACE",
            "user_route_binding_used": False,
            "raw_network_state_stored": False,
        },
        "component_status": {name: value["status"] for name, value in sorted(components.items())},
        "performance_timeline": {
            "schema_version": "v7.service-matrix-path-evidence-timing.v1",
            "clock_source": "time.monotonic_ns",
            "owner": "tools/v7-service-matrix-test.network_path_evidence",
            "critical_path_wall_ms": component_wall_ms,
            "component_duration_ms": dict(sorted(component_timings.items())),
            "bounded_parallelism": len(component_commands),
        },
        "service_ids": service_set,
    }


def service_failure_episode(
    previous: dict[str, Any],
    observed: dict[str, Any],
    *,
    egress_id: str,
    service_id: str,
    observed_at: str,
    observed_monotonic_ns: int = 0,
    monotonic_clock_domain: str = "",
    identity_generation: str = "",
) -> dict[str, Any]:
    """Attach durable, source-bound failure continuity to an existing row.

    `service-matrix.json` remains the sole durable producer.  This adds no
    watcher or registry; it makes the already emitted probe facts consumable
    after a new planner process starts.
    """
    result = dict(observed)
    now = parse_timestamp(observed_at) or datetime.now(timezone.utc)
    previous_failed = service_failure_observed(previous)
    previous_at = parse_timestamp(previous.get("observed_at") or previous.get("tested_at"))
    failure_family = service_failure_family(result)
    continuous = bool(
        previous_failed
        and previous_at
        and (now - previous_at).total_seconds() <= FAILURE_EPISODE_CONTINUITY_SECONDS
        and str(previous.get("failure_family") or "") == failure_family
        and str(previous.get("egress_identity_generation") or identity_generation) == identity_generation
    )
    failure = service_failure_observed(result)
    methodology = "HTTP_LIMITED" if str(result.get("status") or "").upper() == "HTTP_LIMITED" else ""
    result.update({
        "observed_at": observed_at,
        "observation_monotonic_ns": int(observed_monotonic_ns or 0),
        "monotonic_clock_domain": str(monotonic_clock_domain or ""),
        "probe_provenance": "SERVICE_PROBE_OBSERVED",
        "evidence_class": "PROBE_OBSERVATION",
        "probe_classification": methodology or ("FAILURE" if failure else "HEALTHY"),
    })
    if failure:
        started_at = str(previous.get("failure_started_at") or previous.get("observed_at") or previous.get("tested_at") or observed_at) if continuous else observed_at
        samples = max(0, int(previous.get("failure_samples") or 0)) + 1 if continuous else 1
        started = parse_timestamp(started_at) or now
        episode_id = hashlib.sha256(
            (
                "v7.service-failure-episode.v2|"
                f"{egress_id}|{identity_generation}|{service_id}|{failure_family}|{started_at}"
            ).encode("utf-8")
        ).hexdigest()[:32]
        result.update({
            "failure_episode_id": f"sfep_{episode_id}",
            "failure_started_at": started_at,
            "last_failure_at": observed_at,
            "failure_samples": samples,
            "consecutive_failures": samples,
            "bad_for_seconds": max(0.0, round((now - started).total_seconds(), 3)),
            "failure_state": "OBSERVED_CONTINUING" if continuous else "OBSERVED_NEW",
            "failure_family": failure_family,
            "egress_identity_generation": identity_generation,
            "recovery_samples": 0,
            "first_failed_observation_monotonic_ns": (
                int(previous.get("first_failed_observation_monotonic_ns") or 0)
                if continuous
                and str(previous.get("monotonic_clock_domain") or "") == str(monotonic_clock_domain or "")
                else int(observed_monotonic_ns or 0)
            ),
            "confirmed_hard_failure_monotonic_ns": (
                int(previous.get("confirmed_hard_failure_monotonic_ns") or 0)
                if continuous
                and str(previous.get("monotonic_clock_domain") or "") == str(monotonic_clock_domain or "")
                else 0
            ),
        })
        if continuous:
            for key in (
                "failure_event_emitted_episode_id", "failure_event_id",
                "failure_event_emitted_at", "source_incident_id",
            ):
                if previous.get(key):
                    result[key] = previous[key]
        elif previous_failed and previous.get("failure_episode_id"):
            result.update({
                "expired_failure_episode_id": str(previous.get("failure_episode_id") or ""),
                "expired_failure_event_id": str(previous.get("failure_event_id") or ""),
                "expired_source_incident_id": str(previous.get("source_incident_id") or ""),
                "previous_failure_family": str(previous.get("failure_family") or ""),
                "episode_expired_at": observed_at,
                "episode_expiry_reason": "OBSERVATION_GAP_OR_IDENTITY_OR_FAILURE_FAMILY_CHANGE",
            })
        return result

    prior_episode = str(previous.get("failure_episode_id") or "")
    prior_event_id = str(previous.get("failure_event_id") or "")
    recovering = bool(prior_episode or previous_failed)
    result.update({
        "failure_episode_id": "",
        "failure_started_at": "",
        "last_failure_at": str(previous.get("last_failure_at") or ""),
        "failure_samples": 0,
        "consecutive_failures": 0,
        "bad_for_seconds": 0.0,
        "failure_state": "RECOVERY_OBSERVED" if recovering else "HEALTHY",
        "recovery_from_episode_id": prior_episode,
        "recovery_from_event_id": prior_event_id,
        "recovered_at": observed_at if recovering else "",
        "failure_family": "NONE",
        "previous_failure_family": str(previous.get("failure_family") or ""),
        "egress_identity_generation": identity_generation,
        "source_incident_id": str(previous.get("source_incident_id") or ""),
        "recovery_samples": max(0, int(previous.get("recovery_samples") or 0)) + 1 if recovering else 0,
        "first_failed_observation_monotonic_ns": 0,
        "confirmed_hard_failure_monotonic_ns": 0,
    })
    return result


def route_class_fitness(matrix: dict[str, Any]) -> dict[str, Any]:
    services = matrix.get("services") or {}
    fitness: dict[str, Any] = {}
    for route_class, service_ids in ROUTE_CLASS_SERVICE_MAP.items():
        tested = []
        missing = []
        for service_id in service_ids:
            row = services.get(service_id)
            if row:
                tested.append(row)
            else:
                missing.append(service_id)
        ok_count = sum(1 for row in tested if bool(row.get("ok")))
        fail_count = len(tested) - ok_count
        telegram_row = services.get("telegram") if "telegram" in service_ids else None
        telegram_status = str((telegram_row or {}).get("status") or "").upper()
        telegram_hard_down = bool(telegram_row) and (
            telegram_status_is_hard(telegram_status)
            or ((telegram_row or {}).get("ok") is False and telegram_status in ("", "FAIL", "ERROR"))
        )
        telegram_soft_down = bool(telegram_row) and telegram_status in TELEGRAM_SOFT_STATUSES
        latencies = []
        for row in tested:
            value = row.get("first_byte_sec", row.get("total_sec", 0))
            latency = to_float(value)
            if latency > 0:
                latencies.append(latency)
        if not tested:
            status = "UNKNOWN"
            reason = "ещё не проверялось"
        elif telegram_hard_down:
            status = "FAIL"
            reason = "Telegram обязателен для пользователей и сейчас недоступен через этот канал"
        elif ok_count == len(tested) and not missing and not telegram_soft_down:
            status = "OK"
            reason = "все обязательные сервисы прошли проверку"
        elif telegram_soft_down:
            status = "WARN"
            reason = "Telegram работает нестабильно, канал можно держать, но не выбирать как лучший"
        elif ok_count and fail_count == 0:
            status = "WARN"
            reason = "проверенные сервисы работают, но часть ещё не проверялась"
        elif any(row.get("status") == "NOT_STARTED" for row in tested):
            status = "NOT_STARTED"
            reason = "канал не запущен на сервере V7"
        elif ok_count:
            status = "WARN"
            reason = "часть сервисов работает, часть не прошла проверку"
        else:
            status = "FAIL"
            reason = "проверенные сервисы не прошли проверку"
        fitness[route_class] = {
            "status": status,
            "reason": reason,
            "ok_count": ok_count,
            "tested_count": len(tested),
            "missing_count": len(missing),
            "total": len(service_ids),
            "avg_first_byte_sec": round(sum(latencies) / len(latencies), 3) if latencies else None,
            "services": list(service_ids),
            "missing": missing,
        }
    return fitness


def run_curl_check(service_id: str, meta: dict[str, Any], iface: str, timeout: int) -> dict[str, Any]:
    url = meta.get("url")
    started = time.time()
    cmd = [
        "curl",
        "--interface", iface,
        "-A", HTTP_USER_AGENT,
        "-L",
        "-o", "/dev/null",
        "-w", "%{http_code} %{time_starttransfer} %{time_total}",
        "--connect-timeout", str(max(2, min(timeout, 10))),
        "--max-time", str(timeout),
        "-fsS",
        str(url),
    ]
    try:
        proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout + 3)
        output = (proc.stdout or "").strip()
        stderr = (proc.stderr or "").strip()
        rc = proc.returncode
    except subprocess.TimeoutExpired as exc:
        output = (exc.stdout or "") if isinstance(exc.stdout, str) else ""
        stderr = (exc.stderr or "") if isinstance(exc.stderr, str) else ""
        output = (output + "\ntimeout").strip()
        rc = 124
    parts = output.split()
    http_code = parts[0] if parts else ""
    first_byte = parts[1] if len(parts) > 1 else ""
    total = parts[2] if len(parts) > 2 else ""
    http_reachable = http_code.startswith(("2", "3")) or http_code in HTTP_REACHABLE_CODES
    limited = http_code in HTTP_REACHABLE_CODES
    ok = http_reachable
    reason_blob = "\n".join(part for part in (stderr, output) if part).strip()
    reason = (
        f"HTTP {http_code}: endpoint reached but returned an application/CDN limit"
        if limited else ("" if ok else (reason_blob[-500:] or f"curl_rc_{rc}"))
    )
    return {
        "label": meta.get("label", service_id),
        "kind": "http",
        "url": url,
        "interface": iface,
        "ok": ok,
        "status": "HTTP_LIMITED" if limited else ("OK" if ok else "FAIL"),
        "severity": "WARN" if limited else ("OK" if ok else "FAIL"),
        "http_reachable": http_reachable,
        "limited": limited,
        "http_code": http_code,
        "first_byte_sec": first_byte,
        "total_sec": total,
        "rc": rc,
        "elapsed_sec": round(time.time() - started, 3),
        "tested_at": now_iso(),
        "reason": reason,
        "error": reason,
        "samples": [{
            "target": url,
            "ok": ok,
            "http_code": http_code,
            "first_byte_sec": first_byte,
            "total_sec": total,
            "rc": rc,
            "error": reason,
        }],
    }


def bind_to_device(sock: socket.socket, iface: str) -> str:
    if not iface:
        return ""
    try:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BINDTODEVICE, iface.encode("utf-8") + b"\0")
        return ""
    except AttributeError:
        return "so_bindtodevice_unavailable"
    except OSError as exc:
        return f"bind_interface_failed:{exc}"


def tcp_connect_sample(host: str, port: int, iface: str, timeout: float, required: bool) -> dict[str, Any]:
    started = time.time()
    sample: dict[str, Any] = {
        "target": f"{host}:{port}",
        "host": host,
        "port": port,
        "required": required,
        "interface": iface,
        "ok": False,
    }
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(timeout)
    bind_error = bind_to_device(sock, iface)
    if bind_error:
        sample["bind_error"] = bind_error
        try:
            sock.close()
        except OSError:
            pass
        return sample
    try:
        sock.connect((host, port))
        sample["ok"] = True
        sample["connect_ms"] = round((time.time() - started) * 1000.0, 1)
        local = sock.getsockname()
        if local:
            sample["source_ip"] = local[0]
            sample["source_port"] = local[1]
    except socket.timeout:
        sample["error"] = "timeout"
        sample["connect_ms"] = round((time.time() - started) * 1000.0, 1)
    except OSError as exc:
        sample["error"] = f"{exc.__class__.__name__}: {exc}"
        sample["connect_ms"] = round((time.time() - started) * 1000.0, 1)
    finally:
        try:
            sock.close()
        except OSError:
            pass
    return sample


def run_telegram_check(iface: str, timeout: int) -> dict[str, Any]:
    started = time.time()
    per_endpoint_timeout = max(1.0, min(float(timeout), 4.0))
    samples: list[dict[str, Any]] = []
    with ThreadPoolExecutor(max_workers=len(TELEGRAM_ENDPOINTS) or 1) as pool:
        futures = [
            pool.submit(tcp_connect_sample, host, port, iface, per_endpoint_timeout, required)
            for host, port, required in TELEGRAM_ENDPOINTS
        ]
        for future in as_completed(futures):
            try:
                samples.append(future.result())
            except Exception as exc:
                samples.append({
                    "target": "telegram",
                    "ok": False,
                    "error": f"{exc.__class__.__name__}: {exc}",
                })
    ok_count = sum(1 for row in samples if row.get("ok"))
    required = [row for row in samples if row.get("required")]
    required_ok = sum(1 for row in required if row.get("ok"))
    failed = [row for row in samples if not row.get("ok")]
    required_failed = [row for row in required if not row.get("ok")]
    ratio = ok_count / len(samples) if samples else 0.0
    strong_ok = not required_failed and ratio >= 0.80
    down = ratio <= 0.20
    status = "OK" if strong_ok else ("DOWN" if down else "DEGRADED")
    ok = status in ("OK", "DEGRADED")
    score = 100 if status == "OK" else max(0, min(79, int(round(ratio * 100))))
    connect_values = [to_float(row.get("connect_ms")) for row in samples if row.get("ok") and to_float(row.get("connect_ms")) > 0]
    first_ms = min(connect_values) if connect_values else 0.0
    reason = "all telegram samples connected" if ok else "; ".join(
        f"{row.get('target')}={row.get('error') or row.get('bind_error') or 'failed'}"
        for row in failed[:5]
    )
    return {
        "label": "Telegram",
        "kind": "telegram_tcp",
        "interface": iface,
        "ok": ok,
        "status": status,
        "severity": "OK" if status == "OK" else ("WARN" if status == "DEGRADED" else "FAIL"),
        "score": score,
        "ratio": round(ratio, 3),
        "first_byte_sec": round(first_ms / 1000.0, 3) if first_ms else "",
        "total_sec": round(time.time() - started, 3),
        "tested_at": now_iso(),
        "ok_count": ok_count,
        "total": len(samples),
        "required_ok_count": required_ok,
        "required_total": len(required),
        "failed_count": len(failed),
        "required_failed_count": len(required_failed),
        "reason": reason,
        "error": "" if ok else reason,
        "samples": samples,
    }


def run_service(service_id: str, iface: str, timeout: int) -> dict[str, Any]:
    meta = SERVICE_CATALOG.get(service_id)
    if not meta:
        return {
            "label": service_id,
            "ok": False,
            "status": "UNKNOWN_SERVICE",
            "severity": "WARN",
            "tested_at": now_iso(),
            "reason": "service is not in builtin catalog",
        }
    if meta.get("kind") == "telegram_tcp":
        return run_telegram_check(iface, timeout)
    return run_curl_check(service_id, meta, iface, timeout)


def services_to_run(service: str) -> list[str]:
    if not service or service == "all":
        return list(SERVICE_CATALOG.keys())
    return [service]


def exact_services_to_run(service: str, services: str) -> list[str]:
    """Return one exact bounded service subset through the existing owner.

    The legacy positional service remains authoritative when ``--services`` is
    absent.  A comma-separated subset lets the governed verifier reuse the
    existing parallel probe executor and perform one lock/write lifecycle,
    rather than spawning one complete Matrix process per service.
    """
    if not services:
        return services_to_run(service)
    requested: list[str] = []
    for raw in services.split(","):
        service_id = safe_id(raw.strip(), SAFE_SERVICE_RE)
        if not service_id or service_id not in SERVICE_CATALOG:
            raise ValueError(f"invalid_service_subset:{raw.strip()}")
        if service_id not in requested:
            requested.append(service_id)
    if not requested:
        raise ValueError("empty_service_subset")
    return requested


def update_matrix(
    matrix_file: Path,
    egress_id: str,
    iface: str,
    results: dict[str, Any],
    lock_timeout_sec: int,
    *,
    event_dir: Optional[Path] = None,
    persistence_samples: int = 3,
    persistence_window_seconds: int = 180,
    egress_identity: Optional[dict[str, str]] = None,
    state_dir: Optional[Path] = None,
) -> tuple[dict[str, Any], dict[str, Any]]:
    with service_matrix_writer_lock(matrix_file, lock_timeout_sec) as lock_info:
        data = read_json(matrix_file, {"items": {}})
        if not isinstance(data, dict):
            data = {"items": {}}
        items = data.setdefault("items", {})
        row = items.setdefault(egress_id, {})
        services = row.setdefault("services", {})
        observed_at = now_iso()
        observation_monotonic_ns = time.monotonic_ns()
        observation_clock_domain = monotonic_clock_domain_id()
        scope_snapshot = source_scope_snapshot(
            state_dir or matrix_file.parent,
            egress_id,
            observed_at=observed_at,
        )
        events: list[dict[str, Any]] = []
        recovery_events: list[dict[str, Any]] = []
        event_path = (event_dir or DEFAULT_EVENT_DIR) / "service-failure-events.jsonl"
        identity = dict(egress_identity or canonical_egress_identity(
            {}, egress_id=egress_id, iface=iface,
        ))
        for service_id, observed in results.items():
            previous = services.get(service_id) if isinstance(services.get(service_id), dict) else {}
            merged = service_failure_episode(
                previous,
                observed if isinstance(observed, dict) else {},
                egress_id=egress_id,
                service_id=service_id,
                observed_at=str(observed.get("tested_at") or observed_at) if isinstance(observed, dict) else observed_at,
                observed_monotonic_ns=observation_monotonic_ns,
                monotonic_clock_domain=observation_clock_domain,
                identity_generation=str(identity.get("egress_identity_generation") or ""),
            )
            merged.update(identity)
            if str(merged.get("expired_failure_episode_id") or ""):
                expiry_event_id = "sxe_" + hashlib.sha256(
                    (
                        "v7.service-failure-expiry-event.v1|"
                        f"{merged.get('expired_failure_episode_id')}|{merged.get('episode_expired_at')}"
                    ).encode("utf-8")
                ).hexdigest()[:32]
                events.append({
                    "schema_version": "v7.service-failure-expiry-event.v1",
                    "event_id": expiry_event_id,
                    "event_type": "SERVICE_FAILURE_EPISODE_EXPIRED",
                    "capture_only": True,
                    "event_provenance": "EXTERNAL_UNATTRIBUTED",
                    "evidence_class": "PROBE_OBSERVED_EPISODE_EXPIRY",
                    "natural_production_credit": False,
                    "channel": egress_id,
                    "service": service_id,
                    "failure_episode_id": str(merged.get("expired_failure_episode_id") or ""),
                    "failure_event_id": str(merged.get("expired_failure_event_id") or ""),
                    "source_incident_id": str(merged.get("expired_source_incident_id") or ""),
                    "failure_family": str(merged.get("previous_failure_family") or ""),
                    "expired_at": str(merged.get("episode_expired_at") or observed_at),
                    "expiry_reason": str(merged.get("episode_expiry_reason") or ""),
                    **identity,
                    "source_files": [str(matrix_file)],
                    "producer": "tools/v7-service-matrix-test.update_matrix",
                    "next_consumer": "tools/v7-users-autoswitch._consume_passive_production_events",
                    "candidate_or_execution_forbidden": True,
                })
            if (
                merged.get("failure_state") == "RECOVERY_OBSERVED"
                and str(merged.get("recovery_from_event_id") or "")
            ):
                recovery_event_id = "sre_" + hashlib.sha256(
                    (
                        "v7.service-recovery-event.v1|"
                        f"{merged['recovery_from_event_id']}|{merged.get('recovered_at')}"
                    ).encode("utf-8")
                ).hexdigest()[:32]
                recovery_events.append({
                    "schema_version": "v7.service-recovery-event.v1",
                    "event_id": recovery_event_id,
                    "event_type": "SERVICE_RECOVERY_OBSERVED",
                    "capture_only": True,
                    "event_provenance": "EXTERNAL_UNATTRIBUTED",
                    "evidence_class": "PROBE_OBSERVED_RECOVERY_EVENT",
                    "natural_production_credit": False,
                    "channel": egress_id,
                    "service": service_id,
                    "failure_episode_id": str(merged.get("recovery_from_episode_id") or ""),
                    "failure_event_id": str(merged.get("recovery_from_event_id") or ""),
                    "source_incident_id": str(merged.get("source_incident_id") or ""),
                    "failure_family": str(merged.get("previous_failure_family") or ""),
                    "recovered_at": str(merged.get("recovered_at") or observed_at),
                    **identity,
                    "source_files": [str(matrix_file)],
                    "producer": "tools/v7-service-matrix-test.update_matrix",
                    "next_consumer": "tools/v7-users-autoswitch._consume_passive_production_events",
                    "candidate_or_execution_forbidden": True,
                })
                merged["recovery_event_id"] = recovery_event_id
                merged["episode_terminal"] = "RECOVERED"
            services[service_id] = merged

        persistent_rows = {
            service_id: service_row
            for service_id, service_row in services.items()
            if service_failure_observed(service_row)
            and (
                int(service_row.get("failure_samples") or 0) >= max(1, int(persistence_samples or 3))
                or to_float(service_row.get("bad_for_seconds")) >= max(1, int(persistence_window_seconds or 180))
            )
        }
        # A source incident is open while *any* correlated service remains
        # persistently failed.  Do not let one recovered component emit a
        # source-level recovery event that closes the incident underneath the
        # continuing-failure / CT-M0F consumer path.
        if not persistent_rows:
            events.extend(recovery_events)
        for merged in persistent_rows.values():
            if int(merged.get("confirmed_hard_failure_monotonic_ns") or 0) <= 0:
                # A pre-upgrade continuing incident has no reboot-scoped
                # confirmation timestamp.  The first post-upgrade persistent
                # observation is the honest new confirmation boundary; never
                # infer it from historical UTC.
                merged["confirmed_hard_failure_monotonic_ns"] = observation_monotonic_ns
                merged["monotonic_clock_domain"] = observation_clock_domain
                if int(merged.get("first_failed_observation_monotonic_ns") or 0) <= 0:
                    merged["first_failed_observation_monotonic_ns"] = observation_monotonic_ns
        incident_started_at = min(
            (str(item.get("failure_started_at") or observed_at) for item in persistent_rows.values()),
            default=observed_at,
        )
        source_incident_id = "sfinc_" + hashlib.sha256(
            (
                "v7.service-failure-source-incident.v1|"
                f"{egress_id}|{identity.get('egress_identity_generation')}|{incident_started_at}"
            ).encode("utf-8")
        ).hexdigest()[:32]
        fresh_failure_event_emitted = False
        for service_id, merged in persistent_rows.items():
            previous = (
                (row.get("services") or {}).get(service_id)
                if isinstance((row.get("services") or {}).get(service_id), dict)
                else {}
            )
            persistent = (
                service_failure_observed(merged)
                and (
                    int(merged.get("failure_samples") or 0) >= max(1, int(persistence_samples or 3))
                    or to_float(merged.get("bad_for_seconds")) >= max(1, int(persistence_window_seconds or 180))
                )
            )
            episode_id = str(merged.get("failure_episode_id") or "")
            if persistent and episode_id and str(previous.get("failure_event_emitted_episode_id") or "") != episode_id:
                event_id = "sfe_" + hashlib.sha256(
                    f"v7.service-failure-event.v1|{egress_id}|{service_id}|{episode_id}".encode("utf-8")
                ).hexdigest()[:32]
                merged["failure_event_emitted_episode_id"] = episode_id
                merged["failure_event_id"] = event_id
                merged["failure_event_emitted_at"] = observed_at
                merged["source_incident_id"] = source_incident_id
                merged["confirmed_hard_failure_monotonic_ns"] = observation_monotonic_ns
                fresh_failure_event_emitted = True
                events.append({
                    "schema_version": "v7.service-failure-event.v3",
                    "event_id": event_id,
                    "event_type": "SERVICE_FAILURE_OBSERVED",
                    "capture_only": True,
                    "event_provenance": "EXTERNAL_UNATTRIBUTED",
                    "evidence_class": "PROBE_OBSERVED_PRODUCTION_EVENT",
                    "natural_production_credit": False,
                    "channel": egress_id,
                    "service": service_id,
                    "failure_episode_id": episode_id,
                    "source_incident_id": source_incident_id,
                    "failure_family": str(merged.get("failure_family") or "SERVICE_PROBE_FAILURE"),
                    "incident_started_at": incident_started_at,
                    "correlated_service_count": len(persistent_rows),
                    "correlated_services": sorted(persistent_rows),
                    "source_scope": scope_snapshot,
                    **identity,
                    "failure_samples": int(merged.get("failure_samples") or 0),
                    "bad_for_seconds": to_float(merged.get("bad_for_seconds")),
                    "observed_at": observed_at,
                    "monotonic_clock_domain": observation_clock_domain,
                    "first_failed_observation_monotonic_ns": int(merged.get("first_failed_observation_monotonic_ns") or 0),
                    "confirmed_hard_failure_monotonic_ns": observation_monotonic_ns,
                    "source_files": [str(matrix_file)],
                    "source_hashes": {
                        "service_row": hashlib.sha256(json.dumps(merged, ensure_ascii=False, sort_keys=True).encode("utf-8")).hexdigest(),
                    },
                    "producer": "tools/v7-service-matrix-test.update_matrix",
                    "next_consumer": "tools/v7-users-autoswitch._consume_passive_production_events",
                    "provenance_reconciliation_required": True,
                    "candidate_or_execution_forbidden": True,
                })
        # A continuing episode must remain observable after its initial event
        # has been consumed.  Reuse the existing Matrix JSONL producer and
        # passive consumer: one compact correlated revalidation event carries
        # a fresh observation generation, never a Candidate or execution
        # permission.  Without this, an old STOP_SAFE/expiry terminal could
        # hide a still-failing source until a wholly new outage occurred.
        revalidation_rows = [
            (service_id, merged)
            for service_id, merged in persistent_rows.items()
            if str(merged.get("failure_event_emitted_episode_id") or "")
            and str(merged.get("source_incident_id") or "") == source_incident_id
        ]
        if revalidation_rows and not fresh_failure_event_emitted:
            # A revalidation generation is an exact-once boundary for the
            # passive L3 consumer.  Keep stable probes of the same live scope
            # idempotent, but make a changed compact scope a new owner-backed
            # generation: otherwise the consumer retains a legacy denominator
            # even though the existing Matrix owner has observed the current
            # ordinary/certification partition.  This contains only counts and
            # fingerprints; users.registry remains the sole membership owner.
            def compact_scope_identity(scope: Any) -> dict[str, Any]:
                scope = scope if isinstance(scope, dict) else {}
                try:
                    count = int(scope.get("affected_scope_count"))
                except (TypeError, ValueError):
                    count = -1
                return {
                    "affected_scope_count": count,
                    "affected_scope_fingerprint": str(
                        scope.get("affected_scope_fingerprint") or ""
                    ),
                }

            revalidation_scope_identity = {
                "scope_classification": str(
                    scope_snapshot.get("scope_classification") or ""
                ),
                "ordinary_production_scope": compact_scope_identity(
                    scope_snapshot.get("ordinary_production_scope")
                ),
                "controlled_certification_scope": compact_scope_identity(
                    scope_snapshot.get("controlled_certification_scope")
                ),
            }
            revalidation_basis = {
                service_id: {
                    "episode_id": str(merged.get("failure_episode_id") or ""),
                    "family": str(merged.get("failure_family") or ""),
                    "observed_at": str(merged.get("last_failure_at") or ""),
                    "samples": int(merged.get("failure_samples") or 0),
                }
                for service_id, merged in sorted(revalidation_rows)
            }
            observation_generation = "sfrev_" + hashlib.sha256(
                json.dumps(
                    {
                        "source_incident_id": source_incident_id,
                        "identity_generation": identity.get("egress_identity_generation"),
                        "rows": revalidation_basis,
                        "current_compact_scope": revalidation_scope_identity,
                    },
                    ensure_ascii=True,
                    sort_keys=True,
                ).encode("utf-8")
            ).hexdigest()[:32]
            events.append({
                "schema_version": "v7.service-failure-revalidation-event.v1",
                "event_id": observation_generation,
                "event_type": "SERVICE_FAILURE_REVALIDATED",
                "capture_only": True,
                "event_provenance": "EXTERNAL_UNATTRIBUTED",
                "evidence_class": "PROBE_OBSERVED_PRODUCTION_EVENT",
                "natural_production_credit": False,
                "channel": egress_id,
                "service": "",
                "source_incident_id": source_incident_id,
                "observation_generation": observation_generation,
                "failure_family": "CORRELATED_CONTINUING_SERVICE_FAILURE",
                "failure_samples": max(int(row.get("failure_samples") or 0) for _, row in revalidation_rows),
                "bad_for_seconds": max(to_float(row.get("bad_for_seconds")) for _, row in revalidation_rows),
                "incident_started_at": incident_started_at,
                "correlated_service_count": len(revalidation_rows),
                "correlated_services": sorted(service_id for service_id, _ in revalidation_rows),
                "source_scope": scope_snapshot,
                **identity,
                "observed_at": max(str(row.get("last_failure_at") or observed_at) for _, row in revalidation_rows),
                "monotonic_clock_domain": observation_clock_domain,
                "first_failed_observation_monotonic_ns": min(
                    (int(row.get("first_failed_observation_monotonic_ns") or 0) for _, row in revalidation_rows if int(row.get("first_failed_observation_monotonic_ns") or 0) > 0),
                    default=0,
                ),
                "confirmed_hard_failure_monotonic_ns": max(
                    (int(row.get("confirmed_hard_failure_monotonic_ns") or 0) for _, row in revalidation_rows),
                    default=0,
                ),
                "source_files": [str(matrix_file)],
                "source_hashes": {
                    "correlated_matrix_observation": hashlib.sha256(
                        json.dumps(revalidation_basis, ensure_ascii=True, sort_keys=True).encode("utf-8")
                    ).hexdigest(),
                },
                "producer": "tools/v7-service-matrix-test.update_matrix",
                "next_consumer": "tools/v7-users-autoswitch._consume_passive_production_events",
                "provenance_reconciliation_required": True,
                "candidate_or_execution_forbidden": True,
            })
        for service_id in list(services):
            if service_id not in SERVICE_CATALOG:
                services.pop(service_id, None)
        total = len(services)
        ok_count = sum(1 for item in services.values() if bool(item.get("ok")))
        not_started = total > 0 and all(item.get("status") == "NOT_STARTED" for item in services.values())
        row.update({
            "egress": egress_id,
            "interface": iface,
            "updated": now_iso(),
            "checked_at": now_iso(),
            "ok_count": ok_count,
            "total": total,
            "count": total,
            "status": "NOT_STARTED" if not_started else ("OK" if total and ok_count == total else ("WARN" if ok_count else "FAIL")),
        })
        row["path_evidence"] = network_path_evidence(
            state_dir or matrix_file.parent,
            egress_row(state_dir or matrix_file.parent, egress_id),
            egress_id=egress_id,
            iface=iface,
            service_ids=sorted(services),
        )
        row["route_class_fitness"] = route_class_fitness(row)
        data["updated"] = now_iso()
        write_json_atomic(matrix_file, data)
        append_jsonl(event_path, events)
    return data, lock_info


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Run V7 egress service matrix diagnostics.")
    parser.add_argument("egress")
    parser.add_argument("service", nargs="?", default="all")
    parser.add_argument(
        "--services",
        default="",
        help="Exact comma-separated service subset; uses the existing parallel probe owner.",
    )
    parser.add_argument("--state-dir", default=str(DEFAULT_STATE_DIR))
    parser.add_argument("--matrix-file", default="")
    parser.add_argument("--event-dir", default=str(DEFAULT_EVENT_DIR))
    parser.add_argument("--failure-persistence-samples", type=int, default=3)
    parser.add_argument("--failure-persistence-window-seconds", type=int, default=180)
    parser.add_argument("--timeout", type=int, default=8)
    parser.add_argument("--lock-timeout-sec", type=int, default=DEFAULT_LOCK_WAIT_SECONDS)
    parser.add_argument("--interface", default="")
    parser.add_argument(
        "--path-evidence-only",
        action="store_true",
        help="Read and fingerprint the current probe path without probes or durable Matrix writes.",
    )
    parser.add_argument("--pretty", action="store_true")
    return parser


def main() -> int:
    main_entered_ns = time.monotonic_ns()
    usage_before = resource.getrusage(resource.RUSAGE_SELF)
    args = build_parser().parse_args()
    egress_id = safe_id(args.egress, SAFE_EGRESS_RE)
    service = safe_id(args.service, SAFE_SERVICE_RE) or "all"
    if not egress_id:
        print(json.dumps({"error": "invalid_egress"}, ensure_ascii=False))
        return 2

    state_dir = Path(args.state_dir)
    matrix_file = Path(args.matrix_file) if args.matrix_file else state_dir / "service-matrix.json"
    iface = args.interface.strip() or egress_interface(state_dir, egress_id)
    timeout = max(3, min(int(args.timeout or 8), 30))
    try:
        selected = exact_services_to_run(service, str(args.services or ""))
    except ValueError as exc:
        print(json.dumps({"error": str(exc)}, ensure_ascii=False))
        return 2
    row = egress_row(state_dir, egress_id)
    identity = canonical_egress_identity(row, egress_id=egress_id, iface=iface)
    if args.path_evidence_only:
        evidence = network_path_evidence(
            state_dir,
            row,
            egress_id=egress_id,
            iface=iface,
            service_ids=list(SERVICE_CATALOG),
        )
        print(json.dumps({
            "action": "service_matrix_path_evidence",
            "status": "PASS",
            "egress": egress_id,
            "interface": iface,
            "path_evidence": evidence,
            "runtime_behavior_changed": False,
            "users_moved": 0,
        }, ensure_ascii=False, indent=2 if args.pretty else None))
        return 0
    probes_started_ns = time.monotonic_ns()
    if interface_required(row) and not interface_live(iface):
        results = {service_id: not_started_result(service_id, iface) for service_id in selected}
    else:
        results = {}
        with ThreadPoolExecutor(max_workers=max(1, min(len(selected), 8))) as pool:
            futures = {pool.submit(run_service, service_id, iface, timeout): service_id for service_id in selected}
            for future in as_completed(futures):
                service_id = futures[future]
                try:
                    results[service_id] = future.result()
                except Exception as exc:
                    results[service_id] = {
                        "label": SERVICE_CATALOG.get(service_id, {}).get("label", service_id),
                        "ok": False,
                        "status": "ERROR",
                        "severity": "FAIL",
                        "tested_at": now_iso(),
                        "reason": f"{exc.__class__.__name__}: {exc}",
                        "error": f"{exc.__class__.__name__}: {exc}",
                    }
    probes_completed_ns = time.monotonic_ns()
    durable_write_started_ns = time.monotonic_ns()
    try:
        matrix, lock_info = update_matrix(
            matrix_file,
            egress_id,
            iface,
            results,
            int(args.lock_timeout_sec),
            event_dir=Path(args.event_dir),
            persistence_samples=max(1, int(args.failure_persistence_samples or 3)),
            persistence_window_seconds=max(1, int(args.failure_persistence_window_seconds or 180)),
            egress_identity=identity,
            state_dir=state_dir,
        )
    except TimeoutError:
        print(json.dumps({
            "action": "service_matrix_test",
            "egress": egress_id,
            "interface": iface,
            "service": service,
            "ok": False,
            "status": "LOCK_TIMEOUT",
            "matrix_file": str(matrix_file),
            "service_matrix_lock": {
                "held": False,
                "path": str(matrix_file.with_name("service-matrix.lock")),
                "timeout_sec": int(args.lock_timeout_sec),
                "runtime_behavior_changed": False,
                "users_moved": False,
            },
        }, ensure_ascii=False, indent=2 if args.pretty else None))
        return 2
    durable_write_completed_ns = time.monotonic_ns()
    row = (matrix.get("items") or {}).get(egress_id, {})
    payload = {
        "action": "service_matrix_test",
        "egress": egress_id,
        "interface": iface,
        "service": service,
        "updated": matrix.get("updated"),
        "ok_count": row.get("ok_count", 0),
        "total": row.get("total", 0),
        "status": row.get("status", "UNKNOWN"),
        "results": results,
        "matrix_file": str(matrix_file),
        "service_matrix_lock": lock_info,
        "performance_timeline": {
            "schema_version": "v7.service-matrix-probe-timing.v1",
            "clock_source": "time.monotonic_ns",
            "owner": "tools/v7-service-matrix-test",
            "selected_service_count": len(selected),
            "spans": [
                {
                    "stage": "python_module_initialization",
                    "duration_ms": round((main_entered_ns - PROCESS_STARTED_NS) / 1_000_000.0, 3),
                    "critical_path": True,
                },
                {
                    "stage": "service_probe_setup_and_parallel_attempts",
                    "duration_ms": round((probes_completed_ns - probes_started_ns) / 1_000_000.0, 3),
                    "critical_path": True,
                },
                {
                    "stage": "matrix_lock_and_durable_write",
                    "duration_ms": round((durable_write_completed_ns - durable_write_started_ns) / 1_000_000.0, 3),
                    "critical_path": True,
                },
            ],
            "probe_attempts": [
                {
                    "service": service_id,
                    "duration_ms": round(float((results.get(service_id) or {}).get("elapsed_sec") or (results.get(service_id) or {}).get("total_sec") or 0.0) * 1000.0, 3),
                    "status": str((results.get(service_id) or {}).get("status") or "UNKNOWN"),
                }
                for service_id in selected
            ],
            "process": {
                "user_cpu_ms": round((resource.getrusage(resource.RUSAGE_SELF).ru_utime - usage_before.ru_utime) * 1000.0, 3),
                "system_cpu_ms": round((resource.getrusage(resource.RUSAGE_SELF).ru_stime - usage_before.ru_stime) * 1000.0, 3),
                "voluntary_context_switches": max(0, resource.getrusage(resource.RUSAGE_SELF).ru_nvcsw - usage_before.ru_nvcsw),
                "involuntary_context_switches": max(0, resource.getrusage(resource.RUSAGE_SELF).ru_nivcsw - usage_before.ru_nivcsw),
            },
        },
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2 if args.pretty else None))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
