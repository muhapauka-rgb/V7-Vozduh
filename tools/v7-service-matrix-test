def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def monotonic_clock_domain_id() -> str:
    """Name the reboot-scoped monotonic clock shared by V7 processes."""
    try:
        boot_id = Path("/proc/sys/kernel/random/boot_id").read_text(encoding="utf-8").strip()
    except OSError:
        boot_id = "unknown"
    return f"linux-boot:{boot_id or 'unknown'}"


def read_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return default


def bool_value(value: Any, default: bool = False) -> bool:
    if value is None or value == "":
        return default
    return str(value).strip().lower() in ("1", "true", "yes", "on", "enabled")


def telegram_status_is_hard(status: Any) -> bool:
    value = str(status or "").upper()
    return value in TELEGRAM_HARD_STATUSES or value.startswith("TELEGRAM_DOWN_")


def write_json_atomic(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def append_jsonl(path: Path, rows: list[dict[str, Any]]) -> None:
    if not rows:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        for row in rows:
            handle.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")


@contextlib.contextmanager
def service_matrix_writer_lock(matrix_file: Path, timeout_sec: int):
    if os.environ.get("V7_SERVICE_MATRIX_LOCK_HELD") == "1":
        yield {"held": False, "inherited": True, "path": str(matrix_file.with_name("service-matrix.lock"))}
        return
    lock_path = matrix_file.with_name("service-matrix.lock")
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600)
    started = time.time()
    acquired = False
    try:
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                acquired = True
                break
            except BlockingIOError:
                if time.time() - started >= max(1, timeout_sec):
                    raise TimeoutError("service_matrix_lock_timeout")
                time.sleep(0.25)
        yield {"held": True, "inherited": False, "path": str(lock_path)}
    finally:
        if acquired:
            fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def parse_kv_line(line: str) -> dict[str, str]:
    row: dict[str, str] = {}
    for part in line.split():
        if "=" not in part:
            continue
        key, value = part.split("=", 1)
        row[key.strip()] = value.strip()
    return row


def parse_registry(path: Path) -> list[dict[str, str]]:
    rows: list[dict[str, str]] = []
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except FileNotFoundError:
        return rows
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        row = parse_kv_line(line)
        if row:
            rows.append(row)
    return rows


def source_scope_snapshot(state_dir: Path, egress_id: str, *, observed_at: str) -> dict[str, Any]:
    """Return the compact live source cohort owned by the existing registry.

    The Matrix event remains the only durable observation producer.  It stores
    neither a second user registry nor a raw user list: the latter stays with
    ``users.registry``.  Count and a deterministic fingerprint let downstream
    consumers prove that a continuing incident still has an accountable scope.
    """
    assigned = [
        row for row in parse_registry(state_dir / "users.registry")
        if str(row.get("ip") or "")
        and bool_value(row.get("enabled"), True)
        and str(row.get("current") or "") == str(egress_id)
    ]

    def compact_scope(users: list[str], scope_kind: str) -> dict[str, Any]:
        users = sorted(set(users))
        return {
            "affected_scope_count": len(users),
            "affected_scope_fingerprint": hashlib.sha256(
                json.dumps(
                    {
                        "source_channel": str(egress_id),
                        "scope_kind": scope_kind,
                        "users": users,
                    },
                    sort_keys=True,
                    separators=(",", ":"),
                ).encode("utf-8")
            ).hexdigest(),
            "raw_user_list_stored": False,
        }

    users = [str(row.get("ip") or "") for row in assigned]
    ordinary_users = [
        str(row.get("ip") or "") for row in assigned
        if not bool_value(row.get("certification_user"), False)
    ]
    certification_users = [
        str(row.get("ip") or "") for row in assigned
        if bool_value(row.get("certification_user"), False)
    ]
    if ordinary_users and certification_users:
        scope_classification = "MIXED_ORDINARY_AND_CERTIFICATION"
    elif ordinary_users:
        scope_classification = "ORDINARY_PRODUCTION_ONLY"
    elif certification_users:
        scope_classification = "CERTIFICATION_ONLY"
    else:
        scope_classification = "EMPTY"
    total_scope = compact_scope(users, "ALL_ASSIGNED")
    ordinary_scope = compact_scope(ordinary_users, "ORDINARY_PRODUCTION")
    certification_scope = compact_scope(
        certification_users, "CONTROLLED_CERTIFICATION",
    )
    return {
        "schema_version": "v7.service-failure-source-scope.v2",
        "observed_at": observed_at,
        "source_channel": str(egress_id),
        # Compatibility fields are the ordinary production denominator: this
        # is the only scope eligible for the ordinary failover consumer.
        # The complete observed source cohort remains explicitly preserved
        # below, so a service failure is never hidden merely because its
        # current members are certification identities.
        **ordinary_scope,
        "total_assigned_scope": total_scope,
        "scope_classification": scope_classification,
        "ordinary_production_scope": ordinary_scope,
        "controlled_certification_scope": certification_scope,
        "ordinary_customer_reclassification_allowed": False,
        "owner": "users.registry via tools/v7-service-matrix-test",
    }


