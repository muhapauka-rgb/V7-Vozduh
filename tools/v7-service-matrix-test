def failure_episode_continuity_seconds() -> int:
    """Derive continuity from the production timer and bounded batch contract.

    Two cadence intervals preserve one missed lifecycle observation.  Jitter,
    the full refresh batch budget and a bounded safety allowance are explicit
    inputs instead of an unexplained duration literal.
    """
    return (
        2 * SERVICE_MATRIX_CADENCE_SECONDS
        + SERVICE_MATRIX_RANDOMIZED_DELAY_SECONDS
        + SERVICE_MATRIX_BATCH_BUDGET_SECONDS
        + SERVICE_MATRIX_CONTINUITY_SAFETY_SECONDS
    )


