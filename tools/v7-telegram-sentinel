#!/usr/bin/env python3
"""
Fast Telegram sentinel for V7 egress channels.

This command is intentionally narrow: it checks only Telegram TCP reachability,
keeps a short bad-since state per egress, and marks Telegram as failed in
service-matrix.json only after the configured grace threshold. That gives the
regular guarded autoswitch engine a fresh, service-specific signal without
running the full service matrix every few seconds.
"""

import argparse
import contextlib
from concurrent.futures import ThreadPoolExecutor, as_completed
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import socket
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


DEFAULT_STATE_DIR = Path("/opt/v7/egress/state")
DEFAULT_EVENT_DIR = Path("/opt/v7/events")
DEFAULT_SENTINEL_FILE = DEFAULT_STATE_DIR / "telegram-sentinel.json"
DEFAULT_MATRIX_FILE = DEFAULT_STATE_DIR / "service-matrix.json"
DEFAULT_LOCK_WAIT_SECONDS = 90
SAFE_EGRESS_RE = re.compile(r"^[A-Za-z0-9_.-]{1,64}$")

TELEGRAM_ENDPOINTS = (
    ("api.telegram.org", 443),
    ("149.154.167.50", 443),
    ("149.154.175.50", 443),
    ("91.108.56.177", 443),
    ("194.221.250.50", 443),
)
TELEGRAM_CRITICAL_TARGETS = {"api.telegram.org:443"}
TELEGRAM_HARD_STATUSES = {"NOT_STARTED", "DOWN"}
TELEGRAM_SOFT_STATUSES = {"DEGRADED", "DOWN_GRACE", "GRACE"}

ROUTE_CLASS_SERVICE_MAP = {
    "GLOBAL_FAST": ("google", "google_auth", "telegram", "facebook", "chatgpt", "openai_auth", "claude", "anthropic"),
    "GLOBAL_STABLE": ("google", "google_auth", "telegram", "apple", "whatsapp", "chatgpt", "openai_auth", "claude", "anthropic"),
    "VIDEO_OPTIMIZED": ("youtube", "instagram", "spotify", "soundcloud"),
    "DIRECT_RU": (),
    "TRUSTED_RU_SENSITIVE": (),
    "LOW_LATENCY": ("google", "google_auth", "telegram"),
}


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def parse_ts(value: Any) -> float:
    try:
        return datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp()
    except Exception:
        return 0.0


def read_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return default


def write_json_atomic(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, path)


_SERVICE_MATRIX_OWNER: Any = None


def sha256_json(payload: Any) -> str:
    return hashlib.sha256(
        json.dumps(payload, ensure_ascii=True, sort_keys=True, separators=(",", ":")).encode("utf-8")
    ).hexdigest()


def service_matrix_owner() -> Any:
    """Load the existing canonical Matrix writer, never a parallel event owner."""
    global _SERVICE_MATRIX_OWNER
    if _SERVICE_MATRIX_OWNER is not None:
        return _SERVICE_MATRIX_OWNER
    candidates = (
        Path(__file__).with_name("v7-service-matrix-test"),
        Path("/usr/local/bin/v7-service-matrix-test"),
    )
    tool = next((path for path in candidates if path.exists()), None)
    if tool is None:
        raise FileNotFoundError("existing_service_matrix_owner_missing")
    # ``v7-service-matrix-test`` is an executable script rather than an import
    # package.  Its shared admin_core imports resolve from the repository root
    # in source and from /opt/v7 after safe deployment.
    root = tool.parent.parent
    root_text = str(root)
    inserted_root = False
    if root_text not in sys.path:
        sys.path.insert(0, root_text)
        inserted_root = True
    loader = importlib.machinery.SourceFileLoader(
        "v7_service_matrix_fast_signal_bridge", str(tool)
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        raise RuntimeError("existing_service_matrix_owner_unloadable")
    module = importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(module)
    finally:
        if inserted_root:
            try:
                sys.path.remove(root_text)
            except ValueError:
                pass
    _SERVICE_MATRIX_OWNER = module
    return module


def canonical_service_event_ids(event_dir: Path, *, channel: str = "") -> set[str]:
    """Read IDs from the existing Matrix event owner; never create a side store."""
    path = event_dir / "service-failure-events.jsonl"
    ids: set[str] = set()
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()[-2000:]
    except OSError:
        return ids
    for line in lines:
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(row, dict):
            continue
        if str(row.get("event_type") or "") not in {
            "SERVICE_FAILURE_OBSERVED", "SERVICE_FAILURE_REVALIDATED",
        }:
            continue
        if str(row.get("producer") or "") != "tools/v7-service-matrix-test.update_matrix":
            continue
        if channel and str(row.get("channel") or "") != channel:
            continue
        event_id = str(row.get("event_id") or "")
        if event_id:
            ids.add(event_id)
    return ids


def canonical_service_events(event_dir: Path, event_ids: set[str]) -> list[dict[str, Any]]:
    """Return bounded metadata for fresh events from the canonical owner."""
    if not event_ids:
        return []
    path = event_dir / "service-failure-events.jsonl"
    rows: list[dict[str, Any]] = []
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()[-2000:]
    except OSError:
        return rows
    for line in lines:
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(row, dict) or str(row.get("event_id") or "") not in event_ids:
            continue
        scope = row.get("source_scope") if isinstance(row.get("source_scope"), dict) else {}
        rows.append({
            "event_id": str(row.get("event_id") or ""),
            "event_type": str(row.get("event_type") or ""),
            "channel": str(row.get("channel") or ""),
            "source_incident_id": str(row.get("source_incident_id") or ""),
            "affected_scope_count": max(0, int(scope.get("affected_scope_count") or 0)),
        })
    return sorted(rows, key=lambda row: (row["event_id"], row["channel"]))


def wake_existing_matrix_consumer(events: list[dict[str, Any]]) -> dict[str, Any]:
    """Wake the deployed planner only for a new actionable canonical event.

    ``v7-autoswitch-planner.service`` is the existing periodic consumer.  A
    systemd start job only advances that owner; it creates neither a new timer
    nor an independent executor.  Revalidations and zero-scope sources remain
    on the normal periodic path to avoid wake storms.
    """
    actionable = [
        row for row in events
        if row.get("event_type") == "SERVICE_FAILURE_OBSERVED"
        and int(row.get("affected_scope_count") or 0) > 0
    ]
    if not actionable:
        return {
            "status": "NOT_REQUIRED_NO_NEW_ACTIONABLE_SOURCE_SCOPE",
            "ok": True,
            "requested": False,
            "events": events,
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
        }
    command = ["systemctl", "start", "--no-block", "v7-autoswitch-planner.service"]
    try:
        proc = subprocess.run(
            command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            check=False, timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "status": "STOP_SAFE_EXISTING_CONSUMER_WAKE_FAILED",
            "ok": False,
            "requested": True,
            "events": actionable,
            "error": f"{type(exc).__name__}:{exc}",
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
        }
    return {
        "status": "EXISTING_PLANNER_CONSUMER_WAKE_REQUESTED" if proc.returncode == 0 else "STOP_SAFE_EXISTING_CONSUMER_WAKE_FAILED",
        "ok": proc.returncode == 0,
        "requested": True,
        "events": actionable,
        "command": command,
        "returncode": proc.returncode,
        "output_tail": (proc.stdout or "")[-1000:],
        "runtime_mutation_performed": False,
        "routing_mutation_performed": False,
        "users_moved": 0,
    }


@contextlib.contextmanager
def inherited_matrix_writer_lock(owner: Any, matrix_file: Path):
    """Tell the canonical owner that this sentinel already holds its lock."""
    prior = os.environ.get("V7_SERVICE_MATRIX_LOCK_HELD")
    os.environ["V7_SERVICE_MATRIX_LOCK_HELD"] = "1"
    try:
        yield
    finally:
        if prior is None:
            os.environ.pop("V7_SERVICE_MATRIX_LOCK_HELD", None)
        else:
            os.environ["V7_SERVICE_MATRIX_LOCK_HELD"] = prior


@contextlib.contextmanager
def service_matrix_writer_lock(matrix_file: Path, timeout_sec: int):
    if os.environ.get("V7_SERVICE_MATRIX_LOCK_HELD") == "1":
        yield {
            "held": False,
            "inherited": True,
            "path": str(matrix_file.with_name("service-matrix.lock")),
            "waited_sec": 0.0,
            "held_sec": 0.0,
            "released": False,
        }
        return
    lock_path = matrix_file.with_name("service-matrix.lock")
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600)
    started = time.time()
    acquired = False
    lock_info = {
        "held": False,
        "inherited": False,
        "path": str(lock_path),
        "waited_sec": 0.0,
        "held_sec": 0.0,
        "released": False,
    }
    try:
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                acquired = True
                lock_info.update({
                    "held": True,
                    "waited_sec": round(time.time() - started, 3),
                })
                break
            except BlockingIOError:
                if time.time() - started >= max(1, timeout_sec):
                    raise TimeoutError("service_matrix_lock_timeout")
                time.sleep(0.25)
        held_started = time.time()
        yield lock_info
    finally:
        if acquired:
            lock_info["held_sec"] = round(time.time() - held_started, 3)
            fcntl.flock(fd, fcntl.LOCK_UN)
            lock_info["released"] = True
        os.close(fd)


def append_event(event_dir: Path, payload: dict[str, Any]) -> None:
    try:
        event_dir.mkdir(parents=True, exist_ok=True)
        path = event_dir / f"telegram-sentinel-{datetime.now(timezone.utc).strftime('%Y%m%d')}.jsonl"
        with path.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(payload, ensure_ascii=False, sort_keys=True) + "\n")
    except OSError:
        pass


def parse_kv_line(line: str) -> dict[str, str]:
    row: dict[str, str] = {}
    for part in line.split():
        if "=" not in part:
            continue
        key, value = part.split("=", 1)
        row[key.strip()] = value.strip()
    return row


def parse_registry(path: Path) -> list[dict[str, str]]:
    rows: list[dict[str, str]] = []
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except FileNotFoundError:
        return rows
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        row = parse_kv_line(line)
        if row.get("id"):
            rows.append(row)
    return rows


def bool_value(value: Any, default: bool = False) -> bool:
    if value is None or value == "":
        return default
    return str(value).strip().lower() in ("1", "true", "yes", "on", "enabled")


def telegram_status_is_hard(status: Any) -> bool:
    value = str(status or "").upper()
    return value in TELEGRAM_HARD_STATUSES or value.startswith("TELEGRAM_DOWN_")


def interface_live(iface: str) -> bool:
    return bool(iface and (Path("/sys/class/net") / iface).exists())


def bind_to_device(sock: socket.socket, iface: str) -> str:
    if not iface:
        return ""
    try:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BINDTODEVICE, iface.encode("utf-8") + b"\0")
        return ""
    except AttributeError:
        return "so_bindtodevice_unavailable"
    except OSError as exc:
        return f"bind_interface_failed:{exc}"


def tcp_sample(host: str, port: int, iface: str, timeout: float) -> dict[str, Any]:
    started = time.time()
    sample: dict[str, Any] = {
        "target": f"{host}:{port}",
        "host": host,
        "port": port,
        "interface": iface,
        "ok": False,
    }
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(timeout)
    bind_error = bind_to_device(sock, iface)
    if bind_error:
        sample["error"] = bind_error
        sock.close()
        return sample
    try:
        sock.connect((host, port))
        sample["ok"] = True
        sample["connect_ms"] = round((time.time() - started) * 1000.0, 1)
    except socket.timeout:
        sample["error"] = "timeout"
        sample["connect_ms"] = round((time.time() - started) * 1000.0, 1)
    except OSError as exc:
        sample["error"] = f"{exc.__class__.__name__}: {exc}"
        sample["connect_ms"] = round((time.time() - started) * 1000.0, 1)
    finally:
        try:
            sock.close()
        except OSError:
            pass
    return sample


def check_telegram(iface: str, timeout: float) -> dict[str, Any]:
    started = time.time()
    samples: list[dict[str, Any]] = []
    with ThreadPoolExecutor(max_workers=len(TELEGRAM_ENDPOINTS)) as pool:
        futures = [pool.submit(tcp_sample, host, port, iface, timeout) for host, port in TELEGRAM_ENDPOINTS]
        for future in as_completed(futures):
            samples.append(future.result())
    ok_count = sum(1 for row in samples if row.get("ok"))
    total = len(samples)
    ratio = ok_count / total if total else 0.0
    critical_ok = all(
        any(row.get("target") == target and row.get("ok") for row in samples)
        for target in TELEGRAM_CRITICAL_TARGETS
    )
    ok = ratio >= 0.80 and critical_ok
    down = ratio <= 0.20
    score = 100 if ok else max(0, min(79, int(round(ratio * 100))))
    failed = [row for row in samples if not row.get("ok")]
    if ok:
        reason = "telegram tcp endpoints reachable"
    elif down:
        reason = "; ".join(f"{row.get('target')}={row.get('error') or 'failed'}" for row in failed[:5])
    else:
        reason = f"telegram partially reachable: {ok_count}/{total} endpoints"
        if not critical_ok:
            reason += "; critical endpoint failed"
    latencies = [float(row.get("connect_ms") or 0) for row in samples if row.get("ok") and row.get("connect_ms")]
    return {
        "sample_ok": ok,
        "status": "OK" if ok else ("DOWN" if down else "DEGRADED"),
        "score": score,
        "ratio": round(ratio, 3),
        "critical_ok": critical_ok,
        "ok_count": ok_count,
        "total": total,
        "reason": reason,
        "samples": sorted(samples, key=lambda row: str(row.get("target") or "")),
        "first_byte_sec": round(min(latencies) / 1000.0, 3) if latencies else "",
        "total_sec": round(time.time() - started, 3),
    }


def check_telegram_rotating_sample(
    iface: str,
    timeout: float,
    *,
    sample_index: int,
    samples_per_cycle: int = 1,
) -> dict[str, Any]:
    """Run a bounded, rotating Telegram transport sample for V5.3 N2.

    One cycle does not claim an outage.  Consecutive failures must cover
    distinct targets before Matrix receives a persistent-failure observation.
    Rotating one target per cycle keeps the cost O(role-scoped egresses), not
    five sockets per egress per second.
    """
    count = max(1, min(int(samples_per_cycle or 1), len(TELEGRAM_ENDPOINTS)))
    start = max(0, int(sample_index or 0)) % len(TELEGRAM_ENDPOINTS)
    selected = [
        TELEGRAM_ENDPOINTS[(start + offset) % len(TELEGRAM_ENDPOINTS)]
        for offset in range(count)
    ]
    started = time.time()
    samples = [tcp_sample(host, port, iface, timeout) for host, port in selected]
    ok_count = sum(1 for row in samples if row.get("ok"))
    ok = ok_count == len(samples)
    latencies = [
        float(row.get("connect_ms") or 0)
        for row in samples if row.get("ok") and row.get("connect_ms")
    ]
    target_ids = [str(row.get("target") or "") for row in samples]
    return {
        "sample_ok": ok,
        "status": "OK" if ok else "DOWN",
        "score": 100 if ok else 0,
        "ratio": round(ok_count / len(samples), 3) if samples else 0.0,
        "critical_ok": ok,
        "ok_count": ok_count,
        "total": len(samples),
        "reason": (
            "telegram rotating tcp target reachable"
            if ok else "; ".join(
                f"{row.get('target')}={row.get('error') or 'failed'}"
                for row in samples if not row.get("ok")
            )
        ),
        "samples": samples,
        "sample_target_ids": target_ids,
        "sample_target_fingerprint": sha256_json(target_ids),
        "first_byte_sec": round(min(latencies) / 1000.0, 3) if latencies else "",
        "total_sec": round(time.time() - started, 3),
        "probe_budget": {
            "sockets": len(samples),
            "endpoint_samples_per_cycle": count,
            "rotation_index": start,
        },
    }


def route_class_fitness(matrix_row: dict[str, Any]) -> dict[str, Any]:
    services = matrix_row.get("services") or {}
    fitness: dict[str, Any] = {}
    for route_class, service_ids in ROUTE_CLASS_SERVICE_MAP.items():
        tested = [services[sid] for sid in service_ids if sid in services]
        missing = [sid for sid in service_ids if sid not in services]
        ok_count = sum(1 for row in tested if bool(row.get("ok")))
        fail_count = len(tested) - ok_count
        telegram_row = services.get("telegram") if "telegram" in service_ids else None
        telegram_status = str((telegram_row or {}).get("status") or "").upper()
        telegram_hard_down = bool(telegram_row) and (
            telegram_status_is_hard(telegram_status)
            or ((telegram_row or {}).get("ok") is False and telegram_status in ("", "FAIL", "ERROR"))
        )
        telegram_soft_down = bool(telegram_row) and telegram_status in TELEGRAM_SOFT_STATUSES
        if not tested:
            status = "UNKNOWN"
            reason = "not checked yet"
        elif telegram_hard_down:
            status = "FAIL"
            reason = "telegram is mandatory and unavailable"
        elif ok_count == len(tested) and not missing and not telegram_soft_down:
            status = "OK"
            reason = "all required services passed"
        elif telegram_soft_down:
            status = "WARN"
            reason = "telegram is degraded"
        elif ok_count and fail_count == 0:
            status = "WARN"
            reason = "checked services passed, some services are missing"
        elif ok_count:
            status = "WARN"
            reason = "some required services failed"
        else:
            status = "FAIL"
            reason = "required services failed"
        fitness[route_class] = {
            "status": status,
            "reason": reason,
            "ok_count": ok_count,
            "tested_count": len(tested),
            "missing_count": len(missing),
            "total": len(service_ids),
            "services": list(service_ids),
            "missing": missing,
        }
    return fitness


def merge_matrix_item(matrix: dict[str, Any], egress_id: str, iface: str, item: dict[str, Any]) -> None:
    if not isinstance(matrix, dict):
        return
    row = matrix.setdefault("items", {}).setdefault(egress_id, {})
    services = row.setdefault("services", {})
    previous = services.get("telegram") if isinstance(services.get("telegram"), dict) else {}
    services["telegram"] = {
        "label": "Telegram",
        "kind": "telegram_tcp_sentinel",
        "interface": iface,
        "ok": bool(item.get("matrix_ok")),
        "status": item.get("matrix_status") or item.get("status") or "UNKNOWN",
        "severity": (
            "OK" if item.get("matrix_status") == "OK"
            else "WARN" if item.get("matrix_status") in ("DEGRADED", "DOWN_GRACE", "GRACE")
            else "FAIL"
        ),
        "first_byte_sec": item.get("first_byte_sec", ""),
        "total_sec": item.get("total_sec", ""),
        "tested_at": item.get("checked_at") or now_iso(),
        "ok_count": item.get("ok_count", 0),
        "total": item.get("total", 0),
        "bad_for_seconds": item.get("bad_for_seconds", 0),
        "score": item.get("score", 0),
        "ratio": item.get("ratio", 0),
        "critical_ok": item.get("critical_ok", False),
        "threshold_seconds": item.get("threshold_seconds", 14),
        "reason": item.get("reason", ""),
        "error": "" if item.get("matrix_ok") else item.get("reason", ""),
        "samples": item.get("samples", []),
    }
    # Preserve the sentinel's threshold crossing for the canonical Matrix
    # episode owner.  The subsequent bridge may then use the known failed-since
    # time instead of restarting persistence at the hand-off boundary.
    if bool(item.get("blocked")):
        services["telegram"].update({
            "failure_started_at": str(item.get("bad_since") or item.get("checked_at") or now_iso()),
            "last_failure_at": str(item.get("checked_at") or now_iso()),
            "failure_samples": max(1, int(item.get("failure_samples") or 1)),
            "consecutive_failures": max(1, int(item.get("failure_samples") or 1)),
            "bad_for_seconds": float(item.get("bad_for_seconds") or 0.0),
        })
        # ``v7-service-matrix-test.update_matrix`` owns the episode and its
        # event identity.  The sentinel is only a fast observation producer;
        # replacing its intermediate service row must never erase the
        # canonical episode fields before that owner reads them.  Otherwise a
        # continuous failure is falsely reborn every four seconds and can
        # cause a wake storm instead of one exact incident lifecycle.
        for key in (
            "failure_episode_id", "failure_event_emitted_episode_id",
            "failure_event_id", "failure_event_emitted_at",
            "source_incident_id", "failure_family",
            "egress_identity_generation", "observed_at",
            "first_failed_observation_monotonic_ns",
            "confirmed_hard_failure_monotonic_ns", "monotonic_clock_domain",
        ):
            if previous.get(key) not in (None, ""):
                services["telegram"][key] = previous[key]
    total = len(services)
    ok_count = sum(1 for service in services.values() if bool(service.get("ok")))
    row.update({
        "egress": egress_id,
        "interface": iface,
        "updated": now_iso(),
        "checked_at": now_iso(),
        "ok_count": ok_count,
        "total": total,
        "count": total,
        "status": "OK" if total and ok_count == total else ("WARN" if ok_count else "FAIL"),
    })
    row["route_class_fitness"] = route_class_fitness(row)
    matrix["updated"] = now_iso()


def fast_signal_result(item: dict[str, Any]) -> dict[str, Any]:
    """Translate the existing sentinel result into the canonical service shape.

    The sentinel does not decide that an outage is actionable.  It only hands
    its bounded Telegram observation to ``v7-service-matrix-test.update_matrix``
    so failure episodes, source scope, persistence, recovery and event identity
    retain their one existing owner.
    """
    blocked = bool(item.get("blocked"))
    status = str(item.get("matrix_status") or item.get("status") or "UNKNOWN")
    failure_status = status if blocked and status.startswith("TELEGRAM_DOWN_") else (
        "DOWN" if blocked else (
        "DEGRADED" if status in {"DEGRADED", "DOWN_GRACE", "GRACE"} else "OK"
        )
    )
    reason = str(item.get("reason") or "")
    return {
        "label": "Telegram",
        "kind": "telegram_tcp_sentinel",
        "interface": str(item.get("interface") or ""),
        "ok": not blocked,
        "status": failure_status,
        "severity": "FAIL" if blocked else ("WARN" if failure_status == "DEGRADED" else "OK"),
        "score": int(item.get("score") or 0),
        "ratio": item.get("ratio", 0),
        "first_byte_sec": item.get("first_byte_sec", ""),
        "total_sec": item.get("total_sec", ""),
        "tested_at": str(item.get("checked_at") or now_iso()),
        "ok_count": int(item.get("ok_count") or 0),
        "total": int(item.get("total") or 0),
        "required_ok_count": 1 if bool(item.get("critical_ok")) else 0,
        "required_total": 1,
        "failed_count": max(0, int(item.get("total") or 0) - int(item.get("ok_count") or 0)),
        "required_failed_count": 0 if bool(item.get("critical_ok")) else 1,
        "reason": reason,
        "error": "" if not blocked else reason,
        "samples": list(item.get("samples") or []),
        "fast_signal_owner": "tools/v7-telegram-sentinel",
        "fast_signal_persistence_seconds": int(item.get("threshold_seconds") or 0),
        "failure_started_at": str(item.get("bad_since") or ""),
        "last_failure_at": str(item.get("checked_at") or ""),
        "failure_samples": max(1, int(item.get("failure_samples") or 1)) if blocked else 0,
        "consecutive_failures": max(1, int(item.get("failure_samples") or 1)) if blocked else 0,
        "bad_for_seconds": float(item.get("bad_for_seconds") or 0.0),
    }


def publish_fast_signal_to_canonical_matrix(
    *,
    state_dir: Path,
    matrix_file: Path,
    event_dir: Path,
    items: dict[str, Any],
    persistence_window_seconds: int,
    lock_timeout_sec: int,
) -> dict[str, Any]:
    """Publish only confirmed fast observations through the existing Matrix owner.

    No Candidate, Packet, lease, Planner, Runtime action or new durable store is
    created here.  This turns the pre-existing 4-second Telegram sentinel into
    a low-latency *producer* for the same source-bound failure events used by
    the ordinary Matrix -> governed failover chain.
    """
    confirmed = [
        item for item in items.values()
        if isinstance(item, dict) and bool(item.get("blocked"))
    ]
    if not confirmed:
        return {
            "schema_version": "v7.fast-signal-canonical-matrix-bridge.v1",
            "status": "NO_CONFIRMED_HARD_FAILURE",
            "ok": True,
            "published_channels": [],
            "events_created": 0,
            "candidate_created": False,
            "packet_created": False,
            "lease_created": False,
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
        }
    try:
        owner = service_matrix_owner()
    except Exception as exc:
        return {
            "schema_version": "v7.fast-signal-canonical-matrix-bridge.v1",
            "status": "STOP_SAFE_EXISTING_MATRIX_OWNER_UNAVAILABLE",
            "ok": False,
            "blockers": [f"{type(exc).__name__}:{exc}"],
            "published_channels": [],
            "candidate_created": False,
            "packet_created": False,
            "lease_created": False,
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
        }
    published: list[dict[str, Any]] = []
    try:
        # The sentinel already owns the writer lock at this point.  Reusing the
        # Matrix writer under that lock preserves a single atomic producer
        # transaction instead of creating a second event stream.
        with inherited_matrix_writer_lock(owner, matrix_file):
            for item in sorted(confirmed, key=lambda row: str(row.get("egress") or "")):
                channel = str(item.get("egress") or "")
                if not channel:
                    continue
                before_channel_event_ids = canonical_service_event_ids(
                    event_dir, channel=channel,
                )
                matrix, _lock = owner.update_matrix(
                    matrix_file,
                    channel,
                    str(item.get("interface") or channel),
                    {"telegram": fast_signal_result(item)},
                    max(1, int(lock_timeout_sec)),
                    event_dir=event_dir,
                    persistence_samples=1,
                    persistence_window_seconds=max(1, int(persistence_window_seconds)),
                    egress_identity=owner.canonical_egress_identity(
                        owner.egress_row(state_dir, channel),
                        egress_id=channel,
                        iface=str(item.get("interface") or channel),
                    ),
                    state_dir=state_dir,
                )
                service = (
                    ((matrix.get("items") or {}).get(channel) or {}).get("services")
                    or {}
                ).get("telegram") or {}
                new_event_ids = sorted(
                    canonical_service_event_ids(event_dir, channel=channel)
                    - before_channel_event_ids
                )
                published.append({
                    "channel": channel,
                    "failure_episode_id": str(service.get("failure_episode_id") or ""),
                    "failure_event_id": str(service.get("failure_event_id") or ""),
                    "source_incident_id": str(service.get("source_incident_id") or ""),
                    "failure_state": str(service.get("failure_state") or ""),
                    "confirmed_hard_failure_monotonic_ns": int(
                        service.get("confirmed_hard_failure_monotonic_ns") or 0
                    ),
                    "new_event_ids": new_event_ids,
                })
    except (OSError, TimeoutError, ValueError) as exc:
        return {
            "schema_version": "v7.fast-signal-canonical-matrix-bridge.v1",
            "status": "STOP_SAFE_CANONICAL_MATRIX_PUBLISH_FAILED",
            "ok": False,
            "blockers": [f"{type(exc).__name__}:{exc}"],
            "published_channels": published,
            "candidate_created": False,
            "packet_created": False,
            "lease_created": False,
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
        }
    return {
        "schema_version": "v7.fast-signal-canonical-matrix-bridge.v1",
        "status": "CONFIRMED_FAILURE_PUBLISHED_TO_EXISTING_MATRIX_OWNER",
        "ok": True,
        "producer": "tools/v7-telegram-sentinel",
        "canonical_event_owner": "tools/v7-service-matrix-test.update_matrix",
        "next_consumer": "existing v7-users-autoswitch / governed L3 consumer",
        "published_channels": published,
        "new_event_ids": sorted({
            event_id
            for row in published
            for event_id in (row.get("new_event_ids") or [])
            if isinstance(event_id, str) and event_id
        }),
        "new_events": canonical_service_events(
            event_dir,
            {
                event_id
                for row in published
                for event_id in (row.get("new_event_ids") or [])
                if isinstance(event_id, str) and event_id
            },
        ),
        "events_created": sum(len(row.get("new_event_ids") or []) for row in published),
        "candidate_created": False,
        "packet_created": False,
        "lease_created": False,
        "runtime_mutation_performed": False,
        "routing_mutation_performed": False,
        "users_moved": 0,
    }


def update_matrix_items(matrix_file: Path, items: dict[str, Any]) -> dict[str, Any]:
    matrix = read_json(matrix_file, {"items": {}})
    if not isinstance(matrix, dict):
        matrix = {"items": {}}
    for item in items.values():
        merge_matrix_item(matrix, str(item.get("egress") or ""), str(item.get("interface") or ""), item)
    write_json_atomic(matrix_file, matrix)
    return matrix


def update_matrix(matrix_file: Path, egress_id: str, iface: str, item: dict[str, Any]) -> dict[str, Any]:
    return update_matrix_items(matrix_file, {
        str(egress_id or ""): dict(item, egress=egress_id, interface=iface),
    })


def telegram_required_source_ids(state_dir: Path) -> set[str]:
    """Resolve active sources only from the existing user/profile contracts."""
    prefs = read_json(state_dir / "service-preferences.json", {})
    if not isinstance(prefs, dict) or not bool_value(prefs.get("enabled"), default=True):
        return set()
    user_prefs = prefs.get("users") if isinstance(prefs.get("users"), dict) else {}
    global_values = prefs.get("required_services") or []
    if isinstance(global_values, str):
        global_values = [item.strip() for item in global_values.split(",") if item.strip()]
    global_requires = "telegram" in {
        str(item).strip().lower() for item in global_values
    } if isinstance(global_values, list) else False
    try:
        user_lines = (state_dir / "users.registry").read_text(
            encoding="utf-8", errors="replace",
        ).splitlines()
    except OSError:
        user_lines = []
    sources: set[str] = set()
    for line in user_lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        row = parse_kv_line(line)
        if not bool_value(row.get("enabled"), default=True):
            continue
        source = str(row.get("current") or "").strip()
        identity = str(row.get("ip") or "").strip()
        profile = user_prefs.get(identity) if identity else None
        values = (
            (profile.get("required_services") or profile.get("services") or [])
            if isinstance(profile, dict)
            else []
        )
        if isinstance(values, str):
            values = [item.strip() for item in values.split(",") if item.strip()]
        requires = global_requires or (
            "telegram" in {str(item).strip().lower() for item in values}
            if isinstance(values, list) else False
        )
        if source and requires:
            sources.add(source)
    return sources


def egress_items(
    state_dir: Path,
    only: str,
    *,
    required_profiles_only: bool = False,
) -> list[dict[str, str]]:
    rows = parse_registry(state_dir / "egress.registry")
    required_sources = telegram_required_source_ids(state_dir) if required_profiles_only else set()
    result = []
    for row in rows:
        egress_id = str(row.get("id") or "")
        if only and egress_id != only:
            continue
        if not bool_value(row.get("enabled"), default=True):
            continue
        if required_profiles_only and egress_id not in required_sources:
            continue
        result.append(row)
    return result


def check_egress(row: dict[str, str], prior: dict[str, Any], args: argparse.Namespace) -> dict[str, Any]:
    egress_id = str(row.get("id") or "")
    iface = str(row.get("interface") or egress_id)
    checked_at = now_iso()
    threshold = int(args.threshold_seconds)
    item: dict[str, Any] = {
        "egress": egress_id,
        "interface": iface,
        "checked_at": checked_at,
        "threshold_seconds": threshold,
    }

    previous = prior.get(egress_id) if isinstance(prior.get(egress_id), dict) else {}
    type_requires_interface = row.get("type") == "interface"
    if type_requires_interface and not interface_live(iface):
        result = {
            "sample_ok": False,
            "status": "NOT_STARTED",
            "ok_count": 0,
            "total": len(TELEGRAM_ENDPOINTS),
            "reason": f"channel interface is not running: {iface}",
            "samples": [],
            "first_byte_sec": "",
            "total_sec": 0,
        }
    else:
        if int(args.endpoint_samples_per_cycle or 0) > 0:
            result = check_telegram_rotating_sample(
                iface,
                float(args.timeout),
                sample_index=max(0, int(previous.get("sample_sequence") or 0)),
                samples_per_cycle=int(args.endpoint_samples_per_cycle),
            )
        else:
            result = check_telegram(iface, float(args.timeout))
    item.update(result)

    status = str(result.get("status") or "")
    bad_now = status in ("DOWN", "NOT_STARTED")
    if bad_now:
        bad_since = str(previous.get("bad_since") or checked_at)
        bad_for = max(0.0, time.time() - parse_ts(bad_since))
        failure_samples = max(0, int(previous.get("failure_samples") or 0)) + 1
        prior_targets = [
            str(value) for value in (previous.get("failure_target_ids") or [])
            if str(value)
        ]
        current_targets = [
            str(value) for value in (result.get("sample_target_ids") or [])
            if str(value)
        ]
        failure_target_ids = list(dict.fromkeys(prior_targets + current_targets))[-8:]
    else:
        bad_since = ""
        bad_for = 0.0
        failure_samples = 0
        failure_target_ids = []
    sample_threshold = max(0, int(args.failure_samples or 0))
    distinct_target_count = len(set(failure_target_ids))
    if sample_threshold:
        blocked = bool(
            status == "DOWN"
            and failure_samples >= sample_threshold
            and distinct_target_count >= min(2, sample_threshold)
        )
    else:
        blocked = status == "NOT_STARTED" or (status == "DOWN" and bad_for >= threshold)
    if status == "NOT_STARTED":
        matrix_status = "SOURCE_LOCAL_FAILURE_DELEGATED" if sample_threshold else "NOT_STARTED"
    elif status == "DOWN" and blocked:
        matrix_status = f"TELEGRAM_DOWN_{threshold}S"
    elif status == "DOWN":
        matrix_status = "DOWN_GRACE"
    elif status == "DEGRADED":
        matrix_status = "DEGRADED"
    elif bad_now:
        matrix_status = "GRACE"
    else:
        matrix_status = "OK"
    item.update({
        "bad_now": bad_now,
        "bad_since": bad_since,
        "bad_for_seconds": round(bad_for, 1),
        "blocked": blocked,
        "matrix_ok": not blocked,
        "matrix_status": matrix_status,
        "failure_samples": failure_samples,
        "failure_target_ids": failure_target_ids,
        "distinct_failure_target_count": distinct_target_count,
        "sample_sequence": max(0, int(previous.get("sample_sequence") or 0)) + 1,
    })
    return item


def apply_correlated_telegram_guard(items: dict[str, Any]) -> dict[str, Any]:
    """Suppress source evacuation when all independently scoped paths fail.

    This is intentionally conservative.  A shared Telegram endpoint incident
    or host-wide probe problem becomes DEGRADED/STOP_SAFE and remains available
    to deep reconciliation; it never fans out into one action per source.
    """
    blocked = [item for item in items.values() if isinstance(item, dict) and item.get("blocked")]
    healthy = [item for item in items.values() if isinstance(item, dict) and item.get("sample_ok")]
    correlated = len(blocked) >= 2 and not healthy
    if correlated:
        for item in blocked:
            item.update({
                "blocked": False,
                "matrix_ok": True,
                "matrix_status": "DEGRADED",
                "correlated_failure": True,
                "correlated_failure_disposition": "STOP_SAFE_SHARED_TELEGRAM_EVIDENCE",
            })
    return {
        "status": (
            "STOP_SAFE_CORRELATED_TELEGRAM_FAILURE"
            if correlated else "SOURCE_SPECIFIC_OR_HEALTHY"
        ),
        "correlated": correlated,
        "blocked_source_count_before_guard": len(blocked),
        "healthy_source_count": len(healthy),
        "routing_mutation_performed": False,
        "users_moved": 0,
    }


def run_autoswitch(args: argparse.Namespace, blocked_items: list[dict[str, Any]]) -> dict[str, Any]:
    if args.no_autoswitch or not blocked_items:
        return {"started": False, "reason": "disabled_or_no_blocked_egress"}
    cmd = ["v7-users-autoswitch", "--mode", "guarded", "--apply", "--service", "telegram", "--route-class", "GLOBAL_STABLE", "--pretty"]
    if args.dry_run_autoswitch:
        cmd = ["v7-users-autoswitch", "--service", "telegram", "--route-class", "GLOBAL_STABLE", "--pretty"]
    try:
        proc = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False, timeout=75)
        return {
            "started": True,
            "dry_run": bool(args.dry_run_autoswitch),
            "rc": proc.returncode,
            "output_tail": (proc.stdout or "")[-4000:],
            "cmd": cmd,
        }
    except Exception as exc:
        return {
            "started": False,
            "reason": f"{exc.__class__.__name__}: {exc}",
            "cmd": cmd,
        }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Run fast Telegram reachability sentinel for V7 egress channels.")
    parser.add_argument("--state-dir", default=str(DEFAULT_STATE_DIR))
    parser.add_argument("--event-dir", default=str(DEFAULT_EVENT_DIR))
    parser.add_argument("--sentinel-file", default=str(DEFAULT_SENTINEL_FILE))
    parser.add_argument("--matrix-file", default=str(DEFAULT_MATRIX_FILE))
    parser.add_argument("--egress", default="", help="Limit to one egress id.")
    parser.add_argument(
        "--required-profiles-only",
        action="store_true",
        help=(
            "Probe only current sources of enabled profiles that declare "
            "Telegram required; source truth remains users.registry plus "
            "service-preferences.json."
        ),
    )
    parser.add_argument("--threshold-seconds", type=int, default=14)
    parser.add_argument(
        "--failure-samples",
        type=int,
        default=0,
        help="N2 consecutive failures required; zero preserves legacy time-threshold compatibility.",
    )
    parser.add_argument(
        "--endpoint-samples-per-cycle",
        type=int,
        default=0,
        help="N2 rotating endpoint count; zero preserves the legacy five-endpoint sample.",
    )
    parser.add_argument("--concurrency", type=int, default=8)
    parser.add_argument("--timeout", type=float, default=2.0, help="Per endpoint TCP timeout.")
    parser.add_argument("--autoswitch-cooldown-seconds", type=int, default=30)
    parser.add_argument("--lock-timeout-sec", type=int, default=DEFAULT_LOCK_WAIT_SECONDS)
    parser.add_argument("--no-autoswitch", action="store_true")
    parser.add_argument("--dry-run-autoswitch", action="store_true")
    parser.add_argument("--pretty", action="store_true")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    state_dir = Path(args.state_dir)
    matrix_file = Path(args.matrix_file)
    sentinel_file = Path(args.sentinel_file)
    event_dir = Path(args.event_dir)
    only = str(args.egress or "").strip()
    if only and not SAFE_EGRESS_RE.match(only):
        print(json.dumps({"error": "invalid_egress"}, ensure_ascii=False))
        return 2
    if not 0 <= int(args.failure_samples or 0) <= 10:
        print(json.dumps({"error": "failure_samples_out_of_range"}, ensure_ascii=False))
        return 2
    if not 0 <= int(args.endpoint_samples_per_cycle or 0) <= len(TELEGRAM_ENDPOINTS):
        print(json.dumps({"error": "endpoint_samples_per_cycle_out_of_range"}, ensure_ascii=False))
        return 2
    if not 1 <= int(args.concurrency or 0) <= 128:
        print(json.dumps({"error": "concurrency_out_of_range"}, ensure_ascii=False))
        return 2

    started = time.time()
    prior_state = read_json(sentinel_file, {"items": {}})
    prior_items = prior_state.get("items") or {}
    rows = egress_items(
        state_dir, only, required_profiles_only=bool(args.required_profiles_only),
    )
    items: dict[str, Any] = {}
    with ThreadPoolExecutor(max_workers=max(1, min(len(rows), int(args.concurrency)))) as pool:
        future_map = {pool.submit(check_egress, row, prior_items, args): row for row in rows}
        for future in as_completed(future_map):
            item = future.result()
            items[str(item.get("egress") or "")] = item
    correlated_guard = (
        apply_correlated_telegram_guard(items)
        if int(args.failure_samples or 0) > 0
        else {
            "status": "LEGACY_COMPATIBILITY_NOT_APPLIED",
            "correlated": False,
            "blocked_source_count_before_guard": sum(
                1 for item in items.values() if item.get("blocked")
            ),
            "healthy_source_count": sum(
                1 for item in items.values() if item.get("sample_ok")
            ),
            "routing_mutation_performed": False,
            "users_moved": 0,
        }
    )
    try:
        with service_matrix_writer_lock(matrix_file, int(args.lock_timeout_sec)) as lock_info:
            update_matrix_items(matrix_file, items)
            fast_signal_bridge = publish_fast_signal_to_canonical_matrix(
                state_dir=state_dir,
                matrix_file=matrix_file,
                event_dir=event_dir,
                items=items,
                persistence_window_seconds=int(args.threshold_seconds),
                lock_timeout_sec=int(args.lock_timeout_sec),
            )
    except TimeoutError as exc:
        print(json.dumps({
            "schema_version": 1,
            "error": str(exc),
            "service_matrix_lock": {
                "held": False,
                "timeout": True,
                "path": str(matrix_file.with_name("service-matrix.lock")),
                "timeout_sec": int(args.lock_timeout_sec),
            },
            "checked_egress": len(items),
            "users_moved": False,
            "autoswitch": {"started": False, "reason": "service_matrix_lock_timeout"},
            "fast_signal_bridge": {
                "status": "STOP_SAFE_SERVICE_MATRIX_LOCK_TIMEOUT",
                "ok": False,
                "candidate_created": False,
                "packet_created": False,
                "lease_created": False,
                "runtime_mutation_performed": False,
                "routing_mutation_performed": False,
                "users_moved": 0,
            },
        }, ensure_ascii=False, indent=2 if args.pretty else None))
        return 75

    blocked_items = [item for item in items.values() if item.get("blocked")]
    healthy_items = [item for item in items.values() if item.get("sample_ok")]
    last_autoswitch_at = str(prior_state.get("last_autoswitch_at") or "")
    cooldown_left = int(args.autoswitch_cooldown_seconds) - (time.time() - parse_ts(last_autoswitch_at)) if last_autoswitch_at else 0
    autoswitch = {"started": False, "reason": "no_blocked_egress_or_no_healthy_target"}
    if blocked_items and healthy_items and cooldown_left <= 0:
        autoswitch = run_autoswitch(args, blocked_items)
        if autoswitch.get("started"):
            last_autoswitch_at = now_iso()
    elif blocked_items and healthy_items and cooldown_left > 0:
        autoswitch = {"started": False, "reason": f"cooldown_active_{int(cooldown_left)}s"}

    payload = {
        "schema_version": 1,
        "updated": now_iso(),
        "threshold_seconds": int(args.threshold_seconds),
        "timeout_seconds": float(args.timeout),
        "failure_samples_required": int(args.failure_samples or 0),
        "endpoint_samples_per_cycle": int(args.endpoint_samples_per_cycle or 0),
        "concurrency_cap": int(args.concurrency),
        "elapsed_sec": round(time.time() - started, 3),
        "checked_egress": len(items),
        "role_scope": (
            "TELEGRAM_REQUIRED_ACTIVE_PROFILE_SOURCES"
            if args.required_profiles_only else "ALL_ENABLED_EGRESS_COMPATIBILITY"
        ),
        "blocked_egress": sorted(item.get("egress") for item in blocked_items),
        "healthy_egress": sorted(item.get("egress") for item in healthy_items),
        "last_autoswitch_at": last_autoswitch_at,
        "autoswitch": autoswitch,
        "correlated_failure_guard": correlated_guard,
        "fast_signal_bridge": fast_signal_bridge,
        "existing_consumer_wake": wake_existing_matrix_consumer(
            list(fast_signal_bridge.get("new_events") or [])
        ) if fast_signal_bridge.get("ok") else {
            "status": "NOT_REQUESTED_CANONICAL_EVENT_PUBLISH_NOT_READY",
            "ok": False,
            "requested": False,
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
        },
        "existing_consumer_handoff": {
            "schema_version": "v7.fast-signal-existing-consumer-handoff.v1",
            "status": (
                "READY_FOR_EXISTING_MATRIX_CONSUMER"
                if fast_signal_bridge.get("new_event_ids")
                else "NOT_REQUIRED_NO_NEW_CANONICAL_EVENT"
            ),
            "ok": True,
            "event_ids": list(fast_signal_bridge.get("new_event_ids") or []),
            # The legacy apply timer is deliberately held.  CPS names the
            # Matrix refresh owner as the lawful durable-successor consumer;
            # that owner may subsequently admit the existing governed
            # executor only after its independent live gates pass.
            "consumer": "existing v7-service-matrix-refresh-all -> existing governed CT-M0F consumer",
            "wake_owner": "v7-service-matrix-refresh.timer",
            "apply_timer_required": False,
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
        },
        "service_matrix_lock": lock_info,
        "items": items,
    }
    write_json_atomic(sentinel_file, payload)
    if blocked_items or autoswitch.get("started"):
        append_event(event_dir, {
            "ts": payload["updated"],
            "component": "telegram_sentinel",
            "blocked_egress": payload["blocked_egress"],
            "healthy_egress": payload["healthy_egress"],
            "autoswitch": autoswitch,
        })
    print(json.dumps(payload, ensure_ascii=False, indent=2 if args.pretty else None))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
