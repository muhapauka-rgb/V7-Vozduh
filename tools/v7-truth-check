CommandRunner = Callable[[list[str], Optional[Path], int], dict[str, Any]]


def run_command(cmd: list[str], cwd: Optional[Path] = None, timeout: int = 10) -> dict[str, Any]:
    try:
        proc = subprocess.run(
            cmd,
            cwd=str(cwd) if cwd else None,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            timeout=timeout,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        return {"ok": False, "rc": 127, "stdout": "", "stderr": str(exc)}
    return {
        "ok": proc.returncode == 0,
        "rc": proc.returncode,
        "stdout": proc.stdout.strip(),
        "stderr": proc.stderr.strip(),
    }


# This static remote reader is an adapter between two existing owners only:
# immutable production execution feedback and the compact L3 incident state.
# It makes no production mutation, does not invoke the planner, and returns
# one exact envelope for the existing source-CPS reconciliation consumer.
SERVICE_FAILURE_PRODUCTION_ENVELOPE_SCRIPT = r'''
import json
from pathlib import Path

state_dir = Path("/opt/v7/egress/state")
state = json.loads((state_dir / "l3-runtime-state.json").read_text(encoding="utf-8"))
records = [item for item in (state.get("incidents") or {}).values() if isinstance(item, dict)]
records = [item for item in records if item.get("source_incident_id") or item.get("incident_id")]
records.sort(key=lambda item: str(item.get("last_observed_at") or ""), reverse=True)
for record in records:
    feedback_id = str(record.get("last_execution_feedback_id") or "")
    scope = record.get("scope_accounting") if isinstance(record.get("scope_accounting"), dict) else {}
    if not feedback_id or str(scope.get("status") or "") != "ACCOUNTED":
        continue
    for line in reversed((state_dir / "execution-events.jsonl").read_text(encoding="utf-8").splitlines()):
        row = json.loads(line)
        if row.get("schema_version") != "v7.execution-outcome-record.v1" or row.get("feedback_id") != feedback_id:
            continue
        binding = row.get("service_failure_causal_binding") if isinstance(row.get("service_failure_causal_binding"), dict) else {}
        incident_id = str(record.get("source_incident_id") or record.get("incident_id") or "")
        if str(binding.get("source_incident_id") or "") != incident_id:
            continue
        row["incident_scope_accounting"] = scope
        row["source_cps_projection_provenance"] = {
            "execution_owner": "/opt/v7/egress/state/execution-events.jsonl",
            "compact_scope_owner": "/opt/v7/egress/state/l3-runtime-state.json",
            "incident_id": incident_id,
            "feedback_id": feedback_id,
            "read_only": True,
        }
        print(json.dumps(row, sort_keys=True))
        raise SystemExit(0)
raise SystemExit("no_accounted_packet_bound_service_failure_feedback")
'''.strip()


def fetch_accounted_service_failure_feedback(
    manifest: dict[str, Any], *, expected_incident_id: str = "", runner: CommandRunner = run_command,
) -> dict[str, Any]:
    """Read one current production Outcome plus matching L3 scope envelope."""
    host = str(manifest.get("production_ssh_target") or "").strip()
    if not re.fullmatch(r"[A-Za-z0-9._-]+", host):
        return {"ok": False, "errors": ["production_ssh_target_invalid"]}
    # SSH joins trailing arguments into a remote shell command.  Keep the
    # static script as one shell-quoted argument so the remote reader cannot
    # be split into shell statements or reinterpret its source text.
    command = ["ssh", host, f"python3 -c {shlex.quote(SERVICE_FAILURE_PRODUCTION_ENVELOPE_SCRIPT)}"]
    result = runner(command, None, 20)
    if not result.get("ok"):
        return {
            "ok": False,
            "errors": ["production_service_failure_envelope_unreadable"],
            "remote_read": {"host": host, "rc": result.get("rc"), "stderr": result.get("stderr", "")},
        }
    try:
        envelope = json.loads(str(result.get("stdout") or ""))
    except json.JSONDecodeError:
        return {
            "ok": False,
            "errors": ["production_service_failure_envelope_invalid_json"],
            "remote_read": {"host": host, "stdout": str(result.get("stdout") or "")[:300]},
        }
    actual_incident_id = str(((envelope.get("service_failure_causal_binding") or {}).get("source_incident_id") or ""))
    if expected_incident_id and actual_incident_id != expected_incident_id:
        return {
            "ok": False,
            "errors": ["production_service_failure_incident_identity_mismatch"],
            "remote_read": {"host": host, "expected_incident_id": expected_incident_id, "actual_incident_id": actual_incident_id},
        }
    return {
        "ok": True,
        "envelope": envelope,
        "remote_read": {
            "host": host,
            "read_only": True,
            "feedback_id": str(envelope.get("feedback_id") or ""),
            "source_incident_id": actual_incident_id,
        },
    }


def current_vless_incident_id(root: Path) -> str:
    """Return the exact active VLESS incident pointer from canonical CPS."""
    text = (root / "docs/programs/V7_CURRENT_PROGRAM_STATE.md").read_text(encoding="utf-8")
    live = sync_lib._markdown_field_table(sync_lib._markdown_section(
        text, "## 0. Authoritative Live Current State", "## Authoritative Unfinished Capability Closure Registry",
    ))
    incident = sync_lib._plain_live_value(live, "CURRENT_VLESS_SERVICE_INCIDENT")
    match = re.search(r"\bsource incident (sfinc_[0-9a-f]{32})\b", incident)
    return match.group(1) if match else ""


def current_matrix_owned_service_failure_successor(root: Path) -> dict[str, Any]:
    """Identify an exact CPS successor already owned by the production Matrix.

    A controlled-certification stage is independent from the legacy/current
    VLESS execution-feedback bridge.  Requiring that bridge first can select
    an older VLESS feedback envelope and create a false scope-generation
    blocker before the campaign's real consumer is acknowledged.
    """
    cps_path = root / "docs/programs/V7_CURRENT_PROGRAM_STATE.md"
    try:
        text = cps_path.read_text(encoding="utf-8")
    except OSError as exc:
        return {
            "matrix_owned": False,
            "frontier": "",
            "errors": [f"cps_unreadable:{exc}"],
        }
    live = sync_lib._markdown_field_table(sync_lib._markdown_section(
        text,
        "## 0. Authoritative Live Current State",
        "## Authoritative Unfinished Capability Closure Registry",
    ))
    frontier = sync_lib._plain_live_value(live, "CURRENT_NEXT_ACTION_ID")
    matrix_owned = sync_lib._matrix_runtime_successor_is_explicit(live)
    return {
        "matrix_owned": matrix_owned,
        "frontier": frontier,
        "consumer": "tools/v7-service-matrix-refresh-all" if matrix_owned else "",
        "errors": [],
    }


