def parse_kv_line(line: str) -> dict[str, str]:
    row: dict[str, str] = {}
    for part in line.split():
        if "=" not in part:
            continue
        key, value = part.split("=", 1)
        row[key.strip()] = value.strip()
    return row


def parse_registry(path: Path) -> list[dict[str, str]]:
    rows: list[dict[str, str]] = []
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except FileNotFoundError:
        return rows
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        row = parse_kv_line(line)
        if row:
            rows.append(row)
    return rows


CONTROLLED_CERTIFICATION_BASELINE_MAX_AGE_SECONDS = 3600


def read_flat_state(path: Path) -> dict[str, str]:
    """Read an existing compact key=value state owner without copying raw logs."""
    result: dict[str, str] = {}
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except FileNotFoundError:
        return result
    for line in lines:
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        if key:
            result[key] = value.strip()
    return result


def controlled_certification_source_health_status(
    state_dir: Path,
    source_id: str,
) -> dict[str, Any]:
    """Project a compact, fail-closed baseline from the existing Matrix owner.

    An empty source is isolated, but isolation is not reachability.  Controlled
    certification needs a healthy baseline before the existing condition owner
    can deliberately fail and later restore that source.  Keep service details
    with ``service-matrix.json`` and expose only counts plus a fingerprint here.
    """
    state_dir = Path(state_dir)
    matrix_path = state_dir / "service-matrix.json"
    matrix = read_json(matrix_path, {})
    items = matrix.get("items") if isinstance(matrix.get("items"), dict) else {}
    row = items.get(str(source_id or ""))
    row = row if isinstance(row, dict) else {}
    services = row.get("services") if isinstance(row.get("services"), dict) else {}
    matrix_updated = str(matrix.get("updated") or "")
    age_seconds = max(0.0, time.time() - parse_ts(matrix_updated)) if matrix_updated else -1.0
    fresh = bool(
        matrix_updated
        and age_seconds <= CONTROLLED_CERTIFICATION_BASELINE_MAX_AGE_SECONDS
    )
    hard_statuses = {"FAIL", "DOWN", "NOT_STARTED"}
    hard_failures = 0
    reachable = 0
    observations: list[dict[str, Any]] = []
    for service_id, value in sorted(services.items()):
        service = value if isinstance(value, dict) else {}
        status = str(service.get("status") or "").upper()
        ok = bool_value(service.get("ok"))
        hard = status in hard_statuses or status.startswith("TELEGRAM_DOWN_")
        if hard:
            hard_failures += 1
        if ok and not hard:
            reachable += 1
        observations.append({
            "service_id": str(service_id),
            "status": status,
            "ok": ok,
            "hard_failure": hard,
            "observed_at": str(
                service.get("observed_at") or service.get("tested_at") or ""
            ),
        })
    if not services:
        status = "STOP_SAFE_BASELINE_NOT_OBSERVED"
    elif not fresh:
        status = "STOP_SAFE_BASELINE_STALE"
    elif hard_failures or reachable == 0:
        status = "STOP_SAFE_BASELINE_UNHEALTHY"
    else:
        status = "PASS_HEALTHY_BASELINE"

    diagnose = read_flat_state(state_dir / "egress-diagnose.state")
    diagnostic_reason = str(
        diagnose.get(f"{source_id}_diagnose_reason") or "NOT_OBSERVED"
    )
    diagnostic_severity = str(
        diagnose.get(f"{source_id}_diagnose_severity") or "UNKNOWN"
    )
    diagnostic_detail = str(
        diagnose.get(f"{source_id}_diagnose_detail") or ""
    )
    source_row = next((
        value for value in parse_registry(state_dir / "egress.registry")
        if str(value.get("id") or "") == str(source_id or "")
    ), {})
    config_path = Path(
        str(source_row.get("config") or source_row.get("config_path") or "")
    )
    config_fingerprint = (
        sha256_file(config_path)
        if str(config_path) and config_path.is_file()
        else ""
    )
    root_cause_class = "NONE"
    exact_external_resource = "NONE"
    exact_external_owner = "NONE"
    exact_required_input = "NONE"
    why_existing_owners_cannot_supply_it = "NONE"
    failed_producer_consumer_link = "NONE"
    if (
        status == "STOP_SAFE_BASELINE_UNHEALTHY"
        and diagnostic_severity == "FAIL"
        and diagnostic_reason == "curl_failed_and_handshake_stale"
        and "handshake_age_seconds=999999" in diagnostic_detail
    ):
        # Interface/process/route presence plus a never-established handshake
        # cannot distinguish a dead remote peer from revoked or mismatched
        # remote key material.  Both require the same independent external
        # input, so keep the classification honest and fail closed.
        root_cause_class = "EXTERNAL_INFRASTRUCTURE_OR_ACCESS_REQUIRED"
        exact_external_resource = (
            f"AMNEZIAWG_REMOTE_PEER_OR_MATCHING_PROFILE_FOR_SOURCE_{source_id}"
        )
        exact_external_owner = (
            "EXTERNAL_AMNEZIAWG_PEER_OR_CREDENTIAL_PROVIDER"
        )
        exact_required_input = (
            "OWNER_VERIFIED_REACHABLE_REMOTE_PEER_WITH_MATCHING_KEY_MATERIAL_"
            "OR_REPLACEMENT_WORKING_PROFILE_FOR_THE_EXACT_APPROVED_SOURCE"
        )
        why_existing_owners_cannot_supply_it = (
            "LOCAL_V7_OWNERS_CAN_RELOAD_AND_VERIFY_THE_EXISTING_PROFILE_BUT_"
            "CANNOT_REPAIR_THE_REMOTE_PEER_OR_ISSUE_MATCHING_EXTERNAL_KEYS"
        )
        failed_producer_consumer_link = (
            "EXTERNAL_AMNEZIAWG_PEER_RESPONSE_OR_MATCHING_PROFILE"
            "->LOCAL_HANDSHAKE->MATRIX_BASELINE"
        )
    return {
        "schema_version": "v7.controlled-certification-source-health.v2",
        "status": status,
        "ok": status == "PASS_HEALTHY_BASELINE",
        "source_id": str(source_id or ""),
        "source_protocol": str(source_row.get("protocol") or ""),
        "source_interface": str(source_row.get("interface") or ""),
        "source_config_fingerprint": config_fingerprint,
        "matrix_updated": matrix_updated,
        "age_seconds": round(age_seconds, 3) if age_seconds >= 0 else -1,
        "max_age_seconds": CONTROLLED_CERTIFICATION_BASELINE_MAX_AGE_SECONDS,
        "service_count": len(services),
        "reachable_service_count": reachable,
        "hard_failure_count": hard_failures,
        "observation_fingerprint": sha256_json(observations),
        "raw_service_details_stored": False,
        "diagnostic_updated": str(diagnose.get("updated") or ""),
        "diagnostic_reason": diagnostic_reason,
        "diagnostic_severity": diagnostic_severity,
        "diagnostic_detail": diagnostic_detail,
        "root_cause_class": root_cause_class,
        "exact_external_resource": exact_external_resource,
        "exact_external_owner": exact_external_owner,
        "exact_required_input": exact_required_input,
        "why_existing_owners_cannot_supply_it": (
            why_existing_owners_cannot_supply_it
        ),
        "failed_producer_consumer_link": failed_producer_consumer_link,
        "owner": (
            "existing service-matrix.json via tools/v7-service-matrix-test + "
            "existing egress-diagnose.state via tools/v7-egress-diagnose"
        ),
        "reentry_condition": (
            "owner-verified remote peer or matching profile is restored; "
            "then a fresh Matrix observation proves at least one reachable "
            "service and zero hard service failures on the exact source"
            if root_cause_class == "EXTERNAL_INFRASTRUCTURE_OR_ACCESS_REQUIRED"
            else
            "fresh Matrix observation proves at least one reachable service "
            "and zero hard service failures on the exact source"
        ),
    }


def controlled_certification_pool_status(state_dir: Path) -> dict[str, Any]:
    """Project the existing certification pool without exposing identities."""
    state_dir = Path(state_dir)
    users_path = state_dir / "users.registry"
    egress_path = state_dir / "egress.registry"
    users = parse_registry(users_path)
    egress = parse_registry(egress_path)
    enabled_certification_users = [
        row for row in users
        if bool_value(row.get("certification_user"))
        and bool_value(row.get("enabled", "1"))
    ]
    enabled_users = [
        row for row in users
        if bool_value(row.get("enabled", "1"))
    ]
    active_sources = [
        row for row in egress
        if bool_value(row.get("controlled_certification_source"))
        and bool_value(row.get("enabled", "1"))
        and str(row.get("state") or "").lower() not in {"disabled", "maintenance"}
    ]
    source_rows: list[dict[str, Any]] = []
    for source in sorted(active_sources, key=lambda row: str(row.get("id") or "")):
        source_id = str(source.get("id") or "")
        baseline_health = controlled_certification_source_health_status(
            state_dir, source_id,
        )
        source_group = str(source.get("certification_group") or "")
        assigned = [
            row for row in enabled_certification_users
            if str(row.get("current") or "") == source_id
        ]
        assigned_enabled = [
            row for row in enabled_users
            if str(row.get("current") or "") == source_id
        ]
        assigned_non_certification = [
            row for row in assigned_enabled
            if not bool_value(row.get("certification_user"))
        ]
        group_aligned = [
            row for row in assigned
            if not source_group
            or str(row.get("certification_group") or "") == source_group
        ]
        source_rows.append({
            "source_id": source_id,
            "certification_group": source_group,
            "enabled_certification_users_on_source": len(assigned),
            "group_aligned_certification_users_on_source": len(group_aligned),
            "enabled_non_certification_users_on_source": len(
                assigned_non_certification
            ),
            "source_isolated_for_controlled_failure": (
                not assigned_non_certification
            ),
            "baseline_health": baseline_health,
        })
    max_users_on_one_source = max(
        (int(row["enabled_certification_users_on_source"]) for row in source_rows),
        default=0,
    )
    isolated_source_rows = [
        row for row in source_rows
        if bool(row.get("source_isolated_for_controlled_failure"))
    ]
    max_users_on_one_isolated_source = max(
        (
            int(row["enabled_certification_users_on_source"])
            for row in isolated_source_rows
        ),
        default=0,
    )
    assigned_source_ids = {
        str(row.get("current") or "")
        for row in enabled_users
        if str(row.get("current") or "")
    }
    isolated_source_candidates = []
    execution_only_controlled_target_candidates = []
    for source in sorted(egress, key=lambda row: str(row.get("id") or "")):
        source_id = str(source.get("id") or "")
        execution_only_contract = (
            bool_value(source.get("enabled", "1"))
            and str(source.get("state") or "").lower()
            not in {"disabled", "maintenance"}
            and source_id not in assigned_source_ids
            and str(source.get("type") or "") == "interface"
            and str(source.get("role") or "").upper() == "EXECUTION_ONLY"
            and bool_value(source.get("execution_reserved"))
            and bool_value(source.get("canary_reserved"))
            and str(source.get("reservation_owner") or "")
            == "operator_execution_governance"
            and not bool_value(source.get("autoswitch_allowed"))
            and not bool_value(source.get("rebalance_allowed"))
            and str(source.get("production_assignment_allowed") or "").lower()
            in {"0", "false", "no"}
        )
        if source_id and execution_only_contract:
            baseline_health = controlled_certification_source_health_status(
                state_dir, source_id,
            )
            execution_only_controlled_target_candidates.append({
                "source_id": source_id,
                "role": "EXECUTION_ONLY",
                "reservation_owner": "operator_execution_governance",
                "execution_reserved": True,
                "canary_reserved": True,
                "autoswitch_allowed": False,
                "rebalance_allowed": False,
                "production_assignment_allowed": False,
                "enabled_assigned_users": 0,
                "ordinary_production_eligible": False,
                "controlled_certification_target_eligible": bool(
                    baseline_health.get("ok")
                ),
                "baseline_health": baseline_health,
            })
        if (
            not source_id
            or source_id in assigned_source_ids
            or not bool_value(source.get("enabled", "1"))
            or str(source.get("state") or "").lower()
            in {"disabled", "maintenance"}
            or bool_value(source.get("execution_reserved"))
            or str(source.get("production_assignment_allowed") or "").lower()
            in {"0", "false", "no"}
            or str(source.get("type") or "") != "interface"
        ):
            continue
        baseline_health = controlled_certification_source_health_status(
            state_dir, source_id,
        )
        isolated_source_candidates.append({
            "source_id": source_id,
            "protocol": str(source.get("protocol") or ""),
            "controlled_certification_marker_present": bool_value(
                source.get("controlled_certification_source")
            ),
            "enabled_assigned_users": 0,
            "source_isolated_for_controlled_failure": True,
            "baseline_health": baseline_health,
        })
    healthy_isolated_source_candidates = [
        row for row in isolated_source_candidates
        if bool((row.get("baseline_health") or {}).get("ok"))
    ]
    healthy_execution_only_controlled_target_candidates = [
        row for row in execution_only_controlled_target_candidates
        if bool((row.get("baseline_health") or {}).get("ok"))
    ]
    ladder = (5, 10, 25, 48)
    next_required_tier = next(
        (tier for tier in ladder if max_users_on_one_isolated_source < tier),
        48,
    )
    tier5_ready = max_users_on_one_isolated_source >= 5
    mixed_source_count = len([
        row for row in source_rows
        if int(row.get("enabled_non_certification_users_on_source") or 0) > 0
    ])
    projection = {
        "schema_version": "v7.controlled-certification-pool-status.v1",
        "owner": "existing users.registry + egress.registry certification markers",
        "status": (
            "CONTROLLED_CERTIFICATION_POOL_READY_FOR_TIER_5"
            if tier5_ready else
            "CONTROLLED_CERTIFICATION_POOL_INSUFFICIENT_FOR_TIER_5"
        ),
        "total_enabled_certification_users": len(enabled_certification_users),
        "active_controlled_source_count": len(active_sources),
        "max_enabled_certification_users_on_one_active_source": max_users_on_one_source,
        "max_enabled_certification_users_on_one_isolated_active_source": (
            max_users_on_one_isolated_source
        ),
        "mixed_controlled_source_count": mixed_source_count,
        "next_required_tier": next_required_tier,
        "missing_users_for_tier_5": max(
            0, 5 - max_users_on_one_isolated_source
        ),
        "tier_readiness": {
            str(tier): max_users_on_one_isolated_source >= tier
            for tier in ladder
        },
        "active_source_projections": source_rows,
        "isolated_source_candidates": isolated_source_candidates,
        "healthy_isolated_source_candidates": healthy_isolated_source_candidates,
        "execution_only_controlled_target_candidates": (
            execution_only_controlled_target_candidates
        ),
        "healthy_execution_only_controlled_target_candidates": (
            healthy_execution_only_controlled_target_candidates
        ),
        "raw_user_list_stored": False,
        "ordinary_customer_reclassification_allowed": False,
        "exact_blocker": (
            "NONE" if tier5_ready else
            "active_controlled_source_contains_non_certification_users"
            if mixed_source_count and not isolated_source_rows else
            "fewer_than_5_enabled_certification_users_on_one_active_controlled_source"
        ),
        "responsible_existing_owner": (
            "existing Controlled Production Certification Program user, registry, "
            "assignment and Authority owners"
        ),
        "reentry_condition": (
            "five_or_more_existing_owner_authorized_enabled_certification_users_are_"
            "assigned_to_one_active_controlled_source_with_zero_enabled_"
            "non_certification_users"
        ),
        "read_only": True,
        "registry_hashes": {
            "users_registry": sha256_file(users_path),
            "egress_registry": sha256_file(egress_path),
        },
        "forbidden_effects": {
            "registry_write": False,
            "policy_write": False,
            "runtime_apply": False,
            "routing_mutation": False,
            "user_movement": 0,
            "authority_expansion": False,
            "production_maturity_change": False,
        },
    }
    projection["fingerprint"] = sha256_json(projection)
    return projection


def to_float(value: Any, default: float = 0.0) -> float:
    try:
        if value is None or value == "":
            return default
        return float(value)
    except (TypeError, ValueError):
        return default


def to_int(value: Any, default: int = 0) -> int:
    try:
        if value is None or value == "":
            return default
        return int(float(value))
    except (TypeError, ValueError):
        return default


def bool_value(value: Any) -> bool:
    return str(value).strip().lower() in ("1", "true", "yes", "on", "enabled")


def split_csv(value: Any) -> list[str]:
    if isinstance(value, list):
        return [str(v).strip() for v in value if str(v).strip()]
    return [part.strip() for part in str(value or "").split(",") if part.strip()]


def normalize_service_ids(values: Any) -> list[str]:
    result: list[str] = []
    for item in split_csv(values):
        value = str(item or "").strip().lower()
        if value and value not in result:
            result.append(value)
    return result


def user_priority_services_from_pref(row: Any) -> list[str]:
    if isinstance(row, dict) and "services" in row:
        services = normalize_service_ids(row.get("services") or [])
        if int(row.get("schema_version") or 0) < 2 and services == ["telegram"]:
            return list(DEFAULT_USER_PRIORITY_SERVICES)
        return services
    return list(DEFAULT_USER_PRIORITY_SERVICES)


def telegram_status_is_hard(status: str) -> bool:
    value = str(status or "").upper()
    return value in TELEGRAM_HARD_STATUSES or value.startswith("TELEGRAM_DOWN_")


def merge_defaults(data: dict[str, Any], defaults: dict[str, Any]) -> dict[str, Any]:
    result = dict(defaults)
    for key, value in (data or {}).items():
        if isinstance(value, dict) and isinstance(result.get(key), dict):
            result[key] = merge_defaults(value, result[key])
        else:
            result[key] = value
    return result


def glob_contains(patterns: list[str], value: str) -> bool:
    return any(fnmatch.fnmatchcase(value, pattern) for pattern in patterns)


def parse_ts(value: Any) -> float:
    try:
        return datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp()
    except Exception:
        return 0.0


def runtime_authority_contract_status(
    policy: dict[str, Any],
    *,
    prepared_class: str,
    certified_class: str,
    standing_policy_contract: dict[str, Any] = None,
    authority_audit_records: list[dict[str, Any]] = None,
) -> dict[str, Any]:
    """Bind a broad runtime budget to a fresh, explicitly scoped policy contract.

    Historical promotion evidence is useful for analysis, but is not an
    executable grant forever.  The existing policy owner must keep an active
    action-class contract alongside any authority above CANARY; absence or
    expiry is deliberately a zero-budget terminal before a plan can reach the
    restore-barrier or apply path.
    """
    broad_authority = max(
        AUTHORITY_CLASS_RANK[prepared_class],
        AUTHORITY_CLASS_RANK[certified_class],
    ) > AUTHORITY_CLASS_RANK["CANARY"]
    contract = policy.get("current_action_class_contract")
    contract = dict(contract) if isinstance(contract, dict) else {}
    required = broad_authority
    now = datetime.now(timezone.utc).timestamp()
    expires_at = str(contract.get("expires_at") or "")
    max_users = max(0, to_int(contract.get("max_users"), 0))
    max_concurrent_transactions = max(0, to_int(contract.get("max_concurrent_transactions"), 0))
    scope = contract.get("scope") if isinstance(contract.get("scope"), dict) else {}
    subject = contract.get("subject") if isinstance(contract.get("subject"), dict) else {}
    source_generation = contract.get("source_generation") if isinstance(contract.get("source_generation"), dict) else {}
    incident_generation = contract.get("incident_generation") if isinstance(contract.get("incident_generation"), dict) else {}
    verification_contract = contract.get("verification_contract") if isinstance(contract.get("verification_contract"), dict) else {}
    rollback_contract = contract.get("rollback_containment_contract") if isinstance(contract.get("rollback_containment_contract"), dict) else {}
    cooldown = contract.get("cooldown") if isinstance(contract.get("cooldown"), dict) else {}
    anti_flap = contract.get("anti_flap") if isinstance(contract.get("anti_flap"), dict) else {}
    decision = contract.get("authority_decision") if isinstance(contract.get("authority_decision"), dict) else {}
    consumption = contract.get("one_use_consumption") if isinstance(contract.get("one_use_consumption"), dict) else {}
    required_gates = contract.get("required_gates") if isinstance(contract.get("required_gates"), dict) else {}
    stop_conditions = contract.get("stop_conditions") if isinstance(contract.get("stop_conditions"), list) else []
    allowed_class = normalize_authority_class(
        contract.get("max_authority_class") or contract.get("authority_class") or "CANARY"
    )
    action_class = str(contract.get("action_class") or "").strip().upper()
    contract_schema = str(contract.get("schema_version") or "")
    strict_provenance_contract = contract_schema == operator_execution.CURRENT_ACTION_CLASS_CONTRACT_SCHEMA
    schema_ok = contract_schema in {"v7.current-action-class-contract.v1", operator_execution.CURRENT_ACTION_CLASS_CONTRACT_SCHEMA}
    provenance_ok = (not strict_provenance_contract) or (
        str(contract.get("issuing_owner") or "") == operator_execution.CURRENT_ACTION_CLASS_CONTRACT_ISSUING_OWNER
        and bool(str(contract.get("contract_id") or ""))
        and bool(str(contract.get("contract_hash") or ""))
        and operator_execution.current_action_class_contract_hash(contract) == str(contract.get("contract_hash") or "")
        and bool(str(contract.get("active_program") or ""))
        and bool(str(subject.get("user_ip") or ""))
        and decision.get("decision") == operator_execution.ENGINEERING_AUTHORITY_APPROVAL
        and bool(str(decision.get("request_id") or ""))
        and bool(str(decision.get("request_hash") or ""))
        and bool(str(decision.get("decided_at") or ""))
        and bool(str(decision.get("actor_id") or ""))
        and bool(str(decision.get("decision_id") or ""))
    )
    scope_ok = bool(str(scope.get("source_egress") or "")) and bool(str(scope.get("target_egress") or ""))
    action_ok = action_class in {"GOVERNED_ONLY", "EMERGENCY_FAILOVER"}
    expiry_ok = parse_ts(expires_at) > now
    class_ok = AUTHORITY_CLASS_RANK[allowed_class] >= AUTHORITY_CLASS_RANK[certified_class]
    budget_ok = (max_users > 0) if not strict_provenance_contract else (max_users == 1 and max_concurrent_transactions == 1)
    source_generation_ok = (not strict_provenance_contract) or (all(str(source_generation.get(key) or "") for key in (
        "planner_generation_id", "source_bundle_hash", "snapshot_bundle_hash", "selected_move_hash",
    )) and all(str(incident_generation.get(key) or "") for key in ("incident_id", "incident_generation")))
    execution_contract_ok = (not strict_provenance_contract) or (
        verification_contract.get("owner") and verification_contract.get("required") is True
        and verification_contract.get("immediate_and_temporal_observation") is True
        and verification_contract.get("success_criteria")
        and rollback_contract.get("owner") and rollback_contract.get("required") is True
        and rollback_contract.get("triggered_by_verifier") is True
        and rollback_contract.get("direct_terminal_manufacture_forbidden") is True
    )
    lifecycle_ok = (not strict_provenance_contract) or (
        cooldown.get("required") is True and to_int(cooldown.get("seconds"), -1) >= 0
        and anti_flap.get("required") is True
        and consumption.get("state") == "ISSUED"
        and to_int(consumption.get("allowed_uses"), 0) == 1
        and to_int(consumption.get("consumed_uses"), -1) == 0
        and consumption.get("retry_allowed") is False
        and str(consumption.get("consumption_owner") or "") == "tools/v7-users-autoswitch"
    )
    action_scope_ok = scope_ok
    gate_contract_ok = (
        bool_value(required_gates.get("fresh_evidence_required"))
        and bool_value(required_gates.get("verification_required"))
        and bool_value(required_gates.get("rollback_required"))
        and bool_value(required_gates.get("anti_flap_required"))
        and "cooldown_seconds" in required_gates
        and to_int(required_gates.get("cooldown_seconds"), -1) >= 0
    )
    stop_conditions_ok = (not strict_provenance_contract) or operator_execution.CURRENT_ACTION_CLASS_REQUIRED_STOP_CONDITIONS.issubset(
        {str(item).strip() for item in stop_conditions if str(item).strip()}
    )
    valid = (not required) or (
        schema_ok and provenance_ok and scope_ok and action_ok and expiry_ok and class_ok and budget_ok
        and source_generation_ok and execution_contract_ok and lifecycle_ok and gate_contract_ok and stop_conditions_ok
    )
    blockers: list[str] = []
    if required and not schema_ok:
        blockers.append("current_action_class_contract_missing_or_schema_invalid")
    if required and strict_provenance_contract and not provenance_ok:
        blockers.append("current_action_class_contract_authority_provenance_invalid")
    if required and schema_ok and not scope_ok:
        blockers.append("current_action_class_contract_scope_missing")
    if required and schema_ok and not action_ok:
        blockers.append("current_action_class_contract_action_class_invalid")
    if required and schema_ok and not expiry_ok:
        blockers.append("current_action_class_contract_expired_or_missing")
    if required and schema_ok and not class_ok:
        blockers.append("current_action_class_contract_below_certified_authority")
    if required and schema_ok and not budget_ok:
        blockers.append("current_action_class_contract_exact_one_user_budget_required")
    if required and schema_ok and not action_scope_ok:
        blockers.append("current_action_class_contract_source_target_scope_missing")
    if required and strict_provenance_contract and not source_generation_ok:
        blockers.append("current_action_class_contract_incident_or_source_generation_missing")
    if required and strict_provenance_contract and not execution_contract_ok:
        blockers.append("current_action_class_contract_verification_or_rollback_contract_missing")
    if required and strict_provenance_contract and not lifecycle_ok:
        blockers.append("current_action_class_contract_one_use_lifecycle_invalid")
    if required and schema_ok and not gate_contract_ok:
        blockers.append("current_action_class_contract_required_gates_missing")
    if required and schema_ok and not stop_conditions_ok:
        blockers.append("current_action_class_contract_stop_conditions_missing")

    # A valid standing delegated policy is an existing Authority-owner
    # contract, not an absent one-use M5a contract. Its exact per-action
    # binding happens later in the existing governed executor against fresh
    # Candidate, Packet, event, source/target, verification and rollback
    # facts. Requiring the retired one-use shape here would freeze the already
    # approved path before it could reach those live gates.
    standing = standing_policy_contract if isinstance(standing_policy_contract, dict) else {}
    standing_validation = operator_execution.validate_standing_delegated_operational_policy(
        standing,
        audit_records=authority_audit_records or [],
    ) if standing else {"ok": False, "errors": ["standing_delegated_policy_missing"], "policy": {}}
    standing_scope = standing_validation.get("policy") if isinstance(standing_validation.get("policy"), dict) else {}
    standing_max_users = int(standing_scope.get("max_users_per_action") or 0)
    standing_exactly_bounded = (
        bool(standing_validation.get("ok"))
        and str(standing_scope.get("policy_state") or "") == "APPROVED"
        and str(standing_scope.get("current_mode") or "") == "DELEGATED_AUTONOMY"
        and standing_max_users in operator_execution.SERVICE_FAILURE_DELEGATED_ACTION_CLASSES
        and int(standing_scope.get("max_concurrent_transactions") or 0) == 1
        and str(standing_scope.get("candidate_identity") or "") == "FRESH_ONLY"
        and str(standing_scope.get("packet_generation") or "") == "FRESH_IMMEDIATELY_BEFORE_EXECUTION"
        and str(standing_scope.get("packet_reuse") or "") == "FORBIDDEN"
        and standing_scope.get("runtime_apply_enabled") is True
        and standing_scope.get("self_expansion_allowed") is False
    )
    if required and not valid and standing_exactly_bounded:
        return {
            "schema_version": "v7.current-action-class-contract-gate.v1",
            "required": True,
            "valid": True,
            "contract_id": str(standing.get("contract_id") or ""),
            "contract_hash": str(standing.get("contract_hash") or ""),
            "active_program": str(standing.get("active_program") or ""),
            "action_class": "GOVERNED_ONLY",
            "max_authority_class": "CANARY",
            "max_users": standing_max_users,
            "max_concurrent_transactions": 1,
            "subject": {"user_ip": ""},
            "expires_at": str(standing.get("expires_at") or ""),
            "scope": {"source_egress": "", "target_egress": ""},
            "required_gates": {
                "fresh_evidence_required": True,
                "verification_required": True,
                "rollback_required": True,
                "anti_flap_required": True,
                "cooldown_seconds": int((standing_scope.get("cooldown") or {}).get("per_user_seconds") or 0),
            },
            "stop_conditions": list(standing_scope.get("stop_conditions") or []),
            "provenance": {
                "issuing_owner": str(standing.get("issuing_owner") or ""),
                "authority_decision_id": str((standing.get("authority_decision") or {}).get("decision_id") or ""),
                "standing_policy_contract": True,
                "strict_provenance_contract": False,
            },
            "blockers": [],
            "truth_source": "existing_delegated_autonomy_policy_and_operator_execution_audit",
            "new_truth_sources_created": False,
        }
    return {
        "schema_version": "v7.current-action-class-contract-gate.v1",
        "required": required,
        "valid": valid,
        "contract_id": str(contract.get("contract_id") or ""),
        "contract_hash": str(contract.get("contract_hash") or ""),
        "active_program": str(contract.get("active_program") or ""),
        "action_class": action_class,
        "max_authority_class": allowed_class,
        "max_users": max_users,
        "max_concurrent_transactions": max_concurrent_transactions,
        "subject": {"user_ip": str(subject.get("user_ip") or "")},
        "expires_at": expires_at,
        "scope": {
            "source_egress": str(scope.get("source_egress") or ""),
            "target_egress": str(scope.get("target_egress") or ""),
        },
        "required_gates": {
            "fresh_evidence_required": bool_value(required_gates.get("fresh_evidence_required")),
            "verification_required": bool_value(required_gates.get("verification_required")),
            "rollback_required": bool_value(required_gates.get("rollback_required")),
            "anti_flap_required": bool_value(required_gates.get("anti_flap_required")),
            "cooldown_seconds": to_int(required_gates.get("cooldown_seconds"), -1),
        },
        "stop_conditions": [str(item) for item in stop_conditions if str(item).strip()],
        "provenance": {
            "issuing_owner": str(contract.get("issuing_owner") or ""),
            "authority_decision_id": str(decision.get("request_id") or ""),
            "incident_generation": incident_generation,
            "source_generation": source_generation,
            "verification_contract": verification_contract,
            "rollback_containment_contract": rollback_contract,
            "cooldown": cooldown,
            "anti_flap": anti_flap,
            "one_use_state": str(consumption.get("state") or ""),
            "strict_provenance_contract": strict_provenance_contract,
        },
        "blockers": blockers,
        "truth_source": "existing_policy_current_action_class_contract",
        "new_truth_sources_created": False,
    }


def action_class_contract_source_generation(plan: dict[str, Any], selected_move: dict[str, Any]) -> dict[str, str]:
    """Derive fresh contract provenance from the existing planner snapshot.

    The authority gate intentionally removes selected moves before a contract
    exists, so ``operation.selected_move_hash`` can legitimately be the empty
    selection.  The contract instead binds the exact shadow move identity and
    the canonical snapshot sources that produced it.
    """
    plan = plan if isinstance(plan, dict) else {}
    operation = plan.get("operation") if isinstance(plan.get("operation"), dict) else {}
    safety = plan.get("safety") if isinstance(plan.get("safety"), dict) else {}
    intelligence = safety.get("intelligence_snapshots") if isinstance(safety.get("intelligence_snapshots"), dict) else {}
    results = intelligence.get("results") if isinstance(intelligence.get("results"), dict) else {}
    source_hashes = {
        str(name): dict(row.get("source_hashes") or {})
        for name, row in sorted(results.items())
        if isinstance(row, dict) and isinstance(row.get("source_hashes"), dict)
    }
    planner_generation_id = str(operation.get("planner_generation_id") or operation.get("generation_id") or "")
    source_bundle_hash = str(operation.get("source_bundle_hash") or "")
    if not source_bundle_hash and source_hashes:
        source_bundle_hash = sha256_json({"planner_generation_id": planner_generation_id, "source_hashes": source_hashes})
    snapshot_bundle_hash = str(
        operation.get("snapshot_bundle_hash") or operation.get("runtime_snapshot_hash") or ""
    )
    if not snapshot_bundle_hash and results:
        snapshot_bundle_hash = sha256_json({
            str(name): {
                "path": str(row.get("path") or ""),
                "source_hashes": dict(row.get("source_hashes") or {}),
                "validation_ok": bool_value(row.get("validation_ok")),
            }
            for name, row in sorted(results.items()) if isinstance(row, dict)
        })
    selected_move_hash = sha256_json({
        "user_ip": str(selected_move.get("user_ip") or ""),
        "source_egress": str(selected_move.get("current_egress") or ""),
        "target_egress": str(selected_move.get("recommended_egress") or ""),
    }) if selected_move else ""
    return {
        "planner_generation_id": planner_generation_id,
        "source_bundle_hash": source_bundle_hash,
        "snapshot_bundle_hash": snapshot_bundle_hash,
        "selected_move_hash": selected_move_hash,
    }


def availability_first_action_class_context(
    diagnostic: dict[str, Any],
) -> tuple[dict[str, Any], list[str]]:
    """Bind the special shared-target boundary to its existing topology owner."""
    diagnostic = diagnostic if isinstance(diagnostic, dict) else {}
    if diagnostic.get("status") != "CONTROLLED_TOPOLOGY_AVAILABILITY_FIRST_CONTRACT_REQUIRED":
        return {}, ["availability_first_topology_boundary_not_current"]
    projection = diagnostic.get("shared_production_target_capacity_projection")
    projection = projection if isinstance(projection, dict) else {}
    allocation = ((projection.get("stage_allocations") or {}).get("1") or {})
    rows = allocation.get("immutable_allocation_projection") or []
    row = rows[0] if len(rows) == 1 and isinstance(rows[0], dict) else {}
    post_trial = diagnostic.get("POST_TRIAL_CONTROLLED_TOPOLOGY_DECISION_DIAGNOSTIC")
    post_trial = post_trial if isinstance(post_trial, dict) else {}
    campaign = diagnostic.get("current_campaign")
    campaign = campaign if isinstance(campaign, dict) else {}
    source = str(projection.get("actual_controlled_source_id") or "")
    user_ip = str(post_trial.get("trial_identity") or "")
    target = str(row.get("target_id") or "")
    allocation_fingerprint = str(allocation.get("allocation_fingerprint") or "")
    target_fingerprint = str(row.get("target_fingerprint") or "")
    capability_map_fingerprint = str(diagnostic.get("capability_map_fingerprint") or "")
    blockers = []
    if not allocation.get("feasible") or not row:
        blockers.append("availability_first_single_target_allocation_missing")
    if str(row.get("availability_policy_boundary") or "") != "EXACT_DEGRADED_SHARED_TARGET_ACTION_CLASS_CONTRACT_REQUIRED":
        blockers.append("availability_first_policy_boundary_mismatch")
    if not source or not user_ip or not target or str(post_trial.get("trial_identity_current_location") or "") != source:
        blockers.append("availability_first_exact_identity_source_binding_missing")
    if source == target:
        blockers.append("availability_first_source_target_collision")
    if not str(campaign.get("request_id") or "") or len(str(campaign.get("request_hash") or "")) != 64:
        blockers.append("availability_first_campaign_generation_missing")
    if not allocation_fingerprint or not target_fingerprint or not capability_map_fingerprint:
        blockers.append("availability_first_snapshot_generation_missing")
    if blockers:
        return {}, sorted(set(blockers))
    selected_move_hash = sha256_json({
        "source": source, "target": target, "user_ip": user_ip,
        "allocation_fingerprint": allocation_fingerprint,
        "target_fingerprint": target_fingerprint,
    })
    return {
        "chosen": {"user_ip": user_ip, "current_egress": source, "recommended_egress": target},
        "incident_generation": {"incident_id": str(campaign.get("request_id") or ""), "incident_generation": allocation_fingerprint},
        "source_generation": {
            "planner_generation_id": allocation_fingerprint,
            "source_bundle_hash": capability_map_fingerprint,
            "snapshot_bundle_hash": target_fingerprint,
            "selected_move_hash": selected_move_hash,
        },
    }, []


def action_class_contract_reconciliation_request(
    plan: dict[str, Any], *, policy_path: Path,
    availability_first_context: Optional[dict[str, Any]] = None,
) -> dict[str, Any]:
    """Produce the next existing-owner input after an Authority STOP_SAFE.

    This is intentionally a *request template*, not a policy writer and not an
    Authority grant.  It makes the producer -> existing policy owner ->
    autoswitch revalidation link explicit while preserving the rule that a
    fresh Situation, Decision Trace and one-use operational contract are
    required before any Candidate/Packet/apply lifecycle can begin.
    """
    safety = plan.get("safety") if isinstance(plan.get("safety"), dict) else {}
    boundary = safety.get("action_class_execution_boundary") if isinstance(
        safety.get("action_class_execution_boundary"), dict
    ) else {}
    authority_gate = safety.get("authority_budget_gate") if isinstance(
        safety.get("authority_budget_gate"), dict
    ) else {}
    contract_gate = authority_gate.get("current_action_class_contract") if isinstance(
        authority_gate.get("current_action_class_contract"), dict
    ) else {}
    intelligence_gate = safety.get("intelligence_snapshots") if isinstance(
        safety.get("intelligence_snapshots"), dict
    ) else {}
    l3_wake = safety.get("l3_wake") if isinstance(safety.get("l3_wake"), dict) else {}
    emergency_gate = safety.get("emergency_failover_autonomy") if isinstance(
        safety.get("emergency_failover_autonomy"), dict
    ) else {}
    status = str(boundary.get("status") or "STOP_SAFE_ACTION_CLASS_BOUNDARY_NOT_EVALUATED")
    l3_incident = safety.get("l3_incident") if isinstance(safety.get("l3_incident"), dict) else {}
    shadow_candidates = sorted(
        [
            row for row in (plan.get("decisions") or [])
            if isinstance(row, dict)
            and str(row.get("recommended_egress") or "")
            and str(row.get("recommended_egress") or "") != str(row.get("current_egress") or "")
        ],
        key=lambda row: (
            str(row.get("user_ip") or ""),
            str(row.get("current_egress") or ""),
            str(row.get("recommended_egress") or ""),
        ),
    )
    chosen = shadow_candidates[0] if shadow_candidates else {}
    current_contract_valid = bool(contract_gate.get("valid"))
    contract_required = bool(contract_gate.get("required"))
    availability_first_context = (
        availability_first_context
        if isinstance(availability_first_context, dict) else {}
    )
    # A degraded shared target is not an ordinary Planner shadow move.  Its
    # current CPS frontier is bound by the topology owner to an exact
    # certification identity and must never inherit an unrelated incident's
    # source/user merely because that row sorts first in plan.decisions.
    if availability_first_context:
        status = "STOP_SAFE_CURRENT_ACTION_CLASS_CONTRACT_REQUIRED"
        chosen = dict(availability_first_context.get("chosen") or {})
        l3_incident = dict(
            availability_first_context.get("incident_generation") or {}
        )
        current_contract_valid = False
        contract_required = True
    template = {
        "active_program": "V7_SERVICE_FAILURE_AUTOMATION_EVOLUTION_PROGRAM_V1",
        "action_class": "GOVERNED_ONLY",
        "max_authority_class": str(authority_gate.get("certified_authority_class") or "CANARY"),
        "authority_ceiling": str(authority_gate.get("certified_authority_class") or "CANARY"),
        "policy_generation_hash": sha256_file(policy_path),
        "max_users": 1,
        "max_concurrent_transactions": 1,
        "max_ttl_seconds": 900,
        "subject": {"user_ip": str(chosen.get("user_ip") or "OWNER_TO_BIND_FROM_FRESH_SITUATION")},
        "scope": {
            "source_egress": str(chosen.get("current_egress") or "OWNER_TO_BIND_FROM_FRESH_SITUATION"),
            "target_egress": str(chosen.get("recommended_egress") or "OWNER_TO_BIND_FROM_FRESH_SITUATION"),
        },
        "incident_generation": {
            "incident_id": str(l3_incident.get("incident_id") or l3_incident.get("incident_key") or ""),
            "incident_generation": str(l3_incident.get("incident_generation") or l3_incident.get("generation") or ""),
        },
        "source_generation": (
            dict(availability_first_context.get("source_generation") or {})
            if availability_first_context else
            action_class_contract_source_generation(plan, chosen)
        ),
        "verification_contract": {
            "owner": "tools/v7-users-autoswitch",
            "required": True,
            "immediate_and_temporal_observation": True,
            "success_criteria": "owner_defined_immediate_and_temporal_route_service_verification",
        },
        "rollback_containment_contract": {
            "owner": "tools/v7-users-autoswitch",
            "required": True,
            "triggered_by_verifier": True,
            "direct_terminal_manufacture_forbidden": True,
        },
        "cooldown": {"required": True, "seconds": 180},
        "anti_flap": {"required": True, "same_source_target_repeat_forbidden": True},
        "required_gates": {
            "fresh_evidence_required": True,
            "verification_required": True,
            "rollback_required": True,
            "anti_flap_required": True,
            "cooldown_seconds": 180,
        },
        "stop_conditions": [
            "no_safe_target",
            "stale_or_changed_situation",
            "selected_move_identity_changed",
            "target_capacity_or_service_gate_failed",
            "verification_failure",
            "rollback_required",
            "authority_decision_expired",
            "one_use_consumed_or_contended",
        ],
    }
    request_id = "accr_" + sha256_json({
        "policy_path": str(policy_path),
        "boundary_status": status,
        "contract_blockers": sorted(str(item) for item in (contract_gate.get("blockers") or [])),
        "source": template["scope"]["source_egress"],
        "target": template["scope"]["target_egress"],
        "user": str(chosen.get("user_ip") or ""),
    })[:24]
    issue_preflight_blockers: list[str] = []
    if not chosen:
        issue_preflight_blockers.append("no_current_shadow_candidate")
    if bool_value(intelligence_gate.get("stop_required")):
        issue_preflight_blockers.append(
            str(intelligence_gate.get("unsafe_blocker") or "intelligence_snapshot_gate_stop_required")
        )
    # A shadow recommendation is deliberately weaker than a runtime-ready L3
    # incident.  Do not ask the existing policy owner to issue a short-lived
    # one-use contract if the same planner invocation already knows that its
    # event-driven L3 consumer will reject execution.  Otherwise an approved
    # contract can only expire unused, which is an Authority request/consumer
    # handoff defect rather than a legitimate production boundary.
    if l3_wake and not bool_value(l3_wake.get("accepted")):
        wake_blockers = [str(item) for item in (l3_wake.get("blockers") or []) if str(item)]
        issue_preflight_blockers.extend(wake_blockers or ["confirmed_l3_wake_required"])
    # M5a must decide the scoped Action Class before M5b can legally rerun the
    # planner and before M5c can materialize a packet.  A restore barrier is a
    # packet-bound *operational* gate, so treating it as a pre-contract M5a
    # blocker creates an impossible cycle: no contract -> no packet -> no
    # barrier -> no contract.  Preserve it as explicit post-contract evidence,
    # but never let an absent packet/barrier suppress a fresh action-class
    # Authority request.  This does not make the contract executable: the
    # existing planner still revalidates every gate and only then exposes
    # PACKET_MATERIALIZATION_ELIGIBLE or STOP_SAFE.
    contract_artifact_blockers = {
        "confirmed_l3_wake_required",
        "no_selected_moves_for_emergency_failover",
    }
    operational_post_contract_blockers = [
        str(item) for item in (emergency_gate.get("blockers") or [])
        if str(item) and str(item) not in contract_artifact_blockers
    ]
    if not all(str(template["source_generation"].get(key) or "") for key in (
        "planner_generation_id", "source_bundle_hash", "snapshot_bundle_hash", "selected_move_hash",
    )):
        issue_preflight_blockers.append("fresh_source_generation_missing")
    if not all(str(template["incident_generation"].get(key) or "") for key in ("incident_id", "incident_generation")):
        issue_preflight_blockers.append("fresh_owner_backed_incident_generation_missing")
    if len(str(template["policy_generation_hash"] or "")) != 64:
        issue_preflight_blockers.append("policy_generation_missing")
    if not str(template["subject"].get("user_ip") or "") or str(template["subject"].get("user_ip")) == "OWNER_TO_BIND_FROM_FRESH_SITUATION":
        issue_preflight_blockers.append("fresh_exact_user_missing")
    if current_contract_valid:
        reconciliation_status = "CURRENT_ACTION_CLASS_CONTRACT_ACTIVE_REVALIDATE_EXISTING_CONSUMER"
