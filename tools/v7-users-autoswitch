        self,
        *,
        mutation_kind: str,
        action_class: str,
        expected_generation: str = "",
        rollback_certified: bool = False,
        operation_id: str = "",
        selected_move_hash: str = "",
        source_bundle_hash: str = "",
        snapshot_bundle_hash: str = "",
        max_users: int = 0,
    ) -> dict[str, Any]:
        return operator_execution.autonomous_execution_control_decision(
            Path(getattr(self.args, "execution_control_file", DEFAULT_EXECUTION_CONTROL_FILE)),
            mutation_kind=mutation_kind,
            action_class=action_class,
            expected_generation=expected_generation,
            rollback_certified=rollback_certified,
            operation_id=operation_id,
