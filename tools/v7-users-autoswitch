    def _exact_controlled_verifier_scope(self, selected_moves: list[dict[str, Any]]) -> dict[str, Any]:
        requested_user = str(getattr(self.args, "user", "") or "").strip()
        requested_source = str(getattr(self.args, "source_egress", "") or "").strip()
        requested_target = str(getattr(self.args, "target_egress", "") or "").strip()
        reasons: list[str] = []
        if not bool_value(getattr(self.args, "controlled_verifier_contention", False)):
            reasons.append("controlled_verifier_contention_not_requested")
        if not bool_value(getattr(self.args, "emergency_failover_autonomy", False)):
            reasons.append("controlled_verifier_requires_emergency_failover")
        if to_int(getattr(self.args, "max_selected_moves", 0), 0) != 1:
            reasons.append("controlled_verifier_max_users_must_be_one")
        if len(selected_moves) != 1:
            reasons.append("controlled_verifier_exact_move_required")
        move = selected_moves[0] if len(selected_moves) == 1 else {}
        if requested_user != str(move.get("user_ip") or ""):
            reasons.append("controlled_verifier_user_scope_mismatch")
        if requested_source != str(move.get("current_egress") or ""):
            reasons.append("controlled_verifier_source_scope_mismatch")
        if requested_target != str(move.get("recommended_egress") or ""):
            reasons.append("controlled_verifier_target_scope_mismatch")
        required_bindings = (
            "approved_packet_id",
            "approved_operation_id",
            "approved_selected_move_hash",
            "approved_authority_generation",
            "approved_breaker_generation",
            "approved_source_bundle_hash",
            "approved_snapshot_bundle_hash",
        )
        for field in required_bindings:
            if not str(getattr(self.args, field, "") or ""):
                reasons.append(f"controlled_verifier_{field}_missing")
        # The exact controlled verifier must use the mutable runtime registry
        # directly.  self.state is a diagnostic snapshot and can legitimately
        # lag a just-completed certification setup; merging it through
        # _load_users() would let stale snapshot fields override current owner
        # truth during the final pre-apply gate.
        fresh_users = {row.ip: row for row in self._load_runtime_registry_users()}
        fresh_egress = self._load_egress()
        user = fresh_users.get(requested_user)
        source = fresh_egress.get(requested_source)
        target = fresh_egress.get(requested_target)
        if user is None or not user.enabled:
            reasons.append("controlled_verifier_user_missing_or_disabled")
        else:
            raw_user = next((row for row in parse_registry(self.state_dir / "users.registry") if str(row.get("ip") or "") == requested_user), {})
            # This scope is evaluated only after the bounded forward apply has
            # been acknowledged.  The immutable move still proves the original
            # source, while fresh runtime truth must now place the user on the
            # approved forward target.  Requiring the pre-apply source here
            # makes every valid forward apply fail its own verifier setup.
            if str(user.current) != requested_target:
                reasons.append("controlled_verifier_user_not_on_forward_target")
            if str(raw_user.get("certification_user") or "").lower() not in {"1", "true", "yes"}:
                reasons.append("controlled_verifier_user_not_certification_user")
        raw_source = next((row for row in parse_registry(self.state_dir / "egress.registry") if str(row.get("id") or "") == requested_source), {})
        if source is None:
            reasons.append("controlled_verifier_source_missing")
        else:
            if str(raw_source.get("controlled_certification_source") or "").lower() not in {"1", "true", "yes"}:
                reasons.append("controlled_verifier_source_not_certification_source")
            if source.enabled or str(source.state).lower() not in {"maintenance", "disabled", "down"}:
                reasons.append("controlled_verifier_source_not_deliberately_unavailable")
        if target is None or not target.enabled:
            reasons.append("controlled_verifier_target_not_enabled")
        return {
            "schema_version": "v7.controlled-verifier-scope.v1",
            "ok": not reasons,
            "reasons": sorted(set(reasons)),
            "user": requested_user,
            "source": requested_source,
            "target": requested_target,
            "fresh_user_source": str(user.current) if user is not None else "",
            "fresh_user_egress": str(user.current) if user is not None else "",
            "source_enabled": bool(source.enabled) if source is not None else None,
            "source_state": str(source.state) if source is not None else "",
        }

    def _exact_availability_first_controlled_scope(
        self,
        selected_moves: list[dict[str, Any]],
    ) -> dict[str, Any]:
        """Consume the existing availability-first semantic binding.

        Availability-first certification deliberately moves certification
        identities from a healthy controlled source to an independently
        selected shared target.  It is therefore neither an ordinary
        production incident nor the older deliberately unavailable-source
        verifier.  The exact standing Authority contract, immutable allocation
        binding and live registry facts must all agree before this context may
        bypass incident-source continuity.
        """
        moves = [
            move for move in selected_moves
            if isinstance(move, dict)
        ]
        if not moves or not any(
            isinstance(
                move.get("availability_first_controlled_assignment"),
                dict,
            )
            for move in moves
        ):
            return {
                "schema_version": (
                    "v7.availability-first-controlled-scope.v1"
                ),
                "ok": False,
                "reasons": [
                    "availability_first_semantic_binding_missing"
                ],
                "event_provenance": "",
                "natural_production_credit": False,
                "ordinary_user_effect": "FORBIDDEN",
                "authority_expanded": False,
                "new_owner_created": False,
            }
        reasons: list[str] = []
        standing_contract = (
            (self.policy or {}).get("delegated_autonomy_policy")
            if isinstance((self.policy or {}).get("delegated_autonomy_policy"), dict)
            else {}
        )
        audit_store = Path(getattr(
            self.args,
            "action_class_audit_store",
            str(operator_execution.DEFAULT_PRODUCTION_OPERATOR_EXECUTION_AUDIT_STORE),
        ))
        standing_validation = (
            operator_execution.validate_standing_delegated_operational_policy(
                standing_contract,
                audit_records=operator_execution.read_live_execution_lineage_records(
                    audit_store
                ),
            )
            if standing_contract
            else {
                "ok": False,
                "errors": ["standing_delegated_policy_missing"],
                "policy": {},
            }
        )
        standing_scope = (
            standing_validation.get("policy")
            if isinstance(standing_validation.get("policy"), dict)
            else {}
        )
        action_scopes = (
            standing_scope.get("action_class_scopes")
            if isinstance(standing_scope.get("action_class_scopes"), dict)
            else {}
        )
        availability_scope = (
            action_scopes.get(
                operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
            )
            if isinstance(
                action_scopes.get(
                    operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
                ),
                dict,
            )
            else {}
        )
        if standing_validation.get("ok") is not True:
            reasons.extend(
                str(value)
                for value in (
                    standing_validation.get("errors")
                    or ["availability_first_standing_policy_invalid"]
                )
                if str(value)
            )
        if (
            standing_scope.get("policy_profile")
            != operator_execution.AVAILABILITY_FIRST_STANDING_POLICY_PROFILE
        ):
            reasons.append("availability_first_policy_profile_not_active")
        if (
            operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
            not in set(standing_scope.get("allowed_action_classes") or [])
        ):
            reasons.append("availability_first_action_class_not_active")
        if availability_scope.get("certification_identities_only") is not True:
            reasons.append("availability_first_certification_identity_fence_missing")
        max_users = to_int(
            availability_scope.get("max_users_per_transaction"),
            0,
        )
        if not moves:
            reasons.append("availability_first_exact_move_missing")
        if max_users < 1 or len(moves) > max_users:
            reasons.append("availability_first_scope_above_contract_ceiling")

        requested_user = str(getattr(self.args, "user", "") or "").strip()
        requested_source = str(
            getattr(self.args, "source_egress", "") or ""
        ).strip()
        requested_target = str(
            getattr(self.args, "target_egress", "") or ""
        ).strip()
        registry_rows = [
            row for row in parse_registry(self.state_dir / "users.registry")
            if isinstance(row, dict)
        ]
        users_by_ip = {
            str(row.get("ip") or ""): row for row in registry_rows
        }
        egress_rows = {
            str(row.get("id") or ""): row
            for row in parse_registry(self.state_dir / "egress.registry")
            if isinstance(row, dict)
        }
        allocation_fingerprints: set[str] = set()
        sources: set[str] = set()
        targets: set[str] = set()
        users: list[str] = []
        member_proof: list[dict[str, Any]] = []
        for move in moves:
            user_ip = str(move.get("user_ip") or "")
            source = str(move.get("current_egress") or "")
            target = str(move.get("recommended_egress") or "")
            binding = (
                move.get("availability_first_controlled_assignment")
                if isinstance(
                    move.get("availability_first_controlled_assignment"),
                    dict,
                )
                else {}
            )
            user_row = users_by_ip.get(user_ip) or {}
            source_row = egress_rows.get(source) or {}
            target_obj = self.egress.get(target)
            fingerprint = str(
                binding.get("allocation_fingerprint") or ""
            )
            allocation_fingerprints.add(fingerprint)
            sources.add(source)
            targets.add(target)
            users.append(user_ip)
            if binding.get("schema_version") != (
                "v7.availability-first-controlled-selection.v1"
            ):
                reasons.append(
                    f"availability_first_binding_schema_invalid:{user_ip}"
                )
            if binding.get("event_provenance") != "CONTROLLED_CERTIFICATION":
                reasons.append(
                    f"availability_first_provenance_invalid:{user_ip}"
                )
            if binding.get("natural_production_credit") is not False:
                reasons.append(
                    f"availability_first_natural_credit_invalid:{user_ip}"
                )
            if binding.get("ordinary_user") is not False:
                reasons.append(
                    f"availability_first_ordinary_user_fence_invalid:{user_ip}"
                )
            if (
                str(binding.get("source") or "") != source
                or str(binding.get("target") or "") != target
            ):
                reasons.append(
                    f"availability_first_source_target_binding_mismatch:{user_ip}"
                )
            if len(fingerprint) != 64:
                reasons.append(
                    f"availability_first_allocation_fingerprint_invalid:{user_ip}"
                )
            if not user_row or not bool_value(user_row.get("enabled")):
                reasons.append(
                    f"availability_first_user_missing_or_disabled:{user_ip}"
                )
            if str(user_row.get("current") or "") != source:
                reasons.append(
                    f"availability_first_user_source_mismatch:{user_ip}"
                )
            if not bool_value(user_row.get("certification_user")):
                reasons.append(
                    f"availability_first_user_not_certification_identity:{user_ip}"
                )
            if not bool_value(
                source_row.get("controlled_certification_source")
            ):
                reasons.append(
                    f"availability_first_source_not_controlled:{source}"
                )
            if source == target:
                reasons.append(
                    f"availability_first_source_target_collision:{user_ip}"
                )
            if target_obj is None or not target_obj.enabled:
                reasons.append(
                    f"availability_first_target_not_enabled:{target}"
                )
            member_proof.append({
                "user_ip": user_ip,
                "source": source,
                "target": target,
                "certification_user": bool_value(
                    user_row.get("certification_user")
                ),
                "source_controlled": bool_value(
                    source_row.get("controlled_certification_source")
                ),
                "binding_fingerprint": fingerprint,
            })

        if len(allocation_fingerprints) != 1:
            reasons.append(
                "availability_first_allocation_fingerprint_not_uniform"
            )
        if len(sources) != 1:
            reasons.append("availability_first_source_not_exact")
        if requested_user and users != [requested_user]:
            reasons.append("availability_first_requested_user_mismatch")
        if requested_source and sources != {requested_source}:
            reasons.append("availability_first_requested_source_mismatch")
        if requested_target and targets != {requested_target}:
            reasons.append("availability_first_requested_target_mismatch")
        for source in sources:
            ordinary_on_source = [
                str(row.get("ip") or "")
                for row in registry_rows
                if str(row.get("current") or "") == source
                and bool_value(row.get("enabled"))
                and not bool_value(row.get("certification_user"))
            ]
            if ordinary_on_source:
                reasons.append(
                    "availability_first_controlled_source_contains_ordinary_users"
                )

        return {
            "schema_version": "v7.availability-first-controlled-scope.v1",
            "ok": not reasons,
            "reasons": sorted(set(reasons)),
            "standing_policy_contract_id": str(
                standing_contract.get("contract_id") or ""
            ),
            "standing_policy_contract_hash": str(
                standing_contract.get("contract_hash") or ""
            ),
            "policy_profile": str(
                standing_scope.get("policy_profile") or ""
            ),
            "users": users,
            "sources": sorted(sources),
            "targets": sorted(targets),
            "allocation_fingerprint": (
                next(iter(allocation_fingerprints))
                if len(allocation_fingerprints) == 1
                else ""
            ),
            "member_scope_fingerprint": sha256_json(member_proof),
            "event_provenance": "CONTROLLED_CERTIFICATION",
            "natural_production_credit": False,
            "ordinary_user_effect": "FORBIDDEN",
            "authority_expanded": False,
            "new_owner_created": False,
        }

    def _activate_controlled_verifier_contention(self, move: dict[str, Any], operation_id: str) -> dict[str, Any]:
        scope = self._exact_controlled_verifier_scope([move])
        source = str(move.get("current_egress") or "")
        safe_operation = re.sub(r"[^A-Za-z0-9_.-]", "_", str(operation_id or "controlled"))[:80]
        marker = self.state_dir / f"controlled-verifier-lock-{safe_operation}.json"
        output = self.state_dir / f"controlled-verifier-refresh-{safe_operation}.log"
        try:
            marker.unlink(missing_ok=True)
        except OSError:
            pass
        if not scope.get("ok"):
            restore = subprocess.run(
                ["v7-egress-set-state", source, "enabled", "--apply"],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=180,
            ) if source else subprocess.CompletedProcess([], 2, stdout="missing source\n")
            return {
                "schema_version": "v7.controlled-verifier-contention.v1",
                "ok": False,
                "status": "STOP_SAFE_SCOPE_INVALID",
                "scope": scope,
                "source_restore_rc": restore.returncode,
                "source_restore_output": (restore.stdout or "")[-2000:],
            }
        handle = output.open("w", encoding="utf-8")
        try:
            proc = subprocess.Popen(
                [
                    "v7-service-matrix-refresh-all",
                    "--state-dir", str(self.state_dir),
                    "--event-dir", str(self.event_dir),
                    "--summary-file", str(self.state_dir / f"controlled-verifier-summary-{safe_operation}.json"),
                    "--lock-timeout-sec", "5",
                    "--lock-acquired-marker", str(marker),
                ],
                stdout=handle,
                stderr=subprocess.STDOUT,
                text=True,
                start_new_session=True,
            )
        except OSError as exc:
            handle.close()
            restore = subprocess.run(
                ["v7-egress-set-state", source, "enabled", "--apply"],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=180,
            )
            return {
                "schema_version": "v7.controlled-verifier-contention.v1",
                "ok": False,
                "status": "STOP_SAFE_LIFECYCLE_START_FAILED",
                "scope": scope,
                "error": f"{type(exc).__name__}:{exc}",
                "source_restore_rc": restore.returncode,
                "source_restore_output": (restore.stdout or "")[-2000:],
                "direct_rollback_invoked": False,
                "runtime_automation_enabled": False,
            }
        marker_payload: dict[str, Any] = {}
        deadline = time.time() + 12
        while time.time() < deadline:
            marker_payload = read_json(marker, {})
            if (
                marker_payload.get("owner") == "tools/v7-service-matrix-refresh-all"
                and to_int(marker_payload.get("pid"), 0) == proc.pid
            ):
                break
            if proc.poll() is not None:
                break
            time.sleep(0.05)
        handle.close()
        acquired = (
            marker_payload.get("owner") == "tools/v7-service-matrix-refresh-all"
            and to_int(marker_payload.get("pid"), 0) == proc.pid
        )
        if not acquired and proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait(timeout=5)
        restore = subprocess.run(
            ["v7-egress-set-state", source, "enabled", "--apply"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=180,
        )
        return {
            "schema_version": "v7.controlled-verifier-contention.v1",
            "ok": bool(acquired and restore.returncode == 0),
            "status": "ACTIVE" if acquired and restore.returncode == 0 else "STOP_SAFE_ACTIVATION_FAILED",
            "scope": scope,
            "refresh_pid": proc.pid,
            "refresh_running": proc.poll() is None,
            "lock_marker": marker_payload,
            "lock_marker_path": str(marker),
            "refresh_output_path": str(output),
            "source_restore_rc": restore.returncode,
            "source_restore_output": (restore.stdout or "")[-2000:],
            "direct_rollback_invoked": False,
            "runtime_automation_enabled": False,
        }

    def _execution_action_class(self, move_type: str = "") -> str:
        text = str(move_type or "").lower()
        if "recover" in text or "reconnect" in text:
            return "RECOVERY_ADMISSION"
        if "rebalance" in text:
            return "BOUNDED_REBALANCE"
        if "degrad" in text:
            return "DEGRADATION_MOVEMENT"
        if "failover" in text or bool_value(getattr(self.args, "emergency_failover_autonomy", False)):
            return "EMERGENCY_FAILOVER"
        return "USER_SWITCH"

