            "availability_ladder_stages": availability_first_stages,
            "availability_campaign": availability_campaign,
            "current_stage": availability_current_stage,
            "eligible_target_count": len(shared_ranked),
            "target_classifications": {
                str(row.get("target_id") or ""): str(
                    (row.get("shared_target_availability") or {}).get(
                        "state"
                    ) or ""
                )
                for row in rows
            },
            "ranked_target_ids": [
                str(row.get("target_id") or "") for row in shared_ranked
            ],
            "stage_allocations": shared_stage_allocations,
            "current_stage_feasible": bool(shared_current.get("feasible")),
            "campaign_completion_feasible": bool(shared_completion.get("feasible")),
            "authority_boundary": (
                "EXACT_DEGRADED_SHARED_TARGET_ACTION_CLASS_CONTRACT_REQUIRED"
                if any(
                    str((row.get("shared_target_availability") or {}).get(
                        "state"
                    ) or "") == "DEGRADED_USABLE"
                    for row in shared_ranked
                ) else
                "EXACT_LAST_RESORT_SHARED_TARGET_ACTION_CLASS_CONTRACT_REQUIRED"
                if any(
                    str((row.get("shared_target_availability") or {}).get(
                        "state"
                    ) or "") == "LAST_RESORT_USABLE"
                    for row in shared_ranked
                ) else
                "EXACT_SHARED_PRODUCTION_TARGET_ACTION_CLASS_CONTRACT_REQUIRED"
                if shared_current.get("feasible") else "NONE"
            ),
            "no_implicit_policy_grant": True,
            "ordinary_user_effect": "FORBIDDEN",
            "target_fault_injection": "FORBIDDEN",
            "candidate_packet_lease_created": False,
        },
        "standing_policy_semantic_coverage_gate": (
            standing_policy_semantic_coverage
        ),
        "hysteresis_and_no_churn": {
            "health_owner": "existing Matrix observations",
            "stability_owner": str(args.quality_summary_file),
            "cooldown_owner": "existing delegated_autonomy_policy",
            "anti_flap_owner": "existing planner safety policy",
            "minimum_successful_observations": (
                "existing quality window sample counts"
            ),
            "recovery_law": (
                "HEALTHY requires current+5m+1h owner-backed normal floor; "
                "emergency states remain capped and require fresh exact policy"
            ),
            "unchanged_fingerprint_result": (
                "TARGET_SET_UNCHANGED_REUSE_CURRENT_DECISION"
            ),
        },
        "material_replan": {
            "target_set_fingerprint": inventory_fingerprint,
            "unchanged_result": "TARGET_SET_UNCHANGED_REUSE_CURRENT_DECISION",
            "changed_result": "TARGET_RESELECTION_REQUIRED",
            "eligible_alternative_prevents_wait_for_current_target": True,
            "durable_successor_owner": (
                "existing Matrix -> OMP -> CPS continuation chain"
            ),
        },
        "historical_defects_closed": historical_defects_closed,
        "current_residuals": sorted(set(current_residuals)),
        "completion": (
            "DYNAMIC_TARGET_SELECTION_RUNTIME_CONSUMED"
            if not current_residuals
            else "DYNAMIC_TARGET_SELECTION_RUNTIME_CONSUMED_WITH_EXACT_BOUNDARY"
        ),
        "forbidden_effects": forbidden_effects,
    }
    result["diagnostic_fingerprint"] = sha256_json({
        "campaign": result["campaign"],
        "inventory_fingerprint": inventory_fingerprint,
        "selection": result["selection"],
        "current_residuals": result["current_residuals"],
    })
    return result


def _controlled_source_reservation_owner_capability() -> dict[str, Any]:
    """Inspect the existing egress state owner by behavior, not by filename."""
    candidates = [
        Path(__file__).resolve().with_name("v7-egress-set-state"),
    ]
    installed = shutil.which("v7-egress-set-state")
    if installed:
        candidates.append(Path(installed))
    owner_path = next((path for path in candidates if path.is_file()), None)
    text = ""
    if owner_path is not None:
        try:
            text = owner_path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            text = ""
    required_semantics = {
        "reserve_mode": "certification-reserve",
        "release_mode": "certification-release",
        "empty_or_same_campaign_source_gate": (
            "controlled_source_reservation_requires_empty_or_"
            "same_campaign_certification_source"
        ),
        "cas_gate": "egress_fingerprint_changed",
        "ordinary_assignment_fence": "production_assignment_allowed",
        "planner_reservation_fence": "canary_reserved",
        "exact_reservation_identity": "controlled_source_reservation_id",
        "expiry_binding": "controlled_source_reservation_expires_at",
        "bounded_restore": "restore_backup",
    }
    checks = {
        key: token in text for key, token in required_semantics.items()
    }
    return {
        "owner": str(owner_path or "v7-egress-set-state"),
        "status": "READY" if checks and all(checks.values()) else "ENGINEERING_GAP",
        "checks": checks,
        "apply_requires_exact_confirm": (
            "RESERVE_CONTROLLED_CERTIFICATION_SOURCE" in text
            and "RELEASE_CONTROLLED_CERTIFICATION_SOURCE" in text
        ),
        "runtime_effect_now": False,
    }


def _controlled_source_interface_identity(path: Path) -> dict[str, str]:
    """Read only the non-secret equality fields used by the draft owner.

    The administrative draft lifecycle refuses to materialize an interface
    whose private-key/peer/endpoint identity is already present.  The topology
    preflight must consume that existing safety result before it can request an
    Authority decision; otherwise it can advertise a source that the actual
    owner will (correctly) reject.  Values never leave this helper.
    """
    section = ""
    fields: dict[str, str] = {}
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return fields
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith(("#", ";")):
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip().lower()
            continue
        if "=" not in line:
            continue
        key, value = (part.strip() for part in line.split("=", 1))
        key = key.lower()
        if section == "interface" and key == "privatekey":
            fields["private_key"] = value
        elif section == "peer" and key == "publickey":
            fields["peer_public_key"] = value
        elif section == "peer" and key == "endpoint":
            fields["endpoint"] = value.lower()
    return fields


def _controlled_source_openvpn_identity(path: Path) -> dict[str, str]:
    """Redacted OpenVPN equality projection matching the draft lifecycle."""
    result: dict[str, str] = {}
    blocks: dict[str, list[str]] = {"cert": [], "key": []}
    active_block = ""
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return result
    for raw in lines:
        line = raw.strip()
        lower = line.lower()
        if lower in {"<cert>", "<key>"}:
            active_block = lower[1:-1]
            continue
        if lower in {"</cert>", "</key>"}:
            active_block = ""
            continue
        if active_block:
            blocks[active_block].append(raw.rstrip())
            continue
        if not line or line.startswith(("#", ";")):
            continue
        key, _, value = line.partition(" ")
        if key.lower() == "remote" and value.strip() and not result.get("remote"):
            result["remote"] = value.strip().lower()
        elif key.lower() == "proto" and value.strip() and not result.get("proto"):
            result["proto"] = value.strip().lower()
    result["proto"] = result.get("proto") or "udp"
    for name, lines in blocks.items():
        body = "\n".join(lines)
        if body:
            result[name] = hashlib.sha256(body.encode("utf-8")).hexdigest()
    return result


def _controlled_source_draft_duplicate_egress(
    *,
    protocol: str,
    config_path: Path,
    registry_rows: list[dict[str, str]],
    own_pool_egress_id: str,
) -> str:
    """Return only an existing conflicting egress id, never config data."""
    if protocol == "openvpn":
        identity = _controlled_source_openvpn_identity(config_path)
        required = ("remote", "proto")
    else:
        identity = _controlled_source_interface_identity(config_path)
        required = ("private_key", "peer_public_key", "endpoint")
    if not all(identity.get(key) for key in required):
        return ""
    for existing in registry_rows:
        egress_id = str(existing.get("id") or "").strip()
        if (
            not egress_id
            or egress_id == own_pool_egress_id
            or str(existing.get("type") or "") != "interface"
            or str(existing.get("protocol") or "") != protocol
        ):
            continue
        existing_path = Path(
            str(existing.get("config") or existing.get("config_path") or "")
        )
        other = (
            _controlled_source_openvpn_identity(existing_path)
            if protocol == "openvpn"
            else _controlled_source_interface_identity(existing_path)
        )
        compare_keys = list(required)
        if protocol == "openvpn":
            for key in ("cert", "key"):
                if identity.get(key) or other.get(key):
                    compare_keys.append(key)
        if all(other.get(key) == identity.get(key) for key in compare_keys):
            return egress_id
    return ""


def _controlled_source_draft_candidates(
    drafts_dir: Path,
    state_dir: Optional[Path] = None,
) -> list[dict[str, Any]]:
    """Project redacted existing admin draft lifecycle without reading secrets out."""
    rows: list[dict[str, Any]] = []
    if not drafts_dir.is_dir():
        return rows
    registry_rows = (
        parse_registry(state_dir / "egress.registry")
        if state_dir is not None else []
    )
    user_rows = (
        parse_registry(state_dir / "users.registry")
        if state_dir is not None else []
    )
    for metadata_path in sorted(drafts_dir.glob("*/metadata.json")):
        metadata = read_json(metadata_path, {})
        if not isinstance(metadata, dict):
            continue
        config_path = metadata_path.parent / "config.input"
        expected_hash = str(metadata.get("config_sha256") or "")
        normalized_hash = ""
        try:
            raw = config_path.read_bytes()
            normalized_hash = hashlib.sha256(raw.rstrip(b"\n")).hexdigest()
        except OSError:
            pass
        protocol = str(metadata.get("protocol") or "")
        runtime_mode = str(metadata.get("runtime_mode") or "")
        supported = bool(
            runtime_mode == "interface"
            and protocol in {"wireguard", "amneziawg", "openvpn"}
        )
        lifecycle_pass = all(
            str(metadata.get(key) or "") == "PASS"
            for key in (
                "last_preflight_status",
                "last_runtime_status",
                "last_quarantine_status",
            )
        )
        config_bound = bool(
            expected_hash
            and normalized_hash
            and expected_hash == normalized_hash
        )
        usage = (
            metadata.get("usage_policy")
            if isinstance(metadata.get("usage_policy"), dict)
            else {}
        )
        hard_limit = max(
            0,
            to_int(usage.get("hard_limit") or metadata.get("hard_limit"), 0),
        )
        label = str(metadata.get("label") or metadata_path.parent.name)
        proposed_id = (
            re.sub(r"[^A-Za-z0-9_.-]+", "-", label.lower()).strip("-")[:32]
            or metadata_path.parent.name[:32]
        )
        blockers = []
        if not supported:
            blockers.append("dedicated_source_protocol_adapter_not_supported")
        if not lifecycle_pass:
            blockers.append("draft_preflight_runtime_or_quarantine_not_passed")
        if not config_bound:
            blockers.append("draft_config_generation_changed")
        if hard_limit < 1:
            blockers.append("draft_one_identity_capacity_not_owned")
        pool_egress_id = str(metadata.get("pool_egress_id") or "")
        # A materialized draft is reusable only while it is genuinely empty.
        # ``added_disabled`` describes the admin lifecycle action, not the
        # current assignment reality: ordinary or another certification
        # campaign may have subsequently acquired the same source.  The
        # one-user topology contract reserves an *initially empty* source, so
        # never reinterpret an occupied source as dedicated merely because a
        # historic draft says it was added disabled.
        assigned_users = [
            user for user in user_rows
            if str(user.get("current") or "") == pool_egress_id
        ] if pool_egress_id else []
        ordinary_assigned_users = [
            user for user in assigned_users
            if not bool_value(user.get("certification_user"))
        ]
        if assigned_users:
            blockers.append(
                f"draft_materialized_source_not_empty:{pool_egress_id}"
            )
        if (
            proposed_id != pool_egress_id
            and any(
                str(existing.get("id") or "") == proposed_id
                for existing in registry_rows
            )
        ):
            blockers.append(
                f"draft_proposed_egress_id_already_exists:{proposed_id}"
            )
        duplicate_egress = _controlled_source_draft_duplicate_egress(
            protocol=protocol,
            config_path=config_path,
            registry_rows=registry_rows,
            own_pool_egress_id=pool_egress_id,
        ) if supported else ""
        if duplicate_egress:
            blockers.append(
                f"draft_duplicates_existing_interface_config:{duplicate_egress}"
            )
        row = {
            "draft_id": str(metadata.get("id") or metadata_path.parent.name),
            "proposed_source_id": proposed_id,
            # The draft lifecycle may already have materialized its disabled
            # pool entry.  Keep this current owner-owned binding compact so an
            # approved topology request can reserve that exact existing
            # source rather than attempting to create a duplicate channel.
            "pool_egress_id": pool_egress_id,
            "pool_action": str(metadata.get("pool_action") or ""),
            "runtime_profile_status": str(
                metadata.get("runtime_profile_status") or ""
            ),
            "protocol": protocol,
            "runtime_mode": runtime_mode,
            "status": str(metadata.get("status") or ""),
            "next_step": str(metadata.get("next_step") or ""),
            "preflight_status": str(metadata.get("last_preflight_status") or ""),
            "runtime_status": str(metadata.get("last_runtime_status") or ""),
            "quarantine_status": str(
                metadata.get("last_quarantine_status") or ""
            ),
            "config_generation_bound": config_bound,
            "config_fingerprint": normalized_hash,
            "duplicate_existing_egress": duplicate_egress,
            "assigned_user_count": len(assigned_users),
            "ordinary_assigned_user_count": len(ordinary_assigned_users),
            "hard_capacity": hard_limit,
            "one_identity_trial_capacity": max(0, hard_limit - 1),
            "ready_for_guarded_disabled_pool_preflight": not blockers,
            "blockers": sorted(set(blockers)),
            "owner": "existing admin/v7-admin-api egress draft lifecycle",
            "raw_config_returned": False,
        }
        row["fingerprint"] = sha256_json(row)
        rows.append(row)
    return rows


def _controlled_source_key_value_output(text: str) -> dict[str, str]:
    result: dict[str, str] = {}
    for raw in str(text or "").splitlines():
        if "=" not in raw:
            continue
        key, value = raw.split("=", 1)
        key = key.strip()
        if key:
            result[key] = value.strip()
    return result


def consume_approved_controlled_source_topology(args: argparse.Namespace) -> dict[str, Any]:
    """Consume one approved topology provision through the existing reservation owner.

    This is the missing handoff between the append-only topology Authority
    decision and an already materialized admin draft.  It never creates an
    egress, enables/disables an interface, creates execution artifacts, or
    moves a user.  It only reserves the exact existing empty source with the
    immutable one-identity manifest, and is exact-once in the existing audit.
    """
    forbidden = [
        name for name in (
            "apply",
            "emergency_failover_autonomy",
            "controlled_verifier_contention",
        )
        if bool_value(getattr(args, name, False))
    ]
    if forbidden:
        return {
            "schema_version": "v7.controlled-source-topology-provision-consumer.v1",
            "status": "STOP_SAFE_FORBIDDEN_FLAGS",
            "ok": False,
            "blockers": sorted(set(forbidden)),
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }
    diagnostic_args = copy.copy(args)
    diagnostic_args.controlled_source_validation_profile = "ct-m0f-one-user"
    diagnostic = controlled_source_topology_diagnostic(diagnostic_args)
    lifecycle = diagnostic.get("authority_lifecycle") if isinstance(diagnostic.get("authority_lifecycle"), dict) else {}
    package = diagnostic.get("authority_package") if isinstance(diagnostic.get("authority_package"), dict) else {}
    preflight = diagnostic.get("production_preflight") if isinstance(diagnostic.get("production_preflight"), dict) else {}
    manifest = preflight.get("manifest") if isinstance(preflight.get("manifest"), dict) else {}
    request_id = str(lifecycle.get("request_id") or "")
    request_hash = str(lifecycle.get("request_hash") or "")
    blockers: list[str] = []
    if diagnostic.get("status") != "CONTROLLED_SOURCE_TOPOLOGY_PRODUCTION_PREFLIGHT_READY":
        blockers.append("controlled_source_topology_preflight_not_ready")
    if lifecycle.get("status") != "APPROVED" or lifecycle.get("matching_current_preflight") is not True:
        blockers.append("controlled_source_topology_exact_approval_not_current")
    try:
        approval_expired = min(
            operator_execution.parse_ts(
                str(lifecycle.get("expires_at") or "")
            ),
            operator_execution.parse_ts(
                str((package.get("authority_basis") or {}).get("expires_at") or "")
            ),
        ) <= datetime.now(timezone.utc)
    except operator_execution.PacketError:
        approval_expired = True
    if approval_expired:
        blockers.append("controlled_source_topology_approval_expired")
    selected_option = str(manifest.get("selected_option") or "")
    rebind_existing = selected_option == "OPTION_1_REBIND_EXISTING_EMPTY_EGRESS"
    expected_decision = (
        "APPROVE_REBIND_CONTROLLED_CERTIFICATION_SOURCE"
        if rebind_existing
        else "APPROVE_PROVISION_DEDICATED_CONTROLLED_CERTIFICATION_SOURCE"
    )
    expected_action = (
        "REBIND_CONTROLLED_CERTIFICATION_SOURCE"
        if rebind_existing
        else "PROVISION_DEDICATED_CONTROLLED_CERTIFICATION_SOURCE"
    )
    if str(lifecycle.get("decision") or "") != expected_decision:
        blockers.append("controlled_source_topology_decision_not_provision_approval")
    if str(package.get("exact_action") or "") != expected_action:
        blockers.append("controlled_source_topology_action_changed")
    if manifest.get("validation_profile") != "CT_M0F_ONE_USER_CONTROLLED_CONDITION":
        blockers.append("controlled_source_topology_profile_changed")
    if int(manifest.get("trial_identity_count") or 0) != 1:
        blockers.append("controlled_source_topology_trial_scope_changed")
    if manifest.get("expected_ordinary_assignment_delta") != "NONE" or manifest.get("expected_ordinary_route_delta") != "NONE":
        blockers.append("controlled_source_topology_ordinary_delta_changed")
    draft_id = str(manifest.get("selected_source_or_draft") or "")
    state_dir = Path(args.state_dir)
    candidates = {
        str(row.get("draft_id") or ""): row
        for row in _controlled_source_draft_candidates(
            Path(args.egress_drafts_dir), state_dir
        )
    }
    draft = candidates.get(draft_id, {})
    source_id = (
        draft_id if rebind_existing
        else str(draft.get("pool_egress_id") or "")
    )
    if not rebind_existing and (not draft or not source_id):
        blockers.append("approved_draft_not_materialized_to_existing_pool_source")
    if not rebind_existing and draft and (
        draft.get("pool_action") not in {"added_disabled", "enabled"}
        or draft.get("runtime_profile_status") != "READY"
    ):
        blockers.append("approved_draft_runtime_lifecycle_not_ready")
    registry_rows = parse_registry(state_dir / "egress.registry")
    source_rows = [row for row in registry_rows if str(row.get("id") or "") == source_id]
    users = [row for row in parse_registry(state_dir / "users.registry") if bool_value(row.get("enabled", "1"))]
    source_users = [row for row in users if str(row.get("current") or "") == source_id]
    if len(source_rows) != 1:
        blockers.append("approved_draft_pool_source_not_unique")
    if source_users:
        blockers.append("approved_draft_pool_source_not_empty")
    source = source_rows[0] if len(source_rows) == 1 else {}
    if source:
        if rebind_existing:
            if (
                str(source.get("type") or "") != "interface"
                or not bool_value(source.get("enabled", "1"))
            ):
                blockers.append("approved_rebind_source_runtime_identity_changed")
        elif (
            str(source.get("protocol") or "") != str(draft.get("protocol") or "")
            or str(source.get("type") or "") != "interface"
            or not bool_value(source.get("enabled", "1"))
        ):
            blockers.append("approved_draft_pool_source_runtime_identity_changed")
    if blockers:
        return {
            "schema_version": "v7.controlled-source-topology-provision-consumer.v1",
            "status": "STOP_SAFE",
            "ok": False,
            "blockers": sorted(set(blockers)),
            "request_id": request_id,
            "request_hash": request_hash,
            "draft_id": draft_id,
            "source_id": source_id,
            "runtime_mutation_performed": False,
            "users_moved": 0,
        }
    reservation_id = "ctres_" + sha256_json({
        "request_id": request_id,
        "request_hash": request_hash,
        "manifest_hash": str(manifest.get("manifest_hash") or ""),
        "source_id": source_id,
    })[:24]
    audit_store = Path(args.action_class_audit_store)
    with operator_execution.current_action_class_contract_policy_lock(audit_store):
        records = operator_execution.read_live_execution_lineage_records(
            audit_store
        )
        receipts = [
            row for row in records
            if row.get("record_type") == operator_execution.CONTROLLED_SOURCE_TOPOLOGY_PROVISION_RECORD_TYPE
            and str(row.get("authority_request_id") or "") == request_id
        ]
        if receipts:
            exact = [
                row for row in receipts
                if str(row.get("authority_request_hash") or "") == request_hash
                and str(row.get("reservation_id") or "") == reservation_id
                and str(row.get("source_id") or "") == source_id
            ]
            if len(receipts) == 1 and len(exact) == 1:
                return {
                    "schema_version": "v7.controlled-source-topology-provision-consumer.v1",
                    "status": "ALREADY_CONSUMED_EXACT",
                    "ok": True,
                    "request_id": request_id,
                    "request_hash": request_hash,
                    "reservation_id": reservation_id,
                    "source_id": source_id,
                    "audit_write": False,
                    "registry_write": False,
                    "runtime_mutation_performed": False,
                    "users_moved": 0,
                }
            return {
                "schema_version": "v7.controlled-source-topology-provision-consumer.v1",
                "status": "STOP_SAFE_DUPLICATE_OR_CONFLICTING_PROVISION_RECEIPT",
                "ok": False,
                "request_id": request_id,
                "request_hash": request_hash,
                "runtime_mutation_performed": False,
                "users_moved": 0,
            }
        # A reservation without this consumer's exact append-only receipt is
        # an ambiguous partial predecessor.  Never overwrite or silently
        # adopt it; the fingerprint CAS below is only an additional guard.
        if any(
            str(source.get(key) or "").strip()
            for key in (
                "execution_reservation_id",
                "controlled_source_reservation_id",
                "reservation_id",
            )
        ):
            return {
                "schema_version": "v7.controlled-source-topology-provision-consumer.v1",
                "status": "STOP_SAFE_UNRECEIPTED_RESERVATION",
                "ok": False,
                "request_id": request_id,
                "request_hash": request_hash,
                "source_id": source_id,
                "runtime_mutation_performed": False,
                "users_moved": 0,
            }
        line = next(
            (
                item for item in (state_dir / "egress.registry").read_text(
                    encoding="utf-8", errors="replace"
                ).splitlines()
                if item.startswith(f"id={source_id} ")
            ),
            "",
        )
        expected_fingerprint = hashlib.sha256(line.encode("utf-8")).hexdigest()
        expires_at = min(
            operator_execution.parse_ts(str(lifecycle.get("expires_at") or "")),
            operator_execution.parse_ts(str((package.get("authority_basis") or {}).get("expires_at") or "")),
            datetime.now(timezone.utc) + timedelta(minutes=30),
        ).isoformat()
        owner = str(manifest.get("reservation_owner") or "v7-egress-set-state")
        command = [
            owner, source_id, "certification-reserve",
            "--certification-group", str(manifest.get("certification_group") or ""),
            "--reservation-id", reservation_id,
            "--reservation-expires-at", expires_at,
            "--expected-egress-fingerprint", expected_fingerprint,
            "--apply", "--confirm", "RESERVE_CONTROLLED_CERTIFICATION_SOURCE",
        ]
        env = dict(os.environ)
        env["V7_STATE_DIR"] = str(state_dir)
        try:
            proc = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False, timeout=180, env=env)
        except (OSError, subprocess.TimeoutExpired) as exc:
            return {
                "schema_version": "v7.controlled-source-topology-provision-consumer.v1",
                "status": "STOP_SAFE_RESERVATION_OWNER_UNAVAILABLE",
                "ok": False,
                "error": f"{type(exc).__name__}:{exc}",
                "runtime_mutation_performed": False,
                "users_moved": 0,
            }
        result = _controlled_source_key_value_output(proc.stdout or "")
        if proc.returncode != 0 or result.get("ACTION") != "controlled_source_reserved":
            return {
                "schema_version": "v7.controlled-source-topology-provision-consumer.v1",
                "status": "STOP_SAFE_RESERVATION_NOT_APPLIED",
                "ok": False,
                "request_id": request_id,
                "source_id": source_id,
                "reservation_result": result,
                "runtime_mutation_performed": False,
                "users_moved": 0,
            }
        receipt = operator_execution.append_record(audit_store, {
            "schema_version": "v7.controlled-source-topology-provision-receipt.v1",
            "record_type": operator_execution.CONTROLLED_SOURCE_TOPOLOGY_PROVISION_RECORD_TYPE,
            "authority_request_id": request_id,
            "authority_request_hash": request_hash,
            "authority_decision_id": str(lifecycle.get("decision_id") or ""),
            "manifest_hash": str(manifest.get("manifest_hash") or ""),
            "draft_id": draft_id,
            "source_id": source_id,
            "reservation_id": reservation_id,
            "reservation_expires_at": expires_at,
            "reservation_owner": owner,
            "restore_backup": str(result.get("restore_backup") or ""),
            "created_at": now_iso(),
            "ordinary_user_delta": 0,
            "routing_mutation": False,
            "users_moved": 0,
            "candidate_created": False,
            "packet_created": False,
            "lease_created": False,
            "controlled_failure_created": False,
            "natural_l8_credit": False,
        })
    return {
        "schema_version": "v7.controlled-source-topology-provision-consumer.v1",
        "status": "CONTROLLED_SOURCE_TOPOLOGY_PROVISIONED",
        "ok": True,
        "request_id": request_id,
        "request_hash": request_hash,
        "decision_id": str(lifecycle.get("decision_id") or ""),
        "draft_id": draft_id,
        "source_id": source_id,
        "reservation_id": reservation_id,
        "reservation_expires_at": expires_at,
        "restore_backup": str(result.get("restore_backup") or ""),
        "audit_record_hash": str(receipt.get("record_hash") or ""),
        "audit_write": True,
        "registry_write": True,
        "runtime_mutation_performed": True,
        "routing_mutation": False,
        "users_moved": 0,
        "candidate_created": False,
        "packet_created": False,
        "lease_created": False,
        "controlled_failure_created": False,
        "natural_l8_credit": False,
        "next_required_consumer": "existing CT-M0F source-selection and controlled-condition owners",
    }


def reconcile_released_controlled_source_topology(args: argparse.Namespace) -> dict[str, Any]:
    """Record a strict release-to-fresh-request boundary through the same owner."""
    diagnostic_args = copy.copy(args)
    diagnostic_args.controlled_source_validation_profile = "ct-m0f-one-user"
    diagnostic = controlled_source_topology_diagnostic(diagnostic_args)
    lifecycle = diagnostic.get("authority_lifecycle") if isinstance(diagnostic.get("authority_lifecycle"), dict) else {}
    manifest = (diagnostic.get("production_preflight") or {}).get("manifest") or {}
    draft_id = str(manifest.get("selected_source_or_draft") or "")
    drafts = {
        str(row.get("draft_id") or ""): row
        for row in _controlled_source_draft_candidates(
            Path(args.egress_drafts_dir), Path(args.state_dir)
        )
    }
    rebind_existing = (
        str(manifest.get("selected_option") or "")
        == "OPTION_1_REBIND_EXISTING_EMPTY_EGRESS"
    )
    source_id = (
        draft_id if rebind_existing
        else str((drafts.get(draft_id) or {}).get("pool_egress_id") or "")
    )
    registry_rows = parse_registry(Path(args.state_dir) / "egress.registry")
    source_rows = [row for row in registry_rows if str(row.get("id") or "") == source_id]
    users = [row for row in parse_registry(Path(args.state_dir) / "users.registry") if bool_value(row.get("enabled", "1"))]
    source = source_rows[0] if len(source_rows) == 1 else {}
    reservation_keys = ("execution_reservation_id", "controlled_source_reservation_id", "reservation_id")
    marker_keys = ("controlled_certification_source", "execution_reserved", "canary_reserved", "reservation_owner", "certification_group")
    snapshot = {
        "source_id": source_id,
        "source_exists": len(source_rows) == 1,
        "reservation_absent": not any(str(source.get(key) or "").strip() for key in reservation_keys),
        "controlled_source_markers_absent": not any(bool_value(source.get(key)) if key != "reservation_owner" and key != "certification_group" else str(source.get(key) or "").strip() for key in marker_keys),
        "assigned_user_count": sum(1 for row in users if str(row.get("current") or "") == source_id),
    }
    snapshot["snapshot_fingerprint"] = sha256_json(snapshot)
    if lifecycle.get("status") != "APPROVED" or not source_id:
        return {"schema_version": "v7.controlled-source-topology-release-reconciliation.v1", "status": "STOP_SAFE_PREDECESSOR_REQUIRED", "ok": False, "blockers": ["exact_approved_topology_request_required"], "runtime_mutation_performed": False, "users_moved": 0}
    try:
        result = operator_execution.invalidate_released_controlled_source_topology_request(
            request_id=str(lifecycle.get("request_id") or ""),
            request_hash=str(lifecycle.get("request_hash") or ""),
            source_id=source_id,
            release_snapshot=snapshot,
            audit_store=Path(args.action_class_audit_store),
        )
    except operator_execution.PacketError as exc:
        return {"schema_version": "v7.controlled-source-topology-release-reconciliation.v1", "status": "STOP_SAFE_PREDECESSOR_REQUIRED", "ok": False, "blockers": [str(exc)], "source_id": source_id, "runtime_mutation_performed": False, "users_moved": 0}
    return {"schema_version": "v7.controlled-source-topology-release-reconciliation.v1", "status": result.get("status"), "ok": True, "source_id": source_id, "invalidation_id": result.get("invalidation_id"), "audit_write": bool(result.get("audit_write")), "runtime_mutation_performed": False, "routing_mutation": False, "users_moved": 0, "candidate_created": False, "packet_created": False, "lease_created": False}


def controlled_source_topology_diagnostic(
    args: argparse.Namespace,
) -> dict[str, Any]:
    """Close the non-waiting source-topology discovery and preflight gap.

    This is a compact derived projection over existing owners.  It does not
    become a registry and deliberately emits no production evidence credit.
    """
    state_dir = Path(args.state_dir)
    forbidden = [
        name for name in (
            "apply",
            "controlled_verifier_contention",
            "allow_pre_planner_refresh_with_apply",
        )
        if bool_value(getattr(args, name, False))
    ]
    forbidden.extend(
        name for name in (
            "approved_packet_id",
            "approved_operation_id",
            "approved_selected_move_hash",
            "approved_authority_generation",
            "approved_breaker_generation",
            "approved_source_bundle_hash",
            "approved_snapshot_bundle_hash",
            "generate_rollback_packet_from_result",
            "rollback_packet",
            "promote_authority_to",
        )
        if str(getattr(args, name, "") or "").strip()
    )
    forbidden_effects = {
        "registry_write": False,
        "policy_write": False,
        "identity_creation": False,
        "assignment_change": False,
        "candidate_created": False,
        "packet_created": False,
        "lease_created": False,
        "restore_barrier_write": False,
        "runtime_apply": False,
        "routing_mutation": False,
        "user_movement": 0,
        "rollback_apply": False,
        "authority_expansion": False,
        "production_maturity_change": False,
        "controlled_production_credit": False,
        "natural_l8_credit": False,
    }
    if forbidden:
        return {
            "schema_version": "v7.controlled-source-topology-capability-map.v1",
            "status": "STOP_SAFE_FORBIDDEN_FLAGS",
            "ok": False,
            "blockers": sorted(set(forbidden)),
            "forbidden_effects": forbidden_effects,
        }

    target_diagnostic = (
        controlled_campaign_target_selection_diagnostic(args)
        if getattr(args, "policy_file", "")
        else {"targets": []}
    )
    shared_target_projection = (
        target_diagnostic.get("shared_production_target_capacity_projection")
        if isinstance(
            target_diagnostic.get("shared_production_target_capacity_projection"),
            dict,
        ) else {}
    )
    policy_root = read_json(Path(args.policy_file), {})
    policy_contract = (
        policy_root.get("delegated_autonomy_policy")
        if isinstance(policy_root, dict)
        and isinstance(policy_root.get("delegated_autonomy_policy"), dict)
        else {}
    )
    policy_validation = (
        operator_execution.validate_standing_delegated_operational_policy(
            policy_contract,
            # A standing Authority decision can legitimately live in a bounded
            # rotated audit segment.  This topology consumer must use the same
            # compact durable-lineage projection as the policy-status and
            # target-selection consumers; otherwise one active contract is
            # simultaneously PASS and "missing" depending on which existing
            # consumer read it.  It remains a read-only projection, not a new
            # registry or cache.
            audit_records=operator_execution.read_live_execution_lineage_records(
                Path(args.action_class_audit_store)
            ),
        )
    )
    policy = (
        policy_validation.get("policy")
        if isinstance(policy_validation.get("policy"), dict)
        else {}
    )
    topology_scope = (
        (policy.get("action_class_scopes") or {}).get(
            operator_execution.CONTROLLED_TOPOLOGY_DELEGATED_ACTION_CLASS
        )
        if isinstance(policy.get("action_class_scopes"), dict)
        else {}
    )
    topology_scope = topology_scope if isinstance(topology_scope, dict) else {}
    topology_policy_blockers = list(policy_validation.get("errors") or [])
    if (
        policy.get("policy_profile")
        not in {
            operator_execution.CONTROLLED_TOPOLOGY_STANDING_POLICY_PROFILE,
            operator_execution.AVAILABILITY_FIRST_STANDING_POLICY_PROFILE,
        }
    ):
        topology_policy_blockers.append(
            "controlled_topology_standing_policy_profile_missing"
        )
    if (
        operator_execution.CONTROLLED_TOPOLOGY_DELEGATED_ACTION_CLASS
        not in set(policy.get("allowed_action_classes") or [])
    ):
        topology_policy_blockers.append(
            "controlled_topology_action_class_not_allowed"
        )
    exact_topology_requirements = {
        "allowed_actions": ["REBIND_CONTROLLED_CERTIFICATION_SOURCE"],
        "certification_identities_only": True,
        "max_users_per_transaction": 1,
        "max_concurrent_transactions": 1,
        "ordinary_identity_delta": 0,
        "ordinary_route_delta": 0,
        "ordinary_assignment_mutation_allowed": False,
        "target_ordinary_users": 0,
        "immutable_manifest_required": True,
        "fresh_candidate_required": True,
        "fresh_packet_required": True,
        "fresh_lease_required": True,
        "restore_barrier_before_apply_required": True,
        "verification_required": True,
        "bounded_idempotent_rollback_required": True,
        "private_credential_mutation_allowed": False,
        "external_resource_creation_allowed": False,
        "hard_limit_modification_allowed": False,
        "authority_self_expansion_allowed": False,
    }
    for field, expected in exact_topology_requirements.items():
        if topology_scope.get(field) != expected:
            topology_policy_blockers.append(
                f"controlled_topology_scope_{field}_mismatch"
            )
    topology_policy_admission = {
        "schema_version": (
            "v7.controlled-certification-topology-standing-policy-admission.v1"
        ),
        "status": (
            "AUTO_ADMITTED_BY_STANDING_DELEGATED_CONTROLLED_TOPOLOGY_POLICY"
            if not topology_policy_blockers
            else "STANDING_DELEGATED_CONTROLLED_TOPOLOGY_POLICY_REQUIRED"
        ),
        "ok": not topology_policy_blockers,
        "contract_id": str(policy_contract.get("contract_id") or ""),
        "contract_hash": str(policy_contract.get("contract_hash") or ""),
        "policy_profile": str(policy.get("policy_profile") or ""),
        "policy_scope_hash": str(policy_contract.get("policy_scope_hash") or ""),
        "action_class": (
            operator_execution.CONTROLLED_TOPOLOGY_DELEGATED_ACTION_CLASS
        ),
        "max_users_per_transaction": int(
            topology_scope.get("max_users_per_transaction") or 0
        ),
        "max_concurrent_transactions": int(
            topology_scope.get("max_concurrent_transactions") or 0
        ),
        "blockers": sorted(set(topology_policy_blockers)),
        "authority_self_expansion": False,
        "production_effect_performed": False,
    }
    availability_scope = (
        (policy.get("action_class_scopes") or {}).get(
            operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
        )
        if isinstance(policy.get("action_class_scopes"), dict)
        else {}
    )
    availability_scope = (
        availability_scope
        if isinstance(availability_scope, dict)
        else {}
    )
    availability_policy_blockers = list(
        policy_validation.get("errors") or []
    )
    if (
        policy.get("policy_profile")
        != operator_execution.AVAILABILITY_FIRST_STANDING_POLICY_PROFILE
    ):
        availability_policy_blockers.append(
            "availability_first_standing_policy_profile_missing"
        )
    if (
        operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
        not in set(policy.get("allowed_action_classes") or [])
    ):
        availability_policy_blockers.append(
            "availability_first_action_class_not_allowed"
        )
    exact_availability_requirements = {
        "allowed_actions": list(
            operator_execution.AVAILABILITY_FIRST_ALLOWED_ACTIONS
        ),
        "certification_identities_only": True,
        "max_concurrent_transactions": 1,
        "ladder": list(operator_execution.AVAILABILITY_FIRST_LADDER),
        "ladder_stage_semantics": (
            "EXACT_TOTAL_COHORT_WITH_BASELINE_RESET"
        ),
        "ordinary_identity_delta": 0,
        "ordinary_route_delta": 0,
        "ordinary_assignment_mutation_allowed": False,
        "ordinary_reclassification_allowed": False,
        "shared_target_fault_injection_allowed": False,
        "shared_target_restart_allowed": False,
        "capacity_double_counting_forbidden": True,
        "source_target_collision_forbidden": True,
        "immutable_allocation_required": True,
        "fresh_inventory_required": True,
        "fresh_candidate_required": True,
        "fresh_packet_or_packet_set_required": True,
        "fresh_lease_required": True,
        "restore_barrier_before_apply_required": True,
        "per_user_verification_required": True,
        "per_target_verification_required": True,
        "aggregate_verification_required": True,
        "ordinary_user_quality_verification_required": True,
        "cohort_circuit_breaker_required": True,
        "partial_target_containment_required": True,
        "rollback_or_redistribution_required": True,
        "baseline_reset_between_stages_required": True,
        "authority_self_expansion_allowed": False,
    }
    for field, expected in exact_availability_requirements.items():
        if availability_scope.get(field) != expected:
            availability_policy_blockers.append(
                f"availability_first_scope_{field}_mismatch"
            )
    availability_max_users = int(
        availability_scope.get("max_users_per_transaction") or 0
    )
    if (
        availability_max_users < 1
        or availability_max_users
        != int(policy.get("max_users_per_action") or 0)
    ):
        availability_policy_blockers.append(
            "availability_first_scope_blast_radius_mismatch"
        )
    availability_policy_admission = {
        "schema_version": (
            "v7.availability-first-standing-policy-admission.v1"
        ),
        "status": (
            "AUTO_ADMITTED_BY_STANDING_DELEGATED_"
            "AVAILABILITY_FIRST_POLICY"
            if not availability_policy_blockers
            else "STANDING_DELEGATED_AVAILABILITY_FIRST_POLICY_REQUIRED"
        ),
        "ok": not availability_policy_blockers,
        "contract_id": str(policy_contract.get("contract_id") or ""),
        "contract_hash": str(policy_contract.get("contract_hash") or ""),
        "policy_profile": str(policy.get("policy_profile") or ""),
        "policy_scope_hash": str(
            policy_contract.get("policy_scope_hash") or ""
        ),
        "action_class": (
            operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
        ),
        "max_users_per_transaction": availability_max_users,
        "max_concurrent_transactions": int(
            availability_scope.get("max_concurrent_transactions") or 0
        ),
        "ladder": list(availability_scope.get("ladder") or []),
        "blockers": sorted(set(availability_policy_blockers)),
        "authority_self_expansion": False,
        "production_effect_performed": False,
    }
    topology_authority_status = (
        operator_execution.controlled_source_topology_authority_status(
            operator_execution.read_live_execution_lineage_records(
                Path(args.action_class_audit_store)
            )
        )
    )
    prior_topology_request = (
        topology_authority_status.get("request")
        if isinstance(topology_authority_status.get("request"), dict)
        else {}
    )
    prior_topology_manifest = (
        prior_topology_request.get("manifest")
        if isinstance(prior_topology_request.get("manifest"), dict)
        else {}
    )
    declined_rebind_sources = set()
    declined_drafts = set()
    if topology_authority_status.get("status") == "DECLINED":
        declined_resource = str(
            prior_topology_manifest.get("selected_source_or_draft") or ""
        )
        if (
            prior_topology_request.get("exact_action")
            == "REBIND_CONTROLLED_CERTIFICATION_SOURCE"
            and declined_resource
        ):
            declined_rebind_sources.add(declined_resource)
        if (
            prior_topology_request.get("exact_action")
            == "PROVISION_DEDICATED_CONTROLLED_CERTIFICATION_SOURCE"
            and declined_resource
        ):
            declined_drafts.add(declined_resource)
    validation_profile = str(
        getattr(args, "controlled_source_validation_profile", "campaign")
        or "campaign"
    ).strip().lower()
    if validation_profile not in {"campaign", "ct-m0f-one-user"}:
        return {
            "schema_version": "v7.controlled-source-topology-capability-map.v1",
            "status": "STOP_SAFE_UNKNOWN_VALIDATION_PROFILE",
            "ok": False,
            "blockers": ["controlled_source_validation_profile_invalid"],
            "forbidden_effects": forbidden_effects,
        }
    audit_records = operator_execution.read_live_execution_lineage_records(
        Path(args.action_class_audit_store)
    )
    ct_m0f_contract = (
        policy_root.get(operator_execution.CT_M0F_STANDING_VALIDATION_POLICY_KEY)
        if isinstance(policy_root, dict)
        and isinstance(
            policy_root.get(
                operator_execution.CT_M0F_STANDING_VALIDATION_POLICY_KEY
            ),
            dict,
        )
        else {}
    )
    ct_m0f_validation = operator_execution.validate_ct_m0f_standing_validation_policy(
        ct_m0f_contract,
        audit_records=audit_records,
    )
    ct_m0f_decision = (
        ct_m0f_contract.get("authority_decision")
        if isinstance(ct_m0f_contract.get("authority_decision"), dict)
        else {}
    )
    ct_m0f_basis = (
        {
            "kind": "CT_M0F_STANDING_VALIDATION_POLICY",
            "contract_id": str(ct_m0f_contract.get("contract_id") or ""),
            "contract_hash": str(ct_m0f_contract.get("contract_hash") or ""),
            "authority_request_id": str(
                ct_m0f_decision.get("request_id") or ""
            ),
            "authority_request_hash": str(
                ct_m0f_decision.get("request_hash") or ""
            ),
            "expires_at": str(ct_m0f_contract.get("expires_at") or ""),
        }
        if validation_profile == "ct-m0f-one-user" and ct_m0f_validation.get("ok")
        else {}
    )
    campaign = (
        target_diagnostic.get("campaign")
        if isinstance(target_diagnostic.get("campaign"), dict)
        else {}
    )
    source_id = str(campaign.get("source_id") or "")
    campaign_stages = (
        [1]
        if validation_profile == "ct-m0f-one-user"
        else sorted({
            to_int(value, 0)
            for value in (
                list(campaign.get("remaining_stages") or [])
                + list(campaign.get("completed_stages") or [])
                + [campaign.get("current_stage")]
            )
            if to_int(value, 0) > 0
        }) or [5, 10, 25, 48]
    )
    current_stage = (
        1 if validation_profile == "ct-m0f-one-user"
        else max(1, to_int(campaign.get("current_stage"), 0) or 5)
    )
    campaign_completion_stage = (
        1 if validation_profile == "ct-m0f-one-user"
        else max(campaign_stages)
    )
    rows = [
        row for row in (target_diagnostic.get("targets") or [])
        if isinstance(row, dict)
    ]
    registry_rows = parse_registry(Path(args.state_dir) / "egress.registry")
    registry_by_id = {
        str(row.get("id") or ""): row
        for row in registry_rows
        if str(row.get("id") or "")
    }
    assignment_rows = [
        row for row in parse_registry(Path(args.state_dir) / "users.registry")
        if bool_value(row.get("enabled", "1"))
    ]
    source_registry = registry_by_id.get(source_id, {})
    campaign_group = str(source_registry.get("certification_group") or "")
    campaign_identity_rows = [
        row for row in assignment_rows
        if bool_value(row.get("certification_user"))
        and (
            not campaign_group
            or str(row.get("certification_group") or "") == campaign_group
        )
    ]
    campaign_identity_locations: dict[str, int] = {}
    for row in campaign_identity_rows:
        location = str(row.get("current") or "UNASSIGNED")
        campaign_identity_locations[location] = (
            campaign_identity_locations.get(location, 0) + 1
        )
    campaign_identity_count = len(campaign_identity_rows)
    # ``campaign.source_id`` is immutable historical admission lineage.  It
    # can legitimately differ from the current controlled source after an
    # owner-backed topology rebind.  Accounting needs present route truth, so
    # use the single live controlled source carrying this campaign group when
    # it is unambiguous; otherwise retain the historical source and fail the
    # semantic selection closed in the projection rather than guessing.
    live_campaign_source_candidates = sorted(
        str(row.get("id") or "")
        for row in registry_rows
        if bool_value(row.get("controlled_certification_source"))
        and str(row.get("certification_group") or "") == campaign_group
        and int(campaign_identity_locations.get(str(row.get("id") or ""), 0))
        > 0
    )
    campaign_identity_baseline_source_id = (
        live_campaign_source_candidates[0]
        if len(live_campaign_source_candidates) == 1
        else source_id
    )
    reservation_owner = _controlled_source_reservation_owner_capability()
    certification_users = sorted(
        str(row.get("ip") or "")
        for row in assignment_rows
        if bool_value(row.get("certification_user"))
        and str(row.get("current") or "") == source_id
        and str(row.get("ip") or "")
    )
    trial_identity = certification_users[0] if certification_users else ""
    ct_trial_identity_source = ""
    if validation_profile == "ct-m0f-one-user" and ct_m0f_basis:
        ct_candidates = sorted(
            (
                row for row in assignment_rows
                if bool_value(row.get("certification_user"))
                and str(row.get("ip") or "")
                and str(row.get("current") or "")
            ),
            key=lambda row: (
                str(row.get("current") or ""),
                str(row.get("ip") or ""),
            ),
        )
        if ct_candidates:
            selected_ct_identity = ct_candidates[0]
            trial_identity = str(selected_ct_identity.get("ip") or "")
            ct_trial_identity_source = str(
                selected_ct_identity.get("current") or ""
            )
            source_id = ct_trial_identity_source
            source_registry = registry_by_id.get(source_id, {})
            campaign_group = str(
                selected_ct_identity.get("certification_group") or ""
            )
            campaign_identity_rows = [selected_ct_identity]
            campaign_identity_locations = {ct_trial_identity_source: 1}
            campaign_identity_count = 1
            campaign_identity_baseline_source_id = ct_trial_identity_source
    certification_identity_fingerprint = sha256_json(sorted(
        str(row.get("ip") or "")
        for row in campaign_identity_rows
        if str(row.get("ip") or "")
    ))
    # This is deliberately a compact derived read model, not a second
    # campaign registry.  The assignments owner remains authoritative for
    # every identity.  A stage may proceed only when the complete immutable
    # certification cohort can be balanced against current route truth;
    # retaining raw user lists here would make periodic Matrix projections
    # grow with the cohort.
    campaign_identity_ips = sorted(
        str(row.get("ip") or "")
        for row in campaign_identity_rows
        if str(row.get("ip") or "")
    )
    campaign_identity_unique_count = len(set(campaign_identity_ips))
    campaign_identity_unassigned_count = sum(
        1
        for row in campaign_identity_rows
        if not str(row.get("current") or "").strip()
        or str(row.get("current") or "") == "UNASSIGNED"
    )
    campaign_identity_source_count = int(
        campaign_identity_locations.get(
            campaign_identity_baseline_source_id,
            0,
        )
    )
    campaign_identity_target_counts = {
        location: int(count)
        for location, count in campaign_identity_locations.items()
        if location != campaign_identity_baseline_source_id
    }
    campaign_identity_target_count = sum(
        campaign_identity_target_counts.values()
    )
    # Availability-first certification always returns the cohort to the
    # controlled baseline.  Until that reset receipt is consumed, every
    # non-baseline current route is therefore an in-flight forward/reset
    # member, not a stable target allocation.  This keeps the balance causal
    # without duplicating the mutable execution lease or raw identity set.
    campaign_identity_active_forward_count = campaign_identity_target_count
    campaign_identity_accounted_count = (
        campaign_identity_source_count
        + campaign_identity_active_forward_count
    )
    campaign_identity_accounting = {
        "schema_version": "v7.controlled-campaign-identity-accounting.v1",
        "status": (
            "ACCOUNTED"
            if (
                campaign_identity_count > 0
                and campaign_identity_unique_count == campaign_identity_count
                and campaign_identity_unassigned_count == 0
                and campaign_identity_accounted_count
                == campaign_identity_count
            )
            else "CAMPAIGN_IDENTITY_ACCOUNTING_BROKEN"
        ),
        "expected_identity_count": campaign_identity_count,
        "identity_set_fingerprint": certification_identity_fingerprint,
        "baseline_source_id": campaign_identity_baseline_source_id,
        "baseline_source_selection": (
            "CURRENT_CONTROLLED_SOURCE_GROUP_OCCUPANCY"
            if len(live_campaign_source_candidates) == 1
            else "HISTORICAL_CAMPAIGN_SOURCE_FALLBACK_AMBIGUOUS_OR_EMPTY"
        ),
        "baseline_source_count": campaign_identity_source_count,
        "target_count": 0,
        "target_locations": dict(sorted(campaign_identity_target_counts.items())),
        "active_forward_count": campaign_identity_active_forward_count,
        "active_reset_count": 0,
        "contained_count": 0,
        "accounted_count": campaign_identity_accounted_count,
        "unique_identity_count": campaign_identity_unique_count,
        "unassigned_count": campaign_identity_unassigned_count,
        "raw_user_list_stored": False,
        "balance": {
            "expected": campaign_identity_count,
            "baseline_source": campaign_identity_source_count,
            "targets": 0,
            "active_forward": campaign_identity_active_forward_count,
            "active_reset": 0,
            "contained": 0,
            "accounted": campaign_identity_accounted_count,
        },
    }

    rebind_candidates = []
    for row in rows:
        target_id = str(row.get("target_id") or "")
        registry = registry_by_id.get(target_id, {})
        capacity = (
            row.get("capacity") if isinstance(row.get("capacity"), dict) else {}
        )
        quality = (
            row.get("quality") if isinstance(row.get("quality"), dict) else {}
        )
        ordinary_users = int(capacity.get("ordinary_users") or 0)
        certification_user_count = int(
            capacity.get("certification_users") or 0
        )
        assigned_rows = [
            item for item in assignment_rows
            if str(item.get("current") or "") == target_id
        ]
        assigned_certification_rows = [
            item for item in assigned_rows
            if bool_value(item.get("certification_user"))
        ]
        free_capacity = int(capacity.get("free_capacity_after_reserve") or 0)
        empty = int(capacity.get("current_assigned_users") or 0) == 0
        reservation_id = str(
            registry.get("controlled_source_reservation_id") or ""
        )
        reservation_expires_at = str(
            registry.get("controlled_source_reservation_expires_at") or ""
        )
        reservation_unexpired = bool(
            reservation_id
            and reservation_expires_at
            and parse_ts(reservation_expires_at) > time.time()
        )
        reserved_controlled_source = bool(
            bool_value(registry.get("controlled_certification_source"))
            and bool_value(registry.get("execution_reserved"))
            and bool_value(registry.get("canary_reserved"))
            and str(registry.get("reservation_owner") or "")
            == "operator_execution_governance"
            and not bool_value(registry.get("autoswitch_allowed"))
            and not bool_value(registry.get("rebalance_allowed"))
            and str(
                registry.get("production_assignment_allowed") or ""
            ).lower() in {"0", "false", "no"}
        )
        reserved_group = str(registry.get("certification_group") or "")
        assigned_groups = sorted({
            str(item.get("certification_group") or "")
            for item in assigned_certification_rows
        })
        reservation_group_aligned = bool(
            not assigned_certification_rows
            or (
                reserved_group
                and assigned_groups == [reserved_group]
            )
        )
        campaign_group_aligned = bool(
            not assigned_certification_rows
            or (
                campaign_group
                and all(
                    str(item.get("certification_group") or "")
                    == campaign_group
                    for item in assigned_certification_rows
                )
            )
        )
        # An empty reserved source still belongs to its current reservation
        # group.  Treating an empty assignment list as permission to reuse a
        # different group's live reservation would silently steal another
        # controlled operation's source.  Only a released/expired reservation
        # may be rebound across groups through the existing owner.
        reservation_campaign_group_compatible = bool(
            not reservation_unexpired
            or (
                reserved_group
                and campaign_group
                and reserved_group == campaign_group
            )
        )
        continuing_campaign_source_repairable = bool(
            reserved_controlled_source
            and ordinary_users == 0
            and bool(assigned_certification_rows)
            and campaign_group_aligned
        )
        continuing_reservation_valid = bool(
            reserved_controlled_source
            and ordinary_users == 0
            and reservation_unexpired
            and reservation_group_aligned
            and campaign_group_aligned
            and reservation_campaign_group_compatible
        )
        # CT-M0F is a one-identity controlled condition, not a shortcut for
        # repairing or reusing a wider certification campaign.  A source with
        # an expired reservation or more than one certification identity may
        # remain relevant to the wider campaign projection, but is never an
        # admissible CT-M0F fault source.
        ct_m0f_exact_source_scope_eligible = bool(
            validation_profile != "ct-m0f-one-user"
            or (
                empty
                and ordinary_users == 0
            )
            or (
                continuing_reservation_valid
                and len(assigned_certification_rows) == 1
                and certification_user_count == 1
            )
        )
        hard_gate_blockers = []
        if target_id == source_id:
            hard_gate_blockers.append("same_as_current_failed_source")
        if not bool((row.get("health") or {}).get("ok")):
            hard_gate_blockers.append("healthy_baseline_not_proven")
        if quality.get("blockers"):
            hard_gate_blockers.append("quality_or_stability_floor_not_met")
        if ordinary_users:
            hard_gate_blockers.append(
                "ordinary_users_share_whole_egress_failure_domain"
            )
        if (
            not empty
            and not reserved_controlled_source
            and not continuing_campaign_source_repairable
        ):
            hard_gate_blockers.append("source_not_empty_before_reservation")
        if (
            reserved_controlled_source
            and not reservation_unexpired
            and not continuing_campaign_source_repairable
        ):
            hard_gate_blockers.append(
                "controlled_source_reservation_expired"
            )
        if (
            reserved_controlled_source
            and not reservation_group_aligned
            and not continuing_campaign_source_repairable
        ):
            hard_gate_blockers.append(
                "controlled_source_reservation_group_mismatch"
            )
        if reserved_controlled_source and not campaign_group_aligned:
            hard_gate_blockers.append(
                "controlled_source_campaign_group_mismatch"
            )
        if (
            reserved_controlled_source
            and not reservation_campaign_group_compatible
        ):
            hard_gate_blockers.append(
                "controlled_source_reservation_campaign_group_mismatch"
            )
        if not ct_m0f_exact_source_scope_eligible:
            hard_gate_blockers.append(
                "ct_m0f_source_not_empty_or_exact_one_identity_current_reservation"
            )
        if free_capacity < 1:
            hard_gate_blockers.append("one_identity_capacity_unavailable")
        if not row.get("verification_supported"):
            hard_gate_blockers.append("baseline_verification_not_supported")
        if not row.get("rollback_containment_supported"):
            hard_gate_blockers.append("bounded_rollback_not_supported")
        if reservation_owner.get("status") != "READY":
            hard_gate_blockers.append(
                "certification_reservation_and_release_owner_missing"
            )
        rebind_candidates.append({
            "source_id": target_id,
            "protocol": str(row.get("protocol") or ""),
            "interface": str(row.get("interface") or ""),
            "ordinary_identities": ordinary_users,
            "certification_identities": certification_user_count,
            "campaign_certification_identities": sum(
                1
                for item in assigned_certification_rows
                if (
                    campaign_group
                    and str(item.get("certification_group") or "")
                    == campaign_group
                )
            ),
            "healthy_baseline": bool((row.get("health") or {}).get("ok")),
            "stability_pass": not bool(quality.get("blockers")),
            "free_capacity_after_reserve": free_capacity,
            "supports_all_48_identities": (
                free_capacity
                + sum(
                    1
                    for item in assigned_certification_rows
                    if (
                        campaign_group
                        and str(item.get("certification_group") or "")
                        == campaign_group
                    )
                )
                >= max(48, campaign_identity_count)
            ),
            "separate_certification_policy_tables": True,
            "separate_route_rules": True,
            "independently_controllable_failure_boundary": bool(
                ordinary_users == 0
                and (empty or continuing_reservation_valid)
            ),
            "initial_empty_reservation_eligible": bool(
                empty and ordinary_users == 0
            ),
            "continuing_campaign_source_repairable": (
                continuing_campaign_source_repairable
            ),
            "ct_m0f_exact_source_scope_eligible": (
                ct_m0f_exact_source_scope_eligible
            ),
            "existing_controlled_reservation": {
                "present": reserved_controlled_source,
                "reservation_id": reservation_id,
                "expires_at": reservation_expires_at,
                "unexpired": reservation_unexpired,
                "reservation_group": reserved_group,
                "assigned_certification_groups": assigned_groups,
                "reservation_group_aligned": reservation_group_aligned,
                "campaign_group": campaign_group,
                "campaign_group_aligned": campaign_group_aligned,
                "reservation_campaign_group_compatible": (
                    reservation_campaign_group_compatible
                ),
                "continuation_valid": continuing_reservation_valid,
            },
            "reservation_owner_ready": (
                reservation_owner.get("status") == "READY"
            ),
            "technically_feasible": not hard_gate_blockers,
            "hard_gate_blockers": hard_gate_blockers,
            "owner_lineage": row.get("owner_lineage") or {},
            "semantic_fingerprint": str(row.get("semantic_fingerprint") or ""),
        })
    rebind_ranked = sorted(
        (
            row for row in rebind_candidates
            if (
                row.get("technically_feasible")
                and str(row.get("source_id") or "")
                not in declined_rebind_sources
            )
        ),
        key=lambda row: (
            not bool(row.get("supports_all_48_identities")),
            -int(row.get("free_capacity_after_reserve") or 0),
            str(row.get("source_id") or ""),
        ),
    )
    selected_rebind = rebind_ranked[0] if rebind_ranked else {}

    drafts = _controlled_source_draft_candidates(
        Path(args.egress_drafts_dir), state_dir
    )
    # A consumed topology reservation is an exact-once predecessor, not a
    # reusable draft candidate.  Retrying it hides other already-owned,
    # independent drafts and turns a completed provision into a selection
    # loop.  Keep this derived from the existing audit + registry owners: a
    # released source is eligible again only after its reservation marker is
    # actually gone.
    consumed_reservation_marker_keys = (
        "execution_reservation_id",
        "controlled_source_reservation_id",
        "reservation_id",
    )
    consumed_reserved_source_ids = {
        str(record.get("source_id") or "")
        for record in audit_records
        if (
            record.get("record_type")
            == operator_execution.CONTROLLED_SOURCE_TOPOLOGY_PROVISION_RECORD_TYPE
            and str(record.get("source_id") or "")
            and (
                any(
                    str(
                        registry_by_id.get(
                            str(record.get("source_id") or ""), {}
                        ).get(marker_key)
                        or ""
                    )
                    for marker_key in consumed_reservation_marker_keys
                )
                or bool_value(
                    registry_by_id.get(
                        str(record.get("source_id") or ""), {}
                    ).get("controlled_certification_source")
                )
            )
        )
    }
    consumed_reserved_draft_ids = sorted(
        str(row.get("draft_id") or "")
        for row in drafts
        if str(row.get("pool_egress_id") or "")
        in consumed_reserved_source_ids
    )
    ready_drafts = [
        row for row in drafts
        if row.get("ready_for_guarded_disabled_pool_preflight")
        and str(row.get("draft_id") or "") not in declined_drafts
        and str(row.get("pool_egress_id") or "")
        not in consumed_reserved_source_ids
    ]
    ready_drafts.sort(
        key=lambda row: (
            -int(row.get("one_identity_trial_capacity") or 0),
            str(row.get("draft_id") or ""),
        )
    )
    campaign_capable_drafts = [
        row for row in ready_drafts
        if int(row.get("one_identity_trial_capacity") or 0) >= current_stage
        and int(row.get("one_identity_trial_capacity") or 0)
        >= campaign_completion_stage
    ]
    selected_draft = (
        campaign_capable_drafts[0] if campaign_capable_drafts else {}
    )

    occupied_slice_rows = [
        row for row in rows
        if int((row.get("capacity") or {}).get("ordinary_users") or 0) > 0
    ]
    slice_blockers = [
        "shared_egress_failure_affects_ordinary_users",
        "per_user_policy_table_does_not_isolate_interface_or_peer_failure",
        "no_existing_owner_proves_independent_slice_failure_and_restore",
    ] if occupied_slice_rows else [
        "no_occupied_healthy_egress_requires_slice_instead_of_whole_egress_reservation"
    ]

    existing_exact_source = source_id
    selected_source = str(selected_rebind.get("source_id") or "")
    selected_option = (
        "OPTION_1_CONTINUE_EXISTING_CONTROLLED_EGRESS"
        if selected_rebind
        and selected_rebind.get(
            "continuing_campaign_source_repairable"
        ) else
        "OPTION_1_REBIND_EXISTING_EMPTY_EGRESS"
        if selected_rebind else
        "OPTION_2_PROVISION_EXISTING_VALID_DRAFT"
        if selected_draft else
        ""
    )
    trial_identity_source = existing_exact_source
    if validation_profile == "ct-m0f-one-user" and ct_trial_identity_source:
        trial_identity_source = ct_trial_identity_source
    if (
        selected_option
        == "OPTION_1_CONTINUE_EXISTING_CONTROLLED_EGRESS"
    ):
        remaining_campaign_identities = sorted(
            (
                row for row in campaign_identity_rows
                if str(row.get("current") or "") != selected_source
                and str(row.get("ip") or "")
            ),
            key=lambda row: str(row.get("ip") or ""),
        )
        if remaining_campaign_identities:
            trial_identity = str(
                remaining_campaign_identities[0].get("ip") or ""
            )
            trial_identity_source = str(
                remaining_campaign_identities[0].get("current") or ""
            )
        else:
            trial_identity = ""
            trial_identity_source = ""
    if selected_option.startswith("OPTION_1"):
        required_authority_action = "REBIND_CONTROLLED_CERTIFICATION_SOURCE"
        exact_resource = selected_source
    elif selected_option.startswith("OPTION_2"):
        required_authority_action = (
            "PROVISION_DEDICATED_CONTROLLED_CERTIFICATION_SOURCE"
        )
        exact_resource = str(selected_draft.get("draft_id") or "")
    else:
        required_authority_action = ""
        exact_resource = ""

    delegated_topology_actions = set(
        topology_scope.get("allowed_actions") or []
    )
    if (
        required_authority_action
        and required_authority_action not in delegated_topology_actions
    ):
        topology_policy_blockers.append(
            "controlled_topology_required_action_not_delegated:"
            + required_authority_action
        )
        topology_policy_admission.update({
            "status": "STANDING_DELEGATED_CONTROLLED_TOPOLOGY_POLICY_REQUIRED",
            "ok": False,
            "blockers": sorted(set(topology_policy_blockers)),
        })

    preflight_ready = bool(
        selected_option
        and trial_identity
        and reservation_owner.get("status") == "READY"
        and (
            bool(ct_m0f_basis)
            if validation_profile == "ct-m0f-one-user"
            else True
        )
    )
    manifest = {
        "validation_profile": (
            "CT_M0F_ONE_USER_CONTROLLED_CONDITION"
            if validation_profile == "ct-m0f-one-user"
            else "CAMPAIGN_FULL_PATH"
        ),
        "selected_option": selected_option,
        "existing_source": trial_identity_source,
        "selected_source_or_draft": exact_resource,
        "trial_identity": trial_identity,
        "trial_identity_count": 1 if trial_identity else 0,
        "identity_set_fingerprint": certification_identity_fingerprint,
        "expected_assignment_delta": (
            f"{trial_identity}:{trial_identity_source}->{selected_source}"
            if trial_identity and selected_source else
            f"{trial_identity}:{trial_identity_source}->NEW_DEDICATED_SOURCE"
            if trial_identity and selected_draft else ""
        ),
        "expected_ordinary_assignment_delta": "NONE",
        "expected_ordinary_route_delta": "NONE",
        "capacity_reservation": 1,
        "certification_group": campaign_group,
        "reservation_mode": (
            "RENEW_AND_CONTINUE_SAME_CAMPAIGN_CERTIFICATION_SOURCE"
            if selected_option
            == "OPTION_1_CONTINUE_EXISTING_CONTROLLED_EGRESS"
            else "INITIAL_EMPTY_CONTROLLED_SOURCE_RESERVATION"
        ),
        "max_concurrent_transactions": 1,
        "reservation_owner": reservation_owner.get("owner"),
        "verification": (
            "fresh Matrix baseline + current route + ordinary fingerprints"
        ),
        "rollback": (
            "move exact certification identity to original source; verify; "
            "release exact reservation from owner backup"
        ),
        "failure_mechanism": (
            "existing v7-egress-set-state controlled-certification guard; "
            "only after healthy baseline and separate execution Authority"
        ),
        "lease_and_expiry_required": True,
        "packet_required_before_effect": True,
        "restore_barrier_required_before_effect": True,
    }
    manifest["manifest_hash"] = sha256_json(manifest)
    request_payload = {
        "schema_version": "v7.controlled-source-topology-authority-request.v1",
        "status": "AWAITING_INDEPENDENT_ENGINEERING_AUTHORITY_DECISION",
        "active_program": (
            "V7_SERVICE_FAILURE_AUTOMATION_EVOLUTION_PROGRAM_V1"
        ),
        "mission": (
            "CONTROLLED_SOURCE_RESELECTION_PROVISIONING_AND_"
            "SLICE_FEASIBILITY_V1"
        ),
        "decision_set": [
            f"APPROVE_{required_authority_action}"
            if required_authority_action else "",
            "DECLINE",
        ],
        "exact_action": required_authority_action,
        "manifest": manifest,
        "authority_basis": ct_m0f_basis,
        "current_campaign_request_id": str(campaign.get("request_id") or ""),
        "current_campaign_request_hash": str(campaign.get("request_hash") or ""),
        "supersedes_source_binding_only": True,
        "tier48_capability_or_campaign_reapproval": False,
        "ordinary_customer_involvement": False,
        "self_expansion_allowed": False,
        "forbidden_effects": [
            key for key, value in forbidden_effects.items()
            if value is False or value == 0
        ],
        "reentry_condition": (
            "one exact independent decision is appended through the existing "
            "operator-execution Authority audit; approval permits only the "
            "manifest-bound one-identity topology setup and fresh preflight, "
            "not controlled failure or campaign execution"
        ),
    }
    request_hash = sha256_json(request_payload)
    authority_template = {
        **request_payload,
        "request_id": f"cstopauth_r1_{request_hash[:24]}",
        "request_hash": request_hash,
        "actionable": preflight_ready,
        "issuing_owner": (
            "existing admin_core/operator_execution.py append-only "
            "Authority audit"
        ),
        "registered": False,
        "registration_reason": (
            "independent decision path must consume this exact package; "
            "the current Tier-48 campaign grant remains unchanged"
        ),
    }
    registered_request = (
        topology_authority_status.get("request")
        if isinstance(topology_authority_status.get("request"), dict)
        else {}
    )
    registered_manifest = (
        registered_request.get("manifest")
        if isinstance(registered_request.get("manifest"), dict)
        else {}
    )
    registered_matches = bool(
        registered_request
        and str(registered_request.get("exact_action") or "")
        == required_authority_action
        and str(registered_manifest.get("manifest_hash") or "")
        == str(manifest.get("manifest_hash") or "")
        and str(registered_request.get("current_campaign_request_id") or "")
        == str(campaign.get("request_id") or "")
        and str(registered_request.get("current_campaign_request_hash") or "")
        == str(campaign.get("request_hash") or "")
        and registered_request.get("authority_basis") == ct_m0f_basis
        and topology_authority_status.get("status") != "SUPERSEDED_STALE_PREFLIGHT"
    )
    authority_package = (
        {
            **registered_request,
            "actionable": (
                preflight_ready
                and topology_authority_status.get("status") == "PENDING"
            ),
            "issuing_owner": (
                "existing admin_core/operator_execution.py append-only "
                "Authority audit"
            ),
            "registered": True,
            "authority_lifecycle": {
                key: topology_authority_status.get(key)
                for key in (
                    "status",
                    "request_id",
                    "request_hash",
                    "created_at",
                    "expires_at",
                    "decision",
                    "decision_id",
                    "actor_id",
                )
            },
        }
        if registered_matches
        else authority_template
    )
    if topology_policy_admission.get("ok"):
        authority_package = {
            **authority_package,
            "actionable": False,
            "superseded_by_standing_policy": True,
            "superseding_contract_id": str(
                topology_policy_admission.get("contract_id") or ""
            ),
            "superseding_contract_hash": str(
                topology_policy_admission.get("contract_hash") or ""
            ),
        }

    options = {
        "option_1_existing_egress_rebind": {
            "result": (
                "AUTHORITY_INPUT_REQUIRED"
                if selected_rebind else
                "UNSAFE_BY_PROVEN_INVARIANT"
            ),
            "selected_candidate": selected_rebind,
            "all_candidates": rebind_candidates,
            "engineering_gap": (
                "NONE" if reservation_owner.get("status") == "READY"
                else "ATOMIC_CONTROLLED_SOURCE_RESERVATION_AND_RELEASE"
            ),
            "authority_action": (
                "REBIND_CONTROLLED_CERTIFICATION_SOURCE"
                if selected_rebind else ""
            ),
        },
        "option_2_dedicated_source": {
            "result": (
                "AUTHORITY_INPUT_REQUIRED"
                if selected_draft else
                "UNSAFE_BY_PROVEN_INVARIANT"
                if ready_drafts else
                "EXTERNAL_RESOURCE_REQUIRED"
            ),
            "selected_draft": selected_draft,
            "drafts": drafts,
            "bootstrap_only_ready_drafts": [
                {
                    "draft_id": str(row.get("draft_id") or ""),
                    "hard_capacity": int(row.get("hard_capacity") or 0),
                    "usable_capacity_after_reserve": int(
                        row.get("one_identity_trial_capacity") or 0
                    ),
                    "current_stage": current_stage,
                    "campaign_completion_stage": (
                        campaign_completion_stage
                    ),
                    "classification": (
                        "BOOTSTRAP_ONLY_NO_CREDIBLE_CAMPAIGN_SUCCESSOR"
                    ),
                }
                for row in ready_drafts
                if row not in campaign_capable_drafts
            ],
            "existing_owner": (
                "admin/v7-admin-api egress draft preflight, quarantine, "
                "disabled pool, runtime profile and enable lifecycle"
            ),
            "exact_external_resource": (
                "" if selected_draft
                else "OWNER_VERIFIED_EGRESS_PROFILE_OR_PEER_CONFIG"
            ),
        },
        "option_3_controlled_slice": {
            "result": "UNSAFE_BY_PROVEN_INVARIANT",
            "occupied_egress_count": len(occupied_slice_rows),
            "blockers": slice_blockers,
            "separate_policy_table_alone_is_isolation": False,
            "equivalent_safe_implementation_routes_to_option_2": True,
        },
    }
    repairable_source_candidates = sorted(
        (
            row for row in rebind_candidates
            if (
                str(row.get("source_id") or "") != source_id
                and row.get("technically_feasible")
                and int(row.get("ordinary_identities") or 0) == 0
                and row.get("healthy_baseline")
                and row.get("stability_pass")
                and row.get("supports_all_48_identities")
                and row.get("existing_controlled_reservation", {}).get(
                    "present"
                )
            )
        ),
        key=lambda row: (
            -int(row.get("free_capacity_after_reserve") or 0),
            str(row.get("source_id") or ""),
        ),
    )
    selected_repairable_source = (
        repairable_source_candidates[0]
        if repairable_source_candidates else {}
    )
    # Availability certification deliberately evaluates a controlled source
    # that may be degraded.  Once the exact campaign cohort is wholly located
    # on one still-valid reserved source, a transient source-health miss must
    # not erase that source identity and make the admitted failover stage
    # impossible to consume.  Reuse only the existing registry, assignment and
    # reservation owners; this is not a source-selection or Authority grant.
    availability_source_location = (
        next(iter(campaign_identity_locations))
        if (
            campaign_identity_count > 0
            and len(campaign_identity_locations) == 1
            and next(iter(campaign_identity_locations.values()))
            == campaign_identity_count
        )
        else ""
    )
    availability_existing_controlled_source = next((
        row for row in rebind_candidates
        if (
            availability_policy_admission.get("ok")
            and str(row.get("source_id") or "")
            == availability_source_location
            and row.get("continuing_campaign_source_repairable")
            and (
                row.get("existing_controlled_reservation") or {}
            ).get("continuation_valid")
        )
    ), {})
    controlled_target_rows = [
        row for row in rows
        if row.get("controlled_rebind_eligible")
    ]
    full_campaign_target_rows = [
        row for row in controlled_target_rows
        if int(
            (row.get("capacity") or {}).get(
                "campaign_completion_safe_scope"
            )
            or 0
        ) >= campaign_completion_stage
    ]
    pinned_target_id = str(campaign.get("pinned_target_id") or "")
    pinned_target = next((
        row for row in rows
