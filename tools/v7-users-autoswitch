    def _action_class_execution_boundary(
        self,
        *,
        decisions: list[dict[str, Any]],
        selected: list[dict[str, Any]],
        authority_budget_gate: dict[str, Any],
        emergency_failover_gate: dict[str, Any],
        restore_barrier_execution_gate: dict[str, Any],
        intelligence_snapshot_gate: dict[str, Any],
    ) -> dict[str, Any]:
        """Compare shadow demand with the legally allowed action boundary.

        This remains a read-only projection: it does not create a Candidate,
        Packet or lease and never turns a shadow recommendation into execution
        permission.  It makes the exact residual gate consumable by the
        existing STOP_SAFE/OMP owners.
        """
        shadow_candidates = [
            item for item in decisions
            if str(item.get("recommended_egress") or "")
            and str(item.get("recommended_egress") or "") != str(item.get("current_egress") or "")
        ]
        contract = dict(authority_budget_gate.get("current_action_class_contract") or {})
        contract_valid = bool(contract.get("valid"))
        blockers = list(contract.get("blockers") or [])
        if not contract_valid:
            status = "STOP_SAFE_CURRENT_ACTION_CLASS_CONTRACT_REQUIRED"
        elif not shadow_candidates:
            status = "NO_ACTION_NO_SHADOW_CANDIDATE"
        elif not selected:
            status = "STOP_SAFE_OTHER_EXECUTION_GATE_REQUIRED"
            if bool_value(restore_barrier_execution_gate.get("execution_blocked")):
                blockers.append(str(restore_barrier_execution_gate.get("execution_blocker") or "restore_barrier"))
            if bool_value(intelligence_snapshot_gate.get("stop_required")):
                blockers.append(str(intelligence_snapshot_gate.get("unsafe_blocker") or "intelligence_snapshot_gate"))
            if bool_value(emergency_failover_gate.get("enabled")) and not bool_value(emergency_failover_gate.get("ok")):
                blockers.extend(str(item) for item in (emergency_failover_gate.get("blockers") or []) if str(item))
        else:
            status = "PACKET_MATERIALIZATION_ELIGIBLE"
        return {
            "schema_version": "v7.service-failure-action-class-execution-boundary.v1",
            "shadow_candidate_count": len(shadow_candidates),
            "allowed_selected_count": len(selected),
            "action_class_contract": contract,
            "status": status,
            "blockers": sorted(set(blockers)),
            "next_required_objects": ["fresh_candidate", "packet", "lease", "verification", "rollback"]
            if status == "PACKET_MATERIALIZATION_ELIGIBLE" else [],
            "execution_authorized": False,
            "candidate_created": False,
            "packet_created": False,
            "lease_created": False,
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
            "authority_expanded": False,
            "owner": "tools/v7-users-autoswitch",
            "consumer": "existing service failure obligation -> OMP Automation Gap Closure",
        }

    def _authority_budget_gate(self, selected: list[dict[str, Any]]) -> tuple[list[dict[str, Any]], dict[str, Any]]:
        policy = dict(self.authority_budget_policy)
        authority_class = normalize_authority_class(policy.get("authority_class"))
        prepared_class = normalize_authority_class(policy.get("prepared_authority_class") or authority_class)
        certified_class = normalize_authority_class(policy.get("certified_authority_class") or "CANARY")
        lifecycle_state = normalize_authority_lifecycle_state(policy.get("authority_lifecycle_state")) or "CERTIFIED"
        bridge = dict(policy.get("authority_bridge") or {})
        action_contract = dict(policy.get("current_action_class_contract") or {})
        action_contract_valid = bool(action_contract.get("valid", True))
        bridge_enabled = bool(bridge.get("enabled")) and lifecycle_state in AUTHORITY_BRIDGE_STATES
        class_budget = authority_class_budget(authority_class, to_int(policy.get("current_allowed_user_budget"), 1))
        allowed_budget = max(0, min(to_int(policy.get("current_allowed_user_budget"), class_budget), class_budget))
        if bridge_enabled:
            allowed_budget = max(0, min(to_int(policy.get("current_allowed_user_budget"), 0), to_int(bridge.get("bridge_budget_ceiling"), 0)))
        selected_before = len(selected)
        selected_after = selected[:allowed_budget] if selected_before > allowed_budget else list(selected)
        cap_applied = selected_after != selected
        prepared_exceeds_certified = AUTHORITY_CLASS_RANK[prepared_class] > AUTHORITY_CLASS_RANK[certified_class]
        if not action_contract_valid:
            decision = "block_all_selected_moves_current_action_class_contract_required"
            action = "drop_selected_moves_before_restore_barrier_snapshot_apply"
            next_state = "FROZEN"
        elif lifecycle_state in {"FROZEN", "REVOKED"} or allowed_budget <= 0:
            decision = "block_all_selected_moves_authority_budget_zero"
            action = "drop_selected_moves_before_restore_barrier_snapshot_apply"
            next_state = lifecycle_state if lifecycle_state in {"FROZEN", "REVOKED"} else "FROZEN"
        elif bridge_enabled:
            decision = "allow_transitional_authority_bridge_budget"
            action = "permit_next_blast_radius_step_without_certifying_prepared_authority"
            next_state = "PROVISIONAL_SMALL_BATCH" if lifecycle_state == "CANARY_EXPANSION" else "SMALL_BATCH_CERTIFIED_AFTER_EVIDENCE"
        elif prepared_exceeds_certified:
            decision = "cap_prepared_authority_to_certified_evidence"
            action = "allow_only_certified_authority_budget"
            next_state = "CERTIFIED"
        elif cap_applied:
            decision = "cap_selected_moves_to_authority_budget"
            action = "drop_moves_above_current_authority_budget"
            next_state = authority_class
        else:
            decision = "selected_moves_within_authority_budget"
            action = "continue_existing_runtime_lifecycle"
            next_state = authority_class
        gate = {
            "schema_version": "v7.authority-budget-gate.v1",
            "enabled": bool_value(policy.get("enabled", True)),
            "truth_source": policy.get("truth_source", "existing_policy_files"),
            "runtime_calculation_mode": policy.get("runtime_calculation_mode", "prepared_and_certified_min_authority"),
            "authority_class": authority_class,
            "prepared_authority_class": prepared_class,
            "certified_authority_class": certified_class,
            "authority_lifecycle_state": lifecycle_state,
            "current_action_class_contract": action_contract,
            "current_allowed_user_budget": allowed_budget,
            "next_authority_class": policy.get("next_authority_class") or AUTHORITY_CLASS_NEXT.get(authority_class, "CANARY"),
            "next_allowed_user_budget": to_int(policy.get("next_allowed_user_budget"), allowed_budget),
            "selected_moves_before_gate": selected_before,
            "selected_moves_after_gate": len(selected_after),
            "authority_cap_applied": cap_applied,
            "decision": decision,
            "action": action,
            "executor": "tools/v7-users-autoswitch",
            "trigger": "after_policy_selection_before_restore_barrier_snapshot_apply",
            "written_evidence": "plan.safety.authority_budget_gate",
            "blocked_actions": (
                sorted(set(["selected_moves_above_authority_budget", "apply_above_authority_budget"] + list(action_contract.get("blockers") or [])))
                if cap_applied or allowed_budget <= 0 or not action_contract_valid else []
            ),
            "next_state": next_state,
            "authority_lifecycle": {
                "schema_version": "v7.authority-governance-lifecycle.v1",
                "state": lifecycle_state,
                "prepared_authority_class": prepared_class,
                "certified_authority_class": certified_class,
                "runtime_authority_class": authority_class,
                "prepared_budget_ceiling": authority_class_budget(prepared_class, allowed_budget),
                "certified_budget_ceiling": authority_class_budget(certified_class, allowed_budget),
                "runtime_allowed_user_budget": allowed_budget,
                "prepared_exceeds_certified": prepared_exceeds_certified,
                "model": self._authority_lifecycle_model(),
                "bridge_model": self._authority_bridge_model(),
                "certification_rules": self._authority_certification_rules(),
                "governance": self._authority_governance_policy(prepared_class, certified_class, lifecycle_state),
                "action_matrix": self._authority_full_action_matrix(),
                "new_truth_sources_created": False,
                "duplicate_systems_created": False,
            },
            "authority_bridge": {
                **bridge,
                "active": bridge_enabled,
                "decision": decision if bridge_enabled else "not_in_bridge_state",
                "action": action if bridge_enabled else "use_certified_authority_gate",
                "blocked_actions": [
                    "small_batch_certification_without_5_user_success",
                    "budget_above_bridge_ceiling",
                    "bounded_autonomy",
                    "production_autonomy",
                ] if bridge_enabled else [],
                "next_state": next_state if bridge_enabled else "",
            },
            "anti_flapping_policy": {
                "minimum_residence_seconds": to_int(policy.get("minimum_residence_seconds"), 300),
                "cooldown_seconds": to_int(policy.get("cooldown_seconds"), to_int(self.switch_policy.get("cooldown_seconds"), 180)),
                "sticky_protection": "existing_autoswitch_safety_state",
                "rollback_penalty_seconds": to_int(policy.get("rollback_penalty_seconds"), 3600),
                "promotion_delay_seconds": to_int(policy.get("promotion_delay_seconds"), 900),
                "demotion_delay_seconds": to_int(policy.get("demotion_delay_seconds"), 0),
            },
            "policy": {
                "evidence_floor": str(policy.get("evidence_floor") or ""),
                "class_budget_ceiling": class_budget,
                "new_truth_sources_created": False,
                "new_execution_path_created": False,
                "network_calls_in_apply_path": False,
                "history_scan_in_apply_path": False,
            },
            "action_matrix": self._authority_action_matrix(authority_class, allowed_budget),
        }
        if prepared_exceeds_certified:
            gate["blocked_actions"] = sorted(set(gate["blocked_actions"] + ["promotion_without_certification", "apply_above_certified_budget"]))
        if bridge_enabled:
            gate["blocked_actions"] = sorted(set(gate["blocked_actions"] + ["small_batch_certification_without_5_user_success", "apply_above_bridge_budget"]))
        if not gate["enabled"]:
            gate["decision"] = "authority_budget_gate_disabled_by_policy"
            gate["blocked_actions"] = ["disable_authority_budget_gate_in_production"]
            gate["selected_moves_after_gate"] = 0
            return [], gate
        return selected_after, gate

    def _recent_audit_records(self, limit: int = 200) -> list[dict[str, Any]]:
        path = self.event_dir / "switch-history.jsonl"
        try:
            lines = path.read_text(encoding="utf-8", errors="replace").splitlines()[-max(0, limit):]
        except OSError:
            return []
        records: list[dict[str, Any]] = []
        for line in lines:
            text = line.strip()
            if not text:
                continue
            try:
                row = json.loads(text)
            except json.JSONDecodeError:
                continue
            if isinstance(row, dict):
                records.append(row)
        return records

    def _snapshot_items(self, family: str) -> list[dict[str, Any]]:
        if family in self._snapshot_items_cache:
            return self._snapshot_items_cache[family]
        result = ((self.intelligence_snapshots.get("results") or {}).get(family) or {})
        if result.get("runtime_behavior") == "STOP":
            self._snapshot_items_cache[family] = []
            return []
        payload = {}
        path = str(result.get("path") or "")
        if path:
            payload = read_json(Path(path), {})
        items = payload.get("items") if isinstance(payload, dict) else []
        rows = [item for item in (items or []) if isinstance(item, dict)]
        self._snapshot_items_cache[family] = rows
        return rows

    def _snapshot_channel_score_map(self) -> dict[str, dict[str, Any]]:
        rows: dict[str, dict[str, Any]] = {}
        for item in self._snapshot_items("channel-service-scores"):
            channel = str(item.get("channel") or "").strip()
            if channel:
                rows[channel] = item
        return rows

    def _snapshot_channel_trust_recovery_map(self) -> dict[str, dict[str, Any]]:
        rows: dict[str, dict[str, Any]] = {}
        for item in self._snapshot_items("trust-evolution-summaries"):
            model = item.get("channel_trust_recovery") if isinstance(item.get("channel_trust_recovery"), dict) else {}
            for row in model.get("channels") or []:
                if not isinstance(row, dict):
                    continue
                channel = str(row.get("channel") or "").strip()
                if channel:
                    rows[channel] = row
        return rows

    def _ctr_soft_adjustment_for_state(self, state: str) -> float:
        return {
            "TRUSTED": 20.0,
            "WATCH": 0.0,
            "NEW": -8.0,
            "RECOVERING": -12.0,
            "DEGRADED": -18.0,
            "QUARANTINED": -24.0,
        }.get(str(state or "").upper(), 0.0)

    def _ctr_recommended_action_for_state(self, state: str) -> str:
        return {
            "TRUSTED": "normal_monitoring",
            "WATCH": "review_for_expansion",
            "NEW": "observe_before_expansion",
            "RECOVERING": "operator_review_required",
            "DEGRADED": "review_before_normal_target_use",
            "QUARANTINED": "emergency_or_rollback_review_only",
        }.get(str(state or "").upper(), "observe")

    def _ctr_blocked_actions_for_state(self, state: str) -> list[str]:
        normalized = str(state or "").upper()
        if normalized == "TRUSTED":
            return ["direct_user_switch", "planner_bypass", "governance_bypass"]
        if normalized in {"WATCH", "NEW"}:
            return ["automatic_expansion_without_review", "direct_user_switch", "governance_bypass"]
        if normalized == "RECOVERING":
            return ["automatic_expansion", "direct_user_switch", "governance_bypass"]
        if normalized == "DEGRADED":
            return ["normal_target_use_without_review", "direct_user_switch", "governance_bypass"]
        if normalized == "QUARANTINED":
            return ["normal_target_use", "automatic_expansion", "direct_user_switch", "governance_bypass"]
        return ["direct_user_switch", "governance_bypass"]

