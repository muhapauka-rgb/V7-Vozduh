    def _intelligence_snapshot_source_mismatches(self, family: str, payload: dict[str, Any]) -> list[str]:
        if not isinstance(payload, dict):
            return []
        hashes = payload.get("source_hashes")
        if not isinstance(hashes, dict):
            return []
        expected_by_key: dict[str, str] = {}
        if family in {"service-scores", "channel-service-scores"}:
            expected_by_key = {
                "service_matrix": sha256_json(self.matrix or {}),
                "quality_summary": sha256_json(self.quality_summary or {}),
                "service_preferences": sha256_json(self.service_prefs or {}),
            }
        mismatches: list[str] = []
        for key, expected in expected_by_key.items():
            actual = str(hashes.get(key) or "")
            if actual and expected and actual != expected:
                mismatches.append(f"source_hash_mismatch:{family}:{key}")
        return mismatches

    def _intelligence_snapshot_gate(self, selected_before_gate: int = 0) -> dict[str, Any]:
        gate = dict(self.intelligence_snapshots)
        refresh = dict(self.pre_planner_refresh)
        refresh_stop = bool_value(refresh.get("stop_required"))
        if refresh.get("enabled"):
            gate["pre_planner_refresh"] = refresh
        if refresh_stop:
            gate["active"] = True
            gate["stop_required"] = True
            gate["unavailable_reason"] = str(refresh.get("state") or "pre_planner_refresh_failed")
            stop_families = set(gate.get("stop_families") or [])
            stop_families.add("pre-planner-refresh")
            gate["stop_families"] = sorted(stop_families)
        gate["selected_moves_before_gate"] = selected_before_gate
        gate["selected_moves_suppressed"] = bool(gate.get("active") and gate.get("stop_required") and selected_before_gate > 0)
        gate["runtime_behavior_changed"] = False
        gate["governance_behavior_changed"] = False
        gate["execution_behavior_changed"] = False
        gate["hard_gate_override"] = "forbidden"
        gate["reservation_override"] = "forbidden"
        return gate

    def _apply_source_bundle_lease_to_intelligence_gate(
        self,
        gate: dict[str, Any],
        restore_barrier: dict[str, Any],
        approved_plan_lock: dict[str, Any],
    ) -> dict[str, Any]:
        if not bool_value(getattr(self.args, "apply", False)):
            return gate
        if not approved_plan_lock.get("ok"):
            return gate
        if not bool_value(gate.get("active")) or not bool_value(gate.get("stop_required")):
            return gate
        if not bool_value(restore_barrier.get("clearance_generation_ok")):
            return gate
        lease = restore_barrier.get("source_bundle_lease") or {}
        if not isinstance(lease, dict) or not bool_value(lease.get("ok")):
            return gate
        allowed_drift = {str(item) for item in (lease.get("allowed_source_drift") or [])}
        changed_keys = {str(item) for item in (lease.get("changed_source_keys") or [])}
        if not allowed_drift or not changed_keys.issubset(allowed_drift):
            return gate

        results = gate.get("results") if isinstance(gate.get("results"), dict) else {}
        stop_families = [str(item) for item in (gate.get("stop_families") or [])]
        if not stop_families:
            return gate

        accepted_errors: list[str] = []
        for family in stop_families:
            payload = results.get(family) if isinstance(results, dict) else {}
            if not isinstance(payload, dict):
                return gate
            errors = [str(item) for item in (payload.get("validation_errors") or [])]
            if not errors:
                return gate
            for error in errors:
                match = re.fullmatch(r"source_hash_mismatch:[^:]+:([^:]+)", error)
                if not match or match.group(1) not in allowed_drift:
                    return gate
                accepted_errors.append(error)

        leased = dict(gate)
        leased["stop_required_before_source_bundle_lease"] = True
        leased["stop_required"] = False
        leased["runtime_behavior"] = "ALLOW_APPROVED_SOURCE_BUNDLE_LEASE"
        leased["selected_moves_suppressed"] = False
        leased["selected_moves_after_gate"] = int(gate.get("selected_moves_before_gate") or 0)
        leased["source_bundle_lease_used"] = True
        leased["source_bundle_lease_scope"] = "approved_plan_lock_apply_only"
        leased["source_bundle_lease_allowed_drift"] = sorted(allowed_drift)
        leased["source_bundle_lease_changed_keys"] = sorted(changed_keys)
        leased["source_bundle_lease_accepted_errors"] = sorted(set(accepted_errors))
        leased["hard_gate_override"] = "approved_source_bundle_lease_for_locked_apply"
        leased["execution_behavior_changed"] = False
        leased["governance_behavior_changed"] = False
        leased["runtime_behavior_changed"] = False
        return leased

    def _load_safety(self) -> dict[str, Any]:
        safety = read_json(self.safety_file, {})
        if not isinstance(safety, dict):
            safety = {}
        safety.setdefault("schema_version", 1)
        safety.setdefault("users", {})
        safety.setdefault("egress", {})
        return self._compact_safety(safety)

    def _compact_safety(self, safety: dict[str, Any]) -> dict[str, Any]:
        now = time.time()
        for ip, row in list((safety.get("users") or {}).items()):
            if not isinstance(row, dict):
                safety["users"].pop(ip, None)
                continue
            recent = [item for item in (row.get("recent_switches") or []) if now - parse_ts(item.get("ts")) <= 86400]
            row["recent_switches"] = recent[-10:]
            row["switches_1h"] = sum(1 for item in recent if now - parse_ts(item.get("ts")) <= 3600)
            row["switches_24h"] = len(recent)
            row["last_targets"] = [item.get("to") for item in recent[-3:] if item.get("to")]
            blocked = row.get("blocked_targets") if isinstance(row.get("blocked_targets"), dict) else {}
            row["blocked_targets"] = {target: until for target, until in blocked.items() if parse_ts(until) > now}
            if row.get("penalty_until") and parse_ts(row.get("penalty_until")) <= now:
                row["penalty_until"] = None
        for egress_id, row in list((safety.get("egress") or {}).items()):
            if not isinstance(row, dict):
                safety["egress"].pop(egress_id, None)
                continue
            incoming = [item for item in (row.get("incoming") or []) if now - parse_ts(item.get("ts")) <= 3600]
            failed = [item for item in (row.get("failed_verifications") or []) if now - parse_ts(item.get("ts")) <= 3600]
            row["incoming"] = incoming[-200:]
            row["failed_verifications"] = failed[-50:]
            row["incoming_1h"] = len(incoming)
            row["failed_verifications_1h"] = len(failed)
            if row.get("quarantine_until") and parse_ts(row.get("quarantine_until")) <= now:
                row["quarantine_until"] = None
        safety["updated"] = now_iso()
        return safety

