    def _l3_incident_context(
        self,
        gate: dict[str, Any],
        selected: list[dict[str, Any]],
        *,
        selected_hash: str,
        operation: dict[str, Any],
    ) -> dict[str, Any]:
        move_evidence = [row for row in (gate.get("move_evidence") or []) if isinstance(row, dict)]
        failed_sources = sorted({
            str(row.get("current_egress") or "")
            for row in move_evidence
            if row.get("current_failures")
        })
        channel_failed_sources = sorted({
            str(((row.get("current_channel_failure") or {}).get("channel")) or row.get("current_egress") or "")
            for row in move_evidence
            if bool_value((row.get("current_channel_failure") or {}).get("confirmed"))
        })
        failed_sources = sorted(set(failed_sources) | set(channel_failed_sources))
        incident_source = failed_sources[0] if len(failed_sources) == 1 else ""
        failed_services = sorted({
            str(item.get("service") or "")
            for row in move_evidence
            for item in (row.get("current_failures") or [])
            if item.get("service")
        })
        incident_services = failed_services or (["current_channel_failure"] if channel_failed_sources else [])
        affected_users = sorted({
            str(row.get("user_ip") or "")
            for row in move_evidence
            if row.get("user_ip")
        })
        target_channels = sorted({
            str(move.get("recommended_egress") or "")
            for move in selected
            if str(move.get("recommended_egress") or "")
        })
        generation = str((self.generation or {}).get("planner_generation_id") or "")
        key = self._l3_incident_key(
            source_channels=failed_sources,
            services=incident_services,
            authority=str(gate.get("mode") or "EMERGENCY_FAILOVER_AUTONOMY"),
            generation=generation,
        )
        if str(gate.get("incident_key") or ""):
            key["key"] = str(gate.get("incident_key") or "")
        enabled = bool_value(gate.get("enabled"))
        if not enabled:
            state = "NO_INCIDENT_DISABLED"
        elif not move_evidence:
            state = "NO_INCIDENT_NO_EVIDENCE"
        elif bool_value(gate.get("ok")):
            state = "READY_FOR_EXECUTION"
        else:
            state = "INCIDENT_OPEN_STOP_SAFE"
        incident = {
            "schema_version": "v7.l3-incident-context.v1",
            "incident_state": state,
            "incident_key": key["key"],
            "incident_key_components": key["components"],
            "incident_generation": generation,
            "authority_object": "EMERGENCY_FAILOVER_AUTONOMY",
            "allowed_move": "FAILOVER",
            "allowed_reason": "CURRENT_CHANNEL_FAILED",
            "affected_users": affected_users,
            "failed_sources": failed_sources,
            "incident_source": incident_source,
            "incident_source_continuity": gate.get("incident_source_continuity", {}),
            "failed_required_services": failed_services,
            "confirmed_current_channel_failures": [
                row.get("current_channel_failure")
                for row in move_evidence
                if bool_value((row.get("current_channel_failure") or {}).get("confirmed"))
            ],
            "target_channels": target_channels,
            "selected_move_hash": selected_hash,
            "operation_id": str(operation.get("operation_id") or ""),
            "event_collapse": {
                "enabled": True,
                "collapsed_event_count": len(move_evidence),
                "collapse_key": key["key"],
                "runtime_apply_allowed_now": False,
            },
            "incident_merge": {
                "same_key_merges": True,
                "merge_key": key["key"],
                "new_framework_created": False,
            },
            "incident_split": {
                "different_source_service_authority_or_generation_splits": True,
                "split_dimensions": ["source_channels", "service_family", "authority_envelope", "generation"],
                "new_framework_created": False,
            },
            "planner_consumption": {
                "planner_owner": "tools/v7-users-autoswitch",
                "affected_users": affected_users,
                "safe_target": target_channels[0] if len(target_channels) == 1 else "",
                "blocked_reason": ",".join(str(item) for item in (gate.get("blockers") or [])),
                "selected_move_hash": selected_hash,
                "runtime_replaced_planner": False,
            },
            "operator_visibility": {
                "show_incident": enabled and bool(move_evidence),
                "show_reason": "CURRENT_CHANNEL_FAILED",
                "show_blockers": list(gate.get("blockers") or []),
                "show_selected_users": affected_users,
                "show_target_channels": target_channels,
            },
            "terminal_outcome": "NOT_EXECUTED_PHASE1",
            "runtime_apply_allowed_now": False,
            "authority_expanded": False,
            "new_incident_framework_created": False,
        }
        runtime_record = self._l3_runtime_incident_record(
            incident_key=key["key"],
            incident_state=state,
            key_components=key["components"],
            gate=gate,
            selected=selected,
            operation=operation,
        )
        incident["runtime_lifecycle"] = runtime_record
        incident["opened"] = runtime_record["lifecycle_transition"] == "opened"
        incident["updated"] = runtime_record["lifecycle_transition"] == "updated"
        incident["merged"] = bool_value(runtime_record["incident_merge"].get("merged"))
        incident["split"] = bool_value(runtime_record["incident_split"].get("split"))
        incident["consumed"] = bool_value(runtime_record.get("consumed"))
        incident["production_behavior_contracts"] = self._l3_behavior_contracts(
            gate=gate,
            incident_key=key["key"],
            incident_state=state,
            selected=selected,
            move_evidence=move_evidence,
            target_channels=target_channels,
            affected_users=affected_users,
        )
        incident["operator_surface"] = self._l3_operator_surface(incident, gate, selected)
        incident["production_validation_ladder"] = self._l3_production_validation_ladder(incident, gate)
        incident["certification_pipeline"] = self._l3_certification_pipeline(incident, incident["production_validation_ladder"])
        return incident

    def _authority_promotion_feedback_paths(self) -> dict[str, list[Path]]:
        return {
            "outcome": [self.state_dir / "execution-events.jsonl"],
            "trust": [self.state_dir / "runtime-trust.jsonl"],
            "prediction": [self.state_dir / "execution-events.jsonl"],
            "recommendation": [
                self.state_dir / "proposal-records.jsonl",
                self.state_dir / "proposals.jsonl",
            ],
            "closure": [self.state_dir / "closure-records.jsonl"],
        }

    def _authority_feedback_records_for_operation(self, operation_id: str) -> dict[str, list[dict[str, Any]]]:
        paths = self._authority_promotion_feedback_paths()
        result: dict[str, list[dict[str, Any]]] = {}
        schema_markers = {
            "outcome": "execution-outcome",
            "trust": "execution-trust",
            "prediction": "execution-prediction",
            "recommendation": "execution-recommendation",
            "closure": "execution-feedback-closure",
        }
        for kind, path in paths.items():
            marker = schema_markers[kind]
            matches: list[dict[str, Any]] = []
            for item_path in path:
                for row in read_jsonl(item_path):
                    schema = str(row.get("schema_version") or "")
                    if marker not in schema:
                        continue
                    raw = json.dumps(row, ensure_ascii=False, sort_keys=True)
                    if operation_id not in raw:
                        continue
                    matches.append(row)
            result[kind] = matches
        return result

    def _authority_promotion_stability_window_seconds(self, target_class: str, records: dict[str, list[dict[str, Any]]]) -> int:
        policy = self.authority_budget_policy
        target_key = normalize_authority_class(target_class).lower()
        policy_keys = [
            f"{target_key}_stable_runtime_truth_window_observed_seconds",
            f"{target_key}_no_regression_window_observed_seconds",
            "authority_promotion_stability_window_observed_seconds",
            "stable_runtime_truth_window_observed_seconds",
            "no_regression_window_observed_seconds",
        ]
        values = [to_int(policy.get(key), 0) for key in policy_keys]
        row_keys = [
            "stability_window_seconds",
            "observed_stability_window_seconds",
            "runtime_truth_stability_window_seconds",
            "no_regression_window_seconds",
        ]
        created_ts_values: list[float] = []
        for kind_records in records.values():
            for row in kind_records:
                for key in row_keys:
                    values.append(to_int(row.get(key), 0))
                created_ts = parse_ts(row.get("created_at"))
                if created_ts > 0:
                    created_ts_values.append(created_ts)
        if created_ts_values:
            values.append(max(0, int(time.time() - max(created_ts_values))))
        return max(values) if values else 0

    def _pool_equivalence_distribution_review(self) -> dict[str, Any]:
        active = self._active_users()
        working_ids = {
            egress.id
            for egress in self.egress.values()
            if self._healthy_for_load(egress) and not egress.reserve_only
        }
        counts: dict[str, int] = {egress_id: 0 for egress_id in working_ids}
        for user in active:
            if user.current in working_ids:
                counts[user.current] = counts.get(user.current, 0) + 1
        active_counts = [count for count in counts.values() if count > 0]
        max_count = max(active_counts) if active_counts else 0
        min_count = min(active_counts) if active_counts else 0
        spread = max_count - min_count if active_counts else 0
        return {
            "schema_version": "v7.pool-equivalence-distribution-review.v1",
            "active_users": len(active),
            "pool_budget": AUTHORITY_CLASS_BUDGETS["POOL"],
            "working_channels": len(working_ids),
            "counts": {key: counts[key] for key in sorted(counts)},
            "active_working_channels": len(active_counts),
            "max_users_per_active_channel": max_count,
            "min_users_per_active_channel": min_count,
            "spread": spread,
            "balanced": len(active) >= AUTHORITY_CLASS_BUDGETS["POOL"]
            and len(active_counts) >= 2
            and spread <= 1,
        }

    def _pool_equivalence_planner_review(self) -> dict[str, Any]:
        active = self._active_users()
        decisions = [self._decision_for_user(user) for user in active]
        candidate_moves = [
            item
            for item in decisions
            if item.get("recommended_egress") and item.get("recommended_egress") != item.get("current_egress")
        ]
        snapshot_gate = self._intelligence_snapshot_gate(0)
        return {
            "schema_version": "v7.pool-equivalence-planner-review.v1",
            "active_users": len(active),
            "candidate_moves_total": len(candidate_moves),
            "rebalance_candidates": sum(1 for item in candidate_moves if item.get("move_type") == "rebalance"),
            "selected_moves": 0,
            "zero_rebalance_demand": len(candidate_moves) == 0,
            "snapshot_stop_required": bool_value(snapshot_gate.get("stop_required")),
            "snapshot_source_mismatch_families": list(snapshot_gate.get("source_mismatch_families") or []),
            "snapshot_gate": {
                "active": bool_value(snapshot_gate.get("active")),
                "stop_required": bool_value(snapshot_gate.get("stop_required")),
                "source_mismatch_families": list(snapshot_gate.get("source_mismatch_families") or []),
            },
        }

    def _pool_authority_equivalence_review(
        self,
        operation_reviews: list[dict[str, Any]],
        successful_runs: list[dict[str, Any]],
        required_window: int,
    ) -> dict[str, Any]:
        distribution = self._pool_equivalence_distribution_review()
        planner = self._pool_equivalence_planner_review()
        load = dict(self.dynamic_load)
        successful_large_reviews = [
            row
            for row in operation_reviews
            if to_int(row.get("users_count"), 0) >= AUTHORITY_PROMOTION_RULES["POOL"]["min_users_per_run"]
            and bool_value(row.get("successful"))
            and bool_value(row.get("closure_closed"))
            and not row.get("missing_feedback_types")
            and not bool_value(row.get("rollback_required"))
        ]
        blockers: list[str] = []
        if len(successful_large_reviews) < 1:
            blockers.append("pool_equivalence_requires_one_successful_large_batch_operation")
        if any(row.get("rollback_required") for row in operation_reviews):
            blockers.append("pool_equivalence_requires_clean_rollback_history")
        if max((to_int(row.get("stability_window_observed_seconds"), 0) for row in successful_large_reviews), default=0) < required_window:
            blockers.append("pool_equivalence_requires_3600s_large_stability_window")
        if to_int(distribution.get("active_users"), 0) < AUTHORITY_CLASS_BUDGETS["POOL"]:
            blockers.append("pool_equivalence_requires_25_planner_visible_users")
        if not bool_value(distribution.get("balanced")):
            blockers.append("pool_equivalence_requires_balanced_zero_move_pool")
        if str(load.get("status") or "").lower() != "ok":
            blockers.append("pool_equivalence_requires_load_status_ok")
        if to_int(distribution.get("active_working_channels"), 0) < 2:
            blockers.append("pool_equivalence_requires_at_least_two_active_working_channels")
        if not bool_value(planner.get("zero_rebalance_demand")):
            blockers.append("pool_equivalence_requires_zero_planner_candidate_moves")
        if bool_value(planner.get("snapshot_stop_required")):
            blockers.append("pool_equivalence_requires_clean_snapshot_gate")
        accepted = not blockers
        return {
            "schema_version": "v7.pool-promotion-equivalence-review.v1",
            "target_authority_class": "POOL",
            "rule": "one_successful_large_3600s_no_regression_25_users_balanced_zero_move_pool",
            "accepted": accepted,
            "blockers": blockers,
            "operator_approval_required": True,
            "new_governance_owner_created": False,
            "new_truth_source_created": False,
            "requirements": {
                "one_successful_large_batch": len(successful_large_reviews) >= 1,
                "required_stability_window_seconds": required_window,
                "observed_stability_window_seconds": max(
                    (to_int(row.get("stability_window_observed_seconds"), 0) for row in successful_large_reviews),
                    default=0,
                ),
                "active_users_at_least_pool_budget": to_int(distribution.get("active_users"), 0) >= AUTHORITY_CLASS_BUDGETS["POOL"],
                "balanced_pool": bool_value(distribution.get("balanced")),
                "load_status_ok": str(load.get("status") or "").lower() == "ok",
                "active_working_channels_at_least_two": to_int(distribution.get("active_working_channels"), 0) >= 2,
                "zero_planner_candidate_moves": bool_value(planner.get("zero_rebalance_demand")),
                "snapshot_gate_clean": not bool_value(planner.get("snapshot_stop_required")),
            },
            "distribution_review": distribution,
            "planner_review": planner,
            "load_review": {
                "status": load.get("status"),
                "active_users": load.get("active_users"),
                "healthy_channels": load.get("healthy_channels"),
                "working_channels": load.get("working_channels"),
                "avg_load": load.get("avg_load"),
                "soft_limit": load.get("soft_limit"),
                "hard_limit": load.get("hard_limit"),
                "failover_hard_limit": load.get("failover_hard_limit"),
            },
        }

    def _authority_promotion_evidence_review(self, operation_ids: list[str], target_class: str) -> dict[str, Any]:
        target = normalize_authority_class(target_class)
        rule = AUTHORITY_PROMOTION_RULES.get(target)
        if not rule:
            return {
                "schema_version": "v7.authority-promotion-evidence-review.v2",
                "target_authority_class": target,
                "operation_ids": operation_ids,
                "operation_reviews": [],
                "blockers": [f"unsupported_authority_promotion_target_{target.lower()}"],
                "evidence_valid": False,
            }
        required_feedback = tuple(rule["requires_feedback"])
        required_runs = int(rule["required_successful_runs"])
        min_users = int(rule["min_users_per_run"])
        required_window = int(rule.get("stability_window_seconds") or 0)
        operation_reviews = []
        for operation_id in operation_ids:
            records = self._authority_feedback_records_for_operation(operation_id)
            users: set[str] = set()
            feedback_ids: set[str] = set()
            statuses: set[str] = set()
            rollback_required = False
            for kind_records in records.values():
                for row in kind_records:
                    user = str(row.get("user") or "")
                    if user:
                        users.add(user)
                    feedback_id = str(row.get("feedback_id") or row.get("object_id") or "")
                    if feedback_id:
                        feedback_ids.add(feedback_id)
                    status = str(row.get("outcome_status") or row.get("closure_state") or "").lower()
                    if status:
                        statuses.add(status)
                    rollback_result = row.get("rollback_result")
                    if isinstance(rollback_result, dict) and bool_value(rollback_result.get("rollback_required")):
                        rollback_required = True
                    if bool_value(row.get("rollback_required")):
                        rollback_required = True
            missing = [kind for kind in required_feedback if not records.get(kind)]
            successful = (
                "success" in statuses
                and not {"failure", "rollback_required"}.intersection(statuses)
                and not rollback_required
            )
            closed = any(str(row.get("closure_state") or "").upper() == "CLOSED" for row in records.get("closure", []))
            users_count = len(users)
            stability_window_seconds = self._authority_promotion_stability_window_seconds(target, records)
            stability_window_satisfied = stability_window_seconds >= required_window
            operation_success_proven = (
                users_count >= min_users
                and successful
                and closed
                and not missing
                and stability_window_satisfied
            )
            operation_reviews.append(
                {
                    "operation_id": operation_id,
                    "feedback_record_counts": {kind: len(items) for kind, items in records.items()},
                    "feedback_ids": sorted(feedback_ids),
                    "users": sorted(users),
                    "users_count": users_count,
                    "statuses": sorted(statuses),
                    "missing_feedback_types": missing,
                    "rollback_required": rollback_required,
                    "successful": successful,
                    "closure_closed": closed,
                    "required_min_users": min_users,
                    "stability_window_required_seconds": required_window,
                    "stability_window_observed_seconds": stability_window_seconds,
                    "stability_window_satisfied": stability_window_satisfied,
                    "operation_success_proven": operation_success_proven,
                    f"{rule['run_label']}_success_proven": operation_success_proven,
                }
            )
        successful_runs = [row for row in operation_reviews if row["operation_success_proven"]]
        blockers = []
        if len(operation_ids) < required_runs:
            blockers.append(str(rule["count_blocker"]))
        if len(successful_runs) < required_runs:
            blockers.append(str(rule["failure_blocker"]))
        equivalence_review: dict[str, Any] | None = None
        if target == "POOL" and blockers:
            equivalence_review = self._pool_authority_equivalence_review(operation_reviews, successful_runs, required_window)
            if equivalence_review.get("accepted"):
                blockers = []
        return {
            "schema_version": "v7.authority-promotion-evidence-review.v2",
            "target_authority_class": target,
            "source_authority_class": rule["from"],
            "required_successful_runs": required_runs,
            f"required_successful_{rule['run_label']}_runs": required_runs,
            "min_users_per_successful_run": min_users,
            "requires_feedback": list(required_feedback),
            "requires_stability_window": bool(rule.get("requires_stability_window")),
            "required_stability_window_seconds": required_window,
            "operation_ids": operation_ids,
            "operation_reviews": operation_reviews,
            "successful_runs": len(successful_runs),
            f"successful_{rule['run_label']}_runs": len(successful_runs),
            "blockers": blockers,
            **({"equivalence_review": equivalence_review, "equivalence_accepted": bool(equivalence_review.get("accepted"))} if equivalence_review is not None else {}),
            "evidence_valid": not blockers,
        }

    def promote_authority(self, target_class: str) -> dict[str, Any]:
        target = normalize_authority_class(target_class)
        operation_ids = []
        for value in getattr(self.args, "authority_promotion_operation_id", []) or []:
            operation_ids.extend(split_csv(value))
        operation_ids = list(dict.fromkeys(operation_ids))
        before_effective = dict(self.authority_budget_policy)
        before_raw = dict((self.policy or {}).get("authority_budget") or {})
        current = normalize_authority_class(before_effective.get("authority_class"))
        certified = normalize_authority_class(before_effective.get("certified_authority_class"))
        current_for_transition = canonical_authority_class_for_promotion(
            current,
            before_effective.get("current_allowed_user_budget"),
        )
        certified_for_transition = canonical_authority_class_for_promotion(
            certified,
            before_effective.get("current_allowed_user_budget"),
        )
        expected_next = AUTHORITY_CLASS_NEXT.get(current_for_transition, current_for_transition)
        result: dict[str, Any] = {
            "schema_version": "v7.authority-promotion-action.v1",
            "action": "authority_promotion",
            "component": "tools/v7-users-autoswitch",
            "target_authority_class": target,
            "before": {
                "raw": before_raw,
                "effective": before_effective,
                "policy_hash": sha256_file(Path(self.args.policy_file)),
            },
            "operation_ids": operation_ids,
            "users_moved": 0,
            "routing_mutation_performed": False,
            "autoswitch_apply_run": False,
            "status": "DENIED",
            "blockers": [],
        }
        control = self._execution_control_decision(
            mutation_kind="forward",
            action_class="AUTHORITY_PROMOTION",
            expected_generation=str(getattr(self.args, "approved_breaker_generation", "") or ""),
            operation_id="authority-promotion",
        )
        result["execution_control"] = control
        if not control.get("allowed_forward_mutation"):
            result["blockers"].append("autonomous_execution_control_denied")
        if current_for_transition != current or certified_for_transition != certified:
            result["legacy_authority_class_alias"] = {
                "raw_authority_class": current,
                "raw_certified_authority_class": certified,
                "canonical_authority_class": current_for_transition,
                "canonical_certified_authority_class": certified_for_transition,
                "reason": "legacy_pool_25_maps_to_canonical_large_batch_for_forward_promotion",
            }
        if getattr(self.args, "confirm_authority_promotion", "") != "PROMOTE_AUTHORITY_APPROVED":
            result["blockers"].append("missing_explicit_authority_promotion_confirmation")
        if target != expected_next or target == current_for_transition:
            result["blockers"].append(f"invalid_target_authority_transition_{current_for_transition}_to_{target}")
        if current_for_transition != certified_for_transition:
            result["blockers"].append("runtime_authority_not_equal_to_certified_authority")
        rule = AUTHORITY_PROMOTION_RULES.get(target)
        result["promotion_rule"] = rule or {}
        if not rule:
            result["blockers"].append(f"unsupported_authority_promotion_target_{target.lower()}")
        elif current_for_transition != rule["from"]:
            result["blockers"].append(f"invalid_rule_source_authority_{current_for_transition}_for_{target}")
        elif target != "POOL" and len(operation_ids) < int(rule["required_successful_runs"]):
            result["blockers"].append(str(rule["count_blocker"]))

        truth = self._authority_promotion_truth_check()
        result["truth_check"] = truth
        if not truth.get("passed"):
            result["blockers"].append("runtime_truth_check_failed")

        evidence = self._authority_promotion_evidence_review(operation_ids, target)
        result["evidence_review"] = evidence
        if not evidence.get("evidence_valid"):
            for blocker in evidence.get("blockers") or [str(rule["failure_blocker"]) if rule else "authority_evidence_validation_failed"]:
                if blocker not in result["blockers"]:
                    result["blockers"].append(str(blocker))

        audit_available = shutil.which("v7-audit-log") is not None
        result["audit_command_available"] = audit_available
        if not audit_available:
            result["blockers"].append("v7_audit_log_unavailable")

        if result["blockers"]:
            return result

        policy_path = Path(self.args.policy_file)
        if not policy_path.is_file():
            result["blockers"].append("policy_file_missing")
            return result

        raw_policy = read_json(policy_path, {})
        if not isinstance(raw_policy, dict):
            result["blockers"].append("policy_file_not_json_object")
            return result
        promoted_at = now_iso()
        backup_path = policy_path.with_name(f"{policy_path.name}.backup-authority-promotion-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}")
        after_authority = dict(raw_policy.get("authority_budget") or {})
        after_authority.update(
            {
                "enabled": True,
                "authority_class": target,
                "prepared_authority_class": target,
                "certified_authority_class": target,
                "authority_lifecycle_state": "PROMOTED",
                "current_allowed_user_budget": authority_class_budget(target, to_int(after_authority.get("current_allowed_user_budget"), 0)),
                "next_authority_class": AUTHORITY_CLASS_NEXT.get(target, target),
                "next_allowed_user_budget": authority_class_budget(AUTHORITY_CLASS_NEXT.get(target, target), authority_class_budget(target, 0)),
                "evidence_floor": rule["evidence_floor"],
                "promoted_at": promoted_at,
                "promoted_by": "tools/v7-users-autoswitch",
                "promotion_action": rule["promotion_action"],
                "promotion_evidence": {
                    "operation_ids": operation_ids,
                    "successful_runs": evidence.get("successful_runs"),
                    f"successful_{rule['run_label']}_runs": evidence.get(f"successful_{rule['run_label']}_runs"),
                    "required_successful_runs": evidence.get("required_successful_runs"),
                    "required_stability_window_seconds": evidence.get("required_stability_window_seconds"),
                    "equivalence_accepted": bool(evidence.get("equivalence_accepted")),
                    "equivalence_review": evidence.get("equivalence_review") or {},
                    "feedback_ids": sorted(
                        {
                            feedback_id
                            for review in evidence.get("operation_reviews", [])
                            for feedback_id in review.get("feedback_ids", [])
                        }
                    ),
                },
            }
        )
        raw_policy["authority_budget"] = after_authority
        try:
            shutil.copy2(policy_path, backup_path)
            write_json_atomic(policy_path, raw_policy)
        except OSError as exc:
            result["blockers"].append(f"policy_write_failed:{exc}")
            return result

        audit = {
            "action": "authority_promotion",
            "component": "autoswitch",
            "object_type": "policy",
            "object_id": "authority_budget",
            "result": "OK",
            "metadata": {
                "from_authority_class": current,
                "to_authority_class": target,
                "from_allowed_user_budget": before_effective.get("current_allowed_user_budget"),
                "to_allowed_user_budget": authority_class_budget(target, 0),
                "operation_ids": ",".join(operation_ids),
                "backup_path": str(backup_path),
                "policy_hash_before": result["before"]["policy_hash"],
                "promotion_action": rule["promotion_action"],
                "program": "PROGRAM_UNIFIED_AUTHORITY_PROMOTION_OWNER_AND_FUTURE_LADDER_GOVERNANCE",
            },
            "emitted": False,
            "status": "ready_to_emit",
        }
        audit = self._emit_terminal_audit(audit)
        if not audit.get("emitted"):
            try:
                shutil.copy2(backup_path, policy_path)
            except OSError:
                pass
            result["audit"] = audit
            result["status"] = "DENIED_AUDIT_FAILED_ROLLED_BACK"
            result["blockers"].append("authority_promotion_audit_failed")
            return result

        after_effective = AutoswitchPlanner(
            argparse.Namespace(**{**vars(self.args), "pre_planner_refresh": "off"})
        ).authority_budget_policy
        result["backup_path"] = str(backup_path)
        result["audit"] = audit
        result["after"] = {
            "raw": after_authority,
            "effective": after_effective,
            "policy_hash": sha256_file(policy_path),
        }
        result["authority_promoted"] = True
        result["status"] = "PROMOTED"
        return result

