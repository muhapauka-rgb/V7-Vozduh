            continue
        multi_target_rows.append({
            "target_id": str(row.get("target_id") or ""),
            "correlation_domain": correlation_domain,
            "allocated_users": safe_scope,
            "capacity_reservation": safe_scope,
            "verification_supported": bool(row.get("verification_supported")),
            "rollback_containment_supported": bool(
                row.get("rollback_containment_supported")
            ),
            "target_fingerprint": str(
                row.get("semantic_fingerprint") or ""
            ),
        })
        selected_correlation_domains.add(correlation_domain)
        combined_safe_scope += safe_scope
        remaining_stage_scope = max(0, current_stage - combined_safe_scope)
        if remaining_stage_scope == 0:
            break
    multi_target_ready = bool(
        current_stage > 0
        and len(multi_target_rows) > 1
        and combined_safe_scope >= current_stage
    )
    if (
        legal_outcome
        == "NO_CURRENT_TARGET_CAPACITY_WITH_EXACT_OWNER_BOUNDARY"
        and multi_target_ready
    ):
        legal_outcome = (
            "MULTI_TARGET_EXECUTION_AUTHORITY_REQUIRED"
            if exact_target_authority
            else "MULTI_TARGET_ALLOCATION_READY"
        )

    # Reuse the same inventory, quality and capacity owners, but do not apply
    # the controlled-source isolation law to a non-destructive destination.
    # The result can only request an exact future action-class contract.
    availability_first_stages = list(
        operator_execution.AVAILABILITY_FIRST_LADDER
    )
    shared_allocation = shared_target_stage_allocations(
        rows=rows,
        stages=availability_first_stages,
        inventory_fingerprint=inventory_fingerprint,
    )
    shared_ranked = [
        row for row in rows
        if str(row.get("target_id") or "")
        in set(shared_allocation.get("ranked_target_ids") or [])
    ]
    shared_stage_allocations = shared_allocation["stage_allocations"]
    shared_current = shared_stage_allocations.get(
        str(availability_current_stage),
        {},
    )
    shared_completion = shared_stage_allocations.get(
        str(operator_execution.AVAILABILITY_FIRST_LADDER[-1]),
        {},
    )
    standing_policy_semantic_coverage = (
        availability_first_standing_policy_semantic_coverage_gate(
            standing_validation=standing_validation,
            policy_contract=policy_contract,
            availability_scope=availability_scope,
            stage=availability_current_stage,
            allocation=shared_current,
        )
        if shared_current.get("feasible")
        else {
            "schema_version": "v7.standing-policy-semantic-coverage-gate.v1",
            "status": "NOT_EVALUATED_NO_CURRENT_FEASIBLE_ALLOCATION",
            "ok": False,
            "contract_id": str(policy_contract.get("contract_id") or ""),
            "contract_hash": str(policy_contract.get("contract_hash") or ""),
            "normalized_effect": {},
            "matched_dimensions": [],
            "mismatched_dimensions": ["current_stage_allocation_not_feasible"],
            "forbidden_effects": {
                "policy_write": False,
                "authority_issuance": False,
                "candidate_created": False,
                "packet_created": False,
                "lease_created": False,
                "runtime_apply": False,
                "routing_mutation": False,
                "user_movement": 0,
                "rollback_apply": False,
                "authority_expansion": False,
                "production_maturity_change": False,
            },
        }
    )
    if (
        legal_outcome == "NO_CURRENT_TARGET_CAPACITY_WITH_EXACT_OWNER_BOUNDARY"
        and shared_current.get("feasible")
    ):
        legal_outcome = str(
            standing_policy_semantic_coverage.get("status")
            or "ENGINEERING_BINDING_GAP"
        )

    historical_defects_closed = [
        "CAMPAIGN_TARGET_ID_ORDER_SELECTION_DEFECT",
        "CAMPAIGN_TARGET_READINESS_SEMANTICALLY_INCOMPLETE",
        "CAMPAIGN_TARGET_PINNING_WITHOUT_DYNAMIC_RESELECTION",
        "CAMPAIGN_TARGET_INVENTORY_GENERATION_NOT_CONSUMED",
    ]
    if legal_outcome == "AUTO_ADMITTED_BY_EXISTING_STANDING_POLICY":
        historical_defects_closed.append(
            "STANDING_POLICY_SEMANTIC_COVERAGE_GATE_CONSUMER_BINDING"
        )
    current_residuals: list[str] = []
    if pinned_target_id and not pinned.get("full_live_admission"):
        current_residuals.append(
