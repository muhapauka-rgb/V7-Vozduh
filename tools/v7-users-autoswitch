def controlled_source_topology_authority_request_only(
    args: argparse.Namespace,
) -> dict[str, Any]:
    """Register the exact current preflight through the existing audit owner."""
    forbidden = [
        name for name in (
            "apply",
            "emergency_failover_autonomy",
            "controlled_verifier_contention",
            "allow_pre_planner_refresh_with_apply",
        )
        if bool_value(getattr(args, name, False))
    ]
    forbidden.extend(
        name for name in (
            "approved_packet_id",
            "approved_operation_id",
            "approved_selected_move_hash",
            "approved_authority_generation",
            "approved_breaker_generation",
            "approved_source_bundle_hash",
            "approved_snapshot_bundle_hash",
            "generate_rollback_packet_from_result",
            "rollback_packet",
            "promote_authority_to",
        )
        if str(getattr(args, name, "") or "").strip()
    )
    if str(getattr(args, "pre_planner_refresh", "off") or "off") != "off":
        forbidden.append("pre_planner_refresh")
    if forbidden:
        return {
            "schema_version": (
                "v7.controlled-source-topology-authority-entrypoint.v1"
            ),
            "status": "STOP_SAFE_FORBIDDEN_FLAGS",
            "ok": False,
            "blockers": [
                f"controlled_source_topology_request_forbids_{name}"
                for name in sorted(set(forbidden))
            ],
        }
    diagnostic = controlled_source_topology_diagnostic(args)
    package = (
        diagnostic.get("authority_package")
        if isinstance(diagnostic.get("authority_package"), dict)
        else {}
    )
    if (
        diagnostic.get("status")
        != "CONTROLLED_SOURCE_TOPOLOGY_PRODUCTION_PREFLIGHT_READY"
        or package.get("actionable") is not True
    ):
        lifecycle = (
            diagnostic.get("authority_lifecycle")
            if isinstance(diagnostic.get("authority_lifecycle"), dict)
            else {}
        )
        if (
            package.get("registered") is True
            and lifecycle.get("matching_current_preflight") is True
            and lifecycle.get("status") == "PENDING"
        ):
            return {
                "schema_version": (
                    "v7.controlled-source-topology-authority-entrypoint.v1"
                ),
                "status": "PASS",
                "ok": True,
                "authority_classification": "ENGINEERING_AUTHORITY",
                "request": package,
                "registration": {
                    "status": "ALREADY_REGISTERED_SEMANTIC_ACTIVE",
                    "request_id": str(package.get("request_id") or ""),
                    "request_hash": str(package.get("request_hash") or ""),
                    "audit_write": False,
                },
                "next_required_consumer": (
                    "existing independent Authority owner"
                ),
                "forbidden_effects": diagnostic.get("forbidden_effects"),
            }
        return {
            "schema_version": (
                "v7.controlled-source-topology-authority-entrypoint.v1"
            ),
            "status": "STOP_SAFE_PREDECESSOR_REQUIRED",
            "ok": False,
            "blockers": [
                str(diagnostic.get("durable_successor") or "preflight_not_ready")
            ],
            "diagnostic": diagnostic,
        }
    request = (
        operator_execution.build_controlled_source_topology_authority_request(
            package
        )
    )
    registration = (
        operator_execution.register_controlled_source_topology_authority_request(
            request,
            audit_store=Path(args.action_class_audit_store),
            producer_id="tools/v7-users-autoswitch",
        )
    )
    registered_request = (
        registration.get("request")
        if isinstance(registration.get("request"), dict)
        else request
    )
    return {
        "schema_version": (
            "v7.controlled-source-topology-authority-entrypoint.v1"
        ),
        "status": "PASS",
        "ok": True,
        "authority_classification": "ENGINEERING_AUTHORITY",
        "request": registered_request,
        "registration": registration,
        "selected_option": str(
            ((diagnostic.get("recommendation") or {}).get("selected_option"))
            or ""
        ),
        "selected_resource": str(
            ((diagnostic.get("recommendation") or {}).get("selected_resource"))
            or ""
        ),
        "next_required_consumer": "existing independent Authority owner",
        "reentry_condition": str(
            registered_request.get("reentry_condition") or ""
        ),
        "forbidden_effects": {
            "audit_write": bool(registration.get("audit_write")),
            "policy_write": False,
            "registry_write": False,
            "identity_creation": False,
            "assignment_change": False,
            "topology_materialized": False,
            "candidate_created": False,
            "packet_created": False,
            "lease_created": False,
            "restore_barrier_write": False,
            "runtime_apply": False,
            "routing_mutation": False,
            "user_movement": 0,
            "rollback_apply": False,
            "authority_expansion": False,
            "production_maturity_change": False,
        },
    }


def standing_delegated_policy_status_only(args: argparse.Namespace) -> dict[str, Any]:
    """Expose the existing policy/audit owner as a redacted read-only status.

    This is deliberately narrower than the planner: it does not construct an
    incident, Candidate, Packet or lease.  CPS reconciliation needs only the
    already-authoritative contract identity and validation outcome, not the
    policy body or an execution preflight.
    """
    forbidden = [
        name for name in (
            "apply", "emergency_failover_autonomy", "controlled_verifier_contention",
            "allow_pre_planner_refresh_with_apply",
        )
        if bool_value(getattr(args, name, False))
    ]
    forbidden.extend(
        name for name in (
            "approved_packet_id", "approved_operation_id", "approved_selected_move_hash",
            "approved_authority_generation", "approved_breaker_generation",
            "approved_source_bundle_hash", "approved_snapshot_bundle_hash",
            "generate_rollback_packet_from_result", "rollback_packet", "promote_authority_to",
        )
        if str(getattr(args, name, "") or "").strip()
    )
    if str(getattr(args, "pre_planner_refresh", "off") or "off") != "off":
        forbidden.append("pre_planner_refresh")
    if forbidden:
        return {
            "schema_version": "v7.standing-delegated-policy-runtime-status.v1",
            "status": "STOP_SAFE_FORBIDDEN_FLAGS",
            "ok": False,
            "blockers": [f"standing_policy_status_forbids_{name}" for name in sorted(set(forbidden))],
            "forbidden_effects": {"policy_write": False, "runtime_apply": False, "routing_mutation": False, "user_movement": 0},
        }

    policy_root = read_json(Path(args.policy_file), {})
    policy_root = policy_root if isinstance(policy_root, dict) else {}
    contract = policy_root.get("delegated_autonomy_policy")
    contract = contract if isinstance(contract, dict) else {}
    audit_records = operator_execution.read_live_execution_lineage_records(
        Path(args.action_class_audit_store)
    )
    validation = operator_execution.validate_standing_delegated_operational_policy(
        contract,
        audit_records=audit_records,
    )
    pending_owner_result = operator_execution.latest_pending_standing_delegated_policy_request(
        audit_records,
    )
    controlled_substrate_authority = (
        operator_execution.controlled_certification_substrate_authority_status(
            audit_records,
        )
    )
    controlled_substrate_request = (
        controlled_substrate_authority.get("request")
        if isinstance(controlled_substrate_authority.get("request"), dict)
        else {}
    )
    controlled_substrate_scope = (
        controlled_substrate_request.get("scope")
        if isinstance(controlled_substrate_request.get("scope"), dict)
        else {}
    )
    pending_request = (
        pending_owner_result.get("request")
        if isinstance(pending_owner_result.get("request"), dict)
        else {}
    )
    pending_policy = (
        pending_request.get("policy")
        if isinstance(pending_request.get("policy"), dict)
        else {}
    )
    policy_scope = validation.get("policy") if isinstance(validation.get("policy"), dict) else {}
    controlled_campaign_status = (
        operator_execution.controlled_certification_campaign_stage_status(
            audit_records,
        )
    )
    availability_campaign_status = (
        operator_execution.availability_first_campaign_stage_status(
            audit_records,
            contract=contract,
        )
        if (
            validation.get("ok")
            and policy_scope.get("policy_profile")
            == operator_execution.AVAILABILITY_FIRST_STANDING_POLICY_PROFILE
        )
        else {
            "schema_version": (
                "v7.availability-first-campaign-stage-status.v1"
