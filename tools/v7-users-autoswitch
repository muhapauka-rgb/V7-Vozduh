            "intelligence_confidence": round(sum(result_confidences) / len(result_confidences), 4) if result_confidences else 0.0,
            "service_history_score": to_float(risk.get("average_service_score"), 0.0),
            "weighted_service_score": to_float(risk.get("average_channel_score"), 0.0),
            "execution_trust_score": to_float(trust.get("score"), 0.0),
            "recommended_blast_radius": to_int(recommendation.get("recommended_budget"), 0),
            "intelligence_used_for_explanation": True,
