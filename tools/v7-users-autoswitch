    def _load_limits_for_egress(self, egress: Egress, base: Optional[dict[str, Any]] = None) -> dict[str, Any]:
        base = base or self.dynamic_load
        base_soft = to_int(base.get("soft_limit"), 15)
        base_hard = to_int(base.get("hard_limit"), 30)
        base_failover = to_int(base.get("failover_hard_limit"), max(base_hard, 60))
        soft_limit = base_soft
        hard_limit = base_hard
        failover_hard_limit = base_failover
        if egress.capacity_users > 0:
            soft_limit = min(soft_limit, egress.capacity_users)
            hard_limit = min(hard_limit, egress.capacity_users)
            multiplier = to_float(self.load_policy.get("failover_capacity_multiplier"), 1.25)
            failover_hard_limit = min(failover_hard_limit, max(hard_limit, int(math.ceil(egress.capacity_users * multiplier))))
        hard_limit = max(1, hard_limit)
        soft_limit = max(1, min(soft_limit, hard_limit))
        failover_hard_limit = max(hard_limit, failover_hard_limit)
        status = "OK"
        if egress.users >= failover_hard_limit:
            status = "FAILOVER_FULL"
        elif egress.users >= hard_limit:
            status = "HARD_FULL"
        elif egress.users >= soft_limit:
            status = "SOFT_FULL"
        return {
            "users": egress.users,
            "soft_limit": soft_limit,
            "hard_limit": hard_limit,
            "failover_hard_limit": failover_hard_limit,
            "capacity_users": egress.capacity_users,
            "status": status,
        }

    def _load_users(self) -> list[User]:
        state_users = self.state.get("users")
        rows = state_users if isinstance(state_users, list) else parse_registry(self.state_dir / "users.registry")
        org_users = self._org_user_map()
        users: list[User] = []
        for row in rows:
            ip = str(row.get("ip", ""))
            if not SAFE_IP_RE.match(ip):
                continue
            group = str(row.get("group") or row.get("org") or row.get("organization") or org_users.get(ip) or self.org_policy.get("default_group") or "default")
            users.append(User(
                ip=ip,
                current=str(row.get("current", "")),
                table=str(row.get("table", "")),
                enabled=str(row.get("enabled", "1")) == "1",
                group=group,
                raw=row,
            ))
        return users

    def _org_user_map(self) -> dict[str, str]:
        mapping: dict[str, str] = {}
        explicit = self.org_policy.get("user_groups") or {}
        if isinstance(explicit, dict):
            mapping.update({str(ip): str(group) for ip, group in explicit.items()})
        for group_name, group in (self.org_policy.get("groups") or {}).items():
            for ip in split_csv((group or {}).get("users", [])):
                mapping[ip] = str(group_name)
        return mapping

    def _load_egress(self) -> dict[str, Egress]:
        registry_rows = parse_registry(self.state_dir / "egress.registry")
        state_egress = self.state.get("egress") if isinstance(self.state.get("egress"), dict) else {}
        ids = sorted({str(row.get("id", "")) for row in registry_rows if row.get("id")} | set(state_egress.keys()))
        meta_all = self.org_policy.get("egress") or {}
        result: dict[str, Egress] = {}
        for egress_id in ids:
            reg = next((row for row in registry_rows if row.get("id") == egress_id), {})
            live = state_egress.get(egress_id) or {}
            meta = meta_all.get(egress_id) or {}
            speed_item = (self.speed.get("items") or {}).get(egress_id) or {}
            avg_mbps = to_float(live.get("avg_mbps"), to_float(speed_item.get("server_v7_mbps")))
            min_mbps = to_float(live.get("min_mbps"), to_float(speed_item.get("server_v7_min_mbps"), avg_mbps))
            roles = split_csv(meta.get("roles") or meta.get("role") or reg.get("roles") or reg.get("role") or "GLOBAL_FAST")
            capacity = to_int(meta.get("capacity_users") or reg.get("capacity_users") or reg.get("capacity") or 0)
            result[egress_id] = Egress(
                id=egress_id,
                interface=str(meta.get("interface") or reg.get("interface") or live.get("interface") or ""),
                enabled=str(reg.get("enabled", meta.get("enabled", "1"))) == "1" and not bool_value(meta.get("disabled")),
                state=str(meta.get("state") or reg.get("state") or "enabled"),
                role=roles[0] if roles else "GLOBAL_FAST",
                roles=roles or ["GLOBAL_FAST"],
                priority=to_int(meta.get("priority") or reg.get("priority") or 50, 50),
                weight=to_float(meta.get("weight") or reg.get("weight") or 100.0, 100.0),
                capacity_users=capacity,
                reserve_only=bool_value(meta.get("reserve_only") or reg.get("reserve_only")),
                manual_only=bool_value(meta.get("manual_only") or reg.get("manual_only")),
                canary_reserved=bool_value(meta.get("canary_reserved") or reg.get("canary_reserved")),
                exclusive_group=str(meta.get("exclusive_group") or reg.get("exclusive_group") or ""),
                groups=split_csv(meta.get("groups") or reg.get("groups") or ""),
                users=to_int(live.get("users")),
                avg_mbps=avg_mbps,
                min_mbps=min_mbps,
                client_mbps=self._client_mbps_for_egress(egress_id),
                stability=to_float(live.get("stability"), to_float(speed_item.get("stability"))),
                health_code=str(live.get("code") or speed_item.get("code") or ""),
                severity=str(live.get("diagnose_severity") or speed_item.get("severity") or ""),
                diagnose_reason=str(live.get("diagnose_reason") or ""),
                load_status=str(live.get("load_status") or ""),
                raw={"registry": reg, "state": live, "meta": meta, "speed": speed_item},
            )
        return result

    def _sync_egress_user_counts(self) -> None:
        counts: dict[str, int] = {egress_id: 0 for egress_id in self.egress}
        for user in self.users:
            if user.enabled and user.current:
                counts[user.current] = counts.get(user.current, 0) + 1
        for egress_id, egress in self.egress.items():
            egress.users = counts.get(egress_id, 0)

    def _load_reconnect_state(self) -> dict[str, Any]:
        state = read_json(self.reconnect_state_file, {})
        if not isinstance(state, dict):
            state = {}
        state.setdefault("schema_version", 1)
        state.setdefault("users", {})
        state.setdefault("events", [])
        return state

    def _activity_epoch_for_user(self, user: User) -> int:
        activity = self.vless_activity.get(user.ip) if isinstance(self.vless_activity, dict) else {}
        if isinstance(activity, dict):
            return to_int(activity.get("latest_activity_epoch"), 0)
        return 0

    def _observe_reconnect_events(self) -> dict[str, dict[str, Any]]:
        if not bool_value(self.reconnect_policy.get("enabled", True)):
            return {}
        now = time.time()
        active_age = max(10, to_int(self.reconnect_policy.get("active_age_seconds"), 45))
        reconnect_window = max(active_age, to_int(self.reconnect_policy.get("reconnect_window_seconds"), 120))
        rotation_cooldown = max(30, to_int(self.reconnect_policy.get("rotation_cooldown_seconds"), 180))
        users_state = self.reconnect_state.setdefault("users", {})
        events = self.reconnect_state.setdefault("events", [])
        detected: dict[str, dict[str, Any]] = {}
        changed = False

        active_ips = {user.ip for user in self._active_users()}
        for ip in list(users_state.keys()):
            if ip not in active_ips:
                users_state.pop(ip, None)
                changed = True

        for user in self._active_users():
            latest_epoch = self._activity_epoch_for_user(user)
            observed_online = latest_epoch > 0 and (now - latest_epoch) <= active_age
            row = users_state.setdefault(user.ip, {})
            was_online = bool(row.get("online"))
            last_activity_epoch = to_int(row.get("last_activity_epoch"), 0)
            event: dict[str, Any] = {}

            if was_online and not observed_online:
                row["online"] = False
                row["offline_at"] = now_iso()
                row["offline_epoch"] = int(now)
                row["offline_from_egress"] = user.current
                changed = True
            elif not was_online and observed_online:
                offline_epoch = to_int(row.get("offline_epoch"), 0)
                last_rotation_epoch = to_int(row.get("last_rotation_epoch"), 0)
                offline_from = str(row.get("offline_from_egress") or user.current)
                if (
                    offline_epoch
                    and (now - offline_epoch) <= reconnect_window
                    and (now - last_rotation_epoch) >= rotation_cooldown
                    and latest_epoch > last_activity_epoch
                    and offline_from == user.current
                ):
                    event = {
                        "user_ip": user.ip,
                        "from_egress": user.current,
                        "offline_at": row.get("offline_at"),
                        "online_at": now_iso(),
                        "offline_seconds": round(now - offline_epoch, 1),
                        "latest_activity_epoch": latest_epoch,
                        "reason": "client_reconnect_short_off_on",
                    }
                    detected[user.ip] = event
                    events.append(event)
                    row["last_rotation_epoch"] = int(now)
                row["online"] = True
                row["online_at"] = now_iso()
                changed = True

            if observed_online:
                row["last_seen_at"] = now_iso()
                row["last_activity_epoch"] = max(latest_epoch, last_activity_epoch)
            row["current_egress"] = user.current
            row["latest_activity_epoch"] = latest_epoch

        self.reconnect_state["events"] = events[-200:]
        self.reconnect_state["updated"] = now_iso()
        if changed or detected:
            write_json_atomic(self.reconnect_state_file, self.reconnect_state)
        return detected

    def _client_mbps_for_egress(self, egress_id: str) -> float:
        values: list[float] = []
        for user_data in (self.client_speed.get("users") or {}).values():
            latest = user_data.get("latest") or {}
            v7 = latest.get("v7") or {}
            if v7.get("egress") == egress_id and isinstance(v7.get("mbps"), (int, float)):
                values.append(float(v7["mbps"]))
        return sum(values) / len(values) if values else 0.0

    def _last_switches(self) -> dict[str, float]:
        path = self.event_dir / "switch-history.jsonl"
        last: dict[str, float] = {}
        try:
            lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
        except FileNotFoundError:
            return last
        for line in lines[-2000:]:
            try:
                item = json.loads(line)
            except json.JSONDecodeError:
                continue
            ip = str(item.get("user_ip", ""))
            ts = str(item.get("ts", ""))
            if not ip or not ts:
                continue
            try:
                dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
            except ValueError:
                continue
            last[ip] = dt.timestamp()
        return last

    def _group_usage(self) -> dict[str, set[str]]:
        usage: dict[str, set[str]] = {}
        for user in self.users:
            if user.enabled and user.current:
                usage.setdefault(user.current, set()).add(user.group)
        return usage

    def _group_policy(self, group: str) -> dict[str, Any]:
        return (self.org_policy.get("groups") or {}).get(group) or {}

    def _required_services(self) -> list[str]:
        values: list[str] = []
        for source in (
            self.switch_policy.get("required_services"),
            (self.policy or {}).get("required_services"),
            (self.org_policy or {}).get("required_services"),
            (self.service_prefs or {}).get("required_services"),
        ):
            values.extend(normalize_service_ids(source))
        if not values:
            values = list(DEFAULT_REQUIRED_SERVICES)
        return normalize_service_ids(values)

    def _important_services(self, user: User) -> list[str]:
        prefs = (self.service_prefs.get("users") or {}).get(user.ip) or {}
        values = list(self._required_services())
        if self.args.service:
            values.extend(normalize_service_ids(self.args.service))
        else:
            values.extend(user_priority_services_from_pref(prefs))
        return normalize_service_ids(values)

    def _matrix_services(self, egress_id: str) -> dict[str, Any]:
        return ((self.matrix.get("items") or {}).get(egress_id) or {}).get("services") or {}

    def _route_class_fitness(self, egress_id: str, route_class: str) -> str:
        return str((((self.matrix.get("items") or {}).get(egress_id) or {}).get("route_class_fitness") or {}).get(route_class, {}).get("status") or "")

    def _severity_classification(self, egress: Egress) -> dict[str, Any]:
        severity = str(egress.severity or "").upper()
        reason = str(
            egress.diagnose_reason
            or egress.raw.get("state", {}).get("diagnose_reason")
            or egress.raw.get("state", {}).get("reason")
            or egress.raw.get("speed", {}).get("reason")
            or ""
        )
        if severity in ("", "OK", "WARN", "WARNING"):
            return {
                "severity": severity or "OK",
                "category": "normal",
                "hard_block": False,
                "reason": reason,
            }
        if severity == "FAIL":
            return {
                "severity": severity,
                "category": "fatal",
                "hard_block": True,
                "block_reason": "severity_FAIL",
                "reason": reason,
            }
        if severity == "SUSPECT" and reason == "handshake_unsupported_for_protocol_vless":
            return {
                "severity": severity,
                "category": "protocol_diagnostic_limited_suspect",
                "hard_block": False,
                "reason": reason,
            }
        return {
            "severity": severity,
            "category": "fatal_suspect",
            "hard_block": True,
            "block_reason": f"severity_{severity}",
            "reason": reason,
        }

    def _quality_history(self, egress_id: str) -> dict[str, Any]:
        return ((self.quality_summary.get("items") or {}).get(egress_id) or {})

    def _quality_window(self, egress_id: str, window: str = "1h") -> dict[str, Any]:
        return ((self._quality_history(egress_id).get("windows") or {}).get(window) or {})

    def _explicit_required_services(self) -> set[str]:
        values: list[str] = []
        for source in (
            self.switch_policy.get("required_services"),
            (self.policy or {}).get("required_services"),
            (self.org_policy or {}).get("required_services"),
            (self.service_prefs or {}).get("required_services"),
            self.args.service,
        ):
            values.extend(normalize_service_ids(source))
        return set(values)

    def _service_metric_latency(self, row: dict[str, Any]) -> float:
        return to_float(row.get("first_byte_sec") or row.get("total_sec") or row.get("latency_sec"), 0.0)

    def _service_row_ts(self, row: dict[str, Any]) -> float:
        for key in ("tested_at", "updated", "sampled_at", "ts", "timestamp"):
            value = row.get(key)
            if value:
                return parse_ts(value)
        return 0.0

    def _service_truth_freshness(self, row: dict[str, Any]) -> dict[str, Any]:
        ts = self._service_row_ts(row)
        if ts <= 0:
            return {
                "state": "UNKNOWN",
                "age_seconds": None,
                "runtime_behavior": "fail_closed_if_required",
            }
        age = max(0.0, time.time() - ts)
        fresh = max(1, to_int(self.service_signal_policy.get("service_truth_fresh_seconds"), 900))
        stale = max(fresh, to_int(self.service_signal_policy.get("service_truth_stale_seconds"), 3600))
        expired = max(stale, to_int(self.service_signal_policy.get("service_truth_expired_seconds"), 7200))
        if age <= fresh:
            state = "FRESH"
            behavior = "use"
        elif age <= stale:
            state = "AGING"
            behavior = "degrade_confidence"
        elif age <= expired:
            state = "STALE"
            behavior = "fail_closed_if_required"
        else:
            state = "EXPIRED"
            behavior = "fail_closed_if_relevant"
        return {
            "state": state,
            "age_seconds": round(age, 3),
            "runtime_behavior": behavior,
        }

    def _service_probe_methodology_issue(self, row: dict[str, Any]) -> bool:
        status = str(row.get("status") or "").upper()
        reason = str(row.get("reason") or row.get("error") or "").lower()
        http_code = to_int(row.get("http_code") or row.get("code") or row.get("status_code"), 0)
        methodology_codes = {
            to_int(value, 0)
            for value in (self.service_signal_policy.get("service_truth_probe_methodology_http_codes") or [])
        }
        if status in {"HTTP_LIMITED", "AUTH_REQUIRED", "FORBIDDEN", "RATE_LIMITED", "METHOD_NOT_ALLOWED"}:
            return True
        if http_code in methodology_codes:
            return True
        return any(token in reason for token in ("http 403", "http_403", "http 404", "http_404", "rate limit", "auth"))

    def _service_truth_classification(
        self,
        service: str,
        row: dict[str, Any],
        required: bool,
        relevant: bool = True,
    ) -> dict[str, Any]:
        if not relevant and row and row.get("ok") is False:
            return {
                "truth_class": "PROFILE_IRRELEVANT_FAIL",
                "planner_decision": "ignore_for_current_profile",
                "eligibility_behavior": "no_block",
                "runtime_behavior": "visible_ignored_failure",
                "blocked_action": "",
                "evidence": "service_not_requested_by_user_or_route_profile",
                "freshness": self._service_truth_freshness(row),
                "revalidation": {
                    "mode": "not_run",
                    "reason": "profile_irrelevant",
                    "budget_seconds": to_int(self.service_signal_policy.get("service_truth_revalidation_budget_seconds"), 5),
                    "target_egress_only": bool_value(self.service_signal_policy.get("service_truth_revalidation_target_egress_only", True)),
                },
            }
        if not row:
            return {
                "truth_class": "STALE_SERVICE_TRUTH",
                "planner_decision": "unknown_service_truth",
                "eligibility_behavior": "block_if_required",
                "runtime_behavior": "fail_closed_if_required",
                "blocked_action": f"service_{service}_evidence_unknown" if required else "",
                "evidence": "service_evidence_missing",
                "freshness": {"state": "UNKNOWN", "age_seconds": None, "runtime_behavior": "fail_closed_if_required"},
                "revalidation": {
                    "mode": "not_run",
                    "reason": "no_existing_row_to_revalidate_inside_planner_loop",
                    "budget_seconds": to_int(self.service_signal_policy.get("service_truth_revalidation_budget_seconds"), 5),
                    "target_egress_only": bool_value(self.service_signal_policy.get("service_truth_revalidation_target_egress_only", True)),
                },
            }
        freshness = self._service_truth_freshness(row)
        ok = row.get("ok") is True
        status = str(row.get("status") or ("OK" if ok else "FAIL")).upper()
        if freshness.get("state") in {"STALE", "EXPIRED"}:
            return {
                "truth_class": "STALE_SERVICE_TRUTH",
                "planner_decision": "truth_stale_revalidation_required",
                "eligibility_behavior": "block_if_required_or_expired",
                "runtime_behavior": "fail_closed_when_relevant_truth_expired",
                "blocked_action": f"service_{service}_truth_stale" if required or freshness.get("state") == "EXPIRED" else "",
                "evidence": f"service_truth_{str(freshness.get('state')).lower()}",
                "freshness": freshness,
                "revalidation": {
                    "mode": "bounded_required_not_run_in_planner_loop",
                    "reason": "stale_truth",
                    "budget_seconds": to_int(self.service_signal_policy.get("service_truth_revalidation_budget_seconds"), 5),
                    "target_egress_only": bool_value(self.service_signal_policy.get("service_truth_revalidation_target_egress_only", True)),
                    "profile_relevant_only": bool_value(self.service_signal_policy.get("service_truth_revalidation_profile_relevant_only", True)),
                },
            }
        if ok or status in {"OK", "WARN", "DEGRADED"}:
            return {
                "truth_class": "HEALTHY",
                "planner_decision": "service_truth_accepted",
                "eligibility_behavior": "allow",
                "runtime_behavior": "use_existing_truth",
                "blocked_action": "",
                "evidence": "fresh_ok_or_degraded_truth",
                "freshness": freshness,
                "revalidation": {
                    "mode": "not_run",
                    "reason": "healthy_services_are_not_scanned",
                    "budget_seconds": to_int(self.service_signal_policy.get("service_truth_revalidation_budget_seconds"), 5),
                    "target_egress_only": bool_value(self.service_signal_policy.get("service_truth_revalidation_target_egress_only", True)),
                },
            }
        if self._service_probe_methodology_issue(row):
            return {
                "truth_class": "PROBE_METHODOLOGY_ISSUE",
                "planner_decision": "do_not_treat_as_transport_failure",
                "eligibility_behavior": "visible_degradation_no_transport_block",
                "runtime_behavior": "operator_visible_methodology_issue",
                "blocked_action": "",
                "evidence": "probe_endpoint_or_method_limited",
                "freshness": freshness,
                "revalidation": {
                    "mode": "not_run",
                    "reason": "probe_methodology_issue_requires_probe_fix_not_runtime_failover",
                    "budget_seconds": to_int(self.service_signal_policy.get("service_truth_revalidation_budget_seconds"), 5),
                    "target_egress_only": bool_value(self.service_signal_policy.get("service_truth_revalidation_target_egress_only", True)),
                },
            }
        count = self._service_failure_count(row)
        persistent = self._service_failure_persistent(row, count)
        legacy_unknown_critical = (
            row.get("ok") is False
            and freshness.get("state") == "UNKNOWN"
            and not row.get("status")
            and not row.get("reason")
            and not row.get("error")
            and not row.get("http_code")
            and not row.get("code")
            and not row.get("status_code")
        )
        truth_class = "PERSISTENT_FAIL" if persistent else "TRANSIENT_FAIL"
        return {
            "truth_class": truth_class,
            "planner_decision": "block_persistent_fail" if persistent else "degrade_and_require_bounded_revalidation",
            "eligibility_behavior": "block" if persistent else "penalty_only_until_persistent",
            "runtime_behavior": "fail_closed" if persistent else "bounded_revalidation_before_promotion",
            "blocked_action": f"service_{service}_persistent_failed" if persistent else "",
            "evidence": f"failure_samples_{count}",
            "critical_unknown_truth": legacy_unknown_critical,
            "freshness": freshness,
            "revalidation": {
                "mode": "bounded_required",
                "reason": "transient_failure_needs_targeted_recheck" if not persistent else "persistent_failure_already_blocking",
                "budget_seconds": to_int(self.service_signal_policy.get("service_truth_revalidation_budget_seconds"), 5),
                "target_egress_only": bool_value(self.service_signal_policy.get("service_truth_revalidation_target_egress_only", True)),
                "profile_relevant_only": bool_value(self.service_signal_policy.get("service_truth_revalidation_profile_relevant_only", True)),
            },
        }

    def _service_suitability_for_row(
        self,
        service: str,
        row: dict[str, Any],
        required: bool,
        relevant: bool = True,
    ) -> dict[str, Any]:
        truth = self._service_truth_classification(service, row, required, relevant)
        if not row:
            return {
                "service": service,
                "score": 0.0,
                "confidence": 0.0,
                "status": "UNKNOWN",
                "available": False,
                "required": required,
                "profile_relevant": relevant,
                **truth,
                "reason": "service_evidence_missing",
                "profile": SERVICE_QUALITY_PROFILES.get(service, {}),
            }
        ok = row.get("ok") is True
        status = str(row.get("status") or ("OK" if ok else "FAIL")).upper()
        score = max(0.0, min(to_float(row.get("score"), 100.0 if ok else 0.0), 100.0))
        latency = self._service_metric_latency(row)
        if latency > 0:
            if latency <= 0.75:
                latency_score = 100.0
            elif latency <= 2.0:
                latency_score = max(50.0, 100.0 - ((latency - 0.75) / 1.25) * 50.0)
            else:
                latency_score = max(0.0, 50.0 - min(latency - 2.0, 5.0) * 10.0)
            score = (score * 0.75) + (latency_score * 0.25)
        failure_count = self._service_failure_count(row) if row.get("ok") is False else 0
        if status in ("DOWN", "FAIL", "ERROR", "NOT_STARTED") and not ok:
            score = min(score, 20.0)
        if failure_count:
            score = max(0.0, score - min(failure_count, 5) * 8.0)
        confidence = 0.45
        if row.get("score") not in (None, ""):
            confidence += 0.25
        if latency > 0:
            confidence += 0.15
        if row.get("tested_at") or row.get("updated") or row.get("sampled_at"):
            confidence += 0.10
        if row.get("ok") in (True, False):
            confidence += 0.10
        return {
            "service": service,
            "score": round(max(0.0, min(score, 100.0)), 3),
            "confidence": round(max(0.0, min(confidence, 1.0)), 3),
            "status": status,
            "available": ok or status in ("OK", "WARN", "DEGRADED"),
            "required": required,
            "profile_relevant": relevant,
            **truth,
            "latency_sec": latency,
            "failure_count": failure_count,
            "reason": str(row.get("reason") or row.get("error") or ""),
            "profile": SERVICE_QUALITY_PROFILES.get(service, {}),
        }

    def _service_suitability(self, egress: Egress, services: list[str], route_class: str) -> dict[str, Any]:
        matrix_services = self._matrix_services(egress.id)
        explicit_required = self._explicit_required_services()
        wanted = normalize_service_ids(services)
        if not wanted:
            wanted = normalize_service_ids(list((((self.matrix.get("items") or {}).get(egress.id) or {}).get("services") or {}).keys()))
        per_service: dict[str, Any] = {}
        required_missing: list[str] = []
        low_required: list[str] = []
        min_required_score = to_float(self.service_quality_policy.get("min_required_service_score"), 50.0)
        min_required_confidence = to_float(self.service_quality_policy.get("min_required_service_confidence"), 0.35)
        for service in wanted:
            required = service in explicit_required
            row = matrix_services.get(service) or {}
            item = self._service_suitability_for_row(service, row, required, True)
            self._attach_service_revalidation_command(item, egress.id, service)
            per_service[service] = item
            if required and not row:
                required_missing.append(service)
            if required and row and (
                to_float(item.get("score")) < min_required_score
                or to_float(item.get("confidence")) < min_required_confidence
            ):
                low_required.append(service)
        ignored_failures = []
        for service, row in sorted(matrix_services.items()):
            if service in wanted or not isinstance(row, dict) or row.get("ok") is not False:
                continue
            item = self._service_suitability_for_row(service, row, service in explicit_required, False)
            self._attach_service_revalidation_command(item, egress.id, service)
            ignored_failures.append(item)
        scores = [to_float(item.get("score")) for item in per_service.values()]
        confidences = [to_float(item.get("confidence")) for item in per_service.values()]
        aggregate = sum(scores) / len(scores) if scores else 0.0
        confidence = sum(confidences) / len(confidences) if confidences else 0.0
        fitness = self._route_class_fitness(egress.id, route_class)
        return {
            "schema_version": 1,
            "route_class": route_class,
            "aggregate_score": round(aggregate, 3),
            "confidence": round(confidence, 3),
            "per_service": per_service,
            "ignored_failures": ignored_failures,
            "required_missing": required_missing,
            "required_low": low_required,
            "route_class_fitness": fitness or "UNKNOWN",
            "semantics": "service suitability 0-100; not generic Mbps",
        }

    def _attach_service_revalidation_command(self, item: dict[str, Any], egress_id: str, service: str) -> None:
        revalidation = item.get("revalidation")
        if not isinstance(revalidation, dict):
            return
        budget = max(1, min(to_int(revalidation.get("budget_seconds"), 5), 30))
        truth_class = str(item.get("truth_class") or "")
        if truth_class in {"HEALTHY", "PROFILE_IRRELEVANT_FAIL", "PROBE_METHODOLOGY_ISSUE"}:
            revalidation.setdefault("existing_command", [])
            return
        revalidation["existing_command"] = [
