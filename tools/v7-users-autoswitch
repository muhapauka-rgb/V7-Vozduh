def action_class_contract_reconciliation_only(args: argparse.Namespace) -> dict[str, Any]:
    """Close the STOP_SAFE -> policy-owner handoff on one coherent snapshot.

    The policy handoff itself remains non-mutating.  Its preflight must however
    run inside the existing observe lifecycle: the Telegram sentinel is a
    legitimate high-frequency service-matrix writer, so an out-of-band refresh
    followed by an unlocked read can immediately be stale.  Observe mode holds
    the shared service-matrix lock, invokes the existing snapshot owner, and
    reloads the same source bundle before the request template is derived.

    The entrypoint also enables the existing emergency failover *evidence* gate
    only on its private observe-mode planner.  This is necessary to consume a
    fresh L3 wake from the bounded pre-contract shadow selection; it cannot
    enable apply because this entrypoint rejects `--apply` and never calls
    `planner.apply()`.
    """
    forbidden = [
        name for name in (
            "apply", "emergency_failover_autonomy", "controlled_verifier_contention",
            "allow_pre_planner_refresh_with_apply",
        )
        if bool_value(getattr(args, name, False))
    ]
    forbidden.extend(
        name for name in (
            "promote_authority_to", "generate_rollback_packet_from_result", "rollback_packet",
        )
        if str(getattr(args, name, "") or "").strip()
    )
    if str(getattr(args, "pre_planner_refresh", "off") or "off") != "off":
        forbidden.append("pre_planner_refresh")
    if forbidden:
        return {
            "schema_version": "v7.action-class-contract-reconciliation-entrypoint.v1",
            "status": "STOP_SAFE_FORBIDDEN_FLAGS",
            "ok": False,
            "blockers": [f"action_class_contract_reconciliation_forbids_{name}" for name in sorted(set(forbidden))],
        }
    coherent_args = argparse.Namespace(**vars(args))
    coherent_args.mode = "observe"
    coherent_args.pre_planner_refresh = "off"
    coherent_args.emergency_failover_autonomy = True
    planner = AutoswitchPlanner(coherent_args)
    plan = planner.plan()
    topology = controlled_source_topology_diagnostic(args)
    availability_admission = (
        topology.get("availability_first_standing_policy_admission")
        if isinstance(
            topology.get("availability_first_standing_policy_admission"),
            dict,
        )
        else {}
    )
    if (
        topology.get("status")
        == "CONTROLLED_TOPOLOGY_AVAILABILITY_FIRST_AUTO_ADMITTED"
        and availability_admission.get("ok")
    ):
        return {
            "schema_version": (
                "v7.action-class-contract-reconciliation-entrypoint.v1"
            ),
            "status": "PASS",
            "ok": True,
            "mode": "STANDING_AVAILABILITY_FIRST_POLICY_CONSUMED",
            "authority_classification": "AUTO_ADMITTED",
            "result": {
                "status": (
                    "AUTO_ADMITTED_BY_STANDING_DELEGATED_"
                    "AVAILABILITY_FIRST_POLICY"
                ),
                "standing_policy_admission": availability_admission,
                "durable_successor": topology.get("durable_successor"),
                "next_consumer": (
                    "existing Matrix/Planner fresh allocation and governed "
                    "Candidate/Packet/lease consumer"
                ),
                "request_created": False,
                "one_off_target_approval_required": False,
            },
            "forbidden_effects": {
                "policy_write": False,
                "authority_granted": False,
                "runtime_apply": False,
                "routing_mutation": False,
                "user_movement": 0,
                "candidate_created": False,
                "packet_created": False,
                "lease_created": False,
                "rollback_apply": False,
                "production_maturity_change": False,
            },
        }
    availability_context, availability_blockers = availability_first_action_class_context(topology)
    if topology.get("status") == "CONTROLLED_TOPOLOGY_AVAILABILITY_FIRST_CONTRACT_REQUIRED" and availability_blockers:
        return {
            "schema_version": "v7.action-class-contract-reconciliation-entrypoint.v1",
            "status": "STOP_SAFE_AVAILABILITY_FIRST_BINDING_REQUIRED",
            "ok": False,
            "blockers": availability_blockers,
            "forbidden_effects": {"policy_write": False, "authority_granted": False, "runtime_apply": False, "routing_mutation": False, "user_movement": 0, "candidate_created": False, "packet_created": False, "lease_created": False},
        }
    request = action_class_contract_reconciliation_request(
        plan, policy_path=Path(args.policy_file),
        availability_first_context=availability_context,
    )
    snapshot_gate = ((plan.get("safety") or {}).get("intelligence_snapshots") or {})
    refresh = snapshot_gate.get("pre_planner_refresh") if isinstance(snapshot_gate, dict) else {}
    refresh = refresh if isinstance(refresh, dict) else {}
    return {
        "schema_version": "v7.action-class-contract-reconciliation-entrypoint.v1",
        "status": "PASS",
        "ok": True,
        "mode": "POLICY_READ_ONLY_HANDOFF_WITH_EXISTING_SNAPSHOT_REFRESH",
        "l3_evidence_mode": "PRE_CONTRACT_SHADOW_SELECTION_READ_ONLY",
        "producer": "tools/v7-users-autoswitch.action_class_contract_reconciliation_request",
        "consumer": request["next_consumer"],
        "result": request,
        "coherent_snapshot_preflight": {
            "owner": "existing v7-intelligence-snapshot-refresh",
            "performed": refresh.get("state") == "REFRESH_SUCCESS",
            "source_stable": bool_value(((refresh.get("refresh_result") or {}).get("source_stable"))),
            "shared_service_matrix_lock_held": bool_value(((refresh.get("service_matrix_lock") or {}).get("acquired"))),
            "snapshot_stop_required": bool_value(snapshot_gate.get("stop_required")) if isinstance(snapshot_gate, dict) else True,
            "snapshot_write_only": True,
        },
        "forbidden_effects": {
            "policy_write": False,
            "authority_granted": False,
            "runtime_apply": False,
            "routing_mutation": False,
            "user_movement": 0,
            "candidate_created": False,
            "packet_created": False,
            "lease_created": False,
            "rollback_apply": False,
            "production_maturity_change": False,
            "snapshot_refresh_only": True,
        },
    }


def main() -> int:
    args = build_arg_parser().parse_args()
    if args.prepare_controlled_source_topology_authority_request:
        result = controlled_source_topology_authority_request_only(args)
        print(json.dumps(result, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=False))
        return 0 if result.get("status") == "PASS" else 2
    if args.controlled_source_topology_diagnostic:
        result = controlled_source_topology_diagnostic(args)
        print(json.dumps(result, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=False))
        return 0 if result.get("ok") else 2
    if args.controlled_target_selection_diagnostic:
        result = controlled_campaign_target_selection_diagnostic(args)
        print(json.dumps(result, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=False))
        return 0 if result.get("ok") else 2
    if args.prepare_controlled_certification_substrate_authority_request:
        result = controlled_certification_substrate_authority_request_only(args)
        print(json.dumps(result, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=False))
        return 0 if result.get("status") == "PASS" else 2
    if args.standing_delegated_policy_status:
        result = standing_delegated_policy_status_only(args)
        print(json.dumps(result, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=False))
        return 0 if result.get("status") == "PASS" else 2
    if args.consume_passive_events_only:
        result = consume_passive_events_only(args)
        print(json.dumps(result, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=False))
        return 0 if result.get("status") == "PASS" else 2
    if args.consume_service_failure_automation_only:
        result = consume_service_failure_automation_only(args)
        print(json.dumps(result, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=False))
        return 0 if result.get("status") == "PASS" else 2
    if args.reconcile_passive_causal_projections_only:
        result = reconcile_passive_causal_projections_only(args)
        print(json.dumps(result, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=False))
        return 0 if result.get("status") == "PASS" else 2
    if args.action_class_contract_reconciliation_only:
        result = action_class_contract_reconciliation_only(args)
        print(json.dumps(result, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=False))
        return 0 if result.get("status") == "PASS" else 2
    planner = AutoswitchPlanner(args)
    if args.promote_authority_to:
        result = planner.promote_authority(args.promote_authority_to)
        print(json.dumps(result, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=False))
        return 0 if result.get("status") == "PROMOTED" else 1
    if args.generate_rollback_packet_from_result:
        output = Path(args.rollback_packet_output) if args.rollback_packet_output else Path(args.generate_rollback_packet_from_result).with_suffix(".rollback-packet.json")
        result = planner.write_rollback_packet_from_result(Path(args.generate_rollback_packet_from_result), output)
        print(json.dumps(result, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=False))
        return 1 if result.get("validation_errors") else 0
    if args.rollback_packet:
        result = planner.execute_rollback_packet(Path(args.rollback_packet))
        print(json.dumps(result, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=False))
        state = (result.get("operation") or {}).get("terminal_state")
        return 0 if state in {"ROLLBACK_DRY_RUN", "ROLLBACK_COMPLETED"} else 1
    plan = planner.plan()
    plan["apply_result"] = planner.apply(plan)
    planner.finalize_operation(plan)
    print(json.dumps(plan, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=False))
    return 0


