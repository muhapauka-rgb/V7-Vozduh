    def _switch_policy(self) -> dict[str, Any]:
        sw = merge_defaults((self.policy or {}).get("switch", {}), DEFAULT_SWITCH_POLICY)
        sw.update((self.org_policy or {}).get("switch", {}))
        if self.args.mode:
            sw["autoswitch_mode"] = self.args.mode
        return sw

    def _authority_budget_policy(self) -> dict[str, Any]:
        policy = merge_defaults((self.policy or {}).get("authority_budget", {}), DEFAULT_AUTHORITY_BUDGET_POLICY)
        policy.update((self.org_policy or {}).get("authority_budget", {}))
        prepared_class = normalize_authority_class(policy.get("authority_class"))
        certified_class = normalize_authority_class(
            policy.get("certified_authority_class")
            or policy.get("certified_authority")
            or "CANARY"
        )
        requested_state = normalize_authority_lifecycle_state(policy.get("authority_lifecycle_state"))
        requested_state = AUTHORITY_CERTIFIED_STATE_ALIASES.get(requested_state, requested_state)
        standing_policy_contract = (self.policy or {}).get("delegated_autonomy_policy")
        standing_policy_contract = standing_policy_contract if isinstance(standing_policy_contract, dict) else {}
        authority_audit_store = Path(getattr(
            self.args,
            "action_class_audit_store",
            str(operator_execution.DEFAULT_PRODUCTION_OPERATOR_EXECUTION_AUDIT_STORE),
        ))
        action_contract = runtime_authority_contract_status(
            policy,
            prepared_class=prepared_class,
            certified_class=certified_class,
            standing_policy_contract=standing_policy_contract,
            authority_audit_records=operator_execution.read_live_execution_lineage_records(
                authority_audit_store
            ),
        )
        frozen = bool_value(policy.get("frozen") or policy.get("authority_frozen"))
        revoked = bool_value(policy.get("revoked") or policy.get("authority_revoked"))
        if revoked:
            lifecycle_state = "REVOKED"
        elif frozen:
            lifecycle_state = "FROZEN"
        elif not action_contract["valid"]:
            lifecycle_state = "FROZEN"
        elif requested_state in AUTHORITY_BRIDGE_STATES:
            lifecycle_state = requested_state
        elif requested_state in {"DEMOTED", "FROZEN", "REVOKED"}:
            lifecycle_state = requested_state
        elif AUTHORITY_CLASS_RANK[prepared_class] > AUTHORITY_CLASS_RANK[certified_class]:
            lifecycle_state = "PREPARED"
        elif AUTHORITY_CLASS_RANK[prepared_class] < AUTHORITY_CLASS_RANK[certified_class]:
            lifecycle_state = "DEMOTED"
        elif requested_state == "PROMOTED":
            lifecycle_state = "PROMOTED"
        else:
            lifecycle_state = "CERTIFIED"
        runtime_class = min_authority_class(prepared_class, certified_class)
        if lifecycle_state in {"FROZEN", "REVOKED"}:
            runtime_class = "CANARY"
        prepared_budget = authority_class_budget(prepared_class, to_int(policy.get("current_allowed_user_budget"), 1))
        certified_budget = authority_class_budget(certified_class, to_int(policy.get("current_allowed_user_budget"), 1))
        next_class_for_certified = AUTHORITY_CLASS_NEXT.get(certified_class, certified_class)
        bridge_budget_ceiling = 0
        if (
            lifecycle_state in AUTHORITY_BRIDGE_STATES
            and AUTHORITY_CLASS_RANK[prepared_class] == AUTHORITY_CLASS_RANK[certified_class] + 1
            and prepared_class == next_class_for_certified
        ):
            bridge_budget_ceiling = min(prepared_budget, authority_class_budget(next_class_for_certified, prepared_budget))
        runtime_ceiling = 0 if lifecycle_state in {"FROZEN", "REVOKED"} else authority_class_budget(runtime_class, to_int(policy.get("current_allowed_user_budget"), 1))
        if bridge_budget_ceiling:
            runtime_ceiling = bridge_budget_ceiling
        requested_budget = to_int(policy.get("current_allowed_user_budget"), prepared_budget)
        certification_ceiling = bridge_budget_ceiling or certified_budget
        current_budget = max(0, min(requested_budget, prepared_budget, certification_ceiling, runtime_ceiling))
        if action_contract["required"]:
            current_budget = min(current_budget, action_contract["max_users"]) if action_contract["valid"] else 0
        next_class = AUTHORITY_CLASS_NEXT.get(runtime_class, "CANARY")
        next_budget_default = authority_class_budget(next_class, current_budget)
        policy["prepared_authority_class"] = prepared_class
        policy["certified_authority_class"] = certified_class
        policy["authority_lifecycle_state"] = lifecycle_state
        policy["authority_class"] = runtime_class
        policy["current_allowed_user_budget"] = current_budget
        policy["next_authority_class"] = next_class
        policy["next_allowed_user_budget"] = max(
            current_budget,
            min(to_int(policy.get("next_allowed_user_budget"), next_budget_default), next_budget_default),
        )
        policy["truth_source"] = "existing_policy_files"
        policy["current_action_class_contract"] = action_contract
        policy["runtime_calculation_mode"] = (
            "current_action_class_contract_bounded_authority"
            if action_contract["required"] else
            "certified_authority_with_transitional_bridge"
            if bridge_budget_ceiling
            else "prepared_and_certified_min_authority"
        )
        policy["authority_bridge"] = {
            "schema_version": "v7.authority-transition-bridge.v1",
            "enabled": bool(bridge_budget_ceiling),
            "state": lifecycle_state if lifecycle_state in AUTHORITY_BRIDGE_STATES else "",
            "from_certified_authority": certified_class,
            "to_prepared_authority": prepared_class,
            "bridge_budget_ceiling": bridge_budget_ceiling,
            "promotion_certification": False,
            "truth_source": "existing_policy_files",
            "new_truth_sources_created": False,
            "duplicate_systems_created": False,
        }
        return policy

    def _emergency_failover_policy(self) -> dict[str, Any]:
        policy = merge_defaults(
            (self.policy or {}).get("emergency_failover_autonomy", {}),
            DEFAULT_EMERGENCY_FAILOVER_AUTONOMY_POLICY,
        )
        policy.update((self.org_policy or {}).get("emergency_failover_autonomy", {}))
        if bool_value(getattr(self.args, "emergency_failover_autonomy", False)):
            policy["enabled"] = True
        standing_contract = (self.policy or {}).get("delegated_autonomy_policy")
        standing_validation = operator_execution.validate_standing_delegated_operational_policy(
            standing_contract if isinstance(standing_contract, dict) else {},
            audit_records=operator_execution.read_live_execution_lineage_records(
                Path(getattr(
                    self.args,
                    "action_class_audit_store",
                    str(operator_execution.DEFAULT_PRODUCTION_OPERATOR_EXECUTION_AUDIT_STORE),
                ))
            ),
        )
        standing_scope = standing_validation.get("policy") if isinstance(standing_validation.get("policy"), dict) else {}
        standing_max_users = max(0, to_int(standing_scope.get("max_users_per_action"), 0))
        if standing_validation.get("ok") and standing_max_users in operator_execution.SERVICE_FAILURE_DELEGATED_ACTION_CLASSES:
            runtime_axes = operator_execution.standing_delegated_policy_runtime_axes(
                standing_validation.get("contract") or standing_contract
            )
            # Authority owns the maximum possible budget, while evidence and
            # the exact execution context own the Runtime budget.  An
            # unscoped legacy Tier-48 contract must not expose ordinary users
            # above the currently proven ordinary-production floor.  The
            # controlled ceiling is selected later only after every member is
            # independently proven to be a certification identity on a
            # controlled source.
            policy["max_users_per_run"] = int(runtime_axes["ordinary_production_runtime_max"])
            policy["max_users_per_channel"] = int(runtime_axes["ordinary_production_runtime_max"])
            policy["standing_policy_budget_owner"] = operator_execution.CURRENT_ACTION_CLASS_CONTRACT_ISSUING_OWNER
            policy["runtime_scope_axes"] = runtime_axes
        return policy

    def _load_l3_runtime_state(self) -> dict[str, Any]:
        state = read_json(self.l3_runtime_state_file, {})
        if not isinstance(state, dict):
            state = {}
        state.setdefault("schema_version", "v7.l3-runtime-state.v1")
        state.setdefault("incidents", {})
        state.setdefault("processed_event_ids", [])
        state.setdefault("passive_event_consumptions", {})
        state.setdefault("service_failure_automation_obligations", {})
        state.setdefault("bounded_cohort_transactions", {})
        state.setdefault("capability", {})
        state.setdefault("updated", "")
        return state

    def _write_l3_runtime_state(self, state: dict[str, Any]) -> None:
        state["schema_version"] = "v7.l3-runtime-state.v1"
        state["updated"] = now_iso()
        processed = [str(item) for item in (state.get("processed_event_ids") or []) if str(item)]
        state["processed_event_ids"] = processed[-500:]
        write_json_atomic(self.l3_runtime_state_file, state)
        self.l3_runtime_state = state

    def _bounded_cohort_checkpoint(
        self,
        plan: dict[str, Any],
        selected_moves: list[dict[str, Any]],
        *,
        results: Optional[list[dict[str, Any]]] = None,
        terminal_state: str = "IN_PROGRESS",
        terminal_reason: str = "",
    ) -> dict[str, Any]:
        """Persist compact per-member progress in the existing L3 state owner."""
        operation = plan.get("operation") if isinstance(plan.get("operation"), dict) else {}
        safety = plan.get("safety") if isinstance(plan.get("safety"), dict) else {}
        barrier = safety.get("restore_barrier") if isinstance(safety.get("restore_barrier"), dict) else {}
        approved_lock = barrier.get("approved_plan_lock") if isinstance(barrier.get("approved_plan_lock"), dict) else {}
        operation_id = str(operation.get("operation_id") or "")
        selected_hash = str(operation.get("selected_move_hash") or "")
        members = [{
            "user_ip": str(row.get("user_ip") or ""),
            "source": str(row.get("current_egress") or ""),
            "target": str(row.get("recommended_egress") or ""),
            "index": index,
        } for index, row in enumerate(selected_moves)]
        cohort_fingerprint = sha256_json({"members": members})
        state = self._load_l3_runtime_state()
        transactions = state.setdefault("bounded_cohort_transactions", {})
        existing = transactions.get(operation_id)
        existing = existing if isinstance(existing, dict) else {}
        if existing and (
            str(existing.get("selected_move_hash") or "") != selected_hash
            or str(existing.get("cohort_fingerprint") or "") != cohort_fingerprint
        ):
            return {
                "ok": False,
                "status": "STOP_SAFE",
                "reason": "bounded_cohort_checkpoint_identity_mismatch",
                "checkpoint": existing,
            }
        result_rows = list(results or [])
        subreceipts = [{
            "index": int(row.get("selected_move_index") or index),
            "user_ip": str(row.get("user_ip") or ""),
            "source": str(row.get("from") or ""),
            "target": str(row.get("to") or ""),
            "apply_rc": row.get("rc"),
            "verify_rc": row.get("verify_rc"),
            "service_verify_rc": row.get("service_verify_rc"),
            "rollback_rc": row.get("rollback_rc"),
            "terminal": str(row.get("terminal_outcome_classification") or ""),
        } for index, row in enumerate(result_rows)]
        attempted = {str(row.get("user_ip") or "") for row in result_rows}
        successful = {
            str(row.get("user_ip") or "")
            for row in result_rows
            if str(row.get("terminal_outcome_classification") or "") == "SUCCESS"
        }
        failed = sorted(attempted - successful)
        unapplied = [
            row["user_ip"] for row in members
            if row["user_ip"] not in attempted
        ]
        checkpoint = {
            "schema_version": "v7.bounded-cohort-transaction-checkpoint.v1",
            "owner": "tools/v7-users-autoswitch:l3-runtime-state",
            "operation_id": operation_id,
            "packet_id": str(
                barrier.get("packet_id")
                or approved_lock.get("packet_id")
                or approved_lock.get("approved_packet_id")
                or ""
            ),
            "selected_move_hash": selected_hash,
            "cohort_fingerprint": cohort_fingerprint,
            "member_count": len(members),
            "members": members,
            "subreceipts": subreceipts,
            "applied_successfully": sorted(successful),
            "failed_or_contained": failed,
            "unapplied": unapplied,
            "next_member_index": len(result_rows),
            "state": terminal_state,
            "terminal_reason": terminal_reason,
            "packet_reuse_for_new_transaction": "FORBIDDEN",
            "restart_semantics": "RESUME_CAUSAL_CLOSURE_FROM_CHECKPOINT_NO_DUPLICATE_FORWARD_APPLY",
            "updated_at": now_iso(),
        }
        transactions[operation_id] = checkpoint
        # This compact checkpoint belongs to the existing L3 state owner.  It
        # is not a second execution registry.
        self._write_l3_runtime_state(state)
        return {"ok": True, "status": terminal_state, "checkpoint": checkpoint}

    def _passive_incident_projection_key(self, source_incident_id: str) -> str:
        """Return the deterministic key inside the existing L3 incident owner.

        Passive service failures used to have an immutable closure and an OMP
        receipt, but no compact current-state representation.  The key stays
        in `l3-runtime-state.json:incidents`; it is not a second registry.
        """
        return "passive_" + sha256_json({
            "owner": "tools/v7-users-autoswitch.passive-causal-projection",
            "source_incident_id": str(source_incident_id or ""),
        })[:24]

    def _materialize_passive_incident_projection(
        self,
        state: dict[str, Any],
        closure: dict[str, Any],
        *,
        terminal: str,
        recovery_observed: bool = False,
        expiry_observed: bool = False,
    ) -> dict[str, Any]:
        """Project one passive terminal into the existing compact L3 state.

        This is deliberately a state projection, not an execution attempt. It
        retains identities/pointers and a count-plus-fingerprint scope only;
        raw user lists remain in their producer-owned immutable evidence.
        """
        source_incident_id = str(closure.get("source_incident_id") or closure.get("object_id") or "")
        if not source_incident_id:
            return {"projected": False, "reason": "source_incident_id_missing"}
        incidents = state.setdefault("incidents", {})
        if not isinstance(incidents, dict):
            incidents = {}
            state["incidents"] = incidents
        incident_key = self._passive_incident_projection_key(source_incident_id)
        existing = incidents.get(incident_key) if isinstance(incidents.get(incident_key), dict) else {}
        source_event_ids = sorted({
            str(item) for item in (closure.get("source_event_ids") or []) if str(item)
        })
        if not source_event_ids and str(closure.get("event_id") or ""):
            source_event_ids = [str(closure.get("event_id") or "")]
        source_hashes = closure.get("source_hashes") if isinstance(closure.get("source_hashes"), dict) else {}
        affected_users = [str(item) for item in (closure.get("affected_users") or []) if str(item)]
        source_scope = closure.get("source_scope") if isinstance(closure.get("source_scope"), dict) else {}
        source_scope_count = to_int(source_scope.get("affected_scope_count"), -1)
        source_scope_fingerprint = str(source_scope.get("affected_scope_fingerprint") or "")
        # ``scope_accounting`` is the historical compatibility name for the
        # current-source denominator.  Keep it while exposing the semantic
        # name below: historical packet success must never be mistaken for
        # membership in this live source generation.
        #
        # A continuing incident may legitimately receive a newer Matrix
        # observation after a bounded action.  Its source scope is the next
        # live denominator, not a contradiction with the older denominator.
        # Preserve every previous Outcome in the cumulative projection, but
        # advance the compact current-source projection only from a strictly
        # newer owner-backed source snapshot.  This prevents a stale event
        # from silently shrinking scope while allowing current accounting to
        # remain balanced after a verified action.
        existing_scope = (
            existing.get("current_source_scope")
            if isinstance(existing.get("current_source_scope"), dict)
            else (existing.get("scope_accounting") if isinstance(existing.get("scope_accounting"), dict) else {})
        )
        prior_scope_observed_at = str(existing_scope.get("baseline_observed_at") or "")
        incoming_scope_observed_at = str(source_scope.get("observed_at") or closure.get("observed_at") or "")
        scope_changed = (
            to_int(existing_scope.get("affected_scope_count"), -1) != source_scope_count
            or str(existing_scope.get("affected_scope_fingerprint") or "") != source_scope_fingerprint
        )
        scope_rotation = bool(
            existing_scope
            and scope_changed
            and parse_ts(incoming_scope_observed_at) > parse_ts(prior_scope_observed_at)
        )
        if source_scope_count >= 0 and source_scope_fingerprint and (not existing_scope or scope_rotation):
            scope_accounting = {
                "schema_version": "v7.service-failure-incident-scope-accounting.v2",
                "status": "ACCOUNTED",
                # ``closure.event_id`` can be the compact incident group id.
                # The baseline must point to the producer event that supplied
                # the immutable scope snapshot, not to that derived group.
                "baseline_event_id": str(source_event_ids[0] if source_event_ids else closure.get("event_id") or ""),
                "baseline_observed_at": str(source_scope.get("observed_at") or closure.get("observed_at") or ""),
                "affected_scope_count": source_scope_count,
                "affected_scope_fingerprint": source_scope_fingerprint,
                "protected_scope_count": 0,
                "protected_scope_fingerprint": sha256_json({"incident": source_incident_id, "users": []}),
                "unresolved_scope_count": source_scope_count,
                "unresolved_scope_fingerprint": source_scope_fingerprint,
                "explicitly_excluded_or_recovered_scope_count": 0,
                "accounted_scope_count": source_scope_count,
                "live_registry_available": True,
                "raw_user_list_stored": False,
                "scope_generation": str(source_event_ids[0] if source_event_ids else closure.get("event_id") or ""),
                "supersedes_prior_scope_generation": ({
                    "affected_scope_count": to_int(existing_scope.get("affected_scope_count"), -1),
                    "affected_scope_fingerprint": str(existing_scope.get("affected_scope_fingerprint") or ""),
                    "baseline_event_id": str(existing_scope.get("baseline_event_id") or ""),
                    "rotation_reason": (
                        "LIVE_ROUTE_SCOPE_NO_LONGER_RECONCILABLE_WITH_LEGACY_GENERATION"
                        if str(existing_scope.get("status") or "") == "INCIDENT_SCOPE_ACCOUNTING_BROKEN"
                        else "FRESHER_OWNER_BACKED_SOURCE_SCOPE_GENERATION"
                    ),
                } if scope_rotation else {}),
            }
        else:
            scope_accounting = existing_scope
        affected_count = to_int(scope_accounting.get("affected_scope_count"), len(affected_users))
        scope_fingerprint = sha256_json({
            "source_incident_id": source_incident_id,
            "source_event_ids": source_event_ids,
            "egress_identity_generation": str(closure.get("egress_identity_generation") or ""),
            "channel": str(closure.get("channel") or ""),
            "affected_users": sorted(affected_users),
        })
        incident_generation = str(closure.get("egress_identity_generation") or "") or (
            "pigen_" + sha256_json({
                "source_incident_id": source_incident_id,
                "source_event_ids": source_event_ids,
                "source_hashes": source_hashes,
            })[:24]
        )
        observation_generation = "pobs_" + sha256_json({
            "source_incident_id": source_incident_id,
            "source_event_ids": source_event_ids,
            "source_hashes": source_hashes,
            "terminal": terminal,
        })[:24]
        transition_id = "ptr_" + sha256_json({
            "incident_key": incident_key,
            "observation_generation": observation_generation,
            "terminal": terminal,
        })[:24]
        parent_transition_id = (
            str(existing.get("parent_transition_id") or "")
            if str(existing.get("observation_generation") or "") == observation_generation
            else str(existing.get("transition_id") or "")
        )
        intent_closed = recovery_observed or expiry_observed
        closure_reason = (
            "RECOVERY_OBSERVED" if recovery_observed else
            "EPISODE_EXPIRED_NEW_GENERATION_REQUIRED" if expiry_observed else ""
        )
        next_consumer = "" if intent_closed else "tools/v7-users-autoswitch.materialize_service_failure_automation_advisory"
        reentry_condition = (
            "new owner-backed event starts the next generation"
            if intent_closed else
            "existing advisory materializes exactly one OMP obligation for this incident generation"
        )
        now = now_iso()
        desired = {
            **existing,
            "schema_version": "v7.l3-runtime-incident-record.v2",
            "incident_key": incident_key,
            "incident_id": source_incident_id,
            "incident_generation": incident_generation,
            "observation_generation": observation_generation,
            "parent_transition_id": parent_transition_id,
            "transition_id": transition_id,
            "status": "CLOSED" if intent_closed else "OPEN",
            "incident_state": "INTENT_CLOSED" if intent_closed else "OPEN",
            "channel_incident_state": "RECOVERED" if recovery_observed else ("EXPIRED" if expiry_observed else "OPEN"),
            "attempt_terminal": terminal,
            "attempt_id": "",
            "authority_object": "PASSIVE_SERVICE_FAILURE_CAPTURE",
            "opened_at": str(existing.get("opened_at") or now),
            "closed_at": str(existing.get("closed_at") or now) if intent_closed else "",
            "last_observed_at": str(
                closure.get("observed_at") or closure.get("created_at")
                or existing.get("last_observed_at") or now
            ),
            "channel": str(closure.get("channel") or ""),
            "services": sorted({str(item) for item in (closure.get("services") or []) if str(item)}),
            "failure_families": sorted({str(item) for item in (closure.get("failure_families") or []) if str(item)}),
            "event_provenance": str(closure.get("event_provenance") or "UNKNOWN"),
            "evidence_class": str(closure.get("evidence_class") or "UNKNOWN_EVENT"),
            "source_event_ids": source_event_ids,
            "source_hashes": source_hashes,
            "situation_id": str(closure.get("situation_id") or ""),
            "decision_trace_id": str(closure.get("decision_trace_id") or ""),
            "obligation_id": str(existing.get("obligation_id") or ""),
            "action_opportunity_id": "actionop_" + sha256_json({
                "incident_key": incident_key,
                "incident_generation": incident_generation,
            })[:24],
            "candidate_id": "",
            "packet_id": "",
            "lease_id": "",
            "outcome_id": str(closure.get("object_id") or source_incident_id),
            "learning_id": str(closure.get("learning_record_id") or ""),
            "intent_scope_type": "COHORT",
            "intent_scope_fingerprint": scope_fingerprint,
            "intent_closure_reason": closure_reason,
            "intent_closure_evidence_pointer": str(closure.get("object_id") or source_incident_id) if intent_closed else "",
            "cohort_protection_intent": {
                "state": "INTENT_CLOSED" if intent_closed else "UNRESOLVED",
                "scope_type": "COHORT",
                "scope_fingerprint": scope_fingerprint,
                "affected_users_count": affected_count,
            },
            "user_protection_intent": {
                "state": "INTENT_CLOSED" if intent_closed else "UNRESOLVED_COUNT_ONLY",
                "affected_users_count": affected_count,
                "scope_fingerprint": sha256_json({"incident_key": incident_key, "users": sorted(affected_users)}),
                "raw_user_list_stored": False,
            },
            "next_required_consumer": next_consumer,
            "reentry_condition": reentry_condition,
            "causal_lineage": {
                "source_incident_id": source_incident_id,
                "source_event_ids": source_event_ids,
                "situation_id": str(closure.get("situation_id") or ""),
                "decision_trace_id": str(closure.get("decision_trace_id") or ""),
                "outcome_id": str(closure.get("object_id") or source_incident_id),
                "learning_id": str(closure.get("learning_record_id") or ""),
                "parent_transition_id": parent_transition_id,
            },
            "scope_accounting": scope_accounting,
            "current_source_scope": scope_accounting,
            "incident_cumulative_scope": (
                existing.get("incident_cumulative_scope")
                if isinstance(existing.get("incident_cumulative_scope"), dict)
                else {
                    "schema_version": "v7.service-failure-incident-cumulative-scope.v1",
                    "status": "NO_PACKET_BOUND_LINEAGE_YET",
                    "source_incident_id": source_incident_id,
                    "raw_user_list_stored": False,
                    "lineage_pointers": [],
                }
            ),
            "affected_scope_count": affected_count,
            "affected_scope_fingerprint": str(scope_accounting.get("affected_scope_fingerprint") or scope_fingerprint),
            "protected_scope_count": to_int(scope_accounting.get("protected_scope_count"), 0),
            "protected_scope_fingerprint": str(scope_accounting.get("protected_scope_fingerprint") or ""),
            "unresolved_scope_count": to_int(scope_accounting.get("unresolved_scope_count"), affected_count),
            "unresolved_scope_fingerprint": str(scope_accounting.get("unresolved_scope_fingerprint") or ""),
            "causal_invariant": {
                "name": "OPEN_INCIDENT_REQUIRES_SUCCESSOR_AND_REENTRY",
                "valid": bool(intent_closed or (next_consumer and reentry_condition)),
            },
            "execution_performed": False,
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
            "apply_executed": False,
            "authority_expanded": False,
            "production_maturity_changed": False,
            "consumer": "tools/v7-users-autoswitch._consume_passive_production_events",
            "feeds_next_runtime_cycle": True,
        }
        comparable_existing = {key: value for key, value in existing.items() if key != "updated_at"}
        comparable_desired = {key: value for key, value in desired.items() if key != "updated_at"}
        changed = comparable_existing != comparable_desired
        if changed:
            desired["updated_at"] = now
            incidents[incident_key] = desired
        return {
            "projected": True,
            "changed": changed,
            "incident_key": incident_key,
            "record": desired if changed else existing,
        }

    def reconcile_passive_causal_projections(self) -> dict[str, Any]:
        """Backfill/verify compact passive projections through the same L3 owner.

        This is a bounded-scope repair entrypoint for existing immutable
        closures. It creates no event, Candidate, Packet, lease or execution.
        New passive events materialize the identical projection inline.
        """
        rows = [
            row for row in read_jsonl(self.state_dir / "closure-records.jsonl")
            if str(row.get("object_type") or "") == "passive_production_event"
        ]
        state = self._load_l3_runtime_state()
        # Historical closures remain append-only evidence.  The compact current
        # projection consumes only the latest terminal of each source incident;
        # replaying an older terminal before the current one would otherwise
        # rewrite the same state on every reconciliation.
        latest_by_source: dict[str, dict[str, Any]] = {}
        for closure in sorted(rows, key=lambda row: str(row.get("created_at") or row.get("observed_at") or "")):
            source_incident_id = str(closure.get("source_incident_id") or closure.get("object_id") or "")
            if source_incident_id:
                latest_by_source[source_incident_id] = closure
        changed = 0
        projected = 0
        for closure in latest_by_source.values():
            terminal = str(closure.get("terminal_outcome_classification") or "STOP_SAFE_NO_ACTION")
            result = self._materialize_passive_incident_projection(
                state,
                closure,
                terminal=terminal,
                recovery_observed=terminal == "RECOVERY_OBSERVED_NO_ACTION",
                expiry_observed=terminal == "EPISODE_EXPIRED_NO_ACTION",
            )
            projected += int(bool_value(result.get("projected")))
            changed += int(bool_value(result.get("changed")))
        incidents = state.get("incidents") if isinstance(state.get("incidents"), dict) else {}
        passive_records = [
            row for row in incidents.values()
            if isinstance(row, dict) and str(row.get("authority_object") or "") == "PASSIVE_SERVICE_FAILURE_CAPTURE"
        ]
        invalid_open = sum(
            1 for row in passive_records
            if str(row.get("incident_state") or "") != "INTENT_CLOSED"
            and (not str(row.get("next_required_consumer") or "") or not str(row.get("reentry_condition") or ""))
        )
        if changed:
            self._write_l3_runtime_state(state)
        return {
            "schema_version": "v7.passive-incident-causal-projection-reconciliation.v1",
            "active": bool(rows),
            "projected_records": projected,
            "changed_records": changed,
            "passive_incident_records": len(passive_records),
            "invalid_open_incidents": invalid_open,
            "final_verdict": "PASS" if invalid_open == 0 else "INVALID_OPEN_INCIDENT_NO_SUCCESSOR",
            "forbidden_effects": {
                "candidate_created": False,
                "packet_created": False,
                "lease_created": False,
                "runtime_apply": False,
                "routing_mutation": False,
                "user_movement": 0,
                "rollback_apply": False,
                "authority_change": False,
                "production_maturity_change": False,
            },
        }

    def _effective_service_failure_causal_binding(self, feedback_row: dict[str, Any]) -> dict[str, Any]:
        """Resolve a missing compact scope only from the immutable event owner.

        Earlier governed outcomes can contain a valid event identity but lack
        the compact source scope because the generic event projection dropped
        it.  Do not rewrite history and never infer membership from time or a
        current route: enrich the in-memory binding only when the exact
        producer event confirms the same incident/channel and a valid compact
        denominator.  New packets are rejected without that scope by the
        packet owner.
        """
        raw = feedback_row.get("service_failure_causal_binding")
        binding = dict(raw) if isinstance(raw, dict) else {}
        scope = binding.get("source_scope") if isinstance(binding.get("source_scope"), dict) else {}
        if scope:
            return binding
        event_id = str(binding.get("source_event_id") or "")
        incident_id = str(binding.get("source_incident_id") or "")
        channel = str(binding.get("source_channel") or "")
        if not event_id or not incident_id or not channel:
            return binding
        event_dir = getattr(self, "event_dir", self.state_dir.parent / "events")
        event_path = Path(event_dir) / "service-failure-events.jsonl"
        for event in reversed(read_jsonl(event_path)[-2000:]):
            if str(event.get("event_id") or "") != event_id:
                continue
            event_scope = event.get("source_scope") if isinstance(event.get("source_scope"), dict) else {}
            if (
                str(event.get("source_incident_id") or "") != incident_id
                or str(event.get("channel") or event.get("object") or "") != channel
                or to_int(event_scope.get("affected_scope_count"), 0) <= 0
                or not str(event_scope.get("affected_scope_fingerprint") or "")
                or str(event_scope.get("source_channel") or "") != channel
                or bool_value(event_scope.get("raw_user_list_stored"))
            ):
                return binding
            binding["source_scope"] = dict(event_scope)
            binding["source_scope_resolution"] = "IMMUTABLE_EVENT_OWNER_BACKFILL"
            return binding
        return binding

    def _reconcile_incident_scope_accounting(
        self,
        *,
        existing: dict[str, Any],
        execution_rows: list[dict[str, Any]],
    ) -> dict[str, Any]:
        """Recompute one active incident denominator from live route truth.

        A packet outcome is not membership in a later source-scope generation.
        It can reduce that generation only when its immutable causal binding
        carries the exact same count-plus-fingerprint snapshot.  This avoids
        treating an old successful move as protection for users that were not
        in the current failed-source denominator.
        """
        existing_scope = existing.get("scope_accounting")
        if not isinstance(existing_scope, dict):
            return {}
        source_incident_id = str(existing.get("source_incident_id") or existing.get("incident_id") or "")
        source_channel = str(existing.get("channel") or existing.get("source_channel") or "")
        baseline_count = to_int(existing_scope.get("affected_scope_count"), -1)
        baseline_fingerprint = str(existing_scope.get("affected_scope_fingerprint") or "")
        if not source_incident_id or not source_channel or baseline_count < 0 or not baseline_fingerprint:
            return {}

        if str(existing.get("incident_state") or "") == "INTENT_CLOSED":
            # A closed protection intent is a terminal historical scope, not a
            # live cohort.  Re-evaluating it against a later users.registry
            # generation can incorrectly reopen the old incident when a user
            # legitimately returns to the same channel.  Freeze the compact
            # denominator from its owner-backed terminal projection and keep
            # all later route truth for a new incident generation.
            existing_protected = max(
                0,
                min(
                    baseline_count,
                    to_int(
                        existing_scope.get(
                            "protected_scope_count",
                            existing.get("protected_scope_count"),
                        ),
                        0,
                    ),
                ),
            )
            terminal_excluded = baseline_count - existing_protected
            protected_pointers = sorted({
                str(item)
                for item in (
                    existing_scope.get("protected_scope_lineage_pointers")
                    or existing.get("protected_scope_lineage_pointers")
                    or []
                )
                if str(item)
            })
            closure_pointers = sorted({
                str(item)
                for item in (
                    existing_scope.get("explicitly_excluded_or_recovered_lineage_pointers")
                    or existing.get("explicitly_excluded_or_recovered_lineage_pointers")
                    or []
                )
                if str(item)
            })
            closure_evidence = str(existing.get("intent_closure_evidence_pointer") or "")
            if closure_evidence:
                closure_pointers = sorted(set(closure_pointers) | {closure_evidence})
            terminal_fingerprint_basis = {
                "incident": source_incident_id,
                "baseline_scope_fingerprint": baseline_fingerprint,
                "terminal_scope_frozen": True,
            }
            return {
                "schema_version": "v7.service-failure-incident-scope-accounting.v2",
                "status": "ACCOUNTED",
                "baseline_event_id": str(existing_scope.get("baseline_event_id") or ""),
                "baseline_observed_at": str(existing_scope.get("baseline_observed_at") or ""),
                "affected_scope_count": baseline_count,
                "affected_scope_fingerprint": baseline_fingerprint,
                "protected_scope_count": existing_protected,
                "protected_scope_fingerprint": sha256_json({
                    **terminal_fingerprint_basis,
                    "category": "protected",
                    "count": existing_protected,
                    "lineage_pointers": protected_pointers,
                }),
                "protected_scope_lineage_pointers": protected_pointers,
                "unresolved_scope_count": 0,
                "unresolved_scope_fingerprint": sha256_json({
                    **terminal_fingerprint_basis,
                    "category": "unresolved",
                    "count": 0,
                }),
                "unresolved_scope_route_truth_owner": "terminal_intent_closure",
                "explicitly_excluded_or_recovered_scope_count": terminal_excluded,
                "explicitly_excluded_or_recovered_scope_fingerprint": sha256_json({
                    **terminal_fingerprint_basis,
                    "category": "explicitly_excluded_or_recovered",
                    "count": terminal_excluded,
                    "lineage_pointers": closure_pointers,
                }),
                "explicitly_excluded_or_recovered_lineage_pointers": closure_pointers,
                "nonmember_or_stale_feedback_pointers": sorted({
                    str(item)
                    for item in existing_scope.get("nonmember_or_stale_feedback_pointers", [])
                    if str(item)
                }),
                "accounted_scope_count": baseline_count,
                "live_registry_available": (self.state_dir / "users.registry").exists(),
                "raw_user_list_stored": False,
                "scope_membership_law": "INTENT_CLOSED_TERMINAL_SCOPE_FROZEN",
                "terminal_scope_frozen": True,
            }

        live_registry_available = (self.state_dir / "users.registry").exists()
        live_rows = parse_registry(self.state_dir / "users.registry") if live_registry_available else []
        live_current = {
            str(item.get("ip") or ""): str(item.get("current") or "")
            for item in live_rows
            if str(item.get("ip") or "") and (
                not str(item.get("enabled") or "") or bool_value(item.get("enabled"))
            )
        }
        protected_users: set[str] = set()
        excluded_users: set[str] = set()
        protected_pointers: set[str] = set()
        excluded_pointers: set[str] = set()
        rejected_feedback_ids: set[str] = set()
        for feedback_row in execution_rows:
            binding = self._effective_service_failure_causal_binding(feedback_row)
            if str(binding.get("source_incident_id") or "") != source_incident_id:
                continue
            verification = feedback_row.get("verification_result")
            verification = verification if isinstance(verification, dict) else {}
            if str(feedback_row.get("terminal_outcome_classification") or "") != "SUCCESS" or verification.get("success") is not True:
                continue
            feedback_id = str(feedback_row.get("feedback_id") or feedback_row.get("object_id") or "")
            scope = binding.get("source_scope")
            scope = scope if isinstance(scope, dict) else {}
            scope_matches = (
                str(scope.get("source_channel") or "") == source_channel
                and to_int(scope.get("affected_scope_count"), -1) == baseline_count
                and str(scope.get("affected_scope_fingerprint") or "") == baseline_fingerprint
            )
            if not scope_matches:
                if feedback_id:
                    rejected_feedback_ids.add(feedback_id)
                continue
            user = str(feedback_row.get("user") or "")
            target = str(feedback_row.get("target_channel") or "")
            current = str(live_current.get(user) or "")
            if user and target and current == target:
                protected_users.add(user)
                if feedback_id:
                    protected_pointers.add(feedback_id)
            elif user and current and current != source_channel:
                # Route truth says this bounded member left the failed source,
                # but not through the packet's verified target.  Preserve it as
                # an explicit, non-protection closure rather than guessing.
                excluded_users.add(user)
                if feedback_id:
                    excluded_pointers.add(feedback_id)

        unresolved_users = {
            user for user, current in live_current.items() if current == source_channel
        } if live_registry_available else set()
        # Categories are disjoint by construction: a user on source is
        # unresolved; a matching target is protected; another live route is
        # explicitly excluded/recovered only with exact packet lineage.
        protected_users -= unresolved_users
        excluded_users -= unresolved_users | protected_users
        accounted = len(protected_users) + len(unresolved_users) + len(excluded_users)
        valid = live_registry_available and baseline_count == accounted
        return {
            "schema_version": "v7.service-failure-incident-scope-accounting.v2",
            "status": "ACCOUNTED" if valid else "INCIDENT_SCOPE_ACCOUNTING_BROKEN",
            "baseline_event_id": str(existing_scope.get("baseline_event_id") or ""),
            "baseline_observed_at": str(existing_scope.get("baseline_observed_at") or ""),
            "affected_scope_count": baseline_count,
            "affected_scope_fingerprint": baseline_fingerprint,
            "protected_scope_count": len(protected_users),
            "protected_scope_fingerprint": sha256_json({"incident": source_incident_id, "users": sorted(protected_users)}),
            "protected_scope_lineage_pointers": sorted(protected_pointers),
            "unresolved_scope_count": len(unresolved_users),
            "unresolved_scope_fingerprint": sha256_json({"incident": source_incident_id, "users": sorted(unresolved_users)}),
            "unresolved_scope_route_truth_owner": "state/users.registry",
            "explicitly_excluded_or_recovered_scope_count": len(excluded_users),
            "explicitly_excluded_or_recovered_scope_fingerprint": sha256_json({"incident": source_incident_id, "users": sorted(excluded_users)}),
            "explicitly_excluded_or_recovered_lineage_pointers": sorted(excluded_pointers),
            "nonmember_or_stale_feedback_pointers": sorted(rejected_feedback_ids),
            "accounted_scope_count": accounted,
            "live_registry_available": live_registry_available,
            "raw_user_list_stored": False,
            "scope_membership_law": "EXACT_SOURCE_SCOPE_FINGERPRINT_AND_CURRENT_ROUTE",
        }

    def _reconcile_incident_cumulative_scope(
        self,
        *,
        existing: dict[str, Any],
        execution_rows: list[dict[str, Any]],
        current_source_scope: Optional[dict[str, Any]] = None,
    ) -> dict[str, Any]:
        """Preserve packet-bound history without altering the live denominator.

        The existing immutable execution owner keeps full packet evidence.  The
        L3 incident record stores only a compact, deduplicated classification
        and lineage pointer per feedback.  In particular, an older success
        does not decrement ``current_source_scope`` unless that scope's exact
        fingerprint says it is a member.
        """
        source_incident_id = str(existing.get("source_incident_id") or existing.get("incident_id") or "")
        source_channel = str(existing.get("channel") or existing.get("source_channel") or "")
        current_scope = current_source_scope if isinstance(current_source_scope, dict) else (
            existing.get("current_source_scope")
            if isinstance(existing.get("current_source_scope"), dict)
            else (existing.get("scope_accounting") if isinstance(existing.get("scope_accounting"), dict) else {})
        )
        if not source_incident_id or not source_channel:
            return {}
        live_rows = parse_registry(self.state_dir / "users.registry") if (self.state_dir / "users.registry").exists() else []
        live_current = {
            str(item.get("ip") or ""): str(item.get("current") or "")
            for item in live_rows
            if str(item.get("ip") or "") and (not str(item.get("enabled") or "") or bool_value(item.get("enabled")))
        }
        baseline_count = to_int(current_scope.get("affected_scope_count"), -1)
        baseline_fingerprint = str(current_scope.get("affected_scope_fingerprint") or "")
        entries: list[dict[str, Any]] = []
        seen_feedback: set[str] = set()
        for row in execution_rows:
            if str(row.get("schema_version") or "") != "v7.execution-outcome-record.v1":
                continue
            terminal = str(row.get("terminal_outcome_classification") or "")
            verification = row.get("verification_result") if isinstance(row.get("verification_result"), dict) else {}
            if terminal not in {"SUCCESS", "ROLLBACK_SUCCESS"} or (terminal == "SUCCESS" and verification.get("success") is not True):
                continue
            feedback_id = str(row.get("feedback_id") or row.get("object_id") or "")
            if not feedback_id or feedback_id in seen_feedback:
                continue
            binding = self._effective_service_failure_causal_binding(row)
            bound_incident = str(binding.get("source_incident_id") or "")
            # Retain an unbound historical move from the same failed source as
            # an explicit *missing-binding* fact, never as incident membership.
            # A differently-bound event is retained only if an earlier compact
            # projection already linked it; scanning all VLESS history into
            # every active incident would violate bounded storage semantics.
            same_source = str(row.get("source_channel") or "") == source_channel
            prior = existing.get("incident_cumulative_scope") if isinstance(existing.get("incident_cumulative_scope"), dict) else {}
            prior_entries = prior.get("entries") if isinstance(prior.get("entries"), list) else []
            prior_known = any(isinstance(item, dict) and str(item.get("feedback_id") or "") == feedback_id for item in prior_entries)
            if bound_incident and bound_incident != source_incident_id:
                include = prior_known
            else:
                include = bound_incident == source_incident_id or (not bound_incident and same_source)
            if not include:
                continue
            user = str(row.get("user") or "")
            target = str(row.get("target_channel") or "")
            current = str(live_current.get(user) or "")
            scope = binding.get("source_scope") if isinstance(binding.get("source_scope"), dict) else {}
            exact_current_member = (
                bound_incident == source_incident_id
                and str(scope.get("source_channel") or "") == source_channel
                and to_int(scope.get("affected_scope_count"), -1) == baseline_count
                and str(scope.get("affected_scope_fingerprint") or "") == baseline_fingerprint
            )
            if bound_incident and bound_incident != source_incident_id:
                classification = "OTHER_INCIDENT"
            elif bound_incident != source_incident_id:
                classification = "HISTORICAL_MOVED_INCIDENT_BINDING_MISSING"
            elif current == source_channel:
                classification = "RETURNED_TO_SOURCE"
            elif exact_current_member and target and current == target:
                classification = "CURRENT_INCIDENT_PROTECTED"
            elif current and current != source_channel:
                classification = "HISTORICAL_PROTECTED_PRE_BASELINE"
            else:
                classification = "RECOVERED_OR_EXCLUDED"
            entries.append({
                "feedback_id": feedback_id,
                "packet_id": str(row.get("packet_id") or ""),
                "learning_id": str(((row.get("learning_record") or {}).get("learning_record_id") or "")),
                "classification": classification,
                "user_fingerprint": sha256_json({"incident": source_incident_id, "user": user}),
                "source_scope_fingerprint": str(scope.get("affected_scope_fingerprint") or ""),
                "current_route_matches_packet_target": bool(target and current == target),
            })
            seen_feedback.add(feedback_id)
        entries.sort(key=lambda item: str(item.get("feedback_id") or ""))
        classification_counts = {
            name: sum(1 for item in entries if item.get("classification") == name)
            for name in (
                "CURRENT_INCIDENT_PROTECTED", "HISTORICAL_PROTECTED_PRE_BASELINE",
                "HISTORICAL_MOVED_INCIDENT_BINDING_MISSING", "RETURNED_TO_SOURCE",
                "RECOVERED_OR_EXCLUDED", "OTHER_INCIDENT",
            )
        }
        return {
            "schema_version": "v7.service-failure-incident-cumulative-scope.v1",
            "status": "LINEAGE_RECONCILED" if entries else "NO_PACKET_BOUND_LINEAGE_YET",
            "source_incident_id": source_incident_id,
            "current_source_scope_fingerprint": baseline_fingerprint,
            "current_source_scope_count": baseline_count,
            "packet_bound_success_count": len(entries),
            "classification_counts": classification_counts,
            "entries": entries,
            "lineage_pointers": [item["feedback_id"] for item in entries],
            "membership_basis": "PACKET_BOUND_CAUSAL_BINDING_AND_CURRENT_ROUTE_ONLY",
            "cumulative_count_semantics": "PROVABLE_PACKET_BOUND_SUBSET_NOT_A_CURRENT_SOURCE_DENOMINATOR",
            "raw_user_list_stored": False,
        }

    def reconcile_service_failure_execution_outcomes(self) -> dict[str, Any]:
        """Consume exact packet-bound execution feedback into the same L3 incident state.

        The feedback, packet and incident already have owners.  This method is
        only their compact-state consumer: it refuses timing-based inference,
        creates no execution artefact and keeps a partially protected channel
        incident open for its remaining scope.
        """
        state = self._load_l3_runtime_state()
        incidents = state.get("incidents") if isinstance(state.get("incidents"), dict) else {}
        rows = read_jsonl(self.state_dir / "execution-events.jsonl")
        changed = 0
        consumed = 0
        rejected: list[str] = []
        for row in rows:
            if str(row.get("schema_version") or "") != "v7.execution-outcome-record.v1":
                continue
            binding = self._effective_service_failure_causal_binding(row)
            if not binding:
                continue
            source_incident_id = str(binding.get("source_incident_id") or "")
            source_event_id = str(binding.get("source_event_id") or "")
            source_channel = str(binding.get("source_channel") or "")
            event_type = str(binding.get("event_type") or "")
            feedback_id = str(row.get("feedback_id") or row.get("object_id") or "")
            if not all((source_incident_id, source_event_id, source_channel, feedback_id)):
                rejected.append("execution_feedback_causal_binding_identity_missing")
                continue
            if event_type not in {"SERVICE_FAILURE_OBSERVED", "SERVICE_FAILURE_REVALIDATED"}:
                rejected.append("execution_feedback_causal_binding_event_type_invalid")
                continue
            if str(row.get("source_channel") or "") != source_channel:
                rejected.append("execution_feedback_causal_binding_source_mismatch")
                continue
            incident_key = self._passive_incident_projection_key(source_incident_id)
            existing = incidents.get(incident_key) if isinstance(incidents.get(incident_key), dict) else {}
            if not existing:
                rejected.append("execution_feedback_parent_incident_projection_missing")
                continue
            consumed_feedback_ids = {
                str(item) for item in (existing.get("execution_feedback_ids") or []) if str(item)
            }
            if feedback_id in consumed_feedback_ids:
                consumed += 1
                continue
            terminal = str(row.get("terminal_outcome_classification") or "UNKNOWN")
            verification = row.get("verification_result") if isinstance(row.get("verification_result"), dict) else {}
            success = terminal == "SUCCESS" and verification.get("success") is True
            rollback_success = terminal == "ROLLBACK_SUCCESS"
            if not (success or rollback_success):
                rejected.append("execution_feedback_terminal_not_consumable")
                continue
            user = str(row.get("user") or "")
            user_fingerprint = sha256_json({"incident": source_incident_id, "user": user})
            existing_scope = existing.get("current_source_scope") if isinstance(existing.get("current_source_scope"), dict) else (existing.get("scope_accounting") if isinstance(existing.get("scope_accounting"), dict) else {})
            scope_accounting = self._reconcile_incident_scope_accounting(
                existing=existing,
                execution_rows=rows,
            )
            cumulative_scope = self._reconcile_incident_cumulative_scope(
                existing=existing,
                execution_rows=rows,
                current_source_scope=scope_accounting or existing_scope,
            )
            lineage = dict(existing.get("causal_lineage") or {})
            lineage.update({
                "source_incident_id": source_incident_id,
                "source_event_ids": sorted({
                    *[str(item) for item in (binding.get("source_event_ids") or []) if str(item)],
                    source_event_id,
                }),
                "execution_feedback_id": feedback_id,
                "packet_id": str(row.get("packet_id") or ""),
                "execution_decision_trace_id": str(row.get("decision_trace_id") or ""),
                "learning_id": str(((row.get("learning_record") or {}).get("learning_record_id") or existing.get("learning_id") or "")),
            })
            desired = {
                **existing,
                "status": "PARTIALLY_PROTECTED",
                "incident_state": "PARTIALLY_PROTECTED",
                "channel_incident_state": "OPEN",
                "attempt_terminal": terminal,
                "attempt_id": str(row.get("closure_reference") or row.get("operation_id") or feedback_id),
                "packet_id": str(row.get("packet_id") or ""),
                "outcome_id": feedback_id,
                "learning_id": lineage["learning_id"],
                "last_execution_feedback_id": feedback_id,
                "execution_feedback_ids": sorted({*consumed_feedback_ids, feedback_id})[-500:],
                "last_observed_at": str(row.get("outcome_observed_at") or row.get("created_at") or now_iso()),
                "cohort_protection_intent": {
                    **(existing.get("cohort_protection_intent") if isinstance(existing.get("cohort_protection_intent"), dict) else {}),
                    "state": "PARTIALLY_PROTECTED",
                    "partial_scope_reason": "ONE_PACKET_BOUND_USER_PROTECTED; remaining cohort remains open",
                },
                "user_protection_intent": {
                    "state": "INTENT_CLOSED",
                    "scope_type": "USER",
                    "scope_fingerprint": user_fingerprint,
                    "intent_closure_reason": "PACKET_BOUND_EXECUTION_SUCCESS" if success else "PACKET_BOUND_ROLLBACK_SUCCESS",
                    "intent_closure_evidence_pointer": feedback_id,
                    "raw_user_list_stored": False,
                },
                "scope_accounting": scope_accounting or existing_scope,
                "current_source_scope": scope_accounting or existing_scope,
                "incident_cumulative_scope": cumulative_scope,
                "next_required_consumer": (
                    "tools/v7-users-autoswitch.reconcile_service_failure_execution_outcomes"
                    if scope_accounting and scope_accounting.get("status") == "INCIDENT_SCOPE_ACCOUNTING_BROKEN"
                    else "tools/v7-users-autoswitch.reconcile_service_failure_shadow_outcomes"
                ),
                "reentry_condition": (
                    "existing Matrix producer must provide a fresh compact source-scope snapshot before another action"
                    if scope_accounting and scope_accounting.get("status") == "INCIDENT_SCOPE_ACCOUNTING_BROKEN"
                    else "existing shadow/outcome consumer consumes exact packet-bound feedback; remaining channel scope continues on fresh owner-backed observation"
                ),
                "causal_lineage": lineage,
                "causal_invariant": {
                    "name": "OPEN_INCIDENT_REQUIRES_SUCCESSOR_AND_REENTRY",
                    "valid": True,
                },
                "execution_performed": True,
                "runtime_mutation_performed": True,
                "routing_mutation_performed": True,
                "users_moved": 1,
                "apply_executed": True,
                "authority_expanded": False,
                "production_maturity_changed": False,
                "consumer": "tools/v7-users-autoswitch.reconcile_service_failure_execution_outcomes",
            }
            if scope_accounting:
                desired.update({
                    "affected_scope_count": scope_accounting["affected_scope_count"],
                    "affected_scope_fingerprint": scope_accounting["affected_scope_fingerprint"],
                    "protected_scope_count": scope_accounting["protected_scope_count"],
                    "protected_scope_fingerprint": scope_accounting["protected_scope_fingerprint"],
                    "unresolved_scope_count": scope_accounting["unresolved_scope_count"],
                    "unresolved_scope_fingerprint": scope_accounting["unresolved_scope_fingerprint"],
                })
            incidents[incident_key] = desired
            changed += 1
            consumed += 1
        # Scope truth is a live-route projection, not a side effect of the
        # first feedback consumer.  Recompute it even when every immutable
        # feedback id was already consumed; otherwise a generation-local
        # result can remain stale forever after a deploy or a route change.
        for incident_key, record in list(incidents.items()):
            if not isinstance(record, dict):
                continue
            scope_accounting = self._reconcile_incident_scope_accounting(
                existing=record,
                execution_rows=rows,
            )
            if not scope_accounting:
                continue
            desired_scope_fields = {
                "scope_accounting": scope_accounting,
                "current_source_scope": scope_accounting,
                "incident_cumulative_scope": self._reconcile_incident_cumulative_scope(
                    existing=record,
                    execution_rows=rows,
                    current_source_scope=scope_accounting,
                ),
                "affected_scope_count": scope_accounting["affected_scope_count"],
                "affected_scope_fingerprint": scope_accounting["affected_scope_fingerprint"],
                "protected_scope_count": scope_accounting["protected_scope_count"],
                "protected_scope_fingerprint": scope_accounting["protected_scope_fingerprint"],
                "unresolved_scope_count": scope_accounting["unresolved_scope_count"],
                "unresolved_scope_fingerprint": scope_accounting["unresolved_scope_fingerprint"],
            }
            if scope_accounting.get("status") == "INCIDENT_SCOPE_ACCOUNTING_BROKEN":
                desired_scope_fields.update({
                    "next_required_consumer": "tools/v7-users-autoswitch.reconcile_service_failure_execution_outcomes",
                    "reentry_condition": "reconcile exact source-scope fingerprint with current route truth before any further action",
                })
            if any(record.get(key) != value for key, value in desired_scope_fields.items()):
                incidents[incident_key] = {**record, **desired_scope_fields}
                changed += 1
        if changed:
            state["incidents"] = incidents
            self._write_l3_runtime_state(state)
        return {
            "schema_version": "v7.service-failure-execution-outcome-reconciliation.v1",
            "active": bool(rows),
            "consumed_records": consumed,
            "changed_records": changed,
            "rejected_records": sorted(set(rejected)),
            "final_verdict": "PASS" if not rejected else "STOP_SAFE",
            "forbidden_effects": {
                "candidate_created": False, "packet_created": False, "lease_created": False,
                "runtime_apply": False, "routing_mutation": False, "user_movement": 0,
                "rollback_apply": False, "authority_change": False, "production_maturity_change": False,
            },
        }

    def _l3_incident_attempt_count(self, incident_key: str) -> int:
        incidents = self.l3_runtime_state.get("incidents") if isinstance(self.l3_runtime_state.get("incidents"), dict) else {}
        incident = incidents.get(incident_key) if isinstance(incidents.get(incident_key), dict) else {}
        return len([
            row
            for row in (incident.get("attempts") or [])
            if isinstance(row, dict) and self._l3_attempt_consumed_retry_budget(row)
        ])

    @staticmethod
    def _l3_attempt_consumed_retry_budget(row: dict[str, Any]) -> bool:
        terminal_state = str(row.get("terminal_state") or "")
        terminal_outcome = str(row.get("terminal_outcome") or "")
        return bool_value(row.get("applied")) or terminal_state in {
            "APPLIED",
            "ROLLED_BACK",
            "ROLLBACK_FAILED",
            "VERIFY_FAILED",
            "FAILED",
        } or terminal_outcome in {
            "SUCCESS",
            "ROLLBACK_SUCCESS",
            "ROLLBACK_FAILURE",
            "APPLY_FAILURE",
            "VERIFY_FAILED",
        }

    @staticmethod
    def _l3_semantic_attempt_signature(
        moves: list[dict[str, Any]],
        *,
        incident_key: str,
    ) -> str:
        if not incident_key or not moves:
            return ""
        return sha256_json([
            {
                "user_ip": str(move.get("user_ip") or ""),
                "from": str(move.get("current_egress") or ""),
                "to": str(move.get("recommended_egress") or ""),
                "move_type": str(move.get("move_type") or ""),
                "incident_key": incident_key,
            }
            for move in moves
        ])

    def _l3_consumed_retry_attempts(
        self,
        *,
        incident_key: str,
        semantic_attempt_signature: str,
    ) -> list[dict[str, Any]]:
        if not incident_key or not semantic_attempt_signature:
            return []
        incidents = self.l3_runtime_state.get("incidents") if isinstance(self.l3_runtime_state.get("incidents"), dict) else {}
        incident = incidents.get(incident_key) if isinstance(incidents.get(incident_key), dict) else {}
        return [
            row
            for row in (incident.get("attempts") or [])
            if isinstance(row, dict)
            and self._l3_attempt_consumed_retry_budget(row)
            and str(row.get("semantic_attempt_signature") or "") == semantic_attempt_signature
        ]

    def _l3_retry_budget_exhausted_for_move(
        self,
        move: dict[str, Any],
        *,
        target: str,
        incident_source_context: dict[str, Any],
        retry_budget_per_incident: int,
    ) -> dict[str, Any]:
        incident_key = str(incident_source_context.get("incident_key") or "")
        incident_source = str(incident_source_context.get("incident_source") or "")
        if (
            not bool_value(incident_source_context.get("active"))
            or not incident_key
            or not incident_source
            or str(move.get("current_egress") or "") != incident_source
        ):
            return {"exhausted": False}
        candidate = dict(move)
        candidate["recommended_egress"] = target
        signature = self._l3_semantic_attempt_signature([candidate], incident_key=incident_key)
        consumed = self._l3_consumed_retry_attempts(
            incident_key=incident_key,
            semantic_attempt_signature=signature,
        )
        exhausted = bool(consumed) and len(consumed) >= max(0, retry_budget_per_incident)
        return {
            "exhausted": exhausted,
            "incident_key": incident_key,
            "incident_source": incident_source,
            "semantic_attempt_signature": signature,
            "consumed_attempts": len(consumed),
            "retry_budget_per_incident": max(0, retry_budget_per_incident),
            "user_ip": str(candidate.get("user_ip") or ""),
            "current_egress": str(candidate.get("current_egress") or ""),
            "recommended_egress": target,
        }

    def _l3_enabled_users_on_source(self, source: str, *, excluding_users: Optional[set[str]] = None) -> list[str]:
        excluded = excluding_users or set()
        return sorted(
            user.ip
            for user in self.users
            if user.enabled and str(user.current) == source and user.ip not in excluded
        )

    def _l3_required_service_failures_for_source(self, source: str, *, required_services: Optional[list[str]] = None) -> list[dict[str, Any]]:
        matrix_items = self.matrix.get("items") if isinstance(self.matrix.get("items"), dict) else {}
        item = matrix_items.get(source) if isinstance(matrix_items.get(source), dict) else {}
        services = item.get("services") if isinstance(item.get("services"), dict) else {}
        failures: list[dict[str, Any]] = []
        service_ids = normalize_service_ids(required_services or self._required_services())
        if not service_ids:
            service_ids = sorted(str(service) for service in services.keys() if str(service))
        for service in service_ids:
            row = services.get(service) if isinstance(services.get(service), dict) else {}
            status = str(row.get("status") or "").upper()
            truth_class = str(row.get("truth_class") or "")
            failure_samples = self._service_failure_count(row)
            bad_for_seconds = to_float(row.get("bad_for_seconds") or row.get("failed_for_seconds"))
            persistent = (
                truth_class == "PERSISTENT_FAIL"
                or failure_samples >= max(1, to_int(self.service_signal_policy.get("service_failure_persistence_samples"), 3))
                or bad_for_seconds >= max(1, to_int(self.service_signal_policy.get("service_failure_persistence_window_seconds"), 180))
            )
            failed = row.get("ok") is False or row.get("available") is False or status in {"DOWN", "FAIL", "ERROR", "NOT_STARTED"}
            # A source incident must be backed by a durable episode, not a
            # single reset/timeout observed by an otherwise fresh probe.
            if failed and persistent:
                failures.append({
                    "service": service,
                    "status": status or str(row.get("status") or ""),
                    "truth_class": "PERSISTENT_FAIL",
                    "failure_episode_id": str(row.get("failure_episode_id") or ""),
                    "failure_samples": failure_samples,
                    "bad_for_seconds": bad_for_seconds,
                    "observed_at": str(row.get("observed_at") or row.get("tested_at") or ""),
                    "probe_provenance": str(row.get("probe_provenance") or "SERVICE_PROBE_OBSERVED"),
                    "probe_classification": str(row.get("probe_classification") or "FAILURE"),
                    "source_object": "service-matrix.json:items[].services",
                })
        return failures

    def _l3_failed_source_scope(
        self,
        source: str,
        *,
        excluding_users: Optional[set[str]] = None,
        required_services: Optional[list[str]] = None,
    ) -> dict[str, Any]:
        egress = self.egress.get(source)
        affected_users = self._l3_enabled_users_on_source(source, excluding_users=excluding_users)
        severity = str((egress.severity if egress else "") or "").upper()
        diagnose_reason = str((egress.diagnose_reason if egress else "") or "")
        enabled = bool(egress and egress.enabled and str(egress.state).lower() not in {"disabled", "down"})
        controlled_failure = self._controlled_certification_failure_context(source)
        channel_failed = enabled and severity == "FAIL" and bool(affected_users)
        service_failures = self._l3_required_service_failures_for_source(source, required_services=required_services)
        service_failed = enabled and bool(service_failures) and bool(affected_users)
        controlled_channel_failed = bool_value(controlled_failure.get("confirmed"))
        return {
            "schema_version": "v7.l3-incident-source-scope.v1",
            "source": source,
            "enabled": enabled,
            "affected_users": affected_users,
            "affected_users_count": len(affected_users),
            "source_failed": channel_failed or service_failed or controlled_channel_failed,
            "current_channel_failure": channel_failed or controlled_channel_failed,
            "required_service_failure": service_failed,
            "diagnose_severity": severity,
            "diagnose_reason": diagnose_reason,
            "controlled_certification_failure": controlled_failure,
            "required_service_failures": service_failures,
            "owner": "tools/v7-users-autoswitch",
            "source_objects": [
                "l3-runtime-state.json:incidents[].failed_sources",
                "users.registry",
                "v7-state.json",
                "service-matrix.json",
            ],
        }

    def _l3_active_incident_source_context(self) -> dict[str, Any]:
        incidents = self.l3_runtime_state.get("incidents") if isinstance(self.l3_runtime_state.get("incidents"), dict) else {}
        active_statuses = {"OPEN", "READY_FOR_EXECUTION", "INCIDENT_OPEN_STOP_SAFE", "STOP_SAFE", "SUSPENDED"}
        candidates: list[dict[str, Any]] = []
        emergency_enabled = bool_value(self.emergency_failover_policy.get("enabled"))
        for incident_key, row in incidents.items():
            if not isinstance(row, dict):
                continue
            if str(row.get("authority_object") or "") != "EMERGENCY_FAILOVER_AUTONOMY":
                continue
            if str(row.get("status") or "") not in active_statuses:
                continue
            sources = [
                str(item)
                for item in (row.get("failed_sources") or ([row.get("incident_source")] if row.get("incident_source") else []))
                if str(item)
            ]
            for source in sorted(set(sources)):
                scope = self._l3_failed_source_scope(source, required_services=list(row.get("failed_required_services") or []))
                if not bool_value(scope.get("source_failed")):
                    continue
                candidates.append({
                    "incident_key": str(row.get("incident_key") or incident_key),
                    "incident_source": source,
                    "status": str(row.get("status") or ""),
                    "updated_at": str(row.get("updated_at") or ""),
                    "opened_at": str(row.get("opened_at") or ""),
                    "failed_required_services": list(row.get("failed_required_services") or []),
                    "scope": scope,
                    "producer": "tools/v7-users-autoswitch._l3_close_incident_and_update_capability",
                    "consumer": "tools/v7-users-autoswitch.plan",
                    "owner": "tools/v7-users-autoswitch",
                    "reason": "active_failed_source_incident",
                    "continuity_source": "persisted_incident",
                })
        if emergency_enabled:
            observed_sources = sorted({
                str(user.current)
                for user in self.users
                if user.enabled and str(user.current or "")
            })
            persisted_sources = {str(item.get("incident_source") or "") for item in candidates}
            for source in observed_sources:
                if source in persisted_sources:
                    continue
                scope = self._l3_failed_source_scope(source)
                if not bool_value(scope.get("source_failed")):
                    continue
                observed_at = now_iso()
                candidates.append({
                    "incident_key": "",
                    "incident_source": source,
                    "status": "OBSERVED",
                    "updated_at": observed_at,
                    "opened_at": observed_at,
                    "failed_required_services": [],
                    "scope": scope,
                    "producer": "tools/v7-users-autoswitch._l3_failed_source_scope",
                    "consumer": "tools/v7-users-autoswitch.plan",
                    "owner": "tools/v7-users-autoswitch",
                    "reason": "confirmed_failed_source_observation_with_affected_users",
                    "continuity_source": "confirmed_observation",
                })
        if not candidates:
            if not emergency_enabled:
                return {
                    "schema_version": "v7.l3-incident-source-continuity.v1",
                    "active": False,
                    "reason": "emergency_failover_autonomy_not_enabled",
                }
            return {
                "schema_version": "v7.l3-incident-source-continuity.v1",
                "active": False,
                "reason": "no_active_failed_source_incident",
            }
        candidates.sort(
            key=lambda item: (
                1 if bool_value((item.get("scope") or {}).get("current_channel_failure")) else 0,
                to_int((item.get("scope") or {}).get("affected_users_count"), 0),
                1 if bool_value((item.get("scope") or {}).get("required_service_failure")) else 0,
                1 if str(item.get("continuity_source") or "") == "persisted_incident" else 0,
                parse_ts(item.get("updated_at")) or 0,
                str(item.get("incident_source") or ""),
            ),
            reverse=True,
        )
        selected = candidates[0]
        return {
            "schema_version": "v7.l3-incident-source-continuity.v1",
            "active": True,
            "reason": str(selected.get("reason") or "active_failed_source_incident"),
            "incident_key": selected["incident_key"],
            "incident_source": selected["incident_source"],
            "incident_status": selected["status"],
            "failed_required_services": selected["failed_required_services"],
            "affected_users": list((selected.get("scope") or {}).get("affected_users") or []),
            "affected_users_count": to_int((selected.get("scope") or {}).get("affected_users_count"), 0),
            "scope": selected["scope"],
            "continuity_source": str(selected.get("continuity_source") or ""),
            "producer": selected["producer"],
            "consumer": selected["consumer"],
            "owner": selected["owner"],
        }

    def _l3_failed_source_cooldown_override_context(self, user_ip: str, current_egress: str) -> dict[str, Any]:
        context = self._l3_active_incident_source_context()
        requested_source = str(getattr(self.args, "source_egress", "") or "").strip()
        existing_scope = context.get("scope") if isinstance(context.get("scope"), dict) else {}
        if (
            requested_source
            and (
                not bool_value(context.get("active"))
                or str(context.get("incident_source") or "") != requested_source
                or not bool_value(existing_scope.get("source_failed"))
            )
        ):
            requested_scope = self._l3_failed_source_scope(requested_source)
            if bool_value(requested_scope.get("source_failed")):
                context = {
                    "schema_version": "v7.l3-incident-source-continuity.v1",
                    "active": True,
                    "reason": "requested_failed_source_scope",
                    "incident_key": "",
                    "incident_source": requested_source,
                    "incident_status": "OBSERVED",
                    "failed_required_services": list(requested_scope.get("required_service_failures") or []),
                    "affected_users": list(requested_scope.get("affected_users") or []),
                    "affected_users_count": to_int(requested_scope.get("affected_users_count"), 0),
                    "scope": requested_scope,
                    "continuity_source": "requested_source_egress",
                    "producer": "tools/v7-users-autoswitch._l3_failed_source_cooldown_override_context",
                    "consumer": "tools/v7-users-autoswitch._decision_for_user",
                    "owner": "tools/v7-users-autoswitch",
                }
        incident_source = str(context.get("incident_source") or "")
        affected_users = {str(item) for item in (context.get("affected_users") or []) if str(item)}
        scope = context.get("scope") if isinstance(context.get("scope"), dict) else {}
        continuity_source = str(context.get("continuity_source") or "")
        controlled_failure = scope.get("controlled_certification_failure") if isinstance(scope.get("controlled_certification_failure"), dict) else {}
        cooldown_override_source_allowed = (
            continuity_source in {"persisted_incident", "requested_source_egress"}
            or (continuity_source == "confirmed_observation" and bool_value(controlled_failure.get("confirmed")))
        )
        allowed = (
            bool_value(context.get("active"))
            and cooldown_override_source_allowed
            and bool_value(scope.get("source_failed"))
            and incident_source
            and str(current_egress or "") == incident_source
            and (not affected_users or str(user_ip or "") in affected_users)
        )
        if not allowed:
            return {
                "allowed": False,
                "reason": "not_active_failed_source_incident_user",
                "incident_source": incident_source,
            }
        return {
            "schema_version": "v7.l3-failed-source-cooldown-override.v1",
            "allowed": True,
            "reason": "active_failed_source_incident_evacuation",
            "incident_key": str(context.get("incident_key") or ""),
            "incident_source": incident_source,
            "user_ip": str(user_ip or ""),
            "scope_source_failed": bool_value(scope.get("source_failed")),
            "current_channel_failure": bool_value(scope.get("current_channel_failure")),
            "required_service_failure": bool_value(scope.get("required_service_failure")),
            "owner": "tools/v7-users-autoswitch",
            "producer": "tools/v7-users-autoswitch._l3_active_incident_source_context",
            "consumer": "tools/v7-users-autoswitch._decision_for_user/_emergency_failover_move_evidence",
        }

    def _l3_external_wake_events(self, *, late_window_seconds: int) -> list[dict[str, Any]]:
        rows: list[dict[str, Any]] = []
        paths = [
            self.event_dir / "l3-wake-events.jsonl",
            self.event_dir / "service-failure-events.jsonl",
            self.event_dir / "runtime-wake-events.jsonl",
        ]
        now = time.time()
        for path in paths:
            for event in read_jsonl(path)[-200:]:
                source = self._l3_normalized_wake_source(
                    event.get("wake_source")
                    or event.get("source")
                    or event.get("event_type")
                    or event.get("reason")
                )
                if not source:
                    continue
                ts_value = event.get("ts") or event.get("observed_at") or event.get("updated") or event.get("created_at")
                event_ts = parse_ts(ts_value)
                late = bool(event_ts and late_window_seconds > 0 and now - event_ts > late_window_seconds)
                channel = str(event.get("current_egress") or event.get("egress") or event.get("channel") or "")
                service = str(event.get("service") or event.get("required_service") or "")
                event_id = str(event.get("event_id") or event.get("id") or "")
                if not event_id:
                    event_id = sha256_json({
                        "source": source,
                        "channel": channel,
                        "service": service,
                        "ts": str(ts_value or ""),
                        "path": str(path.name),
                    })[:24]
                rows.append({
                    "event_id": event_id,
                    "wake_source": source,
                    "channel": channel,
                    "service": service,
                    "late": late,
                    "path": str(path),
                    "ts": str(ts_value or ""),
                    "consumed_by_runtime": False,
                })
        return rows

    def _authority_promotion_truth_check(self) -> dict[str, Any]:
        command = str(getattr(self.args, "authority_promotion_truth_check_command", "") or "v7-truth-check")
        result = {
            "command": command,
            "required": True,
            "returncode": None,
            "passed": False,
            "stdout_tail": "",
            "error": "",
        }
        try:
            proc = subprocess.run(
                [command, "--all", "--json"],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=30,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            result["error"] = str(exc)
            return result
        output = proc.stdout or ""
        result["returncode"] = proc.returncode
        result["stdout_tail"] = output[-2000:]
        parsed: Any = {}
        try:
            parsed = json.loads(output)
        except json.JSONDecodeError:
            parsed = {}
        json_text = json.dumps(parsed, ensure_ascii=False, sort_keys=True) if isinstance(parsed, dict) else output
        result["passed"] = proc.returncode == 0 and (
            "FULLY_ALIGNED" in output
            or '"PASS"' in json_text
            or '"pass"' in json_text.lower()
            or '"PASSED"' in json_text
        )
        if not result["passed"]:
            fallback = self._authority_promotion_runtime_fingerprint_check()
            result["runtime_fingerprint_fallback"] = fallback
            result["passed"] = bool(fallback.get("passed"))
        return result

    def _authority_promotion_runtime_fingerprint_check(self) -> dict[str, Any]:
        fingerprint_path = Path("/opt/v7/runtime-fingerprint.json")
        fingerprint = read_json(fingerprint_path, {})
        rows = fingerprint.get("critical_files") if isinstance(fingerprint, dict) else []
        target_path = "/usr/local/bin/v7-users-autoswitch"
        expected = ""
        if isinstance(rows, list):
            for row in rows:
                if isinstance(row, dict) and row.get("remote_path") == target_path:
                    expected = str(row.get("sha256") or "")
                    break
        actual = sha256_file(Path(target_path))
        passed = bool(
            expected
            and actual
            and expected == actual
            and str(fingerprint.get("commit") or "")
            and str(fingerprint.get("branch") or "")
        )
        return {
            "schema_version": "v7.authority-promotion-runtime-fingerprint-check.v1",
            "fingerprint_path": str(fingerprint_path),
            "branch": str(fingerprint.get("branch") or "") if isinstance(fingerprint, dict) else "",
            "commit": str(fingerprint.get("commit") or "") if isinstance(fingerprint, dict) else "",
            "target_path": target_path,
            "expected_sha256": expected,
            "actual_sha256": actual,
            "passed": passed,
            "truth_source": "existing_safe_deploy_runtime_fingerprint",
        }

    def _emergency_failover_authority_gate(
        self,
        selected: list[dict[str, Any]],
        restore_barrier: dict[str, Any],
        *,
        evidence_candidates: Optional[list[dict[str, Any]]] = None,
    ) -> tuple[list[dict[str, Any]], dict[str, Any]]:
        policy = dict(self.emergency_failover_policy)
        enabled = bool_value(policy.get("enabled"))
        gate: dict[str, Any] = {
            "schema_version": "v7.emergency-failover-autonomy-gate.v1",
            "enabled": enabled,
            "mode": "EMERGENCY_FAILOVER_AUTONOMY" if enabled else "DISABLED",
            "decision": "disabled",
            "ok": False,
            "blockers": [],
            "selected_moves_before_gate": len(selected),
            "selected_moves_after_gate": len(selected),
            "evidence_candidates_before_gate": len(evidence_candidates or selected),
            "max_users_per_run": to_int(policy.get("max_users_per_run"), 1),
            "max_users_per_channel": to_int(policy.get("max_users_per_channel"), 1),
            "require_fresh_evidence": bool_value(policy.get("require_fresh_evidence", True)),
            "require_restore_barrier": bool_value(policy.get("require_restore_barrier", True)),
            "require_rollback": bool_value(policy.get("require_rollback", True)),
            "require_verification": bool_value(policy.get("require_verification", True)),
            "retry_budget_per_incident": max(0, to_int(policy.get("retry_budget_per_incident"), 1)),
            "backoff_seconds": max(0, to_int(policy.get("backoff_seconds"), to_int(policy.get("cooldown_seconds"), 180))),
            "broad_automation_enabled": False,
        }
        approved_validation = restore_barrier.get("approved_plan_lock_validation") if isinstance(restore_barrier.get("approved_plan_lock_validation"), dict) else {}
        approved_envelope = self._approved_l3_production_validation_envelope(selected, restore_barrier, approved_validation)
        gate["approved_production_validation_envelope"] = approved_envelope
        incident_source_continuity = self._l3_active_incident_source_context()
        requested_source = str(getattr(self.args, "source_egress", "") or "").strip()
        if (
            requested_source
            and bool_value(incident_source_continuity.get("active"))
            and str(incident_source_continuity.get("incident_source") or "") != requested_source
        ):
            requested_scope = self._l3_failed_source_scope(requested_source)
            if bool_value(requested_scope.get("source_failed")):
                incident_source_continuity = {
                    "schema_version": "v7.l3-incident-source-continuity.v1",
                    "active": True,
                    "reason": "requested_failed_source_scope",
                    "incident_key": "",
                    "incident_source": requested_source,
                    "incident_status": "OBSERVED",
                    "failed_required_services": list(requested_scope.get("required_service_failures") or []),
                    "affected_users": list(requested_scope.get("affected_users") or []),
                    "affected_users_count": to_int(requested_scope.get("affected_users_count"), 0),
                    "scope": requested_scope,
                    "continuity_source": "requested_source_egress",
                    "producer": "tools/v7-users-autoswitch._emergency_failover_authority_gate",
                    "consumer": "tools/v7-users-autoswitch._emergency_failover_authority_gate",
                    "owner": "tools/v7-users-autoswitch",
                    "overrode_incident_source": str(incident_source_continuity.get("incident_source") or ""),
                    "override_reason": "requested_source_egress_has_failed_source_scope",
                }
        gate["incident_source_continuity"] = incident_source_continuity
        runtime_axes = (
            policy.get("runtime_scope_axes")
            if isinstance(policy.get("runtime_scope_axes"), dict)
            else {}
        )
        scope = (
            incident_source_continuity.get("scope")
            if isinstance(incident_source_continuity.get("scope"), dict)
            else {}
        )
        controlled_failure = (
            scope.get("controlled_certification_failure")
            if isinstance(scope.get("controlled_certification_failure"), dict)
            else {}
        )
        context_moves = list(selected) if selected else list(evidence_candidates or [])
        availability_first_scope = (
            self._exact_availability_first_controlled_scope(context_moves)
        )
        context_source = str(incident_source_continuity.get("incident_source") or "")
        if availability_first_scope.get("ok"):
            context_source = str(
                (availability_first_scope.get("sources") or [""])[0]
            )
        controlled_members = []
        for move in context_moves:
            user_ip = str(move.get("user_ip") or "")
            source = str(move.get("current_egress") or "")
            proof = self._controlled_certification_failure_context(source, user_ip=user_ip)
            controlled_members.append({
                "user_ip": user_ip,
                "source": source,
                "confirmed": bool_value(proof.get("confirmed")),
                "certification_user_in_scope": bool_value(proof.get("certification_user_in_scope")),
            })
        exact_controlled_context = bool(
            availability_first_scope.get("ok")
            or (
                context_moves
                and context_source
                and bool_value(controlled_failure.get("confirmed"))
                and all(
                    row["confirmed"]
                    and row["certification_user_in_scope"]
                    and row["source"] == context_source
                    for row in controlled_members
                )
            )
        )
        ordinary_runtime_max = max(
            0,
            to_int(
                runtime_axes.get("ordinary_production_runtime_max"),
                policy.get("max_users_per_run", 1),
            ),
        )
        controlled_runtime_max = max(
            0,
            to_int(
                runtime_axes.get("controlled_certification_runtime_max"),
                ordinary_runtime_max,
            ),
        )
        selected_runtime_max = (
            controlled_runtime_max if exact_controlled_context else ordinary_runtime_max
        )
        gate["runtime_scope"] = {
            "schema_version": "v7.service-failure-execution-context-proof.v1",
            "context": (
                "AVAILABILITY_FIRST_CONTROLLED_CERTIFICATION_CONTEXT"
                if availability_first_scope.get("ok")
                else "CONTROLLED_CERTIFICATION_CONTEXT"
                if exact_controlled_context
                else "ORDINARY_PRODUCTION_SERVICE_FAILURE"
            ),
            "exact_controlled_context": exact_controlled_context,
            "incident_source": context_source,
            "member_count": len(controlled_members),
            "member_scope_fingerprint": sha256_json(controlled_members),
            "raw_member_list_stored": False,
            "authority_approved_max": to_int(runtime_axes.get("authority_approved_max"), 0),
            "controlled_certification_runtime_max": controlled_runtime_max,
            "ordinary_production_runtime_max": ordinary_runtime_max,
            "selected_runtime_max": selected_runtime_max,
            "contract_rewritten": False,
            "authority_expanded": False,
            "availability_first_controlled_scope": (
                availability_first_scope
            ),
        }
        if not enabled:
            gate["wake"] = self._l3_wake_decision(policy, [])
            return selected, gate
        blockers: list[str] = []
        if (
            gate["require_restore_barrier"]
            and not bool_value(restore_barrier.get("failover_quarantine"))
            and not bool_value(approved_envelope.get("ok"))
        ):
            blockers.append("restore_barrier_required_for_emergency_failover")
        if gate["require_rollback"] and not bool_value(getattr(self.args, "rollback_on_verify_fail", False)):
            blockers.append("rollback_required_for_emergency_failover")
        if gate["require_verification"] and not bool_value(getattr(self.args, "verify", False)):
            blockers.append("verification_required_for_emergency_failover")

        eligible: list[dict[str, Any]] = []
        per_move: list[dict[str, Any]] = []
        selected_keys = {
            (
                str(move.get("user_ip") or ""),
                str(move.get("current_egress") or ""),
                str(move.get("recommended_egress") or ""),
                str(move.get("move_type") or ""),
            )
            for move in selected
        }
        # The action-class contract is an execution gate, not an observation
        # gate.  When it suppresses selected moves, retain the exact
        # pre-contract bounded shadow selection solely to derive a fresh L3
        # wake.  It cannot create a Candidate, Packet, lease or mutation: only
        # rows that still survive the contract gate may enter `eligible`.
        evidence_source = list(selected) if selected else list(evidence_candidates or [])
        incident_source = str(incident_source_continuity.get("incident_source") or "")
        for move in evidence_source:
            if (
                not availability_first_scope.get("ok")
                and bool_value(incident_source_continuity.get("active"))
                and str(move.get("current_egress") or "") != incident_source
            ):
                blockers.append("incident_source_selected_move_mismatch")
            if availability_first_scope.get("ok"):
                evidence = {
                    "schema_version": (
                        "v7.availability-first-controlled-move-evidence.v1"
                    ),
                    "ok": True,
                    "blockers": [],
                    "user_ip": str(move.get("user_ip") or ""),
                    "current_egress": str(
                        move.get("current_egress") or ""
                    ),
                    "recommended_egress": str(
                        move.get("recommended_egress") or ""
                    ),
                    "event_provenance": "CONTROLLED_CERTIFICATION",
                    "natural_production_credit": False,
                    "authority_source": (
                        "ACTIVE_STANDING_AVAILABILITY_FIRST_POLICY"
                    ),
                }
            else:
                evidence = self._emergency_failover_move_evidence(move)
            per_move.append(evidence)
            move_key = (
                str(move.get("user_ip") or ""),
                str(move.get("current_egress") or ""),
                str(move.get("recommended_egress") or ""),
                str(move.get("move_type") or ""),
            )
            if evidence.get("ok") and move_key in selected_keys:
                eligible.append(move)
            else:
                blockers.extend(str(reason) for reason in evidence.get("blockers") or [])

        max_run = min(
            selected_runtime_max,
            max(0, to_int(policy.get("max_users_per_run"), selected_runtime_max or 1)),
        )
        max_channel = min(
            selected_runtime_max,
            max(0, to_int(policy.get("max_users_per_channel"), max_run or 1)),
        )
        if exact_controlled_context:
            # The global policy is intentionally narrowed to the ordinary
            # floor.  Only this exact member/source proof may consume the
            # separately projected controlled-certification ceiling.
            max_run = controlled_runtime_max
            max_channel = controlled_runtime_max
        if bool_value(approved_envelope.get("ok")):
            approved_run_limit = max(0, min(
                to_int(approved_envelope.get("selected_move_count"), len(eligible)),
                to_int(approved_envelope.get("clearance_max_selected_moves"), len(eligible)),
                to_int(approved_envelope.get("authorized_l3_budget"), len(eligible)),
            ))
            approved_target_counts: dict[str, int] = {}
            for move in selected:
                target = str(move.get("recommended_egress") or "")
                if target:
                    approved_target_counts[target] = approved_target_counts.get(target, 0) + 1
            if approved_run_limit > 0:
                max_run = approved_run_limit
            if approved_target_counts:
                max_channel = max(approved_target_counts.values())
        per_target_counts: dict[str, int] = {}
        bounded: list[dict[str, Any]] = []
        for move in eligible:
            if len(bounded) >= max_run:
                break
            target = str(move.get("recommended_egress") or "")
            count = per_target_counts.get(target, 0)
            if count >= max_channel:
                blockers.append("emergency_target_channel_limit_reached")
                continue
            row = dict(move)
            row["execution_mode"] = "emergency_failover"
            row.setdefault("reason", []).append("emergency_failover_autonomy_authorized")
            bounded.append(row)
            per_target_counts[target] = count + 1

        if not selected:
            blockers.append("no_selected_moves_for_emergency_failover")
        if selected and not bounded and not blockers:
            blockers.append("no_emergency_eligible_failover_moves")
        if selected and gate["retry_budget_per_incident"] < 1:
            blockers.append("l3_retry_budget_exhausted")

        wake = (
            {
                "schema_version": "v7.l3-wake-decision.v1",
                "accepted": True,
                "blockers": [],
                "reason": (
                    "availability_first_standing_policy_packet_consumption"
                ),
                "event_provenance": "CONTROLLED_CERTIFICATION",
                "natural_production_credit": False,
            }
            if availability_first_scope.get("ok")
            else self._l3_wake_decision(policy, per_move)
        )
        if not wake.get("accepted"):
            blockers.extend(str(reason) for reason in wake.get("blockers") or [])
        failed_sources = sorted({
            str(row.get("current_egress") or "")
            for row in per_move
            if row.get("current_failures")
        })
        channel_failed_sources = sorted({
            str(((row.get("current_channel_failure") or {}).get("channel")) or row.get("current_egress") or "")
            for row in per_move
            if bool_value((row.get("current_channel_failure") or {}).get("confirmed"))
        })
        failed_sources = sorted(set(failed_sources) | set(channel_failed_sources))
        failed_services = sorted({
            str(item.get("service") or "")
            for row in per_move
            for item in (row.get("current_failures") or [])
            if item.get("service")
        })
        incident_services = failed_services or (["current_channel_failure"] if channel_failed_sources else [])
        generation = str((self.generation or {}).get("planner_generation_id") or "")
        incident_key = ""
        previous_attempts = 0
        semantic_attempt_signature = ""
        if failed_sources and incident_services:
            if (
                bool_value(incident_source_continuity.get("active"))
                and incident_source in failed_sources
                and str(incident_source_continuity.get("incident_key") or "")
            ):
                incident_key = str(incident_source_continuity.get("incident_key") or "")
                gate["incident_source_continuity"] = {
                    **incident_source_continuity,
                    "incident_key_reused": True,
                    "incident_key_reuse_reason": "active_failed_source_incident_continuation",
                }
            else:
                incident_key = self._l3_incident_key(
                    source_channels=failed_sources,
                    services=incident_services,
                    authority=str(gate.get("mode") or "EMERGENCY_FAILOVER_AUTONOMY"),
                    generation=generation,
                )["key"]
            previous_attempts = self._l3_incident_attempt_count(incident_key)
            if bounded:
                semantic_attempt_signature = self._l3_semantic_attempt_signature(bounded, incident_key=incident_key)
            duplicate_consumed_attempts = self._l3_consumed_retry_attempts(
                incident_key=incident_key,
                semantic_attempt_signature=semantic_attempt_signature,
            )
            if duplicate_consumed_attempts:
                blockers.append("duplicate_apply_attempt")
                if len(duplicate_consumed_attempts) >= gate["retry_budget_per_incident"]:
                    blockers.append("l3_retry_budget_exhausted")
        gate["move_evidence"] = per_move
        gate["move_evidence_source"] = (
            "selected_moves" if selected else "pre_contract_shadow_selection_read_only"
        )
        gate["wake"] = wake
        gate["incident_key"] = incident_key
        gate["previous_attempts"] = previous_attempts
        gate["semantic_attempt_signature"] = semantic_attempt_signature
        gate["failed_sources"] = failed_sources
        gate["failed_required_services"] = failed_services
        gate["effective_max_users_per_run"] = max_run
        gate["effective_max_users_per_channel"] = max_channel
        gate["blockers"] = sorted(set(blockers))
        gate["ok"] = bool(bounded) and not gate["blockers"]
        gate["selected_moves_after_gate"] = len(bounded) if gate["ok"] else 0
        if (
            gate["ok"]
            and bool_value(approved_envelope.get("ok"))
            and availability_first_scope.get("ok")
        ):
            gate["decision"] = (
                "authorize_availability_first_controlled_certification_envelope"
            )
            gate["authority_source"] = (
                "active_standing_availability_first_policy"
            )
            gate["production_validation_only"] = True
            gate["autonomy_certified"] = False
            gate["event_provenance"] = "CONTROLLED_CERTIFICATION"
            gate["natural_production_credit"] = False
        elif gate["ok"] and bool_value(approved_envelope.get("ok")):
            gate["decision"] = (
                "authorize_governed_production_validation_envelope"
                if len(bounded) > 1
                else "authorize_one_user_production_validation_envelope"
            )
            gate["authority_source"] = "current_approved_emergency_envelope"
            gate["production_validation_only"] = True
            gate["autonomy_certified"] = False
        else:
            gate["decision"] = "authorize_bounded_emergency_failover" if gate["ok"] else "block_emergency_failover"
            gate["authority_source"] = "certified_emergency_failover_policy" if gate["ok"] else ""
            gate["production_validation_only"] = False
            gate["autonomy_certified"] = bool(gate["ok"])
        return bounded if gate["ok"] else [], gate

    def _approved_l3_production_validation_envelope(
        self,
        selected: list[dict[str, Any]],
        restore_barrier: dict[str, Any],
        approved_lock: dict[str, Any],
    ) -> dict[str, Any]:
        authorized_budget = max(1, to_int(self.authority_budget_policy.get("current_allowed_user_budget"), 1))
        selected_count = len(selected)
        approved_count = to_int(approved_lock.get("selected_move_count"), selected_count)
        clearance_max = to_int(restore_barrier.get("clearance_max_selected_moves"), authorized_budget)
        expected: list[dict[str, Any]] = [
            {
                "condition": "l3_production_validation_mode",
                "expected": True,
                "actual": bool_value(getattr(self.args, "emergency_failover_autonomy", False))
                and bool_value(getattr(self.args, "apply", False)),
                "owner": "tools/v7-governed-canary-dry-run-cycle",
                "applies_to_l3_production_validation": True,
            },
            {
                "condition": "selected_moves_within_authorized_l3_budget",
                "expected": True,
                "actual": 1 <= selected_count <= authorized_budget,
                "owner": "tools/v7-users-autoswitch",
                "applies_to_l3_production_validation": True,
                "authorized_l3_budget": authorized_budget,
            },
            {
                "condition": "approved_plan_lock_valid",
                "expected": True,
                "actual": bool_value(approved_lock.get("ok")),
                "owner": "tools/v7-users-autoswitch._approved_plan_lock_validation",
                "applies_to_l3_production_validation": True,
            },
            {
                "condition": "restore_barrier_clearance_valid",
                "expected": True,
                "actual": bool_value(restore_barrier.get("cleared"))
                and str(restore_barrier.get("clearance_guard_reason") or "") in {
                    "restore_barrier_clearance_budget_and_generation_ok",
                    "restore_barrier_clearance_preview_packet_identity_match",
                    "restore_barrier_clearance_generation_match_source_bundle_lease",
                    "restore_barrier_clearance_budget_ok",
                },
                "owner": "admin_core/operator_execution.py",
                "applies_to_l3_production_validation": True,
            },
            {
                "condition": "selected_move_hash_matches",
                "expected": True,
                "actual": bool(selected)
                and str(approved_lock.get("selected_move_hash") or "")
                == str(restore_barrier.get("clearance_selected_moves_hash") or approved_lock.get("selected_move_hash") or ""),
                "owner": "admin_core/operator_execution.py",
                "applies_to_l3_production_validation": True,
            },
            {
                "condition": "verify_enabled",
                "expected": True,
                "actual": bool_value(getattr(self.args, "verify", False)),
                "owner": "tools/v7-users-autoswitch",
                "applies_to_l3_production_validation": True,
            },
            {
                "condition": "rollback_on_verify_fail_enabled",
                "expected": True,
                "actual": bool_value(getattr(self.args, "rollback_on_verify_fail", False)),
                "owner": "tools/v7-users-autoswitch",
                "applies_to_l3_production_validation": True,
            },
            {
                "condition": "approved_batch_scope_within_authorized_l3_budget",
                "expected": True,
                "actual": selected_count >= 1
                and approved_count == selected_count
                and selected_count <= clearance_max
                and clearance_max <= authorized_budget,
                "owner": "admin_core/operator_execution.py",
                "applies_to_l3_production_validation": True,
                "authorized_l3_budget": authorized_budget,
            },
        ]
        selected_users = [str(move.get("user_ip") or "") for move in selected]
        selected_targets = sorted({str(move.get("recommended_egress") or "") for move in selected if move.get("recommended_egress")})
        allowed_users = [str(item) for item in (restore_barrier.get("allowed_users") or approved_lock.get("selected_users") or [])]
        allowed_targets = sorted(str(item) for item in (restore_barrier.get("allowed_targets") or approved_lock.get("selected_targets") or []))
        expected.append({
            "condition": "user_and_target_scope_match",
            "expected": True,
            "actual": bool(selected) and sorted(selected_users) == sorted(allowed_users) and selected_targets == allowed_targets,
            "owner": "tools/v7-users-autoswitch._approved_plan_lock_validation",
            "applies_to_l3_production_validation": True,
        })
        failed = [row for row in expected if row["actual"] != row["expected"]]
        return {
            "schema_version": "v7.l3-production-validation-envelope-gate.v1",
            "ok": not failed,
            "conditions": expected,
            "failed_conditions": [str(row["condition"]) for row in failed],
            "authority_source": "current_approved_emergency_envelope" if not failed else "",
            "production_validation_only": True,
            "broad_automation_enabled": False,
            "autonomy_certified": False,
        }

    def _emergency_failover_move_evidence(self, move: dict[str, Any]) -> dict[str, Any]:
        blockers: list[str] = []
        user_ip = str(move.get("user_ip") or "")
        reasons = [str(reason) for reason in (move.get("reason") or [])]
        if str(move.get("move_type") or "") != "failover":
            blockers.append("emergency_allows_failover_only")
        if "current_egress_not_eligible" not in reasons:
            blockers.append("current_egress_not_eligible_required")

        current_id = str(move.get("current_egress") or "")
        target_id = str(move.get("recommended_egress") or "")
        candidates = move.get("candidates") if isinstance(move.get("candidates"), list) else []
        current = next((row for row in candidates if str(row.get("egress") or "") == current_id), {})
        target = next((row for row in candidates if str(row.get("egress") or "") == target_id), {})
        current_channel_failure = self._current_channel_failure_evidence(current, user_ip=user_ip)
        if not bool_value(current_channel_failure.get("confirmed")) and current_id:
            controlled_current_failure = self._controlled_certification_failure_context(current_id, user_ip=user_ip)
            if bool_value(controlled_current_failure.get("confirmed")):
                current_channel_failure = controlled_current_failure
        current_channel_failure_confirmed = bool_value(current_channel_failure.get("confirmed"))
        if current and bool_value(current.get("eligible")) and not current_channel_failure_confirmed:
            blockers.append("current_candidate_still_eligible")
        if not target or not bool_value(target.get("eligible")):
            blockers.append("safe_target_required")
        target_load = target.get("load") if isinstance(target.get("load"), dict) else {}
        if str(target_load.get("status") or "OK") in {"HARD_FULL", "FAILOVER_FULL"}:
            blockers.append("target_load_gate_failed")

        required_services = normalize_service_ids(move.get("important_services") or [])
        current_service = current.get("service_suitability") if isinstance(current.get("service_suitability"), dict) else {}
        target_service = target.get("service_suitability") if isinstance(target.get("service_suitability"), dict) else {}
        current_failures: list[dict[str, Any]] = []
        per_service = current_service.get("per_service") if isinstance(current_service.get("per_service"), dict) else {}
        for service in required_services:
            row = per_service.get(service) if isinstance(per_service.get(service), dict) else {}
            status = str(row.get("status") or "").upper()
            truth_class = str(row.get("truth_class") or "")
            if (
                row.get("available") is False
                or truth_class == "PERSISTENT_FAIL"
                or status in {"DOWN", "FAIL", "ERROR", "NOT_STARTED"}
            ):
                current_failures.append(row)
        if not current_failures and not current_channel_failure_confirmed:
            blockers.append("required_service_failure_required")
        if bool_value(self.emergency_failover_policy.get("require_fresh_evidence", True)):
            stale_failures = [
                row for row in current_failures
                if str(((row.get("freshness") or {}).get("state") or "")) not in {"FRESH", "AGING"}
            ]
            if stale_failures and not current_channel_failure_confirmed:
                blockers.append("fresh_service_failure_evidence_required")
            freshness_state = str(((current_channel_failure.get("freshness") or {}).get("state") or ""))
            if current_channel_failure and freshness_state not in {"FRESH", "AGING"}:
                blockers.append("fresh_channel_failure_evidence_required")
        if target_service.get("required_missing") or target_service.get("required_low"):
            blockers.append("target_required_services_not_ready")
        cooldown = max(0, to_int(self.emergency_failover_policy.get("cooldown_seconds"), 180))
        cooldown_remaining = 0
        cooldown_override = self._l3_failed_source_cooldown_override_context(user_ip, current_id)
        last = self.last_switch.get(user_ip)
        if cooldown > 0 and last:
            age = max(0.0, time.time() - last)
            if age < cooldown:
                cooldown_remaining = int(cooldown - age)
                if not bool_value(cooldown_override.get("allowed")):
                    blockers.append("emergency_failover_cooldown_active")

        return {
            "user_ip": user_ip,
            "current_egress": current_id,
            "recommended_egress": target_id,
            "ok": not blockers,
            "blockers": sorted(set(blockers)),
            "cooldown_remaining_seconds": cooldown_remaining,
            "cooldown_override": cooldown_override if bool_value(cooldown_override.get("allowed")) else {},
            "current_channel_failure": current_channel_failure,
            "current_failures": [
                {
                    "service": row.get("service"),
                    "status": row.get("status"),
                    "truth_class": row.get("truth_class"),
                    "freshness": row.get("freshness"),
                }
                for row in current_failures
            ],
        }

    def _state_file_freshness(self) -> dict[str, Any]:
        max_age = max(1, to_int(self.quality_policy.get("metrics_fresh_seconds"), DEFAULT_QUALITY_POLICY["metrics_fresh_seconds"]))
        path = self.state_dir / "v7-state.json"
        try:
            mtime = path.stat().st_mtime
        except OSError:
            return {
                "state": "UNKNOWN",
                "age_seconds": None,
                "max_age_seconds": max_age,
                "path": str(path),
                "runtime_behavior": "fail_closed_if_required",
            }
        age = max(0.0, time.time() - mtime)
        return {
            "state": "FRESH" if age <= max_age else "STALE",
            "age_seconds": round(age, 3),
            "max_age_seconds": max_age,
            "path": str(path),
            "observed_at": datetime.fromtimestamp(mtime, timezone.utc).isoformat(),
            "runtime_behavior": "use_existing_observation" if age <= max_age else "fail_closed_if_required",
        }

    def _file_freshness(self, path: Path) -> dict[str, Any]:
        max_age = max(1, to_int(self.quality_policy.get("metrics_fresh_seconds"), DEFAULT_QUALITY_POLICY["metrics_fresh_seconds"]))
        try:
            mtime = path.stat().st_mtime
        except OSError:
            return {
                "state": "UNKNOWN",
                "age_seconds": None,
                "max_age_seconds": max_age,
                "path": str(path),
                "runtime_behavior": "fail_closed_if_required",
            }
        age = max(0.0, time.time() - mtime)
        return {
            "state": "FRESH" if age <= max_age else "STALE",
            "age_seconds": round(age, 3),
            "max_age_seconds": max_age,
            "path": str(path),
            "observed_at": datetime.fromtimestamp(mtime, timezone.utc).isoformat(),
            "runtime_behavior": "use_existing_production_registry" if age <= max_age else "fail_closed_if_required",
        }

    def _controlled_certification_failure_context(self, source: str, *, user_ip: str = "") -> dict[str, Any]:
        egress_rows = getattr(self, "egress", {})
        egress_rows = egress_rows if isinstance(egress_rows, dict) else {}
        egress = egress_rows.get(source)
        if not egress:
            return {"confirmed": False, "reason": "source_not_found"}
        registry = egress.raw.get("registry") if isinstance(egress.raw.get("registry"), dict) else {}
        controlled_source = bool_value(registry.get("controlled_certification_source"))
        egress_state = str(egress.state or "").lower()
        source_unavailable = (not egress.enabled) or egress_state in {"maintenance", "disabled", "quarantine", "down"}
        certification_users = sorted(
            user.ip
            for user in (getattr(self, "users", []) or [])
            if user.enabled
            and str(user.current) == source
            and bool_value(user.raw.get("certification_user"))
        )
        user_in_scope = (not user_ip) or user_ip in set(certification_users)
        freshness = self._file_freshness(self.state_dir / "egress.registry")
        confirmed = (
            controlled_source
            and source_unavailable
            and bool(certification_users)
            and user_in_scope
            and str(freshness.get("state") or "") in {"FRESH", "AGING"}
        )
        return {
            "schema_version": "v7.controlled-certification-current-channel-failure.v1",
            "confirmed": confirmed,
            "wake_source": "confirmed_current_channel_failure",
            "channel": source,
            "controlled_certification": controlled_source,
            "source_unavailable": source_unavailable,
            "egress_enabled": bool(egress.enabled),
            "egress_state": egress_state,
            "affected_user": user_ip,
            "certification_user_in_scope": user_in_scope,
            "affected_users_on_channel": len(certification_users),
            "certification_users": certification_users,
            "diagnose_reason": "controlled_certification_source_unavailable",
            "block_reason": f"egress_state_{egress_state}" if egress_state else "egress_disabled",
            "freshness": freshness,
            "producer": "tools/v7-users-autoswitch._controlled_certification_failure_context",
            "source_object": "egress.registry:controlled_certification_source + users.registry:certification_user + egress.registry enabled/state",
            "owner": "tools/v7-users-autoswitch",
            "authority_expanded": False,
            "runtime_apply_allowed_now": False,
        }

    def _current_channel_failure_evidence(self, current: dict[str, Any], *, user_ip: str) -> dict[str, Any]:
        if not isinstance(current, dict) or not current:
            return {}
        controlled = self._controlled_certification_failure_context(str(current.get("egress") or ""), user_ip=user_ip)
        if bool_value(controlled.get("confirmed")):
            return controlled
        severity = current.get("severity_classification") if isinstance(current.get("severity_classification"), dict) else {}
        reason = str(severity.get("reason") or "")
        hard_block = bool_value(severity.get("hard_block"))
        severity_value = str(severity.get("severity") or "").upper()
        affected_users = to_int(current.get("users"), 0)
        freshness = self._state_file_freshness()
        confirmed = (
            hard_block
            and severity_value == "FAIL"
            and reason == "interface_down_or_missing"
            and affected_users > 0
            and str(freshness.get("state") or "") in {"FRESH", "AGING"}
        )
        if not (hard_block or severity_value == "FAIL" or reason):
            return controlled if bool_value(controlled.get("confirmed")) else {}
        return {
            "schema_version": "v7.confirmed-current-channel-failure-evidence.v1",
            "confirmed": confirmed,
            "wake_source": "confirmed_current_channel_failure",
            "channel": str(current.get("egress") or ""),
            "affected_user": user_ip,
            "affected_users_on_channel": affected_users,
            "severity": severity_value,
            "diagnose_reason": reason,
            "block_reason": str(severity.get("block_reason") or ""),
            "freshness": freshness,
            "producer": "tools/v7-users-autoswitch._emergency_failover_move_evidence",
            "source_object": "v7-state.json:egress[].diagnose_severity/diagnose_reason + users.registry assignment",
            "owner": "tools/v7-users-autoswitch",
            "authority_expanded": False,
            "runtime_apply_allowed_now": False,
        }

    def _l3_normalized_wake_source(self, value: Any) -> str:
        raw = str(value or "").strip().lower().replace("-", "_").replace(" ", "_")
        aliases = {
            "service_failure": "confirmed_service_failure",
            "service_regression": "confirmed_service_failure",
            "current_channel_failure": "confirmed_current_channel_failure",
            "hard_failure": "confirmed_current_channel_failure",
            "channel_unavailable": "confirmed_current_channel_failure",
            "incident_resume": "verified_incident_resume",
            "runtime_resume": "recorded_runtime_resume",
            "poll": "blind_polling",
            "blind_poll": "blind_polling",
            "synthetic": "synthetic_wake",
            "optimization": "optimization_wake",
        }
        return aliases.get(raw, raw)

    def _l3_wake_decision(self, policy: dict[str, Any], move_evidence: list[dict[str, Any]]) -> dict[str, Any]:
        allowed = {
            self._l3_normalized_wake_source(item)
            for item in (policy.get("allowed_wake_sources") or [])
        } or set(DEFAULT_EMERGENCY_FAILOVER_AUTONOMY_POLICY["allowed_wake_sources"])
        rejected = {
            self._l3_normalized_wake_source(item)
            for item in (policy.get("rejected_wake_sources") or [])
        } or set(DEFAULT_EMERGENCY_FAILOVER_AUTONOMY_POLICY["rejected_wake_sources"])
        requested = self._l3_normalized_wake_source(policy.get("wake_source"))
        inferred: set[str] = set()
        observed_events: list[dict[str, Any]] = []
        failed_sources = sorted({
            str(row.get("current_egress") or "")
            for row in move_evidence
            if row.get("current_failures")
        })
        channel_failed_sources = sorted({
            str(((row.get("current_channel_failure") or {}).get("channel")) or row.get("current_egress") or "")
            for row in move_evidence
            if bool_value((row.get("current_channel_failure") or {}).get("confirmed"))
        })
        failed_sources = sorted(set(failed_sources) | set(channel_failed_sources))
        incident_source = failed_sources[0] if len(failed_sources) == 1 else ""
        failed_services = sorted({
            str(item.get("service") or "")
            for row in move_evidence
            for item in (row.get("current_failures") or [])
            if item.get("service")
        })
        if failed_sources and failed_services:
            inferred.update({"confirmed_service_failure", "confirmed_current_channel_failure"})
            observed_events.append({
                "event_id": sha256_json({
                    "wake_source": "confirmed_service_failure",
                    "failed_sources": failed_sources,
                    "failed_services": failed_services,
                    "generation": str((self.generation or {}).get("planner_generation_id") or ""),
                })[:24],
                "wake_source": "confirmed_service_failure",
                "channel": ",".join(failed_sources),
                "service": ",".join(failed_services),
                "late": False,
                "path": "inferred:service-matrix",
                "ts": now_iso(),
                "consumed_by_runtime": False,
            })
        if channel_failed_sources:
            inferred.add("confirmed_current_channel_failure")
            event_payload = {
                "wake_source": "confirmed_current_channel_failure",
                "failed_sources": channel_failed_sources,
                "generation": str((self.generation or {}).get("planner_generation_id") or ""),
                "failure_reasons": sorted({
                    str((row.get("current_channel_failure") or {}).get("diagnose_reason") or "")
                    for row in move_evidence
                    if bool_value((row.get("current_channel_failure") or {}).get("confirmed"))
                }),
            }
            observed_events.append({
                "event_id": sha256_json(event_payload)[:24],
                "wake_source": "confirmed_current_channel_failure",
                "channel": ",".join(channel_failed_sources),
                "service": "",
                "late": False,
                "path": "inferred:v7-state-current-channel-failure",
                "ts": now_iso(),
                "consumed_by_runtime": False,
            })
        observed_events.extend(
            self._l3_external_wake_events(
                late_window_seconds=max(0, to_int(policy.get("late_event_window_seconds"), 300))
            )
        )

        blockers: list[str] = []
        accepted_sources: list[str] = []
        if requested:
            if requested in rejected:
                blockers.append(f"rejected_wake_source_{requested}")
            elif requested not in allowed:
                blockers.append(f"unknown_l3_wake_source_{requested}")
            else:
                accepted_sources.append(requested)
        for event in observed_events:
            source = self._l3_normalized_wake_source(event.get("wake_source"))
            if bool_value(event.get("late")):
                continue
            if source in allowed and source not in rejected and source not in accepted_sources:
                accepted_sources.append(source)
        accepted_sources.extend(sorted(source for source in inferred if source in allowed and source not in accepted_sources))
        if not accepted_sources and not blockers:
            blockers.append("confirmed_l3_wake_required")
        accepted = bool(accepted_sources) and not blockers
        consumed_events = []
        for event in observed_events:
            source = self._l3_normalized_wake_source(event.get("wake_source"))
            consumed = accepted and source in accepted_sources and not bool_value(event.get("late"))
            row = dict(event)
            row["consumed_by_runtime"] = consumed
            consumed_events.append(row)
        return {
            "schema_version": "v7.l3-wake-decision.v1",
            "decision": "ACCEPT_WAKE" if accepted else "REJECT_WAKE",
            "accepted": accepted,
            "requested_wake_source": requested,
            "accepted_wake_sources": accepted_sources,
            "rejected_wake_sources": sorted(rejected),
            "allowed_wake_sources": sorted(allowed),
            "failed_sources": failed_sources,
            "failed_services": failed_services,
            "observed_events": consumed_events,
            "consumed_event_ids": [
                str(event.get("event_id") or "")
                for event in consumed_events
                if bool_value(event.get("consumed_by_runtime")) and str(event.get("event_id") or "")
            ],
            "late_event_ids": [
                str(event.get("event_id") or "")
                for event in consumed_events
                if bool_value(event.get("late")) and str(event.get("event_id") or "")
            ],
            "blockers": sorted(set(blockers)),
            "wake_may_grant_execution": False,
            "runtime_apply_allowed_now": accepted,
            "authority_expanded": False,
        }

    def _l3_incident_key(self, *, source_channels: list[str], services: list[str], authority: str, generation: str) -> dict[str, Any]:
        components = {
            "source_channels": sorted(str(item) for item in source_channels if str(item)),
            "failure_family": "CURRENT_CHANNEL_FAILED",
            "service_family": sorted(str(item) for item in services if str(item)),
            "authority_envelope": authority or "EMERGENCY_FAILOVER_AUTONOMY",
            "generation": generation,
        }
        return {
            "schema_version": "v7.l3-incident-key.v1",
            "key": sha256_json(components)[:24],
            "components": components,
        }

    def _l3_behavior_contracts(
        self,
        *,
        gate: dict[str, Any],
        incident_key: str,
        incident_state: str,
        selected: list[dict[str, Any]],
        move_evidence: list[dict[str, Any]],
        target_channels: list[str],
        affected_users: list[str],
    ) -> dict[str, Any]:
        policy = dict(self.emergency_failover_policy)
        retry_budget = max(0, to_int(policy.get("retry_budget_per_incident"), 1))
        backoff = max(0, to_int(policy.get("backoff_seconds"), to_int(policy.get("cooldown_seconds"), 180)))
        duplicate_window = max(0, to_int(policy.get("duplicate_event_window_seconds"), 300))
        late_window = max(0, to_int(policy.get("late_event_window_seconds"), 300))
        blockers = [str(item) for item in (gate.get("blockers") or [])]
        selected_count = len(selected)
        terminal = "READY" if bool_value(gate.get("ok")) else ("BUDGET_EXHAUSTED" if "l3_retry_budget_exhausted" in blockers else "STOP_SAFE")

        def row(
            behavior: str,
            *,
            purpose: str,
            trigger: str,
            decision: str,
            owner: str,
            stop_safe: list[str],
            learning: str,
            outcome: Optional[str] = None,
        ) -> dict[str, Any]:
            return {
                "behavior": behavior,
                "implementation_status": "EXISTS_EXTENDED",
                "purpose": purpose,
                "trigger": trigger,
                "decision": decision,
                "terminal_outcome": outcome or terminal,
                "existing_owner": owner,
                "stop_safe_conditions": stop_safe,
                "operator_visibility": True,
                "learning_impact": learning,
                "new_owner_created": False,
            }

        rows = [
            row(
                "Event Collapse",
                purpose="Collapse equivalent L3 wake signals into one incident key.",
                trigger="same failed source/service/authority/generation",
                decision="COLLAPSE_ON_INCIDENT_KEY",
                owner="tools/v7-users-autoswitch._l3_incident_key",
                stop_safe=["event_unmapped_to_generation", "authority_or_blast_radius_boundary_crossed"],
                learning="collapsed duplicate observations are evidence context, not extra outcomes",
            ),
            row(
                "Incident Merge",
                purpose="Attach equivalent events to the active incident instead of creating a duplicate incident.",
                trigger="matching incident key",
                decision="MERGE_BY_INCIDENT_KEY",
                owner="tools/v7-users-autoswitch._l3_incident_context",
                stop_safe=["merge_key_incomplete", "merge_crosses_authority_boundary"],
                learning="merged events enrich incident context",
            ),
            row(
                "Incident Split",
                purpose="Separate materially different source/service/authority/generation failures.",
                trigger="different incident key dimensions",
                decision="SPLIT_ON_MATERIAL_KEY_CHANGE",
                owner="tools/v7-users-autoswitch._l3_incident_key",
                stop_safe=["split_dimension_unknown", "generation_missing"],
                learning="split incidents preserve failure-family identity",
            ),
            row(
                "Retry Budget",
                purpose="Prevent repeated unsafe L3 attempts.",
                trigger="retry or replay after STOP_SAFE/failure/timeout",
                decision="ALLOW_ONE_ATTEMPT" if retry_budget >= 1 else "STOP_SAFE_BUDGET_EXHAUSTED",
                owner="tools/v7-users-autoswitch._emergency_failover_authority_gate",
                stop_safe=["l3_retry_budget_exhausted", "duplicate_apply_attempt"],
                learning="budget exhaustion is safety evidence, not success evidence",
                outcome="READY" if retry_budget >= 1 else "BUDGET_EXHAUSTED",
            ),
            row(
                "Backoff",
                purpose="Reuse cooldown as L3 backoff before another governed/autonomous attempt.",
                trigger="recent movement or retry consideration",
                decision=f"BACKOFF_SECONDS_{backoff}",
                owner="tools/v7-users-autoswitch._emergency_failover_move_evidence",
                stop_safe=["emergency_failover_cooldown_active"],
                learning="cooldown/backoff blocks are anti-flap evidence",
            ),
            row(
                "Target Lost Before Apply",
                purpose="Stop if the selected target disappears before commit/apply.",
                trigger="live target missing or disabled during final eligibility",
                decision="LIVE_TARGET_RECHECK",
                owner="tools/v7-users-autoswitch._l3_execution_eligibility",
                stop_safe=["target_lost_before_apply", "target_not_eligible_before_apply"],
                learning="target loss becomes runtime eligibility evidence",
            ),
            row(
                "Partial Success",
                purpose="Preserve mixed terminal results without hiding failure.",
                trigger="multiple selected moves have mixed terminal classifications",
                decision="CLASSIFY_PARTIAL_SUCCESS",
                owner="tools/v7-users-autoswitch.apply",
                stop_safe=["partial_apply_requires_terminal_classification"],
                learning="partial success does not become full success evidence",
                outcome="PARTIAL_SUCCESS",
            ),
            row(
                "Verification Timeout",
                purpose="Treat service verification timeout as non-success.",
                trigger="required service verification timeout",
                decision="ROLLBACK_OR_STOP_SAFE_ON_TIMEOUT",
                owner="tools/v7-users-autoswitch._verify_emergency_required_services",
                stop_safe=["required_service_verify_timeout"],
                learning="timeout becomes verification-quality evidence, not success evidence",
            ),
            row(
                "Unknown State Quarantine",
                purpose="Fail closed if incident state is not recognized as executable.",
                trigger="incident_state != READY_FOR_EXECUTION",
                decision="STOP_SAFE_UNKNOWN_OR_NONREADY_STATE",
                owner="tools/v7-users-autoswitch._l3_execution_eligibility",
                stop_safe=["l3_incident_not_ready"],
                learning="unknown state becomes workflow safety evidence",
                outcome="STOP_SAFE" if incident_state not in {"READY_FOR_EXECUTION", "NO_INCIDENT_DISABLED", "NO_INCIDENT_NO_EVIDENCE"} else terminal,
            ),
            row(
                "Recovery During Execution",
                purpose="Do not chase recovery mid-transaction; finish verify/rollback/closure.",
                trigger="source recovers after decision but before terminal closure",
                decision="KEEP_TRANSACTION_ATOMIC_UNTIL_TERMINAL_STATE",
                owner="tools/v7-users-autoswitch.apply",
                stop_safe=["live_validation_or_verification_fails"],
                learning="recovery during execution is recorded as incident context",
            ),
            row(
                "Recovery After Suspend",
                purpose="Require a new wake/resume decision after suspended L3 work.",
                trigger="incident resumes after STOP_SAFE/suspend",
                decision="REQUIRE_VERIFIED_INCIDENT_OR_RUNTIME_RESUME_WAKE",
                owner="tools/v7-users-autoswitch._l3_wake_decision",
                stop_safe=["confirmed_l3_wake_required"],
                learning="resume events are observations until execution occurs",
            ),
            row(
                "Late Event Handling",
                purpose="Prevent late/stale signals from starting unsafe execution.",
                trigger=f"event arrives outside {late_window}s L3 late-event window or stale generation",
                decision="REQUIRE_CURRENT_GENERATION",
                owner="tools/v7-users-autoswitch._l3_incident_key",
                stop_safe=["event_unmapped_to_generation", "generation_missing"],
                learning="late events are context evidence only",
            ),
            row(
                "Budget Exhaustion",
                purpose="Expose budget exhaustion as terminal safety state.",
                trigger="attempt budget exhausted",
                decision="STOP_SAFE_BUDGET_EXHAUSTED" if retry_budget < 1 else "BUDGET_AVAILABLE",
                owner="tools/v7-users-autoswitch._emergency_failover_authority_gate",
                stop_safe=["l3_retry_budget_exhausted"],
                learning="budget exhaustion never increases success or promotion evidence",
                outcome="BUDGET_EXHAUSTED" if retry_budget < 1 else terminal,
            ),
            row(
                "Duplicate Event Suppression",
                purpose="Prevent duplicate events/replays from causing duplicate apply.",
                trigger=f"same semantic event inside {duplicate_window}s duplicate-event window",
                decision="SUPPRESS_DUPLICATE_BY_INCIDENT_AND_SELECTED_MOVE_HASH",
                owner="tools/v7-users-autoswitch._l3_incident_context",
                stop_safe=["duplicate_apply_attempt", "selected_move_hash_mismatch"],
                learning="duplicates may complete closure but never add another outcome",
            ),
        ]
        return {
            "schema_version": "v7.l3-production-behavior-contracts.v1",
            "incident_key": incident_key,
            "incident_state": incident_state,
            "selected_count": selected_count,
            "affected_users": affected_users,
            "target_channels": target_channels,
            "retry_budget_per_incident": retry_budget,
            "backoff_seconds": backoff,
            "duplicate_event_window_seconds": duplicate_window,
            "late_event_window_seconds": late_window,
            "behaviors": rows,
            "all_required_behaviors_mapped": len(rows) == 14,
            "new_behavior_framework_created": False,
        }

    def _l3_operator_surface(self, incident: dict[str, Any], gate: dict[str, Any], selected: list[dict[str, Any]]) -> dict[str, Any]:
        behaviors = incident.get("production_behavior_contracts") if isinstance(incident.get("production_behavior_contracts"), dict) else {}
        target_channels = [str(move.get("recommended_egress") or "") for move in selected if str(move.get("recommended_egress") or "")]
        execution_state = "READY" if bool_value(gate.get("ok")) else ("DISABLED" if not bool_value(gate.get("enabled")) else "STOP_SAFE")
        return {
            "schema_version": "v7.l3-operator-surface.v1",
            "incident": str(incident.get("incident_key") or ""),
            "reason": "CURRENT_CHANNEL_FAILED",
            "failed_channel": list(incident.get("failed_sources") or []),
            "affected_users": list(incident.get("affected_users") or []),
            "selected_target": target_channels,
