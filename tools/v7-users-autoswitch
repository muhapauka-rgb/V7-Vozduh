                "available": False,
                "state": "UNKNOWN",
                "reason": "channel_trust_recovery_missing",
                "recovery_state": "UNKNOWN",
                "recovery_path": "collect_channel_trust_recovery_snapshot",
                "confidence": 0.0,
                "trust_score": 0.0,
                "current_service_score": 0.0,
                "soft_adjustment": 0.0,
                "advisory_score": 0.0,
