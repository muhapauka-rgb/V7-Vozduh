def write_json_atomic(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def read_jsonl(
    path: Path,
    *,
    tail_limit: int = 0,
    tail_max_bytes: int = 0,
) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    try:
        if tail_limit > 0 and tail_max_bytes > 0:
            with path.open("rb") as handle:
                handle.seek(0, os.SEEK_END)
                size = handle.tell()
                handle.seek(max(0, size - tail_max_bytes))
                data = handle.read(tail_max_bytes)
            lines = data.decode("utf-8", errors="replace").splitlines()
            if size > tail_max_bytes and lines:
                lines = lines[1:]
        else:
            lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except FileNotFoundError:
        return rows
    except OSError:
        return rows
    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(row, dict):
            rows.append(row)
    return rows[-tail_limit:] if tail_limit > 0 else rows


def iter_jsonl_reverse(path: Path, *, limit: int = 1000):
    """Yield a JSONL owner's newest rows first with bounded physical reads.

    Consumers such as the exact current-failure binding normally match the
    newest row.  Yielding while reading lets them stop immediately instead of
    decoding and retaining up to 1,000 potentially large historical events.
    The same append-only file remains authoritative and the hard row limit is
    unchanged; malformed rows remain non-evidence.
    """
    yielded = 0
    try:
        with Path(path).open("rb") as handle:
            handle.seek(0, os.SEEK_END)
            position = handle.tell()
            pending = b""
            while position > 0 and yielded < max(1, int(limit)):
                size = min(65536, position)
                position -= size
                handle.seek(position)
                pending = handle.read(size) + pending
                parts = pending.split(b"\n")
                pending = parts[0]
                for raw in reversed(parts[1:]):
                    if not raw.strip():
                        continue
                    try:
                        value = json.loads(raw.decode("utf-8"))
                    except (UnicodeDecodeError, json.JSONDecodeError):
                        continue
                    if isinstance(value, dict):
                        yield value
                        yielded += 1
                        if yielded >= max(1, int(limit)):
                            return
            if position == 0 and pending and yielded < max(1, int(limit)):
                try:
                    value = json.loads(pending.decode("utf-8"))
                except (UnicodeDecodeError, json.JSONDecodeError):
                    return
                if isinstance(value, dict):
                    yield value
    except OSError:
        return


def read_service_failure_event_window(
    path: Path,
    *,
    limit: int = SERVICE_FAILURE_EVENT_WINDOW_LIMIT,
) -> list[dict[str, Any]]:
    """Read a bounded recent window from the canonical failure-event owner.

    The production journal is append-only and can grow to hundreds of
    megabytes. Runtime decisions need only recent Matrix evidence, so loading
    the complete journal is both unnecessary and unsafe. This remains a
    projection of the same owner: no cache, registry or alternate truth is
    introduced, and absence from the bounded fresh window fails closed.
    """
    bounded_limit = max(
        1, min(int(limit or 1), SERVICE_FAILURE_EVENT_WINDOW_LIMIT)
    )
    max_bytes = max(
        SERVICE_FAILURE_EVENT_WINDOW_MIN_BYTES,
        min(
            SERVICE_FAILURE_EVENT_WINDOW_MAX_BYTES,
            bounded_limit * 4096,
        ),
    )
    return read_jsonl(
        Path(path),
        tail_limit=bounded_limit,
        tail_max_bytes=max_bytes,
    )


def read_live_owner_history_window(
    path: Path,
    *,
    limit: int = LIVE_OWNER_HISTORY_WINDOW_LIMIT,
) -> list[dict[str, Any]]:
    """Read a bounded recent window for a live decision consumer.

    The JSONL owner remains the sole source of truth.  This helper only keeps
    the synchronous decision path from materializing unbounded history; an
    absent matching row is treated as unknown by the caller and therefore
    cannot authorize a move.
    """
    bounded_limit = max(
        1, min(int(limit or 1), LIVE_OWNER_HISTORY_WINDOW_LIMIT)
    )
    return read_jsonl(
        Path(path),
        tail_limit=bounded_limit,
        tail_max_bytes=LIVE_OWNER_HISTORY_WINDOW_MAX_BYTES,
    )


def read_jsonl_exact_schema(path: Path, schema_version: str) -> tuple[list[dict[str, Any]], bool]:
    """Stream one immutable JSONL owner and materialize only one exact schema.

    The complete file remains the evidence owner and every matching line is
    still decoded in file order.  The cheap textual prefilter merely avoids
    JSON-decoding unrelated append-only history whose schema cannot satisfy
    this caller's contract; the parsed equality check remains authoritative.
    """
    rows: list[dict[str, Any]] = []
    active = False
    try:
        with path.open("r", encoding="utf-8", errors="replace") as handle:
            for line in handle:
                if line.strip():
                    active = True
                if schema_version not in line:
                    continue
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if isinstance(row, dict) and str(row.get("schema_version") or "") == schema_version:
                    rows.append(row)
    except (FileNotFoundError, OSError):
        return rows, active
    return rows, active


def append_jsonl(path: Path, rows: list[dict[str, Any]]) -> None:
    if not rows:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fh:
        for row in rows:
            fh.write(json.dumps(row, ensure_ascii=False, sort_keys=False) + "\n")


def acquire_service_matrix_lock(state_dir: Path, timeout_sec: int, *, enabled: bool) -> tuple[Optional[int], dict[str, Any]]:
    status: dict[str, Any] = {
        "schema": "v7.service-matrix-lifecycle-lock.v1",
        "enabled": bool(enabled),
        "acquired": False,
        "path": str(state_dir / "service-matrix.lock"),
        "scope": "planner_snapshot_packet_lifecycle",
        "owner": "tools/v7-users-autoswitch",
        "runtime_behavior_changed": False,
        "governance_behavior_changed": False,
        "execution_behavior_changed": False,
        "users_moved": False,
    }
    if not enabled:
        status["decision"] = "lock_not_required"
        return None, status
    lock_path = state_dir / "service-matrix.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600)
    started = time.time()
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            _SERVICE_MATRIX_LOCKS_HELD_BY_PROCESS.add(str(lock_path))
            status.update({
                "acquired": True,
                "decision": "service_matrix_writer_serialized_for_planner_lifecycle",
                "waited_sec": round(time.time() - started, 3),
                "timeout_sec": max(1, timeout_sec),
            })
            return fd, status
        except BlockingIOError:
            if str(lock_path) in _SERVICE_MATRIX_LOCKS_HELD_BY_PROCESS:
                os.close(fd)
                status.update({
                    "acquired": True,
                    "reentrant_same_process": True,
                    "decision": "service_matrix_writer_serialized_for_planner_lifecycle",
                    "waited_sec": round(time.time() - started, 3),
                    "timeout_sec": max(1, timeout_sec),
                })
                return None, status
            if time.time() - started >= max(1, timeout_sec):
                os.close(fd)
                status.update({
                    "acquired": False,
                    "decision": "service_matrix_lock_timeout",
                    "waited_sec": round(time.time() - started, 3),
                    "timeout_sec": max(1, timeout_sec),
                    "blocked_actions": ["selected_moves", "apply", "operator_visible_promotion"],
                })
                return None, status
            time.sleep(0.25)


def service_failure_causal_integrity_status(state_dir: Path) -> dict[str, Any]:
    """Validate the existing compact incident owner without mutating it.

    This is a read-only projection of ``l3-runtime-state.json``.  It creates no
    incident or successor; it gives policy/CPS consumers exact invalid-state
    names instead of allowing an incomplete causal record to look executable.
    """
    state_path = Path(state_dir) / "l3-runtime-state.json"
    state = read_json(state_path, {})
    incidents = state.get("incidents") if isinstance(state.get("incidents"), dict) else {}
    if not state_path.exists():
        return {
            "schema_version": "v7.service-failure-causal-integrity-status.v1",
            "status": "NOT_AVAILABLE",
            "final_verdict": "NOT_APPLICABLE",
            "state_path": str(state_path),
            "incident_count": 0,
            "open_incident_count": 0,
            "invalid_states": [],
            "read_only": True,
        }

    invalid_states: set[str] = set()
    historical_integrity_warnings: list[dict[str, Any]] = []
    open_incidents = 0
    checked_incidents = 0
    open_incident_projections: list[dict[str, Any]] = []
    for record in incidents.values():
        if not isinstance(record, dict):
            continue
        if str(record.get("authority_object") or "") != "PASSIVE_SERVICE_FAILURE_CAPTURE":
            continue
        checked_incidents += 1
        closed = str(record.get("incident_state") or "") == "INTENT_CLOSED"
        # A closed intent is immutable historical evidence.  Its old compact
        # projection may predate cumulative-lineage support, but it cannot
        # select a fresh action or block an unrelated live incident.  Keep
        # such defects visible as a bounded warning; only a live incident
        # makes the runtime safety gate STOP_SAFE.
        record_invalid_states: set[str] = set()
        if not closed:
            open_incidents += 1
            next_consumer = str(record.get("next_required_consumer") or "")
            reentry = str(record.get("reentry_condition") or "")
            if not next_consumer:
                record_invalid_states.add("INVALID_OPEN_INCIDENT_NO_SUCCESSOR")
            if not reentry:
                record_invalid_states.add("CAUSAL_LINEAGE_BROKEN")
            if bool(record.get("durable_successor_published")) and not next_consumer:
                record_invalid_states.add("DURABLE_SUCCESSOR_WITHOUT_CONSUMER")
            if str(record.get("attempt_terminal") or "") not in {
                "", "SUCCESS", "ROLLBACK_SUCCESS", "RECOVERY_OBSERVED_NO_ACTION",
                "EPISODE_EXPIRED_NO_ACTION",
            } and not next_consumer:
                record_invalid_states.add("NONTERMINAL_RESULT_WITHOUT_DURABLE_SUCCESSOR")

        scope = (
            record.get("current_source_scope")
            if isinstance(record.get("current_source_scope"), dict)
            else (record.get("scope_accounting") if isinstance(record.get("scope_accounting"), dict) else {})
        )
        if scope:
            affected = to_int(scope.get("affected_scope_count"), -1)
            protected = to_int(scope.get("protected_scope_count"), -1)
            unresolved = to_int(scope.get("unresolved_scope_count"), -1)
            excluded = to_int(scope.get("explicitly_excluded_or_recovered_scope_count"), -1)
            if min(affected, protected, unresolved, excluded) < 0 or affected != protected + unresolved + excluded:
                record_invalid_states.add("INCIDENT_SCOPE_ACCOUNTING_BROKEN")

        cumulative = (
            record.get("incident_cumulative_scope")
            if isinstance(record.get("incident_cumulative_scope"), dict) else {}
        )
        entries = cumulative.get("entries") if isinstance(cumulative.get("entries"), list) else []
        pointers = {
            str(item) for item in (cumulative.get("lineage_pointers") or []) if str(item)
        }
        entry_pointers = {
            str(item.get("feedback_id") or "")
            for item in entries if isinstance(item, dict) and str(item.get("feedback_id") or "")
        }
        consumed_feedback = {
            str(item) for item in (record.get("execution_feedback_ids") or []) if str(item)
        }
        if pointers != entry_pointers or not consumed_feedback.issubset(pointers):
            record_invalid_states.add("CURRENT_SCOPE_REPLACES_CUMULATIVE_HISTORY")
        last_feedback = str(record.get("last_execution_feedback_id") or "")
        if last_feedback and (
            last_feedback not in pointers
            or not scope
            or str(scope.get("status") or "") == "INCIDENT_SCOPE_ACCOUNTING_BROKEN"
        ):
            record_invalid_states.add("SUCCESSFUL_ATTEMPT_WITHOUT_SCOPE_UPDATE")
        if cumulative and scope:
            cumulative_fingerprint = str(cumulative.get("current_source_scope_fingerprint") or "")
            current_fingerprint = str(scope.get("affected_scope_fingerprint") or "")
            if cumulative_fingerprint and current_fingerprint and cumulative_fingerprint != current_fingerprint:
                record_invalid_states.add("CURRENT_SCOPE_REPLACES_CUMULATIVE_HISTORY")
        if closed:
            if record_invalid_states:
                historical_integrity_warnings.append({
                    "incident_id": str(record.get("incident_id") or ""),
                    "incident_generation": str(record.get("incident_generation") or record.get("generation") or ""),
                    "source_channel": str(record.get("channel") or record.get("source_channel") or ""),
                    "warning_states": sorted(record_invalid_states),
                    "owner": "existing l3-runtime-state closed historical projection",
                    "blocks_live_execution": False,
                    "raw_user_list_stored": False,
                })
        else:
            invalid_states.update(record_invalid_states)
        if not closed:
            lineage = record.get("causal_lineage") if isinstance(record.get("causal_lineage"), dict) else {}
            open_incident_projections.append({
                "incident_id": str(record.get("incident_id") or ""),
                "incident_generation": str(record.get("incident_generation") or record.get("generation") or ""),
                "source_channel": str(record.get("channel") or record.get("source_channel") or ""),
                "incident_state": str(record.get("incident_state") or ""),
                "affected_scope_count": max(0, to_int(scope.get("affected_scope_count"), 0)),
                "protected_scope_count": max(0, to_int(scope.get("protected_scope_count"), 0)),
                "unresolved_scope_count": max(0, to_int(scope.get("unresolved_scope_count"), 0)),
                "explicitly_excluded_or_recovered_scope_count": max(
                    0, to_int(scope.get("explicitly_excluded_or_recovered_scope_count"), 0)
                ),
                "affected_scope_fingerprint": str(scope.get("affected_scope_fingerprint") or ""),
                "protected_scope_fingerprint": str(scope.get("protected_scope_fingerprint") or ""),
                "unresolved_scope_fingerprint": str(scope.get("unresolved_scope_fingerprint") or ""),
                "explicitly_excluded_or_recovered_scope_fingerprint": str(
                    scope.get("explicitly_excluded_or_recovered_scope_fingerprint") or ""
                ),
                "packet_bound_success_count": max(0, to_int(cumulative.get("packet_bound_success_count"), 0)),
                "cumulative_lineage_count": len(entries),
                "last_execution_feedback_id": str(record.get("last_execution_feedback_id") or ""),
                "last_outcome_id": str(record.get("outcome_id") or ""),
                "last_learning_id": str(record.get("learning_id") or lineage.get("learning_id") or ""),
                "last_packet_id": str(record.get("packet_id") or lineage.get("packet_id") or ""),
                "next_required_consumer": str(record.get("next_required_consumer") or ""),
                "reentry_condition": str(record.get("reentry_condition") or ""),
                "last_observed_at": str(record.get("last_observed_at") or ""),
                "raw_user_list_stored": False,
            })

    return {
        "schema_version": "v7.service-failure-causal-integrity-status.v1",
        "status": "PASS" if not invalid_states else "STOP_SAFE",
        "final_verdict": "PASS" if not invalid_states else "STOP_SAFE",
        "state_path": str(state_path),
        "incident_count": checked_incidents,
        "open_incident_count": open_incidents,
        "open_incident_projections": sorted(
            open_incident_projections,
            key=lambda item: (
                str(item.get("source_channel") or ""),
                str(item.get("incident_id") or ""),
                str(item.get("incident_generation") or ""),
            ),
        ),
        "invalid_states": sorted(invalid_states),
        "historical_integrity_warnings": sorted(
            historical_integrity_warnings,
            key=lambda item: (
                str(item.get("source_channel") or ""),
                str(item.get("incident_id") or ""),
                str(item.get("incident_generation") or ""),
            ),
        ),
        "read_only": True,
        "forbidden_effects": {
            "candidate_created": False,
            "packet_created": False,
            "lease_created": False,
            "runtime_apply": False,
            "routing_mutation": False,
            "user_movement": 0,
            "rollback_apply": False,
            "authority_change": False,
            "production_maturity_change": False,
        },
    }


def ct_m0f_active_service_failure_binding_projection(
    state_dir: Path,
    source_id: str,
    *,
    event_dir: Optional[Path] = None,
    evidence_cache: Optional[dict[str, Any]] = None,
) -> dict[str, Any]:
    """Read the one current passive incident binding for a CT-M0F source.

    This deliberately projects the existing L3 incident owner rather than
    creating a second CT-M0F incident/obligation registry.  A real failed
    source may be selected only with an accounted, current obligation.  A
    deliberately controlled source continues to use its already separate
    controlled-condition lineage.
    """
    # Callers that compare several candidate sources may share this ephemeral
    # invocation cache.  It is never persisted and does not become a second
    # L3/Matrix owner; it only prevents rereading the same immutable inputs.
    cache = evidence_cache if isinstance(evidence_cache, dict) else {}
    state_path = Path(state_dir) / "l3-runtime-state.json"
    if not state_path.exists():
        return {
            "status": "NOT_AVAILABLE",
            "ok": False,
            "requires_binding": False,
            "read_only": True,
        }
    state = cache.get("l3_state")
    if not isinstance(state, dict):
        state = read_json(state_path, {})
        cache["l3_state"] = state
    incidents = state.get("incidents") if isinstance(state.get("incidents"), dict) else {}
    users = cache.get("users")
    if not isinstance(users, list):
        users = parse_registry(Path(state_dir) / "users.registry")
        cache["users"] = users
    live_source_users = sorted({
        str(row.get("ip") or "") for row in users
        if str(row.get("ip") or "")
        and bool_value(row.get("enabled", "1"))
        and str(row.get("current") or "") == str(source_id or "")
    })
    # This is an ephemeral comparison against the canonical route owner.  It
    # deliberately persists only count plus fingerprint, just like the Matrix
    # source-scope producer; it neither materializes nor stores a second
    # membership registry.
    live_source_scope = {
        "source_channel": str(source_id or ""),
        "affected_scope_count": len(live_source_users),
        "affected_scope_fingerprint": sha256_json({
            "source_channel": str(source_id or ""),
            "users": live_source_users,
        }),
        "registry_available": (Path(state_dir) / "users.registry").exists(),
        "raw_user_list_stored": False,
    }
    def current_accounted_scope(record: dict[str, Any]) -> dict[str, Any]:
        scope = record.get("current_source_scope")
        if isinstance(scope, dict):
            return scope
        legacy_scope = record.get("scope_accounting")
        return legacy_scope if isinstance(legacy_scope, dict) else {}

    def current_actionable_scope(record: dict[str, Any]) -> dict[str, Any]:
        """Return the still-live subset of an accounted incident.

        ``affected`` is the immutable incident denominator.  Once a bounded
        transaction protects one member it must remain in that denominator for
        correct incident accounting, while the next CT-M0F Packet must bind to
        the remaining users that are *currently* on the failed source.  The
        unresolved count/fingerprint is the existing owner of that live
        subset; this helper does not persist a membership list or derive a
        new truth source.
        """
        scope = current_accounted_scope(record)
        affected_count = to_int(scope.get("affected_scope_count"), -1)
        unresolved_count = to_int(scope.get("unresolved_scope_count"), -1)
        unresolved_fingerprint = str(scope.get("unresolved_scope_fingerprint") or "")
        if (
            unresolved_count == affected_count
            and not unresolved_fingerprint
        ):
            # Historical rows predate the explicit unresolved fingerprint;
            # when no member has been protected the two scopes are identical.
            unresolved_fingerprint = str(
                scope.get("affected_scope_fingerprint") or ""
            )
        return {
            "count": unresolved_count,
            "fingerprint": unresolved_fingerprint,
            "incident_affected_count": affected_count,
            "incident_affected_fingerprint": str(
                scope.get("affected_scope_fingerprint") or ""
            ),
        }

    def matches_live_source_scope(record: dict[str, Any]) -> bool:
        scope = current_actionable_scope(record)
        return (
            int(scope.get("count") or -1)
            == live_source_scope["affected_scope_count"]
            and str(scope.get("fingerprint") or "")
            == live_source_scope["affected_scope_fingerprint"]
        )
    matches = [
        record for record in incidents.values()
        if isinstance(record, dict)
        and str(record.get("authority_object") or "") == "PASSIVE_SERVICE_FAILURE_CAPTURE"
        and str(record.get("incident_state") or "") != "INTENT_CLOSED"
        and str(record.get("channel") or record.get("source_channel") or "") == str(source_id or "")
    ]
    if len(matches) == 1 and live_source_scope["registry_available"] and not matches_live_source_scope(matches[0]):
        return {
            "status": "NO_CURRENT_ROUTE_MATCHING_ACTIVE_SERVICE_FAILURE_BINDING",
            "ok": False,
            "requires_binding": True,
            "read_only": True,
            "live_source_scope": live_source_scope,
        }
    if len(matches) != 1:
        # One persistent failure can legitimately be re-observed by successive
        # Matrix generations.  Older compact L3 projections are immutable
        # lineage, but must not turn the current failure into an indefinitely
        # ambiguous CT-M0F source.  Reuse the existing closure/OMP owner to
        # select the newest *consumed* projection only when every contender
        # describes the same source generation and same current scope.  A
        # different generation or scope remains fail-closed ambiguity.
        closure_rows = cache.get("closure_rows")
        if not isinstance(closure_rows, list):
            closure_rows = read_live_owner_history_window(
                state_dir / "closure-records.jsonl"
            )
            cache["closure_rows"] = closure_rows
        consumed_pairs = {
            (
                str(row.get("automation_obligation_id") or ""),
                str(row.get("source_incident_id") or ""),
            )
            for row in closure_rows
            if str(row.get("object_type") or "")
            == "service_failure_automation_omp_consumption"
            and str(row.get("closure_state") or "") == "OMP_CONSUMED"
        }
        # An immutable historical L3 row whose own scope accounting is broken
        # cannot compete with an ACCOUNTED current incident.  Treating that
        # row as a separate live source scope would permanently starve the
        # ordinary Matrix consumer even when it has a newer, consumed, exact
        # projection for the same source generation.  This filters only rows
        # that fail their own existing-owner scope law; two distinct valid
        # generations or valid scope fingerprints still fail closed below.
        valid_matches = [
            record for record in matches
            if (
                str(current_accounted_scope(record).get("status") or "")
                == "ACCOUNTED"
                and int(current_actionable_scope(record).get("count") or 0) > 0
                and str(current_actionable_scope(record).get("fingerprint") or "")
            )
        ]
        consumed_matches = [
            record for record in matches
            if (
                str(record.get("obligation_id") or (
                    record.get("causal_lineage") or {}
                ).get("obligation_id") or ""),
                str(record.get("incident_id") or ""),
            ) in consumed_pairs
        ]
        consumed_matches = [
            record for record in consumed_matches if record in valid_matches
        ]

        def semantic_key(record: dict[str, Any]) -> tuple[str, str]:
            current_scope = current_actionable_scope(record)
            return (
                str(record.get("incident_generation") or record.get("generation") or ""),
                str(current_scope.get("fingerprint") or ""),
            )
        semantic_groups = {semantic_key(record) for record in valid_matches}
        live_scope_matches = [
            record for record in consumed_matches
            if matches_live_source_scope(record)
        ]
        if live_source_scope["registry_available"]:
            # The live route owner is available, so no historical or compact
            # projection may win merely by being newer.  One exact matching
            # projection is accepted; repeated consumed observations of the
            # *same* live source generation and scope are one continuing
            # incident and may deterministically select their newest receipt.
            # Different matching generations still remain ambiguous.
            if len(live_scope_matches) == 1:
                matches = live_scope_matches
            elif (
                len(live_scope_matches) > 1
                and len({semantic_key(record) for record in live_scope_matches}) == 1
            ):
                matches = [max(
                    live_scope_matches,
                    key=lambda record: (
                        str(record.get("last_observed_at") or ""),
                        str(record.get("updated_at") or ""),
                        str(record.get("incident_id") or ""),
                    ),
                )]
            else:
                return {
                    "status": (
                        "NO_CURRENT_ROUTE_MATCHING_ACTIVE_SERVICE_FAILURE_BINDING"
                        if not live_scope_matches
                        else "AMBIGUOUS_ACTIVE_SERVICE_FAILURE_BINDING"
                    ),
                    "ok": False,
                    "requires_binding": True,
                    "read_only": True,
                    "invalid_historical_scope_rows_ignored": len(matches) - len(valid_matches),
                    "live_source_scope": live_source_scope,
                }
        elif len(semantic_groups) == 1 and consumed_matches:
            matches = [max(
                consumed_matches,
                key=lambda record: (
                    str(record.get("last_observed_at") or ""),
                    str(record.get("updated_at") or ""),
                    str(record.get("incident_id") or ""),
                ),
            )]
        else:
            return {
                "status": (
                    "NO_ACTIVE_SERVICE_FAILURE_BINDING"
                    if not valid_matches else "AMBIGUOUS_ACTIVE_SERVICE_FAILURE_BINDING"
                ),
                "ok": False,
                "requires_binding": True,
                "read_only": True,
                "invalid_historical_scope_rows_ignored": len(matches) - len(valid_matches),
            }
    if len(matches) != 1:
        return {
            "status": (
                "NO_ACTIVE_SERVICE_FAILURE_BINDING"
                if not matches else "AMBIGUOUS_ACTIVE_SERVICE_FAILURE_BINDING"
            ),
            "ok": False,
            # The L3 projection exists, so a non-controlled failed source
            # cannot be treated as an unbound CT-M0F exercise merely because
            # its passive producer/consumer link failed to publish an open
            # incident.  Fail closed and leave that exact upstream repair
            # visible to OMP.
            "requires_binding": True,
            "read_only": True,
        }
    record = matches[0]
    scope = record.get("current_source_scope") if isinstance(record.get("current_source_scope"), dict) else {}
    actionable_scope = current_actionable_scope(record)
    lineage = record.get("causal_lineage") if isinstance(record.get("causal_lineage"), dict) else {}
    obligation_id = str(record.get("obligation_id") or lineage.get("obligation_id") or "")
    event_ids = [str(value) for value in (record.get("source_event_ids") or lineage.get("source_event_ids") or []) if str(value)]
    blockers = []
    for value, name in (
        (str(record.get("incident_id") or ""), "incident_id_missing"),
        (str(record.get("incident_generation") or record.get("generation") or ""), "incident_generation_missing"),
        (obligation_id, "obligation_id_missing"),
        (str(actionable_scope.get("fingerprint") or ""), "scope_fingerprint_missing"),
    ):
        if not value:
            blockers.append(name)
    if str(scope.get("status") or "") != "ACCOUNTED":
        blockers.append("incident_scope_accounting_not_accounted")
    if int(actionable_scope.get("count") or 0) <= 0:
        blockers.append("incident_scope_empty")
    if int(scope.get("unresolved_scope_count") or 0) <= 0:
        blockers.append("incident_scope_unresolved_empty")
    if live_source_scope["registry_available"] and (
        int(actionable_scope.get("count") or -1)
        != live_source_scope["affected_scope_count"]
        or str(actionable_scope.get("fingerprint") or "")
        != live_source_scope["affected_scope_fingerprint"]
    ):
        blockers.append("current_live_route_scope_mismatch")
    # A current route scope is necessary but not sufficient for a production
    # cutover.  The governed executor independently requires a recent
    # capture-only Matrix event for the same incident and scope.  Check the
    # exact same existing event owner here when the normal Matrix caller
    # supplies it, so an expired incident cannot create a Candidate/Packet
    # attempt only to be rejected downstream.  Direct projection callers that
    # do not own an event directory retain their read-only scope semantics.
    fresh_event_id = ""
    fresh_event_status = "NOT_EVALUATED"
    if event_dir is not None:
        fresh_event_status = "MISSING"
        now = datetime.now(timezone.utc)
        event_rows = cache.get("service_failure_events")
        if not isinstance(event_rows, list):
            event_rows = read_service_failure_event_window(
                Path(event_dir) / "service-failure-events.jsonl",
            )
            cache["service_failure_events"] = event_rows
        for event in reversed(event_rows):
            if str(event.get("event_type") or "") not in {
                "SERVICE_FAILURE_OBSERVED", "SERVICE_FAILURE_REVALIDATED",
            }:
                continue
            if str(event.get("source_incident_id") or "") != str(record.get("incident_id") or ""):
                continue
            if str(event.get("channel") or event.get("object") or "") != str(source_id or ""):
                continue
            if not bool(event.get("capture_only")) or str(event.get("event_provenance") or "") != "EXTERNAL_UNATTRIBUTED":
                continue
            event_scope = event.get("source_scope") if isinstance(event.get("source_scope"), dict) else {}
            if (
                int(event_scope.get("affected_scope_count") or 0)
                != int(actionable_scope.get("count") or 0)
                or str(event_scope.get("affected_scope_fingerprint") or "")
                != str(actionable_scope.get("fingerprint") or "")
            ):
                continue
            timestamp = str(event.get("observed_at") or event.get("timestamp") or "")
            try:
                observed = datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
                if observed.tzinfo is None:
                    observed = observed.replace(tzinfo=timezone.utc)
            except (TypeError, ValueError):
                continue
            if 0 <= (now - observed.astimezone(timezone.utc)).total_seconds() <= 1800:
                fresh_event_id = str(event.get("event_id") or "")
                fresh_event_status = "READY"
                break
        if fresh_event_status != "READY":
            blockers.append("fresh_matching_service_failure_event_missing")
    return {
        "schema_version": "v7.ct-m0f-active-service-failure-binding.v1",
        "status": "ACTIVE_SERVICE_FAILURE_BINDING_READY" if not blockers else "STOP_SAFE_ACTIVE_SERVICE_FAILURE_BINDING_INVALID",
        "ok": not blockers,
        "requires_binding": True,
        "automation_obligation_id": obligation_id,
        "source_incident_id": str(record.get("incident_id") or ""),
        "source_incident_generation": str(record.get("incident_generation") or record.get("generation") or ""),
        "source_event_id": event_ids[0] if event_ids else "",
        "source_event_ids": event_ids,
        "fresh_event_id": fresh_event_id,
        "fresh_event_status": fresh_event_status,
        "source_channel": str(source_id or ""),
        "source_scope_fingerprint": str(actionable_scope.get("fingerprint") or ""),
        "source_scope_count": int(actionable_scope.get("count") or 0),
        "incident_affected_scope_count": int(
            actionable_scope.get("incident_affected_count") or 0
        ),
        "incident_affected_scope_fingerprint": str(
            actionable_scope.get("incident_affected_fingerprint") or ""
        ),
        "live_source_scope": live_source_scope,
        "observation_generation": str(record.get("observation_generation") or ""),
        "blockers": sorted(set(blockers)),
        "read_only": True,
        "raw_identity_list_stored": False,
    }


def ct_m0f_certification_only_matrix_failure_binding_projection(
    state_dir: Path,
    source_id: str,
    *,
    event_dir: Path,
    evidence_cache: Optional[dict[str, Any]] = None,
) -> dict[str, Any]:
    """Bind a controlled recovery to one active Matrix episode, read-only.

    Matrix owns the current health/failure episode and its append-only event
    is immutable evidence of an observation.  ``users.registry`` remains the
    sole owner of *current* assignment membership.  A continuing failure must
    therefore be bound to a fresh Matrix episode and then to the current
    certification-only registry scope, rather than require an old event
    snapshot to describe identities which may legitimately have changed.

    This is an in-memory selector projection only.  It persists neither a
    membership list nor an incident, and the later Candidate/Packet/lease
    pipeline still freezes the one exact selected identity before any apply.
    """
    cache = evidence_cache if isinstance(evidence_cache, dict) else {}
    source_id = str(source_id or "")
    users_path = Path(state_dir) / "users.registry"
    egress_path = Path(state_dir) / "egress.registry"
    matrix_path = Path(state_dir) / "service-matrix.json"
    if not source_id or not users_path.exists() or not egress_path.exists():
        return {
            "status": "CONTROLLED_MATRIX_BINDING_NOT_AVAILABLE",
            "ok": False,
            "requires_binding": True,
            "read_only": True,
            "raw_identity_list_stored": False,
        }
    users = cache.get("users")
    if not isinstance(users, list):
        users = parse_registry(users_path)
        cache["users"] = users
    egress_rows = cache.get("egress_rows")
    if not isinstance(egress_rows, list):
        egress_rows = parse_registry(egress_path)
        cache["egress_rows"] = egress_rows
    registry = next(
        (
            row for row in egress_rows
            if str(row.get("id") or "") == source_id
        ),
        {},
    )
    source_users = sorted({
        str(row.get("ip") or "")
        for row in users
        if str(row.get("ip") or "")
        and bool_value(row.get("enabled", "1"))
        and str(row.get("current") or "") == source_id
    })
    ordinary_users = sorted({
        str(row.get("ip") or "")
        for row in users
        if str(row.get("ip") or "")
        and bool_value(row.get("enabled", "1"))
        and str(row.get("current") or "") == source_id
        and not bool_value(row.get("certification_user"))
    })
    certification_users = sorted(set(source_users) - set(ordinary_users))
    live_scope = {
        "source_channel": source_id,
        "affected_scope_count": len(certification_users),
        "affected_scope_fingerprint": sha256_json({
            "source_channel": source_id,
            "users": certification_users,
        }),
        "registry_available": True,
        "raw_user_list_stored": False,
    }
    blockers: list[str] = []
    if not bool_value(registry.get("controlled_certification_source")):
        blockers.append("source_not_controlled_certification_source")
    if not certification_users:
        blockers.append("controlled_certification_scope_empty")
    if ordinary_users:
        blockers.append("ordinary_users_present_on_controlled_source")

    matrix = cache.get("service_matrix")
    if not isinstance(matrix, dict):
        matrix = read_json(matrix_path, {}) if matrix_path.exists() else {}
        cache["service_matrix"] = matrix
    matrix_row = (
        (matrix.get("items") or {}).get(source_id)
        if isinstance(matrix.get("items"), dict)
        else {}
    )
    matrix_row = matrix_row if isinstance(matrix_row, dict) else {}
    checked_at = str(matrix_row.get("checked_at") or "")
    matrix_fresh = False
    try:
        checked = datetime.fromisoformat(checked_at.replace("Z", "+00:00"))
        if checked.tzinfo is None:
            checked = checked.replace(tzinfo=timezone.utc)
        matrix_fresh = 0 <= (
            datetime.now(timezone.utc) - checked.astimezone(timezone.utc)
        ).total_seconds() <= 1800
    except (TypeError, ValueError):
        pass
    services = matrix_row.get("services") if isinstance(matrix_row.get("services"), dict) else {}
    matrix_failed = any(
        isinstance(value, dict) and value.get("ok") is False
        for value in services.values()
    )
    if not matrix_fresh:
        blockers.append("matrix_source_observation_not_fresh")
    if not matrix_failed:
        blockers.append("matrix_source_not_currently_failed")
    current_failed_services = {
        str(service_id): value
        for service_id, value in services.items()
        if isinstance(value, dict) and value.get("ok") is False
    }

    event_match: dict[str, Any] = {}
    now = datetime.now(timezone.utc)
    event_path = Path(event_dir) / "service-failure-events.jsonl"
    event_rows = cache.get("service_failure_events")
    if isinstance(event_rows, list):
        reverse_events = reversed(event_rows)
    else:
        # Preserve the same newest-1,000-row evidence envelope, but allow the
        # exact-match consumer below to stop after the first current row.
        reverse_events = iter_jsonl_reverse(event_path, limit=1000)
    for event in reverse_events:
        if str(event.get("event_type") or "") not in {
            "SERVICE_FAILURE_OBSERVED", "SERVICE_FAILURE_REVALIDATED",
        }:
            continue
        if str(event.get("channel") or event.get("object") or "") != source_id:
            continue
        if not bool(event.get("capture_only")) or (
            str(event.get("event_provenance") or "")
            != "EXTERNAL_UNATTRIBUTED"
        ):
            continue
        scope = event.get("source_scope") if isinstance(event.get("source_scope"), dict) else {}
        controlled_scope = scope.get("controlled_certification_scope")
        controlled_scope = (
            controlled_scope if isinstance(controlled_scope, dict) else {}
        )
        if (
            str(scope.get("scope_classification") or "")
            != "CERTIFICATION_ONLY"
            or to_int(scope.get("affected_scope_count"), -1) != 0
        ):
            continue
        event_services = {
            str(service_id)
            for service_id in (event.get("correlated_services") or [])
            if str(service_id)
        }
        if str(event.get("service") or ""):
            event_services.add(str(event.get("service") or ""))
        # The source-level event must still describe at least one service that
        # the fresh Matrix row says is failing.  Service rows from a
        # continuing correlated outage can have older per-service incident
        # ids (or none) while the source-level revalidation event is the
        # canonical episode identity, so demand equality only where the two
        # owners describe the same concrete service.
        correlated_current = {
            service_id: current_failed_services[service_id]
            for service_id in event_services
            if service_id in current_failed_services
        }
        if not correlated_current:
            continue
        event_incident_id = str(event.get("source_incident_id") or "")
        if not event_incident_id:
            continue
        correlated_incident_ids = {
            str(value.get("source_incident_id") or "")
            for value in correlated_current.values()
            if str(value.get("source_incident_id") or "")
        }
        if correlated_incident_ids and event_incident_id not in correlated_incident_ids:
            continue
        timestamp = str(event.get("observed_at") or event.get("timestamp") or "")
        try:
            observed = datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
            if observed.tzinfo is None:
                observed = observed.replace(tzinfo=timezone.utc)
        except (TypeError, ValueError):
            continue
        if 0 <= (now - observed.astimezone(timezone.utc)).total_seconds() <= 1800:
            event_match = event
            break
    if not event_match:
        blockers.append("fresh_active_certification_only_matrix_event_missing")
    event_scope = (
        event_match.get("source_scope")
        if isinstance(event_match.get("source_scope"), dict)
        else {}
    )
    event_controlled_scope = (
        event_scope.get("controlled_certification_scope")
        if isinstance(event_scope.get("controlled_certification_scope"), dict)
        else {}
    )
    event_scope_snapshot = {
        "scope_classification": str(event_scope.get("scope_classification") or ""),
        "ordinary_scope_count": to_int(event_scope.get("affected_scope_count"), -1),
        "controlled_scope_count": to_int(
            event_controlled_scope.get("affected_scope_count"), -1,
        ),
        "controlled_scope_fingerprint": str(
            event_controlled_scope.get("affected_scope_fingerprint") or "",
        ),
        "raw_identity_list_stored": False,
    }
    return {
        "schema_version": "v7.ct-m0f-certification-only-matrix-binding.v1",
        "status": (
            "CERTIFICATION_ONLY_MATRIX_FAILURE_BINDING_READY"
            if not blockers else "STOP_SAFE_CERTIFICATION_ONLY_MATRIX_BINDING_INVALID"
        ),
        "ok": not blockers,
        "requires_binding": True,
        "binding_kind": "CERTIFICATION_ONLY_MATRIX_FAILURE",
        "scope_binding_model": "CURRENT_REGISTRY_SCOPE_ON_ACTIVE_MATRIX_EPISODE",
        "automation_obligation_id": "",
        "source_incident_id": str(event_match.get("source_incident_id") or ""),
        "source_incident_generation": str(
            event_match.get("observation_generation") or ""
        ),
        "source_event_id": str(event_match.get("event_id") or ""),
        "source_event_ids": [str(event_match.get("event_id") or "")]
        if event_match.get("event_id") else [],
        "fresh_event_id": str(event_match.get("event_id") or ""),
        "fresh_event_status": "READY" if event_match else "MISSING",
        "source_channel": source_id,
        "source_scope_fingerprint": live_scope["affected_scope_fingerprint"],
        "source_scope_count": live_scope["affected_scope_count"],
        "live_source_scope": live_scope,
        "event_scope_snapshot": event_scope_snapshot,
        "event_scope_snapshot_matches_current": bool(
            event_scope_snapshot["controlled_scope_count"]
            == live_scope["affected_scope_count"]
            and event_scope_snapshot["controlled_scope_fingerprint"]
            == live_scope["affected_scope_fingerprint"]
        ),
        "matrix_checked_at": checked_at,
        "matrix_source_incident_id": str(
            event_match.get("source_incident_id") or "",
        ),
        "matrix_correlated_failed_service_count": len(
            {
                service_id
                for service_id in (
                    list(event_match.get("correlated_services") or [])
                    + [str(event_match.get("service") or "")]
                )
                if service_id in current_failed_services
            }
        ),
        "blockers": sorted(set(blockers)),
        "read_only": True,
        "raw_identity_list_stored": False,
    }


