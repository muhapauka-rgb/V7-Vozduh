def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def read_json(path: Path, default: Any) -> Any:
    try:
        with path.open("r", encoding="utf-8") as fh:
            return json.load(fh)
    except FileNotFoundError:
        return default
    except json.JSONDecodeError:
        return default
    except OSError:
        return default


def normalize_authority_class(value: Any) -> str:
    name = str(value or "CANARY").strip().upper()
    return name if name in AUTHORITY_CLASS_RANK else "CANARY"


def authority_class_budget(value: Any, default: int = 1) -> int:
    authority_class = normalize_authority_class(value)
    if authority_class in AUTHORITY_CLASS_BUDGETS:
        return AUTHORITY_CLASS_BUDGETS[authority_class]
    return max(0, to_int(default, 0))


def normalize_authority_lifecycle_state(value: Any) -> str:
    name = str(value or "").strip().upper()
    return name if name in AUTHORITY_LIFECYCLE_STATES else ""


def min_authority_class(*classes: str) -> str:
    normalized = [normalize_authority_class(item) for item in classes if item]
    if not normalized:
        return "CANARY"
    return min(normalized, key=lambda item: AUTHORITY_CLASS_RANK[item])


def canonical_authority_class_for_promotion(value: Any, budget: Any = None) -> str:
    authority_class = normalize_authority_class(value)
    if authority_class == "POOL" and to_int(budget, AUTHORITY_CLASS_BUDGETS["POOL"]) <= AUTHORITY_CLASS_BUDGETS["LARGE_BATCH"]:
        return "LARGE_BATCH"
    return authority_class


def sha256_file(path: Path) -> str:
    try:
        h = hashlib.sha256()
        with path.open("rb") as fh:
            for chunk in iter(lambda: fh.read(1024 * 1024), b""):
                h.update(chunk)
        return h.hexdigest()
    except OSError:
        return ""


def sha256_json(payload: Any) -> str:
    encoded = json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def build_prepared_class_decision_projection(
    plan: dict[str, Any], *, ordinary_user_ips: Optional[set[str]] = None,
    ordinary_user_assignments: Optional[dict[str, str]] = None,
) -> dict[str, Any]:
    """Compact the existing Planner result for pre-incident fast validation.

    This is a projection of the normal Matrix/Planner owner, not a second
    planner or a durable truth source.  The potentially O(N) member scan has
    already happened before this helper is called.  The projection deliberately
    retains only a precomputed membership fingerprint and generation-bound
    invalidators; no member list, Candidate, Packet or lease crosses into the
    incident hot path.
    """
    decisions = [row for row in (plan.get("decisions") or []) if isinstance(row, dict)]
    safety = plan.get("safety") if isinstance(plan.get("safety"), dict) else {}
    generation = safety.get("generation") if isinstance(safety.get("generation"), dict) else {}
    stable_inputs = generation.get("inputs") if isinstance(generation.get("inputs"), dict) else {}
    volatile_inputs = generation.get("volatile_inputs") if isinstance(generation.get("volatile_inputs"), dict) else {}
    groups: dict[str, dict[str, Any]] = {}
    global_hot_contracts: dict[str, dict[str, Any]] = {}
    exclusions = 0
    stale_registry_source_exclusions = 0
    for row in decisions:
        user = str(row.get("user_ip") or row.get("user") or "")
        if bool_value(row.get("certification_user")) or (
            ordinary_user_ips is not None and user not in ordinary_user_ips
        ):
            # N10 is an ordinary-user product lane.  Certification identities
            # remain available to their own governed campaigns but may never
            # enter an ordinary cohort merely because their route/profile is
            # otherwise semantically similar.
            exclusions += 1
            continue
        source = str(row.get("current_egress") or "")
        target = str(row.get("recommended_egress") or "")
        if not user or not source or not target or source == target:
            exclusions += 1
            continue
        # The Planner can retain a decision for a source that a completed
        # governed operation has already vacated.  A prepared N10 class must
        # use the canonical live assignment, not that historical direction.
        # Exclude disagreement rather than silently rewriting its source or
        # target in this Matrix-owned projection.
        if (
            ordinary_user_assignments is not None
            and str(ordinary_user_assignments.get(user) or "") != source
        ):
            exclusions += 1
            stale_registry_source_exclusions += 1
            continue
        services = sorted(str(item) for item in (
            row.get("profile_required_services")
            if "profile_required_services" in row
            else row.get("important_services") or []
        ) if str(item))
        capacity = row.get("capacity_decision") if isinstance(row.get("capacity_decision"), dict) else {}
        semantic = {
            "source_channel": source,
            "target_channel": target,
            "service_routing_compatibility": services,
            "route_class": str(row.get("route_class") or ""),
            "policy_set": str(row.get("policy_set") or row.get("policy_class") or ""),
            "correlation_domain": str(row.get("correlation_domain") or target),
            "capacity_bucket": str(capacity.get("status") or capacity.get("decision") or "UNKNOWN"),
            "exception_boundary": str(row.get("exception_boundary") or "NONE"),
        }
        class_id = "pcd_" + sha256_json(semantic)[:24]
        item = groups.setdefault(
            class_id,
            {"semantic": semantic, "members": [], "hot_targets": {}},
        )
        item["members"].append(user)
        candidates = [
            candidate
            for candidate in (row.get("candidates") or [])
            if isinstance(candidate, dict)
            and bool(candidate.get("eligible"))
            and str(candidate.get("egress") or "")
            and str(candidate.get("egress") or "") != source
            and not bool_value(candidate.get("canary_reserved"))
        ]
        # The Planner owns eligibility and scoring.  This adapter only bounds
        # and deduplicates its already-ranked alternatives; it never invents
        # or manually chooses a server.
        candidates.sort(key=lambda candidate: (
            -to_float(candidate.get("score"), 0.0),
            str(candidate.get("egress") or ""),
        ))
        if not candidates and target:
            # Older/current plan fixtures expose only the selected target.  It
            # is still an official Planner result and remains a lawful H=1
            # projection, with the same generation invalidators below.
            candidates = [{
                "egress": target,
                "eligible": True,
                "score": to_float(row.get("recommended_score"), 0.0),
                "role": str(row.get("target_role") or ""),
                "capacity_decision": capacity,
            }]
        for candidate in candidates[:4]:
            target_id = str(candidate.get("egress") or "")
            target_semantic = {
                "target_id": target_id,
                "critical_services": services,
            }
            contract_fingerprint = sha256_json(target_semantic)
            capacity_decision = (
                candidate.get("capacity_decision")
                if isinstance(candidate.get("capacity_decision"), dict)
                else {}
            )
            projected_load = (
                capacity_decision.get("projected_load")
                if isinstance(capacity_decision.get("projected_load"), dict)
                else {}
            )
            target_safe_additional_capacity = max(
                0,
                to_int(projected_load.get("hard_limit"), 0)
                - to_int(projected_load.get("users"), 0),
            )
            contract = {
                **target_semantic,
                "target_service_fingerprint": contract_fingerprint,
                "planner_score": round(to_float(candidate.get("score"), 0.0), 3),
                "capacity_bucket": str(
                    capacity_decision.get("status")
                    or capacity_decision.get("decision")
                    or "UNKNOWN"
                ),
                # This scalar is produced by the existing capacity owner.  A
                # hot-path consumer may reuse it only while the projection's
                # membership/capacity generations still match; it must never
                # invent a registry default during an incident.
                "target_safe_additional_capacity": (
                    target_safe_additional_capacity
                ),
                "role": str(candidate.get("role") or ""),
                "selection_owner": "tools/v7-users-autoswitch.AutoswitchPlanner.plan",
                "manual_server_selection": False,
            }
            item["hot_targets"][contract_fingerprint] = contract
            global_hot_contracts[contract_fingerprint] = contract
    prepared = []
    for class_id, item in sorted(groups.items()):
        members = sorted(set(item["members"]))
        semantic = item["semantic"]
        hot_targets = sorted(
            item["hot_targets"].values(),
            key=lambda row: (-to_float(row.get("planner_score"), 0.0), str(row.get("target_id") or "")),
        )[:4]
        # Keep the per-class routing relation compact.  Full target readiness
        # facts live once in ``hot_target_set.contracts`` and are addressed by
        # fingerprint; embedding them in every class made a valid
        # 1000-source/many-profile projection needlessly approach 20 MiB.
        hot_target_refs = [
            {
                "target_id": str(row.get("target_id") or ""),
                "target_service_fingerprint": str(
                    row.get("target_service_fingerprint") or ""
                ),
            }
            for row in hot_targets
        ]
        prepared.append({
            "class_id": class_id,
            **semantic,
            "member_count": len(members),
            "membership_fingerprint": sha256_json({"members": members}),
            # A bounded, deterministic slice is intentionally different from
            # persisting every class member.  It lets the existing Matrix /
            # Planner projection feed the N10 small-cohort contract without
            # an incident-time O(all-users) reconstruction or a new registry.
            "ordinary_member_slice": members[:4],
            "ordinary_member_slice_fingerprint": sha256_json({"members": members[:4]}),
            "ordinary_member_slice_limit": 4,
            "ordinary_member_slice_policy": "ORDINARY_NON_CERTIFICATION_ONLY_V1",
            "raw_member_list_stored": False,
            "prepared_action": "FAILOVER_TO_EXISTING_PLANNER_TARGET",
            "hot_target_limit": 4,
            "hot_targets": hot_target_refs,
            "hot_target_contracts_embedded": False,
            "hot_target_count": len(hot_target_refs),
            "target_readiness_state": (
                "PRE_READY_TARGET_SET_PROJECTED"
                if hot_targets else "NO_3S_TARGET_CAPACITY"
            ),
            "execution_allowed": False,
        })
    invalidators = {
        "planner_generation": prepared_selection_planner_generation(
            stable_inputs
        ),
        "membership_generation": str(stable_inputs.get("users_registry") or ""),
        "target_topology_generation": str(
            stable_inputs.get("prepared_target_topology")
            or stable_inputs.get("egress_registry")
            or ""
        ),
        "policy_authority_generation": str(stable_inputs.get("policy") or ""),
        "organization_policy_generation": str(stable_inputs.get("org_policy") or ""),
        "service_routing_generation": str(stable_inputs.get("service_preferences") or ""),
        "target_health_and_path_generation": str(volatile_inputs.get("service_matrix") or ""),
        "capacity_reservation_generation": str(volatile_inputs.get("egress_speed") or ""),
        "anti_flap_generation": str(volatile_inputs.get("autoswitch_safety") or ""),
        "active_operation_generation": str((plan.get("operation") or {}).get("operation_id") or ""),
        "rollback_target_availability_generation": str(volatile_inputs.get("service_matrix") or ""),
    }
    fact_freshness = {
        "path_liveness": {
            "generation_owner": "target_health_and_path_generation",
            "maximum_age_seconds": 3,
        },
        "telegram_required_service": {
            "generation_owner": "target_health_and_path_generation",
            "maximum_age_seconds": 2,
        },
        "other_required_service": {
            "generation_owner": "target_health_and_path_generation",
            "maximum_age_seconds": 10,
        },
        "capacity": {
            "generation_owner": "capacity_reservation_generation",
            "maximum_age_seconds": 30,
        },
        "policy": {
            "generation_owner": "policy_authority_generation",
            "maximum_age_seconds": None,
            "freshness_semantics": "CURRENT_GENERATION_EQUALITY",
        },
        "identity_and_role": {
            "generation_owner": "target_topology_generation",
            "maximum_age_seconds": None,
            "freshness_semantics": "CURRENT_GENERATION_EQUALITY",
        },
    }
    return {
        "schema_version": "v7.prepared-class-decision-projection.v1",
        "owner": "tools/v7-users-autoswitch.AutoswitchPlanner.plan",
        "producer_trigger_owner": "tools/v7-service-matrix-refresh-all",
        "status": "PREPARED_CLASS_DECISION_AVAILABLE" if prepared else "NO_COMPATIBLE_PREPARED_CLASS",
        "produced_at": str(plan.get("updated") or now_iso()),
        "classes": prepared,
        "class_count": len(prepared),
        "excluded_decision_count": exclusions,
        "stale_registry_source_exclusions": stale_registry_source_exclusions,
        "invalidators": invalidators,
        # Health observations, capacity and anti-flap state are validated at
        # use time by their existing owners.  In particular, a confirmed
        # failure necessarily changes anti-flap state; treating that change as
        # target-selection identity would force an O(N) world-model rebuild at
        # the exact moment the prepared target is needed.  The projection
        # still carries the anti-flap generation as evidence, but it is not a
        # selection invalidator and never grants execution by itself.
        "selection_invalidator_keys": list(PREPARED_SELECTION_INVALIDATOR_KEYS),
        "maximum_reuse_seconds": PREPARED_PROJECTION_PERIODIC_REBUILD_SECONDS,
        "hot_target_set": {
            "schema_version": "v7.role-based-pre-ready-hot-target-set.v1",
            "bound_per_class": 4,
            "selection_owner": "tools/v7-users-autoswitch.AutoswitchPlanner.plan",
            "contracts": sorted(
                global_hot_contracts.values(),
                key=lambda row: (str(row.get("target_id") or ""), row.get("critical_services") or []),
            ),
            "deduplicated_target_service_contract_count": len(global_hot_contracts),
            "fact_specific_freshness": fact_freshness,
            "current_state": (
                "PRE_READY_TARGET_SET_PROJECTED"
                if global_hot_contracts else "NO_3S_TARGET_CAPACITY"
            ),
            "prepared_dataplane_owner": "admin_core.routing_core + existing route owner",
            "incident_time_world_model_rebuild": False,
            "new_state_store_created": False,
        },
        "hot_validation_law": "COMPARE_DECLARED_GENERATIONS_ONLY_NO_WORLD_MODEL_REBUILD",
        "candidate_created": False,
        "packet_created": False,
        "lease_created": False,
        "runtime_mutation_performed": False,
        "routing_mutation_performed": False,
        "users_moved": 0,
    }


def validate_prepared_class_decision_projection(
    projection: dict[str, Any], current_invalidators: dict[str, Any]
) -> dict[str, Any]:
    """Bounded consumer for a precomputed decision's declared invalidators."""
    expected = projection.get("invalidators") if isinstance(projection.get("invalidators"), dict) else {}
    declared_keys = projection.get("selection_invalidator_keys")
    compared_keys = (
        [str(key) for key in declared_keys]
        if isinstance(declared_keys, list) and declared_keys
        else list(expected)
    )
    reasons = sorted(
        key for key in compared_keys
        if (value := expected.get(key)) is not None
        if str(value or "") != str(current_invalidators.get(key) or "")
    )
    missing = not projection or not expected or not (projection.get("classes") or [])
    if missing:
        status = "PREPARED_CLASS_DECISION_MISSING"
        reasons = ["prepared_projection_or_generation_binding_missing"]
    elif reasons:
        status = "PREPARED_CLASS_DECISION_STALE"
    else:
        status = "PREPARED_CLASS_DECISION_FRESH"
    fact_owner_map = {
        "path_liveness": "target_health_and_path_generation",
        "telegram_required_service": "target_health_and_path_generation",
        "other_required_service": "target_health_and_path_generation",
        "capacity": "capacity_reservation_generation",
        "policy": "policy_authority_generation",
        "identity_and_role": "target_topology_generation",
    }
    fact_freshness = {
        fact: {
            "generation_owner": owner,
            "fresh": bool(
                expected.get(owner)
                and str(expected.get(owner) or "")
                == str(current_invalidators.get(owner) or "")
            ),
        }
        for fact, owner in fact_owner_map.items()
    }
    hot_target_set = (
        projection.get("hot_target_set")
        if isinstance(projection.get("hot_target_set"), dict)
        else {}
    )
    no_hot_target = not bool(hot_target_set.get("contracts"))
    if status == "PREPARED_CLASS_DECISION_FRESH" and no_hot_target:
        status = "NO_3S_TARGET_CAPACITY"
        reasons = ["pre_ready_hot_target_missing"]
    return {
        "schema_version": "v7.prepared-class-decision-freshness-consumer.v1",
        "owner": "tools/v7-users-autoswitch",
        "status": status,
        "ok": status == "PREPARED_CLASS_DECISION_FRESH",
        "invalidation_reasons": reasons,
        "comparison_count": len(compared_keys),
        "selection_invalidator_keys": compared_keys,
        "fact_specific_freshness": fact_freshness,
        "hot_target_contract_count": len(hot_target_set.get("contracts") or []),
        "no_3s_target_capacity": no_hot_target,
        "world_model_rebuilt": False,
        "registry_scanned": False,
        "member_list_serialized": False,
        "candidate_created": False,
        "packet_created": False,
        "lease_created": False,
        "runtime_mutation_performed": False,
    }


def current_prepared_selection_invalidators(args: argparse.Namespace) -> dict[str, str]:
    """Hash only inputs that can invalidate the prepared selection surface."""
    state_dir = Path(args.state_dir)
    stable_inputs = {
        "users_registry": sha256_file(state_dir / "users.registry"),
        "egress_registry": sha256_file(state_dir / "egress.registry"),
        "prepared_target_topology": prepared_target_topology_generation(
            state_dir / "egress.registry"
        ),
        "service_preferences": sha256_file(state_dir / "service-preferences.json"),
        "policy": sha256_file(Path(args.policy_file)),
        "org_policy": sha256_file(Path(args.org_policy_file)),
    }
    return {
        "planner_generation": prepared_selection_planner_generation(
            stable_inputs
        ),
        "membership_generation": stable_inputs["users_registry"],
        "target_topology_generation": stable_inputs[
            "prepared_target_topology"
        ],
        "policy_authority_generation": stable_inputs["policy"],
        "organization_policy_generation": stable_inputs["org_policy"],
        "service_routing_generation": stable_inputs["service_preferences"],
        "capacity_reservation_generation": sha256_file(state_dir / "egress-speed.json"),
        "anti_flap_generation": sha256_file(Path(args.safety_file)),
    }


def reuse_current_prepared_class_projection(args: argparse.Namespace) -> dict[str, Any]:
    """Reuse the Matrix-owned target set while its selection inputs are current.

    A periodic rebuild remains mandatory to re-rank top-H from fresh quality
    evidence. Between rebuilds, PATH and required-service roles update the
    selected targets' readiness without an O(N) Planner run.
    """
    summary = read_json(
        Path(args.state_dir) / "service-matrix-refresh-summary.json", {},
    )
    projection = (
        summary.get("prepared_class_decisions")
        if isinstance(summary, dict)
        and isinstance(summary.get("prepared_class_decisions"), dict)
        else {}
    )
    expected = projection.get("invalidators") if isinstance(projection.get("invalidators"), dict) else {}
    declared = projection.get("selection_invalidator_keys")
    current = current_prepared_selection_invalidators(args)
    age_seconds = max(0.0, time.time() - parse_ts(projection.get("produced_at")))
    blockers: list[str] = []
    if str(projection.get("schema_version") or "") != "v7.prepared-class-decision-projection.v1":
        blockers.append("prepared_projection_missing")
    if str(projection.get("status") or "") != "PREPARED_CLASS_DECISION_AVAILABLE":
        blockers.append("prepared_projection_not_ready")
    if list(declared or []) != list(PREPARED_SELECTION_INVALIDATOR_KEYS):
        blockers.append("selection_invalidation_contract_upgrade_required")
    hot_target_set = (
        projection.get("hot_target_set")
        if isinstance(projection.get("hot_target_set"), dict)
        else {}
    )
    hot_contracts = [
        row for row in (hot_target_set.get("contracts") or [])
        if isinstance(row, dict)
    ]
    if hot_contracts and any(
        "target_safe_additional_capacity" not in row
        for row in hot_contracts
    ):
        # Existing v1 projections produced before the role-based capacity
        # scalar was added are structurally valid but cannot safely feed the
        # incident hot path. Force the existing Planner owner to rebuild them
        # once instead of silently reusing a legacy projection.
        blockers.append("prepared_hot_target_capacity_upgrade_required")
    for key in PREPARED_SELECTION_INVALIDATOR_KEYS:
        if not expected.get(key) or str(expected.get(key)) != str(current.get(key)):
            blockers.append(f"selection_input_changed:{key}")
    if age_seconds >= PREPARED_PROJECTION_PERIODIC_REBUILD_SECONDS:
        blockers.append("periodic_quality_rerank_due")
    freshness = validate_prepared_class_decision_projection(
        projection, {**expected, **current},
    ) if projection else {}
    ok = not blockers and freshness.get("status") == "PREPARED_CLASS_DECISION_FRESH"
    return {
        "ok": ok,
        "status": "PREPARED_CLASS_PROJECTION_REUSED" if ok else "PREPARED_CLASS_PROJECTION_REBUILD_REQUIRED",
        "blockers": sorted(set(blockers)),
        "age_seconds": round(age_seconds, 3),
        "maximum_reuse_seconds": PREPARED_PROJECTION_PERIODIC_REBUILD_SECONDS,
        "prepared_class_decisions": projection if ok else {},
        "prepared_class_decision_freshness": freshness if ok else {},
        "world_model_rebuilt": False,
        "matrix_observation_invalidates_selection": False,
    }


def prepared_decision_handoff_for_scope(
    *,
    state_dir: Path,
    policy_file: Path,
    org_policy_file: Path,
    safety_file: Path,
    source: str,
    target: str = "",
) -> dict[str, Any]:
    """Expose one existing prepared Planner proposal to the governed caller.

    This is a read-only adapter over the Matrix-owned summary and the normal
    prepared-decision freshness consumer.  It never selects a target from the
    registry, creates execution objects or grants permission.  Ambiguous or
    stale preparation deliberately returns a fallback reason so the existing
    full Planner path remains authoritative.
    """
    args = argparse.Namespace(
        state_dir=str(state_dir),
        policy_file=str(policy_file),
        org_policy_file=str(org_policy_file),
        safety_file=str(safety_file),
    )
    reuse = reuse_current_prepared_class_projection(args)
    projection = reuse.get("prepared_class_decisions") or {}
    if not reuse.get("ok"):
        return {
            "schema_version": "v7.precomputed-decision-governed-handoff.v1",
            "status": "PREPARED_DECISION_STALE_OR_MISSING",
            "ok": False,
            "fallback": "EXISTING_FULL_PLANNER",
            "source": str(source or ""),
            "requested_target": str(target or ""),
            "selected_target": "",
            "projection_fingerprint": "",
            "invalidators": {},
            "blockers": list(reuse.get("blockers") or ["prepared_projection_not_reusable"]),
            "runtime_mutation_performed": False,
        }
    source = str(source or "")
    requested_target = str(target or "")
    classes = [
        row for row in (projection.get("classes") or [])
        if isinstance(row, dict) and str(row.get("source_channel") or "") == source
    ]
    contracts = {
        str(row.get("target_id") or ""): row
        for row in ((projection.get("hot_target_set") or {}).get("contracts") or [])
        if isinstance(row, dict) and str(row.get("target_id") or "")
    }
    class_targets = {
        str(target_row.get("target_id") or "")
        for row in classes
        for target_row in (row.get("hot_targets") or [])
        if isinstance(target_row, dict) and str(target_row.get("target_id") or "")
    }
    candidates = sorted(class_targets & set(contracts))
    blockers: list[str] = []
    if not source:
        blockers.append("prepared_handoff_source_missing")
    if not classes:
        blockers.append("prepared_handoff_source_class_missing")
    if requested_target:
        if requested_target not in candidates:
            blockers.append("prepared_handoff_requested_target_not_in_source_class")
        selected_target = requested_target
    elif len(candidates) == 1:
        selected_target = candidates[0]
    elif len(candidates) > 1:
        blockers.append("prepared_handoff_target_ambiguous")
        selected_target = ""
    else:
        blockers.append("prepared_handoff_source_class_has_no_hot_target")
        selected_target = ""
    if selected_target and selected_target not in contracts:
        blockers.append("prepared_handoff_target_contract_missing")
    return {
        "schema_version": "v7.precomputed-decision-governed-handoff.v1",
        "status": "READY_FOR_BOUNDED_HOT_VALIDATION" if not blockers else "PREPARED_DECISION_HANDOFF_STOP_SAFE",
        "ok": not blockers,
        "fallback": "EXISTING_FULL_PLANNER" if blockers else "NONE",
        "source": source,
        "requested_target": requested_target,
        "selected_target": selected_target,
        "source_class_count": len(classes),
        "prepared_target_count": len(candidates),
        "target_contract": copy.deepcopy(contracts.get(selected_target) or {}),
        "projection_fingerprint": sha256_json(projection),
        "invalidators": copy.deepcopy(projection.get("invalidators") or {}),
        "freshness": {
            "status": "PREPARED_CLASS_DECISION_FRESH",
            "selection_invalidator_keys": list(
                projection.get("selection_invalidator_keys") or []
            ),
            "world_model_rebuilt": False,
        },
        "blockers": sorted(set(blockers)),
        "runtime_mutation_performed": False,
    }


def matrix_comparative_probe_selection(
    plan: dict[str, Any], prepared_freshness: dict[str, Any]
) -> dict[str, Any]:
    """Project exact Planner-selected Matrix scope for a shadow comparison.

    This reuses the already computed Planner decision. It creates no target,
    role registry, queue or durable health state. Stale, incomplete or
    contradictory input is rejected rather than widened by this caller.
    """
    if str(prepared_freshness.get("status") or "") != "PREPARED_CLASS_DECISION_FRESH":
        return {
            "status": "STOP_SAFE_MATRIX_COMPARISON_PREPARED_DECISION_NOT_FRESH",
            "ok": False,
            "reason": "prepared_decision_not_fresh",
        }
    selected = []
    for row in (plan.get("decisions") or []):
        if not isinstance(row, dict):
            continue
        source = str(row.get("current_egress") or "")
        target = str(row.get("recommended_egress") or "")
        services = normalize_service_ids(row.get("important_services") or [])
        if source and target and source != target and services:
            selected.append({"source": source, "target": target, "services": services})
    if not selected:
        return {
            "status": "STOP_SAFE_MATRIX_COMPARISON_NO_EXISTING_PLANNER_SELECTION",
            "ok": False,
            "reason": "no_exact_source_target_service_selection",
        }
    sources = sorted({row["source"] for row in selected})
    targets = sorted({row["target"] for row in selected})
    if len(sources) != 1:
        return {
            "status": "STOP_SAFE_MATRIX_COMPARISON_MULTIPLE_ACTIVE_SOURCES",
            "ok": False,
            "reason": "active_source_not_exact",
            "active_sources": sources,
        }
    services = sorted({service for row in selected for service in row["services"]})
    semantic = {
        "active_source": sources[0],
        "eligible_planner_targets": targets,
        "required_services": services,
        "planner_generation": str(
            (prepared_freshness.get("current_invalidators") or {}).get("planner_generation")
            or ""
        ),
    }
    return {
        "schema_version": "v7.matrix-comparative-probe-selection.v1",
        "status": "EXACT_EXISTING_PLANNER_MATRIX_SELECTION",
        "ok": True,
        **semantic,
        "egresses": sorted(set(sources + targets)),
        "selection_fingerprint": sha256_json(semantic),
        "selection_owner": "tools/v7-users-autoswitch.AutoswitchPlanner.plan",
        "manual_server_selection": False,
        "new_owner_created": False,
        "routing_mutation_performed": False,
        "users_moved": 0,
    }


def _matrix_observation_refresh(*, command: list[str], timeout_sec: int) -> dict[str, Any]:
    started_ns = time.monotonic_ns()
    try:
        proc = subprocess.run(
            command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            check=False, timeout=timeout_sec,
        )
        try:
            payload = json.loads(proc.stdout or "{}")
        except json.JSONDecodeError:
            payload = {}
        return {
            "ok": proc.returncode == 0 and isinstance(payload, dict),
            "returncode": proc.returncode,
            "payload": payload if isinstance(payload, dict) else {},
            "output_tail": (proc.stdout or "")[-2000:],
            "duration_ms": round((time.monotonic_ns() - started_ns) / 1_000_000.0, 3),
        }
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "ok": False, "returncode": 1, "payload": {}, "error": str(exc),
            "duration_ms": round((time.monotonic_ns() - started_ns) / 1_000_000.0, 3),
        }


def _required_service_verdicts(
    refresh: dict[str, Any], *, egresses: list[str], services: list[str]
) -> tuple[dict[str, dict[str, dict[str, Any]]], list[str]]:
    payload = refresh.get("payload") if isinstance(refresh.get("payload"), dict) else {}
    rows = payload.get("results") if isinstance(payload.get("results"), list) else []
    by_egress = {
        str(row.get("egress") or ""): row
        for row in rows if isinstance(row, dict) and str(row.get("egress") or "")
    }
    verdicts: dict[str, dict[str, dict[str, Any]]] = {}
    missing: list[str] = []
    for egress in egresses:
        result = by_egress.get(egress) or {}
        result_services = result.get("service_results") if isinstance(result.get("service_results"), dict) else {}
        verdicts[egress] = {}
        for service in services:
            item = result_services.get(service)
            if not isinstance(item, dict):
                missing.append(f"{egress}:{service}:missing")
                continue
            verdicts[egress][service] = {
                "ok": bool(item.get("ok")),
                "status": str(item.get("status") or "UNKNOWN"),
            }
    return verdicts, missing


def run_matrix_comparative_preflight(
    selection: dict[str, Any], args: argparse.Namespace
) -> dict[str, Any]:
    """Run an exact Matrix subset then the unchanged full Matrix as shadow.

    Both calls use the existing Matrix writer in observation-only mode. The
    full result runs the complete service catalogue for the same
    Planner-selected source/targets and is the final canonical observation;
    the subset never permits a route action or user move.
    """
    if not selection.get("ok"):
        return {
            "schema_version": "v7.matrix-fast-full-comparison.v1",
            "status": str(selection.get("status") or "STOP_SAFE_SELECTION_REQUIRED"),
            "ok": False, "selection": selection, "full_matrix_fallback_used": True,
            "fallback_reasons": [str(selection.get("reason") or "selection_invalid")],
            "routing_mutation_performed": False, "users_moved": 0,
        }
    state_dir = str(getattr(args, "state_dir", "") or "")
    event_dir = str(getattr(args, "event_dir", "") or "")
    timeout = max(30, min(180, to_int(getattr(args, "matrix_comparative_timeout_sec", 120), 120)))
    base = [
        "v7-service-matrix-refresh-all", "--state-dir", state_dir,
        "--event-dir", event_dir, "--matrix-observation-only",
    ]
    short = _matrix_observation_refresh(
        command=base + [
            "--egresses", ",".join(selection["egresses"]),
            "--services", ",".join(selection["required_services"]),
        ], timeout_sec=timeout,
    )
    # Always execute the unchanged baseline, including after a failed or
    # incomplete exact observation.
    full = _matrix_observation_refresh(
        command=base + ["--egresses", ",".join(selection["egresses"])],
        timeout_sec=timeout,
    )
    short_verdicts, short_missing = _required_service_verdicts(
        short, egresses=selection["egresses"], services=selection["required_services"]
    )
    full_verdicts, full_missing = _required_service_verdicts(
        full, egresses=selection["egresses"], services=selection["required_services"]
    )
    fallback_reasons = []
    if not short.get("ok"):
        fallback_reasons.append("short_matrix_observation_failed")
    if not full.get("ok"):
        fallback_reasons.append("full_matrix_observation_failed")
    fallback_reasons.extend(short_missing)
    fallback_reasons.extend(full_missing)
    if short_verdicts != full_verdicts:
        fallback_reasons.append("required_service_verdict_disagreement")
    short_payload = short.get("payload") if isinstance(short.get("payload"), dict) else {}
    full_payload = full.get("payload") if isinstance(full.get("payload"), dict) else {}
    short_checks = sum(to_int(row.get("total"), 0) for row in short_payload.get("results", []) if isinstance(row, dict))
    full_checks = sum(to_int(row.get("total"), 0) for row in full_payload.get("results", []) if isinstance(row, dict))
    short_ms = float(short.get("duration_ms") or 0)
    full_ms = float(full.get("duration_ms") or 0)
    return {
        "schema_version": "v7.matrix-fast-full-comparison.v1",
        "status": "MATRIX_FAST_FULL_AGREEMENT" if not fallback_reasons else "MATRIX_FULL_FALLBACK_RETAINED",
        "ok": not fallback_reasons,
        "selection": selection,
        "required_service_verdicts": {"short": short_verdicts, "full": full_verdicts},
        "measurements": {
            "short_duration_ms": short.get("duration_ms"), "full_duration_ms": full.get("duration_ms"),
            "short_executed_checks": short_checks, "full_executed_checks": full_checks,
            "elapsed_reduction_pct": round((1 - short_ms / full_ms) * 100, 1) if full_ms > 0 else None,
            "check_reduction_pct": round((1 - short_checks / full_checks) * 100, 1) if full_checks > 0 else None,
            "short_errors": 0 if short.get("ok") else 1, "full_errors": 0 if full.get("ok") else 1,
        },
        "full_matrix_fallback_used": True,
        "fallback_reasons": sorted(set(fallback_reasons)),
        "full_matrix_is_final_canonical_observation": True,
        "runtime_mutation_performed": False, "routing_mutation_performed": False,
        "users_moved": 0, "candidate_created": False, "packet_created": False, "lease_created": False,
    }


def build_service_failure_adaptive_cohort_contract(
    movable: list[dict[str, Any]],
    *,
    incident_required_scope: int,
    generic_certified_scope: int,
    adapter_compatible_scope: int,
    authority_safe_scope: int,
    runtime_safe_scope: int,
    verification_safe_scope: int,
    rollback_containment_safe_scope: int,
    circuit_breaker_safe_scope: int,
    request_safe_scope: int,
    measured_at: str,
    expires_at: str = "",
) -> dict[str, Any]:
    """Project one exact Service Failure cohort through existing safety owners.

    This is a bounded projection, not a Planner or an Authority decision.  The
    input rows have already been selected by the existing Planner and carry its
    projected per-target capacity decisions.  The helper makes every numeric
    bound and the exact selected set explicit so downstream OMP/Matrix owners
    cannot silently turn a policy maximum into the actual cohort size.
    """
    unique: list[dict[str, Any]] = []
    seen_users: set[str] = set()
    exclusions: list[dict[str, str]] = []
    for row in movable:
        user = str(row.get("user_ip") or "")
        source = str(row.get("current_egress") or "")
        target = str(row.get("recommended_egress") or "")
        if not user or not source or not target or source == target:
            exclusions.append({"user_ip": user, "reason": "invalid_or_non_movement_row"})
            continue
        if user in seen_users:
            exclusions.append({"user_ip": user, "reason": "duplicate_user_identity"})
            continue
        seen_users.add(user)
        unique.append(dict(row))

    capacity_safe: list[dict[str, Any]] = []
    target_loads: dict[str, dict[str, Any]] = {}
    for row in unique:
        user = str(row.get("user_ip") or "")
        target = str(row.get("recommended_egress") or "")
        decision = row.get("capacity_decision")
        decision = decision if isinstance(decision, dict) else {}
        projected = decision.get("projected_load")
        projected = projected if isinstance(projected, dict) else {}
        hard_limit = max(0, to_int(projected.get("hard_limit"), 0))
        projected_users = max(0, to_int(projected.get("users"), 0))
        user_payload = row.get("user") if isinstance(row.get("user"), dict) else {}
        load_weight = max(1, to_int(
            row.get("capacity_weight")
            or row.get("load_weight")
            or user_payload.get("capacity_weight")
            or 1,
            1,
        ))
        reserve = max(0, to_int(
            projected.get("required_reserve")
            or projected.get("reserve_users")
            or 0,
            0,
        ))
        if hard_limit <= 0:
            exclusions.append({"user_ip": user, "reason": "capacity_bound_unknown"})
            continue
        target_state = target_loads.setdefault(target, {
            "capacity_limit": hard_limit,
            "required_reserve": reserve,
            "current_load": max(0, projected_users - 1),
            "selected_load": 0,
            "selected_users": [],
            "unit": "CAPACITY_WEIGHT_UNIT",
        })
        target_state["capacity_limit"] = min(
            int(target_state["capacity_limit"]), hard_limit,
        )
        target_state["required_reserve"] = max(
            int(target_state["required_reserve"]), reserve,
        )
        available_after_reserve = max(
            0,
            int(target_state["capacity_limit"])
            - int(target_state["required_reserve"])
            - int(target_state["current_load"]),
        )
        if int(target_state["selected_load"]) + load_weight > available_after_reserve:
            exclusions.append({"user_ip": user, "reason": "target_capacity_or_reserve_limit"})
            continue
        target_state["selected_load"] = int(target_state["selected_load"]) + load_weight
        target_state["selected_users"].append(user)
        capacity_safe.append({**row, "capacity_weight": load_weight})

    bounds_spec = {
        "incident_required_scope": (
            max(0, int(incident_required_scope)),
            "existing Service Failure incident scope owner",
            "current unresolved protection intent",
        ),
        "eligible_source_scope": (
            len(unique),
            "existing autoswitch Planner",
            "unique current-source users with a different eligible target",
        ),
        "generic_certified_scope": (
            max(0, int(generic_certified_scope)),
            "existing generic movement certification owner",
            "engineering-certified generic primitive ceiling",
        ),
        "adapter_compatible_scope": (
            max(0, int(adapter_compatible_scope)),
            "existing Service Failure adapter owner",
            "scenario bridge engineering-compatible ceiling",
        ),
        "capacity_safe_scope": (
            len(capacity_safe),
            "existing target capacity and reserve owner",
            "exact Planner rows within current per-target capacity",
        ),
        "authority_safe_scope": (
            max(0, int(authority_safe_scope)),
            operator_execution.CURRENT_ACTION_CLASS_CONTRACT_ISSUING_OWNER,
            "current independently issued Authority maximum",
        ),
        "runtime_safe_scope": (
            max(0, int(runtime_safe_scope)),
            "tools/v7-users-autoswitch._emergency_failover_policy",
            "current Runtime-enabled transaction maximum",
        ),
        "verification_safe_scope": (
            max(0, int(verification_safe_scope)),
            "existing per-user and aggregate verification owner",
            "currently qualified verification ceiling",
        ),
        "rollback_containment_safe_scope": (
            max(0, int(rollback_containment_safe_scope)),
            "existing rollback and containment owner",
            "currently qualified rollback/containment ceiling",
        ),
        "circuit_breaker_safe_scope": (
            max(0, int(circuit_breaker_safe_scope)),
            "tools/v7-users-autoswitch.apply",
            "stop-after-first-non-success cohort circuit breaker ceiling",
        ),
        "request_safe_scope": (
            max(0, int(request_safe_scope)),
            "existing Matrix/controlled-production caller",
            "exact current caller request ceiling",
        ),
    }
    bounds: dict[str, dict[str, Any]] = {}
    for name, (value, owner, reason) in bounds_spec.items():
        semantic = {"name": name, "owner": owner, "value": value, "reason": reason}
        bounds[name] = {
            **semantic,
            "fingerprint": sha256_json(semantic),
            "measured_at": measured_at,
            "expires_at": expires_at,
            "freshness": "CURRENT_GENERATION",
        }
    mandatory_values = [int(row["value"]) for row in bounds.values()]
    effective_limit = min(mandatory_values) if mandatory_values else 0
    selected = capacity_safe[:effective_limit] if effective_limit > 0 else []
    shadow_bound_names = [
        name for name in bounds
        if name != "authority_safe_scope"
    ]
    shadow_values = [int(bounds[name]["value"]) for name in shadow_bound_names]
    shadow_limit = min(shadow_values) if shadow_values else 0
    shadow_selected = capacity_safe[:shadow_limit] if shadow_limit > 0 else []
    cohort_semantic = [{
        "user_ip": str(row.get("user_ip") or ""),
        "source": str(row.get("current_egress") or ""),
        "target": str(row.get("recommended_egress") or ""),
        "capacity_weight": int(row.get("capacity_weight") or 1),
    } for row in selected]
    cohort_fingerprint = sha256_json({"members": cohort_semantic})
    limiting_bounds = sorted(
        name for name, row in bounds.items()
        if int(row["value"]) == effective_limit
    )
    return {
        "schema_version": "v7.service-failure-adaptive-cohort-contract.v1",
        "owner": "tools/v7-users-autoswitch",
        "planner_owner_reused": True,
        "authority_granted": False,
        "runtime_mutation_performed": False,
        "bounds": bounds,
        "effective_cohort_limit": effective_limit,
        "effective_cohort": len(selected),
        "effective_cohort_load": sum(int(row.get("capacity_weight") or 1) for row in selected),
        "load_unit": "CAPACITY_WEIGHT_UNIT",
        "target_loads_after_reserve": target_loads,
        "selected_moves": selected,
        "bounded_shadow_limit": shadow_limit,
        "bounded_shadow_moves": shadow_selected,
        "selected_members": cohort_semantic,
        "cohort_fingerprint": cohort_fingerprint,
        "limiting_bounds": limiting_bounds,
        "excluded_members": exclusions,
        "status": "MOVE_READY_WITHIN_EXISTING_AUTHORITY" if selected else "STOP_SAFE",
        "blockers": [] if selected else [
            "one_or_more_mandatory_cohort_bounds_are_zero_or_unknown",
        ],
    }


def planner_movable_rows_with_selected_capacity(
    decisions: list[dict[str, Any]],
) -> list[dict[str, Any]]:
    """Carry an existing selected-candidate capacity projection to its move row.

    ``plan()`` deliberately keeps candidate evidence nested under each user
    decision.  The bounded cohort contract consumes a movement-shaped row, so
    this adapter preserves the Planner's exact selected-target capacity without
    recalculating capacity, selecting a target, or changing an admission.
    """
    movable: list[dict[str, Any]] = []
    for row in decisions:
        target = str(row.get("recommended_egress") or "")
        if not target or target == str(row.get("current_egress") or ""):
            continue
        movable_row = dict(row)
        if not isinstance(row.get("capacity_decision"), dict):
            for candidate in row.get("candidates") or []:
                if not isinstance(candidate, dict):
                    continue
                if str(candidate.get("egress") or "") != target:
                    continue
                candidate_capacity = candidate.get("capacity_decision")
                if isinstance(candidate_capacity, dict):
                    movable_row["capacity_decision"] = candidate_capacity
                break
        movable.append(movable_row)
    return movable


