    def _load_intelligence_snapshots(self) -> dict[str, Any]:
        root = self.intelligence_snapshot_root
        try:
            from admin_core.intelligence_snapshots import read_snapshot_bundle
        except Exception as exc:
            return {
                "schema_version": "v7.runtime-intelligence-snapshot-gate.v1",
                "root": str(root),
                "active": False,
                "mode": "legacy_routing_brain_fallback",
                "stop_required": False,
                "unavailable_reason": f"snapshot_reader_import_unavailable:{exc.__class__.__name__}",
                "results": {},
                "stop_families": [],
                "warn_families": [],
                "ignored_families": [],
            }
        expected_paths = [root / f"{name}.json" for name in RUNTIME_INTELLIGENCE_SNAPSHOT_FAMILIES]
        active = any(path.exists() for path in expected_paths)
        results = read_snapshot_bundle(root, list(RUNTIME_INTELLIGENCE_SNAPSHOT_FAMILIES)) if active else {}
        summaries: dict[str, dict[str, Any]] = {}
        stop_families: list[str] = []
        warn_families: list[str] = []
        ignored_families: list[str] = []
        source_mismatch_families: list[str] = []
        for family, result in results.items():
            validation = result.validation
            source_mismatches = self._intelligence_snapshot_source_mismatches(family, result.payload)
            source_mismatch_stop = bool(source_mismatches and family in RUNTIME_REQUIRED_INTELLIGENCE_SNAPSHOT_FAMILIES)
            runtime_behavior = "STOP" if source_mismatch_stop else result.runtime_behavior
            if family not in RUNTIME_REQUIRED_INTELLIGENCE_SNAPSHOT_FAMILIES and runtime_behavior == "STOP":
                runtime_behavior = "IGNORE"
            errors = list(validation.errors)
            if source_mismatches:
                errors.extend(source_mismatches)
                source_mismatch_families.append(family)
            stop_required = bool(active and runtime_behavior == "STOP")
            if stop_required:
                stop_families.append(family)
            elif runtime_behavior == "WARN":
                warn_families.append(family)
            elif runtime_behavior == "IGNORE":
                ignored_families.append(family)
            summaries[family] = {
                "path": result.path,
                "exists": result.exists,
                "validation_ok": validation.ok and not source_mismatch_stop,
                "validation_errors": errors,
                "validation_warnings": list(validation.warnings),
                "freshness_state": result.freshness_state,
                "confidence": result.confidence,
                "runtime_behavior": runtime_behavior,
                "stop_required": stop_required,
                "schema": result.payload.get("schema") if isinstance(result.payload, dict) else "",
                "source_hashes": result.payload.get("source_hashes") if isinstance(result.payload, dict) else {},
                "item_count": result.payload.get("item_count") if isinstance(result.payload, dict) else 0,
            }
        return {
            "schema_version": "v7.runtime-intelligence-snapshot-gate.v1",
            "root": str(root),
            "active": active,
            "mode": "snapshot_backed_runtime_fast_path" if active else "legacy_routing_brain_fallback",
            "required_families": list(RUNTIME_REQUIRED_INTELLIGENCE_SNAPSHOT_FAMILIES),
            "families_checked": list(RUNTIME_INTELLIGENCE_SNAPSHOT_FAMILIES) if active else [],
            "stop_required": bool(active and stop_families),
            "stop_families": sorted(set(stop_families)),
            "warn_families": sorted(set(warn_families)),
            "ignored_families": sorted(set(ignored_families)),
            "source_mismatch_families": sorted(set(source_mismatch_families)),
            "results": summaries,
            "authority": {
                "planner_decision_owner": "tools/v7-users-autoswitch",
                "snapshot_write_authority": "none_runtime_read_only",
                "execution_authority": "none",
                "selected_moves_write_authority": "none",
            },
        }

    def _run_pre_planner_refresh(self) -> dict[str, Any]:
        mode = str(getattr(self.args, "pre_planner_refresh", "off") or "off")
        status: dict[str, Any] = {
            "schema": "v7.pre-planner-intelligence-refresh.v1",
            "enabled": mode != "off",
            "mode": mode,
            "executor": "tools/v7-users-autoswitch",
            "trigger": "pre_planner_refresh_gate",
            "action": "noop",
            "state": "DISABLED",
            "decision": "do_not_refresh",
            "stop_required": False,
            "written_evidence": "plan.safety.intelligence_snapshots.pre_planner_refresh",
            "blocked_actions": [],
            "next_state": "load_existing_snapshots",
            "runtime_behavior_changed": False,
            "governance_behavior_changed": False,
            "execution_behavior_changed": False,
            "users_moved": False,
        }
        if mode == "off":
            return status
        if bool_value(getattr(self.args, "apply", False)):
            allow_apply_refresh = bool_value(getattr(self.args, "allow_pre_planner_refresh_with_apply", False))
            requested_max_selected_moves = to_int(getattr(self.args, "max_selected_moves", 0), 0)
            target_egress = str(getattr(self.args, "target_egress", "") or "").strip()
            clearance_max_selected_moves = to_int(self.restore_barrier.get("clearance_max_selected_moves"), 0)
            apply_refresh_clearance = self.restore_barrier.get("apply_refresh_clearance") or {}
            allowed_targets = [str(item) for item in (apply_refresh_clearance.get("allowed_targets") or [])]
            governed_envelope_scope = (
                mode == "write"
                and allow_apply_refresh
                and bool(target_egress)
                and requested_max_selected_moves > 0
                and clearance_max_selected_moves > 0
                and requested_max_selected_moves <= clearance_max_selected_moves
                and target_egress in allowed_targets
                and bool_value(apply_refresh_clearance.get("generation_clearance"))
                and bool(apply_refresh_clearance.get("approved_atomic_execution_envelope_id"))
                and bool(apply_refresh_clearance.get("approved_atomic_execution_envelope_hash"))
                and bool(apply_refresh_clearance.get("approved_source_bundle_hash"))
            )
            bounded_apply_scope = (
                mode == "write"
                and bool(str(getattr(self.args, "user", "") or "").strip())
                and bool(target_egress)
                and requested_max_selected_moves == 1
            )
            if allow_apply_refresh and bounded_apply_scope:
                status.update({
                    "state": "APPLY_REFRESH_BOUNDED_ALLOWED",
                    "decision": "refresh_before_bounded_one_user_apply",
                    "blocked_actions": [],
                    "next_state": "load_refreshed_snapshots_for_bounded_apply",
                    "apply_refresh_scope": {
                        "user": str(getattr(self.args, "user", "") or ""),
                        "target_egress": str(getattr(self.args, "target_egress", "") or ""),
                        "max_selected_moves": 1,
                    },
                })
            elif governed_envelope_scope:
                status.update({
                    "state": "APPLY_REFRESH_GOVERNED_ENVELOPE_ALLOWED",
                    "decision": "refresh_before_governed_atomic_envelope_apply",
                    "blocked_actions": [],
                    "next_state": "load_refreshed_snapshots_for_governed_envelope_apply",
                    "apply_refresh_scope": {
                        "target_egress": target_egress,
                        "max_selected_moves": requested_max_selected_moves,
                        "clearance_max_selected_moves": clearance_max_selected_moves,
                        "approved_atomic_execution_envelope_id": str(apply_refresh_clearance.get("approved_atomic_execution_envelope_id") or ""),
                        "governance_owner": str(apply_refresh_clearance.get("owner") or ""),
                    },
                })
            else:
                blocked = ["apply", "selected_moves"]
                if allow_apply_refresh:
                    blocked = ["unbounded_apply_refresh", "selected_moves"]
                status.update({
                    "action": "block_refresh_and_apply_promotion",
                    "state": "SKIPPED_APPLY_FORBIDDEN",
                    "decision": "pre_planner_refresh_apply_requires_bounded_one_user_scope",
                    "stop_required": True,
                    "blocked_actions": blocked,
                    "next_state": "fail_closed_planner_output",
                    "required_scope": {
                        "mode": "write",
                        "user_required": True,
                        "target_egress_required": True,
                        "max_selected_moves": 1,
                        "or_governed_atomic_envelope_clearance": True,
                        "allow_pre_planner_refresh_with_apply": True,
                    },
                })
                return status

        command = str(getattr(self.args, "pre_planner_refresh_command", "") or "v7-intelligence-snapshot-refresh")
        cmd = [
            command,
            "--state-dir", str(self.state_dir),
            "--event-dir", str(self.event_dir),
            "--out-dir", str(self.intelligence_snapshot_root),
            "--quality-summary-file", str(Path(self.args.quality_summary_file)),
        ]
        if mode == "dry-run":
            cmd.append("--dry-run")
        timeout = max(1, to_int(getattr(self.args, "pre_planner_refresh_timeout_sec", 20), 20))
        status.update({
            "command": cmd,
            "timeout_sec": timeout,
            "action": "refresh_snapshots" if mode == "write" else "validate_refresh_without_write",
            "decision": "refresh_before_planner",
            "next_state": "load_refreshed_snapshots" if mode == "write" else "load_existing_snapshots_after_validation",
        })
        try:
            proc = subprocess.run(
                cmd,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=timeout,
            )
        except subprocess.TimeoutExpired as exc:
            status.update({
                "state": "REFRESH_TIMEOUT",
                "rc": None,
                "output": (exc.stdout or "")[-2000:] if isinstance(exc.stdout, str) else "",
                "decision": "freshness_unknown",
                "stop_required": True,
                "blocked_actions": ["selected_moves", "apply", "operator_visible_promotion"],
                "next_state": "fail_closed_planner_output",
            })
            return status
        except OSError as exc:
            status.update({
                "state": "REFRESH_EXCEPTION",
                "error": f"{exc.__class__.__name__}:{exc}",
                "decision": "freshness_unknown",
                "stop_required": True,
                "blocked_actions": ["selected_moves", "apply", "operator_visible_promotion"],
                "next_state": "fail_closed_planner_output",
            })
            return status

        output = (proc.stdout or "")[-4000:]
        status["rc"] = proc.returncode
        status["output"] = output
        payload: dict[str, Any] = {}
        try:
            parsed = json.loads(proc.stdout or "{}")
            if isinstance(parsed, dict):
                payload = parsed
        except json.JSONDecodeError:
            payload = {}
        status["refresh_result"] = payload
        source_stable = bool_value(payload.get("source_stable"))
        refresh_success = proc.returncode == 0 and source_stable
        if refresh_success:
            status.update({
                "state": "REFRESH_DRY_RUN_SUCCESS" if mode == "dry-run" else "REFRESH_SUCCESS",
                "decision": "freshness_refreshed" if mode == "write" else "refresh_path_validated",
                "stop_required": False,
                "blocked_actions": [],
                "next_state": "load_refreshed_snapshots" if mode == "write" else "load_existing_snapshots_after_validation",
                "snapshot_count": payload.get("snapshot_count", 0),
                "warnings": payload.get("warnings", []),
            })
            return status
        status.update({
            "state": "REFRESH_FAILED",
            "decision": "freshness_unknown",
            "stop_required": True,
            "blocked_actions": ["selected_moves", "apply", "operator_visible_promotion"],
            "next_state": "fail_closed_planner_output",
            "snapshot_count": payload.get("snapshot_count", 0),
            "warnings": payload.get("warnings", []),
        })
        if not payload and proc.returncode == 0:
            status["state"] = "REFRESH_OUTPUT_INVALID"
        elif not source_stable:
            status["state"] = "SOURCE_VOLATILE"
        return status

