def n10_small_cohort_authority_request_only(args: argparse.Namespace) -> dict[str, Any]:
    """Produce an exact N10 cohort request from one fresh prepared class.

    No source, target or user may be named by the caller.  The only eligible
    cohort is a 2--4 member slice already emitted by the Matrix-owned Planner
    projection.  A larger coherent source class may supply that bounded slice:
    the existing owner deterministically selects the uniquely smallest lawful
    class, never an operator-selected member list.  This is preparation,
    never an execution or a target choice.
    """
    forbidden = []
    for name in ("user", "source_egress", "target_egress"):
        if str(getattr(args, name, "") or "").strip():
            forbidden.append(name)
    if bool_value(getattr(args, "apply", False)):
        forbidden.append("apply")
    reuse = reuse_current_prepared_class_projection(args)
    projection = reuse.get("prepared_class_decisions") or {}
    raw_policy = read_json(Path(args.policy_file), {})
    raw_budget = raw_policy.get("authority_budget") if isinstance(raw_policy.get("authority_budget"), dict) else {}
    existing = raw_budget.get("current_action_class_contract") if isinstance(raw_budget.get("current_action_class_contract"), dict) else {}
    existing_use = existing.get("one_use_consumption") if isinstance(existing.get("one_use_consumption"), dict) else {}
    blockers = list(forbidden)
    if not reuse.get("ok"):
        blockers.extend(str(item) for item in (reuse.get("blockers") or ["prepared_projection_not_fresh"]))
    if str(existing_use.get("state") or "") == "ISSUED" and parse_ts(existing.get("expires_at")) > datetime.now(timezone.utc).timestamp():
        blockers.append("n10_unconsumed_current_action_contract_exists")
    classes = [
        row for row in (projection.get("classes") or [])
        if isinstance(row, dict)
        and to_int(row.get("member_count"), 0) >= 2
        and 2 <= len([item for item in (row.get("ordinary_member_slice") or []) if str(item)]) <= 4
        and str(row.get("source_channel") or "")
        and str(row.get("target_channel") or "")
        and str(row.get("source_channel") or "") != str(row.get("target_channel") or "")
    ]
    # A bounded N10 no-failure migration may use a deterministic 2--4 member
    # slice from a larger current semantic class.  Select the uniquely
    # smallest such class to minimise blast radius; a tie remains STOP_SAFE
    # rather than being resolved by a hidden lexical or operator choice.
    classes.sort(key=lambda row: (to_int(row.get("member_count"), 0), str(row.get("class_id") or "")))
    smallest_count = to_int(classes[0].get("member_count"), 0) if classes else 0
    smallest = [
        row for row in classes
        if to_int(row.get("member_count"), 0) == smallest_count
    ]
    selected = smallest[0] if len(smallest) == 1 else {}
    if not classes:
        blockers.append("n10_small_cohort_prepared_class_missing")
    elif len(smallest) > 1:
        blockers.append("n10_small_cohort_prepared_class_ambiguous")
    members = sorted({str(item) for item in (selected.get("ordinary_member_slice") or []) if str(item)})
    source = str(selected.get("source_channel") or "")
    users = {str(row.get("ip") or ""): row for row in parse_registry(Path(args.state_dir) / "users.registry")}
    generation: dict[str, Any] = {}
    if selected:
        if len(members) not in range(2, 5) or any(
            not users.get(ip)
            or bool_value(users[ip].get("certification_user"))
            or str(users[ip].get("current") or "") != source
            for ip in members
        ):
            blockers.append("n10_small_cohort_member_source_truth_changed")
        generation = n10_small_cohort_source_generation(args, members, source) if not blockers else {}
        if not all(str(generation.get(key) or "") for key in ("planner_generation_id", "source_bundle_hash", "snapshot_bundle_hash", "selected_move_hash")):
            blockers.append("n10_small_cohort_owner_generation_missing")
    authority_class = normalize_authority_class(raw_budget.get("certified_authority_class") or raw_budget.get("authority_class") or "CANARY")
    template = {
        "active_program": "V7_SERVICE_FAILURE_AUTOMATION_EVOLUTION_PROGRAM_V1",
        "action_class": operator_execution.N10_SMALL_COHORT_ACTION_CLASS,
        "max_authority_class": authority_class, "authority_ceiling": authority_class,
        "policy_generation_hash": sha256_file(Path(args.policy_file)),
        "max_users": len(members), "max_concurrent_transactions": 1, "max_ttl_seconds": 900,
        "subject": {"user_ips": members},
        "scope": {"source_egress": source, "target_egress": "", "target_selection": operator_execution.N10_FRESH_PLANNER_TARGET_SELECTION, "max_users": len(members), "max_concurrent_transactions": 1, "prepared_class_id": str(selected.get("class_id") or ""), "membership_fingerprint": str(selected.get("membership_fingerprint") or ""), "member_slice_fingerprint": str(selected.get("ordinary_member_slice_fingerprint") or "")},
        "incident_generation": {"incident_id": "N10_SMALL_COHORT_NO_FAILURE_INJECTION", "incident_generation": str(generation.get("planner_generation_id") or "")},
        "source_generation": generation,
        "verification_contract": {"owner": "tools/v7-users-autoswitch", "required": True, "immediate_and_temporal_observation": True, "success_criteria": "every_member_exact_route_kernel_and_current_profile_required_services_server_side_s11_at_or_below_8000ms"},
        "rollback_containment_contract": {"owner": "tools/v7-users-autoswitch", "required": True, "triggered_by_verifier": True, "direct_terminal_manufacture_forbidden": True},
        "cooldown": {"required": True, "seconds": 180}, "anti_flap": {"required": True, "same_source_target_repeat_forbidden": True},
        "stop_conditions": sorted(operator_execution.CURRENT_ACTION_CLASS_REQUIRED_STOP_CONDITIONS | {"ordinary_scope_expansion_forbidden", "cohort_member_drift_forbidden", "cohort_target_divergence_forbidden", "first_member_failure_stops_remaining_forwards"}),
    }
    request = operator_execution.build_current_action_class_contract_authority_request(template, issue_preflight={"ready": not blockers, "blockers": sorted(set(blockers))})
    registration = {"status": "NOT_REGISTERED"}
    if not blockers:
        try:
            registration = operator_execution.register_current_action_class_contract_request(request, audit_store=args.action_class_audit_store, producer_id="tools/v7-users-autoswitch:n10-small-cohort")
        except operator_execution.PacketError as exc:
            blockers.append(str(exc))
    return {"schema_version": "v7.n10-small-cohort-authority-request.v1", "status": "N10_SMALL_COHORT_AUTHORITY_REQUEST_READY" if not blockers else "STOP_SAFE_PRECONDITION", "ok": not blockers, "blockers": sorted(set(blockers)), "request": request, "registration": registration, "prepared_class": {"class_id": selected.get("class_id", ""), "members": members, "source": source, "target_is_unbound": True}, "next_required_consumer": "existing operator-execution Authority owner", "reentry": "prepared cohort -> fresh existing Planner -> Candidate -> Packet -> Lease -> Barrier -> existing v7-user-switch", "forbidden_effects": {"policy_write": False, "authority_granted": False, "runtime_apply": False, "routing_mutation": False, "user_movement": 0}}


def routing_core_certification_authority_request_only(args: argparse.Namespace) -> dict[str, Any]:
    """Build the exact RESET-M6 one-use request from existing truth owners."""
    user_ip = str(getattr(args, "user", "") or "")
    source = str(getattr(args, "source_egress", "") or "")
    target = str(getattr(args, "target_egress", "") or "")
    state_dir = Path(args.state_dir)
    users = parse_registry(state_dir / "users.registry")
    egress = parse_registry(state_dir / "egress.registry")
    user_rows = [row for row in users if str(row.get("ip") or "") == user_ip]
    target_rows = [row for row in egress if str(row.get("id") or "") == target]
    blockers: list[str] = []
    if len(user_rows) != 1 or str((user_rows[0] if user_rows else {}).get("current") or "") != source:
        blockers.append("core_certification_user_source_truth_mismatch")
    target_row = target_rows[0] if len(target_rows) == 1 else {}
    if len(target_rows) != 1:
        blockers.append("core_certification_target_truth_missing_or_duplicate")
    if not bool_value(target_row.get("enabled", "1")) or str(target_row.get("state") or "enabled").lower() == "disabled":
        blockers.append("core_certification_target_not_enabled")
    if to_int(getattr(args, "max_selected_moves", 0), 0) != 1:
        blockers.append("core_certification_exact_one_user_scope_required")
    policy_path = Path(args.policy_file)
    source_material = {
        "users_registry": sha256_file(state_dir / "users.registry"),
        "egress_registry": sha256_file(state_dir / "egress.registry"),
        "service_preferences": sha256_file(state_dir / "service-preferences.json"),
        "policy": sha256_file(policy_path),
        "org_policy": sha256_file(Path(args.org_policy_file)),
    }
    snapshot_material = {
        "service_matrix": sha256_file(state_dir / "service-matrix.json"),
        "quality_summary": sha256_file(Path(args.quality_summary_file)),
        "load_summary": sha256_file(Path(args.load_summary_file)),
    }
    if not all(source_material.values()) or not all(snapshot_material.values()):
        blockers.append("core_certification_owner_generation_missing")
    generation = sha256_json(source_material)
    from admin_core.intelligence_snapshots import read_snapshot_bundle
    snapshot_results = read_snapshot_bundle(
        Path(args.intelligence_snapshot_root),
        list(RUNTIME_INTELLIGENCE_SNAPSHOT_FAMILIES),
    )
    snapshot_source_hashes = {
        str(name): dict(result.payload.get("source_hashes") or {})
        for name, result in sorted(snapshot_results.items())
        if isinstance(result.payload, dict)
        and isinstance(result.payload.get("source_hashes"), dict)
    }
    contract_source_bundle_hash = sha256_json({
        "planner_generation_id": generation,
        "source_hashes": snapshot_source_hashes,
    })
    contract_snapshot_bundle_hash = sha256_json({
        str(name): {
            "path": str(result.path),
            "source_hashes": dict(result.payload.get("source_hashes") or {}),
            "validation_ok": bool(result.validation.ok),
        }
        for name, result in sorted(snapshot_results.items())
    })
    selected_hash = sha256_json({
        "user_ip": user_ip,
        "source_egress": source,
        "target_egress": target,
    })
    context = {
        "chosen": {"user_ip": user_ip, "current_egress": source, "recommended_egress": target},
        "incident_generation": {
            "incident_id": "RESET_M6_CONTROLLED_MIGRATION_SINGLE_WRITER_FENCED_CUTOVER",
            "incident_generation": generation,
        },
        "source_generation": {
            "planner_generation_id": generation,
            "source_bundle_hash": contract_source_bundle_hash,
            "snapshot_bundle_hash": contract_snapshot_bundle_hash,
            "selected_move_hash": selected_hash,
        },
    }
    request = action_class_contract_reconciliation_request(
        {}, policy_path=policy_path, availability_first_context=context,
        active_program="V7_SYSTEM_RESET_AND_ROUTING_CORE_MIGRATION_PROGRAM_V1",
    )
    if blockers:
        request["issue_preflight"] = {"ready": False, "blockers": sorted(set(blockers))}
        request["authority_decision_request"]["issue_preflight"] = copy.deepcopy(request["issue_preflight"])
    return {
        "schema_version": "v7.routing-core-certification-authority-entrypoint.v1",
        "status": "PASS" if not blockers else "STOP_SAFE_PRECONDITION",
        "ok": not blockers,
        "result": request,
        "forbidden_effects": {
            "policy_write": False, "authority_granted": False,
            "runtime_apply": False, "routing_mutation": False, "user_movement": 0,
        },
    }


def _routing_core_scoped_route_verify(
    state_dir: Path, user_ip: str, expected_egress: str,
) -> subprocess.CompletedProcess[str]:
    """Verify one exact assignment and kernel route without planner startup."""
    argv = ["v7-users-autoswitch", "--routing-core-certification-execute"]
    users = [row for row in parse_registry(state_dir / "users.registry") if str(row.get("ip") or "") == user_ip]
    targets = [row for row in parse_registry(state_dir / "egress.registry") if str(row.get("id") or "") == expected_egress]
    lines = [f"user_ip={user_ip}", f"expected_egress={expected_egress}"]
    if len(users) != 1 or len(targets) != 1:
        return subprocess.CompletedProcess(argv, 1, stdout="scoped route truth missing or duplicate\n")
    user, target = users[0], targets[0]
    table = str(user.get("table") or "")
    interface = str(target.get("interface") or "")
    if str(user.get("current") or "") != expected_egress or not table or not interface:
        return subprocess.CompletedProcess(argv, 1, stdout="registry assignment or route identity mismatch\n")
    try:
        rule = subprocess.run(["ip", "rule", "show"], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False, timeout=10)
        route = subprocess.run(["ip", "route", "show", "table", table], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False, timeout=10)
        route_get = subprocess.run(["ip", "route", "get", "8.8.8.8", "from", user_ip, "iif", "wg0"], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(argv, 1, stdout=f"scoped route verification command failed: {exc}\n")
    rule_ok = any(fragment in rule.stdout for fragment in (f"from {user_ip} lookup {table}", f"from {user_ip}/32 lookup {table}"))
    route_ok = f"default dev {interface}" in route.stdout
    route_get_ok = f"dev {interface}" in route_get.stdout
    lines.extend([
        f"policy_rule={'OK' if rule_ok else 'FAIL'}",
        f"table_default={'OK' if route_ok else 'FAIL'}",
        f"route_get={'OK' if route_get_ok else 'FAIL'}",
    ])
    return subprocess.CompletedProcess(argv, 0 if rule_ok and route_ok and route_get_ok else 1, stdout="\n".join(lines) + "\n")


def routing_core_certification_execute_only(args: argparse.Namespace) -> dict[str, Any]:
    """Run the bounded RESET-M6 cutover through existing effect owners only."""
    started_ns = time.monotonic_ns()
    state_dir = Path(args.state_dir)
    policy_path = Path(args.policy_file)
    control_path = Path(args.execution_control_file)
    user_ip = str(args.user or "")
    source = str(args.source_egress or "")
    target = str(args.target_egress or "")
    selected_hash = sha256_json({"user_ip": user_ip, "source_egress": source, "target_egress": target})
    blockers: list[str] = []
    if not args.apply:
        blockers.append("routing_core_certification_execute_requires_explicit_apply")
    if not args.verify or not args.rollback_on_verify_fail:
        blockers.append("routing_core_certification_verify_and_rollback_required")
    if not SAFE_IP_RE.match(user_ip) or not source or not target or source == target:
        blockers.append("routing_core_certification_exact_scope_invalid")
    if to_int(args.max_selected_moves, 0) != 1:
        blockers.append("routing_core_certification_exact_one_user_scope_required")
    users = [row for row in parse_registry(state_dir / "users.registry") if str(row.get("ip") or "") == user_ip]
    targets = [row for row in parse_registry(state_dir / "egress.registry") if str(row.get("id") or "") == target]
    user = users[0] if len(users) == 1 else {}
    target_row = targets[0] if len(targets) == 1 else {}
    if len(users) != 1 or str(user.get("current") or "") != source:
        blockers.append("routing_core_certification_user_source_truth_mismatch")
    if len(targets) != 1 or not str(target_row.get("interface") or ""):
        blockers.append("routing_core_certification_target_truth_missing")
    if target_row and (not bool_value(target_row.get("enabled", "1")) or str(target_row.get("state") or "enabled").lower() == "disabled"):
        blockers.append("routing_core_certification_target_not_enabled")
    policy = read_json(policy_path, {})
    budget = policy.get("authority_budget") if isinstance(policy.get("authority_budget"), dict) else {}
    authority = runtime_authority_contract_status(
        budget, prepared_class="CANARY", certified_class="CANARY",
        standing_policy_contract={}, authority_audit_records=[],
    )
    contract = budget.get("current_action_class_contract") if isinstance(budget.get("current_action_class_contract"), dict) else {}
    provenance = authority.get("provenance") if isinstance(authority.get("provenance"), dict) else {}
    contract_source = contract.get("source_generation") if isinstance(contract.get("source_generation"), dict) else {}
    if authority.get("blockers"):
        blockers.extend(f"authority:{item}" for item in authority.get("blockers") or [])
    if provenance.get("strict_provenance_contract") is not True or str(contract.get("active_program") or "") != "V7_SYSTEM_RESET_AND_ROUTING_CORE_MIGRATION_PROGRAM_V1":
        blockers.append("routing_core_certification_exact_reset_contract_required")
    if str((contract.get("subject") or {}).get("user_ip") or "") != user_ip or {
        "source_egress": source, "target_egress": target,
    } != {
        "source_egress": str((contract.get("scope") or {}).get("source_egress") or ""),
        "target_egress": str((contract.get("scope") or {}).get("target_egress") or ""),
    }:
        blockers.append("routing_core_certification_contract_scope_mismatch")
    if str(contract_source.get("selected_move_hash") or "") != selected_hash:
        blockers.append("routing_core_certification_selected_move_hash_mismatch")
    from admin_core.intelligence_snapshots import read_snapshot_bundle
    snapshot_results = read_snapshot_bundle(Path(args.intelligence_snapshot_root), list(RUNTIME_INTELLIGENCE_SNAPSHOT_FAMILIES))
    snapshot_sources = {
        str(name): dict(result.payload.get("source_hashes") or {})
        for name, result in sorted(snapshot_results.items())
        if isinstance(result.payload, dict) and isinstance(result.payload.get("source_hashes"), dict)
    }
    current_source_bundle = sha256_json({
        "planner_generation_id": str(contract_source.get("planner_generation_id") or ""),
        "source_hashes": snapshot_sources,
    })
    current_snapshot_bundle = sha256_json({
        str(name): {"path": str(result.path), "source_hashes": dict(result.payload.get("source_hashes") or {}), "validation_ok": bool(result.validation.ok)}
        for name, result in sorted(snapshot_results.items())
    })
    if current_source_bundle != str(contract_source.get("source_bundle_hash") or ""):
        blockers.append("routing_core_certification_source_bundle_changed")
    if current_snapshot_bundle != str(contract_source.get("snapshot_bundle_hash") or ""):
        blockers.append("routing_core_certification_snapshot_bundle_changed")
    operation_id = "resetm6_" + sha256_json({"contract_id": contract.get("contract_id"), "selected_move_hash": selected_hash})[:24]
    now = datetime.now(timezone.utc)
    core_envelope = {
        "schema": routing_core.CORE_INPUT_SCHEMA,
        "generation": str(contract_source.get("planner_generation_id") or ""),
        "observed_at": now.isoformat(), "max_age_ms": 5000,
        "scope": {"source": source, "users": [user_ip]},
        "assignments": {user_ip: source},
        "targets": {target: {"healthy": not blockers, "capacity": max(1, to_int(target_row.get("capacity_users"), 1)), "assigned": max(0, to_int(target_row.get("users"), 0))}},
        "policy": {"generation": str(contract_source.get("planner_generation_id") or ""), "allowed_targets": [target], "capacity_reserve": 0},
        "authority": {"generation": str(contract.get("contract_id") or ""), "permitted_users": [user_ip], "max_users": 1},
        "operation": {"id": operation_id, "lease_id": str(contract.get("contract_id") or ""), "fencing_token": str(contract.get("contract_hash") or ""), "idempotency_key": operation_id},
    }
    core_result: dict[str, Any] = {}
    if not blockers:
        try:
            core_result = routing_core.run_shadow(core_envelope, now=now)
        except routing_core.RoutingCoreContractError as exc:
            blockers.append(exc.status)
    expected_move = [{"user": user_ip, "source": source, "target": target}]
    if not blockers and (core_result.get("decision") or {}).get("moves") != expected_move:
        blockers.append("routing_core_certification_decision_mismatch")
    base = {
        "schema_version": "v7.routing-core-certification-execution.v1",
        "operation_id": operation_id, "user_ip": user_ip, "source": source, "target": target,
        "selected_move_hash": selected_hash, "core_decision": core_result,
        "legacy_planner_initialized": False, "member_rows_scanned": 1,
        "effect_writer": "existing v7-user-switch", "contract_owner": operator_execution.CURRENT_ACTION_CLASS_CONTRACT_ISSUING_OWNER,
    }
    if blockers:
        return {**base, "status": "STOP_SAFE", "blockers": sorted(set(blockers)), "user_movement": 0, "runtime_mutation": False}
    control = operator_execution.build_autonomous_execution_control_state(
        False, actor="tools/v7-users-autoswitch:RESET-M6", reason="reset_m6_exact_core_certification",
        operation_id=operation_id, selected_move_hash=selected_hash, action_class="USER_SWITCH",
        source_bundle_hash=current_source_bundle, snapshot_bundle_hash=current_snapshot_bundle, max_users=1,
    )
    operator_execution.write_json_atomic(control_path, control)
    writer: subprocess.CompletedProcess[str] | None = None
    verify: subprocess.CompletedProcess[str] | None = None
    rollback: subprocess.CompletedProcess[str] | None = None
    consumption: dict[str, Any] = {}
    try:
        decision = operator_execution.autonomous_execution_control_decision(
            control_path, mutation_kind="forward", action_class="USER_SWITCH",
            expected_generation=str(control.get("generation") or ""), operation_id=operation_id,
            selected_move_hash=selected_hash, source_bundle_hash=current_source_bundle,
            snapshot_bundle_hash=current_snapshot_bundle, max_users=1,
        )
        if not decision.get("allowed_forward_mutation"):
            return {**base, "status": "STOP_SAFE", "blockers": decision.get("blockers") or ["execution_control_denied"], "user_movement": 0, "runtime_mutation": False}
        consumed = operator_execution.consume_current_action_class_contract_to_policy(
            policy_path, contract_id=str(contract.get("contract_id") or ""), contract_hash=str(contract.get("contract_hash") or ""),
            subject={"user_ip": user_ip}, scope={"source_egress": source, "target_egress": target},
            source_generation=dict(contract_source), operation_id=operation_id,
            audit_store=args.action_class_audit_store, actor_id="tools/v7-users-autoswitch:RESET-M6",
        )
        consumption = dict(consumed.get("consumption") or {})
        env = os.environ.copy()
        env.update({
            "V7_SWITCH_REASON": "autoswitch_reset_m6_core_certification", "V7_EXECUTION_CONTROL_GENERATION": str(control.get("generation") or ""),
            "V7_EXECUTION_MUTATION_KIND": "forward", "V7_EXECUTION_OPERATION_ID": operation_id, "V7_EXECUTION_ACTION_CLASS": "USER_SWITCH",
            "V7_EXECUTION_SELECTED_MOVE_HASH": selected_hash, "V7_EXECUTION_SOURCE_BUNDLE_HASH": current_source_bundle,
            "V7_EXECUTION_SNAPSHOT_BUNDLE_HASH": current_snapshot_bundle, "V7_EXECUTION_MAX_USERS": "1",
        })
        writer = subprocess.run(["v7-user-switch", user_ip, target], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False, timeout=30, env=env)
        if writer.returncode == 0:
            verify = _routing_core_scoped_route_verify(state_dir, user_ip, target)
        if writer.returncode == 0 and verify is not None and verify.returncode != 0:
            env.update({"V7_EXECUTION_MUTATION_KIND": "rollback", "V7_EXECUTION_ROLLBACK_CERTIFIED": "1"})
            rollback = subprocess.run(["v7-user-switch", user_ip, source], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False, timeout=30, env=env)
        success = writer.returncode == 0 and verify is not None and verify.returncode == 0
        return {
            **base, "status": "SUCCESS" if success else "ROLLBACK_COMPLETED" if rollback is not None and rollback.returncode == 0 else "STOP_SAFE",
            "contract_consumption": consumption,
            "writer": {"rc": writer.returncode, "output": (writer.stdout or "")[-4000:]},
            "verify": {"rc": verify.returncode, "output": (verify.stdout or "")[-4000:]} if verify is not None else {},
            "rollback": {"rc": rollback.returncode, "output": (rollback.stdout or "")[-4000:]} if rollback is not None else {},
            "user_movement": 1 if success else 0,
            "runtime_mutation": bool(writer.returncode == 0),
            "elapsed_ms": round((time.monotonic_ns() - started_ns) / 1_000_000.0, 3),
        }
    except (operator_execution.PacketError, OSError, subprocess.TimeoutExpired) as exc:
        return {**base, "status": "STOP_SAFE", "blockers": [str(exc)], "contract_consumption": consumption, "user_movement": 0, "runtime_mutation": bool(writer and writer.returncode == 0)}
    finally:
        operator_execution.finalize_autonomous_execution_control_window(
            control_path, expected_generation=str(control.get("generation") or ""), operation_id=operation_id,
            actor="tools/v7-users-autoswitch:RESET-M6", reason="reset_m6_core_certification_terminal_open",
            force_fail_closed_open=True,
        )


def ct_m0f_standing_source_selection_only(
    args: argparse.Namespace,
    *,
    precomputed_target_diagnostic: Optional[dict[str, Any]] = None,
    precomputed_service_failure_events: Optional[list[dict[str, Any]]] = None,
    precomputed_audit_records: Optional[list[dict[str, Any]]] = None,
) -> dict[str, Any]:
    """Select one current source through the existing controlled-pool owner.

    This is a compact projection, not another source registry or planner.  It
    prevents the downstream governed planner from choosing an unrelated
    certification identity before the standing envelope can validate it.
    """
    state_dir = Path(args.state_dir)
    users = parse_registry(state_dir / "users.registry")
    egress_rows = parse_registry(state_dir / "egress.registry")
    binding_evidence_cache: dict[str, Any] = {
        "users": users,
        "egress_rows": egress_rows,
    }
    if isinstance(precomputed_service_failure_events, list):
        binding_evidence_cache["service_failure_events"] = [
            dict(row)
            for row in precomputed_service_failure_events
            if isinstance(row, dict)
        ]
    # A canonical certification-only Matrix failure plus an already validated
    # prepared target diagnostic contains every fact needed to identify the
    # exact current source. Avoid rebuilding the broad certification campaign
    # pool on this hard-failure hot path; the same registry and event owners
    # below still prove isolation, identity, reservation and causal binding.
    projections: list[dict[str, Any]] = []
    fast_failed_source_projection_reused = False
    if (
        isinstance(precomputed_target_diagnostic, dict)
        and precomputed_target_diagnostic.get("ok") is True
    ):
        for registry in egress_rows:
            source_id = str(registry.get("id") or "")
            if not source_id:
                continue
            source_users = [
                row for row in users
                if str(row.get("current") or "") == source_id
                and bool_value(row.get("enabled", "1"))
            ]
            certification_users = [
                row for row in source_users
                if bool_value(row.get("certification_user"))
            ]
            non_certification_users = [
                row for row in source_users
                if not bool_value(row.get("certification_user"))
            ]
            exact_execution_contract = (
                bool_value(registry.get("controlled_certification_source"))
                and str(registry.get("type") or "") == "interface"
                and str(registry.get("reservation_owner") or "")
                == "operator_execution_governance"
                and bool_value(registry.get("execution_reserved"))
                and bool_value(registry.get("canary_reserved"))
                and not bool_value(registry.get("autoswitch_allowed"))
                and not bool_value(registry.get("rebalance_allowed"))
                and str(
                    registry.get("production_assignment_allowed") or ""
                ).lower() in {"0", "false", "no"}
            )
            if (
                not exact_execution_contract
                or not certification_users
                or non_certification_users
            ):
                continue
            binding = (
                ct_m0f_certification_only_matrix_failure_binding_projection(
                    state_dir,
                    source_id,
                    event_dir=Path(
                        getattr(args, "event_dir", "")
                        or state_dir / "events"
                    ),
                    evidence_cache=binding_evidence_cache,
                )
            )
            if not binding.get("ok"):
                continue
            baseline_health = controlled_certification_source_health_status(
                state_dir, source_id,
            )
            if bool(baseline_health.get("ok")):
                continue
            source_group = str(registry.get("certification_group") or "")
            group_aligned = [
                row for row in certification_users
                if not source_group
                or str(row.get("certification_group") or "") == source_group
            ]
            if not group_aligned:
                continue
            projections.append({
                "source_id": source_id,
                "certification_group": source_group,
                "enabled_certification_users_on_source": len(
                    certification_users
                ),
                "group_aligned_certification_users_on_source": len(
                    group_aligned
                ),
                "enabled_non_certification_users_on_source": 0,
                "source_isolated_for_controlled_failure": True,
                "baseline_health": baseline_health,
                "controlled_condition_active": not bool_value(
                    registry.get("enabled", "1")
                ),
                "projection_origin": (
                    "current_matrix_failure_binding_plus_existing_"
                    "execution_contract"
                ),
                "active_service_failure_binding": binding,
            })
        projections.sort(key=lambda row: str(row.get("source_id") or ""))
        fast_failed_source_projection_reused = bool(projections)
    if not projections:
        pool = controlled_certification_pool_status(state_dir)
        projections = [
            row
            for row in (pool.get("active_source_projections") or [])
            if (
                isinstance(row, dict)
                and str(row.get("source_id") or "")
                and bool(row.get("source_isolated_for_controlled_failure"))
                and int(
                    row.get("enabled_non_certification_users_on_source") or 0
                ) == 0
            )
        ]
        # This selector needs only the active controlled-source projection.
        # Do not retain the broad campaign inventory while later invoking the
        # existing target diagnostic.
        del pool
    projected_source_ids = {
        str(row.get("source_id") or "") for row in projections
    }
    # The controlled-condition owner deliberately disables the isolated
    # EXECUTION_ONLY source.  Such a source is consequently absent from the
    # pool's *active* projection, but that must not erase the already prepared
    # failure lineage before the next ordinary Matrix consumer can act on it.
    # Re-project only the exact existing-owner execution contract from current
    # registries and current Matrix truth; this is not a second source owner.
    for registry in egress_rows:
        source_id = str(registry.get("id") or "")
        if not source_id or source_id in projected_source_ids:
            continue
        source_users = [
            row for row in users
            if str(row.get("current") or "") == source_id
            and bool_value(row.get("enabled", "1"))
        ]
        certification_users = [
            row for row in source_users
            if bool_value(row.get("certification_user"))
        ]
        non_certification_users = [
            row for row in source_users
            if not bool_value(row.get("certification_user"))
        ]
        deliberately_disabled = (
            not bool_value(registry.get("enabled", "1"))
            or str(registry.get("state") or "").lower()
            in {"disabled", "maintenance"}
        )
        exact_execution_contract = (
            bool_value(registry.get("controlled_certification_source"))
            and str(registry.get("type") or "") == "interface"
            and str(registry.get("reservation_owner") or "")
            == "operator_execution_governance"
            and bool_value(registry.get("execution_reserved"))
            and bool_value(registry.get("canary_reserved"))
            and not bool_value(registry.get("autoswitch_allowed"))
            and not bool_value(registry.get("rebalance_allowed"))
            and str(
                registry.get("production_assignment_allowed") or ""
            ).lower() in {"0", "false", "no"}
        )
        if not (
            deliberately_disabled
            and exact_execution_contract
            and len(certification_users) == 1
            and not non_certification_users
        ):
            continue
        baseline_health = controlled_certification_source_health_status(
            state_dir, source_id,
        )
        source_group = str(registry.get("certification_group") or "")
        group_aligned = [
            row for row in certification_users
            if not source_group
            or str(row.get("certification_group") or "") == source_group
        ]
        projections.append({
            "source_id": source_id,
            "certification_group": source_group,
            "enabled_certification_users_on_source": 1,
            "group_aligned_certification_users_on_source": len(group_aligned),
            "enabled_non_certification_users_on_source": 0,
            "source_isolated_for_controlled_failure": True,
            "baseline_health": baseline_health,
            "controlled_condition_active": True,
            "controlled_condition_owner_state": str(
                registry.get("state") or "disabled"
            ),
            "projection_origin": (
                "current_disabled_execution_contract_registry_plus_matrix"
            ),
        })
    failed_ready = []
    stale_or_unbound_failed_sources = []
    for row in projections:
        source_id = str(row.get("source_id") or "")
        certification_scope = int(
            row.get("enabled_certification_users_on_source") or 0
        )
        controlled_condition = bool(row.get("controlled_condition_active"))
        source_failed = not bool((row.get("baseline_health") or {}).get("ok"))
        if certification_scope < 1 or not (controlled_condition or source_failed):
            continue
        if controlled_condition and not source_failed:
            # The deliberate condition owner operates on a whole source.  The
            # CT-M0F envelope permits exactly one certification identity, so
            # this is a *blast-radius* gate, not merely a later move limit.
            if certification_scope == 1:
                failed_ready.append(row)
            else:
                stale_or_unbound_failed_sources.append({
                    "source_id": source_id,
                    "classification": (
                        "CONTROLLED_CONDITION_BLAST_RADIUS_EXCEEDS_"
                        "CT_M0F_MAX_USERS"
                    ),
                    "certification_scope": certification_scope,
                })
            continue
        # A real current Matrix failure has a different existing-owner
        # envelope: the source may contain a bounded certification cohort,
        # while this selector still chooses and later Packet/lease-freezes
        # exactly one identity.  Do not let the historical prepared-condition
        # marker turn a real failure into a false "all members must already be
        # one" rejection.
        # A certification-only Matrix event deliberately has no ordinary
        # passive scope.  Preserve that ordinary-customer fence, then reuse
        # the same event for the distinct existing one-user controlled path.
        # Prefer it before loading the potentially large ordinary L3 history.
        # It is stricter than an ordinary binding and applies only if the
        # immutable Matrix event and current certification scope match.
        controlled_matrix_binding = (
            ct_m0f_certification_only_matrix_failure_binding_projection(
                state_dir,
                source_id,
                event_dir=Path(
                    getattr(args, "event_dir", "") or state_dir / "events"
                ),
                evidence_cache=binding_evidence_cache,
            )
        )
        binding = controlled_matrix_binding
        registry = next(
            (
                item for item in egress_rows
                if str(item.get("id") or "") == source_id
            ),
            {},
        )
        certification_only_source = (
            int(row.get("enabled_non_certification_users_on_source") or 0) == 0
            and bool_value(registry.get("controlled_certification_source"))
        )
        # A controlled certification-only source has no ordinary passive
        # cohort by design.  If its stricter Matrix evidence is stale or
        # contradictory, do not scan the unrelated ordinary L3 history as a
        # fallback: that cannot make this source safe to execute and used to
        # consume enough memory for the OS to kill the read-only selector.
        if not binding.get("ok") and not certification_only_source:
            binding = ct_m0f_active_service_failure_binding_projection(
                state_dir,
                source_id,
                event_dir=Path(
                    getattr(args, "event_dir", "") or state_dir / "events"
                ),
                evidence_cache=binding_evidence_cache,
            )
        # A genuine live incident may retain a larger unresolved cohort: the
        # transaction remains one user, while the incident owner supplies the
        # current source scope.  A stale passive observation must never starve
        # the controlled-condition predecessor by being selected first.
        if binding.get("ok") or not binding.get("requires_binding"):
            failed_ready.append({
                **row,
                "active_service_failure_binding": binding,
            })
        else:
            stale_or_unbound_failed_sources.append({
                "source_id": source_id,
                "classification": "STALE_OR_UNBOUND_PASSIVE_FAILURE",
                "certification_scope": certification_scope,
                "binding_status": str(binding.get("status") or ""),
                "binding_blockers": list(binding.get("blockers") or []),
            })
    failed_ready.sort(key=lambda row: str(row.get("source_id") or ""))
    preparation_sources = []
    for row in projections:
        source_id = str(row.get("source_id") or "")
        registry = next(
            (
                item for item in egress_rows
                if str(item.get("id") or "") == source_id
            ),
            {},
        )
        if (
            int(row.get("enabled_certification_users_on_source") or 0) == 0
            and bool((row.get("baseline_health") or {}).get("ok"))
            and bool_value(registry.get("controlled_certification_source"))
            and str(registry.get("type") or "") == "interface"
            and str(registry.get("reservation_owner") or "")
            == "operator_execution_governance"
            and bool_value(registry.get("execution_reserved"))
            and bool_value(registry.get("canary_reserved"))
            and not bool_value(registry.get("autoswitch_allowed"))
            and not bool_value(registry.get("rebalance_allowed"))
            and str(
                registry.get("production_assignment_allowed") or ""
            ).lower() in {"0", "false", "no"}
        ):
            preparation_sources.append(row)
    preparation_sources.sort(key=lambda row: str(row.get("source_id") or ""))
    healthy_baselines = [
        row for row in projections
        if (
            int(row.get("enabled_certification_users_on_source") or 0) > 0
            and int(row.get("group_aligned_certification_users_on_source") or 0) > 0
            and bool((row.get("baseline_health") or {}).get("ok"))
            and not bool(row.get("controlled_condition_active"))
        )
    ]
    healthy_baselines.sort(
        key=lambda row: (
            -int(row.get("group_aligned_certification_users_on_source") or 0),
            -int(row.get("enabled_certification_users_on_source") or 0),
            str(row.get("source_id") or ""),
        )
    )
    # A completed standing sample restores its exact certification identity to
    # the isolated execution source.  Requiring a *second* healthy controlled
    # source before the next sample would make a one-source Polygon campaign
    # impossible and would add a pointless setup cutover before every
    # measurement.  Admit the already-established baseline in place only for
    # the exact execution-only contract, exactly one group-aligned
    # certification identity and zero ordinary identities.  The distinct
    # target is still selected and admitted below by the existing target and
    # standing-policy owners; this projection grants no apply by itself.
    in_place_preparation_sources = []
    for row in healthy_baselines:
        source_id = str(row.get("source_id") or "")
        registry = next(
            (
                item for item in egress_rows
                if str(item.get("id") or "") == source_id
            ),
            {},
        )
        exact_execution_contract = (
            bool_value(registry.get("controlled_certification_source"))
            and str(registry.get("type") or "") == "interface"
            and str(registry.get("role") or "").upper() == "EXECUTION_ONLY"
            and str(registry.get("reservation_owner") or "")
            == "operator_execution_governance"
            and bool_value(registry.get("execution_reserved"))
            and bool_value(registry.get("canary_reserved"))
            and not bool_value(registry.get("autoswitch_allowed"))
            and not bool_value(registry.get("rebalance_allowed"))
            and str(
                registry.get("production_assignment_allowed") or ""
            ).lower() in {"0", "false", "no"}
        )
        if (
            exact_execution_contract
            and int(row.get("enabled_certification_users_on_source") or 0) == 1
            and int(
                row.get("group_aligned_certification_users_on_source") or 0
            ) == 1
            and int(row.get("enabled_non_certification_users_on_source") or 0)
            == 0
        ):
            in_place_preparation_sources.append(row)
    in_place_preparation_sources.sort(
        key=lambda row: str(row.get("source_id") or "")
    )
    topology_predecessor = {}
    if (
        not failed_ready
        and not preparation_sources
        and not in_place_preparation_sources
        and not stale_or_unbound_failed_sources
        and all(
            hasattr(args, name)
            for name in (
                "egress_drafts_dir",
                "policy_file",
                "action_class_audit_store",
            )
        )
    ):
        topology_args = copy.copy(args)
        topology_args.controlled_source_validation_profile = "ct-m0f-one-user"
        topology_predecessor = controlled_source_topology_diagnostic(
            topology_args
        )
    # CT-M0F may consume a real failure on an isolated certification-only
    # source.  The destination is not itself deliberately failed, so requiring
    # it to be another isolated controlled source incorrectly discards an
    # otherwise healthy existing Planner target.  Reuse the current target
    # diagnostic and admit a *healthy* shared target only when the active
    # availability-first standing policy already authorizes one
    # certification-only assignment with zero ordinary-user delta.  This is a
    # selection projection, not a new target owner or an execution grant.
    policy_file_value = str(getattr(args, "policy_file", "") or "")
    policy_file = Path(policy_file_value) if policy_file_value else None
    policy_root = (
        read_json(policy_file, {})
        if policy_file is not None and policy_file.is_file()
        else {}
    )
    policy_root = policy_root if isinstance(policy_root, dict) else {}
    availability_contract = policy_root.get("delegated_autonomy_policy")
    availability_contract = (
        availability_contract if isinstance(availability_contract, dict) else {}
    )
    availability_decision = (
        availability_contract.get("authority_decision")
        if isinstance(availability_contract.get("authority_decision"), dict)
        else {}
    )
    availability_validation = (
        operator_execution.validate_standing_delegated_operational_policy(
            availability_contract,
            audit_records=(
                list(precomputed_audit_records)
                if isinstance(precomputed_audit_records, list)
                else operator_execution.read_live_execution_lineage_records(
                    Path(
                        getattr(args, "action_class_audit_store", "") or ""
                    ),
                    required_decision_ids=tuple(filter(None, [
                        str(availability_decision.get("decision_id") or "")
                    ])),
                )
            ),
        )
        if availability_contract
        and getattr(args, "action_class_audit_store", "")
        else {"ok": False, "policy": {}}
    )
    availability_policy = (
        availability_validation.get("policy")
        if isinstance(availability_validation.get("policy"), dict)
        else {}
    )
    # The standing-policy validator may return either the normalized policy
    # body or its signed contract envelope.  Both are the same existing
    # Authority decision; consume the body in either representation so a
    # healthy prepared certification target is not lost before T0.
    if (
        not isinstance(availability_policy.get("action_class_scopes"), dict)
        and isinstance(availability_policy.get("policy"), dict)
    ):
        availability_policy = availability_policy["policy"]
    availability_scope = (
        (availability_policy.get("action_class_scopes") or {}).get(
            "bounded availability-first controlled failover"
        )
        if isinstance(availability_policy.get("action_class_scopes"), dict)
        else {}
    )
    shared_target_action_admitted = bool(
        availability_validation.get("ok")
        and "ASSIGN_CERTIFICATION_COHORT_TO_SHARED_TARGET"
        in set(availability_scope.get("allowed_actions") or [])
        and bool(availability_scope.get("certification_identities_only"))
        and int(availability_scope.get("max_users_per_transaction") or 0) >= 1
        and int(availability_scope.get("max_concurrent_transactions") or 0)
        >= 1
        and availability_scope.get("ordinary_identity_delta") == 0
        and availability_scope.get("ordinary_route_delta") == 0
        and availability_scope.get("shared_target_fault_injection_allowed")
        is False
    )
    # Target admission is expensive and cannot make an unbound source or an
    # ambiguous identity executable.  Defer it until the existing L3/source
    # gates have selected an exact one-user predecessor below.
    target_diagnostic_precomputed = isinstance(
        precomputed_target_diagnostic, dict,
    )
    target_diagnostic = (
        dict(precomputed_target_diagnostic)
        if target_diagnostic_precomputed else {"targets": [], "selection": {}}
    )
    shared_targets = []
    controlled_contract_targets = []
    matrix_failure_shared_targets = []
    matrix_failure_policy_coverage: dict[str, Any] = {}
    selection_mode = (
        "EXECUTE_CONTROLLED_FAILURE_CUTOVER"
        if failed_ready
        else "PREPARE_CONTROLLED_FAILURE_CONDITION"
        if preparation_sources and healthy_baselines
        else "PREPARE_CONTROLLED_FAILURE_CONDITION_IN_PLACE"
        if in_place_preparation_sources
        else "STOP_SAFE"
    )
    selected = (
        failed_ready[0]
        if failed_ready
        else preparation_sources[0]
        if preparation_sources and healthy_baselines
        else in_place_preparation_sources[0]
        if in_place_preparation_sources
        else {}
    )
    selected_source = str(selected.get("source_id") or "")
    active_service_failure_binding = (
        selected.get("active_service_failure_binding")
        if isinstance(selected.get("active_service_failure_binding"), dict)
        else ct_m0f_active_service_failure_binding_projection(
            state_dir,
            selected_source,
            event_dir=Path(
                getattr(args, "event_dir", "") or state_dir / "events"
            ),
            evidence_cache=binding_evidence_cache,
        )
        if selected_source and not bool(selected.get("controlled_condition_active"))
        else {
            "status": "CONTROLLED_CONDITION_LINEAGE_APPLIES",
            "ok": True,
            "requires_binding": False,
            "read_only": True,
        }
    )
    source_users = sorted(
        (
            row for row in users
            if selected_source
            and str(row.get("current") or "") == selected_source
            and bool_value(row.get("enabled", "1"))
            and bool_value(row.get("certification_user"))
            and str(row.get("ip") or "")
            and (
                not str(selected.get("certification_group") or "")
                or str(row.get("certification_group") or "")
                == str(selected.get("certification_group") or "")
            )
        ),
        key=lambda row: str(row.get("ip") or ""),
    )
    if selection_mode == "EXECUTE_CONTROLLED_FAILURE_CUTOVER":
        selected_user_row = source_users[0] if source_users else {}
        selected_target_projection = (
            healthy_baselines[0] if healthy_baselines else {}
        )
    elif selection_mode == "PREPARE_CONTROLLED_FAILURE_CONDITION_IN_PLACE":
        selected_user_row = source_users[0] if source_users else {}
        selected_target_projection = {}
    else:
        baseline = healthy_baselines[0] if healthy_baselines else {}
        baseline_id = str(baseline.get("source_id") or "")
        baseline_group = str(baseline.get("certification_group") or "")
        baseline_users = sorted(
            (
                row for row in users
                if str(row.get("current") or "") == baseline_id
                and bool_value(row.get("enabled", "1"))
                and bool_value(row.get("certification_user"))
                and (
                    not baseline_group
                    or str(row.get("certification_group") or "")
                    == baseline_group
                )
            ),
            key=lambda row: str(row.get("ip") or ""),
        )
        selected_user_row = baseline_users[0] if baseline_users else {}
        selected_target_projection = baseline
    selected_user = str(selected_user_row.get("ip") or "")
    if selected_source and selected_user and policy_file is not None:
        # All subsequent source facts are scalar/fingerprinted in ``selected``
        # and ``active_service_failure_binding``.  Release the read-only
        # registry snapshots before asking the existing target owner for its
        # own full projection.  This changes neither source selection nor any
        # persisted state; it merely prevents simultaneous duplicate views.
        del users
        del egress_rows
        del binding_evidence_cache
        gc.collect()
        if not target_diagnostic_precomputed:
            target_diagnostic = controlled_campaign_target_selection_diagnostic(args)
        diagnostic_selected_target = str(
            (target_diagnostic.get("selection") or {}).get("selected_target_id")
            or ""
        )
        for row in target_diagnostic.get("targets") or []:
            if not isinstance(row, dict):
                continue
            target_id = str(row.get("target_id") or "")
            availability = row.get("shared_target_availability") if isinstance(
                row.get("shared_target_availability"), dict
            ) else {}
            capacity = row.get("capacity") if isinstance(row.get("capacity"), dict) else {}
            common_ready = (
                target_id
                and bool((row.get("health") or {}).get("ok"))
                and bool(row.get("shared_target_technically_eligible"))
                and str(availability.get("state") or "") == "HEALTHY"
                and availability.get("policy_boundary") == "NONE"
                and int(capacity.get("target_safe_additional_capacity") or 0) >= 1
                and bool(row.get("verification_supported"))
                and bool(row.get("rollback_containment_supported"))
            )
            if common_ready and bool(row.get("ordinary_planner_eligible")):
                shared_targets.append(row)
            if (
                common_ready
                and bool(row.get("controlled_rebind_eligible"))
                and bool(row.get("controlled_only_contract"))
                and str(row.get("role") or "").upper() == "EXECUTION_ONLY"
                and str(row.get("reservation_owner") or "")
                == "operator_execution_governance"
            ):
                controlled_contract_targets.append(row)
        # The established availability-first owner already derives a stage-1
        # allocation for a fresh DEGRADED_USABLE shared target.  A real
        # certification-only Matrix failure may reuse that exact one-user
        # allocation, but never infer a target from a generic ranking or
        # weaken the ordinary target floor.  The policy semantic gate is the
        # Authority proof for this exceptional bounded effect.
        if (
            str(active_service_failure_binding.get("binding_kind") or "")
            == "CERTIFICATION_ONLY_MATRIX_FAILURE"
        ):
            shared_projection = target_diagnostic.get(
                "shared_production_target_capacity_projection"
            )
            shared_projection = (
                shared_projection if isinstance(shared_projection, dict) else {}
            )
            allocations = shared_projection.get("stage_allocations")
            allocations = allocations if isinstance(allocations, dict) else {}
            matrix_failure_allocation = allocations.get("1")
            matrix_failure_allocation = (
                matrix_failure_allocation
                if isinstance(matrix_failure_allocation, dict) else {}
            )
            matrix_failure_policy_coverage = (
                availability_first_standing_policy_semantic_coverage_gate(
                    standing_validation=availability_validation,
                    policy_contract=availability_contract,
                    availability_scope=availability_scope,
                    stage=1,
                    allocation=matrix_failure_allocation,
                )
            )
            allocation_rows = [
                item for item in (
                    matrix_failure_allocation.get(
                        "immutable_allocation_projection"
                    ) or []
                ) if isinstance(item, dict)
            ]
            if (
                matrix_failure_policy_coverage.get("ok")
                and len(allocation_rows) == 1
                and int(allocation_rows[0].get("allocated_users") or 0) == 1
            ):
                allocation = allocation_rows[0]
                allocation_target = str(allocation.get("target_id") or "")
                for row in target_diagnostic.get("targets") or []:
                    if not isinstance(row, dict) or str(
                        row.get("target_id") or ""
                    ) != allocation_target:
                        continue
                    availability = row.get("shared_target_availability")
                    availability = (
                        availability if isinstance(availability, dict) else {}
                    )
                    capacity = row.get("capacity")
                    capacity = capacity if isinstance(capacity, dict) else {}
                    exact_ready = (
                        bool((row.get("health") or {}).get("ok"))
                        and bool(row.get("shared_target_technically_eligible"))
                        and str(availability.get("state") or "")
                        == "DEGRADED_USABLE"
                        and str(availability.get("policy_boundary") or "")
                        == (
                            "EXACT_DEGRADED_SHARED_TARGET_ACTION_CLASS_"
                            "CONTRACT_REQUIRED"
                        )
                        and int(
                            capacity.get("target_safe_additional_capacity") or 0
                        ) >= 1
                        and bool(row.get("verification_supported"))
                        and bool(row.get("rollback_containment_supported"))
                    )
                    if exact_ready:
                        matrix_failure_shared_targets.append({
                            **row,
                            "matrix_failure_allocation": allocation,
                        })
                    break
        shared_targets.sort(key=lambda row: (
            -int(((row.get("capacity") or {}).get(
                "target_safe_additional_capacity"
            ) or 0)),
            str(row.get("target_id") or ""),
        ))
        controlled_contract_targets.sort(key=lambda row: (
            0 if str(row.get("target_id") or "") == diagnostic_selected_target else 1,
            int(row.get("selected_target_rank") or 999999),
            str(row.get("target_id") or ""),
        ))
        matrix_failure_shared_targets.sort(key=lambda row: (
            str((row.get("matrix_failure_allocation") or {}).get(
                "target_id"
            ) or ""),
        ))
    selected_target = str(selected_target_projection.get("source_id") or "")
    isolated_target_admitted = bool(
        selected_target
        and selected_target != selected_source
        and bool(
            (selected_target_projection.get("baseline_health") or {}).get("ok")
        )
        and bool(
            selected_target_projection.get(
                "source_isolated_for_controlled_failure"
            )
        )
        and int(
            selected_target_projection.get(
                "enabled_non_certification_users_on_source"
            )
            or 0
        )
        == 0
    )
    selected_shared_target = next(
        (
            row for row in shared_targets
            if str(row.get("target_id") or "") != selected_source
        ),
        {},
    )
    selected_controlled_contract_target = next(
        (
            row for row in controlled_contract_targets
            if str(row.get("target_id") or "") != selected_source
        ),
        {},
    )
    selected_matrix_failure_target = next(
        (
            row for row in matrix_failure_shared_targets
            if str(row.get("target_id") or "") != selected_source
        ),
        {},
    )
    shared_target_admitted = bool(
        selection_mode in {
            "EXECUTE_CONTROLLED_FAILURE_CUTOVER",
            "PREPARE_CONTROLLED_FAILURE_CONDITION_IN_PLACE",
        }
        and availability_policy
        and shared_target_action_admitted
        and selected_shared_target
    )
    exact_controlled_contract_target_admitted = bool(
        selection_mode in {
            "EXECUTE_CONTROLLED_FAILURE_CUTOVER",
            "PREPARE_CONTROLLED_FAILURE_CONDITION_IN_PLACE",
        }
        and availability_policy
        and shared_target_action_admitted
        and selected_controlled_contract_target
    )
    matrix_failure_shared_target_admitted = bool(
        selection_mode == "EXECUTE_CONTROLLED_FAILURE_CUTOVER"
        and bool(active_service_failure_binding.get("ok"))
        and str(active_service_failure_binding.get("binding_kind") or "")
        == "CERTIFICATION_ONLY_MATRIX_FAILURE"
        and bool(matrix_failure_policy_coverage.get("ok"))
        and selected_matrix_failure_target
    )
    if exact_controlled_contract_target_admitted:
        selected_target_projection = selected_controlled_contract_target
        selected_target = str(
            selected_controlled_contract_target.get("target_id") or ""
        )
    elif shared_target_admitted:
        selected_target_projection = selected_shared_target
        selected_target = str(selected_shared_target.get("target_id") or "")
    elif matrix_failure_shared_target_admitted:
        selected_target_projection = selected_matrix_failure_target
        selected_target = str(
            selected_matrix_failure_target.get("target_id") or ""
        )
    controlled_target_admitted = bool(
        isolated_target_admitted
        or exact_controlled_contract_target_admitted
        or shared_target_admitted
        or matrix_failure_shared_target_admitted
    )
    blockers = []
    if not selected_source:
        blockers.append(
            "no_healthy_isolated_controlled_source_with_group_aligned_certification_identity"
        )
    if not selected_user:
        blockers.append("no_exact_certification_identity_for_controlled_condition")
    # A live passive failure must carry the exact incident/obligation lineage
    # through Matrix and the governed executor.  Absence of the L3 state file
    # is intentionally not a synthetic failure: it is covered by the existing
    # controlled-condition path and remains non-executable as a real incident.
    if (
        selection_mode == "EXECUTE_CONTROLLED_FAILURE_CUTOVER"
        and active_service_failure_binding.get("requires_binding")
        and not active_service_failure_binding.get("ok")
    ):
        blockers.append("ct_m0f_active_service_failure_causal_binding_required")
    if (
        not selected_target
        or selected_target == selected_source
        or not controlled_target_admitted
    ):
        blockers.append("no_distinct_controlled_contract_admitted_target")
    sample_binding = {
        "user": selected_user,
        "source": selected_source,
        "target": selected_target,
        "source_observation_fingerprint": str(
            (selected.get("baseline_health") or {}).get(
                "observation_fingerprint"
            )
            or ""
        ),
        "selection_mode": selection_mode,
        "active_service_failure_binding": active_service_failure_binding,
        # Unrelated failed controlled sources are useful diagnostics, but they
        # are not part of this exact one-user source/target decision. Binding
        # the whole diagnostic list made an otherwise identical preparation
        # fingerprint drift whenever a different Polygon source changed.
        # Preserve fail-closed evidence only for the selected source.
        "selected_source_stale_or_unbound_evidence": [
            row for row in stale_or_unbound_failed_sources
            if str(row.get("source_id") or "") == selected_source
        ],
        "controlled_source_topology_predecessor": topology_predecessor,
        # Preparation protects the identity/source envelope only.  The
        # target is deliberately selected again after T0 by the existing
        # Matrix/Planner owner, so a fresh target observation cannot be a
        # pre-T0 equality token: it changes on every normal probe and would
        # make an otherwise identical controlled preparation impossible.
        # Keep that observation bound for the post-T0 execution selection.
        "target_observation_fingerprint": (
            str(
                (selected_target_projection.get("baseline_health") or
                 selected_target_projection.get("health") or {}).get(
                    "observation_fingerprint"
                )
                or ""
            )
            if selection_mode == "EXECUTE_CONTROLLED_FAILURE_CUTOVER"
            else ""
        ),
    }
    projection = {
        "schema_version": "v7.ct-m0f-standing-source-selection.v1",
        "status": (
            "CT_M0F_STANDING_CONTROLLED_FAILURE_READY"
            if selection_mode == "EXECUTE_CONTROLLED_FAILURE_CUTOVER"
            and not blockers
            else "CT_M0F_STANDING_CONTROLLED_FAILURE_PREPARATION_READY"
            if selection_mode
            == "PREPARE_CONTROLLED_FAILURE_CONDITION_IN_PLACE"
            and not blockers
            else "CT_M0F_STANDING_CONTROLLED_FAILURE_PREPARATION_READY"
            if selection_mode == "PREPARE_CONTROLLED_FAILURE_CONDITION"
            and not blockers
            else "STOP_SAFE_CT_M0F_STANDING_CONTROLLED_SOURCE_REQUIRED"
        ),
        "ok": not blockers,
        "owner": "existing users.registry + egress.registry controlled-certification pool owner",
        "selection_mode": selection_mode,
        "selected_source_id": selected_source,
        "selected_user": selected_user,
        "selected_target_id": selected_target,
        "active_service_failure_binding": active_service_failure_binding,
        "selected_target_admission": {
            "controlled_contract_admitted": controlled_target_admitted,
            "ordinary_full_live_admission": bool(
                selected_target_projection.get("ordinary_planner_eligible")
                if controlled_target_admitted else False
            ),
            "ordinary_planner_eligible": bool(
                selected_target_projection.get("ordinary_planner_eligible")
                if controlled_target_admitted else False
            ),
            "admission_law": (
                "EXACT_CONTROLLED_BASELINE_RECOVERY_TARGET"
                if isolated_target_admitted
                else "EXACT_EXISTING_CONTROLLED_EXECUTION_TARGET_ONE_USER"
                if exact_controlled_contract_target_admitted
                else "ACTIVE_AVAILABILITY_FIRST_SHARED_TARGET_ONE_USER"
                if shared_target_admitted
                else "ACTIVE_AVAILABILITY_FIRST_MATRIX_FAILURE_ONE_USER"
                if matrix_failure_shared_target_admitted
                else "NOT_ADMITTED"
            ),
            "ordinary_user_delta": 0,
            "shared_target_fault_injection": "FORBIDDEN",
            "stage48_credit": False,
        },
        "sample_binding_fingerprint": (
            sha256_json(sample_binding) if not blockers else ""
        ),
        "selected_source_fingerprint": (
            sha256_json({
                "source_id": selected_source,
                "certification_group": str(selected.get("certification_group") or ""),
                "enabled_certification_users_on_source": int(
                    selected.get("enabled_certification_users_on_source") or 0
                ),
                "group_aligned_certification_users_on_source": int(
                    selected.get("group_aligned_certification_users_on_source") or 0
                ),
                "baseline_observation_fingerprint": str(
                    (selected.get("baseline_health") or {}).get(
                        "observation_fingerprint"
                    )
                    or ""
                ),
            })
            if selected_source
            else ""
        ),
        "eligible_source_count": len(failed_ready) + len(preparation_sources),
        "fast_failed_source_projection_reused": (
            fast_failed_source_projection_reused
        ),
        "eligible_identity_count": 1 if selected_user else 0,
        "shared_target_policy_admission": {
            "ok": shared_target_action_admitted,
            "owner": "existing delegated_autonomy_policy availability-first action class",
            "target_count": (
                len(shared_targets) + len(controlled_contract_targets)
                + len(matrix_failure_shared_targets)
            ),
            "matrix_failure_policy_coverage": matrix_failure_policy_coverage,
            "selection_law": (
