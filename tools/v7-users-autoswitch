class AutoswitchPlanner:
    def __init__(self, args: argparse.Namespace):
        self.args = args
        self.operation_started_at = now_iso()
        self.state_dir = Path(args.state_dir)
        self.event_dir = Path(args.event_dir)
        self.state = read_json(self.state_dir / "v7-state.json", {})
        self.policy = read_json(Path(args.policy_file), {})
        self.org_policy = read_json(Path(args.org_policy_file), {})
        self.quality_summary = read_json(Path(args.quality_summary_file), {"items": {}})
        self.safety_file = Path(args.safety_file)
        self.safety_state = self._load_safety()
        self.speed = read_json(self.state_dir / "egress-speed.json", {"items": {}})
        self.client_speed = read_json(self.state_dir / "client-speed.json", {"users": {}})
        self.matrix = read_json(self.state_dir / "service-matrix.json", {"items": {}})
        self.telegram_sentinel = read_json(Path(args.telegram_sentinel_file), {"items": {}})
        self.vless_activity = read_json(Path(args.vless_activity_file), {})
        self.restore_barrier_file = Path(args.restore_barrier_file)
        self.restore_barrier = self._restore_barrier_status()
        self.generation = self._generation_status()
        self.service_prefs = read_json(self.state_dir / "service-preferences.json", {})
        self.intelligence_snapshot_root = Path(args.intelligence_snapshot_root)
        self.pre_planner_refresh = self._run_pre_planner_refresh()
        self._reload_intelligence_sources_after_pre_planner_refresh()
        self.intelligence_snapshots = self._load_intelligence_snapshots()
        self._snapshot_items_cache: dict[str, list[dict[str, Any]]] = {}
        self.users = self._load_users()
        self.egress = self._load_egress()
        self._sync_egress_user_counts()
        self.switch_policy = self._switch_policy()
        self.authority_budget_policy = self._authority_budget_policy()
        self.quality_policy = self._quality_policy()
        self.load_policy = self._load_policy()
        self.reconnect_policy = self._reconnect_policy()
        self.safety_policy = self._safety_policy()
        self.service_signal_policy = self._service_signal_policy()
        self.service_quality_policy = self._service_quality_policy()
        self.best_available_pool_policy = self._best_available_pool_policy()
        self.last_switch = self._last_switches()
        self.group_usage = self._group_usage()
        self.dynamic_load = self._dynamic_load_summary()
        self.reconnect_state_file = Path(args.reconnect_state_file)
        self.reconnect_state = self._load_reconnect_state()
        self.reconnect_events = self._observe_reconnect_events()
        self._routing_intelligence_cache: dict[tuple[Any, ...], dict[str, Any]] = {}

    def _switch_policy(self) -> dict[str, Any]:
        sw = merge_defaults((self.policy or {}).get("switch", {}), DEFAULT_SWITCH_POLICY)
        sw.update((self.org_policy or {}).get("switch", {}))
        if self.args.mode:
            sw["autoswitch_mode"] = self.args.mode
        return sw

    def _authority_budget_policy(self) -> dict[str, Any]:
        policy = merge_defaults((self.policy or {}).get("authority_budget", {}), DEFAULT_AUTHORITY_BUDGET_POLICY)
        policy.update((self.org_policy or {}).get("authority_budget", {}))
        prepared_class = normalize_authority_class(policy.get("authority_class"))
        certified_class = normalize_authority_class(
            policy.get("certified_authority_class")
            or policy.get("certified_authority")
            or "CANARY"
        )
        requested_state = normalize_authority_lifecycle_state(policy.get("authority_lifecycle_state"))
        requested_state = AUTHORITY_CERTIFIED_STATE_ALIASES.get(requested_state, requested_state)
        frozen = bool_value(policy.get("frozen") or policy.get("authority_frozen"))
        revoked = bool_value(policy.get("revoked") or policy.get("authority_revoked"))
        if revoked:
            lifecycle_state = "REVOKED"
        elif frozen:
            lifecycle_state = "FROZEN"
        elif requested_state in AUTHORITY_BRIDGE_STATES:
            lifecycle_state = requested_state
        elif requested_state in {"DEMOTED", "FROZEN", "REVOKED"}:
            lifecycle_state = requested_state
        elif AUTHORITY_CLASS_RANK[prepared_class] > AUTHORITY_CLASS_RANK[certified_class]:
            lifecycle_state = "PREPARED"
        elif AUTHORITY_CLASS_RANK[prepared_class] < AUTHORITY_CLASS_RANK[certified_class]:
            lifecycle_state = "DEMOTED"
        elif requested_state == "PROMOTED":
            lifecycle_state = "PROMOTED"
        else:
            lifecycle_state = "CERTIFIED"
        runtime_class = min_authority_class(prepared_class, certified_class)
        if lifecycle_state in {"FROZEN", "REVOKED"}:
            runtime_class = "CANARY"
        prepared_budget = AUTHORITY_CLASS_BUDGETS[prepared_class]
        certified_budget = AUTHORITY_CLASS_BUDGETS[certified_class]
        next_class_for_certified = AUTHORITY_CLASS_NEXT.get(certified_class, certified_class)
        bridge_budget_ceiling = 0
        if (
            lifecycle_state in AUTHORITY_BRIDGE_STATES
            and AUTHORITY_CLASS_RANK[prepared_class] == AUTHORITY_CLASS_RANK[certified_class] + 1
            and prepared_class == next_class_for_certified
        ):
            bridge_budget_ceiling = min(prepared_budget, AUTHORITY_CLASS_BUDGETS[next_class_for_certified])
        runtime_ceiling = 0 if lifecycle_state in {"FROZEN", "REVOKED"} else AUTHORITY_CLASS_BUDGETS[runtime_class]
        if bridge_budget_ceiling:
            runtime_ceiling = bridge_budget_ceiling
        requested_budget = to_int(policy.get("current_allowed_user_budget"), prepared_budget)
        certification_ceiling = bridge_budget_ceiling or certified_budget
        current_budget = max(0, min(requested_budget, prepared_budget, certification_ceiling, runtime_ceiling))
        next_class = AUTHORITY_CLASS_NEXT.get(runtime_class, "CANARY")
        next_budget_default = AUTHORITY_CLASS_BUDGETS.get(next_class, current_budget)
        policy["prepared_authority_class"] = prepared_class
        policy["certified_authority_class"] = certified_class
        policy["authority_lifecycle_state"] = lifecycle_state
        policy["authority_class"] = runtime_class
        policy["current_allowed_user_budget"] = current_budget
        policy["next_authority_class"] = next_class
        policy["next_allowed_user_budget"] = max(
            current_budget,
            min(to_int(policy.get("next_allowed_user_budget"), next_budget_default), next_budget_default),
        )
        policy["truth_source"] = "existing_policy_files"
        policy["runtime_calculation_mode"] = (
            "certified_authority_with_transitional_bridge"
            if bridge_budget_ceiling
            else "prepared_and_certified_min_authority"
        )
        policy["authority_bridge"] = {
            "schema_version": "v7.authority-transition-bridge.v1",
            "enabled": bool(bridge_budget_ceiling),
            "state": lifecycle_state if lifecycle_state in AUTHORITY_BRIDGE_STATES else "",
            "from_certified_authority": certified_class,
            "to_prepared_authority": prepared_class,
            "bridge_budget_ceiling": bridge_budget_ceiling,
            "promotion_certification": False,
            "truth_source": "existing_policy_files",
            "new_truth_sources_created": False,
            "duplicate_systems_created": False,
        }
        return policy

    def _authority_promotion_truth_check(self) -> dict[str, Any]:
        command = str(getattr(self.args, "authority_promotion_truth_check_command", "") or "v7-truth-check")
        result = {
            "command": command,
            "required": True,
            "returncode": None,
            "passed": False,
            "stdout_tail": "",
            "error": "",
        }
        try:
            proc = subprocess.run(
                [command, "--all", "--json"],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=30,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            result["error"] = str(exc)
            return result
        output = proc.stdout or ""
        result["returncode"] = proc.returncode
        result["stdout_tail"] = output[-2000:]
        parsed: Any = {}
        try:
            parsed = json.loads(output)
        except json.JSONDecodeError:
            parsed = {}
        json_text = json.dumps(parsed, ensure_ascii=False, sort_keys=True) if isinstance(parsed, dict) else output
        result["passed"] = proc.returncode == 0 and (
            "FULLY_ALIGNED" in output
            or '"PASS"' in json_text
            or '"pass"' in json_text.lower()
            or '"PASSED"' in json_text
        )
        return result

    def _authority_promotion_feedback_paths(self) -> dict[str, Path]:
        return {
            "outcome": self.state_dir / "execution-events.jsonl",
            "trust": self.state_dir / "runtime-trust.jsonl",
            "prediction": self.state_dir / "execution-events.jsonl",
            "recommendation": self.state_dir / "proposals.jsonl",
            "closure": self.state_dir / "closure-records.jsonl",
        }

    def _authority_feedback_records_for_operation(self, operation_id: str) -> dict[str, list[dict[str, Any]]]:
        paths = self._authority_promotion_feedback_paths()
        result: dict[str, list[dict[str, Any]]] = {}
        schema_markers = {
            "outcome": "execution-outcome",
            "trust": "execution-trust",
            "prediction": "execution-prediction",
            "recommendation": "execution-recommendation",
            "closure": "execution-feedback-closure",
        }
        for kind, path in paths.items():
            marker = schema_markers[kind]
            matches: list[dict[str, Any]] = []
            for row in read_jsonl(path):
                schema = str(row.get("schema_version") or "")
                if marker not in schema:
                    continue
                raw = json.dumps(row, ensure_ascii=False, sort_keys=True)
                if operation_id not in raw:
                    continue
                matches.append(row)
            result[kind] = matches
        return result

    def _authority_promotion_evidence_review(self, operation_ids: list[str]) -> dict[str, Any]:
        operation_reviews = []
        for operation_id in operation_ids:
            records = self._authority_feedback_records_for_operation(operation_id)
            users: set[str] = set()
            feedback_ids: set[str] = set()
            statuses: set[str] = set()
            for kind_records in records.values():
                for row in kind_records:
                    user = str(row.get("user") or "")
                    if user:
                        users.add(user)
                    feedback_id = str(row.get("feedback_id") or row.get("object_id") or "")
                    if feedback_id:
                        feedback_ids.add(feedback_id)
                    status = str(row.get("outcome_status") or row.get("closure_state") or "").lower()
                    if status:
                        statuses.add(status)
            missing = [kind for kind in ("outcome", "trust", "prediction", "recommendation", "closure") if not records.get(kind)]
            successful = "success" in statuses and not {"failure", "rollback_required"}.intersection(statuses)
            closed = any(str(row.get("closure_state") or "").upper() == "CLOSED" for row in records.get("closure", []))
            users_count = len(users)
            operation_reviews.append(
                {
                    "operation_id": operation_id,
                    "feedback_record_counts": {kind: len(items) for kind, items in records.items()},
                    "feedback_ids": sorted(feedback_ids),
                    "users": sorted(users),
                    "users_count": users_count,
                    "statuses": sorted(statuses),
                    "missing_feedback_types": missing,
                    "successful": successful,
                    "closure_closed": closed,
                    "small_batch_success_proven": users_count >= 2 and successful and closed and not missing,
                }
            )
        successful_runs = [row for row in operation_reviews if row["small_batch_success_proven"]]
        return {
            "schema_version": "v7.authority-promotion-evidence-review.v1",
            "required_successful_small_batch_runs": 2,
            "operation_ids": operation_ids,
            "operation_reviews": operation_reviews,
            "successful_small_batch_runs": len(successful_runs),
            "evidence_valid": len(operation_ids) >= 2 and len(successful_runs) >= 2,
        }

    def promote_authority(self, target_class: str) -> dict[str, Any]:
        target = normalize_authority_class(target_class)
        operation_ids = []
        for value in getattr(self.args, "authority_promotion_operation_id", []) or []:
            operation_ids.extend(split_csv(value))
        operation_ids = list(dict.fromkeys(operation_ids))
        before_effective = dict(self.authority_budget_policy)
        before_raw = dict((self.policy or {}).get("authority_budget") or {})
        current = normalize_authority_class(before_effective.get("authority_class"))
        certified = normalize_authority_class(before_effective.get("certified_authority_class"))
        expected_next = AUTHORITY_CLASS_NEXT.get(current, current)
        result: dict[str, Any] = {
            "schema_version": "v7.authority-promotion-action.v1",
            "action": "authority_promotion",
            "component": "tools/v7-users-autoswitch",
            "target_authority_class": target,
            "before": {
                "raw": before_raw,
                "effective": before_effective,
                "policy_hash": sha256_file(Path(self.args.policy_file)),
            },
            "operation_ids": operation_ids,
            "users_moved": 0,
            "routing_mutation_performed": False,
            "autoswitch_apply_run": False,
            "status": "DENIED",
            "blockers": [],
        }
        if getattr(self.args, "confirm_authority_promotion", "") != "PROMOTE_AUTHORITY_APPROVED":
            result["blockers"].append("missing_explicit_authority_promotion_confirmation")
        if target != expected_next or target == current:
            result["blockers"].append(f"invalid_target_authority_transition_{current}_to_{target}")
        if current != certified:
            result["blockers"].append("runtime_authority_not_equal_to_certified_authority")
        if target != "MEDIUM_BATCH":
            result["blockers"].append("only_medium_batch_promotion_supported_by_this_action")
        if len(operation_ids) < 2:
            result["blockers"].append("two_successful_small_batch_operation_ids_required")

        truth = self._authority_promotion_truth_check()
        result["truth_check"] = truth
        if not truth.get("passed"):
            result["blockers"].append("runtime_truth_check_failed")

        evidence = self._authority_promotion_evidence_review(operation_ids)
        result["evidence_review"] = evidence
        if not evidence.get("evidence_valid"):
            result["blockers"].append("medium_batch_evidence_validation_failed")

        audit_available = shutil.which("v7-audit-log") is not None
        result["audit_command_available"] = audit_available
        if not audit_available:
            result["blockers"].append("v7_audit_log_unavailable")

        if result["blockers"]:
            return result

        policy_path = Path(self.args.policy_file)
        if not policy_path.is_file():
            result["blockers"].append("policy_file_missing")
            return result

        raw_policy = read_json(policy_path, {})
        if not isinstance(raw_policy, dict):
            result["blockers"].append("policy_file_not_json_object")
            return result
        promoted_at = now_iso()
        backup_path = policy_path.with_name(f"{policy_path.name}.backup-authority-promotion-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}")
        after_authority = dict(raw_policy.get("authority_budget") or {})
        after_authority.update(
            {
                "enabled": True,
                "authority_class": target,
                "prepared_authority_class": target,
                "certified_authority_class": target,
                "authority_lifecycle_state": "PROMOTED",
                "current_allowed_user_budget": AUTHORITY_CLASS_BUDGETS[target],
                "next_authority_class": AUTHORITY_CLASS_NEXT.get(target, target),
                "next_allowed_user_budget": AUTHORITY_CLASS_BUDGETS[AUTHORITY_CLASS_NEXT.get(target, target)],
                "evidence_floor": "two_successful_small_batch_runs_with_feedback_closure",
                "promoted_at": promoted_at,
                "promoted_by": "tools/v7-users-autoswitch",
                "promotion_action": "SMALL_BATCH_TO_MEDIUM_BATCH",
                "promotion_evidence": {
                    "operation_ids": operation_ids,
                    "successful_small_batch_runs": evidence.get("successful_small_batch_runs"),
                    "feedback_ids": sorted(
                        {
                            feedback_id
                            for review in evidence.get("operation_reviews", [])
                            for feedback_id in review.get("feedback_ids", [])
                        }
                    ),
                },
            }
        )
        raw_policy["authority_budget"] = after_authority
        try:
            shutil.copy2(policy_path, backup_path)
            write_json_atomic(policy_path, raw_policy)
        except OSError as exc:
            result["blockers"].append(f"policy_write_failed:{exc}")
            return result

        audit = {
            "action": "authority_promotion",
            "component": "autoswitch",
            "object_type": "policy",
            "object_id": "authority_budget",
            "result": "OK",
            "metadata": {
                "from_authority_class": current,
                "to_authority_class": target,
                "from_allowed_user_budget": before_effective.get("current_allowed_user_budget"),
                "to_allowed_user_budget": AUTHORITY_CLASS_BUDGETS[target],
                "operation_ids": ",".join(operation_ids),
                "backup_path": str(backup_path),
                "policy_hash_before": result["before"]["policy_hash"],
                "program": "PROGRAM_MEDIUM_BATCH_PROMOTION_IMPLEMENTATION_AND_REAL_5_USER_EXECUTION",
            },
            "emitted": False,
            "status": "ready_to_emit",
        }
        audit = self._emit_terminal_audit(audit)
        if not audit.get("emitted"):
            try:
                shutil.copy2(backup_path, policy_path)
            except OSError:
                pass
            result["audit"] = audit
            result["status"] = "DENIED_AUDIT_FAILED_ROLLED_BACK"
            result["blockers"].append("authority_promotion_audit_failed")
            return result

        after_effective = AutoswitchPlanner(
            argparse.Namespace(**{**vars(self.args), "pre_planner_refresh": "off"})
        ).authority_budget_policy
        result["backup_path"] = str(backup_path)
        result["audit"] = audit
        result["after"] = {
            "raw": after_authority,
            "effective": after_effective,
            "policy_hash": sha256_file(policy_path),
        }
        result["authority_promoted"] = True
        result["status"] = "PROMOTED"
        return result

