        )
    if not ranked:
        current_residuals.append("NO_CONTROLLED_ELIGIBLE_TARGET")
    if legal_outcome == "EXACT_TARGET_REBIND_AUTHORITY_REQUIRED":
        current_residuals.append(
            "EXACT_TARGET_REBIND_AUTHORITY_REQUIRED"
        )
    if legal_outcome == "MULTI_TARGET_EXECUTION_AUTHORITY_REQUIRED":
        current_residuals.append(
            "MULTI_TARGET_EXECUTION_AUTHORITY_REQUIRED"
        )
    if legal_outcome == "GENUINE_AUTHORITY_EXPANSION_REQUIRED":
        current_residuals.append(
