            ),
            "action_class_execution_boundary": action_boundary,
            "shadow_allowed_action_status": str(action_boundary.get("status") or "STOP_SAFE_ACTION_CLASS_BOUNDARY_NOT_EVALUATED"),
            "candidate_created": False,
            "packet_created": False,
            "lease_created": False,
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
            "apply_executed": False,
            "authority_expanded": False,
            "production_maturity_changed": False,
        }
        # The lineage id intentionally stays stable across revalidation of one
        # passive incident.  This fingerprint is the existing closure owner's
        # exact-once key for its *current* semantics: a changed scope or
        # classification gets one new consumer turn, while unchanged Matrix
        # observations remain deduplicated without a new queue or registry.
        obligation["automation_consumption_fingerprint"] = sha256_json({
            "automation_obligation_id": obligation_id,
            "source_incident_id": obligation["source_incident_id"],
            "situation_id": obligation["situation_id"],
            "decision_trace_id": obligation["decision_trace_id"],
            "classification": obligation["stop_safe_classification"],
            "incident_frontier": obligation["incident_frontier"],
            "product_evolution_frontier": obligation["product_evolution_frontier"],
            "current_source_scope": obligation["current_source_scope"],
        })
        # A normal Matrix generation may see the same passive event again.
        # Compare only durable decision semantics, rather than volatile
        # timestamps or the complete policy diagnostic, so an unchanged
        # observation remains exact-once.  Conversely, this lets the existing
        # owner append one reconciled projection when an old ordinary-planner
        # STOP_SAFE has become a lawful CT-M0F controlled path.
        def obligation_semantic_projection(row: dict[str, Any]) -> dict[str, Any]:
            boundary = row.get("action_class_execution_boundary")
            boundary = boundary if isinstance(boundary, dict) else {}
            return {
                key: row.get(key)
                for key in (
                    "object_id", "automation_obligation_id", "closure_state",
                    "automation_consumption_fingerprint",
                    "source_incident_id", "incident_key", "situation_id",
                    "decision_trace_id", "event_provenance", "evidence_class",
                    "channel", "failure_families", "affected_users_count",
                    "aggregate_impact_users", "current_source_scope",
                    "bounded_recommendation_users",
                    "current_certified_blast_radius_tier",
                    "runtime_scope_context", "requested_blast_radius_tier",
                    "smallest_necessary_cohort", "maximum_capacity_safe_cohort",
                    "current_authority_safe_cohort", "effective_cohort",
                    "effective_cohort_load", "effective_cohort_fingerprint",
                    "target_capacity_snapshot", "stop_safe_classification",
                    "classification_reason", "product_evolution_frontier",
                    "incident_frontier", "authority_reconciliation",
                    "shadow_allowed_action_status",
                )
            } | {
                "action_boundary": {
                    "status": str(boundary.get("status") or ""),
                    "blockers": list(boundary.get("blockers") or []),
                    "next_required_objects": list(boundary.get("next_required_objects") or []),
                    "ct_m0f_controlled_selection": (
                        boundary.get("ct_m0f_controlled_selection")
                        if isinstance(boundary.get("ct_m0f_controlled_selection"), dict)
                        else {}
                    ),
                },
            }

        previous_obligation = existing.get(obligation_id)
        previous_semantics = (
            obligation_semantic_projection(previous_obligation)
            if isinstance(previous_obligation, dict) else {}
        )
        current_semantics = obligation_semantic_projection(obligation)
        record_advisory_span(
            "advisory_obligation_projection_and_semantic_compare",
            obligation_projection_started_ns,
        )
        if previous_semantics == current_semantics:
            record_advisory_span(
                "advisory_obligation_semantic_construction",
                obligation_build_started_ns,
            )
            record_advisory_span("advisory_materialization_total", advisory_started_ns)
            return {
                "schema_version": "v7.service-failure-automation-advisory.v1",
                "active": False,
                "reason": "current_obligation_semantics_already_materialized",
                "obligation_id": obligation_id,
                # The existing durable obligation already has the exact
                # current semantic projection.  Return it to the caller so
                # the Runtime can revalidate that same contract directly;
                # returning only its ID forced a false
                # NO_CURRENT_SERVICE_FAILURE_OBLIGATION and made the next
                # timer repeat advisory work.  This neither appends another
                # obligation nor treats an OMP receipt as Runtime authority.
                "obligation": previous_obligation,
                "existing_obligation_reused": True,
                "outcome_reconciliation": outcome_reconciliation,
                "pre_obligation_scope_reconciliation": pre_obligation_scope_reconciliation,
                "forbidden_effects": {"runtime_apply": False, "routing_mutation": False, "user_movement": 0, "authority_change": False},
            }
        if isinstance(previous_obligation, dict):
            obligation["reconciliation"] = {
                "kind": "CURRENT_CONTROLLED_TARGET_ADMISSION_RECONCILIATION",
                "supersedes_created_at": str(previous_obligation.get("created_at") or ""),
                "previous_stop_safe_classification": str(
                    previous_obligation.get("stop_safe_classification") or ""
                ),
                "previous_semantic_fingerprint": sha256_json(previous_semantics),
                "current_semantic_fingerprint": sha256_json(current_semantics),
            }
        record_advisory_span(
            "advisory_obligation_semantic_construction",
            obligation_build_started_ns,
        )
        durable_projection_started_ns = time.monotonic_ns()
        shadow_rows = read_live_owner_history_window(shadow_path)
        shadow_ids = {str(row.get("decision_id") or "") for row in shadow_rows}
        shadow_record: dict[str, Any] = {}
        if chosen:
            selected = chosen[0]
            shadow_record = shadow_autonomy.shadow_decision_record({
                "user": str(selected.get("user_ip") or ""),
                "current_channel": str(selected.get("current_egress") or source),
                "recommended_channel": str(selected.get("recommended_egress") or ""),
                "recommendation": "move_recommended",
                "reasons": list(selected.get("reason") or []) + [classification],
                "trust": to_float(selected.get("trust"), 0.0),
                "risk": to_float(selected.get("risk"), 0.0),
                "prediction": selected.get("prediction") if isinstance(selected.get("prediction"), dict) else {},
                "blockers": [classification, "CPS_AUTHORITY_RECONCILIATION_REQUIRED"],
            }, now=now)
            shadow_record["decision_id"] = "shadow_" + sha256_json({
                "automation_obligation_id": obligation_id,
                "user": shadow_record.get("user"),
                "source": shadow_record.get("current_channel"),
                "target": shadow_record.get("recommended_target"),
            })[:24]
            shadow_record.update({
                "source_incident_id": obligation["source_incident_id"],
                "automation_obligation_id": obligation_id,
                "situation_id": obligation["situation_id"],
                "decision_trace_id": obligation["decision_trace_id"],
                "aggregate_impact_users": current_affected_count,
                "bounded_recommendation_users": 1,
                "execution_allowed_now": False,
                "allowed_action_status": obligation["shadow_allowed_action_status"],
                "action_class_execution_boundary": action_boundary,
                "runtime_mutation_performed": False,
                "users_moved": 0,
                "apply_executed": False,
                "autonomy_enabled": False,
            })
        append_jsonl(closure_path, [obligation])
        if shadow_record and str(shadow_record.get("decision_id") or "") not in shadow_ids:
            append_jsonl(shadow_path, [shadow_record])
        state = self._load_l3_runtime_state()
        projection = self._materialize_passive_incident_projection(
            state,
            closure,
            terminal=str(closure.get("terminal_outcome_classification") or "STOP_SAFE_NO_ACTION"),
            recovery_observed=str(closure.get("terminal_outcome_classification") or "") == "RECOVERY_OBSERVED_NO_ACTION",
            expiry_observed=str(closure.get("terminal_outcome_classification") or "") == "EPISODE_EXPIRED_NO_ACTION",
        )
        obligations = state.setdefault("service_failure_automation_obligations", {})
        if not isinstance(obligations, dict):
            obligations = {}
            state["service_failure_automation_obligations"] = obligations
        obligations[obligation_id] = {
            "status": "READY_FOR_OMP_CONSUMPTION",
            "source_incident_id": obligation["source_incident_id"],
            "classification": classification,
            "updated_at": now,
        }
        incident_key = str(projection.get("incident_key") or obligation.get("incident_key") or "")
        incidents = state.setdefault("incidents", {})
        incident_record = incidents.get(incident_key) if isinstance(incidents, dict) and isinstance(incidents.get(incident_key), dict) else {}
        if incident_record:
            incident_record["obligation_id"] = obligation_id
            incident_record["causal_lineage"] = {
                **(incident_record.get("causal_lineage") if isinstance(incident_record.get("causal_lineage"), dict) else {}),
                "obligation_id": obligation_id,
                "action_opportunity_id": str(incident_record.get("action_opportunity_id") or ""),
            }
            if str(incident_record.get("incident_state") or "") != "INTENT_CLOSED":
                incident_record["next_required_consumer"] = "tools/v7_sync_lib.consume_service_failure_automation_frontier"
                incident_record["reentry_condition"] = "existing OMP consumer consumes the exact ready obligation under closure-records.lock"
            incident_record["updated_at"] = now
            incidents[incident_key] = incident_record
        self._write_l3_runtime_state(state)
        record_advisory_span(
            "advisory_durable_projection_materialization",
            durable_projection_started_ns,
        )
        # This advisory writes an obligation after planning.  Reconcile once
        # more so a stale passive closure cannot overwrite the current source
        # generation between the pre-plan reconciliation and the consumer.
        final_scope_reconciliation_started_ns = time.monotonic_ns()
        final_scope_reconciliation = self.reconcile_service_failure_execution_outcomes()
        record_advisory_span(
            "advisory_final_scope_reconciliation",
            final_scope_reconciliation_started_ns,
        )
        record_advisory_span("advisory_materialization_total", advisory_started_ns)
        return {
            "schema_version": "v7.service-failure-automation-advisory.v1",
            "active": True,
            "obligation": obligation,
            "shadow_decision_id": str(shadow_record.get("decision_id") or ""),
            "outcome_reconciliation": outcome_reconciliation,
            "pre_obligation_scope_reconciliation": pre_obligation_scope_reconciliation,
            "final_scope_reconciliation": final_scope_reconciliation,
            "next_output": obligation["incident_frontier"] if product_frontier == "NONE" else product_frontier,
            "forbidden_effects": {"runtime_apply": False, "routing_mutation": False, "user_movement": 0, "authority_change": False, "production_maturity_change": False},
        }

    def _l3_materialize_learning_closure(self, plan: dict[str, Any]) -> dict[str, Any]:
        safety = plan.get("safety") if isinstance(plan.get("safety"), dict) else {}
        action_contract = (
            (safety.get("authority_budget_gate") or {}).get(
                "current_action_class_contract"
            )
            if isinstance(safety.get("authority_budget_gate"), dict)
            else {}
        )
        action_class = str(action_contract.get("action_class") or "").upper()
        # N10 is a governed ordinary-product migration with its own exact
        # Packet/Lease/Barrier and bounded-cohort closure.  A concurrent or
        # historical L3 read model must never turn that product outcome into
        # L3 emergency feedback: that would create a false incident consumer
        # and leave an orphaned L3 projection.  Real emergency paths retain
        # the unchanged learning/closure flow below.
        if action_class in {
            operator_execution.N10_ORDINARY_LIKE_SINGLE_DEVICE_ACTION_CLASS,
            operator_execution.N10_SMALL_COHORT_ACTION_CLASS,
        }:
            return {
                "active": False,
                "reason": "n10_product_contract_uses_existing_packet_lease_and_bounded_cohort_closure",
                "runtime_mutation_performed": False,
                "routing_mutation_performed": False,
                "users_moved": 0,
            }
        incident = safety.get("l3_incident") if isinstance(safety.get("l3_incident"), dict) else {}
        l3_eligibility = safety.get("l3_execution_eligibility") if isinstance(safety.get("l3_execution_eligibility"), dict) else {}
        if not incident or str(incident.get("authority_object") or "") != "EMERGENCY_FAILOVER_AUTONOMY":
            return {"active": False, "reason": "not_l3"}
        operation = plan.get("operation") if isinstance(plan.get("operation"), dict) else {}
        operation_id = str(operation.get("operation_id") or "")
        if not operation_id:
            return {"active": True, "materialized": False, "reason": "operation_id_missing"}
        existing = self._authority_feedback_records_for_operation(operation_id)
        if all(existing.get(kind) for kind in ("outcome", "trust", "prediction", "recommendation", "closure")):
            self._l3_close_incident_and_update_capability(plan, already_materialized=True)
            return {"active": True, "materialized": False, "reason": "already_materialized"}

        apply_result = plan.get("apply_result") if isinstance(plan.get("apply_result"), dict) else {}
        results = [row for row in (apply_result.get("results") or []) if isinstance(row, dict)]
        if results:
            rows_for_feedback = results
        else:
            rows_for_feedback = [{
                "user_ip": ",".join(str(user) for user in (incident.get("affected_users") or []) if str(user)),
                "from": ",".join(str(item) for item in (incident.get("failed_sources") or []) if str(item)),
                "to": ",".join(str(item) for item in (incident.get("target_channels") or []) if str(item)),
                "terminal_outcome_classification": "NO_EXECUTION",
                "rollback_attempted": False,
            }]

        now = now_iso()
        terminal_state = str(operation.get("terminal_state") or "")
        terminal_reason = str(operation.get("terminal_reason") or "")
        incident_key = str(incident.get("incident_key") or "")
        selected_hash = str(operation.get("selected_move_hash") or incident.get("selected_move_hash") or "")
        outcome_rows: list[dict[str, Any]] = []
        prediction_rows: list[dict[str, Any]] = []
        trust_rows: list[dict[str, Any]] = []
        recommendation_rows: list[dict[str, Any]] = []
        closure_rows: list[dict[str, Any]] = []

        for index, row in enumerate(rows_for_feedback):
            classification = str(row.get("terminal_outcome_classification") or terminal_state or "NO_EXECUTION")
            if classification == "SUCCESS":
                outcome_status = "success"
                trust_delta = 1.0
                recommendation_delta = 1.0
            elif classification in {"ROLLBACK_SUCCESS", "ROLLBACK_FAILURE"}:
                outcome_status = "rollback_required"
                trust_delta = -0.5 if classification == "ROLLBACK_SUCCESS" else -1.0
                recommendation_delta = -0.7
            elif classification == "NO_EXECUTION":
                outcome_status = "no_execution"
                trust_delta = 0.0
                recommendation_delta = 0.0
            else:
                outcome_status = "failure"
                trust_delta = -1.0
                recommendation_delta = -1.0
            user = str(row.get("user_ip") or "")
            feedback_id = sha256_json({
                "operation_id": operation_id,
                "incident_key": incident_key,
                "index": index,
                "classification": classification,
                "user": user,
            })[:24]
            base = {
                "feedback_id": feedback_id,
                "operation_id": operation_id,
                "created_at": now,
                "user": user,
                "source": str(row.get("from") or ""),
                "target": str(row.get("to") or ""),
                "l3_incident_key": incident_key,
                "selected_move_hash": selected_hash,
                "terminal_state": terminal_state,
                "terminal_reason": terminal_reason,
                "terminal_outcome_classification": classification,
                "recovery_clocks": {
                    "first_failed_observation_monotonic_ns": to_int(
                        incident.get("first_failed_observation_monotonic_ns"), 0
                    ),
                    "confirmed_hard_failure_monotonic_ns": to_int(
                        incident.get("confirmed_hard_failure_monotonic_ns"), 0
                    ),
                    "monotonic_clock_domain": str(
                        incident.get("monotonic_clock_domain") or ""
                    ),
                    "source": "existing Matrix failure episode -> existing L3 incident context",
                },
                "capability": "L3_EMERGENCY_AUTONOMOUS_FAILOVER",
                "runtime_cycle": "Wake->Observation->Planner->Authority->Eligibility->Execution->Verification->RollbackOrSuccess->Learning->Evidence->OMP->CapabilityState->NextRuntimeCycle",
            }
            outcome_rows.append({
                "schema_version": "v7.execution-outcome-feedback.v1",
                **base,
                "outcome_status": outcome_status,
                "verification_result": {
                    "operation_id": operation_id,
                    "success": classification == "SUCCESS",
                    "verify_rc": row.get("verify_rc"),
                    "service_verify_rc": row.get("service_verify_rc"),
                },
                "rollback_result": {
                    "rollback_required": classification in {"ROLLBACK_SUCCESS", "ROLLBACK_FAILURE"},
                    "rollback_verdict": row.get("rollback_verdict", ""),
                    "rollback_rc": row.get("rollback_rc"),
                },
            })
            prediction_rows.append({
                "schema_version": "v7.execution-prediction-feedback.v1",
                **base,
                "outcome_status": outcome_status,
                "prediction_expected": 1.0 if classification == "SUCCESS" else 0.0,
                "prediction_actual": 1.0 if classification == "SUCCESS" else 0.0,
                "delta": 1.0 if classification == "SUCCESS" else -1.0 if outcome_status == "failure" else 0.0,
            })
            trust_rows.append({
                "schema_version": "v7.execution-trust-feedback.v1",
                **base,
                "outcome_status": outcome_status,
                "subject": str(row.get("to") or ""),
                "delta": trust_delta,
                "reason": classification.lower(),
            })
            recommendation_rows.append({
                "schema_version": "v7.execution-recommendation-feedback.v1",
                **base,
                "outcome_status": outcome_status,
                "recommendation_hash": selected_hash,
                "delta": recommendation_delta,
                "outcome": outcome_status,
            })
            closure_rows.append({
                "schema_version": "v7.execution-feedback-closure.v1",
                **base,
                "outcome_status": outcome_status,
                "object_type": "execution_feedback",
                "object_id": feedback_id,
                "closure_state": "CLOSED",
                "closure_reason": f"l3 terminal feedback materialized: {classification}",
            })

        if not existing.get("outcome") or not existing.get("prediction"):
            append_jsonl(self.state_dir / "execution-events.jsonl", outcome_rows + prediction_rows)
        if not existing.get("trust"):
            append_jsonl(self.state_dir / "runtime-trust.jsonl", trust_rows)
        if not existing.get("recommendation"):
            append_jsonl(self.state_dir / "proposal-records.jsonl", recommendation_rows)
        if not existing.get("closure"):
            append_jsonl(self.state_dir / "closure-records.jsonl", closure_rows)
        capability = self._l3_close_incident_and_update_capability(plan, already_materialized=False)
        result = {
            "active": True,
            "materialized": True,
            "operation_id": operation_id,
            "incident_key": incident_key,
            "records": {
                "outcome": len(outcome_rows),
                "prediction": len(prediction_rows),
                "trust": len(trust_rows),
                "recommendation": len(recommendation_rows),
                "closure": len(closure_rows),
            },
            "evidence_paths": {
                key: [str(path) for path in paths]
                for key, paths in self._authority_promotion_feedback_paths().items()
            },
            "capability_state": capability,
            "eligibility_consumed": bool_value(l3_eligibility.get("active")),
        }
        closure = self._l3_execution_closure_verification(plan, result, capability)
        result["execution_closure_verification"] = closure
        plan.setdefault("safety", {})["l3_execution_closure_verification"] = closure
        return result

    def _l3_execution_closure_verification(
        self,
        plan: dict[str, Any],
        learning_closure: dict[str, Any],
        capability: dict[str, Any],
    ) -> dict[str, Any]:
        safety = plan.get("safety") if isinstance(plan.get("safety"), dict) else {}
        summary = plan.get("summary") if isinstance(plan.get("summary"), dict) else {}
        operation = plan.get("operation") if isinstance(plan.get("operation"), dict) else {}
        apply_result = plan.get("apply_result") if isinstance(plan.get("apply_result"), dict) else {}
        incident = safety.get("l3_incident") if isinstance(safety.get("l3_incident"), dict) else {}
        wake = safety.get("l3_wake") if isinstance(safety.get("l3_wake"), dict) else {}
        gate = safety.get("emergency_failover_autonomy") if isinstance(safety.get("emergency_failover_autonomy"), dict) else {}
        eligibility = safety.get("l3_execution_eligibility") if isinstance(safety.get("l3_execution_eligibility"), dict) else {}
        selected = [row for row in (plan.get("selected_moves") or []) if isinstance(row, dict)]
        results = [row for row in (apply_result.get("results") or []) if isinstance(row, dict)]
        records = learning_closure.get("records") if isinstance(learning_closure.get("records"), dict) else {}
        terminal = str(incident.get("terminal_outcome") or operation.get("terminal_state") or "")

        def status(ok: bool) -> str:
            return "PASS" if ok else "FAIL"

        def row(
            stage: str,
            *,
            output_produced: bool,
            consumer: str,
            consumed: bool,
            behavior_changed: bool,
            next_output: str,
            next_output_produced: bool,
        ) -> dict[str, Any]:
            failure_reasons: list[str] = []
            if not output_produced:
                failure_reasons.append("OUTPUT_NOT_PRODUCED")
            if not consumer:
                failure_reasons.append("ORPHAN_OUTPUT")
            if consumer and not consumed:
                failure_reasons.append("OUTPUT_NOT_CONSUMED")
            if consumed and not behavior_changed:
                failure_reasons.append("NO_BEHAVIOR_CHANGE")
            if behavior_changed and not next_output_produced:
                failure_reasons.append("NEXT_OUTPUT_NOT_PRODUCED")
            return {
                "stage": stage,
                "output_produced": status(output_produced),
                "consumer": consumer or "MISSING",
                "output_consumed": status(consumed),
                "consumption_verified": status(output_produced and bool(consumer) and consumed),
                "behavior_changed": status(behavior_changed),
                "next_output": next_output,
                "next_output_produced": status(next_output_produced),
                "failure_reasons": failure_reasons,
            }

        wake_consumed = bool_value(wake.get("accepted")) and bool(wake.get("consumed_event_ids"))
        incident_ready = str(incident.get("incident_state") or "") == "READY_FOR_EXECUTION"
        planner_hash_ok = bool(selected) and str(incident.get("selected_move_hash") or "") == str(operation.get("selected_move_hash") or "")
        authority_ok = bool_value(gate.get("ok")) and str(gate.get("decision") or "") == "authorize_bounded_emergency_failover"
        eligibility_ok = bool_value(eligibility.get("active")) and str(eligibility.get("decision") or "") in {"EXECUTE", "STOP_SAFE"}
        execution_ran_or_stopped = bool_value(apply_result.get("applied")) or str(apply_result.get("reason") or "") == "l3_execution_eligibility_stop_safe"
        verification_present = any(row.get("verify_rc") is not None for row in results)
        service_verification_present = any(row.get("service_verify_rc") is not None for row in results)
        rollback_or_success = terminal in {"SUCCESS", "ROLLBACK_SUCCESS", "ROLLBACK_FAILURE", "STOP_SAFE"}
        learning_materialized = bool_value(learning_closure.get("materialized")) or str(learning_closure.get("reason") or "") == "already_materialized"
        evidence_materialized = all(to_int(records.get(key), 0) > 0 for key in ("outcome", "prediction", "trust", "recommendation", "closure")) or str(learning_closure.get("reason") or "") == "already_materialized"
        capability_consumable = bool_value(capability.get("omp_consumable")) and bool_value(capability.get("runtime_ready_for_next_incident"))

        chains = [
            row(
                "Wake",
                output_produced=bool(wake.get("decision")),
                consumer="Incident",
                consumed=wake_consumed,
                behavior_changed=incident_ready,
                next_output="Incident",
                next_output_produced=bool(incident.get("incident_key")),
            ),
            row(
                "Incident",
                output_produced=bool(incident.get("incident_key")),
                consumer="Planner/Authority/Eligibility",
                consumed=incident_ready and bool_value(incident.get("consumed")),
                behavior_changed=planner_hash_ok,
                next_output="Planner selected move",
                next_output_produced=bool(selected),
            ),
            row(
                "Planner",
                output_produced=bool(selected),
                consumer="Authority",
                consumed=bool_value((incident.get("planner_consumption") or {}).get("runtime_replaced_planner")) is False and planner_hash_ok,
                behavior_changed=authority_ok,
                next_output="Authority decision",
                next_output_produced=bool(gate.get("decision")),
            ),
            row(
                "Authority",
                output_produced=bool(gate.get("decision")),
                consumer="Eligibility",
                consumed=bool_value(eligibility.get("active")),
                behavior_changed=eligibility_ok,
                next_output="Eligibility decision",
                next_output_produced=bool(eligibility.get("decision")),
            ),
            row(
                "Eligibility",
                output_produced=bool(eligibility.get("decision")),
                consumer="Execution",
                consumed=execution_ran_or_stopped,
                behavior_changed=str(eligibility.get("decision") or "") == "EXECUTE" and bool_value(apply_result.get("applied")),
                next_output="Execution result",
                next_output_produced=bool(results),
            ),
            row(
                "Execution",
                output_produced=bool(results),
                consumer="Verification",
                consumed=verification_present,
                behavior_changed=verification_present,
                next_output="Verification result",
                next_output_produced=verification_present or service_verification_present,
            ),
            row(
                "Verification",
                output_produced=verification_present or service_verification_present,
                consumer="Rollback or Success",
                consumed=rollback_or_success,
                behavior_changed=rollback_or_success,
                next_output="Terminal outcome",
                next_output_produced=bool(terminal),
            ),
            row(
                "Rollback or Success",
                output_produced=bool(terminal),
                consumer="Learning",
                consumed=learning_materialized,
                behavior_changed=learning_materialized,
                next_output="Learning records",
                next_output_produced=learning_materialized,
            ),
            row(
                "Learning",
                output_produced=learning_materialized,
                consumer="Evidence",
                consumed=evidence_materialized,
                behavior_changed=evidence_materialized,
                next_output="Evidence records",
                next_output_produced=evidence_materialized,
            ),
            row(
                "Evidence",
                output_produced=evidence_materialized,
                consumer="Capability State",
                consumed=bool(capability.get("state")),
                behavior_changed=bool_value(capability.get("validated")) or bool_value(capability.get("production_proven")),
                next_output="Capability state",
                next_output_produced=bool(capability.get("state")),
            ),
            row(
                "Capability State",
                output_produced=bool(capability.get("state")),
                consumer="OMP",
                consumed=bool_value(capability.get("omp_consumable")),
                behavior_changed=capability_consumable,
                next_output="OMP next runtime cycle signal",
                next_output_produced=bool_value(capability.get("runtime_ready_for_next_incident")),
            ),
            row(
                "OMP",
                output_produced=bool_value(capability.get("omp_consumable")),
                consumer="Next Runtime Cycle",
                consumed=bool_value(capability.get("runtime_ready_for_next_incident")),
                behavior_changed=bool_value(capability.get("runtime_ready_for_next_incident")),
                next_output="Runtime ready for next incident",
                next_output_produced=bool_value(capability.get("runtime_ready_for_next_incident")),
            ),
            row(
                "Next Runtime Cycle",
                output_produced=bool_value(capability.get("runtime_ready_for_next_incident")),
                consumer="Legal Terminal Consumer",
                consumed=bool_value(capability.get("runtime_ready_for_next_incident")),
                behavior_changed=bool_value(capability.get("runtime_ready_for_next_incident")),
                next_output="Runtime Ready For Next Cycle",
                next_output_produced=bool_value(capability.get("runtime_ready_for_next_incident")),
            ),
        ]
        broken = [
            {
                "stage": item["stage"],
                "failure_reasons": list(item.get("failure_reasons") or []),
            }
            for item in chains
            if item.get("failure_reasons")
        ]
        complete = not broken
        return {
            "schema_version": "v7.l3-execution-closure-verification.v1",
            "capability": "L3_EMERGENCY_AUTONOMOUS_FAILOVER",
            "source_owner": "tools/v7-users-autoswitch",
            "terminal_consumer": "Runtime Ready For Next Cycle",
            "terminal_consumer_verified": complete,
            "ready_for_safe_deploy": complete,
            "behavior_chain_status": "COMPLETE" if complete else "BROKEN",
            "summary_execution_mode": str(summary.get("execution_mode") or ""),
            "operation_id": str(operation.get("operation_id") or ""),
            "terminal_outcome": terminal,
            "chains": chains,
            "broken_chains": broken,
            "new_owner_created": False,
            "new_runtime_path_created": False,
            "new_lifecycle_created": False,
        }

    def _l3_close_incident_and_update_capability(self, plan: dict[str, Any], *, already_materialized: bool) -> dict[str, Any]:
        safety = plan.get("safety") if isinstance(plan.get("safety"), dict) else {}
        incident = safety.get("l3_incident") if isinstance(safety.get("l3_incident"), dict) else {}
        runtime_record = incident.get("runtime_lifecycle") if isinstance(incident.get("runtime_lifecycle"), dict) else {}
        operation = plan.get("operation") if isinstance(plan.get("operation"), dict) else {}
        apply_result = plan.get("apply_result") if isinstance(plan.get("apply_result"), dict) else {}
        operation_id = str(operation.get("operation_id") or "")
        incident_key = str(incident.get("incident_key") or runtime_record.get("incident_key") or "")
        if not incident_key:
            return {"state": "IMPLEMENTED", "updated": False, "reason": "incident_key_missing"}

        state = self._load_l3_runtime_state()
        incidents = state.setdefault("incidents", {})
        existing = incidents.get(incident_key) if isinstance(incidents.get(incident_key), dict) else {}
        record = {**existing, **runtime_record}
        record.setdefault("schema_version", "v7.l3-runtime-incident-record.v1")
        record["incident_key"] = incident_key
        record["updated_at"] = now_iso()
        record.setdefault("opened_at", now_iso())
        terminal = str(incident.get("terminal_outcome") or operation.get("terminal_state") or "UNKNOWN")
        terminal_state = str(operation.get("terminal_state") or "")
        terminal_reason = str(operation.get("terminal_reason") or "")
        applied = bool_value(apply_result.get("applied"))
        closed = terminal in {"SUCCESS", "ROLLBACK_SUCCESS", "ROLLBACK_FAILURE", "APPLY_FAILURE", "VERIFY_FAILED"} or terminal_state in {"APPLIED", "ROLLED_BACK", "ROLLBACK_FAILED", "FAILED", "VERIFY_FAILED"}
        suspended = terminal == "STOP_SAFE" or terminal_state == "DENIED"
        successful_moves = {
            str(row.get("user_ip") or "")
            for row in (apply_result.get("results") or [])
            if isinstance(row, dict)
            and str(row.get("terminal_outcome_classification") or "") == "SUCCESS"
            and str(row.get("from") or "") in set(str(item) for item in (record.get("failed_sources") or []) if str(item))
        }
        continuation_scopes = [
            self._l3_failed_source_scope(
                str(source),
                excluding_users=successful_moves,
                required_services=list(record.get("failed_required_services") or []),
            )
            for source in (record.get("failed_sources") or [])
            if str(source)
        ]
        active_continuations = [
            scope for scope in continuation_scopes
            if bool_value(scope.get("source_failed")) and to_int(scope.get("affected_users_count"), 0) > 0
        ]
        success_terminal = terminal == "SUCCESS" or terminal_state == "APPLIED"
        keep_open_for_remaining_users = closed and success_terminal and bool(active_continuations)
        record["incident_source_continuity"] = {
            "schema_version": "v7.l3-incident-source-continuity.v1",
            "active": bool(active_continuations),
            "kept_open": keep_open_for_remaining_users,
            "reason": "remaining_enabled_users_on_failed_incident_source" if keep_open_for_remaining_users else "terminal_closure_allowed",
            "successful_users_excluded": sorted(successful_moves),
            "scopes": continuation_scopes,
            "owner": "tools/v7-users-autoswitch._l3_close_incident_and_update_capability",
        }
        if keep_open_for_remaining_users:
            closed = False
            suspended = False
        record["status"] = "CLOSED" if closed else ("SUSPENDED" if suspended else "OPEN")
        if closed:
            record["closed_at"] = now_iso()
        elif keep_open_for_remaining_users:
            record["closed_at"] = ""
        record["terminal_outcome"] = terminal
        record["terminal_state"] = terminal_state
        record["terminal_reason"] = terminal_reason
        attempts = [row for row in (record.get("attempts") or []) if isinstance(row, dict)]
        if operation_id and not any(str(row.get("operation_id") or "") == operation_id for row in attempts):
            attempts.append({
                "operation_id": operation_id,
                "selected_move_hash": str(operation.get("selected_move_hash") or incident.get("selected_move_hash") or ""),
                "semantic_attempt_signature": str(runtime_record.get("semantic_attempt_signature") or ""),
                "terminal_outcome": terminal,
                "terminal_state": terminal_state,
                "applied": applied,
                "recorded_at": now_iso(),
                "already_materialized": already_materialized,
            })
        record["attempts"] = attempts[-50:]
        record["attempt_count"] = len(record["attempts"])
        record["consumed"] = True
        record["feeds_next_runtime_cycle"] = True
        incidents[incident_key] = record

        processed = set(str(item) for item in (state.get("processed_event_ids") or []))
        processed.update(str(item) for item in (((safety.get("l3_wake") or {}).get("consumed_event_ids") or [])) if str(item))
        state["processed_event_ids"] = sorted(processed)[-500:]

        feedback_projection = self._l3_feedback_rows_excluding_n10_products()
        rows = feedback_projection["execution_rows"]
        outcome_rows = [row for row in rows if "execution-outcome" in str(row.get("schema_version") or "")]
        success_count = sum(1 for row in outcome_rows if str(row.get("outcome_status") or "") == "success")
        rollback_count = sum(1 for row in outcome_rows if str(row.get("outcome_status") or "") == "rollback_required")
        failure_count = sum(1 for row in outcome_rows if str(row.get("outcome_status") or "") in {"failure", "no_execution"})
        closure_count = len(feedback_projection["closure_rows"])
        capability_state = "IMPLEMENTED"
        if outcome_rows:
            capability_state = "VALIDATED"
        if success_count or rollback_count:
            capability_state = "PRODUCTION_PROVEN"
        if success_count and closure_count:
            capability_state = "CERTIFIED"
        if capability_state == "CERTIFIED" and bool_value(self.emergency_failover_policy.get("enabled")):
            capability_state = "ACTIVE_CAPABILITY"
        capability = {
            "schema_version": "v7.l3-capability-state.v1",
            "capability": "L3_EMERGENCY_AUTONOMOUS_FAILOVER",
            "state": capability_state,
            "implemented": True,
            "validated": bool(outcome_rows),
            "production_proven": bool(success_count or rollback_count),
            "certified": bool(success_count and closure_count),
            "active_capability": capability_state == "ACTIVE_CAPABILITY",
            "success_outcomes": success_count,
            "rollback_outcomes": rollback_count,
            "failure_or_no_execution_outcomes": failure_count,
            "closure_records": closure_count,
            "last_operation_id": operation_id,
            "last_incident_key": incident_key,
            "runtime_ready_for_next_incident": True,
            "omp_consumable": True,
            "updated": now_iso(),
        }
        state["capability"] = capability
        self._write_l3_runtime_state(state)
        write_json_atomic(self.l3_capability_state_file, capability)
        return capability

    def _terminal_verdict(self, plan: dict[str, Any]) -> dict[str, str]:
        apply_result = plan.get("apply_result") or {}
        if not apply_result.get("applied"):
            reason = str(apply_result.get("reason") or "not_applied")
            if reason == "dry_run":
                state = "DRY_RUN"
                reason = self._dry_run_terminal_reason(plan)
            elif reason == "no_selected_moves":
                state = "NOOP"
            else:
                state = "DENIED"
            return {"terminal_state": state, "terminal_reason": reason}
        results = apply_result.get("results") or []
        if any(row.get("rollback_rc") is not None for row in results):
            if all(row.get("rollback_rc") in (None, 0) for row in results):
                return {"terminal_state": "ROLLED_BACK", "terminal_reason": "verification_failed_rollback_completed"}
            return {"terminal_state": "ROLLBACK_FAILED", "terminal_reason": "verification_failed_rollback_failed"}
        if any(row.get("verify_rc") not in (None, 0) for row in results):
            return {"terminal_state": "VERIFY_FAILED", "terminal_reason": "route_verify_failed"}
        if any(row.get("rc") != 0 for row in results):
            if any(row.get("rc") == 0 for row in results):
                return {"terminal_state": "PARTIAL_SUCCESS", "terminal_reason": "partial_apply_failure"}
            return {"terminal_state": "FAILED", "terminal_reason": "switch_command_failed"}
        return {"terminal_state": "APPLIED", "terminal_reason": "selected_moves_applied"}

    def _dry_run_terminal_reason(self, plan: dict[str, Any]) -> str:
        if plan.get("selected_moves"):
            return "dry_run_selected_moves_available"
        snapshot_gate = (plan.get("safety") or {}).get("intelligence_snapshots") or {}
        if bool_value(snapshot_gate.get("active")) and bool_value(snapshot_gate.get("stop_required")):
            return "dry_run_intelligence_snapshot_stop_required"
        barrier = (plan.get("safety") or {}).get("restore_barrier") or {}
        if bool_value(barrier.get("active")):
            return "dry_run_restore_barrier_active"
        if bool_value(barrier.get("post_ttl_blocking")):
            return "dry_run_restore_barrier_post_ttl_blocking"
        for key in ("clearance_guard_reason", "clearance_generation_reason"):
            value = str(barrier.get(key) or "")
            if value:
                return f"dry_run_{value}"
        barrier_reason = str(barrier.get("reason") or "")
        if barrier_reason:
            return f"dry_run_restore_barrier_{barrier_reason}"
        for decision in plan.get("decisions") or []:
            for reason in decision.get("reason") or []:
                if str(reason).startswith(("restore_", "no_eligible_", "current_egress_")):
                    return f"dry_run_{reason}"
        return "dry_run_no_selected_moves"

    def _rollback_verdict(self, plan: dict[str, Any]) -> dict[str, Any]:
        rows = [
            row for row in ((plan.get("apply_result") or {}).get("results") or [])
            if row.get("rollback_attempted") or row.get("rollback_rc") is not None
        ]
        if not rows:
            return {}
        failed = [row for row in rows if row.get("rollback_rc") not in (0, None)]
        return {
            "rollback_attempted": True,
            "rollback_result": "FAIL" if failed else "OK",
            "rollback_verdict": "ROLLBACK_FAILED" if failed else "ROLLBACK_COMPLETED",
            "rollback_rows": len(rows),
        }

    def _restore_barrier_status_label(self, plan: dict[str, Any]) -> str:
        barrier = (plan.get("safety") or {}).get("restore_barrier") or {}
        if bool_value(barrier.get("active")):
            return "active"
        if bool_value(barrier.get("post_ttl_blocking")):
            return "post_ttl_blocking"
        if barrier.get("clearance_guard_reason"):
            return str(barrier.get("clearance_guard_reason"))
        if bool_value(barrier.get("expired")) and bool_value(barrier.get("cleared")):
            return "expired_cleared"
        return "settled"

    def _terminal_audit_reference(self, plan: dict[str, Any], rollback: dict[str, Any]) -> dict[str, Any]:
        operation = plan.get("operation") or {}
        metadata = {
            "operation_id": operation.get("operation_id", ""),
            "operation_owner": operation.get("operation_owner", ""),
            "operation_type": operation.get("operation_type", ""),
            "planner_generation_id": operation.get("planner_generation_id", ""),
            "selected_move_hash": operation.get("selected_move_hash", ""),
            "selected_move_count": operation.get("selected_move_count", 0),
            "runtime_snapshot_hash": operation.get("runtime_snapshot_hash", ""),
            "terminal_state": operation.get("terminal_state", ""),
            "terminal_reason": operation.get("terminal_reason", ""),
            "restore_barrier_status": self._restore_barrier_status_label(plan),
            "rollback_verdict": rollback.get("rollback_verdict", ""),
            "apply_requested": bool(plan.get("apply_requested")),
            "mode": plan.get("mode", ""),
            "target_egress": plan.get("target_egress", ""),
        }
        return {
            "action": "runtime_operation_terminal",
            "component": "autoswitch",
            "object_type": "runtime_operation",
            "object_id": operation.get("operation_id", ""),
            "result": operation.get("terminal_state", ""),
            "metadata": metadata,
            "emitted": False,
            "status": "ready_not_emitted_dry_run" if not self.args.apply else "ready_to_emit",
        }

    def _rollback_audit_reference(
        self,
        operation: dict[str, Any],
        packet: dict[str, Any],
        rollback_result: dict[str, Any],
    ) -> dict[str, Any]:
        source = packet.get("source_operation") or {}
        metadata = {
            "operation_id": operation.get("operation_id", ""),
            "operation_owner": operation.get("operation_owner", ""),
            "operation_type": operation.get("operation_type", ""),
            "source_operation_id": operation.get("source_operation_id", ""),
            "rollback_packet_id": packet.get("rollback_packet_id", ""),
            "selected_move_hash": operation.get("selected_move_hash", ""),
            "selected_move_count": source.get("selected_move_count", 0),
            "terminal_state": operation.get("terminal_state", ""),
            "terminal_reason": operation.get("terminal_reason", ""),
            "rollback_verdict": operation.get("rollback_verdict", operation.get("terminal_state", "")),
            "rollback_rows": len((rollback_result.get("results") or [])),
            "apply_requested": bool(self.args.apply),
            "mode": "rollback",
        }
        return {
            "action": "runtime_operation_terminal",
            "component": "autoswitch",
            "object_type": "runtime_rollback",
            "object_id": operation.get("operation_id", ""),
            "result": operation.get("terminal_state", ""),
            "metadata": metadata,
            "emitted": False,
            "status": "ready_not_emitted_dry_run" if not self.args.apply else "ready_to_emit",
        }

    def _emit_terminal_audit(self, audit: dict[str, Any]) -> dict[str, Any]:
        metadata = audit.get("metadata") or {}
        args = [
            f"object_type={audit.get('object_type', '')}",
            f"object_id={audit.get('object_id', '')}",
            f"result={audit.get('result', '')}",
        ]
        args.extend(f"{key}={value}" for key, value in metadata.items() if value not in (None, ""))
        try:
            proc = subprocess.run(
                ["v7-audit-log", audit["action"], audit["component"], f"operation_id={audit.get('object_id', '')}", *args],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=10,
            )
            audit["emitted"] = proc.returncode == 0
            audit["status"] = "emitted" if proc.returncode == 0 else "emit_failed"
            audit["output"] = proc.stdout[-1000:]
        except (OSError, subprocess.TimeoutExpired) as exc:
            audit["emitted"] = False
            audit["status"] = "emit_failed"
            audit["error"] = str(exc)
        return audit

    def _closure_target(self, operation: dict[str, Any], audit: dict[str, Any]) -> dict[str, Any]:
        return {
            "object_type": "runtime",
            "object_id": operation.get("operation_id", ""),
            "closure_owner": "admin/v7-admin-api",
            "observability_owner": "admin_core/operator_observability.py",
            "closure_state": "OPEN" if not audit.get("emitted") else "VERIFIED_READY",
            "closure_blocker": "" if audit.get("emitted") else "audit_missing",
        }

    def _future_iso(self, seconds: int) -> str:
        return datetime.fromtimestamp(time.time() + max(0, seconds), timezone.utc).isoformat()

    def _update_safety_after_apply(self, results: list[dict[str, Any]]) -> None:
        changed = False
        safety = self._compact_safety(self.safety_state)
        users = safety.setdefault("users", {})
        egress_rows = safety.setdefault("egress", {})
        for result in results:
            if result.get("rc") != 0:
                continue
            ts = now_iso()
            ip = str(result.get("user_ip") or "")
            target = str(result.get("to") or "")
            source = str(result.get("from") or "")
            move_type = str(result.get("move_type") or "")
            if not ip or not target:
                continue
            row = users.setdefault(ip, {})
            recent = row.setdefault("recent_switches", [])
            recent.append({"ts": ts, "from": source, "to": target, "move_type": move_type})
            row["recent_switches"] = recent[-10:]
            row["last_switch_at"] = ts
            targets = [item.get("to") for item in row["recent_switches"][-3:] if item.get("to")]
            row["last_targets"] = targets
            if len(targets) >= 3 and targets[-1] == targets[-3] and targets[-2]:
                blocked = row.setdefault("blocked_targets", {})
                blocked[str(targets[-2])] = self._future_iso(to_int(self.safety_policy.get("target_block_seconds"), 1800))

            recent_1h = [item for item in row["recent_switches"] if time.time() - parse_ts(item.get("ts")) <= 3600]
            recent_24h = [item for item in row["recent_switches"] if time.time() - parse_ts(item.get("ts")) <= 86400]
            row["switches_1h"] = len(recent_1h)
            row["switches_24h"] = len(recent_24h)
            if row["switches_24h"] >= to_int(self.safety_policy.get("user_freeze_switches_24h"), 5):
                row["penalty_until"] = self._future_iso(to_int(self.safety_policy.get("user_freeze_24h_seconds"), 21600))
            elif row["switches_1h"] >= to_int(self.safety_policy.get("user_freeze_switches_1h"), 2):
                row["penalty_until"] = self._future_iso(to_int(self.safety_policy.get("user_freeze_1h_seconds"), 3600))

            target_row = egress_rows.setdefault(target, {})
            incoming = target_row.setdefault("incoming", [])
            incoming.append({"ts": ts, "user_ip": ip, "move_type": move_type})
            target_row["incoming"] = incoming[-200:]
            reconnect_user = (self.reconnect_state.get("users") or {}).get(ip)
            if isinstance(reconnect_user, dict):
                reconnect_user["current_egress"] = target
                reconnect_user["last_rotation_epoch"] = int(time.time())
                reconnect_user["last_rotation_at"] = ts

            if result.get("verify_rc") not in (None, 0):
                failed = target_row.setdefault("failed_verifications", [])
                verification_scope = "selected_user_route_check" if str(result.get("route_verification_scope") or "") == "selected_user" else "global_route_check"
                failure_record = {
                    "ts": ts,
                    "user_ip": ip,
                    "verify_rc": result.get("verify_rc"),
                    "verification_scope": verification_scope,
                    "verification_failure_reason": str(result.get("verification_failure_reason") or ""),
                }
                if result.get("route_verification_expected_egress"):
                    failure_record["verification_expected_egress"] = str(result.get("route_verification_expected_egress") or "")
                failed.append(failure_record)
                target_row["failed_verifications"] = failed[-50:]
                scoped_failures = [
                    item for item in target_row["failed_verifications"]
                    if time.time() - parse_ts(item.get("ts")) <= 3600
                    and str(item.get("verification_scope") or "") == "selected_user_route_check"
                    and str(item.get("verification_expected_egress") or "") == target
                ]
                if len(scoped_failures) >= to_int(self.safety_policy.get("egress_quarantine_failed_verifications_1h"), 2):
                    target_row["quarantine_until"] = self._future_iso(to_int(self.safety_policy.get("egress_quarantine_seconds"), 3600))
                    target_row["quarantine_reason"] = "selected_user_route_verification_failed"
            changed = True
        if changed:
            safety = self._compact_safety(safety)
            write_json_atomic(self.safety_file, safety)
            self.safety_state = safety
            if isinstance(self.reconnect_state, dict):
                self.reconnect_state["updated"] = now_iso()
                write_json_atomic(self.reconnect_state_file, self.reconnect_state)

    def _core_primary_cohort_active(self) -> dict[str, Any]:
        """Read the existing Core-primary owner; this creates no new truth."""
        try:
            proc = subprocess.run(
                ["v7-routing-sync", "--core-primary-active", "--json"],
                text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                check=False, timeout=15,
            )
            payload = json.loads(proc.stdout or "{}")
        except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
            payload = {}
        return {
            "ok": proc.returncode == 0 and payload.get("status") == "CORE_PRIMARY_ACTIVE"
            if "proc" in locals() else False,
            "owner": "existing v7-routing-sync Core-primary owner",
            "status": str(payload.get("status") or "UNAVAILABLE"),
            "runtime_mutation": False,
        }

    def _core_primary_cohort_commit(
        self, members: list[str], operation_id: str,
    ) -> subprocess.CompletedProcess[str]:
        argv = [
            "v7-routing-sync", "--core-primary-cohort-commit",
            "--operation-id", operation_id,
        ]
        for member in sorted(set(members)):
            argv.extend(["--cohort-user", member])
        try:
            return subprocess.run(
                argv, text=True, stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT, check=False, timeout=30,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            return subprocess.CompletedProcess(argv, 2, stdout=f"STOP_SAFE: core-primary cohort commit unavailable: {exc}\n")

    def _core_primary_cohort_admissible(
        self, selected_moves: list[dict[str, Any]],
    ) -> dict[str, Any]:
        """Ask the existing Core-primary owner before consuming N10 Authority."""
        members = sorted({str(row.get("user_ip") or "") for row in selected_moves})
        targets = {str(row.get("recommended_egress") or "") for row in selected_moves}
        if len(targets) != 1 or not all(members):
            return {
                "ok": False,
                "status": "STOP_SAFE",
                "blockers": ["core_primary_cohort_exact_one_target_required"],
                "runtime_mutation": False,
            }
        argv = [
            "v7-routing-sync", "--core-primary-cohort-admissible",
            "--cohort-target", next(iter(targets)), "--json",
        ]
        for member in members:
            argv.extend(["--cohort-user", member])
        try:
            proc = subprocess.run(
                argv, text=True, stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT, check=False, timeout=15,
            )
            payload = json.loads(proc.stdout or "{}")
        except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
            payload = {}
            proc = subprocess.CompletedProcess(argv, 2)
        return {
            **payload,
            "ok": (
                proc.returncode == 0
                and payload.get("status") == "CORE_PRIMARY_COHORT_ADMISSIBLE"
            ),
            "owner": "existing v7-routing-sync Core-primary owner",
        }

    def _cohort_rollback_to_preimage(
        self, *, rows: list[dict[str, Any]], entry_control: dict[str, Any],
        action_class: str, operation_id: str, publish_projection: bool = True,
    ) -> dict[str, Any]:
        """Return staged canonical rows, then publish one matching map delta."""
        rollback_rows: list[dict[str, Any]] = []
        for row in reversed(rows):
            rollback_control = self._execution_control_decision(
                mutation_kind="rollback", action_class=action_class,
                expected_generation=str(entry_control.get("generation") or ""),
                rollback_certified=True, operation_id=operation_id,
            )
            if not rollback_control.get("rollback_only_allowed"):
                return {"ok": False, "reason": "core_primary_cohort_rollback_control_denied", "rows": rollback_rows}
            self._active_execution_control = rollback_control
            proc = self._run_switch(
                str(row.get("user_ip") or ""), str(row.get("from") or ""), "rollback",
            )
            rollback_rows.append({"user_ip": row.get("user_ip"), "rc": proc.returncode})
            if proc.returncode != 0:
                return {"ok": False, "reason": "core_primary_cohort_member_rollback_failed", "rows": rollback_rows}
        if not publish_projection:
            return {"ok": True, "reason": "", "rows": rollback_rows, "projection": {"status": "PREIMAGE_MAP_RETAINED"}}
        commit = self._core_primary_cohort_commit(
            [str(row.get("user_ip") or "") for row in rows], operation_id,
        )
        try:
            payload = json.loads(commit.stdout or "{}")
        except json.JSONDecodeError:
            payload = {}
        return {
            "ok": commit.returncode == 0 and payload.get("status") == "CORE_PRIMARY_COHORT_COMMIT_PASS",
            "reason": "" if commit.returncode == 0 and payload.get("status") == "CORE_PRIMARY_COHORT_COMMIT_PASS" else "core_primary_cohort_rollback_projection_commit_failed",
            "rows": rollback_rows,
            "projection": payload,
        }

    def _apply_n10_core_primary_cohort(
        self, plan: dict[str, Any], *, selected_moves: list[dict[str, Any]],
        entry_control: dict[str, Any], action_class: str, selected_hash: str,
        execution_control_bindings: dict[str, Any], bounded_checkpoint: dict[str, Any],
    ) -> dict[str, Any]:
        """Consume one existing N10 cohort through one Core-primary map commit."""
        operation_id = str((plan.get("operation") or {}).get("operation_id") or "")
        results: list[dict[str, Any]] = []
        circuit_breaker = {
            "owner": "tools/v7-users-autoswitch.apply",
            "policy": "stop_remaining_forward_mutations_after_first_non_success",
            "tripped": False, "trigger_user": "", "trigger_terminal": "",
            "remaining_not_attempted": 0,
        }
        self._core_primary_cohort_defer = True
        try:
            for index, move in enumerate(selected_moves):
                control = self._execution_control_decision(
                    mutation_kind="forward", action_class=action_class,
                    expected_generation=str(entry_control.get("generation") or ""),
                    operation_id=operation_id, selected_move_hash=selected_hash,
                    source_bundle_hash=str(execution_control_bindings.get("source_bundle_hash") or ""),
                    snapshot_bundle_hash=str(execution_control_bindings.get("snapshot_bundle_hash") or ""),
                    max_users=to_int(execution_control_bindings.get("max_users"), 0),
                )
                if not control.get("allowed_forward_mutation"):
                    circuit_breaker.update({"tripped": True, "trigger_user": str(move.get("user_ip") or ""), "trigger_terminal": "CONTROL_DENIED", "remaining_not_attempted": len(selected_moves) - index})
                    break
                self._active_execution_control = control
                started_ns = time.monotonic_ns()
                proc = self._run_switch(
                    str(move.get("user_ip") or ""),
                    str(move.get("recommended_egress") or ""),
                    str(move.get("move_type") or "planned"),
                )
                row = {
                    "user_ip": str(move.get("user_ip") or ""),
                    "from": str(move.get("current_egress") or ""),
                    "to": str(move.get("recommended_egress") or ""),
                    "move_type": move.get("move_type"), "operation_id": operation_id,
                    "selected_move_hash": selected_hash, "rc": proc.returncode,
                    "output": (proc.stdout or "")[-4000:],
                    "route_writer_timing": self._record_performance_span(
                        "route_writer_subprocess_and_low_level_mutation", started_ns,
                        owner="existing v7-user-switch route writer",
                        status="PASS" if proc.returncode == 0 else "FAIL",
                        parent="apply_and_verification",
                    ),
                    "core_primary_projection": "STAGED" if proc.returncode == 0 else "NOT_STAGED",
                    "terminal_outcome_classification": "COHORT_PROJECTION_PENDING" if proc.returncode == 0 else "APPLY_FAILURE",
                    "rollback_attempted": False,
                }
                results.append(row)
                if proc.returncode != 0:
                    circuit_breaker.update({"tripped": True, "trigger_user": row["user_ip"], "trigger_terminal": "APPLY_FAILURE", "remaining_not_attempted": len(selected_moves) - index - 1})
                    break
            if len(results) != len(selected_moves) or any(row["rc"] != 0 for row in results):
                rollback = self._cohort_rollback_to_preimage(
                    rows=[row for row in results if row["rc"] == 0], entry_control=entry_control,
                    action_class=action_class, operation_id=operation_id,
                    publish_projection=False,
                ) if any(row["rc"] == 0 for row in results) else {"ok": True, "rows": []}
                for row in results:
                    if row["rc"] == 0:
                        row.update({"rollback_attempted": True, "rollback_result": "OK" if rollback.get("ok") else "FAIL", "terminal_outcome_classification": "ROLLBACK_SUCCESS" if rollback.get("ok") else "ROLLBACK_FAILURE"})
                plan.setdefault("safety", {})["core_primary_cohort_rollback"] = rollback
            else:
                projection = self._core_primary_cohort_commit(
                    [row["user_ip"] for row in results], operation_id,
                )
                try:
                    projection_payload = json.loads(projection.stdout or "{}")
                except json.JSONDecodeError:
                    projection_payload = {}
                plan.setdefault("safety", {})["core_primary_cohort_projection_commit"] = projection_payload
                if projection.returncode != 0 or projection_payload.get("status") != "CORE_PRIMARY_COHORT_COMMIT_PASS":
                    rollback = self._cohort_rollback_to_preimage(rows=results, entry_control=entry_control, action_class=action_class, operation_id=operation_id)
                    for row in results:
                        row.update({"rollback_attempted": True, "rollback_result": "OK" if rollback.get("ok") else "FAIL", "terminal_outcome_classification": "ROLLBACK_SUCCESS" if rollback.get("ok") else "ROLLBACK_FAILURE"})
                    circuit_breaker.update({"tripped": True, "trigger_terminal": "CORE_PRIMARY_COHORT_COMMIT_FAILED"})
                    plan.setdefault("safety", {})["core_primary_cohort_rollback"] = rollback
                else:
                    failed = False
                    for row in results:
                        verify = self._verify_routes_for_apply(row["user_ip"], row["to"])
                        service_verify = None
                        if verify.returncode == 0:
                            service_started_ns = time.monotonic_ns()
                            service_verify = self._reuse_or_verify_emergency_required_services({
                                "user_ip": row["user_ip"],
                                "recommended_egress": row["to"],
                            })
                            row["service_verification_timing"] = (
                                self._record_performance_span(
                                    "required_service_verification",
                                    service_started_ns,
                                    owner="existing v7-service-matrix-test",
                                    status=(
                                        "PASS"
                                        if service_verify.returncode == 0
                                        else "FAIL"
                                    ),
                                    parent="apply_and_verification",
                                )
                            )
                        row.update({
                            "verify_rc": verify.returncode,
                            "verify_output": (verify.stdout or "")[-4000:],
                            "service_verify_rc": (
                                service_verify.returncode
                                if service_verify is not None else None
                            ),
                            "service_verify_output": (
                                (service_verify.stdout or "")[-4000:]
                                if service_verify is not None else ""
                            ),
                            "route_verification_scope": "selected_user_then_whole_system",
                            "terminal_outcome_classification": (
                                "SUCCESS"
                                if verify.returncode == 0
                                and service_verify is not None
                                and service_verify.returncode == 0
                                else "VERIFY_FAILED"
                            ),
                            "core_primary_projection": "COMMITTED",
                        })
                        failed = failed or verify.returncode != 0 or (
                            service_verify is None or service_verify.returncode != 0
                        )
                    if failed:
                        rollback = self._cohort_rollback_to_preimage(rows=results, entry_control=entry_control, action_class=action_class, operation_id=operation_id)
                        for row in results:
                            row.update({"rollback_attempted": True, "rollback_result": "OK" if rollback.get("ok") else "FAIL", "terminal_outcome_classification": "ROLLBACK_SUCCESS" if rollback.get("ok") else "ROLLBACK_FAILURE"})
                        circuit_breaker.update({"tripped": True, "trigger_terminal": "POST_COMMIT_VERIFY_FAILED"})
                        plan.setdefault("safety", {})["core_primary_cohort_rollback"] = rollback
        finally:
            self._core_primary_cohort_defer = False
        cohort_success = len(results) == len(selected_moves) and all(row.get("terminal_outcome_classification") == "SUCCESS" for row in results)
        checkpoint = self._bounded_cohort_checkpoint(
            plan, selected_moves, results=results,
            terminal_state="SUCCESS" if cohort_success else "CONTAINED_STOP_SAFE",
            terminal_reason="core_primary_cohort_projection_verified" if cohort_success else "core_primary_cohort_projection_contained",
        )
        self._update_safety_after_apply(results)
        plan.setdefault("safety", {})["cohort_circuit_breaker"] = circuit_breaker
        return {
            "applied": bool(results), "results": results,
            "safety_file": str(self.safety_file),
            "cohort_circuit_breaker": circuit_breaker,
            "remaining_forward_mutations_stopped": circuit_breaker["tripped"],
            "bounded_cohort_transaction": checkpoint.get("checkpoint") or bounded_checkpoint.get("checkpoint") or {},
            "core_primary_cohort_projection": True,
        }

    def _run_switch(self, ip: str, egress: str, reason: str) -> subprocess.CompletedProcess[str]:
        control = dict(self._active_execution_control or {})
        mutation_kind = "rollback" if reason == "rollback" else "forward"
        live = self._execution_control_decision(
            mutation_kind=mutation_kind,
            action_class=str(control.get("action_class") or self._execution_action_class(reason)),
            expected_generation=str(control.get("generation") or ""),
            rollback_certified=mutation_kind == "rollback" and bool(control.get("rollback_only_allowed")),
            operation_id=str(control.get("operation_id") or ""),
            selected_move_hash=str(control.get("selected_move_hash") or ""),
            source_bundle_hash=str(control.get("source_bundle_hash") or ""),
            snapshot_bundle_hash=str(control.get("snapshot_bundle_hash") or ""),
            max_users=to_int(control.get("max_users"), 0),
        )
        if not live.get("allowed"):
            return subprocess.CompletedProcess(["v7-user-switch", ip, egress], 2, stdout="STOP_SAFE: autonomous execution control denied\n")
        env = os.environ.copy()
        env["V7_SWITCH_REASON"] = f"autoswitch_{reason}"
        env["V7_EXECUTION_CONTROL_GENERATION"] = str(live.get("generation") or "")
        env["V7_EXECUTION_MUTATION_KIND"] = mutation_kind
        env["V7_EXECUTION_OPERATION_ID"] = str(live.get("operation_id") or "")
        env["V7_EXECUTION_ACTION_CLASS"] = str(live.get("action_class") or "")
        env["V7_EXECUTION_SELECTED_MOVE_HASH"] = str(live.get("selected_move_hash") or "")
        env["V7_EXECUTION_SOURCE_BUNDLE_HASH"] = str(live.get("source_bundle_hash") or "")
        env["V7_EXECUTION_SNAPSHOT_BUNDLE_HASH"] = str(live.get("snapshot_bundle_hash") or "")
        env["V7_EXECUTION_MAX_USERS"] = str(live.get("max_users") or "")
        env["V7_EXECUTION_ROLLBACK_CERTIFIED"] = "1" if live.get("rollback_only_allowed") else "0"
        control_file = Path(
            getattr(
                self.args,
                "execution_control_file",
                DEFAULT_EXECUTION_CONTROL_FILE,
            )
        )
        env["V7_ADMIN_SAFE_MODE_FILE"] = str(control_file)
        env["V7_EXECUTION_CONTROL_FILE_HASH"] = sha256_file(control_file)
        if bool(getattr(self, "_core_primary_cohort_defer", False)):
            env["V7_CORE_PRIMARY_COHORT_DEFER"] = "1"
        return subprocess.run(
            ["v7-user-switch", ip, egress],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=30,
            env=env,
        )

    def _verify_routes(self, user_ip: str = "", expected_egress: str = "") -> subprocess.CompletedProcess[str]:
        if user_ip:
            return self._verify_user_route(user_ip, expected_egress)
        return subprocess.run(
            ["v7-user-route-check"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=20,
        )

    def _verify_routes_for_apply(self, user_ip: str = "", expected_egress: str = "") -> subprocess.CompletedProcess[str]:
        if not user_ip:
            return self._verify_routes()
        try:
            return self._verify_routes(user_ip, expected_egress)  # type: ignore[misc]
        except TypeError:
            return self._verify_routes()

    def _verify_user_route(self, user_ip: str, expected_egress: str = "") -> subprocess.CompletedProcess[str]:
        argv = ["v7-users-autoswitch", "--verify-user-route", user_ip]
        lines = ["===== V7 SCOPED USER ROUTE REALITY CHECK =====", now_iso(), f"user_ip={user_ip}"]
        # Codes identify only failed routing invariants. The verification owner
        # retains raw command output; callers retain no user identity here.
        failure_categories: list[str] = []
        if not SAFE_IP_RE.match(user_ip):
            lines.append(f"FAIL: unsafe user ip: {user_ip}")
            lines.append("V7_SCOPED_USER_ROUTE_FAILURE_CATEGORIES=INVALID_USER_IP")
            return subprocess.CompletedProcess(argv, 1, stdout="\n".join(lines) + "\n")
        users = {user.ip: user for user in self._load_runtime_registry_users()}
        user = users.get(user_ip)
        if not user or not user.enabled:
            lines.append(f"FAIL: user={user_ip} not found or disabled")
            lines.append("V7_SCOPED_USER_ROUTE_FAILURE_CATEGORIES=USER_UNAVAILABLE")
            return subprocess.CompletedProcess(argv, 1, stdout="\n".join(lines) + "\n")
        expected_id = str(expected_egress or user.current)
        egress = self._load_egress().get(expected_id)
        if not egress or not egress.interface:
            lines.append(f"FAIL: user={user_ip} unknown egress={expected_id}")
            lines.append("V7_SCOPED_USER_ROUTE_FAILURE_CATEGORIES=EXPECTED_EGRESS_UNAVAILABLE")
            return subprocess.CompletedProcess(argv, 1, stdout="\n".join(lines) + "\n")
        assign_path = self.state_dir / f"user-{user_ip}.assign"
        assign_egress = ""
        try:
            for raw in assign_path.read_text(encoding="utf-8").splitlines():
                if raw.startswith("egress="):
                    assign_egress = raw.split("=", 1)[1].strip()
                    break
        except OSError:
            assign_egress = "missing"
        lines.append(f"USER={user.ip} TABLE={user.table} REGISTRY_EGRESS={user.current} ASSIGN_EGRESS={assign_egress or 'missing'} EXPECTED_EGRESS={expected_id} EXPECTED_DEV={egress.interface}")
        route_rc = 0
        if assign_egress and assign_egress != "missing" and assign_egress != user.current:
            route_rc = 1
            failure_categories.append("REGISTRY_ASSIGNMENT_MISMATCH")
            lines.append(f"FAIL: user={user.ip} registry/assign mismatch registry={user.current} assign={assign_egress}")
        else:
            lines.append(f"OK: user={user.ip} registry matches assignment")
        try:
            core = subprocess.run(
                ["v7-routing-sync", "--core-primary-verify", "--json"],
                text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                check=False, timeout=10,
            )
            core_payload = json.loads(core.stdout or "{}")
        except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
            core_payload = {}
            core = subprocess.CompletedProcess(argv, 2)
        if core.returncode == 0 and core_payload.get("status") == "CORE_PRIMARY_VERIFY_PASS":
            lines.append("OK: user is covered by verified Core-primary class routing")
            if failure_categories:
                lines.append(
                    "V7_SCOPED_USER_ROUTE_FAILURE_CATEGORIES="
                    + ",".join(sorted(set(failure_categories)))
                )
            lines.append("V7_SCOPED_USER_ROUTE_CHECK=" + ("OK" if route_rc == 0 else "FAIL"))
            return subprocess.CompletedProcess(argv, route_rc, stdout="\n".join(lines) + "\n")
        try:
            policy_rules = subprocess.run(
                ["ip", "rule", "show"],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=10,
            )
            table_route = subprocess.run(
                ["ip", "route", "show", "table", str(user.table)],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=10,
            )
            route_get = subprocess.run(
                ["ip", "route", "get", "8.8.8.8", "from", user.ip, "iif", "wg0"],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=10,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            lines.append(f"FAIL: route verification command failed: {exc}")
            lines.append("V7_SCOPED_USER_ROUTE_FAILURE_CATEGORIES=ROUTE_COMMAND_UNAVAILABLE")
            return subprocess.CompletedProcess(argv, 1, stdout="\n".join(lines) + "\n")
        expected_rule_fragments = (
            f"from {user.ip} lookup {user.table}",
            f"from {user.ip}/32 lookup {user.table}",
        )
        rule_ok = any(fragment in policy_rules.stdout for fragment in expected_rule_fragments)
        rule_fingerprint = hashlib.sha256((policy_rules.stdout or "").encode("utf-8")).hexdigest()
        lines.append(f"policy_rule_fingerprint={rule_fingerprint}")
        if policy_rules.returncode == 0 and rule_ok:
            lines.append(f"OK: user={user.ip} policy rule selects table {user.table}")
        else:
            route_rc = 1
            failure_categories.append("POLICY_RULE_MISSING")
            lines.append(f"FAIL: user={user.ip} policy rule does not select table {user.table}")
        lines.append(f"table_route={table_route.stdout.strip()}")
        if f"default dev {egress.interface}" in table_route.stdout:
            lines.append(f"OK: user={user.ip} table={user.table} default dev {egress.interface}")
        else:
            route_rc = 1
            failure_categories.append("TABLE_DEFAULT_MISMATCH")
            lines.append(f"FAIL: user={user.ip} table={user.table} does not default to {egress.interface}")
        lines.append(f"route_get={route_get.stdout.strip()}")
        if f"dev {egress.interface}" in route_get.stdout:
            lines.append(f"OK: user={user.ip} route_get uses {egress.interface}")
        elif "dev ens3" in route_get.stdout:
            route_rc = 1
            failure_categories.append("ROUTE_GET_PUBLIC_LEAK")
            lines.append(f"FAIL: user={user.ip} route_get leaks to public ens3")
        else:
            route_rc = 1
            failure_categories.append("ROUTE_GET_UNEXPECTED")
            lines.append(f"FAIL: user={user.ip} route_get unexpected")
        if failure_categories:
            lines.append(
                "V7_SCOPED_USER_ROUTE_FAILURE_CATEGORIES="
                + ",".join(sorted(set(failure_categories)))
            )
        lines.append("V7_SCOPED_USER_ROUTE_CHECK=" + ("OK" if route_rc == 0 else "FAIL"))
        return subprocess.CompletedProcess(argv, route_rc, stdout="\n".join(lines) + "\n")

    def _verification_required_services(self, move: dict[str, Any]) -> list[str]:
        if "profile_required_services" in move:
            return normalize_service_ids(move.get("profile_required_services") or [])
        user_ip = str(move.get("user_ip") or "")
        user = next((row for row in getattr(self, "users", []) if row.ip == user_ip), None)
        if user is not None:
            return self._profile_required_services(user)
        # Compatibility for isolated historical fixtures that do not carry a
        # user/profile surface. New Planner output always emits the exact
        # ``profile_required_services`` field above.
        return normalize_service_ids(move.get("important_services") or [])

    def _verify_emergency_required_services(self, move: dict[str, Any]) -> subprocess.CompletedProcess[str]:
        target = str(move.get("recommended_egress") or "")
        services = self._verification_required_services(move)
        if not target:
            return subprocess.CompletedProcess(["v7-service-matrix-test"], 1, stdout="missing target\n")
        timeout_sec = max(1, min(to_int(self.emergency_failover_policy.get("service_verify_timeout_seconds"), 5), 30))
        lock_timeout_sec = max(1, to_int(getattr(self.args, "service_matrix_lock_timeout_sec", DEFAULT_SERVICE_MATRIX_LOCK_TIMEOUT_SECONDS), DEFAULT_SERVICE_MATRIX_LOCK_TIMEOUT_SECONDS))
        command_timeout_sec = timeout_sec + lock_timeout_sec + 5
        # Reuse the existing service Matrix owner's bounded parallel executor.
        # One exact subset now incurs one Python startup, one lock lifecycle and
        # one durable Matrix write instead of repeating all three per service.
        command_timeout_sec = timeout_sec + lock_timeout_sec + 5
        command = ["v7-service-matrix-test", target]
        if services:
            command.extend([
                "--services", ",".join(services),
                "--timeout", str(timeout_sec),
                "--lock-timeout-sec", str(lock_timeout_sec),
            ])
            # S11 is a profile contract, not a full diagnostic Matrix pass.
            # Telegram has several optional diagnostic endpoints which are
            # intentionally retained for the regular Matrix but cannot delay
            # a governed recovery after all mandatory Telegram endpoints have
            # succeeded.  The existing Matrix owner enforces this exact scope
            # as observation-only, preserving canonical Matrix semantics.
            if services == ["telegram"]:
                command.extend([
                    "--required-endpoints-only",
                    "--probe-observation-only",
                ])
        else:
            # A profile with no declared application service still requires a
            # fresh channel/path proof before the exact payload check, but it
            # must not inherit the historical five-service fallback.
            command.append("--path-evidence-only")
        command.extend(["--state-dir", str(self.state_dir)])
        try:
            return subprocess.run(
                command,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=command_timeout_sec,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            return subprocess.CompletedProcess(command, 1, stdout=f"service verify error: {exc}\n")

    def _reuse_or_verify_emergency_required_services(self, move: dict[str, Any]) -> subprocess.CompletedProcess[str]:
        """Reuse fresh exact-path Matrix evidence or run its existing verifier.

        Matrix probes execute through the target interface in the runtime host
        namespace.  They prove egress-path/channel-profile reachability, not a
        user's policy-table binding.  The latter remains fail-closed in
        ``_verify_routes_for_apply`` before this method is reached.
        """
        started_ns = time.monotonic_ns()
        target = str(move.get("recommended_egress") or "")
        services = self._verification_required_services(move)
        matrix = read_json(self.state_dir / "service-matrix.json", {"items": {}})
        target_row = ((matrix.get("items") or {}).get(target) or {}) if isinstance(matrix, dict) else {}
        stored_path = target_row.get("path_evidence") if isinstance(target_row.get("path_evidence"), dict) else {}
        command = [
            "v7-service-matrix-test", target, "--path-evidence-only",
            "--state-dir", str(self.state_dir),
        ]
        try:
            probe = subprocess.run(
                command,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=10,
            )
            current_payload = json.loads(probe.stdout or "{}") if probe.returncode == 0 else {}
        except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
            current_payload = {}
        current_path = current_payload.get("path_evidence") if isinstance(current_payload.get("path_evidence"), dict) else {}
        matrix_services = target_row.get("services") if isinstance(target_row.get("services"), dict) else {}
        invalidation_reasons: list[str] = []
        if not stored_path or not current_path:
            invalidation_reasons.append("path_evidence_missing")
        elif str(stored_path.get("path_fingerprint") or "") != str(current_path.get("path_fingerprint") or ""):
            invalidation_reasons.append("path_fingerprint_changed")
        if str(stored_path.get("service_set_fingerprint") or "") != str(current_path.get("service_set_fingerprint") or ""):
            invalidation_reasons.append("service_set_changed")
        for service in services:
            row = matrix_services.get(service) if isinstance(matrix_services.get(service), dict) else {}
            freshness = self._service_truth_freshness(row)
            status = str(row.get("status") or "").upper()
            if not row:
                invalidation_reasons.append(f"{service}:missing")
            elif freshness.get("state") != "FRESH":
                invalidation_reasons.append(f"{service}:not_fresh")
            elif row.get("ok") is not True and status not in {"OK", "WARN", "DEGRADED", "HTTP_LIMITED"}:
                invalidation_reasons.append(f"{service}:not_healthy")
            if str(row.get("egress_identity_generation") or "") != str(stored_path.get("egress_identity_generation") or ""):
                invalidation_reasons.append(f"{service}:identity_generation_changed")
        if not invalidation_reasons:
            duration_ms = round((time.monotonic_ns() - started_ns) / 1_000_000.0, 3)
            payload = {
                "action": "reuse_service_matrix_path_evidence",
                "status": "REUSED_FRESH_CHANNEL_PATH_MATRIX",
                "ok": True,
                "egress": target,
                "required_services": services,
                "matrix_scope": "EGRESS_PATH_AND_CHANNEL_PROFILE",
                "path_fingerprint": str(stored_path.get("path_fingerprint") or ""),
                "service_set_fingerprint": str(stored_path.get("service_set_fingerprint") or ""),
                "matrix_measured_at": str(stored_path.get("measured_at") or target_row.get("updated") or ""),
                "user_binding_evidence_owner": "tools/v7-users-autoswitch._verify_routes_for_apply",
                "full_matrix_refreshed": False,
                "performance_timeline": {
                    "schema_version": "v7.service-matrix-reuse-timing.v1",
                    "clock_source": "time.monotonic_ns",
                    "owner": "tools/v7-users-autoswitch",
                    "spans": [{"stage": "fresh_channel_path_matrix_lookup_and_fingerprint_validation", "duration_ms": duration_ms, "critical_path": True}],
                },
            }
            return subprocess.CompletedProcess(command, 0, stdout=json.dumps(payload, ensure_ascii=False))
        if not services and current_path and probe.returncode == 0:
            duration_ms = round((time.monotonic_ns() - started_ns) / 1_000_000.0, 3)
            current_payload.update({
                "action": "fresh_exact_channel_path_verification",
                "status": "FRESH_CHANNEL_PATH_VERIFIED_NO_PROFILE_SERVICES",
                "ok": True,
                "egress": target,
                "required_services": [],
                "matrix_scope": "EGRESS_PATH_AND_CHANNEL_PROFILE",
                "full_matrix_refreshed": False,
                "profile_service_probe_count": 0,
                "user_binding_evidence_owner": "tools/v7-users-autoswitch._verify_routes_for_apply",
                "performance_timeline": {
                    "schema_version": "v7.service-matrix-path-only-reuse-timing.v1",
                    "clock_source": "time.monotonic_ns",
                    "owner": "tools/v7-users-autoswitch + existing v7-service-matrix-test path owner",
                    "spans": [{
                        "stage": "fresh_exact_channel_path_verification",
                        "duration_ms": duration_ms,
                        "critical_path": True,
                    }],
                },
            })
            return subprocess.CompletedProcess(command, 0, stdout=json.dumps(current_payload, ensure_ascii=False))
        refreshed = self._verify_emergency_required_services(move)
        try:
            payload = json.loads(refreshed.stdout or "{}")
        except json.JSONDecodeError:
            payload = {}
        if isinstance(payload, dict) and payload:
            payload["matrix_reuse_decision"] = "FULL_MATRIX_REFRESH_REQUIRED"
            payload["matrix_reuse_invalidation_reasons"] = sorted(set(invalidation_reasons))
            payload["user_binding_evidence_owner"] = "tools/v7-users-autoswitch._verify_routes_for_apply"
            refreshed = subprocess.CompletedProcess(
                refreshed.args,
                refreshed.returncode,
                stdout=json.dumps(payload, ensure_ascii=False),
            )
        return refreshed

    def _ct_m0f_kernel_cutover_evidence(
        self,
        plan: dict[str, Any],
        move: dict[str, Any],
        result_row: dict[str, Any],
    ) -> dict[str, Any]:
        """Consume the existing CT-M0F owners after a governed apply.

        The method is gated by an explicit validation flag and a fresh Packet,
        operation and execution lease.  After the existing route verifier has
        passed it performs one exact certification-identity probe through the
        moved user's source rule/table and selected target.  It cannot create
        a Candidate, Packet, lease, restore barrier or routing effect.
        """
        if not bool_value(getattr(self.args, "ct_m0f_kernel_cutover_validation", False)):
            return {"status": "NOT_REQUESTED", "ok": False}
        standing_contract_id = str(
            getattr(self.args, "ct_m0f_standing_validation_contract_id", "") or ""
        )
        standing_contract_hash = str(
            getattr(self.args, "ct_m0f_standing_validation_contract_hash", "") or ""
        )
        implementation_fingerprint = str(
            getattr(self.args, "ct_m0f_implementation_fingerprint", "") or ""
        )
        lineage = {
            "incident_id": str(
                getattr(self.args, "ct_m0f_source_incident_id", "")
                or (((plan.get("safety") or {}).get("l3_incident") or {}).get("incident_id"))
                or move.get("source_incident_id")
                or ""
            ),
            "incident_generation": str(
                getattr(self.args, "ct_m0f_source_incident_generation", "")
                or (((plan.get("safety") or {}).get("l3_incident") or {}).get("incident_generation"))
                or move.get("incident_generation")
                or ""
            ),
            "validation_generation_id": str(
                getattr(self.args, "ct_m0f_validation_generation_id", "") or ""
            ),
            "user": str(move.get("user_ip") or ""),
            "source": str(move.get("current_egress") or ""),
            "target": str(move.get("recommended_egress") or ""),
            "candidate_id": "candidate_" + sha256_json({
                "user": move.get("user_ip"),
                "source": move.get("current_egress"),
                "target": move.get("recommended_egress"),
                "selected_move_hash": (plan.get("operation") or {}).get("selected_move_hash"),
            })[:24],
            "packet_id": str(getattr(self.args, "approved_packet_id", "") or ""),
            "lease_id": str(getattr(self.args, "approved_execution_lease_id", "") or ""),
            "operation_id": str(getattr(self.args, "approved_operation_id", "") or ""),
        }
        standing_lineage_records: list[dict[str, Any]] = []
        controlled_condition: dict[str, Any] = {}
        if standing_contract_id:
            # Committed-apply revalidation refreshed this exact
            # decision-bounded lineage immediately before mutation. No
            # operator-audit write occurs before this evidence consumer.
            standing_lineage_records = self._standing_policy_audit_records()
            controlled_condition = next(
                (
                    row for row in reversed(standing_lineage_records)
                    if row.get("record_type")
                    == "ct_m0f_standing_controlled_condition_prepared"
                    and str(row.get("contract_id") or "")
                    == standing_contract_id
                    and str(row.get("contract_hash") or "")
                    == standing_contract_hash
                    and str(row.get("user") or "") == lineage["user"]
                    and str(row.get("source") or "") == lineage["source"]
                    and str(row.get("baseline_target") or "")
                    == lineage["target"]
                    and str(row.get("record_hash") or "")
                ),
                {},
            )
            if controlled_condition and not lineage["incident_id"]:
                condition_hash = str(
                    controlled_condition.get("record_hash") or ""
                )
                lineage["incident_id"] = (
                    "ctm0finc_"
                    + sha256_json({
                        "condition_record_hash": condition_hash,
                        "contract_id": standing_contract_id,
                        "user": lineage["user"],
                        "source": lineage["source"],
                        "target": lineage["target"],
                    })[:24]
                )
                lineage["incident_generation"] = condition_hash
        if standing_contract_id:
            lineage.update({
                "standing_contract_id": standing_contract_id,
                "standing_contract_hash": standing_contract_hash,
                "implementation_fingerprint": implementation_fingerprint,
            })
        else:
            lineage.update({
                "authority_request_id": str(
                    getattr(self.args, "ct_m0f_controlled_validation_request_id", "") or ""
                ),
                "authority_request_hash": str(
                    getattr(self.args, "ct_m0f_controlled_validation_request_hash", "") or ""
                ),
            })
        blockers = [f"{key}_missing" for key, value in lineage.items() if not value]
        consumption = (
            operator_execution.validate_ct_m0f_standing_validation_sample_reservation(
                contract_id=standing_contract_id,
                contract_hash=standing_contract_hash,
                implementation_fingerprint=implementation_fingerprint,
                validation_generation_id=lineage["validation_generation_id"],
                packet_id=lineage["packet_id"],
                operation_id=lineage["operation_id"],
                lease_id=lineage["lease_id"],
                user=lineage["user"],
                source=lineage["source"],
                target=lineage["target"],
                audit_store=Path(self.args.action_class_audit_store),
                audit_records=standing_lineage_records,
            )
            if standing_contract_id
            else operator_execution.validate_ct_m0f_controlled_validation_consumption(
                request_id=lineage["authority_request_id"],
                request_hash=lineage["authority_request_hash"],
                validation_generation_id=lineage["validation_generation_id"],
                packet_id=lineage["packet_id"],
                operation_id=lineage["operation_id"],
                lease_id=lineage["lease_id"],
                user=lineage["user"],
                source=lineage["source"],
                target=lineage["target"],
                audit_store=Path(self.args.action_class_audit_store),
            )
        )
        blockers.extend(consumption.get("errors") or [])
        user = next((row for row in self.users if row.ip == lineage["user"]), None)
        target = self.egress.get(lineage["target"])
        if user is None or str((user.raw or {}).get("certification_user") or "").lower() not in {"1", "true", "yes"}:
            blockers.append("exact_certification_identity_required")
        if target is None or not target.interface:
            blockers.append("target_interface_missing")
        expected_ip, expected_ip_source = (
            declared_target_egress_ip(target) if target is not None else ("", "target_missing")
        )
        if not expected_ip:
            blockers.append("target_expected_egress_ip_missing")
        if int(result_row.get("verify_rc", 1)) != 0:
            blockers.append("exact_user_route_verification_required")
        if int(result_row.get("service_verify_rc", 1)) != 0:
            blockers.append("fresh_compatible_matrix_or_service_verification_required")
        if blockers:
            route_failure_categories = sorted({
                str(value)
                for value in (
                    result_row.get("route_verification_failure_categories")
                    or []
                )
                if re.fullmatch(r"[A-Z0-9_-]+", str(value))
            })[:8]
            return {
                "status": "CONTROL_PLANE_AND_KERNEL_PATH_CUTOVER_INVALID",
                "ok": False,
                "blockers": sorted(set(blockers)),
                "route_verification_failure_categories": route_failure_categories,
                "route_verification_scope": str(
                    result_row.get("route_verification_scope") or ""
                ),
                "route_verification_expected_egress": str(
                    result_row.get("route_verification_expected_egress") or ""
                ),
                "verify_rc": result_row.get("verify_rc"),
                "service_verify_rc": result_row.get("service_verify_rc"),
                "ordinary_user_delta": 0,
                "routing_mutation_performed_by_consumer": False,
            }

        try:
            address_proc = subprocess.run(
                ["ip", "-j", "addr", "show", "dev", target.interface],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=5,
            )
            address_rows = json.loads(address_proc.stdout or "[]") if address_proc.returncode == 0 else []
            source_address = next(
                str(info.get("local") or "")
                for row in address_rows if isinstance(row, dict)
                for info in (row.get("addr_info") or []) if isinstance(info, dict)
                if str(info.get("family") or "") == "inet" and str(info.get("local") or "")
            )
        except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError, StopIteration):
            source_address = ""
        if not source_address:
            return {
                "status": "CONTROL_PLANE_AND_KERNEL_PATH_CUTOVER_INVALID",
                "ok": False,
                "blockers": ["target_interface_source_address_missing"],
                "ordinary_user_delta": 0,
                "routing_mutation_performed_by_consumer": False,
            }

        incident = ((plan.get("safety") or {}).get("l3_incident") or {})
        # Bind the payload probe to the same Matrix/controlled-condition
        # monotonic failure clock before executing the probe.  The immutable
        # context hash therefore covers the exact clock lineage too.
        first_failed_ns = next((value for value in (
            to_int(incident.get("first_failed_observation_monotonic_ns"), 0),
            to_int(move.get("first_failed_observation_monotonic_ns"), 0),
            to_int(
                getattr(
                    self.args,
                    "ct_m0f_first_failed_observation_monotonic_ns",
                    0,
                ),
                0,
            ),
            to_int(controlled_condition.get("first_failed_observation_monotonic_ns"), 0),
        ) if value > 0), 0)
        confirmed_ns = next((value for value in (
            to_int(incident.get("confirmed_hard_failure_monotonic_ns"), 0),
            to_int(move.get("confirmed_hard_failure_monotonic_ns"), 0),
            to_int(
                getattr(
                    self.args,
                    "ct_m0f_confirmed_hard_failure_monotonic_ns",
                    0,
                ),
                0,
            ),
            to_int(controlled_condition.get("confirmed_hard_failure_monotonic_ns"), 0),
        ) if value > 0), 0)

        now = datetime.now(timezone.utc)
        try:
            netns_inode = int(os.stat("/proc/self/ns/net").st_ino)
        except OSError:
            netns_inode = 0
        boot_id = ""
        try:
            boot_id = Path("/proc/sys/kernel/random/boot_id").read_text(
                encoding="utf-8"
            ).strip()
        except OSError:
            pass
        try:
            fwmark = int(str(user.table if user else ""), 0)
        except (TypeError, ValueError):
            fwmark = 0
        context = {
            "schema_version": "v7.exact-client-probe-execution-context.v1",
            **lineage,
            "contract_id": "ctm0f_" + sha256_json(lineage)[:24],
            "sample_kind": str(getattr(self.args, "ct_m0f_sample_kind", "") or "warm"),
            "issuing_owner": "existing Controlled Production owner",
            "active_program": "V7_SERVICE_FAILURE_AUTOMATION_EVOLUTION_PROGRAM_V1",
            "certification_identity": True,
            "source_address": lineage["user"],
            "interface": target.interface,
            "routing_table": str(user.table if user else ""),
            "fwmark": fwmark,
            "network_namespace_inode": netns_inode,
            "clock_domain_id": (
                f"linux-boot:{boot_id or 'unknown'}:netns:{netns_inode}"
            ),
            "first_failed_observation_monotonic_ns": first_failed_ns,
            "confirmed_hard_failure_monotonic_ns": confirmed_ns,
            "observation_cadence_ms": 50,
            "clock_uncertainty_ms": 2.0,
            "expected_egress_ip": expected_ip,
            "expected_egress_ip_source": expected_ip_source,
            "expected_target_egress_fingerprint": hashlib.sha256(expected_ip.encode("utf-8")).hexdigest(),
            "target_url": "https://icanhazip.com",
            "preferred_probe_protocol": "STUN_XOR_MAPPED_ADDRESS",
            "stun_host": "stun.cloudflare.com",
            "stun_port": 3478,
            "protocol_fallback_allowed": True,
            # Polygon certification identities already have canonical client
            # profiles.  The existing client-speed owner uses one profile in
            # a runtime-only Polygon namespace so the packet genuinely enters
            # through wg0 and traverses the selected per-user table.  Campaign
            # preparation creates it before T0; N11/explicit cleanup removes
            # it without adding canonical state.
            "probe_transport": "EXISTING_LOCAL_CLIENT_PROFILE_NAMESPACE",
            # Controlled preparation establishes the same existing profile
            # before T0, matching a real already-connected client.  Reusing
            # that validated runtime-only namespace removes a synthetic
            # WireGuard cold-start from the recovery measurement; absence or
            # identity mismatch still fails closed in the client-speed owner.
            "reuse_prepared_client_session": True,
            "timeout_ms": 650,
            "retry_count": 0,
            "expires_at": (now + timedelta(minutes=5)).isoformat(),
        }
        context["context_hash"] = hashlib.sha256(
            json.dumps(context, sort_keys=True, separators=(",", ":")).encode("utf-8")
        ).hexdigest()
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", suffix=".json") as handle:
            json.dump(context, handle, sort_keys=True)
            handle.flush()
            try:
                client_speed_owner = in_process_client_speed_module()
            except Exception:
                # Preserve the deployed executable as the fail-closed
                # compatibility path only if the same owner cannot be loaded.
                # A probe execution error must not silently become a second
                # attempt when the certification contract says retry_count=0.
                payload_proc = subprocess.run(
                    ["v7-client-speed-api", "--exact-client-probe-context", handle.name, "--json"],
                    text=True,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    check=False,
                    timeout=10,
                )
                try:
                    payload = json.loads(payload_proc.stdout or "{}")
                except json.JSONDecodeError:
                    payload = {
                        "status": "PROBE_INVALID",
                        "blockers": ["target_payload_receipt_not_json"],
                    }
            else:
                payload = client_speed_owner.run_exact_probe_context(handle.name)

        span_by_stage = {
            str(row.get("stage") or ""): row
            for row in self._performance_spans
            if isinstance(row, dict)
        }
        route_span = result_row.get("route_writer_timing") if isinstance(result_row.get("route_writer_timing"), dict) else {}
        visibility_span = result_row.get("route_visibility_timing") if isinstance(result_row.get("route_visibility_timing"), dict) else {}
        decision_ns = to_int(
            (span_by_stage.get("planner_entry_target_capacity_and_allocation") or {}).get("completed_monotonic_ns"), 0,
        )
        admitted_ns = to_int(
            (span_by_stage.get("pre_apply_fresh_state_validation") or {}).get("completed_monotonic_ns"), 0,
        )
        route_completed_ns = to_int(route_span.get("completed_monotonic_ns"), 0)
        visible_ns = to_int(visibility_span.get("completed_monotonic_ns"), 0)
        payload_ns = to_int(
            payload.get("first_successful_client_traffic_monotonic_ns")
            or payload.get("target_egress_payload_pass_monotonic_ns"),
            0,
        )
        verify_output = str(result_row.get("verify_output") or "")
        rule_match = re.search(r"policy_rule_fingerprint=([0-9a-f]{64})", verify_output)
        table = str(user.table if user else "")
        common = dict(lineage)
        receipt = {
            **lineage,
            "certification_identity": True,
            "ordinary_user_delta": 0,
            "sample_kind": context["sample_kind"],
            "clock_source": "time.monotonic_ns",
            "first_failed_observation_monotonic_ns": first_failed_ns,
            "confirmed_hard_failure_monotonic_ns": confirmed_ns,
            "user_target_decision_bound_monotonic_ns": decision_ns,
            "apply_admitted_monotonic_ns": admitted_ns,
            # The existing writer commits assignment and route in one bounded
            # process.  Their internal split remains UNKNOWN; the shared
            # completion event is explicit rather than inferred.
            "canonical_user_assignment_committed_monotonic_ns": route_completed_ns,
            "kernel_route_mutation_completed_monotonic_ns": route_completed_ns,
            "exact_user_kernel_path_visible_monotonic_ns": visible_ns,
            "target_egress_payload_pass_monotonic_ns": payload_ns,
            "control_plane_and_kernel_path_cutover_pass_monotonic_ns": payload_ns,
            "decision_binding": {**common, "status": "USER_TARGET_DECISION_BOUND"},
            "assignment_proof": {
                **common,
                "status": "CANONICAL_USER_ASSIGNMENT_COMMITTED",
                "stale_writer_rejected": True,
                "previous_egress": lineage["source"],
                "new_egress": lineage["target"],
            },
            "kernel_path_proof": {
                **common,
                "status": "EXACT_USER_ASSIGNMENT_AND_KERNEL_PATH_TRANSITION_PROVEN",
                "source_ip": lineage["user"],
                "policy_rule_fingerprint": rule_match.group(1) if rule_match else "",
                "routing_table": table,
                "target_interface": target.interface,
                "route_generation": str(getattr(self.args, "approved_snapshot_bundle_hash", "") or ""),
                "old_effective_binding_absent": "V7_SCOPED_USER_ROUTE_CHECK=OK" in verify_output,
            },
            "target_payload_proof": payload,
            "assignment_kernel_split": "ATOMIC_BUNDLED_COMPLETION_INTERNAL_SPLIT_UNKNOWN",
            "remote_client_recovery_claimed": False,
            "exact_user_payload_claimed": True,
            "diagnostic_performance_timeline": {
                "schema_version": "v7.ct-m0f-cutover-diagnostic-timeline.v1",
                "matrix_pre_execution_spans": list(
                    getattr(
                        self.args,
                        "ct_m0f_matrix_pre_execution_timing",
                        [],
                    )
                    or []
                ),
                "planner_spans": [
                    {
                        key: row.get(key)
                        for key in (
                            "stage", "duration_ms", "owner", "parent",
                            "critical_path", "status", "details",
                        )
                        if key in row
                    }
                    for row in self._performance_spans
                    if isinstance(row, dict)
                ],
                "diagnostic_only": True,
                "runtime_behavior_changed": False,
            },
        }
        consumed = operator_execution_pipeline.control_plane_kernel_path_cutover_contract(receipt)
        consumed["sample_kind"] = context["sample_kind"]
        consumed["validation_generation_id"] = lineage["validation_generation_id"]
        consumed["target_payload_receipt_id"] = str(payload.get("receipt_id") or "")
        return consumed


