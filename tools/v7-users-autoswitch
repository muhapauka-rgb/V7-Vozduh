    )
    decision = contract.get("authority_decision") if isinstance(contract.get("authority_decision"), dict) else {}
    causal_integrity = service_failure_causal_integrity_status(Path(args.state_dir))
    controlled_pool = controlled_certification_pool_status(Path(args.state_dir))
    controlled_substrate_source_id = str(
        controlled_substrate_scope.get("source_id") or ""
    )
    controlled_substrate_source_projection = next((
        row
        for row in (
            controlled_pool.get("active_source_projections") or []
        )
        if isinstance(row, dict)
        and str(row.get("source_id") or "")
