class AutoswitchPlanner:
    def __init__(self, args: argparse.Namespace):
        self.args = args
        self.operation_started_at = now_iso()
        self.state_dir = Path(args.state_dir)
        self.event_dir = Path(args.event_dir)
        self.state = read_json(self.state_dir / "v7-state.json", {})
        self.policy = read_json(Path(args.policy_file), {})
        self.org_policy = read_json(Path(args.org_policy_file), {})
        self.quality_summary = read_json(Path(args.quality_summary_file), {"items": {}})
        self.safety_file = Path(args.safety_file)
        self.safety_state = self._load_safety()
        self.speed = read_json(self.state_dir / "egress-speed.json", {"items": {}})
        self.client_speed = read_json(self.state_dir / "client-speed.json", {"users": {}})
        self.matrix = read_json(self.state_dir / "service-matrix.json", {"items": {}})
        self.telegram_sentinel = read_json(Path(args.telegram_sentinel_file), {"items": {}})
        self.vless_activity = read_json(Path(args.vless_activity_file), {})
        self.restore_barrier_file = Path(args.restore_barrier_file)
        self.restore_barrier = self._restore_barrier_status()
        self.generation = self._generation_status()
        self.service_prefs = read_json(self.state_dir / "service-preferences.json", {})
        self.users = self._load_users()
        self.egress = self._load_egress()
        self._sync_egress_user_counts()
        self.switch_policy = self._switch_policy()
        self.quality_policy = self._quality_policy()
        self.load_policy = self._load_policy()
        self.reconnect_policy = self._reconnect_policy()
        self.safety_policy = self._safety_policy()
        self.service_signal_policy = self._service_signal_policy()
        self.service_quality_policy = self._service_quality_policy()
        self.best_available_pool_policy = self._best_available_pool_policy()
        self.last_switch = self._last_switches()
        self.group_usage = self._group_usage()
        self.dynamic_load = self._dynamic_load_summary()
        self.reconnect_state_file = Path(args.reconnect_state_file)
        self.reconnect_state = self._load_reconnect_state()
        self.reconnect_events = self._observe_reconnect_events()
        self._routing_intelligence_cache: dict[tuple[Any, ...], dict[str, Any]] = {}

    def _switch_policy(self) -> dict[str, Any]:
        sw = merge_defaults((self.policy or {}).get("switch", {}), DEFAULT_SWITCH_POLICY)
        sw.update((self.org_policy or {}).get("switch", {}))
        if self.args.mode:
            sw["autoswitch_mode"] = self.args.mode
        return sw

    def _quality_policy(self) -> dict[str, Any]:
        quality = merge_defaults((self.policy or {}).get("quality", {}), DEFAULT_QUALITY_POLICY)
        quality.update((self.org_policy or {}).get("quality", {}))
        return quality

    def _load_policy(self) -> dict[str, Any]:
        load = merge_defaults((self.policy or {}).get("load", {}), DEFAULT_LOAD_POLICY)
        load.update((self.org_policy or {}).get("load", {}))
        return load

    def _reconnect_policy(self) -> dict[str, Any]:
        reconnect = merge_defaults((self.policy or {}).get("reconnect", {}), DEFAULT_RECONNECT_POLICY)
        reconnect.update((self.org_policy or {}).get("reconnect", {}))
        return reconnect

    def _safety_policy(self) -> dict[str, Any]:
        safety = merge_defaults((self.policy or {}).get("safety", {}), DEFAULT_SAFETY_POLICY)
        safety.update((self.org_policy or {}).get("safety", {}))
        return safety

    def _service_signal_policy(self) -> dict[str, Any]:
        service = merge_defaults((self.policy or {}).get("service_signals", {}), DEFAULT_SERVICE_SIGNAL_POLICY)
        service.update((self.org_policy or {}).get("service_signals", {}))
        return service

    def _service_quality_policy(self) -> dict[str, Any]:
        service = merge_defaults((self.policy or {}).get("service_quality", {}), DEFAULT_SERVICE_QUALITY_POLICY)
        service.update((self.org_policy or {}).get("service_quality", {}))
        return service

    def _best_available_pool_policy(self) -> dict[str, Any]:
        pool = merge_defaults((self.policy or {}).get("best_available_pool", {}), DEFAULT_BEST_AVAILABLE_POOL_POLICY)
        pool.update((self.org_policy or {}).get("best_available_pool", {}))
        return pool

    def _restore_barrier_status(self) -> dict[str, Any]:
        data = read_json(self.restore_barrier_file, {})
        enabled = bool_value((data or {}).get("enabled"))
        window = to_int(
            (data or {}).get("post_restore_apply_suppression_window_seconds"),
            to_int(DEFAULT_SERVICE_SIGNAL_POLICY.get("post_restore_apply_suppression_window_seconds"), 120),
        )
        expires_at = (
            (data or {}).get("expires_at")
            or (data or {}).get("suppress_until")
            or (data or {}).get("active_until")
            or ""
        )
        created_at = (data or {}).get("created_at") or (data or {}).get("activated_at") or ""
        if not expires_at and created_at and window > 0:
            created_ts = parse_ts(created_at)
            if created_ts:
                expires_at = datetime.fromtimestamp(created_ts + window, tz=timezone.utc).isoformat()
        expires_ts = parse_ts(expires_at) if expires_at else 0.0
        active = enabled and (not expires_at or expires_ts > time.time())
        cleared = bool_value(
            (data or {}).get("cleared")
            or (data or {}).get("allow_post_ttl_apply")
            or (data or {}).get("generation_clearance")
        )
        clearance_max_selected_moves = None
        for key in (
            "clearance_max_selected_moves",
            "max_selected_moves_after_clearance",
            "generation_clearance_max_selected_moves",
        ):
            if key in (data or {}):
                clearance_max_selected_moves = max(0, to_int((data or {}).get(key), 0))
                break
        expired = enabled and bool(expires_at) and expires_ts > 0 and expires_ts <= time.time()
        post_ttl_blocking = expired and not cleared
        status = {
            "file": str(self.restore_barrier_file),
            "enabled": enabled,
            "active": active,
            "expired": expired,
            "cleared": cleared,
            "post_ttl_blocking": post_ttl_blocking,
            "failover_quarantine": enabled and (active or post_ttl_blocking),
            "expires_at": expires_at,
            "reason": str((data or {}).get("reason") or ""),
        }
        if clearance_max_selected_moves is not None:
            status["clearance_max_selected_moves"] = clearance_max_selected_moves
        for key in (
            "clearance_generation_id",
            "approved_generation_id",
            "planner_generation_id",
            "selected_moves_generation",
            "clearance_selected_moves_hash",
            "approved_selected_moves_hash",
            "clearance_expires_at",
            "generation_clearance_expires_at",
            "generation_token",
        ):
            if key in (data or {}):
                status[key] = str((data or {}).get(key) or "")
        for key in ("clearance_expected_selected_moves", "approved_selected_moves_count"):
            if key in (data or {}):
                status[key] = max(0, to_int((data or {}).get(key), 0))
        return status

    def _generation_status(self) -> dict[str, Any]:
        stable_inputs = {
            "users_registry": sha256_file(self.state_dir / "users.registry"),
            "egress_registry": sha256_file(self.state_dir / "egress.registry"),
            "service_preferences": sha256_file(self.state_dir / "service-preferences.json"),
            "policy": sha256_file(Path(self.args.policy_file)),
            "org_policy": sha256_file(Path(self.args.org_policy_file)),
        }
        volatile_inputs = {
            "v7_state": sha256_file(self.state_dir / "v7-state.json"),
            "egress_speed": sha256_file(self.state_dir / "egress-speed.json"),
            "client_speed": sha256_file(self.state_dir / "client-speed.json"),
            "route_classes": sha256_file(self.state_dir / "route-classes.state"),
            "autoswitch_safety": sha256_file(Path(self.args.safety_file)),
            "service_matrix": sha256_file(self.state_dir / "service-matrix.json"),
            "quality_summary": sha256_file(Path(self.args.quality_summary_file)),
            "telegram_sentinel": sha256_file(Path(self.args.telegram_sentinel_file)),
        }
        return {
            "schema_version": 1,
            "planner_generation_id": sha256_json(stable_inputs),
            "inputs": stable_inputs,
            "volatile_inputs": volatile_inputs,
        }

    def _load_safety(self) -> dict[str, Any]:
        safety = read_json(self.safety_file, {})
        if not isinstance(safety, dict):
            safety = {}
        safety.setdefault("schema_version", 1)
        safety.setdefault("users", {})
        safety.setdefault("egress", {})
        return self._compact_safety(safety)

    def _compact_safety(self, safety: dict[str, Any]) -> dict[str, Any]:
        now = time.time()
        for ip, row in list((safety.get("users") or {}).items()):
            if not isinstance(row, dict):
                safety["users"].pop(ip, None)
                continue
            recent = [item for item in (row.get("recent_switches") or []) if now - parse_ts(item.get("ts")) <= 86400]
            row["recent_switches"] = recent[-10:]
            row["switches_1h"] = sum(1 for item in recent if now - parse_ts(item.get("ts")) <= 3600)
            row["switches_24h"] = len(recent)
            row["last_targets"] = [item.get("to") for item in recent[-3:] if item.get("to")]
            blocked = row.get("blocked_targets") if isinstance(row.get("blocked_targets"), dict) else {}
            row["blocked_targets"] = {target: until for target, until in blocked.items() if parse_ts(until) > now}
            if row.get("penalty_until") and parse_ts(row.get("penalty_until")) <= now:
                row["penalty_until"] = None
        for egress_id, row in list((safety.get("egress") or {}).items()):
            if not isinstance(row, dict):
                safety["egress"].pop(egress_id, None)
                continue
            incoming = [item for item in (row.get("incoming") or []) if now - parse_ts(item.get("ts")) <= 3600]
            failed = [item for item in (row.get("failed_verifications") or []) if now - parse_ts(item.get("ts")) <= 3600]
            row["incoming"] = incoming[-200:]
            row["failed_verifications"] = failed[-50:]
            row["incoming_1h"] = len(incoming)
            row["failed_verifications_1h"] = len(failed)
            if row.get("quarantine_until") and parse_ts(row.get("quarantine_until")) <= now:
                row["quarantine_until"] = None
        safety["updated"] = now_iso()
        return safety

    def _active_users(self) -> list[User]:
        return [user for user in self.users if user.enabled]

    def _quality_ok_for_load(self, egress: Egress) -> bool:
        min_avg = to_float(self.quality_policy.get("min_avg_mbps"), 15.0)
        min_floor = to_float(self.quality_policy.get("min_floor_mbps"), 10.0)
        min_stability = to_float(self.quality_policy.get("min_stability"), 0.45)
        hist = self._quality_window(egress.id, "1h")
        hist_avg = to_float(hist.get("avg_mbps"), 0.0)
        hist_min = to_float(hist.get("min_mbps"), 0.0)
        hist_stability = to_float(hist.get("stability"), 0.0)
        severity = self._severity_classification(egress)
        contextual_exception = (
            severity.get("category") == "protocol_diagnostic_limited_suspect"
            and hist_avg >= to_float(self.service_quality_policy.get("quality_exception_min_1h_avg_mbps"), min_avg)
            and hist_min >= to_float(self.service_quality_policy.get("quality_exception_min_1h_floor_mbps"), min_floor)
            and max(egress.stability, hist_stability) >= to_float(self.service_quality_policy.get("quality_exception_min_stability"), 0.15)
        )
        if egress.avg_mbps < min_avg and (not hist or hist_avg < min_avg):
            return False
        if egress.min_mbps < min_floor and (not hist or hist_min < min_floor):
            return False
        if egress.stability and egress.stability < min_stability and (not contextual_exception) and (not hist or hist_stability < min_stability):
            return False
        return True

    def _healthy_for_load(self, egress: Egress) -> bool:
        if not egress.enabled:
            return False
        if egress.state in ("maintenance", "disabled", "quarantine"):
            return False
        if egress.manual_only:
            return False
        if egress.canary_reserved:
            return False
        if egress.health_code and egress.health_code != "200":
            return False
        if self._severity_classification(egress).get("hard_block"):
            return False
        if self._telegram_candidate_state(egress.id).get("hard_blocked"):
            return False
        return self._quality_ok_for_load(egress)

    def _dynamic_load_summary(self) -> dict[str, Any]:
        active_users = len(self._active_users())
        all_healthy = [egress for egress in self.egress.values() if self._healthy_for_load(egress)]
        working_pool = [egress for egress in all_healthy if not egress.reserve_only]
        healthy_channels = len(working_pool)
        reserve_only_channels = len([egress for egress in all_healthy if egress.reserve_only])
        dead_channels = len(self.egress) - len(all_healthy)
        mode = str(self.load_policy.get("mode") or "static").lower()

        if mode == "dynamic":
            reserve_ratio = max(0.0, min(0.8, to_float(self.load_policy.get("reserve_ratio"), 0.15)))
            if healthy_channels > 1:
                reserve_channels = min(healthy_channels - 1, max(1, int(math.ceil(healthy_channels * reserve_ratio))))
            else:
                reserve_channels = 0
            working_channels = max(1, healthy_channels - reserve_channels)
            avg_load = active_users / working_channels if working_channels else float(active_users)
            soft_limit = int(math.ceil(avg_load * to_float(self.load_policy.get("soft_multiplier"), 1.15)))
            hard_limit = int(math.ceil(avg_load * to_float(self.load_policy.get("hard_multiplier"), 1.45)))
            failover_hard_limit = int(math.ceil(avg_load * to_float(self.load_policy.get("failover_hard_multiplier"), 2.0)))
            soft_limit = max(to_int(self.load_policy.get("min_soft_limit"), 5), soft_limit)
            hard_limit = max(to_int(self.load_policy.get("min_hard_limit"), 10), hard_limit, soft_limit)
            max_hard = to_int(self.load_policy.get("max_hard_limit"), 80)
            if max_hard > 0:
                hard_limit = min(max_hard, hard_limit)
                hard_limit = max(soft_limit, hard_limit)
            failover_hard_limit = max(failover_hard_limit, hard_limit)
        else:
            reserve_ratio = 0.0
            reserve_channels = 0
            working_channels = max(1, healthy_channels)
            avg_load = active_users / working_channels if working_channels else float(active_users)
            soft_limit = to_int(self.load_policy.get("soft_limit"), 15)
            hard_limit = max(soft_limit, to_int(self.load_policy.get("hard_limit"), 30))
            failover_hard_limit = max(hard_limit, to_int(self.load_policy.get("failover_hard_limit"), hard_limit * 2))

        summary = {
            "mode": "dynamic" if mode == "dynamic" else "static",
            "active_users": active_users,
            "total_channels": len(self.egress),
            "healthy_channels": healthy_channels,
            "reserve_only_channels": reserve_only_channels,
            "degraded_or_dead_channels": dead_channels,
            "reserve_ratio": round(reserve_ratio, 3),
            "reserve_channels": reserve_channels,
            "working_channels": working_channels,
            "avg_load": round(avg_load, 3),
            "soft_limit": soft_limit,
            "hard_limit": hard_limit,
            "failover_hard_limit": failover_hard_limit,
            "per_egress": {
                egress_id: self._load_limits_for_egress(egress, {
                    "soft_limit": soft_limit,
                    "hard_limit": hard_limit,
                    "failover_hard_limit": failover_hard_limit,
                })
                for egress_id, egress in sorted(self.egress.items())
            },
        }
        summary["status"] = self._capacity_status(summary)
        return summary

    def _capacity_status(self, summary: dict[str, Any]) -> str:
        per_egress = summary.get("per_egress") if isinstance(summary.get("per_egress"), dict) else {}
        statuses = {str(row.get("status") or "UNKNOWN") for row in per_egress.values() if isinstance(row, dict)}
        if "FAILOVER_FULL" in statuses:
            return "overloaded"
        if "HARD_FULL" in statuses:
            return "full"
        if "SOFT_FULL" in statuses:
            return "high"
        if to_int(summary.get("healthy_channels"), 0) <= 1 and to_int(summary.get("active_users"), 0) > 0:
            return "warm"
        return "ok"

    def _persist_dynamic_load_summary(self) -> None:
        if not self.args.load_summary_file:
            return
        payload = {
            "schema_version": 1,
            "updated": now_iso(),
            "source": "v7-users-autoswitch",
            "authority": "capacity_signal",
            "operator_status": self.dynamic_load.get("status", "unknown"),
            "semantics": {
                "ok": "capacity within soft limits",
                "warm": "limited healthy pool, monitor before broad movement",
                "high": "one or more egress reached soft limit",
                "full": "one or more egress reached hard limit",
                "overloaded": "one or more egress reached failover hard limit",
            },
            "summary": self.dynamic_load,
        }
        try:
            write_json_atomic(Path(self.args.load_summary_file), payload)
        except OSError:
            return

    def _load_limits_for_egress(self, egress: Egress, base: Optional[dict[str, Any]] = None) -> dict[str, Any]:
        base = base or self.dynamic_load
        base_soft = to_int(base.get("soft_limit"), 15)
        base_hard = to_int(base.get("hard_limit"), 30)
        base_failover = to_int(base.get("failover_hard_limit"), max(base_hard, 60))
        soft_limit = base_soft
        hard_limit = base_hard
        failover_hard_limit = base_failover
        if egress.capacity_users > 0:
            soft_limit = min(soft_limit, egress.capacity_users)
            hard_limit = min(hard_limit, egress.capacity_users)
            multiplier = to_float(self.load_policy.get("failover_capacity_multiplier"), 1.25)
            failover_hard_limit = min(failover_hard_limit, max(hard_limit, int(math.ceil(egress.capacity_users * multiplier))))
        hard_limit = max(1, hard_limit)
        soft_limit = max(1, min(soft_limit, hard_limit))
        failover_hard_limit = max(hard_limit, failover_hard_limit)
        status = "OK"
        if egress.users >= failover_hard_limit:
            status = "FAILOVER_FULL"
        elif egress.users >= hard_limit:
            status = "HARD_FULL"
        elif egress.users >= soft_limit:
            status = "SOFT_FULL"
        return {
            "users": egress.users,
            "soft_limit": soft_limit,
            "hard_limit": hard_limit,
            "failover_hard_limit": failover_hard_limit,
            "capacity_users": egress.capacity_users,
            "status": status,
        }

    def _load_users(self) -> list[User]:
        state_users = self.state.get("users")
        rows = state_users if isinstance(state_users, list) else parse_registry(self.state_dir / "users.registry")
        org_users = self._org_user_map()
        users: list[User] = []
        for row in rows:
            ip = str(row.get("ip", ""))
            if not SAFE_IP_RE.match(ip):
                continue
            group = str(row.get("group") or row.get("org") or row.get("organization") or org_users.get(ip) or self.org_policy.get("default_group") or "default")
            users.append(User(
                ip=ip,
                current=str(row.get("current", "")),
                table=str(row.get("table", "")),
                enabled=str(row.get("enabled", "1")) == "1",
                group=group,
                raw=row,
            ))
        return users

    def _org_user_map(self) -> dict[str, str]:
        mapping: dict[str, str] = {}
        explicit = self.org_policy.get("user_groups") or {}
        if isinstance(explicit, dict):
            mapping.update({str(ip): str(group) for ip, group in explicit.items()})
        for group_name, group in (self.org_policy.get("groups") or {}).items():
            for ip in split_csv((group or {}).get("users", [])):
                mapping[ip] = str(group_name)
        return mapping

    def _load_egress(self) -> dict[str, Egress]:
        registry_rows = parse_registry(self.state_dir / "egress.registry")
        state_egress = self.state.get("egress") if isinstance(self.state.get("egress"), dict) else {}
        ids = sorted({str(row.get("id", "")) for row in registry_rows if row.get("id")} | set(state_egress.keys()))
        meta_all = self.org_policy.get("egress") or {}
        result: dict[str, Egress] = {}
        for egress_id in ids:
            reg = next((row for row in registry_rows if row.get("id") == egress_id), {})
            live = state_egress.get(egress_id) or {}
            meta = meta_all.get(egress_id) or {}
            speed_item = (self.speed.get("items") or {}).get(egress_id) or {}
            avg_mbps = to_float(live.get("avg_mbps"), to_float(speed_item.get("server_v7_mbps")))
            min_mbps = to_float(live.get("min_mbps"), to_float(speed_item.get("server_v7_min_mbps"), avg_mbps))
            roles = split_csv(meta.get("roles") or meta.get("role") or reg.get("roles") or reg.get("role") or "GLOBAL_FAST")
            capacity = to_int(meta.get("capacity_users") or reg.get("capacity_users") or reg.get("capacity") or 0)
            result[egress_id] = Egress(
                id=egress_id,
                interface=str(meta.get("interface") or reg.get("interface") or live.get("interface") or ""),
                enabled=str(reg.get("enabled", meta.get("enabled", "1"))) == "1" and not bool_value(meta.get("disabled")),
                state=str(meta.get("state") or reg.get("state") or "enabled"),
                role=roles[0] if roles else "GLOBAL_FAST",
                roles=roles or ["GLOBAL_FAST"],
                priority=to_int(meta.get("priority") or reg.get("priority") or 50, 50),
                weight=to_float(meta.get("weight") or reg.get("weight") or 100.0, 100.0),
                capacity_users=capacity,
                reserve_only=bool_value(meta.get("reserve_only") or reg.get("reserve_only")),
                manual_only=bool_value(meta.get("manual_only") or reg.get("manual_only")),
                canary_reserved=bool_value(meta.get("canary_reserved") or reg.get("canary_reserved")),
                exclusive_group=str(meta.get("exclusive_group") or reg.get("exclusive_group") or ""),
                groups=split_csv(meta.get("groups") or reg.get("groups") or ""),
                users=to_int(live.get("users")),
                avg_mbps=avg_mbps,
                min_mbps=min_mbps,
                client_mbps=self._client_mbps_for_egress(egress_id),
                stability=to_float(live.get("stability"), to_float(speed_item.get("stability"))),
                health_code=str(live.get("code") or speed_item.get("code") or ""),
                severity=str(live.get("diagnose_severity") or speed_item.get("severity") or ""),
                diagnose_reason=str(live.get("diagnose_reason") or ""),
                load_status=str(live.get("load_status") or ""),
                raw={"registry": reg, "state": live, "meta": meta, "speed": speed_item},
            )
        return result

    def _sync_egress_user_counts(self) -> None:
        counts: dict[str, int] = {egress_id: 0 for egress_id in self.egress}
        for user in self.users:
            if user.enabled and user.current:
                counts[user.current] = counts.get(user.current, 0) + 1
        for egress_id, egress in self.egress.items():
            egress.users = counts.get(egress_id, 0)

    def _load_reconnect_state(self) -> dict[str, Any]:
        state = read_json(self.reconnect_state_file, {})
        if not isinstance(state, dict):
            state = {}
        state.setdefault("schema_version", 1)
        state.setdefault("users", {})
        state.setdefault("events", [])
        return state

    def _activity_epoch_for_user(self, user: User) -> int:
        activity = self.vless_activity.get(user.ip) if isinstance(self.vless_activity, dict) else {}
        if isinstance(activity, dict):
            return to_int(activity.get("latest_activity_epoch"), 0)
        return 0

    def _observe_reconnect_events(self) -> dict[str, dict[str, Any]]:
        if not bool_value(self.reconnect_policy.get("enabled", True)):
            return {}
        now = time.time()
        active_age = max(10, to_int(self.reconnect_policy.get("active_age_seconds"), 45))
        reconnect_window = max(active_age, to_int(self.reconnect_policy.get("reconnect_window_seconds"), 120))
        rotation_cooldown = max(30, to_int(self.reconnect_policy.get("rotation_cooldown_seconds"), 180))
        users_state = self.reconnect_state.setdefault("users", {})
        events = self.reconnect_state.setdefault("events", [])
        detected: dict[str, dict[str, Any]] = {}
        changed = False

        active_ips = {user.ip for user in self._active_users()}
        for ip in list(users_state.keys()):
            if ip not in active_ips:
                users_state.pop(ip, None)
                changed = True

        for user in self._active_users():
            latest_epoch = self._activity_epoch_for_user(user)
            observed_online = latest_epoch > 0 and (now - latest_epoch) <= active_age
            row = users_state.setdefault(user.ip, {})
            was_online = bool(row.get("online"))
            last_activity_epoch = to_int(row.get("last_activity_epoch"), 0)
            event: dict[str, Any] = {}

            if was_online and not observed_online:
                row["online"] = False
                row["offline_at"] = now_iso()
                row["offline_epoch"] = int(now)
                row["offline_from_egress"] = user.current
                changed = True
            elif not was_online and observed_online:
                offline_epoch = to_int(row.get("offline_epoch"), 0)
                last_rotation_epoch = to_int(row.get("last_rotation_epoch"), 0)
                offline_from = str(row.get("offline_from_egress") or user.current)
                if (
                    offline_epoch
                    and (now - offline_epoch) <= reconnect_window
                    and (now - last_rotation_epoch) >= rotation_cooldown
                    and latest_epoch > last_activity_epoch
                    and offline_from == user.current
                ):
                    event = {
                        "user_ip": user.ip,
                        "from_egress": user.current,
                        "offline_at": row.get("offline_at"),
                        "online_at": now_iso(),
                        "offline_seconds": round(now - offline_epoch, 1),
                        "latest_activity_epoch": latest_epoch,
                        "reason": "client_reconnect_short_off_on",
                    }
                    detected[user.ip] = event
                    events.append(event)
                    row["last_rotation_epoch"] = int(now)
                row["online"] = True
                row["online_at"] = now_iso()
                changed = True

            if observed_online:
                row["last_seen_at"] = now_iso()
                row["last_activity_epoch"] = max(latest_epoch, last_activity_epoch)
            row["current_egress"] = user.current
            row["latest_activity_epoch"] = latest_epoch

        self.reconnect_state["events"] = events[-200:]
        self.reconnect_state["updated"] = now_iso()
        if changed or detected:
            write_json_atomic(self.reconnect_state_file, self.reconnect_state)
        return detected

    def _client_mbps_for_egress(self, egress_id: str) -> float:
        values: list[float] = []
        for user_data in (self.client_speed.get("users") or {}).values():
            latest = user_data.get("latest") or {}
            v7 = latest.get("v7") or {}
            if v7.get("egress") == egress_id and isinstance(v7.get("mbps"), (int, float)):
                values.append(float(v7["mbps"]))
        return sum(values) / len(values) if values else 0.0

    def _last_switches(self) -> dict[str, float]:
        path = self.event_dir / "switch-history.jsonl"
        last: dict[str, float] = {}
        try:
            lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
        except FileNotFoundError:
            return last
        for line in lines[-2000:]:
            try:
                item = json.loads(line)
            except json.JSONDecodeError:
                continue
            ip = str(item.get("user_ip", ""))
            ts = str(item.get("ts", ""))
            if not ip or not ts:
                continue
            try:
                dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
            except ValueError:
                continue
            last[ip] = dt.timestamp()
        return last

    def _group_usage(self) -> dict[str, set[str]]:
        usage: dict[str, set[str]] = {}
        for user in self.users:
            if user.enabled and user.current:
                usage.setdefault(user.current, set()).add(user.group)
        return usage

