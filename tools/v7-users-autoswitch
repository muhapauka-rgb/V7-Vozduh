def _controlled_source_reservation_owner_capability() -> dict[str, Any]:
    """Inspect the existing egress state owner by behavior, not by filename."""
    candidates = [
        Path(__file__).resolve().with_name("v7-egress-set-state"),
    ]
    installed = shutil.which("v7-egress-set-state")
    if installed:
        candidates.append(Path(installed))
    owner_path = next((path for path in candidates if path.is_file()), None)
    text = ""
    if owner_path is not None:
        try:
            text = owner_path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            text = ""
    required_semantics = {
        "reserve_mode": "certification-reserve",
        "release_mode": "certification-release",
        "empty_or_same_campaign_source_gate": (
            "controlled_source_reservation_requires_empty_or_"
            "same_campaign_certification_source"
        ),
        "cas_gate": "egress_fingerprint_changed",
        "ordinary_assignment_fence": "production_assignment_allowed",
        "planner_reservation_fence": "canary_reserved",
        "exact_reservation_identity": "controlled_source_reservation_id",
        "expiry_binding": "controlled_source_reservation_expires_at",
        "bounded_restore": "restore_backup",
    }
    checks = {
        key: token in text for key, token in required_semantics.items()
    }
    return {
        "owner": str(owner_path or "v7-egress-set-state"),
        "status": "READY" if checks and all(checks.values()) else "ENGINEERING_GAP",
        "checks": checks,
        "apply_requires_exact_confirm": (
            "RESERVE_CONTROLLED_CERTIFICATION_SOURCE" in text
            and "RELEASE_CONTROLLED_CERTIFICATION_SOURCE" in text
        ),
        "runtime_effect_now": False,
    }


def _controlled_source_draft_candidates(drafts_dir: Path) -> list[dict[str, Any]]:
    """Project redacted existing admin draft lifecycle without reading secrets out."""
    rows: list[dict[str, Any]] = []
    if not drafts_dir.is_dir():
        return rows
    for metadata_path in sorted(drafts_dir.glob("*/metadata.json")):
        metadata = read_json(metadata_path, {})
        if not isinstance(metadata, dict):
            continue
        config_path = metadata_path.parent / "config.input"
        expected_hash = str(metadata.get("config_sha256") or "")
        normalized_hash = ""
        try:
            raw = config_path.read_bytes()
            normalized_hash = hashlib.sha256(raw.rstrip(b"\n")).hexdigest()
        except OSError:
            pass
        protocol = str(metadata.get("protocol") or "")
        runtime_mode = str(metadata.get("runtime_mode") or "")
        supported = bool(
            runtime_mode == "interface"
            and protocol in {"wireguard", "amneziawg", "openvpn"}
        )
        lifecycle_pass = all(
            str(metadata.get(key) or "") == "PASS"
            for key in (
                "last_preflight_status",
                "last_runtime_status",
                "last_quarantine_status",
            )
        )
        config_bound = bool(
            expected_hash
            and normalized_hash
            and expected_hash == normalized_hash
        )
        usage = (
            metadata.get("usage_policy")
            if isinstance(metadata.get("usage_policy"), dict)
            else {}
        )
        hard_limit = max(
            0,
            to_int(usage.get("hard_limit") or metadata.get("hard_limit"), 0),
        )
        label = str(metadata.get("label") or metadata_path.parent.name)
        proposed_id = (
            re.sub(r"[^A-Za-z0-9_.-]+", "-", label.lower()).strip("-")[:32]
            or metadata_path.parent.name[:32]
        )
        blockers = []
        if not supported:
            blockers.append("dedicated_source_protocol_adapter_not_supported")
        if not lifecycle_pass:
            blockers.append("draft_preflight_runtime_or_quarantine_not_passed")
        if not config_bound:
            blockers.append("draft_config_generation_changed")
        if hard_limit < 1:
            blockers.append("draft_one_identity_capacity_not_owned")
        row = {
            "draft_id": str(metadata.get("id") or metadata_path.parent.name),
            "proposed_source_id": proposed_id,
            "protocol": protocol,
            "runtime_mode": runtime_mode,
            "status": str(metadata.get("status") or ""),
            "next_step": str(metadata.get("next_step") or ""),
            "preflight_status": str(metadata.get("last_preflight_status") or ""),
            "runtime_status": str(metadata.get("last_runtime_status") or ""),
            "quarantine_status": str(
                metadata.get("last_quarantine_status") or ""
            ),
            "config_generation_bound": config_bound,
            "config_fingerprint": normalized_hash,
            "hard_capacity": hard_limit,
            "one_identity_trial_capacity": max(0, hard_limit - 1),
            "ready_for_guarded_disabled_pool_preflight": not blockers,
            "blockers": sorted(set(blockers)),
            "owner": "existing admin/v7-admin-api egress draft lifecycle",
            "raw_config_returned": False,
        }
        row["fingerprint"] = sha256_json(row)
        rows.append(row)
    return rows


def controlled_source_topology_diagnostic(
    args: argparse.Namespace,
) -> dict[str, Any]:
    """Close the non-waiting source-topology discovery and preflight gap.

    This is a compact derived projection over existing owners.  It does not
    become a registry and deliberately emits no production evidence credit.
    """
    forbidden = [
        name for name in (
            "apply",
            "controlled_verifier_contention",
            "allow_pre_planner_refresh_with_apply",
        )
        if bool_value(getattr(args, name, False))
    ]
    forbidden.extend(
        name for name in (
            "approved_packet_id",
            "approved_operation_id",
            "approved_selected_move_hash",
            "approved_authority_generation",
            "approved_breaker_generation",
            "approved_source_bundle_hash",
            "approved_snapshot_bundle_hash",
            "generate_rollback_packet_from_result",
            "rollback_packet",
            "promote_authority_to",
        )
        if str(getattr(args, name, "") or "").strip()
    )
    forbidden_effects = {
        "registry_write": False,
        "policy_write": False,
        "identity_creation": False,
        "assignment_change": False,
        "candidate_created": False,
        "packet_created": False,
        "lease_created": False,
        "restore_barrier_write": False,
        "runtime_apply": False,
        "routing_mutation": False,
        "user_movement": 0,
        "rollback_apply": False,
        "authority_expansion": False,
        "production_maturity_change": False,
        "controlled_production_credit": False,
        "natural_l8_credit": False,
    }
    if forbidden:
        return {
            "schema_version": "v7.controlled-source-topology-capability-map.v1",
            "status": "STOP_SAFE_FORBIDDEN_FLAGS",
            "ok": False,
            "blockers": sorted(set(forbidden)),
            "forbidden_effects": forbidden_effects,
        }

    target_diagnostic = controlled_campaign_target_selection_diagnostic(args)
    shared_target_projection = (
        target_diagnostic.get("shared_production_target_capacity_projection")
        if isinstance(
            target_diagnostic.get("shared_production_target_capacity_projection"),
            dict,
        ) else {}
    )
    policy_root = read_json(Path(args.policy_file), {})
    policy_contract = (
        policy_root.get("delegated_autonomy_policy")
        if isinstance(policy_root, dict)
        and isinstance(policy_root.get("delegated_autonomy_policy"), dict)
        else {}
    )
    policy_validation = (
        operator_execution.validate_standing_delegated_operational_policy(
            policy_contract,
            # A standing Authority decision can legitimately live in a bounded
            # rotated audit segment.  This topology consumer must use the same
            # compact durable-lineage projection as the policy-status and
            # target-selection consumers; otherwise one active contract is
            # simultaneously PASS and "missing" depending on which existing
            # consumer read it.  It remains a read-only projection, not a new
            # registry or cache.
            audit_records=operator_execution.read_live_execution_lineage_records(
                Path(args.action_class_audit_store)
            ),
        )
    )
    policy = (
        policy_validation.get("policy")
        if isinstance(policy_validation.get("policy"), dict)
        else {}
    )
    topology_scope = (
        (policy.get("action_class_scopes") or {}).get(
            operator_execution.CONTROLLED_TOPOLOGY_DELEGATED_ACTION_CLASS
        )
        if isinstance(policy.get("action_class_scopes"), dict)
        else {}
    )
    topology_scope = topology_scope if isinstance(topology_scope, dict) else {}
    topology_policy_blockers = list(policy_validation.get("errors") or [])
    if (
        policy.get("policy_profile")
        not in {
            operator_execution.CONTROLLED_TOPOLOGY_STANDING_POLICY_PROFILE,
            operator_execution.AVAILABILITY_FIRST_STANDING_POLICY_PROFILE,
        }
    ):
        topology_policy_blockers.append(
            "controlled_topology_standing_policy_profile_missing"
        )
    if (
        operator_execution.CONTROLLED_TOPOLOGY_DELEGATED_ACTION_CLASS
        not in set(policy.get("allowed_action_classes") or [])
    ):
        topology_policy_blockers.append(
            "controlled_topology_action_class_not_allowed"
        )
    exact_topology_requirements = {
        "allowed_actions": ["REBIND_CONTROLLED_CERTIFICATION_SOURCE"],
        "certification_identities_only": True,
        "max_users_per_transaction": 1,
        "max_concurrent_transactions": 1,
        "ordinary_identity_delta": 0,
        "ordinary_route_delta": 0,
        "ordinary_assignment_mutation_allowed": False,
        "target_ordinary_users": 0,
        "immutable_manifest_required": True,
        "fresh_candidate_required": True,
        "fresh_packet_required": True,
        "fresh_lease_required": True,
        "restore_barrier_before_apply_required": True,
        "verification_required": True,
        "bounded_idempotent_rollback_required": True,
        "private_credential_mutation_allowed": False,
        "external_resource_creation_allowed": False,
        "hard_limit_modification_allowed": False,
        "authority_self_expansion_allowed": False,
    }
    for field, expected in exact_topology_requirements.items():
        if topology_scope.get(field) != expected:
            topology_policy_blockers.append(
                f"controlled_topology_scope_{field}_mismatch"
            )
    topology_policy_admission = {
        "schema_version": (
            "v7.controlled-certification-topology-standing-policy-admission.v1"
        ),
        "status": (
            "AUTO_ADMITTED_BY_STANDING_DELEGATED_CONTROLLED_TOPOLOGY_POLICY"
            if not topology_policy_blockers
            else "STANDING_DELEGATED_CONTROLLED_TOPOLOGY_POLICY_REQUIRED"
        ),
        "ok": not topology_policy_blockers,
        "contract_id": str(policy_contract.get("contract_id") or ""),
        "contract_hash": str(policy_contract.get("contract_hash") or ""),
        "policy_profile": str(policy.get("policy_profile") or ""),
        "policy_scope_hash": str(policy_contract.get("policy_scope_hash") or ""),
        "action_class": (
            operator_execution.CONTROLLED_TOPOLOGY_DELEGATED_ACTION_CLASS
        ),
        "max_users_per_transaction": int(
            topology_scope.get("max_users_per_transaction") or 0
        ),
        "max_concurrent_transactions": int(
            topology_scope.get("max_concurrent_transactions") or 0
        ),
        "blockers": sorted(set(topology_policy_blockers)),
        "authority_self_expansion": False,
        "production_effect_performed": False,
    }
    availability_scope = (
        (policy.get("action_class_scopes") or {}).get(
            operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
        )
        if isinstance(policy.get("action_class_scopes"), dict)
        else {}
    )
    availability_scope = (
        availability_scope
        if isinstance(availability_scope, dict)
        else {}
    )
    availability_policy_blockers = list(
        policy_validation.get("errors") or []
    )
    if (
        policy.get("policy_profile")
        != operator_execution.AVAILABILITY_FIRST_STANDING_POLICY_PROFILE
    ):
        availability_policy_blockers.append(
            "availability_first_standing_policy_profile_missing"
        )
    if (
        operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
        not in set(policy.get("allowed_action_classes") or [])
    ):
        availability_policy_blockers.append(
            "availability_first_action_class_not_allowed"
        )
    exact_availability_requirements = {
        "allowed_actions": list(
            operator_execution.AVAILABILITY_FIRST_ALLOWED_ACTIONS
        ),
        "certification_identities_only": True,
        "max_concurrent_transactions": 1,
        "ladder": list(operator_execution.AVAILABILITY_FIRST_LADDER),
        "ladder_stage_semantics": (
            "EXACT_TOTAL_COHORT_WITH_BASELINE_RESET"
        ),
        "ordinary_identity_delta": 0,
        "ordinary_route_delta": 0,
        "ordinary_assignment_mutation_allowed": False,
        "ordinary_reclassification_allowed": False,
        "shared_target_fault_injection_allowed": False,
        "shared_target_restart_allowed": False,
        "capacity_double_counting_forbidden": True,
        "source_target_collision_forbidden": True,
        "immutable_allocation_required": True,
        "fresh_inventory_required": True,
        "fresh_candidate_required": True,
        "fresh_packet_or_packet_set_required": True,
        "fresh_lease_required": True,
        "restore_barrier_before_apply_required": True,
        "per_user_verification_required": True,
        "per_target_verification_required": True,
        "aggregate_verification_required": True,
        "ordinary_user_quality_verification_required": True,
        "cohort_circuit_breaker_required": True,
        "partial_target_containment_required": True,
        "rollback_or_redistribution_required": True,
        "baseline_reset_between_stages_required": True,
        "authority_self_expansion_allowed": False,
    }
    for field, expected in exact_availability_requirements.items():
        if availability_scope.get(field) != expected:
            availability_policy_blockers.append(
                f"availability_first_scope_{field}_mismatch"
            )
    availability_max_users = int(
        availability_scope.get("max_users_per_transaction") or 0
    )
    if (
        availability_max_users < 1
        or availability_max_users
        != int(policy.get("max_users_per_action") or 0)
    ):
        availability_policy_blockers.append(
            "availability_first_scope_blast_radius_mismatch"
        )
    availability_policy_admission = {
        "schema_version": (
            "v7.availability-first-standing-policy-admission.v1"
        ),
        "status": (
            "AUTO_ADMITTED_BY_STANDING_DELEGATED_"
            "AVAILABILITY_FIRST_POLICY"
            if not availability_policy_blockers
            else "STANDING_DELEGATED_AVAILABILITY_FIRST_POLICY_REQUIRED"
        ),
        "ok": not availability_policy_blockers,
        "contract_id": str(policy_contract.get("contract_id") or ""),
        "contract_hash": str(policy_contract.get("contract_hash") or ""),
        "policy_profile": str(policy.get("policy_profile") or ""),
        "policy_scope_hash": str(
            policy_contract.get("policy_scope_hash") or ""
        ),
        "action_class": (
            operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
        ),
        "max_users_per_transaction": availability_max_users,
        "max_concurrent_transactions": int(
            availability_scope.get("max_concurrent_transactions") or 0
        ),
        "ladder": list(availability_scope.get("ladder") or []),
        "blockers": sorted(set(availability_policy_blockers)),
        "authority_self_expansion": False,
        "production_effect_performed": False,
    }
    topology_authority_status = (
        operator_execution.controlled_source_topology_authority_status(
            operator_execution.read_live_execution_lineage_records(
                Path(args.action_class_audit_store)
            )
        )
    )
    prior_topology_request = (
        topology_authority_status.get("request")
        if isinstance(topology_authority_status.get("request"), dict)
        else {}
    )
    prior_topology_manifest = (
        prior_topology_request.get("manifest")
        if isinstance(prior_topology_request.get("manifest"), dict)
        else {}
    )
    declined_rebind_sources = set()
    declined_drafts = set()
    if topology_authority_status.get("status") == "DECLINED":
        declined_resource = str(
            prior_topology_manifest.get("selected_source_or_draft") or ""
        )
        if (
            prior_topology_request.get("exact_action")
            == "REBIND_CONTROLLED_CERTIFICATION_SOURCE"
            and declined_resource
        ):
            declined_rebind_sources.add(declined_resource)
        if (
            prior_topology_request.get("exact_action")
            == "PROVISION_DEDICATED_CONTROLLED_CERTIFICATION_SOURCE"
            and declined_resource
        ):
            declined_drafts.add(declined_resource)
    campaign = (
        target_diagnostic.get("campaign")
        if isinstance(target_diagnostic.get("campaign"), dict)
        else {}
    )
    source_id = str(campaign.get("source_id") or "")
    campaign_stages = sorted({
        to_int(value, 0)
        for value in (
            list(campaign.get("remaining_stages") or [])
            + list(campaign.get("completed_stages") or [])
            + [campaign.get("current_stage")]
        )
        if to_int(value, 0) > 0
    }) or [5, 10, 25, 48]
    current_stage = max(1, to_int(campaign.get("current_stage"), 0) or 5)
    campaign_completion_stage = max(campaign_stages)
    rows = [
        row for row in (target_diagnostic.get("targets") or [])
        if isinstance(row, dict)
    ]
    registry_rows = parse_registry(Path(args.state_dir) / "egress.registry")
    registry_by_id = {
        str(row.get("id") or ""): row
        for row in registry_rows
        if str(row.get("id") or "")
    }
    assignment_rows = [
        row for row in parse_registry(Path(args.state_dir) / "users.registry")
        if bool_value(row.get("enabled", "1"))
    ]
    source_registry = registry_by_id.get(source_id, {})
    campaign_group = str(source_registry.get("certification_group") or "")
    campaign_identity_rows = [
        row for row in assignment_rows
        if bool_value(row.get("certification_user"))
        and (
            not campaign_group
            or str(row.get("certification_group") or "") == campaign_group
        )
    ]
    campaign_identity_locations: dict[str, int] = {}
    for row in campaign_identity_rows:
        location = str(row.get("current") or "UNASSIGNED")
        campaign_identity_locations[location] = (
            campaign_identity_locations.get(location, 0) + 1
        )
    campaign_identity_count = len(campaign_identity_rows)
    # ``campaign.source_id`` is immutable historical admission lineage.  It
    # can legitimately differ from the current controlled source after an
    # owner-backed topology rebind.  Accounting needs present route truth, so
    # use the single live controlled source carrying this campaign group when
    # it is unambiguous; otherwise retain the historical source and fail the
    # semantic selection closed in the projection rather than guessing.
    live_campaign_source_candidates = sorted(
        str(row.get("id") or "")
        for row in registry_rows
        if bool_value(row.get("controlled_certification_source"))
        and str(row.get("certification_group") or "") == campaign_group
        and int(campaign_identity_locations.get(str(row.get("id") or ""), 0))
        > 0
    )
    campaign_identity_baseline_source_id = (
        live_campaign_source_candidates[0]
        if len(live_campaign_source_candidates) == 1
        else source_id
    )
    reservation_owner = _controlled_source_reservation_owner_capability()
    certification_users = sorted(
        str(row.get("ip") or "")
        for row in assignment_rows
        if bool_value(row.get("certification_user"))
        and str(row.get("current") or "") == source_id
        and str(row.get("ip") or "")
    )
    trial_identity = certification_users[0] if certification_users else ""
    certification_identity_fingerprint = sha256_json(sorted(
        str(row.get("ip") or "")
        for row in campaign_identity_rows
        if str(row.get("ip") or "")
    ))
    # This is deliberately a compact derived read model, not a second
    # campaign registry.  The assignments owner remains authoritative for
    # every identity.  A stage may proceed only when the complete immutable
    # certification cohort can be balanced against current route truth;
    # retaining raw user lists here would make periodic Matrix projections
    # grow with the cohort.
    campaign_identity_ips = sorted(
        str(row.get("ip") or "")
        for row in campaign_identity_rows
        if str(row.get("ip") or "")
    )
    campaign_identity_unique_count = len(set(campaign_identity_ips))
    campaign_identity_unassigned_count = sum(
        1
        for row in campaign_identity_rows
        if not str(row.get("current") or "").strip()
        or str(row.get("current") or "") == "UNASSIGNED"
    )
    campaign_identity_source_count = int(
        campaign_identity_locations.get(
            campaign_identity_baseline_source_id,
            0,
        )
    )
    campaign_identity_target_counts = {
        location: int(count)
        for location, count in campaign_identity_locations.items()
        if location != campaign_identity_baseline_source_id
    }
    campaign_identity_target_count = sum(
        campaign_identity_target_counts.values()
    )
    # Availability-first certification always returns the cohort to the
    # controlled baseline.  Until that reset receipt is consumed, every
    # non-baseline current route is therefore an in-flight forward/reset
    # member, not a stable target allocation.  This keeps the balance causal
    # without duplicating the mutable execution lease or raw identity set.
    campaign_identity_active_forward_count = campaign_identity_target_count
    campaign_identity_accounted_count = (
        campaign_identity_source_count
        + campaign_identity_active_forward_count
    )
    campaign_identity_accounting = {
        "schema_version": "v7.controlled-campaign-identity-accounting.v1",
        "status": (
            "ACCOUNTED"
            if (
                campaign_identity_count > 0
                and campaign_identity_unique_count == campaign_identity_count
                and campaign_identity_unassigned_count == 0
                and campaign_identity_accounted_count
                == campaign_identity_count
            )
            else "CAMPAIGN_IDENTITY_ACCOUNTING_BROKEN"
        ),
        "expected_identity_count": campaign_identity_count,
        "identity_set_fingerprint": certification_identity_fingerprint,
        "baseline_source_id": campaign_identity_baseline_source_id,
        "baseline_source_selection": (
            "CURRENT_CONTROLLED_SOURCE_GROUP_OCCUPANCY"
            if len(live_campaign_source_candidates) == 1
            else "HISTORICAL_CAMPAIGN_SOURCE_FALLBACK_AMBIGUOUS_OR_EMPTY"
        ),
        "baseline_source_count": campaign_identity_source_count,
        "target_count": 0,
        "target_locations": dict(sorted(campaign_identity_target_counts.items())),
        "active_forward_count": campaign_identity_active_forward_count,
        "active_reset_count": 0,
        "contained_count": 0,
        "accounted_count": campaign_identity_accounted_count,
        "unique_identity_count": campaign_identity_unique_count,
        "unassigned_count": campaign_identity_unassigned_count,
        "raw_user_list_stored": False,
        "balance": {
            "expected": campaign_identity_count,
            "baseline_source": campaign_identity_source_count,
            "targets": 0,
            "active_forward": campaign_identity_active_forward_count,
            "active_reset": 0,
            "contained": 0,
            "accounted": campaign_identity_accounted_count,
        },
    }

    rebind_candidates = []
    for row in rows:
        target_id = str(row.get("target_id") or "")
        registry = registry_by_id.get(target_id, {})
        capacity = (
            row.get("capacity") if isinstance(row.get("capacity"), dict) else {}
        )
        quality = (
            row.get("quality") if isinstance(row.get("quality"), dict) else {}
        )
        ordinary_users = int(capacity.get("ordinary_users") or 0)
        certification_user_count = int(
            capacity.get("certification_users") or 0
        )
        assigned_rows = [
            item for item in assignment_rows
            if str(item.get("current") or "") == target_id
        ]
        assigned_certification_rows = [
            item for item in assigned_rows
            if bool_value(item.get("certification_user"))
        ]
        free_capacity = int(capacity.get("free_capacity_after_reserve") or 0)
        empty = int(capacity.get("current_assigned_users") or 0) == 0
        reservation_id = str(
            registry.get("controlled_source_reservation_id") or ""
        )
        reservation_expires_at = str(
            registry.get("controlled_source_reservation_expires_at") or ""
        )
        reservation_unexpired = bool(
            reservation_id
            and reservation_expires_at
            and parse_ts(reservation_expires_at) > time.time()
        )
        reserved_controlled_source = bool(
            bool_value(registry.get("controlled_certification_source"))
            and bool_value(registry.get("execution_reserved"))
            and bool_value(registry.get("canary_reserved"))
            and str(registry.get("reservation_owner") or "")
            == "operator_execution_governance"
            and not bool_value(registry.get("autoswitch_allowed"))
            and not bool_value(registry.get("rebalance_allowed"))
            and str(
                registry.get("production_assignment_allowed") or ""
            ).lower() in {"0", "false", "no"}
        )
        reserved_group = str(registry.get("certification_group") or "")
        assigned_groups = sorted({
            str(item.get("certification_group") or "")
            for item in assigned_certification_rows
        })
        reservation_group_aligned = bool(
            not assigned_certification_rows
            or (
                reserved_group
                and assigned_groups == [reserved_group]
            )
        )
        campaign_group_aligned = bool(
            not assigned_certification_rows
            or (
                campaign_group
                and all(
                    str(item.get("certification_group") or "")
                    == campaign_group
                    for item in assigned_certification_rows
                )
            )
        )
        continuing_campaign_source_repairable = bool(
            reserved_controlled_source
            and ordinary_users == 0
            and bool(assigned_certification_rows)
            and campaign_group_aligned
        )
        continuing_reservation_valid = bool(
            reserved_controlled_source
            and ordinary_users == 0
            and reservation_unexpired
            and reservation_group_aligned
            and campaign_group_aligned
        )
        hard_gate_blockers = []
        if target_id == source_id:
            hard_gate_blockers.append("same_as_current_failed_source")
        if not bool((row.get("health") or {}).get("ok")):
            hard_gate_blockers.append("healthy_baseline_not_proven")
        if quality.get("blockers"):
            hard_gate_blockers.append("quality_or_stability_floor_not_met")
        if ordinary_users:
            hard_gate_blockers.append(
                "ordinary_users_share_whole_egress_failure_domain"
            )
        if (
            not empty
            and not reserved_controlled_source
            and not continuing_campaign_source_repairable
        ):
            hard_gate_blockers.append("source_not_empty_before_reservation")
        if (
            reserved_controlled_source
            and not reservation_unexpired
            and not continuing_campaign_source_repairable
        ):
            hard_gate_blockers.append(
                "controlled_source_reservation_expired"
            )
        if (
            reserved_controlled_source
            and not reservation_group_aligned
            and not continuing_campaign_source_repairable
        ):
            hard_gate_blockers.append(
                "controlled_source_reservation_group_mismatch"
            )
        if reserved_controlled_source and not campaign_group_aligned:
            hard_gate_blockers.append(
                "controlled_source_campaign_group_mismatch"
            )
        if free_capacity < 1:
            hard_gate_blockers.append("one_identity_capacity_unavailable")
        if not row.get("verification_supported"):
            hard_gate_blockers.append("baseline_verification_not_supported")
        if not row.get("rollback_containment_supported"):
            hard_gate_blockers.append("bounded_rollback_not_supported")
        if reservation_owner.get("status") != "READY":
            hard_gate_blockers.append(
                "certification_reservation_and_release_owner_missing"
            )
        rebind_candidates.append({
            "source_id": target_id,
            "protocol": str(row.get("protocol") or ""),
            "interface": str(row.get("interface") or ""),
            "ordinary_identities": ordinary_users,
            "certification_identities": certification_user_count,
            "campaign_certification_identities": sum(
                1
                for item in assigned_certification_rows
                if (
                    campaign_group
                    and str(item.get("certification_group") or "")
                    == campaign_group
                )
            ),
            "healthy_baseline": bool((row.get("health") or {}).get("ok")),
            "stability_pass": not bool(quality.get("blockers")),
            "free_capacity_after_reserve": free_capacity,
            "supports_all_48_identities": (
                free_capacity
                + sum(
                    1
                    for item in assigned_certification_rows
                    if (
                        campaign_group
                        and str(item.get("certification_group") or "")
                        == campaign_group
                    )
                )
                >= max(48, campaign_identity_count)
            ),
            "separate_certification_policy_tables": True,
            "separate_route_rules": True,
            "independently_controllable_failure_boundary": bool(
                ordinary_users == 0
                and (empty or continuing_reservation_valid)
            ),
            "initial_empty_reservation_eligible": bool(
                empty and ordinary_users == 0
            ),
            "continuing_campaign_source_repairable": (
                continuing_campaign_source_repairable
            ),
            "existing_controlled_reservation": {
                "present": reserved_controlled_source,
                "reservation_id": reservation_id,
                "expires_at": reservation_expires_at,
                "unexpired": reservation_unexpired,
                "reservation_group": reserved_group,
                "assigned_certification_groups": assigned_groups,
                "reservation_group_aligned": reservation_group_aligned,
                "campaign_group": campaign_group,
                "campaign_group_aligned": campaign_group_aligned,
                "continuation_valid": continuing_reservation_valid,
            },
            "reservation_owner_ready": (
                reservation_owner.get("status") == "READY"
            ),
            "technically_feasible": not hard_gate_blockers,
            "hard_gate_blockers": hard_gate_blockers,
            "owner_lineage": row.get("owner_lineage") or {},
            "semantic_fingerprint": str(row.get("semantic_fingerprint") or ""),
        })
    rebind_ranked = sorted(
        (
            row for row in rebind_candidates
            if (
                row.get("technically_feasible")
                and str(row.get("source_id") or "")
                not in declined_rebind_sources
            )
        ),
        key=lambda row: (
            not bool(row.get("supports_all_48_identities")),
            -int(row.get("free_capacity_after_reserve") or 0),
            str(row.get("source_id") or ""),
        ),
    )
    selected_rebind = rebind_ranked[0] if rebind_ranked else {}

    drafts = _controlled_source_draft_candidates(
        Path(args.egress_drafts_dir)
    )
    ready_drafts = [
        row for row in drafts
        if row.get("ready_for_guarded_disabled_pool_preflight")
        and str(row.get("draft_id") or "") not in declined_drafts
    ]
    ready_drafts.sort(
        key=lambda row: (
            -int(row.get("one_identity_trial_capacity") or 0),
            str(row.get("draft_id") or ""),
        )
    )
    campaign_capable_drafts = [
        row for row in ready_drafts
        if int(row.get("one_identity_trial_capacity") or 0) >= current_stage
        and int(row.get("one_identity_trial_capacity") or 0)
        >= campaign_completion_stage
    ]
    selected_draft = (
        campaign_capable_drafts[0] if campaign_capable_drafts else {}
    )

    occupied_slice_rows = [
        row for row in rows
        if int((row.get("capacity") or {}).get("ordinary_users") or 0) > 0
    ]
    slice_blockers = [
        "shared_egress_failure_affects_ordinary_users",
