    def _emit_terminal_audit(self, audit: dict[str, Any]) -> dict[str, Any]:
        metadata = audit.get("metadata") or {}
        args = [
            f"object_type={audit.get('object_type', '')}",
            f"object_id={audit.get('object_id', '')}",
            f"result={audit.get('result', '')}",
        ]
        args.extend(f"{key}={value}" for key, value in metadata.items() if value not in (None, ""))
        try:
            proc = subprocess.run(
                ["v7-audit-log", audit["action"], audit["component"], f"operation_id={audit.get('object_id', '')}", *args],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=10,
            )
            audit["emitted"] = proc.returncode == 0
            audit["status"] = "emitted" if proc.returncode == 0 else "emit_failed"
            audit["output"] = proc.stdout[-1000:]
        except (OSError, subprocess.TimeoutExpired) as exc:
            audit["emitted"] = False
            audit["status"] = "emit_failed"
            audit["error"] = str(exc)
        return audit

