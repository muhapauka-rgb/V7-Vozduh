            "status": "POLICY_NOT_ACTIVE",
            "ok": True,
            "stages": list(operator_execution.AVAILABILITY_FIRST_LADDER),
            "completed_stages": [],
            "production_proven_max": 0,
            "next_stage": 1,
            "completed": False,
            "receipt_ids": [],
