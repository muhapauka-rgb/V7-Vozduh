def controlled_certification_substrate_authority_request_only(
    args: argparse.Namespace,
) -> dict[str, Any]:
    """Prepare the one coordinated M8 boundary through existing owners only."""
    forbidden = [
        name for name in (
            "apply", "emergency_failover_autonomy", "controlled_verifier_contention",
            "allow_pre_planner_refresh_with_apply",
        )
        if bool_value(getattr(args, name, False))
    ]
    forbidden.extend(
        name for name in (
            "approved_packet_id", "approved_operation_id", "approved_selected_move_hash",
            "approved_authority_generation", "approved_breaker_generation",
            "approved_source_bundle_hash", "approved_snapshot_bundle_hash",
            "generate_rollback_packet_from_result", "rollback_packet", "promote_authority_to",
        )
        if str(getattr(args, name, "") or "").strip()
    )
    if str(getattr(args, "pre_planner_refresh", "off") or "off") != "off":
        forbidden.append("pre_planner_refresh")
    if forbidden:
        return {
            "schema_version": "v7.controlled-certification-substrate-authority-entrypoint.v1",
            "status": "STOP_SAFE_FORBIDDEN_FLAGS",
            "ok": False,
            "blockers": [
                f"controlled_certification_substrate_request_forbids_{name}"
                for name in sorted(set(forbidden))
            ],
        }

    policy_root = read_json(Path(args.policy_file), {})
    policy_root = policy_root if isinstance(policy_root, dict) else {}
    contract = policy_root.get("delegated_autonomy_policy")
    contract = contract if isinstance(contract, dict) else {}
    audit_store = Path(args.action_class_audit_store)
    validation = operator_execution.validate_standing_delegated_operational_policy(
        contract,
        audit_records=operator_execution.read_live_execution_lineage_records(
            audit_store
        ),
    )
    pool = controlled_certification_pool_status(Path(args.state_dir))
    sources = [
        row for row in (pool.get("active_source_projections") or [])
        if (
            isinstance(row, dict)
            and str(row.get("source_id") or "")
            and bool(row.get("source_isolated_for_controlled_failure"))
            and int(row.get("enabled_certification_users_on_source") or 0) > 0
        )
    ]
    sources.sort(
        key=lambda row: (
            int(row.get("enabled_certification_users_on_source") or 0),
            str(row.get("source_id") or ""),
        ),
        reverse=True,
    )
    source_candidate = sources[0] if sources else {}
    if not source_candidate:
        candidates = [
            row for row in (
                pool.get("healthy_isolated_source_candidates") or []
            )
            if isinstance(row, dict) and str(row.get("source_id") or "")
        ]
        candidates.sort(key=lambda row: str(row.get("source_id") or ""))
        source_candidate = candidates[0] if candidates else {}
    source_id = str(source_candidate.get("source_id") or "")
    target_diagnostic = controlled_campaign_target_selection_diagnostic(args)
    selected_target_id = str(
        (target_diagnostic.get("selection") or {}).get(
            "selected_target_id"
        )
        or ""
    )
    selected_target_projection = next((
        row for row in (target_diagnostic.get("targets") or [])
        if isinstance(row, dict)
        and str(row.get("target_id") or "") == selected_target_id
    ), {})
    controlled_target = next((
        row for row in (
            pool.get("execution_only_controlled_target_candidates")
            or []
        )
        if isinstance(row, dict)
        and str(row.get("source_id") or "") == selected_target_id
    ), {})
    controlled_target_id = selected_target_id
    blockers = []
    if not validation.get("ok"):
        blockers.extend(validation.get("errors") or ["standing_policy_invalid"])
    if int((validation.get("policy") or {}).get("max_users_per_action") or 0) != 48:
        blockers.append("tier48_standing_policy_required")
    if not source_id:
        blockers.append(
            "healthy_isolated_controlled_source_or_existing_candidate_required"
        )
    if (
        not bool((source_candidate.get("baseline_health") or {}).get("ok"))
        and not controlled_target_id
    ):
        blockers.append(
            "failed_controlled_source_requires_healthy_exact_controlled_target"
        )
    if blockers:
        return {
            "schema_version": "v7.controlled-certification-substrate-authority-entrypoint.v1",
            "status": "STOP_SAFE_PREDECESSOR_REQUIRED",
            "ok": False,
            "blockers": sorted(set(str(item) for item in blockers)),
            "controlled_certification_pool": pool,
            "controlled_target_selection": target_diagnostic,
            "forbidden_effects": {
                "audit_write": False,
                "policy_write": False,
                "registry_write": False,
                "identity_creation": False,
                "assignment_change": False,
                "controlled_condition": False,
                "candidate_created": False,
                "packet_created": False,
                "lease_created": False,
                "runtime_apply": False,
                "routing_mutation": False,
                "user_movement": 0,
                "authority_expansion": False,
                "production_maturity_change": False,
            },
        }
    request = operator_execution.build_controlled_certification_substrate_authority_request(
        active_program="V7_SERVICE_FAILURE_AUTOMATION_EVOLUTION_PROGRAM_V1",
        source_id=source_id,
        current_pool_status=pool,
        current_policy_contract_id=str(contract.get("contract_id") or ""),
        current_policy_contract_hash=str(contract.get("contract_hash") or ""),
        controlled_target_id=controlled_target_id,
        controlled_target_admission={
            **controlled_target,
            "selection": selected_target_projection,
            "inventory_fingerprint": str(
                target_diagnostic.get("inventory_fingerprint") or ""
            ),
            "fingerprint": sha256_json({
                "pool_projection": controlled_target,
                "selection_projection": selected_target_projection,
                "inventory_fingerprint": str(
                    target_diagnostic.get("inventory_fingerprint") or ""
                ),
            }),
