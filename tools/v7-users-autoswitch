def parse_kv_line(line: str) -> dict[str, str]:
    row: dict[str, str] = {}
    for part in line.split():
        if "=" not in part:
            continue
        key, value = part.split("=", 1)
        row[key.strip()] = value.strip()
    return row


def parse_registry(path: Path) -> list[dict[str, str]]:
    rows: list[dict[str, str]] = []
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except FileNotFoundError:
        return rows
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        row = parse_kv_line(line)
        if row:
            rows.append(row)
    return rows


def prepared_target_topology_generation(path: Path) -> str:
    """Hash target identity/policy topology without operational up/down.

    ``enabled`` is volatile health state: a hard source failure is the event
    that consumes this projection. The Matrix consumer still checks every
    declared target's current enabled/canary state and fresh path evidence.
    """
    rows = [
        {
            str(key): str(value)
            for key, value in sorted(row.items())
            if str(key) != "enabled"
        }
        for row in parse_registry(path)
    ]
    rows.sort(key=lambda row: str(row.get("id") or ""))
    return sha256_json(rows)


def declared_target_egress_ip(target: "Egress") -> tuple[str, str]:
    """Return the immutable public identity declared by an existing target.

    Most egress rows carry ``expected_ip`` directly.  An execution-only
    WireGuard/AmneziaWG target can legitimately inherit that declaration from
    its canonical tunnel endpoint when the registry row was created without a
    duplicate field.  This is deliberately narrow: it reads one existing
    target config, accepts one global IPv4 endpoint only, and the subsequent
    exact route-bound payload probe still has to prove that the observed
    egress equals it.  It never learns an identity from the probe itself.
    """
    raw = target.raw if isinstance(target.raw, dict) else {}
    registry = raw.get("registry") if isinstance(raw.get("registry"), dict) else {}
    meta = raw.get("meta") if isinstance(raw.get("meta"), dict) else {}
    explicit = str(
        registry.get("expected_ip")
        or meta.get("expected_ip")
        or raw.get("expected_ip")
        or ""
    ).strip()
    if explicit:
        try:
            if ipaddress.ip_address(explicit).is_global:
                return explicit, "egress_registry_expected_ip"
        except ValueError:
            return "", "invalid_egress_registry_expected_ip"
        return "", "invalid_egress_registry_expected_ip"

    protocol = str(registry.get("protocol") or raw.get("protocol") or "").lower()
    config_path = str(
        registry.get("config_path")
        or registry.get("config")
        or meta.get("config_path")
        or meta.get("config")
        or raw.get("config_path")
        or raw.get("config")
        or ""
    ).strip()
    if protocol not in {"wireguard", "amneziawg"} or not config_path:
        return "", "no_declared_target_egress_identity"
    path = Path(config_path)
    # Only consume the existing tunnel configuration owner.  Do not follow a
    # user-controlled path or parse a generic configuration as an IP source.
    if not path.is_absolute() or not any(
        str(path).startswith(prefix)
        for prefix in ("/etc/wireguard/", "/etc/amnezia/")
    ):
        return "", "unsupported_target_config_owner"
    try:
        contents = path.read_text(encoding="utf-8", errors="replace")[:65536]
    except OSError:
        return "", "target_config_unreadable"
    endpoints = {
        match.group(1)
        for match in re.finditer(
            r"(?mi)^\s*Endpoint\s*=\s*\[?([0-9.]+)\]?\s*:\s*[0-9]+\s*$",
            contents,
        )
    }
    if len(endpoints) != 1:
        return "", "target_endpoint_identity_ambiguous"
    endpoint = next(iter(endpoints))
    try:
        if ipaddress.ip_address(endpoint).is_global:
            return endpoint, "tunnel_endpoint_expected_ip"
    except ValueError:
        pass
    return "", "target_endpoint_identity_invalid"


CONTROLLED_CERTIFICATION_BASELINE_MAX_AGE_SECONDS = 3600


def read_flat_state(path: Path) -> dict[str, str]:
    """Read an existing compact key=value state owner without copying raw logs."""
    result: dict[str, str] = {}
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except FileNotFoundError:
        return result
    for line in lines:
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        if key:
            result[key] = value.strip()
    return result


def controlled_certification_source_health_status(
    state_dir: Path,
    source_id: str,
    *,
    matrix: Optional[dict[str, Any]] = None,
    diagnose: Optional[dict[str, str]] = None,
    egress_rows: Optional[list[dict[str, str]]] = None,
) -> dict[str, Any]:
    """Project a compact, fail-closed baseline from the existing Matrix owner.

    An empty source is isolated, but isolation is not reachability.  Controlled
    certification needs a healthy baseline before the existing condition owner
    can deliberately fail and later restore that source.  Keep service details
    with ``service-matrix.json`` and expose only counts plus a fingerprint here.
    """
    state_dir = Path(state_dir)
    matrix_path = state_dir / "service-matrix.json"
    matrix = matrix if isinstance(matrix, dict) else read_json(matrix_path, {})
    items = matrix.get("items") if isinstance(matrix.get("items"), dict) else {}
    row = items.get(str(source_id or ""))
    row = row if isinstance(row, dict) else {}
    services = row.get("services") if isinstance(row.get("services"), dict) else {}
    matrix_updated = str(matrix.get("updated") or "")
    age_seconds = max(0.0, time.time() - parse_ts(matrix_updated)) if matrix_updated else -1.0
    fresh = bool(
        matrix_updated
        and age_seconds <= CONTROLLED_CERTIFICATION_BASELINE_MAX_AGE_SECONDS
    )
    hard_statuses = {"FAIL", "DOWN", "NOT_STARTED"}
    hard_failures = 0
    reachable = 0
    observations: list[dict[str, Any]] = []
    for service_id, value in sorted(services.items()):
        service = value if isinstance(value, dict) else {}
        status = str(service.get("status") or "").upper()
        ok = bool_value(service.get("ok"))
        hard = status in hard_statuses or status.startswith("TELEGRAM_DOWN_")
        if hard:
            hard_failures += 1
        if ok and not hard:
            reachable += 1
        observations.append({
            "service_id": str(service_id),
            "status": status,
            "ok": ok,
            "hard_failure": hard,
            "observed_at": str(
                service.get("observed_at") or service.get("tested_at") or ""
            ),
        })
    if not services:
        status = "STOP_SAFE_BASELINE_NOT_OBSERVED"
    elif not fresh:
        status = "STOP_SAFE_BASELINE_STALE"
    elif hard_failures or reachable == 0:
        status = "STOP_SAFE_BASELINE_UNHEALTHY"
    else:
        status = "PASS_HEALTHY_BASELINE"

    diagnose = (
        diagnose if isinstance(diagnose, dict)
        else read_flat_state(state_dir / "egress-diagnose.state")
    )
    diagnostic_reason = str(
        diagnose.get(f"{source_id}_diagnose_reason") or "NOT_OBSERVED"
    )
    diagnostic_severity = str(
        diagnose.get(f"{source_id}_diagnose_severity") or "UNKNOWN"
    )
    diagnostic_detail = str(
        diagnose.get(f"{source_id}_diagnose_detail") or ""
    )
    source_rows = (
        egress_rows if isinstance(egress_rows, list)
        else parse_registry(state_dir / "egress.registry")
    )
    source_row = next((
        value for value in source_rows
        if str(value.get("id") or "") == str(source_id or "")
    ), {})
    config_path = Path(
        str(source_row.get("config") or source_row.get("config_path") or "")
    )
    config_fingerprint = (
        sha256_file(config_path)
        if str(config_path) and config_path.is_file()
        else ""
    )
    root_cause_class = "NONE"
    exact_external_resource = "NONE"
    exact_external_owner = "NONE"
    exact_required_input = "NONE"
    why_existing_owners_cannot_supply_it = "NONE"
    failed_producer_consumer_link = "NONE"
    if (
        status == "STOP_SAFE_BASELINE_UNHEALTHY"
        and diagnostic_severity == "FAIL"
        and diagnostic_reason == "curl_failed_and_handshake_stale"
        and "handshake_age_seconds=999999" in diagnostic_detail
    ):
        # Interface/process/route presence plus a never-established handshake
        # cannot distinguish a dead remote peer from revoked or mismatched
        # remote key material.  Both require the same independent external
        # input, so keep the classification honest and fail closed.
        root_cause_class = "EXTERNAL_INFRASTRUCTURE_OR_ACCESS_REQUIRED"
        exact_external_resource = (
            f"AMNEZIAWG_REMOTE_PEER_OR_MATCHING_PROFILE_FOR_SOURCE_{source_id}"
        )
        exact_external_owner = (
            "EXTERNAL_AMNEZIAWG_PEER_OR_CREDENTIAL_PROVIDER"
        )
        exact_required_input = (
            "OWNER_VERIFIED_REACHABLE_REMOTE_PEER_WITH_MATCHING_KEY_MATERIAL_"
            "OR_REPLACEMENT_WORKING_PROFILE_FOR_THE_EXACT_APPROVED_SOURCE"
        )
        why_existing_owners_cannot_supply_it = (
