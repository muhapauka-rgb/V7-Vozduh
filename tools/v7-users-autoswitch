        )

    def _open_n10_execution_control_window(
        self,
        plan: dict[str, Any],
        *,
        operation_id: str,
        selected_move_hash: str,
        action_class: str,
    ) -> dict[str, Any]:
        """Open one existing-owner control window for a Packet-bound N10 apply.

        The global control file is normally OPEN (fail closed for forward
        mutation).  A valid N10 Packet/Lease/Barrier is the sole authority to
        create its short, operation-bound CLOSED window; the normal CLI
        finalizer returns it to OPEN after the terminal result.
        """
        safety = plan.get("safety") if isinstance(plan.get("safety"), dict) else {}
        barrier = (
            safety.get("restore_barrier")
            if isinstance(safety.get("restore_barrier"), dict)
            else {}
        )
        # The Packet/Barrier and the operation-scoped binding deliberately
        # hash different representations of the same current transaction.
        # The Packet binds the governed approval bundle; the existing binding
        # owner binds the exact route-writer projection.  Do not compare their
        # hashes as if they were interchangeable.  Require both owners, and
        # bind execution control to the latter representation.
        operation_binding = self._operation_scoped_source_binding(plan)
        source_bundle_hash = str(
            operation_binding.get("source_bundle_hash")
            or ""
        )
        snapshot_bundle_hash = str(
            operation_binding.get("snapshot_bundle_hash")
            or ""
        )
        control_path = Path(
            getattr(self.args, "execution_control_file", DEFAULT_EXECUTION_CONTROL_FILE)
        )
        missing = [
            name
            for name, value in {
                "operation_id": operation_id,
                "selected_move_hash": selected_move_hash,
                "action_class": action_class,
                "source_bundle_hash": source_bundle_hash,
                "snapshot_bundle_hash": snapshot_bundle_hash,
            }.items()
            if not str(value or "")
        ]
        before = operator_execution.autonomous_execution_control_state(control_path)
        if (
            missing
            or operation_binding.get("status") != "BOUND"
            or not barrier.get("approved_source_bundle_hash")
            or not barrier.get("approved_snapshot_bundle_hash")
            or not before.get("valid")
            or before.get("state") != "OPEN"
        ):
            return {
                "ok": False,
                "reason": "n10_execution_control_window_not_open",
                "missing": missing,
                "before": before,
                "operation_scoped_binding": operation_binding,
                "runtime_mutation": False,
            }
        control = operator_execution.build_autonomous_execution_control_state(
            False,
            actor="tools/v7-users-autoswitch:n10-ordinary-like",
            reason="n10_packet_bound_single_device_apply",
            operation_id=operation_id,
            selected_move_hash=selected_move_hash,
            action_class=action_class,
            source_bundle_hash=source_bundle_hash,
            snapshot_bundle_hash=snapshot_bundle_hash,
            max_users=max(1, len(plan.get("selected_moves") or [])),
        )
        operator_execution.write_json_atomic(control_path, control)
        decision = self._execution_control_decision(
            mutation_kind="forward",
            action_class=action_class,
            expected_generation=str(control.get("generation") or ""),
            operation_id=operation_id,
            selected_move_hash=selected_move_hash,
            source_bundle_hash=source_bundle_hash,
            snapshot_bundle_hash=snapshot_bundle_hash,
            max_users=max(1, len(plan.get("selected_moves") or [])),
        )
        if not decision.get("allowed_forward_mutation"):
            finalization = operator_execution.finalize_autonomous_execution_control_window(
                control_path,
                expected_generation=str(control.get("generation") or ""),
                operation_id=operation_id,
                actor="tools/v7-users-autoswitch:n10-ordinary-like",
                reason="n10_control_window_pre_apply_stop_safe",
            )
            return {
                "ok": False,
                "reason": "n10_execution_control_window_validation_failed",
                "before": before,
                "control": control,
                "decision": decision,
                "finalization": finalization,
                "runtime_mutation": False,
            }
        window = {
            "ok": True,
            "before": before,
            "control": control,
            "decision": decision,
            "source_bundle_hash": source_bundle_hash,
            "snapshot_bundle_hash": snapshot_bundle_hash,
            "operation_scoped_binding": operation_binding,
            "max_users": max(1, len(plan.get("selected_moves") or [])),
            "owner": "admin_core.operator_execution",
            "new_owner_created": False,
        }
        self._n10_execution_control_window = {
            "path": str(control_path),
            "generation": str(control.get("generation") or ""),
            "operation_id": operation_id,
        }
        return window

    def _switch_policy(self) -> dict[str, Any]:
        sw = merge_defaults((self.policy or {}).get("switch", {}), DEFAULT_SWITCH_POLICY)
        sw.update((self.org_policy or {}).get("switch", {}))
        if self.args.mode:
            sw["autoswitch_mode"] = self.args.mode
        return sw

    def _authority_budget_policy(self) -> dict[str, Any]:
        policy = merge_defaults((self.policy or {}).get("authority_budget", {}), DEFAULT_AUTHORITY_BUDGET_POLICY)
        policy.update((self.org_policy or {}).get("authority_budget", {}))
        prepared_class = normalize_authority_class(policy.get("authority_class"))
        certified_class = normalize_authority_class(
            policy.get("certified_authority_class")
            or policy.get("certified_authority")
            or "CANARY"
        )
        requested_state = normalize_authority_lifecycle_state(policy.get("authority_lifecycle_state"))
        requested_state = AUTHORITY_CERTIFIED_STATE_ALIASES.get(requested_state, requested_state)
        standing_policy_contract = (self.policy or {}).get("delegated_autonomy_policy")
        standing_policy_contract = standing_policy_contract if isinstance(standing_policy_contract, dict) else {}
        lineage_read_started_ns = time.monotonic_ns()
        lineage_reused_at_entry = (
            self._standing_policy_audit_records_cache is not None
        )
        authority_audit_records = self._standing_policy_audit_records()
        self._record_performance_span(
            "policy_authority_lineage_record_reuse",
            lineage_read_started_ns,
            owner="existing operator-execution append-only lineage owner",
            status=(
                "REUSED_CURRENT_MATRIX_LINEAGE"
                if lineage_reused_at_entry
                else "FRESH_OWNER_READ"
            ),
            details={
                "records_reused_from_matrix": bool(
                    lineage_reused_at_entry
                ),
                "record_count": len(authority_audit_records),
                "handoff": copy.deepcopy(
                    self._standing_policy_lineage_reuse_diagnostic
                ),
            },
        )
        action_contract_started_ns = time.monotonic_ns()
        action_contract = runtime_authority_contract_status(
            policy,
            prepared_class=prepared_class,
            certified_class=certified_class,
            standing_policy_contract=standing_policy_contract,
            authority_audit_records=authority_audit_records,
        )
        self._record_performance_span(
            "policy_authority_contract_evaluation",
            action_contract_started_ns,
            owner="existing Authority contract validator",
            details={
                "action_contract_required": bool(action_contract.get("required")),
                "action_contract_valid": bool(action_contract.get("valid")),
            },
        )
        effective_budget_started_ns = time.monotonic_ns()
        frozen = bool_value(policy.get("frozen") or policy.get("authority_frozen"))
        revoked = bool_value(policy.get("revoked") or policy.get("authority_revoked"))
        if revoked:
            lifecycle_state = "REVOKED"
        elif frozen:
            lifecycle_state = "FROZEN"
        elif not action_contract["valid"]:
            lifecycle_state = "FROZEN"
        elif requested_state in AUTHORITY_BRIDGE_STATES:
            lifecycle_state = requested_state
        elif requested_state in {"DEMOTED", "FROZEN", "REVOKED"}:
            lifecycle_state = requested_state
        elif AUTHORITY_CLASS_RANK[prepared_class] > AUTHORITY_CLASS_RANK[certified_class]:
            lifecycle_state = "PREPARED"
        elif AUTHORITY_CLASS_RANK[prepared_class] < AUTHORITY_CLASS_RANK[certified_class]:
            lifecycle_state = "DEMOTED"
        elif requested_state == "PROMOTED":
            lifecycle_state = "PROMOTED"
        else:
            lifecycle_state = "CERTIFIED"
        runtime_class = min_authority_class(prepared_class, certified_class)
        if lifecycle_state in {"FROZEN", "REVOKED"}:
            runtime_class = "CANARY"
        prepared_budget = authority_class_budget(prepared_class, to_int(policy.get("current_allowed_user_budget"), 1))
        certified_budget = authority_class_budget(certified_class, to_int(policy.get("current_allowed_user_budget"), 1))
        next_class_for_certified = AUTHORITY_CLASS_NEXT.get(certified_class, certified_class)
        bridge_budget_ceiling = 0
        if (
            lifecycle_state in AUTHORITY_BRIDGE_STATES
            and AUTHORITY_CLASS_RANK[prepared_class] == AUTHORITY_CLASS_RANK[certified_class] + 1
            and prepared_class == next_class_for_certified
        ):
            bridge_budget_ceiling = min(prepared_budget, authority_class_budget(next_class_for_certified, prepared_budget))
        runtime_ceiling = 0 if lifecycle_state in {"FROZEN", "REVOKED"} else authority_class_budget(runtime_class, to_int(policy.get("current_allowed_user_budget"), 1))
        if bridge_budget_ceiling:
            runtime_ceiling = bridge_budget_ceiling
        requested_budget = to_int(policy.get("current_allowed_user_budget"), prepared_budget)
        certification_ceiling = bridge_budget_ceiling or certified_budget
        current_budget = max(0, min(requested_budget, prepared_budget, certification_ceiling, runtime_ceiling))
        if action_contract["required"]:
            current_budget = min(current_budget, action_contract["max_users"]) if action_contract["valid"] else 0
        next_class = AUTHORITY_CLASS_NEXT.get(runtime_class, "CANARY")
        next_budget_default = authority_class_budget(next_class, current_budget)
        policy["prepared_authority_class"] = prepared_class
        policy["certified_authority_class"] = certified_class
        policy["authority_lifecycle_state"] = lifecycle_state
        policy["authority_class"] = runtime_class
        policy["current_allowed_user_budget"] = current_budget
        policy["next_authority_class"] = next_class
        policy["next_allowed_user_budget"] = max(
            current_budget,
            min(to_int(policy.get("next_allowed_user_budget"), next_budget_default), next_budget_default),
        )
        policy["truth_source"] = "existing_policy_files"
        policy["current_action_class_contract"] = action_contract
        policy["runtime_calculation_mode"] = (
            "current_action_class_contract_bounded_authority"
            if action_contract["required"] else
            "certified_authority_with_transitional_bridge"
            if bridge_budget_ceiling
            else "prepared_and_certified_min_authority"
        )
        policy["authority_bridge"] = {
            "schema_version": "v7.authority-transition-bridge.v1",
            "enabled": bool(bridge_budget_ceiling),
            "state": lifecycle_state if lifecycle_state in AUTHORITY_BRIDGE_STATES else "",
            "from_certified_authority": certified_class,
            "to_prepared_authority": prepared_class,
            "bridge_budget_ceiling": bridge_budget_ceiling,
            "promotion_certification": False,
            "truth_source": "existing_policy_files",
            "new_truth_sources_created": False,
            "duplicate_systems_created": False,
        }
        self._record_performance_span(
            "policy_authority_effective_budget_projection",
            effective_budget_started_ns,
            owner="existing Authority budget projection",
            details={
                "runtime_authority_class": runtime_class,
                "current_allowed_user_budget": current_budget,
            },
        )
        return policy

    def _emergency_failover_policy(self) -> dict[str, Any]:
        policy = merge_defaults(
            (self.policy or {}).get("emergency_failover_autonomy", {}),
            DEFAULT_EMERGENCY_FAILOVER_AUTONOMY_POLICY,
        )
        policy.update((self.org_policy or {}).get("emergency_failover_autonomy", {}))
        if bool_value(getattr(self.args, "emergency_failover_autonomy", False)):
            policy["enabled"] = True
        standing_contract = (self.policy or {}).get("delegated_autonomy_policy")
        standing_validation = operator_execution.validate_standing_delegated_operational_policy(
            standing_contract if isinstance(standing_contract, dict) else {},
            audit_records=self._standing_policy_audit_records(),
        )
        standing_scope = standing_validation.get("policy") if isinstance(standing_validation.get("policy"), dict) else {}
        standing_max_users = max(0, to_int(standing_scope.get("max_users_per_action"), 0))
        if standing_validation.get("ok") and standing_max_users in operator_execution.SERVICE_FAILURE_DELEGATED_ACTION_CLASSES:
            runtime_axes = operator_execution.standing_delegated_policy_runtime_axes(
                standing_validation.get("contract") or standing_contract
            )
            # Authority owns the maximum possible budget, while evidence and
            # the exact execution context own the Runtime budget.  An
            # unscoped legacy Tier-48 contract must not expose ordinary users
            # above the currently proven ordinary-production floor.  The
            # controlled ceiling is selected later only after every member is
            # independently proven to be a certification identity on a
            # controlled source.
            policy["max_users_per_run"] = int(runtime_axes["ordinary_production_runtime_max"])
            policy["max_users_per_channel"] = int(runtime_axes["ordinary_production_runtime_max"])
            policy["standing_policy_budget_owner"] = operator_execution.CURRENT_ACTION_CLASS_CONTRACT_ISSUING_OWNER
            policy["runtime_scope_axes"] = runtime_axes
        return policy

    def _load_l3_runtime_state(self) -> dict[str, Any]:
        state = read_json(self.l3_runtime_state_file, {})
        if not isinstance(state, dict):
            state = {}
        state.setdefault("schema_version", "v7.l3-runtime-state.v1")
        state.setdefault("incidents", {})
        state.setdefault("processed_event_ids", [])
        state.setdefault("passive_event_consumptions", {})
        state.setdefault("service_failure_automation_obligations", {})
        state.setdefault("bounded_cohort_transactions", {})
        state.setdefault("capability", {})
        state.setdefault("updated", "")
        return state

    @staticmethod
    def _runtime_file_identity(path: Path) -> tuple[int, int, int, int, int]:
        """Return a mutation-sensitive identity for an already loaded file.

        A governed Packet and its apply revalidation execute in one process.
        Re-parsing the multi-megabyte canonical L3 projection adds no new
        evidence when its inode, size, mtime and ctime are all unchanged.
        Any replacement or write changes this tuple and retains the existing
        full reload/fail-closed behavior.  The file remains the sole owner;
        this creates no persisted cache or secondary truth source.
        """
        try:
            stat = Path(path).stat()
        except OSError:
            return (0, 0, 0, 0, 0)
        return (
            int(stat.st_dev),
            int(stat.st_ino),
            int(stat.st_size),
            int(stat.st_mtime_ns),
            int(stat.st_ctime_ns),
        )

    def _write_l3_runtime_state(self, state: dict[str, Any]) -> None:
        state = self._compact_l3_runtime_state_projection(state)
        state["schema_version"] = "v7.l3-runtime-state.v1"
        state["updated"] = now_iso()
        processed = [str(item) for item in (state.get("processed_event_ids") or []) if str(item)]
        state["processed_event_ids"] = processed[-500:]
        write_json_atomic(self.l3_runtime_state_file, state)
        self.l3_runtime_state = state
        self._l3_runtime_state_file_identity = (
            self._runtime_file_identity(self.l3_runtime_state_file)
        )

    @staticmethod
    def _compact_l3_runtime_state_projection(
        state: dict[str, Any],
    ) -> dict[str, Any]:
        """Bound the current L3 projection without deleting durable history.

        ``l3-runtime-state.json`` is the current incident/continuation owner,
        not the historical evidence ledger.  Passive closures, automation
        obligations, OMP receipts and execution outcomes already live in the
        append-only closure/audit owners.  Retaining every derived projection
        here made each failure transaction repeatedly parse and rewrite many
        megabytes of terminal history.

        Keep every actionable passive incident and unfinished cohort, plus a
        bounded recent diagnostic window.  For automation obligations keep
        the newest projection for each source incident and a bounded recent
        window; their immutable full records remain in closure-records.jsonl.
        This changes neither an incident identity nor its authority and never
        infers terminality from age.
        """
        if not isinstance(state, dict):
            return {}

        # The write owner already receives a mutable projection and replaces
        # it atomically below.  Mutate that in-memory object directly; copying
        # the entire historical payload would recreate the very latency and
        # memory pressure this compaction removes.
        compacted = state

        def row_ts(row: dict[str, Any]) -> float:
            return max(
                parse_ts(row.get(field))
                for field in (
                    "updated_at", "updated", "last_observed_at",
                    "closed_at", "opened_at", "created_at",
                )
            )

        incidents = (
            compacted.get("incidents")
            if isinstance(compacted.get("incidents"), dict)
            else {}
        )
        actionable_incidents: dict[str, Any] = {}
        terminal_passive: list[tuple[str, dict[str, Any]]] = []
        emergency_history: list[tuple[str, dict[str, Any]]] = []
        other_history: list[tuple[str, dict[str, Any]]] = []
        for key, raw in incidents.items():
            if not isinstance(raw, dict):
                continue
            authority = str(raw.get("authority_object") or "")
            incident_state = str(raw.get("incident_state") or "")
            if (
                authority == "PASSIVE_SERVICE_FAILURE_CAPTURE"
                and incident_state != "INTENT_CLOSED"
            ):
                actionable_incidents[str(key)] = raw
            elif authority == "PASSIVE_SERVICE_FAILURE_CAPTURE":
                terminal_passive.append((str(key), raw))
            elif authority == "EMERGENCY_FAILOVER_AUTONOMY":
                emergency_history.append((str(key), raw))
            else:
                other_history.append((str(key), raw))

        def keep_recent(
            rows: list[tuple[str, dict[str, Any]]], limit: int,
        ) -> dict[str, dict[str, Any]]:
            ordered = sorted(
                rows,
                key=lambda item: (row_ts(item[1]), item[0]),
                reverse=True,
            )
            return {key: row for key, row in ordered[:limit]}

        retained_incidents = {
            **keep_recent(other_history, 32),
            **keep_recent(terminal_passive, 64),
            **keep_recent(emergency_history, 128),
            **actionable_incidents,
        }
        compacted["incidents"] = retained_incidents

        obligations = (
            compacted.get("service_failure_automation_obligations")
            if isinstance(
                compacted.get("service_failure_automation_obligations"), dict,
            )
            else {}
        )
        newest_by_incident: dict[str, tuple[str, dict[str, Any]]] = {}
        obligation_rows: list[tuple[str, dict[str, Any]]] = []
        for key, raw in obligations.items():
            if not isinstance(raw, dict):
                continue
            key = str(key)
            obligation_rows.append((key, raw))
            source_incident_id = str(raw.get("source_incident_id") or "")
            if not source_incident_id:
                continue
            prior = newest_by_incident.get(source_incident_id)
            if prior is None or (row_ts(raw), key) > (
                row_ts(prior[1]), prior[0],
            ):
                newest_by_incident[source_incident_id] = (key, raw)
        retained_obligations = keep_recent(obligation_rows, 128)
        retained_obligations.update({
            key: raw for key, raw in newest_by_incident.values()
        })
        compacted["service_failure_automation_obligations"] = (
            retained_obligations
        )

        transactions = (
            compacted.get("bounded_cohort_transactions")
            if isinstance(compacted.get("bounded_cohort_transactions"), dict)
            else {}
        )
        unfinished_transactions: dict[str, dict[str, Any]] = {}
        terminal_transactions: list[tuple[str, dict[str, Any]]] = []
        for key, raw in transactions.items():
            if not isinstance(raw, dict):
                continue
            if str(raw.get("state") or "") == "IN_PROGRESS" or str(
                raw.get("closure_obligation_state") or ""
            ) not in {
                "CONSUMED_BY_EXISTING_CLOSURE_OWNER",
                "CLOSED_BY_EXISTING_OUTCOME_OWNER",
            }:
                unfinished_transactions[str(key)] = raw
            else:
                terminal_transactions.append((str(key), raw))
        retained_transactions = keep_recent(terminal_transactions, 32)
        retained_transactions.update(unfinished_transactions)
        compacted["bounded_cohort_transactions"] = retained_transactions

        prior_meta = (
            compacted.get("projection_compaction")
            if isinstance(compacted.get("projection_compaction"), dict)
            else {}
        )
        compacted["projection_compaction"] = {
            "schema_version": "v7.l3-runtime-projection-compaction.v1",
            "owner": "tools/v7-users-autoswitch:l3-runtime-state",
            "compacted_at": now_iso(),
            "history_owners": [
                "closure-records.jsonl",
                "operator-execution-audit.jsonl",
                "execution-events.jsonl",
            ],
            "incidents_before": len(incidents),
            "incidents_after": len(retained_incidents),
            "obligations_before": len(obligations),
            "obligations_after": len(retained_obligations),
            "bounded_transactions_before": len(transactions),
            "bounded_transactions_after": len(retained_transactions),
            "actionable_incidents_preserved": len(actionable_incidents),
            "unfinished_transactions_preserved": len(
                unfinished_transactions
            ),
            "total_compactions": to_int(
                prior_meta.get("total_compactions"), 0,
            ) + 1,
            "routing_mutation_performed": False,
            "users_moved": 0,
            "authority_changed": False,
        }
        return compacted

    def _bounded_cohort_checkpoint(
        self,
        plan: dict[str, Any],
        selected_moves: list[dict[str, Any]],
        *,
        results: Optional[list[dict[str, Any]]] = None,
        terminal_state: str = "IN_PROGRESS",
        terminal_reason: str = "",
    ) -> dict[str, Any]:
        """Persist compact per-member progress in the existing L3 state owner."""
        operation = plan.get("operation") if isinstance(plan.get("operation"), dict) else {}
        safety = plan.get("safety") if isinstance(plan.get("safety"), dict) else {}
        barrier = safety.get("restore_barrier") if isinstance(safety.get("restore_barrier"), dict) else {}
        approved_lock = barrier.get("approved_plan_lock") if isinstance(barrier.get("approved_plan_lock"), dict) else {}
        operation_id = str(operation.get("operation_id") or "")
        selected_hash = str(operation.get("selected_move_hash") or "")
        members = [{
            "user_ip": str(row.get("user_ip") or ""),
            "source": str(row.get("current_egress") or ""),
            "target": str(row.get("recommended_egress") or ""),
            "index": index,
        } for index, row in enumerate(selected_moves)]
        cohort_fingerprint = sha256_json({"members": members})
        state = self._load_l3_runtime_state()
        transactions = state.setdefault("bounded_cohort_transactions", {})
        existing = transactions.get(operation_id)
        existing = existing if isinstance(existing, dict) else {}
        if existing and (
            str(existing.get("selected_move_hash") or "") != selected_hash
            or str(existing.get("cohort_fingerprint") or "") != cohort_fingerprint
        ):
            return {
                "ok": False,
                "status": "STOP_SAFE",
                "reason": "bounded_cohort_checkpoint_identity_mismatch",
                "checkpoint": existing,
            }
        result_rows = list(results or [])
        subreceipts = [{
            "index": int(row.get("selected_move_index") or index),
            "user_ip": str(row.get("user_ip") or ""),
            "source": str(row.get("from") or ""),
            "target": str(row.get("to") or ""),
            "apply_rc": row.get("rc"),
            "verify_rc": row.get("verify_rc"),
            "service_verify_rc": row.get("service_verify_rc"),
            "rollback_rc": row.get("rollback_rc"),
            "terminal": str(row.get("terminal_outcome_classification") or ""),
        } for index, row in enumerate(result_rows)]
        attempted = {str(row.get("user_ip") or "") for row in result_rows}
        successful = {
            str(row.get("user_ip") or "")
            for row in result_rows
            if str(row.get("terminal_outcome_classification") or "") == "SUCCESS"
        }
        failed = sorted(attempted - successful)
        unapplied = [
            row["user_ip"] for row in members
            if row["user_ip"] not in attempted
        ]
        checkpoint = {
            "schema_version": "v7.bounded-cohort-transaction-checkpoint.v1",
            "owner": "tools/v7-users-autoswitch:l3-runtime-state",
            "operation_id": operation_id,
            "packet_id": str(
                barrier.get("packet_id")
                or approved_lock.get("packet_id")
                or approved_lock.get("approved_packet_id")
                or ""
            ),
            "selected_move_hash": selected_hash,
            "cohort_fingerprint": cohort_fingerprint,
            "member_count": len(members),
            "members": members,
            "subreceipts": subreceipts,
            "applied_successfully": sorted(successful),
            "failed_or_contained": failed,
            "unapplied": unapplied,
            "next_member_index": len(result_rows),
            "state": terminal_state,
            "terminal_reason": terminal_reason,
            "packet_reuse_for_new_transaction": "FORBIDDEN",
            "restart_semantics": "RESUME_CAUSAL_CLOSURE_FROM_CHECKPOINT_NO_DUPLICATE_FORWARD_APPLY",
            "closure_obligation_id": "bcclose_" + sha256_json({
                "operation_id": operation_id,
                "selected_move_hash": selected_hash,
                "cohort_fingerprint": cohort_fingerprint,
            })[:24],
            "closure_obligation_state": "PENDING_EXISTING_OWNER_CONSUMPTION",
            "next_required_consumer": "tools/v7-users-autoswitch.reconcile_bounded_cohort_closure_obligations",
            "reentry_condition": "NEXT_MATRIX_OR_AUTOSWITCH_REENTRY",
            "durable_successor_published": True,
            "updated_at": now_iso(),
        }
        transactions[operation_id] = checkpoint
        # This compact checkpoint belongs to the existing L3 state owner.  It
        # is not a second execution registry.
        self._write_l3_runtime_state(state)
        return {"ok": True, "status": terminal_state, "checkpoint": checkpoint}

    def reconcile_bounded_cohort_closure_obligations(self) -> dict[str, Any]:
        """Publish checkpoint-backed closure work through existing owners.

        This is crash recovery for the gap between a route-generation commit
        and the heavier Outcome/Learning closure.  It never resumes forward
        mutation or infers success; the normal execution/outcome reconciler
        remains responsible for current route and verification truth.
        """
        state = self._load_l3_runtime_state()
        transactions = state.get("bounded_cohort_transactions")
        transactions = transactions if isinstance(transactions, dict) else {}
        closure_path = self.state_dir / "closure-records.jsonl"
        existing = {
            str(row.get("object_id") or "")
            for row in read_jsonl(closure_path)
            if str(row.get("object_type") or "") == "bounded_cohort_closure_obligation"
        }
        rows: list[dict[str, Any]] = []
        state_changed = False
        now = now_iso()
        for operation_id, checkpoint in sorted(transactions.items()):
            if not isinstance(checkpoint, dict):
                continue
            obligation_id = str(checkpoint.get("closure_obligation_id") or "")
            if not obligation_id:
                obligation_id = "bcclose_" + sha256_json({
                    "operation_id": str(operation_id),
                    "selected_move_hash": str(checkpoint.get("selected_move_hash") or ""),
                    "cohort_fingerprint": str(checkpoint.get("cohort_fingerprint") or ""),
                })[:24]
            if obligation_id not in existing:
                rows.append({
                    "schema_version": "v7.bounded-cohort-closure-obligation.v1",
                    "object_type": "bounded_cohort_closure_obligation",
                    "object_id": obligation_id,
                    "created_at": now,
                    "operation_id": str(operation_id),
                    "packet_id": str(checkpoint.get("packet_id") or ""),
                    "selected_move_hash": str(checkpoint.get("selected_move_hash") or ""),
                    "cohort_fingerprint": str(checkpoint.get("cohort_fingerprint") or ""),
                    "checkpoint_state": str(checkpoint.get("state") or "UNKNOWN"),
                    "last_terminal_reason": str(checkpoint.get("terminal_reason") or ""),
                    "subreceipt_count": len(checkpoint.get("subreceipts") or []),
                    "raw_member_list_stored": False,
                    "closure_state": "READY_FOR_EXISTING_OUTCOME_RECONCILIATION",
                    "next_required_consumer": "tools/v7-users-autoswitch.reconcile_service_failure_execution_outcomes",
                    "reentry_condition": "NEXT_MATRIX_OR_AUTOSWITCH_REENTRY",
                    "forward_apply_allowed": False,
                    "packet_reuse_allowed": False,
                    "runtime_mutation_performed": False,
                    "routing_mutation_performed": False,
                    "users_moved_by_reconciliation": 0,
                })
            desired = {
                "closure_obligation_id": obligation_id,
                "closure_obligation_state": "CONSUMED_BY_EXISTING_CLOSURE_OWNER",
                "next_required_consumer": "tools/v7-users-autoswitch.reconcile_service_failure_execution_outcomes",
                "reentry_condition": "NEXT_MATRIX_OR_AUTOSWITCH_REENTRY",
                "durable_successor_published": True,
            }
            if any(checkpoint.get(key) != value for key, value in desired.items()):
                checkpoint.update(desired)
                state_changed = True
        if rows:
            append_jsonl(closure_path, rows)
        if state_changed:
            self._write_l3_runtime_state(state)
        return {
            "schema_version": "v7.bounded-cohort-closure-obligation-reconciliation.v1",
            "status": "DEFERRED_CLOSURE_DURABLE_SUCCESSOR_PROVEN" if transactions else "NO_BOUNDED_COHORT_CHECKPOINT",
            "checkpoint_count": len(transactions),
            "closure_obligations_published": len(rows),
            "next_required_consumer": "tools/v7-users-autoswitch.reconcile_service_failure_execution_outcomes" if transactions else "",
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
        }

    def _passive_incident_projection_key(self, source_incident_id: str) -> str:
        """Return the deterministic key inside the existing L3 incident owner.

        Passive service failures used to have an immutable closure and an OMP
        receipt, but no compact current-state representation.  The key stays
        in `l3-runtime-state.json:incidents`; it is not a second registry.
        """
        return "passive_" + sha256_json({
            "owner": "tools/v7-users-autoswitch.passive-causal-projection",
            "source_incident_id": str(source_incident_id or ""),
        })[:24]

    def _materialize_passive_incident_projection(
        self,
        state: dict[str, Any],
        closure: dict[str, Any],
        *,
        terminal: str,
        recovery_observed: bool = False,
        expiry_observed: bool = False,
    ) -> dict[str, Any]:
        """Project one passive terminal into the existing compact L3 state.

        This is deliberately a state projection, not an execution attempt. It
        retains identities/pointers and a count-plus-fingerprint scope only;
        raw user lists remain in their producer-owned immutable evidence.
        """
        source_incident_id = str(closure.get("source_incident_id") or closure.get("object_id") or "")
        if not source_incident_id:
            return {"projected": False, "reason": "source_incident_id_missing"}
        incidents = state.setdefault("incidents", {})
        if not isinstance(incidents, dict):
            incidents = {}
            state["incidents"] = incidents
        incident_key = self._passive_incident_projection_key(source_incident_id)
        existing = incidents.get(incident_key) if isinstance(incidents.get(incident_key), dict) else {}
        source_event_ids = sorted({
            str(item) for item in (closure.get("source_event_ids") or []) if str(item)
        })
        if not source_event_ids and str(closure.get("event_id") or ""):
            source_event_ids = [str(closure.get("event_id") or "")]
        source_hashes = closure.get("source_hashes") if isinstance(closure.get("source_hashes"), dict) else {}
        affected_users = [str(item) for item in (closure.get("affected_users") or []) if str(item)]
        source_scope = closure.get("source_scope") if isinstance(closure.get("source_scope"), dict) else {}
        # The Matrix owns one source observation, but ordinary protection and
        # controlled certification have non-interchangeable subjects.  Reuse
        # its compact partition rather than treating certification identities
        # as ordinary customers or storing a second membership registry.
        ordinary_source_scope = (
            source_scope.get("ordinary_production_scope")
            if isinstance(source_scope.get("ordinary_production_scope"), dict)
            else source_scope
        )
        scope_classification = str(
            source_scope.get("scope_classification") or "LEGACY_UNPARTITIONED"
        )
        controlled_certification_scope = (
            source_scope.get("controlled_certification_scope")
            if isinstance(source_scope.get("controlled_certification_scope"), dict)
            else {}
        )
        source_scope_count = to_int(ordinary_source_scope.get("affected_scope_count"), -1)
        source_scope_fingerprint = str(ordinary_source_scope.get("affected_scope_fingerprint") or "")
        # ``scope_accounting`` is the historical compatibility name for the
        # current-source denominator.  Keep it while exposing the semantic
        # name below: historical packet success must never be mistaken for
        # membership in this live source generation.
        #
        # A continuing incident may legitimately receive a newer Matrix
        # observation after a bounded action.  Its source scope is the next
        # live denominator, not a contradiction with the older denominator.
        # Preserve every previous Outcome in the cumulative projection, but
        # advance the compact current-source projection only from a strictly
        # newer owner-backed source snapshot.  This prevents a stale event
        # from silently shrinking scope while allowing current accounting to
        # remain balanced after a verified action.
        existing_scope = (
            existing.get("current_source_scope")
            if isinstance(existing.get("current_source_scope"), dict)
            else (existing.get("scope_accounting") if isinstance(existing.get("scope_accounting"), dict) else {})
        )
        prior_scope_observed_at = str(existing_scope.get("baseline_observed_at") or "")
        incoming_scope_observed_at = str(source_scope.get("observed_at") or closure.get("observed_at") or "")
        scope_changed = (
            to_int(existing_scope.get("affected_scope_count"), -1) != source_scope_count
            or str(existing_scope.get("affected_scope_fingerprint") or "") != source_scope_fingerprint
        )
        scope_rotation = bool(
            existing_scope
            and scope_changed
            and parse_ts(incoming_scope_observed_at) > parse_ts(prior_scope_observed_at)
        )
        # A legacy compact projection can retain a valid current Matrix
        # fingerprint but omit the accounting partition fields.  A strictly
        # newer snapshot from the existing Matrix owner is enough to rebuild
        # that denominator through this L3 owner; it does not infer members,
        # reuse historical Packet outcomes, or authorize execution.  Treat it
        # as a one-time repair generation even when the live fingerprint did
        # not change, so the existing outcome reconciler can classify prior
        # feedback against the restored denominator.
        # A prior projection can have the correct ordinary fingerprint but
        # have lost the Matrix partition metadata.  In that shape a later
        # route reconciliation sees certification members as ordinary and
        # permanently produces an unbalanced denominator.  The current
        # Matrix event already owns the partition; reuse it once for this
        # broken compact projection even when its observation timestamp is
        # equal to the stored baseline.  This is still reconciliation only:
        # it neither creates an execution object nor authorizes a move.
        partition_metadata_missing = bool(
            scope_classification != "LEGACY_UNPARTITIONED"
            and (
                str(existing_scope.get("scope_classification") or "")
                != scope_classification
                or to_int(
                    existing_scope.get("controlled_certification_scope_count"),
                    -1,
                )
                != max(
                    0,
                    to_int(
                        controlled_certification_scope.get("affected_scope_count"),
                        0,
                    ),
                )
            )
        )
        scope_repair = bool(
            existing_scope
            and str(existing_scope.get("status") or "")
            == "INCIDENT_SCOPE_ACCOUNTING_BROKEN"
            and (
                parse_ts(incoming_scope_observed_at)
                > parse_ts(prior_scope_observed_at)
                or partition_metadata_missing
            )
        )
        if source_scope_count >= 0 and source_scope_fingerprint and (
            not existing_scope or scope_rotation or scope_repair
        ):
            scope_accounting = {
                "schema_version": "v7.service-failure-incident-scope-accounting.v2",
                "status": "ACCOUNTED",
                # ``closure.event_id`` can be the compact incident group id.
                # The baseline must point to the producer event that supplied
                # the immutable scope snapshot, not to that derived group.
                "baseline_event_id": str(source_event_ids[0] if source_event_ids else closure.get("event_id") or ""),
                "baseline_observed_at": str(source_scope.get("observed_at") or closure.get("observed_at") or ""),
                "affected_scope_count": source_scope_count,
                "affected_scope_fingerprint": source_scope_fingerprint,
                "protected_scope_count": 0,
                "protected_scope_fingerprint": sha256_json({"incident": source_incident_id, "users": []}),
                "unresolved_scope_count": source_scope_count,
                "unresolved_scope_fingerprint": source_scope_fingerprint,
                "explicitly_excluded_or_recovered_scope_count": 0,
                "accounted_scope_count": source_scope_count,
                "live_registry_available": True,
                "raw_user_list_stored": False,
                "scope_classification": scope_classification,
                "controlled_certification_scope_count": max(
                    0, to_int(
                        controlled_certification_scope.get("affected_scope_count"),
                        0,
                    ),
                ),
                "controlled_certification_scope_fingerprint": str(
                    controlled_certification_scope.get("affected_scope_fingerprint") or ""
                ),
                "ordinary_customer_reclassification_allowed": False,
                "scope_generation": str(source_event_ids[0] if source_event_ids else closure.get("event_id") or ""),
                "supersedes_prior_scope_generation": ({
                    "affected_scope_count": to_int(existing_scope.get("affected_scope_count"), -1),
                    "affected_scope_fingerprint": str(existing_scope.get("affected_scope_fingerprint") or ""),
                    "baseline_event_id": str(existing_scope.get("baseline_event_id") or ""),
                    "rotation_reason": (
                        "LIVE_ROUTE_SCOPE_NO_LONGER_RECONCILABLE_WITH_LEGACY_GENERATION"
                        if str(existing_scope.get("status") or "") == "INCIDENT_SCOPE_ACCOUNTING_BROKEN"
                        else "FRESHER_OWNER_BACKED_SOURCE_SCOPE_GENERATION"
                    ),
                } if (scope_rotation or scope_repair) else {}),
            }
        else:
            scope_accounting = existing_scope
        affected_count = to_int(scope_accounting.get("affected_scope_count"), len(affected_users))
        scope_fingerprint = sha256_json({
            "source_incident_id": source_incident_id,
            "source_event_ids": source_event_ids,
            "egress_identity_generation": str(closure.get("egress_identity_generation") or ""),
            "channel": str(closure.get("channel") or ""),
            "affected_users": sorted(affected_users),
        })
        incident_generation = str(closure.get("egress_identity_generation") or "") or (
            "pigen_" + sha256_json({
                "source_incident_id": source_incident_id,
                "source_event_ids": source_event_ids,
                "source_hashes": source_hashes,
            })[:24]
        )
        observation_generation = "pobs_" + sha256_json({
            "source_incident_id": source_incident_id,
            "source_event_ids": source_event_ids,
            "source_hashes": source_hashes,
            "terminal": terminal,
        })[:24]
        transition_id = "ptr_" + sha256_json({
            "incident_key": incident_key,
            "observation_generation": observation_generation,
            "terminal": terminal,
        })[:24]
        parent_transition_id = (
            str(existing.get("parent_transition_id") or "")
            if str(existing.get("observation_generation") or "") == observation_generation
            else str(existing.get("transition_id") or "")
        )
        intent_closed = recovery_observed or expiry_observed
        closure_reason = (
            "RECOVERY_OBSERVED" if recovery_observed else
            "EPISODE_EXPIRED_NEW_GENERATION_REQUIRED" if expiry_observed else ""
        )
        next_consumer = "" if intent_closed else "tools/v7-users-autoswitch.materialize_service_failure_automation_advisory"
        reentry_condition = (
            "new owner-backed event starts the next generation"
            if intent_closed else
            "existing advisory materializes exactly one OMP obligation for this incident generation"
        )
        now = now_iso()
        desired = {
            **existing,
            "schema_version": "v7.l3-runtime-incident-record.v2",
            "incident_key": incident_key,
            "incident_id": source_incident_id,
            "incident_generation": incident_generation,
            "observation_generation": observation_generation,
            "parent_transition_id": parent_transition_id,
            "transition_id": transition_id,
            "status": "CLOSED" if intent_closed else "OPEN",
            "incident_state": "INTENT_CLOSED" if intent_closed else "OPEN",
            "channel_incident_state": "RECOVERED" if recovery_observed else ("EXPIRED" if expiry_observed else "OPEN"),
            "attempt_terminal": terminal,
            "attempt_id": "",
            "authority_object": "PASSIVE_SERVICE_FAILURE_CAPTURE",
            "opened_at": str(existing.get("opened_at") or now),
            "closed_at": str(existing.get("closed_at") or now) if intent_closed else "",
            "last_observed_at": str(
                closure.get("observed_at") or closure.get("created_at")
                or existing.get("last_observed_at") or now
            ),
            "channel": str(closure.get("channel") or ""),
            "services": sorted({str(item) for item in (closure.get("services") or []) if str(item)}),
            "failure_families": sorted({str(item) for item in (closure.get("failure_families") or []) if str(item)}),
            "event_provenance": str(closure.get("event_provenance") or "UNKNOWN"),
            "evidence_class": str(closure.get("evidence_class") or "UNKNOWN_EVENT"),
            "source_event_ids": source_event_ids,
            "source_hashes": source_hashes,
            "situation_id": str(closure.get("situation_id") or ""),
            "decision_trace_id": str(closure.get("decision_trace_id") or ""),
            "obligation_id": str(existing.get("obligation_id") or ""),
            "action_opportunity_id": "actionop_" + sha256_json({
                "incident_key": incident_key,
                "incident_generation": incident_generation,
            })[:24],
            "candidate_id": "",
            "packet_id": "",
            "lease_id": "",
            "outcome_id": str(closure.get("object_id") or source_incident_id),
            "learning_id": str(closure.get("learning_record_id") or ""),
            "intent_scope_type": "COHORT",
            "intent_scope_fingerprint": scope_fingerprint,
            "intent_closure_reason": closure_reason,
            "intent_closure_evidence_pointer": str(closure.get("object_id") or source_incident_id) if intent_closed else "",
            "cohort_protection_intent": {
                "state": "INTENT_CLOSED" if intent_closed else "UNRESOLVED",
                "scope_type": "COHORT",
                "scope_fingerprint": scope_fingerprint,
                "affected_users_count": affected_count,
            },
            "user_protection_intent": {
                "state": "INTENT_CLOSED" if intent_closed else "UNRESOLVED_COUNT_ONLY",
                "affected_users_count": affected_count,
                "scope_fingerprint": sha256_json({"incident_key": incident_key, "users": sorted(affected_users)}),
                "raw_user_list_stored": False,
            },
            "next_required_consumer": next_consumer,
            "reentry_condition": reentry_condition,
            "causal_lineage": {
                "source_incident_id": source_incident_id,
                "source_event_ids": source_event_ids,
                "situation_id": str(closure.get("situation_id") or ""),
                "decision_trace_id": str(closure.get("decision_trace_id") or ""),
                "outcome_id": str(closure.get("object_id") or source_incident_id),
                "learning_id": str(closure.get("learning_record_id") or ""),
                "parent_transition_id": parent_transition_id,
            },
            "scope_accounting": scope_accounting,
            "current_source_scope": scope_accounting,
            "incident_cumulative_scope": (
                existing.get("incident_cumulative_scope")
                if isinstance(existing.get("incident_cumulative_scope"), dict)
                else {
                    "schema_version": "v7.service-failure-incident-cumulative-scope.v1",
                    "status": "NO_PACKET_BOUND_LINEAGE_YET",
                    "source_incident_id": source_incident_id,
                    "raw_user_list_stored": False,
                    "lineage_pointers": [],
                }
            ),
            "affected_scope_count": affected_count,
            "affected_scope_fingerprint": str(scope_accounting.get("affected_scope_fingerprint") or scope_fingerprint),
            "protected_scope_count": to_int(scope_accounting.get("protected_scope_count"), 0),
            "protected_scope_fingerprint": str(scope_accounting.get("protected_scope_fingerprint") or ""),
            "unresolved_scope_count": to_int(scope_accounting.get("unresolved_scope_count"), affected_count),
            "unresolved_scope_fingerprint": str(scope_accounting.get("unresolved_scope_fingerprint") or ""),
            "causal_invariant": {
                "name": "OPEN_INCIDENT_REQUIRES_SUCCESSOR_AND_REENTRY",
                "valid": bool(intent_closed or (next_consumer and reentry_condition)),
            },
            "execution_performed": False,
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
            "apply_executed": False,
            "authority_expanded": False,
            "production_maturity_changed": False,
            "consumer": "tools/v7-users-autoswitch._consume_passive_production_events",
            "feeds_next_runtime_cycle": True,
        }
        comparable_existing = {key: value for key, value in existing.items() if key != "updated_at"}
        comparable_desired = {key: value for key, value in desired.items() if key != "updated_at"}
        changed = comparable_existing != comparable_desired
        if changed:
            desired["updated_at"] = now
            incidents[incident_key] = desired
        return {
            "projected": True,
            "changed": changed,
            "incident_key": incident_key,
            "record": desired if changed else existing,
        }

    def reconcile_passive_causal_projections(self) -> dict[str, Any]:
        """Backfill/verify compact passive projections through the same L3 owner.

        This is a bounded-scope repair entrypoint for existing immutable
        closures. It creates no event, Candidate, Packet, lease or execution.
        New passive events materialize the identical projection inline.
        """
        rows = [
            row for row in read_jsonl(self.state_dir / "closure-records.jsonl")
            if str(row.get("object_type") or "") == "passive_production_event"
        ]
        state = self._load_l3_runtime_state()
        # Historical closures remain append-only evidence.  The compact current
        # projection consumes only the latest terminal of each source incident;
        # replaying an older terminal before the current one would otherwise
        # rewrite the same state on every reconciliation.
        latest_by_source: dict[str, dict[str, Any]] = {}
        for closure in sorted(rows, key=lambda row: str(row.get("created_at") or row.get("observed_at") or "")):
            source_incident_id = str(closure.get("source_incident_id") or closure.get("object_id") or "")
            if source_incident_id:
                latest_by_source[source_incident_id] = closure
        changed = 0
        projected = 0
        for closure in latest_by_source.values():
            terminal = str(closure.get("terminal_outcome_classification") or "STOP_SAFE_NO_ACTION")
            result = self._materialize_passive_incident_projection(
                state,
                closure,
                terminal=terminal,
                recovery_observed=terminal == "RECOVERY_OBSERVED_NO_ACTION",
                expiry_observed=terminal == "EPISODE_EXPIRED_NO_ACTION",
            )
            projected += int(bool_value(result.get("projected")))
            changed += int(bool_value(result.get("changed")))
        incidents = state.get("incidents") if isinstance(state.get("incidents"), dict) else {}
        passive_records = [
            row for row in incidents.values()
            if isinstance(row, dict) and str(row.get("authority_object") or "") == "PASSIVE_SERVICE_FAILURE_CAPTURE"
        ]
        invalid_open = sum(
            1 for row in passive_records
            if str(row.get("incident_state") or "") != "INTENT_CLOSED"
            and (not str(row.get("next_required_consumer") or "") or not str(row.get("reentry_condition") or ""))
        )
        if changed:
            self._write_l3_runtime_state(state)
        return {
            "schema_version": "v7.passive-incident-causal-projection-reconciliation.v1",
            "active": bool(rows),
            "projected_records": projected,
            "changed_records": changed,
            "passive_incident_records": len(passive_records),
            "invalid_open_incidents": invalid_open,
            "final_verdict": "PASS" if invalid_open == 0 else "INVALID_OPEN_INCIDENT_NO_SUCCESSOR",
            "forbidden_effects": {
                "candidate_created": False,
                "packet_created": False,
                "lease_created": False,
                "runtime_apply": False,
                "routing_mutation": False,
                "user_movement": 0,
                "rollback_apply": False,
                "authority_change": False,
                "production_maturity_change": False,
            },
        }

    def _effective_service_failure_causal_binding(self, feedback_row: dict[str, Any]) -> dict[str, Any]:
        """Resolve a missing compact scope only from the immutable event owner.

        Earlier governed outcomes can contain a valid event identity but lack
        the compact source scope because the generic event projection dropped
        it.  Do not rewrite history and never infer membership from time or a
        current route: enrich the in-memory binding only when the exact
        producer event confirms the same incident/channel and a valid compact
        denominator.  New packets are rejected without that scope by the
        packet owner.
        """
        raw = feedback_row.get("service_failure_causal_binding")
        binding = dict(raw) if isinstance(raw, dict) else {}
        scope = binding.get("source_scope") if isinstance(binding.get("source_scope"), dict) else {}
        if scope:
            return binding
        event_id = str(binding.get("source_event_id") or "")
        incident_id = str(binding.get("source_incident_id") or "")
        channel = str(binding.get("source_channel") or "")
        if not event_id or not incident_id or not channel:
            return binding
        event_dir = getattr(self, "event_dir", self.state_dir.parent / "events")
        event_path = Path(event_dir) / "service-failure-events.jsonl"
        for event in reversed(
            read_service_failure_event_window(event_path, limit=2000)
        ):
            if str(event.get("event_id") or "") != event_id:
                continue
            event_scope = event.get("source_scope") if isinstance(event.get("source_scope"), dict) else {}
            if (
                str(event.get("source_incident_id") or "") != incident_id
                or str(event.get("channel") or event.get("object") or "") != channel
                or to_int(event_scope.get("affected_scope_count"), 0) <= 0
                or not str(event_scope.get("affected_scope_fingerprint") or "")
                or str(event_scope.get("source_channel") or "") != channel
                or bool_value(event_scope.get("raw_user_list_stored"))
            ):
                return binding
            binding["source_scope"] = dict(event_scope)
            binding["source_scope_resolution"] = "IMMUTABLE_EVENT_OWNER_BACKFILL"
            return binding
        return binding

    def _n10_product_operation_ids_from_authority_audit(self) -> set[str]:
        """Return only operations proven by the existing Authority audit as N10.

        Older N10 releases accidentally produced L3 feedback records before
        the finalizer learned that a governed product migration has its own
        closure owner.  The immutable records stay intact; this compact
        reader reconstructs their product identity from the existing
        request->consumption lineage so L3 never consumes them as emergency
        evidence.  Missing or malformed lineage deliberately remains L3
        evidence rather than being guessed away.
        """
        audit_store = Path(getattr(
            getattr(self, "args", argparse.Namespace()),
            "action_class_audit_store",
            str(operator_execution.DEFAULT_PRODUCTION_OPERATOR_EXECUTION_AUDIT_STORE),
        ))
        request_classes: dict[str, str] = {}
        for row in operator_execution.read_audit_records(audit_store):
            if str(row.get("record_type") or "") != "current_action_class_contract_request_emitted":
                continue
            request = row.get("request") if isinstance(row.get("request"), dict) else {}
            request_id = str(row.get("authority_request_id") or request.get("request_id") or "")
            action_class = str(request.get("action_class") or "").upper()
            if request_id and action_class in {
                operator_execution.N10_ORDINARY_LIKE_SINGLE_DEVICE_ACTION_CLASS,
                operator_execution.N10_SMALL_COHORT_ACTION_CLASS,
            }:
                request_classes[request_id] = action_class
        return {
            str(row.get("operation_id") or "")
            for row in operator_execution.read_audit_records(audit_store)
            if str(row.get("record_type") or "") == "current_action_class_contract_consumed"
            and str(row.get("authority_request_id") or "") in request_classes
            and str(row.get("operation_id") or "")
        }

    def _l3_feedback_rows_excluding_n10_products(self) -> dict[str, Any]:
        """Read L3 feedback while preserving exact historical N10 evidence.

        This is a read-model correction, not an append/delete path.  It makes
        the capability projection truthful without introducing another state
        owner or treating a route result as proof of product intent.
        """
        excluded_operations = self._n10_product_operation_ids_from_authority_audit()

        def retain(row: dict[str, Any]) -> bool:
            return str(row.get("operation_id") or "") not in excluded_operations

        execution_rows = [
            row for row in read_jsonl(self.state_dir / "execution-events.jsonl")
            if "execution-" in str(row.get("schema_version") or "") and retain(row)
        ]
        closure_rows = [
            row for row in read_jsonl(self.state_dir / "closure-records.jsonl")
            if "execution-feedback-closure" in str(row.get("schema_version") or "")
            and retain(row)
        ]
        return {
            "execution_rows": execution_rows,
            "closure_rows": closure_rows,
            "excluded_n10_product_operation_ids": sorted(excluded_operations),
            "excluded_n10_product_feedback_count": sum(
                1
                for row in read_jsonl(self.state_dir / "execution-events.jsonl")
                if "execution-" in str(row.get("schema_version") or "")
                and str(row.get("operation_id") or "") in excluded_operations
            ),
        }

    def _refresh_l3_capability_projection(self, state: dict[str, Any]) -> dict[str, Any]:
        """Repair the existing L3 read projection from its exact evidence."""
        feedback = self._l3_feedback_rows_excluding_n10_products()
        outcome_rows = [
            row for row in feedback["execution_rows"]
            if "execution-outcome" in str(row.get("schema_version") or "")
        ]
        success_count = sum(
            1 for row in outcome_rows
            if str(row.get("outcome_status") or "") == "success"
        )
        rollback_count = sum(
            1 for row in outcome_rows
            if str(row.get("outcome_status") or "") == "rollback_required"
        )
        failure_count = sum(
            1 for row in outcome_rows
            if str(row.get("outcome_status") or "") in {"failure", "no_execution"}
        )
        capability_state = "IMPLEMENTED"
        if outcome_rows:
            capability_state = "VALIDATED"
        if success_count or rollback_count:
            capability_state = "PRODUCTION_PROVEN"
        if success_count and feedback["closure_rows"]:
            capability_state = "CERTIFIED"
        if capability_state == "CERTIFIED" and bool_value(self.emergency_failover_policy.get("enabled")):
            capability_state = "ACTIVE_CAPABILITY"
        latest = outcome_rows[-1] if outcome_rows else {}
        capability = {
            "schema_version": "v7.l3-capability-state.v1",
            "capability": "L3_EMERGENCY_AUTONOMOUS_FAILOVER",
            "state": capability_state,
            "implemented": True,
            "validated": bool(outcome_rows),
            "production_proven": bool(success_count or rollback_count),
            "certified": bool(success_count and feedback["closure_rows"]),
            "active_capability": capability_state == "ACTIVE_CAPABILITY",
            "success_outcomes": success_count,
            "rollback_outcomes": rollback_count,
            "failure_or_no_execution_outcomes": failure_count,
            "closure_records": len(feedback["closure_rows"]),
            "last_operation_id": str(latest.get("operation_id") or ""),
            "last_incident_key": str(latest.get("l3_incident_key") or ""),
            "runtime_ready_for_next_incident": True,
            "omp_consumable": True,
        }
        previous = state.get("capability") if isinstance(state.get("capability"), dict) else {}
        semantic_previous = {key: value for key, value in previous.items() if key != "updated"}
        changed = semantic_previous != capability
        capability["updated"] = now_iso() if changed else str(previous.get("updated") or "")
        state["capability"] = capability
        return {**capability, "changed": changed, **feedback}

    def _reconcile_incident_scope_accounting(
        self,
        *,
        existing: dict[str, Any],
        execution_rows: list[dict[str, Any]],
        reconciliation_cache: Optional[dict[str, Any]] = None,
    ) -> dict[str, Any]:
        """Recompute one active incident denominator from live route truth.

        A packet outcome is not membership in a later source-scope generation.
        It can reduce that generation only when its immutable causal binding
        carries the exact same source, count and fingerprint snapshot.  A
        channel failure can have several service-specific incident IDs over
        one immutable source-scope cohort; an exact matching fingerprint is
        therefore the membership boundary, while the incident ID remains the
        producer identity of the individual service observation.  This avoids
        treating an old successful move as protection for users that were not
        in the current failed-source denominator.
        """
        existing_scope = existing.get("scope_accounting")
        if not isinstance(existing_scope, dict):
            return {}
        source_incident_id = str(existing.get("source_incident_id") or existing.get("incident_id") or "")
        source_channel = str(existing.get("channel") or existing.get("source_channel") or "")
        baseline_count = to_int(existing_scope.get("affected_scope_count"), -1)
        baseline_fingerprint = str(existing_scope.get("affected_scope_fingerprint") or "")
        baseline_event_id = str(existing_scope.get("baseline_event_id") or "")
        if not source_incident_id or not source_channel or baseline_count < 0 or not baseline_fingerprint:
            return {}

        if str(existing.get("incident_state") or "") == "INTENT_CLOSED":
            # A closed protection intent is a terminal historical scope, not a
            # live cohort.  Re-evaluating it against a later users.registry
            # generation can incorrectly reopen the old incident when a user
            # legitimately returns to the same channel.  Freeze the compact
            # denominator from its owner-backed terminal projection and keep
            # all later route truth for a new incident generation.
            existing_protected = max(
                0,
                min(
                    baseline_count,
                    to_int(
                        existing_scope.get(
                            "protected_scope_count",
                            existing.get("protected_scope_count"),
                        ),
                        0,
                    ),
                ),
            )
            terminal_excluded = baseline_count - existing_protected
            protected_pointers = sorted({
                str(item)
                for item in (
                    existing_scope.get("protected_scope_lineage_pointers")
                    or existing.get("protected_scope_lineage_pointers")
                    or []
                )
                if str(item)
            })
            closure_pointers = sorted({
                str(item)
                for item in (
                    existing_scope.get("explicitly_excluded_or_recovered_lineage_pointers")
                    or existing.get("explicitly_excluded_or_recovered_lineage_pointers")
                    or []
                )
                if str(item)
            })
            closure_evidence = str(existing.get("intent_closure_evidence_pointer") or "")
            if closure_evidence:
                closure_pointers = sorted(set(closure_pointers) | {closure_evidence})
            terminal_fingerprint_basis = {
                "incident": source_incident_id,
                "baseline_scope_fingerprint": baseline_fingerprint,
                "terminal_scope_frozen": True,
            }
            return {
                "schema_version": "v7.service-failure-incident-scope-accounting.v2",
                "status": "ACCOUNTED",
                "baseline_event_id": str(existing_scope.get("baseline_event_id") or ""),
                "baseline_observed_at": str(existing_scope.get("baseline_observed_at") or ""),
                "affected_scope_count": baseline_count,
                "affected_scope_fingerprint": baseline_fingerprint,
                "protected_scope_count": existing_protected,
                "protected_scope_fingerprint": sha256_json({
                    **terminal_fingerprint_basis,
                    "category": "protected",
                    "count": existing_protected,
                    "lineage_pointers": protected_pointers,
                }),
                "protected_scope_lineage_pointers": protected_pointers,
                "unresolved_scope_count": 0,
                "unresolved_scope_fingerprint": sha256_json({
                    **terminal_fingerprint_basis,
                    "category": "unresolved",
                    "count": 0,
                }),
                "unresolved_scope_route_truth_owner": "terminal_intent_closure",
                "explicitly_excluded_or_recovered_scope_count": terminal_excluded,
                "explicitly_excluded_or_recovered_scope_fingerprint": sha256_json({
                    **terminal_fingerprint_basis,
                    "category": "explicitly_excluded_or_recovered",
                    "count": terminal_excluded,
                    "lineage_pointers": closure_pointers,
                }),
                "explicitly_excluded_or_recovered_lineage_pointers": closure_pointers,
                "nonmember_or_stale_feedback_pointers": sorted({
                    str(item)
                    for item in existing_scope.get("nonmember_or_stale_feedback_pointers", [])
                    if str(item)
                }),
                "accounted_scope_count": baseline_count,
                "live_registry_available": (self.state_dir / "users.registry").exists(),
                "raw_user_list_stored": False,
                "scope_membership_law": "INTENT_CLOSED_TERMINAL_SCOPE_FROZEN",
                "terminal_scope_frozen": True,
            }

        if reconciliation_cache is not None and "live_registry_available" in reconciliation_cache:
            live_registry_available = bool(reconciliation_cache["live_registry_available"])
            live_rows = list(reconciliation_cache.get("live_rows") or [])
        else:
            live_registry_available = (self.state_dir / "users.registry").exists()
            live_rows = parse_registry(self.state_dir / "users.registry") if live_registry_available else []
            if reconciliation_cache is not None:
                reconciliation_cache["live_registry_available"] = live_registry_available
                reconciliation_cache["live_rows"] = live_rows
        live_current = {
            str(item.get("ip") or ""): str(item.get("current") or "")
            for item in live_rows
            if str(item.get("ip") or "") and (
                not str(item.get("enabled") or "") or bool_value(item.get("enabled"))
            )
        }
        live_certification_users = {
            str(item.get("ip") or "")
            for item in live_rows
            if str(item.get("ip") or "") and bool_value(item.get("certification_user"))
        }
        live_users_on_source = {
            user for user, current in live_current.items()
            if current == source_channel
        }
        live_ordinary_users_on_source = (
            live_users_on_source - live_certification_users
        )
        # Older immutable Matrix events predate scope partitioning.  They
        # correctly preserve their historical all-user denominator, but must
        # not keep an ordinary drain open after the live route owner proves
        # that its entire remaining cohort is now certification-only.  Do not
        # rewrite the event or call these identities protected: retain the
        # historical denominator and close only the ordinary protection intent
        # through the existing explicit-exclusion category.
        legacy_unpartitioned_scope = str(
            existing_scope.get("scope_classification") or ""
        ) in {"", "LEGACY_UNPARTITIONED"}
        preserved_protected = max(
            0,
            min(
                baseline_count,
                to_int(existing_scope.get("protected_scope_count"), 0),
            ),
        )
        preserved_protected_pointers = sorted({
            str(item)
            for item in (existing_scope.get("protected_scope_lineage_pointers") or [])
            if str(item)
        })
        certification_only_live_scope = bool(
            live_users_on_source
            and not live_ordinary_users_on_source
            and live_users_on_source.issubset(live_certification_users)
        )
        if legacy_unpartitioned_scope and certification_only_live_scope:
            exclusion_pointer = "controlled-certification-scope:" + sha256_json({
                "source_channel": source_channel,
                "baseline_scope_fingerprint": baseline_fingerprint,
                "certification_users": sorted(live_users_on_source),
            })[:24]
            terminal_basis = {
                "incident": source_incident_id,
                "baseline_scope_fingerprint": baseline_fingerprint,
                "classification": "CERTIFICATION_ONLY",
            }
            return {
                "schema_version": "v7.service-failure-incident-scope-accounting.v2",
                "status": "ACCOUNTED",
                "baseline_event_id": baseline_event_id,
                "baseline_observed_at": str(existing_scope.get("baseline_observed_at") or ""),
                "affected_scope_count": baseline_count,
                "affected_scope_fingerprint": baseline_fingerprint,
                "protected_scope_count": preserved_protected,
                "protected_scope_fingerprint": sha256_json({
                    **terminal_basis,
                    "category": "protected",
                    "count": preserved_protected,
                    "lineage_pointers": preserved_protected_pointers,
                }),
                "protected_scope_lineage_pointers": preserved_protected_pointers,
                "unresolved_scope_count": 0,
                "unresolved_scope_fingerprint": sha256_json({
                    **terminal_basis, "category": "unresolved", "count": 0,
                }),
                "unresolved_scope_route_truth_owner": "users.registry",
                "explicitly_excluded_or_recovered_scope_count": (
                    baseline_count - preserved_protected
                ),
                "explicitly_excluded_or_recovered_scope_fingerprint": sha256_json({
                    **terminal_basis,
                    "category": "controlled_certification_excluded",
                    "count": baseline_count - preserved_protected,
                    "lineage_pointer": exclusion_pointer,
                }),
                "explicitly_excluded_or_recovered_lineage_pointers": [
                    exclusion_pointer,
                ],
                "nonmember_or_stale_feedback_pointers": [],
                "accounted_scope_count": baseline_count,
                "live_registry_available": True,
                "raw_user_list_stored": False,
                "scope_classification": "CERTIFICATION_ONLY",
                "controlled_certification_scope_count": len(live_users_on_source),
                "controlled_certification_scope_fingerprint": sha256_json({
                    "source_channel": source_channel,
                    "users": sorted(live_users_on_source),
                }),
                "ordinary_customer_reclassification_allowed": False,
                "scope_membership_law": (
                    "LEGACY_ALL_ASSIGNED_SCOPE_RECONCILED_TO_"
                    "CONTROLLED_CERTIFICATION_EXCLUSION"
                ),
            }
        # The reservation is the only lawful way to account for an earlier
        # CT-M0F controlled certification move whose first implementation
        # omitted the passive-incident binding.  It is an explicit exclusion,
        # never a protected-user or evidence-credit rewrite.
        if reconciliation_cache is not None and "ct_m0f_reservations" in reconciliation_cache:
            ct_m0f_reservations = reconciliation_cache["ct_m0f_reservations"]
        else:
            audit_store = Path(getattr(
                getattr(self, "args", argparse.Namespace()),
                "action_class_audit_store",
                str(operator_execution.DEFAULT_PRODUCTION_OPERATOR_EXECUTION_AUDIT_STORE),
            ))
            ct_m0f_reservations = {
                str(row.get("packet_id") or ""): row
                for row in operator_execution.read_audit_records(audit_store)
                if str(row.get("record_type") or "")
                == operator_execution.CT_M0F_STANDING_VALIDATION_SAMPLE_RESERVATION_RECORD_TYPE
                and str(row.get("packet_id") or "")
            }
            if reconciliation_cache is not None:
                reconciliation_cache["ct_m0f_reservations"] = ct_m0f_reservations
        protected_users: set[str] = set()
        excluded_users: set[str] = set()
        protected_pointers: set[str] = set()
        excluded_pointers: set[str] = set()
        rejected_feedback_ids: set[str] = set()
        for feedback_row in execution_rows:
            binding = self._effective_service_failure_causal_binding(feedback_row)
            verification = feedback_row.get("verification_result")
            verification = verification if isinstance(verification, dict) else {}
            if str(feedback_row.get("terminal_outcome_classification") or "") != "SUCCESS" or verification.get("success") is not True:
                continue
            feedback_id = str(feedback_row.get("feedback_id") or feedback_row.get("object_id") or "")
            user = str(feedback_row.get("user") or "")
            target = str(feedback_row.get("target_channel") or "")
            current = str(live_current.get(user) or "")
            packet_id = str(feedback_row.get("packet_id") or "")
            reservation = ct_m0f_reservations.get(packet_id) or {}
            # Backfill only the compact denominator for the one historical
            # CT-M0F lineage.  All fields must match existing immutable audit
            # evidence and current route truth; otherwise it remains ignored.
            exact_ct_m0f_exclusion = bool(
                not binding
                and reservation
                and user in live_certification_users
                and str(feedback_row.get("source_channel") or source_channel) == source_channel
                and str(reservation.get("user") or "") == user
                and str(reservation.get("source") or "") == source_channel
                and str(reservation.get("target") or "") == target
                # Once Matrix has produced a current baseline event, an
                # unbound historical CT-M0F outcome has no proof of cohort
                # membership in that new denominator.  It remains durable
                # history only; later correctly bound packets carry the exact
                # event and can be counted by the normal path below.
                and not baseline_event_id
                and current == target
            )
            if exact_ct_m0f_exclusion:
                excluded_users.add(user)
                if feedback_id:
                    excluded_pointers.add(feedback_id)
                continue
            binding_event_ids = {
                str(value) for value in (
                    binding.get("source_event_ids") or
                    ([binding.get("source_event_id")]
                     if binding.get("source_event_id") else [])
                ) if str(value)
            }
            scope = binding.get("source_scope")
            scope = scope if isinstance(scope, dict) else {}
            scope_matches = (
                str(scope.get("source_channel") or "") == source_channel
                and to_int(scope.get("affected_scope_count"), -1) == baseline_count
                and str(scope.get("affected_scope_fingerprint") or "") == baseline_fingerprint
            )
            direct_incident_binding = (
                str(binding.get("source_incident_id") or "") == source_incident_id
            )
            direct_event_binding = (
                not baseline_event_id or baseline_event_id in binding_event_ids
            )
            # Service observations can be distinct incidents while sharing
            # one immutable channel-scope cohort.  Never use proximity or a
            # route-only inference for that join: source/count/fingerprint
            # must all match the current denominator, and the verified route
            # below must still prove the moved member is on its packet target.
            same_source_scope_cohort = scope_matches
            if not direct_incident_binding and not same_source_scope_cohort:
                continue
            if direct_incident_binding and not direct_event_binding and not same_source_scope_cohort:
                if feedback_id:
                    rejected_feedback_ids.add(feedback_id)
                continue
            if not scope_matches:
                if feedback_id:
                    rejected_feedback_ids.add(feedback_id)
                continue
            if user and target and current == target:
                protected_users.add(user)
                if feedback_id:
                    protected_pointers.add(feedback_id)
            elif user and current and current != source_channel:
                # Route truth says this bounded member left the failed source,
                # but not through the packet's verified target.  Preserve it as
                # an explicit, non-protection closure rather than guessing.
                excluded_users.add(user)
                if feedback_id:
                    excluded_pointers.add(feedback_id)

        scope_classification = str(
            existing_scope.get("scope_classification") or "LEGACY_UNPARTITIONED"
        )
        # A partitioned Matrix baseline owns the ordinary cohort.  Controlled
        # certification identities remain a separate existing owner and must
        # not be added back into the ordinary denominator merely because they
        # share the failed source channel.  Legacy all-user baselines retain
        # their historical behavior above.
        current_source_users = (
            live_ordinary_users_on_source
            if scope_classification in {
                "MIXED_ORDINARY_AND_CERTIFICATION",
                "ORDINARY_PRODUCTION_ONLY",
                "CERTIFICATION_ONLY",
            }
            else live_users_on_source
        )
        unresolved_users = {
            user for user, current in live_current.items() if current == source_channel
            and user in current_source_users
        } if live_registry_available else set()
        # Categories are disjoint by construction: a user on source is
        # unresolved; a matching target is protected; another live route is
        # explicitly excluded/recovered only with exact packet lineage.
        protected_users -= unresolved_users
        excluded_users -= unresolved_users | protected_users
        # The route owner can prove that an otherwise still-failing source has
        # no current members.  This closes the *protection intent* without
        # claiming that the channel recovered or that every historical member
        # was packet-protected.  Leaving the old denominator OPEN would let a
        # zero-scope historical incident compete with a later actionable
        # incident on another source.
        current_route_scope_empty = bool(
            live_registry_available and not unresolved_users
        )
        if current_route_scope_empty:
            # Keep the count separate and record one compact route-truth
            # pointer; raw members remain with users.registry and are never
            # copied into this projection.
            excluded_users = set()
            excluded_count = max(0, baseline_count - len(protected_users))
            excluded_pointers.add(
                "route-scope-empty:" + sha256_json({
                    "source_channel": source_channel,
                    "baseline_scope_fingerprint": baseline_fingerprint,
                    "live_source_scope_count": 0,
                })[:24]
            )
        else:
            excluded_count = len(excluded_users)
        accounted = len(protected_users) + len(unresolved_users) + excluded_count
        valid = live_registry_available and baseline_count == accounted
        # The first open projection has no protected or excluded member.  In
        # that identity case the unresolved cohort *is* the immutable
        # affected cohort, so it must retain the producer's fingerprint.
        # Re-hashing it under the incident id made the same live cohort appear
        # different to the Matrix/CT-M0F binding consumer, even though no
        # packet outcome had changed the denominator.  Once a member leaves
        # the source, keep the existing incident-scoped subset fingerprint to
        # distinguish the remaining live subset from the original cohort.
        unresolved_fingerprint = (
            baseline_fingerprint
            if (
                len(unresolved_users) == baseline_count
                and not protected_users
                and excluded_count == 0
            )
            else sha256_json({
                "incident": source_incident_id,
                "users": sorted(unresolved_users),
            })
        )
        return {
            "schema_version": "v7.service-failure-incident-scope-accounting.v2",
            "status": "ACCOUNTED" if valid else "INCIDENT_SCOPE_ACCOUNTING_BROKEN",
            "baseline_event_id": str(existing_scope.get("baseline_event_id") or ""),
            "baseline_observed_at": str(existing_scope.get("baseline_observed_at") or ""),
            "affected_scope_count": baseline_count,
            "affected_scope_fingerprint": baseline_fingerprint,
            "protected_scope_count": len(protected_users),
            "protected_scope_fingerprint": sha256_json({"incident": source_incident_id, "users": sorted(protected_users)}),
            "protected_scope_lineage_pointers": sorted(protected_pointers),
            "unresolved_scope_count": len(unresolved_users),
            "unresolved_scope_fingerprint": unresolved_fingerprint,
            "unresolved_scope_route_truth_owner": "state/users.registry",
            "explicitly_excluded_or_recovered_scope_count": excluded_count,
            "explicitly_excluded_or_recovered_scope_fingerprint": sha256_json({
                "incident": source_incident_id,
                "users": sorted(excluded_users) if not current_route_scope_empty else [],
                "route_scope_empty": current_route_scope_empty,
            }),
            "explicitly_excluded_or_recovered_lineage_pointers": sorted(excluded_pointers),
            "nonmember_or_stale_feedback_pointers": sorted(rejected_feedback_ids),
            "accounted_scope_count": accounted,
            "live_registry_available": live_registry_available,
            "raw_user_list_stored": False,
            "scope_classification": scope_classification,
            "controlled_certification_scope_count": max(
                0,
                to_int(
                    existing_scope.get("controlled_certification_scope_count"),
                    0,
                ),
            ),
            "controlled_certification_scope_fingerprint": str(
                existing_scope.get("controlled_certification_scope_fingerprint")
                or ""
            ),
            "ordinary_customer_reclassification_allowed": False,
            "scope_membership_law": (
                "CURRENT_ROUTE_SOURCE_SCOPE_EMPTY_PROTECTION_INTENT_CLOSURE"
                if current_route_scope_empty
                else "EXACT_SOURCE_SCOPE_FINGERPRINT_AND_CURRENT_ROUTE"
            ),
        }

    def _reconcile_incident_cumulative_scope(
        self,
        *,
        existing: dict[str, Any],
        execution_rows: list[dict[str, Any]],
        current_source_scope: Optional[dict[str, Any]] = None,
        reconciliation_cache: Optional[dict[str, Any]] = None,
    ) -> dict[str, Any]:
        """Preserve packet-bound history without altering the live denominator.

        The existing immutable execution owner keeps full packet evidence.  The
        L3 incident record stores only a compact, deduplicated classification
        and lineage pointer per feedback.  In particular, an older success
        does not decrement ``current_source_scope`` unless that scope's exact
        fingerprint says it is a member.
        """
        source_incident_id = str(existing.get("source_incident_id") or existing.get("incident_id") or "")
        source_channel = str(existing.get("channel") or existing.get("source_channel") or "")
        current_scope = current_source_scope if isinstance(current_source_scope, dict) else (
            existing.get("current_source_scope")
            if isinstance(existing.get("current_source_scope"), dict)
            else (existing.get("scope_accounting") if isinstance(existing.get("scope_accounting"), dict) else {})
        )
        if not source_incident_id or not source_channel:
            return {}
        if reconciliation_cache is not None and "live_rows" in reconciliation_cache:
            live_rows = list(reconciliation_cache["live_rows"] or [])
        else:
            live_rows = parse_registry(self.state_dir / "users.registry") if (self.state_dir / "users.registry").exists() else []
            if reconciliation_cache is not None:
                reconciliation_cache["live_registry_available"] = (self.state_dir / "users.registry").exists()
                reconciliation_cache["live_rows"] = live_rows
        live_current = {
            str(item.get("ip") or ""): str(item.get("current") or "")
            for item in live_rows
            if str(item.get("ip") or "") and (not str(item.get("enabled") or "") or bool_value(item.get("enabled")))
        }
        baseline_count = to_int(current_scope.get("affected_scope_count"), -1)
        baseline_fingerprint = str(current_scope.get("affected_scope_fingerprint") or "")
        entries: list[dict[str, Any]] = []
        seen_feedback: set[str] = set()
        for row in execution_rows:
            if str(row.get("schema_version") or "") != "v7.execution-outcome-record.v1":
                continue
            terminal = str(row.get("terminal_outcome_classification") or "")
            verification = row.get("verification_result") if isinstance(row.get("verification_result"), dict) else {}
            if terminal not in {"SUCCESS", "ROLLBACK_SUCCESS"} or (terminal == "SUCCESS" and verification.get("success") is not True):
                continue
            feedback_id = str(row.get("feedback_id") or row.get("object_id") or "")
            if not feedback_id or feedback_id in seen_feedback:
                continue
            binding = self._effective_service_failure_causal_binding(row)
            bound_incident = str(binding.get("source_incident_id") or "")
            # Retain an unbound historical move from the same failed source as
            # an explicit *missing-binding* fact, never as incident membership.
            # A differently-bound service event joins only when its immutable
            # source-scope fingerprint is exactly the live denominator.  This
            # captures one channel cohort represented by multiple services,
            # without scanning unrelated VLESS history into every incident.
            same_source = str(row.get("source_channel") or "") == source_channel
            scope = binding.get("source_scope") if isinstance(binding.get("source_scope"), dict) else {}
            same_source_scope_cohort = (
                str(scope.get("source_channel") or "") == source_channel
                and to_int(scope.get("affected_scope_count"), -1) == baseline_count
                and str(scope.get("affected_scope_fingerprint") or "") == baseline_fingerprint
            )
            prior = existing.get("incident_cumulative_scope") if isinstance(existing.get("incident_cumulative_scope"), dict) else {}
            prior_entries = prior.get("entries") if isinstance(prior.get("entries"), list) else []
            prior_known = any(isinstance(item, dict) and str(item.get("feedback_id") or "") == feedback_id for item in prior_entries)
            if bound_incident and bound_incident != source_incident_id:
                include = prior_known or same_source_scope_cohort
            else:
                include = bound_incident == source_incident_id or (not bound_incident and same_source)
            if not include:
                continue
            user = str(row.get("user") or "")
            target = str(row.get("target_channel") or "")
            current = str(live_current.get(user) or "")
            exact_current_member = (
                same_source_scope_cohort
            )
            if bound_incident and bound_incident != source_incident_id:
                classification = (
                    "SAME_SOURCE_SCOPE_COHORT_PROTECTED"
                    if exact_current_member and target and current == target
                    else "OTHER_INCIDENT"
                )
            elif bound_incident != source_incident_id:
                classification = "HISTORICAL_MOVED_INCIDENT_BINDING_MISSING"
            elif current == source_channel:
                classification = "RETURNED_TO_SOURCE"
            elif exact_current_member and target and current == target:
                classification = "CURRENT_INCIDENT_PROTECTED"
            elif current and current != source_channel:
                classification = "HISTORICAL_PROTECTED_PRE_BASELINE"
            else:
                classification = "RECOVERED_OR_EXCLUDED"
            entries.append({
                "feedback_id": feedback_id,
                "packet_id": str(row.get("packet_id") or ""),
                "learning_id": str(((row.get("learning_record") or {}).get("learning_record_id") or "")),
                "classification": classification,
                "user_fingerprint": sha256_json({"incident": source_incident_id, "user": user}),
                "source_scope_fingerprint": str(scope.get("affected_scope_fingerprint") or ""),
                "current_route_matches_packet_target": bool(target and current == target),
            })
            seen_feedback.add(feedback_id)
        entries.sort(key=lambda item: str(item.get("feedback_id") or ""))
        classification_counts = {
            name: sum(1 for item in entries if item.get("classification") == name)
            for name in (
                "CURRENT_INCIDENT_PROTECTED", "HISTORICAL_PROTECTED_PRE_BASELINE",
                "HISTORICAL_MOVED_INCIDENT_BINDING_MISSING", "RETURNED_TO_SOURCE",
                "RECOVERED_OR_EXCLUDED", "OTHER_INCIDENT",
                "SAME_SOURCE_SCOPE_COHORT_PROTECTED",
            )
        }
        return {
            "schema_version": "v7.service-failure-incident-cumulative-scope.v1",
            "status": "LINEAGE_RECONCILED" if entries else "NO_PACKET_BOUND_LINEAGE_YET",
            "source_incident_id": source_incident_id,
            "current_source_scope_fingerprint": baseline_fingerprint,
            "current_source_scope_count": baseline_count,
            "packet_bound_success_count": len(entries),
            "classification_counts": classification_counts,
            "entries": entries,
            "lineage_pointers": [item["feedback_id"] for item in entries],
            "membership_basis": "PACKET_BOUND_CAUSAL_BINDING_AND_CURRENT_ROUTE_ONLY",
            "cumulative_count_semantics": "PROVABLE_PACKET_BOUND_SUBSET_NOT_A_CURRENT_SOURCE_DENOMINATOR",
            "raw_user_list_stored": False,
        }

    def _reconcile_recovered_service_failure_intents(
        self,
        state: dict[str, Any],
    ) -> dict[str, Any]:
        """Close only stale open intents proven recovered by existing owners.

        The passive-event consumer historically keyed recovery strictly by the
        original source-incident ID.  A channel can have several older compact
        incident projections for the same source generation, though.  Leaving
        those projections OPEN after a later owner-backed recovery makes their
        incomplete historical scope accounting block an unrelated current CPS
        reconciliation forever.

        This is not a recovery inference and it is not an execution path.  A
        record may be closed only when both existing owners agree: an immutable
        passive recovery receipt is newer than the record and the current
        Matrix still proves a fresh healthy baseline for the same source.  The
        terminal retains the original counted scope as recovered/excluded;
        it never credits a user movement or rewrites packet evidence.
        """
        incidents = state.get("incidents")
        if not isinstance(incidents, dict):
            return {"changed": 0, "closed_incident_ids": []}
        # Recovery is service-scoped.  Keeping only the last receipt for an
        # entire channel made an older ``claude``/``youtube`` incident depend
        # on whether an unrelated later ``spotify`` recovery happened to list
        # that service.  Preserve the existing append-only receipts and choose
        # the exact post-incident receipt for every service below.
        recoveries_by_source: dict[str, list[dict[str, Any]]] = {}
        for row in read_live_owner_history_window(
            self.state_dir / "closure-records.jsonl"
        ):
            if str(row.get("object_type") or "") != "passive_production_event":
                continue
            if str(row.get("terminal_outcome_classification") or "") != "RECOVERY_OBSERVED_NO_ACTION":
                continue
            source = str(row.get("channel") or "")
            observed_at = str(row.get("observed_at") or row.get("created_at") or "")
            if not source or not observed_at:
                continue
            recoveries_by_source.setdefault(source, []).append(row)
        for source, rows in recoveries_by_source.items():
            recoveries_by_source[source] = sorted(
                rows,
                key=lambda item: parse_ts(
                    str(item.get("recovered_at") or item.get("observed_at")
                        or item.get("created_at") or "")
                ),
            )

        changed = 0
        closed_incident_ids: list[str] = []
        matrix = read_json(self.state_dir / "service-matrix.json", {})
        matrix_items = (
            matrix.get("items") if isinstance(matrix.get("items"), dict) else {}
        )
        for key, record in list(incidents.items()):
            if not isinstance(record, dict):
                continue
            if str(record.get("authority_object") or "") != "PASSIVE_SERVICE_FAILURE_CAPTURE":
                continue
            source = str(record.get("channel") or record.get("source_channel") or "")
            recoveries = recoveries_by_source.get(source) or []
            if not source or not recoveries:
                continue
            last_observed = str(record.get("last_observed_at") or record.get("opened_at") or "")
            record_generation = str(record.get("incident_generation") or "")
            record_services = {
                str(item) for item in (record.get("services") or []) if str(item)
            }
            if not record_services:
                continue
            # Every exact service must have a recovery receipt newer than this
            # incident.  A recovery for another service is never a channel
            # shortcut.  The receipt's identity generation must agree when
            # both owners provide it.
            matching_recoveries: dict[str, dict[str, Any]] = {}
            for service_id in record_services:
                candidates: list[dict[str, Any]] = []
                for recovery in recoveries:
                    recovered_at = str(
                        recovery.get("recovered_at") or recovery.get("observed_at")
                        or recovery.get("created_at") or ""
                    )
                    recovery_generation = str(
                        recovery.get("egress_identity_generation") or ""
                    )
                    recovery_services = {
                        str(item) for item in (recovery.get("services") or [])
                        if str(item)
                    }
                    if (
                        service_id not in recovery_services
                        or not recovered_at
                        or (last_observed and parse_ts(recovered_at) < parse_ts(last_observed))
                        or (record_generation and recovery_generation
                            and record_generation != recovery_generation)
                    ):
                        continue
                    candidates.append(recovery)
                if not candidates:
                    break
                matching_recoveries[service_id] = candidates[-1]
            if set(matching_recoveries) != record_services:
                continue
            source_row = matrix_items.get(source)
            source_services = (
                source_row.get("services")
                if isinstance(source_row, dict)
                and isinstance(source_row.get("services"), dict) else {}
            )
            # A current failure cannot reopen a past episode retrospectively.
            # It may coexist with the old recovery only when the Matrix proves
            # that it began strictly after that exact recovery receipt.  If
            # the service is currently healthy, the live Matrix remains the
            # second independent confirmation.  Unknown/ambiguous current
            # rows fail closed.
            subsequent_failure_epoch = False
            current_service_rows = {
                service_id: source_services.get(service_id) or {}
                for service_id in record_services
            }
            if any(not isinstance(row, dict) for row in current_service_rows.values()):
                continue
            current_services_valid = True
            for service_id, current_row in current_service_rows.items():
                if bool_value(current_row.get("ok")):
                    continue
                recovery = matching_recoveries[service_id]
                recovered_at = str(
                    recovery.get("recovered_at") or recovery.get("observed_at")
                    or recovery.get("created_at") or ""
                )
                failure_started_at = str(
                    current_row.get("failure_started_at")
                    or current_row.get("first_failed_at") or ""
                )
                if not failure_started_at or parse_ts(failure_started_at) <= parse_ts(recovered_at):
                    current_services_valid = False
                    break
                subsequent_failure_epoch = True
            if not current_services_valid:
                continue
            if (
                not subsequent_failure_epoch
                and str(record.get("incident_state") or "") == "INTENT_CLOSED"
            ):
                # A previously closed intent remains terminal while the
                # current Matrix is healthy or ambiguous.  Closed records are
                # intentionally inspected above so a later, timestamped
                # failure epoch can reopen the same source incident safely.
                continue
            scope = (
                record.get("current_source_scope")
                if isinstance(record.get("current_source_scope"), dict)
                else record.get("scope_accounting")
                if isinstance(record.get("scope_accounting"), dict) else {}
            )
            affected = max(0, to_int(scope.get("affected_scope_count"), 0))
            protected = min(
                affected, max(0, to_int(scope.get("protected_scope_count"), 0))
            )
            recovery_pointers = sorted({
                str(recovery.get("object_id") or recovery.get("event_id") or "")
                for recovery in matching_recoveries.values()
                if str(recovery.get("object_id") or recovery.get("event_id") or "")
            })
            recovery_pointer = recovery_pointers[-1] if recovery_pointers else ""
            recovered_at = max(
                str(recovery.get("recovered_at") or recovery.get("observed_at")
                    or recovery.get("created_at") or "")
                for recovery in matching_recoveries.values()
            )
            terminal_scope = {
                **scope,
                "schema_version": "v7.service-failure-incident-scope-accounting.v2",
                "status": "ACCOUNTED",
                "affected_scope_count": affected,
                "protected_scope_count": protected,
                "unresolved_scope_count": 0,
                "explicitly_excluded_or_recovered_scope_count": affected - protected,
                "accounted_scope_count": affected,
                "scope_membership_law": (
                    "EXACT_SERVICE_RECOVERY_RECEIPT_PLUS_CURRENT_MATRIX_EPISODE_BOUNDARY"
                ),
                "terminal_scope_frozen": True,
                "recovery_evidence_pointer": recovery_pointer,
                "recovery_evidence_pointers": recovery_pointers,
                "current_matrix_relation": (
                    "SUBSEQUENT_FAILURE_EPOCH" if subsequent_failure_epoch
                    else "CURRENTLY_HEALTHY"
                ),
                "raw_user_list_stored": False,
            }
            lineage = (
                dict(record.get("causal_lineage") or {})
                if isinstance(record.get("causal_lineage"), dict) else {}
            )
            lineage.update({
                "recovery_evidence_pointer": recovery_pointer,
                "recovery_evidence_pointers": recovery_pointers,
                "current_matrix_relation": terminal_scope["current_matrix_relation"],
            })
            if subsequent_failure_epoch:
                # A later Matrix failure on the same source identity is a new
                # live recovery opportunity, not a reason to freeze the old
                # incident forever.  Reopen the existing L3 projection while
                # preserving protected members and all immutable recovery
                # evidence; the normal advisory/executor owners still decide
                # whether a governed move is legal.
                reopened_scope = {
                    **terminal_scope,
                    "status": "ACCOUNTED",
                    "unresolved_scope_count": max(0, affected - protected),
                    "explicitly_excluded_or_recovered_scope_count": protected,
                    "scope_membership_law": (
                        "CURRENT_MATRIX_FAILURE_AFTER_RECOVERY_REQUIRES_REENTRY"
                    ),
                    "terminal_scope_frozen": False,
                    "current_matrix_relation": "SUBSEQUENT_FAILURE_EPOCH",
                }
                incidents[key] = {
                    **record,
                    "status": "OPEN",
                    "incident_state": "OPEN",
                    "channel_incident_state": "OPEN",
                    "attempt_terminal": "RECOVERY_OBSERVED_NEW_FAILURE_GENERATION_REOPENED",
                    "closed_at": "",
                    "last_observed_at": max(
                        str(row.get("observed_at") or "")
                        for row in current_service_rows.values()
                    ),
                    "next_required_consumer": (
                        "tools/v7-users-autoswitch.materialize_service_failure_automation_advisory"
                    ),
                    "reentry_condition": (
                        "current Matrix failure remains active; existing advisory and governed executor revalidate before action"
                    ),
                    "current_source_scope": reopened_scope,
                    "scope_accounting": reopened_scope,
                    "affected_scope_count": affected,
                    "protected_scope_count": protected,
                    "unresolved_scope_count": reopened_scope["unresolved_scope_count"],
                    "causal_lineage": lineage,
                    "causal_invariant": {
                        "name": "CURRENT_FAILURE_AFTER_RECOVERY_REOPENS_EXISTING_INCIDENT",
                        "valid": True,
                    },
                    "execution_performed": False,
                    "runtime_mutation_performed": False,
                    "routing_mutation_performed": False,
                    "users_moved": 0,
                    "apply_executed": False,
                    "authority_expanded": False,
                    "production_maturity_changed": False,
                    "consumer": (
                        "tools/v7-users-autoswitch."
                        "_reconcile_recovered_service_failure_intents"
                    ),
                    "updated_at": now_iso(),
                }
            else:
                incidents[key] = {
                    **record,
                    "status": "CLOSED",
                    "incident_state": "INTENT_CLOSED",
                    "channel_incident_state": "RECOVERED",
                    "attempt_terminal": "RECOVERY_OBSERVED_NO_ACTION",
                    "closed_at": recovered_at,
                    "next_required_consumer": "",
                    "reentry_condition": "new owner-backed failure generation",
                    "current_source_scope": terminal_scope,
                    "scope_accounting": terminal_scope,
                    "affected_scope_count": affected,
                    "protected_scope_count": protected,
                    "unresolved_scope_count": 0,
                    "causal_lineage": lineage,
                    "causal_invariant": {
                        "name": "INTENT_CLOSED_BY_RECOVERY_REQUIRES_FRESH_NEW_GENERATION",
                        "valid": True,
                    },
                    "execution_performed": False,
                    "runtime_mutation_performed": False,
                    "routing_mutation_performed": False,
                    "users_moved": 0,
                    "apply_executed": False,
                    "authority_expanded": False,
                    "production_maturity_changed": False,
                    "consumer": (
                        "tools/v7-users-autoswitch."
                        "_reconcile_recovered_service_failure_intents"
                    ),
                    "updated_at": now_iso(),
                }
            changed += 1
            closed_incident_ids.append(str(record.get("incident_id") or ""))
        return {
            "changed": changed,
            "closed_incident_ids": sorted(item for item in closed_incident_ids if item),
        }

    def reconcile_service_failure_execution_outcomes(self) -> dict[str, Any]:
        """Consume exact packet-bound execution feedback into the same L3 incident state.

        The feedback, packet and incident already have owners.  This method is
        only their compact-state consumer: it refuses timing-based inference,
        creates no execution artefact and keeps a partially protected channel
        incident open for its remaining scope.
        """
        recorder = getattr(self, "_passive_performance_recorder", None)

        def record_passive_reconciliation_span(stage: str, started_ns: int) -> None:
            if callable(recorder):
                recorder(stage, started_ns)

        ledger_load_started_ns = time.monotonic_ns()
        l3_projection_load_started_ns = time.monotonic_ns()
        state = self._load_l3_runtime_state()
        record_passive_reconciliation_span(
            "passive_reconciliation_l3_projection_load",
            l3_projection_load_started_ns,
        )
        incidents = state.get("incidents") if isinstance(state.get("incidents"), dict) else {}
        execution_ledger_load_started_ns = time.monotonic_ns()
        execution_outcome_rows, ledger_active = read_jsonl_exact_schema(
            self.state_dir / "execution-events.jsonl",
            "v7.execution-outcome-record.v1",
        )
        record_passive_reconciliation_span(
            "passive_reconciliation_execution_ledger_load",
            execution_ledger_load_started_ns,
        )
        # This consumer's exact packet/feedback contract is defined only by
        # immutable execution-outcome records.  Keep the full append-only
        # ledger with its existing owner, but avoid re-scanning unrelated
        # passive decision/outcome history for every incident projection.
        record_passive_reconciliation_span(
            "passive_reconciliation_l3_and_execution_ledger_load",
            ledger_load_started_ns,
        )
        # Reuse a read snapshot only within this one reconciliation call.
        # Existing registry and audit owners remain authoritative and each new
        # invocation reloads them, so no cache becomes durable state or truth.
        reconciliation_cache: dict[str, Any] = {}
        changed = 0
        consumed = 0
        rejected: list[str] = []
        ignored_non_l3_binding_kinds: set[str] = set()
        ignored_non_l3_binding_count = 0
        feedback_ingest_started_ns = time.monotonic_ns()
        for row in execution_outcome_rows:
            binding = self._effective_service_failure_causal_binding(row)
            if not binding:
                continue
            # Certification-only Matrix experiments retain their immutable
            # execution evidence, but are not parents of an L3 production
            # incident.  Treating them as such made this L3-only consumer
            # report a permanent false STOP_SAFE for a deliberately isolated
            # historical lane.  Preserve the record and leave its owning
            # certification/closure consumers unchanged; only direct L3
            # handoffs may update the L3 incident projection here.
            if not bool_value(binding.get("direct_l3_handoff")):
                ignored_non_l3_binding_count += 1
                ignored_non_l3_binding_kinds.add(
                    str(binding.get("binding_kind") or "UNCLASSIFIED")
                )
                continue
            source_incident_id = str(binding.get("source_incident_id") or "")
            source_event_id = str(binding.get("source_event_id") or "")
            source_channel = str(binding.get("source_channel") or "")
            event_type = str(binding.get("event_type") or "")
            feedback_id = str(row.get("feedback_id") or row.get("object_id") or "")
            if not all((source_incident_id, source_event_id, source_channel, feedback_id)):
                rejected.append("execution_feedback_causal_binding_identity_missing")
                continue
            if event_type not in {"SERVICE_FAILURE_OBSERVED", "SERVICE_FAILURE_REVALIDATED"}:
                rejected.append("execution_feedback_causal_binding_event_type_invalid")
                continue
            if str(row.get("source_channel") or "") != source_channel:
                rejected.append("execution_feedback_causal_binding_source_mismatch")
                continue
            incident_key = self._passive_incident_projection_key(source_incident_id)
            existing = incidents.get(incident_key) if isinstance(incidents.get(incident_key), dict) else {}
            if not existing:
                rejected.append("execution_feedback_parent_incident_projection_missing")
                continue
            consumed_feedback_ids = {
                str(item) for item in (existing.get("execution_feedback_ids") or []) if str(item)
            }
            if feedback_id in consumed_feedback_ids:
                consumed += 1
                continue
            terminal = str(row.get("terminal_outcome_classification") or "UNKNOWN")
            verification = row.get("verification_result") if isinstance(row.get("verification_result"), dict) else {}
            success = terminal == "SUCCESS" and verification.get("success") is True
            rollback_success = terminal == "ROLLBACK_SUCCESS"
            if not (success or rollback_success):
                rejected.append("execution_feedback_terminal_not_consumable")
                continue
            user = str(row.get("user") or "")
            user_fingerprint = sha256_json({"incident": source_incident_id, "user": user})
            existing_scope = existing.get("current_source_scope") if isinstance(existing.get("current_source_scope"), dict) else (existing.get("scope_accounting") if isinstance(existing.get("scope_accounting"), dict) else {})
            scope_accounting = self._reconcile_incident_scope_accounting(
                existing=existing,
                execution_rows=execution_outcome_rows,
                reconciliation_cache=reconciliation_cache,
            )
            cumulative_scope = self._reconcile_incident_cumulative_scope(
                existing=existing,
                execution_rows=execution_outcome_rows,
                current_source_scope=scope_accounting or existing_scope,
                reconciliation_cache=reconciliation_cache,
            )
            lineage = dict(existing.get("causal_lineage") or {})
            lineage.update({
                "source_incident_id": source_incident_id,
                "source_event_ids": sorted({
                    *[str(item) for item in (binding.get("source_event_ids") or []) if str(item)],
                    source_event_id,
                }),
                "execution_feedback_id": feedback_id,
                "packet_id": str(row.get("packet_id") or ""),
                "execution_decision_trace_id": str(row.get("decision_trace_id") or ""),
                "learning_id": str(((row.get("learning_record") or {}).get("learning_record_id") or existing.get("learning_id") or "")),
            })
            desired = {
                **existing,
                "status": "PARTIALLY_PROTECTED",
                "incident_state": "PARTIALLY_PROTECTED",
                "channel_incident_state": "OPEN",
                "attempt_terminal": terminal,
                "attempt_id": str(row.get("closure_reference") or row.get("operation_id") or feedback_id),
                "packet_id": str(row.get("packet_id") or ""),
                "outcome_id": feedback_id,
                "learning_id": lineage["learning_id"],
                "last_execution_feedback_id": feedback_id,
                "execution_feedback_ids": sorted({*consumed_feedback_ids, feedback_id})[-500:],
                "last_observed_at": str(row.get("outcome_observed_at") or row.get("created_at") or now_iso()),
                "cohort_protection_intent": {
                    **(existing.get("cohort_protection_intent") if isinstance(existing.get("cohort_protection_intent"), dict) else {}),
                    "state": "PARTIALLY_PROTECTED",
                    "partial_scope_reason": "ONE_PACKET_BOUND_USER_PROTECTED; remaining cohort remains open",
                },
                "user_protection_intent": {
                    "state": "INTENT_CLOSED",
                    "scope_type": "USER",
                    "scope_fingerprint": user_fingerprint,
                    "intent_closure_reason": "PACKET_BOUND_EXECUTION_SUCCESS" if success else "PACKET_BOUND_ROLLBACK_SUCCESS",
                    "intent_closure_evidence_pointer": feedback_id,
                    "raw_user_list_stored": False,
                },
                "scope_accounting": scope_accounting or existing_scope,
                "current_source_scope": scope_accounting or existing_scope,
                "incident_cumulative_scope": cumulative_scope,
                "next_required_consumer": (
                    "tools/v7-users-autoswitch.reconcile_service_failure_execution_outcomes"
                    if scope_accounting and scope_accounting.get("status") == "INCIDENT_SCOPE_ACCOUNTING_BROKEN"
                    else "tools/v7-users-autoswitch.reconcile_service_failure_shadow_outcomes"
                ),
                "reentry_condition": (
                    "existing Matrix producer must provide a fresh compact source-scope snapshot before another action"
                    if scope_accounting and scope_accounting.get("status") == "INCIDENT_SCOPE_ACCOUNTING_BROKEN"
                    else "existing shadow/outcome consumer consumes exact packet-bound feedback; remaining channel scope continues on fresh owner-backed observation"
                ),
                "causal_lineage": lineage,
                "causal_invariant": {
                    "name": "OPEN_INCIDENT_REQUIRES_SUCCESSOR_AND_REENTRY",
                    "valid": True,
                },
                "execution_performed": True,
                "runtime_mutation_performed": True,
                "routing_mutation_performed": True,
                "users_moved": 1,
                "apply_executed": True,
                "authority_expanded": False,
                "production_maturity_changed": False,
                "consumer": "tools/v7-users-autoswitch.reconcile_service_failure_execution_outcomes",
            }
            if scope_accounting:
                desired.update({
                    "affected_scope_count": scope_accounting["affected_scope_count"],
                    "affected_scope_fingerprint": scope_accounting["affected_scope_fingerprint"],
                    "protected_scope_count": scope_accounting["protected_scope_count"],
                    "protected_scope_fingerprint": scope_accounting["protected_scope_fingerprint"],
                    "unresolved_scope_count": scope_accounting["unresolved_scope_count"],
                    "unresolved_scope_fingerprint": scope_accounting["unresolved_scope_fingerprint"],
                })
            incidents[incident_key] = desired
            changed += 1
            consumed += 1
        record_passive_reconciliation_span(
            "passive_reconciliation_feedback_ingest",
            feedback_ingest_started_ns,
        )
        # Scope truth is a live-route projection, not a side effect of the
        # first feedback consumer.  Recompute it even when every immutable
        # feedback id was already consumed; otherwise a generation-local
        # result can remain stale forever after a deploy or a route change.
        incident_refresh_started_ns = time.monotonic_ns()
        for incident_key, record in list(incidents.items()):
            if not isinstance(record, dict):
                continue
            scope_accounting = self._reconcile_incident_scope_accounting(
                existing=record,
                execution_rows=execution_outcome_rows,
                reconciliation_cache=reconciliation_cache,
            )
            if not scope_accounting:
                continue
            desired_scope_fields = {
                "scope_accounting": scope_accounting,
                "current_source_scope": scope_accounting,
                "incident_cumulative_scope": self._reconcile_incident_cumulative_scope(
                    existing=record,
                    execution_rows=execution_outcome_rows,
                    current_source_scope=scope_accounting,
                    reconciliation_cache=reconciliation_cache,
                ),
                "affected_scope_count": scope_accounting["affected_scope_count"],
                "affected_scope_fingerprint": scope_accounting["affected_scope_fingerprint"],
                "protected_scope_count": scope_accounting["protected_scope_count"],
                "protected_scope_fingerprint": scope_accounting["protected_scope_fingerprint"],
                "unresolved_scope_count": scope_accounting["unresolved_scope_count"],
                "unresolved_scope_fingerprint": scope_accounting["unresolved_scope_fingerprint"],
            }
            if scope_accounting.get("status") == "INCIDENT_SCOPE_ACCOUNTING_BROKEN":
                desired_scope_fields.update({
                    "next_required_consumer": "tools/v7-users-autoswitch.reconcile_service_failure_execution_outcomes",
                    "reentry_condition": "reconcile exact source-scope fingerprint with current route truth before any further action",
                })
            elif (
                str(record.get("authority_object") or "")
                == "PASSIVE_SERVICE_FAILURE_CAPTURE"
                and str(record.get("incident_state") or "") != "INTENT_CLOSED"
                and int(scope_accounting.get("unresolved_scope_count") or 0) == 0
            ):
                # Distinguish a channel recovery from an empty current source
                # scope.  The former needs service recovery receipts; the
                # latter is already terminal for user protection, but retains
                # the channel incident as historical diagnostic evidence.
                desired_scope_fields.update({
                    "status": "CLOSED",
                    "incident_state": "INTENT_CLOSED",
                    "channel_incident_state": "OPEN_NO_ASSIGNED_USERS",
                    "attempt_terminal": "CURRENT_SOURCE_SCOPE_EMPTY_NO_ACTION",
                    "closed_at": now_iso(),
                    "next_required_consumer": "",
                    "reentry_condition": "new owner-backed source event with non-empty current route scope",
                    "intent_closure_reason": "CURRENT_ROUTE_SOURCE_SCOPE_EMPTY",
                    "intent_closure_evidence_pointer": next(
                        iter(scope_accounting.get(
                            "explicitly_excluded_or_recovered_lineage_pointers"
                        ) or ()),
                        "",
                    ),
                    "cohort_protection_intent": {
                        **(
                            record.get("cohort_protection_intent")
                            if isinstance(record.get("cohort_protection_intent"), dict)
                            else {}
                        ),
                        "state": "INTENT_CLOSED",
                        "intent_closure_reason": "CURRENT_ROUTE_SOURCE_SCOPE_EMPTY",
                    },
                    "causal_invariant": {
                        "name": "EMPTY_CURRENT_SCOPE_CLOSES_PROTECTION_INTENT_NOT_CHANNEL_INCIDENT",
                        "valid": True,
                    },
                    "consumer": "tools/v7-users-autoswitch.reconcile_service_failure_execution_outcomes",
                })
                # Persist the terminal, frozen scope projection in this same
                # existing reconciliation write.  Without it, the next
                # otherwise-idempotent re-entry performs one avoidable state
                # rewrite merely to freeze a closure already established here.
                terminal_scope_accounting = self._reconcile_incident_scope_accounting(
                    existing={**record, **desired_scope_fields},
                    execution_rows=execution_outcome_rows,
                    reconciliation_cache=reconciliation_cache,
                )
                if terminal_scope_accounting:
                    desired_scope_fields.update({
                        "scope_accounting": terminal_scope_accounting,
                        "current_source_scope": terminal_scope_accounting,
                        "incident_cumulative_scope": self._reconcile_incident_cumulative_scope(
                            existing={**record, **desired_scope_fields},
                            execution_rows=execution_outcome_rows,
                            current_source_scope=terminal_scope_accounting,
                            reconciliation_cache=reconciliation_cache,
                        ),
                        "affected_scope_count": terminal_scope_accounting["affected_scope_count"],
                        "affected_scope_fingerprint": terminal_scope_accounting["affected_scope_fingerprint"],
                        "protected_scope_count": terminal_scope_accounting["protected_scope_count"],
                        "protected_scope_fingerprint": terminal_scope_accounting["protected_scope_fingerprint"],
                        "unresolved_scope_count": terminal_scope_accounting["unresolved_scope_count"],
                        "unresolved_scope_fingerprint": terminal_scope_accounting["unresolved_scope_fingerprint"],
                    })
            elif (
                str(record.get("next_required_consumer") or "")
                == "tools/v7-users-autoswitch.reconcile_service_failure_execution_outcomes"
                and str(record.get("reentry_condition") or "")
                == "reconcile exact source-scope fingerprint with current route truth before any further action"
            ):
                # Do not leave a repaired cohort subscribed to its old repair
                # consumer.  The exact scope and current route now satisfy
                # the accounting invariant, so hand the durable successor
                # back to the existing outcome/shadow consumer; this remains
                # a compact state projection and cannot enter execution.
                desired_scope_fields.update({
                    "next_required_consumer": "tools/v7-users-autoswitch.reconcile_service_failure_shadow_outcomes",
                    "reentry_condition": "existing shadow/outcome consumer consumes exact packet-bound feedback; remaining channel scope continues on fresh owner-backed observation",
                })
            if any(record.get(key) != value for key, value in desired_scope_fields.items()):
                incidents[incident_key] = {**record, **desired_scope_fields}
                changed += 1
        record_passive_reconciliation_span(
            "passive_reconciliation_all_incident_scope_refresh",
            incident_refresh_started_ns,
        )
        recovery_and_write_started_ns = time.monotonic_ns()
        recovery_reconciliation = self._reconcile_recovered_service_failure_intents(
            state,
        )
        changed += int(recovery_reconciliation.get("changed") or 0)
        capability_projection: dict[str, Any] = {}
        # Passive reconciliation must not manufacture a capability projection
        # in a minimal/no-L3 deployment.  When the existing L3 owner has
        # already materialized one, refresh it from its immutable evidence.
        if isinstance(state.get("capability"), dict):
            capability_projection = self._refresh_l3_capability_projection(state)
            if capability_projection.get("changed"):
                changed += 1
        # Older L3 records were created before passive service-failure
        # receipts became the normal recovery carrier.  They can therefore
        # remain OPEN forever even after the Matrix has freshly proved every
        # exact service that opened the historical incident healthy.  Consume
        # only that narrow, owner-backed condition here.  A current failure,
        # an unknown service, or stale Matrix evidence leaves the incident
        # open; this is recovery reconciliation, never a route action.
        l3_recovered: list[str] = []
        matrix_items = (
            self.matrix.get("items")
            if isinstance(getattr(self, "matrix", {}), dict)
            and isinstance(self.matrix.get("items"), dict)
            else {}
        )
        active_l3_states = {
            "OPEN", "READY_FOR_EXECUTION", "INCIDENT_OPEN_STOP_SAFE",
            "STOP_SAFE", "SUSPENDED",
        }
        now_epoch = time.time()
        for incident_key, record in list(incidents.items()):
            if not isinstance(record, dict):
                continue
            if (
                str(record.get("authority_object") or "")
                != "EMERGENCY_FAILOVER_AUTONOMY"
                or str(record.get("status") or "") not in active_l3_states
            ):
                continue
            required_services = sorted({
                str(service) for service in (record.get("failed_required_services") or [])
                if str(service)
            })
            sources = sorted({
                str(source) for source in (
                    record.get("failed_sources")
                    or [record.get("incident_source")]
                ) if str(source)
            })
            if not required_services or not sources:
                continue
            recovered_sources: list[str] = []
            for source in sources:
                rows = (
                    (matrix_items.get(source) or {}).get("services")
                    if isinstance(matrix_items.get(source), dict)
                    else {}
                )
                if not isinstance(rows, dict):
                    break
                exact_rows = [rows.get(service) for service in required_services]
                if any(not isinstance(row, dict) or row.get("ok") is not True for row in exact_rows):
                    break
                try:
                    ages = [
                        now_epoch - parse_ts(str(row.get("observed_at") or row.get("tested_at") or ""))
                        for row in exact_rows
                    ]
                except (TypeError, ValueError):
                    break
                if any(age < 0 or age > 900 for age in ages):
                    break
                recovered_sources.append(source)
            if recovered_sources != sources:
                continue
            prior_scope = (
                record.get("current_source_scope")
                if isinstance(record.get("current_source_scope"), dict)
                else record.get("scope_accounting")
                if isinstance(record.get("scope_accounting"), dict) else {}
            )
            frozen_scope = {
                **prior_scope,
                "status": "ACCOUNTED",
                "terminal_scope_frozen": True,
                "current_matrix_relation": "CURRENTLY_HEALTHY",
                "recovery_services": required_services,
                "recovery_sources": recovered_sources,
                "scope_membership_law": "FRESH_EXACT_MATRIX_RECOVERY_FOR_HISTORICAL_L3_INCIDENT",
            }
            incidents[incident_key] = {
                **record,
                "status": "CLOSED",
                "incident_state": "INTENT_CLOSED",
                "channel_incident_state": "RECOVERED",
                "terminal_outcome": "RECOVERY_OBSERVED_NO_ACTION",
                "terminal_state": "RECOVERED",
                "terminal_reason": "fresh_exact_matrix_recovery_of_historical_l3_services",
                "closed_at": now_iso(),
                "next_required_consumer": "",
                "reentry_condition": "new owner-backed failure generation",
                "current_source_scope": frozen_scope,
                "scope_accounting": frozen_scope,
                "execution_performed": False,
                "runtime_mutation_performed": True,
                "routing_mutation_performed": False,
                "users_moved": 0,
                "apply_executed": False,
                "authority_expanded": False,
                "production_maturity_changed": False,
                "consumer": "tools/v7-users-autoswitch.reconcile_service_failure_execution_outcomes",
            }
            changed += 1
            l3_recovered.append(str(incident_key))
        if changed:
            state["incidents"] = incidents
            self._write_l3_runtime_state(state)
        record_passive_reconciliation_span(
            "passive_reconciliation_recovery_and_state_write",
            recovery_and_write_started_ns,
        )
        return {
            "schema_version": "v7.service-failure-execution-outcome-reconciliation.v1",
            "active": ledger_active,
            "consumed_records": consumed,
            "changed_records": changed,
            "rejected_records": sorted(set(rejected)),
            "ignored_non_l3_binding_count": ignored_non_l3_binding_count,
            "ignored_non_l3_binding_kinds": sorted(ignored_non_l3_binding_kinds),
            "l3_capability_projection": {
                key: capability_projection.get(key)
                for key in (
                    "state", "success_outcomes", "rollback_outcomes",
                    "failure_or_no_execution_outcomes", "closure_records",
                    "last_operation_id", "last_incident_key",
                    "excluded_n10_product_operation_ids",
                    "excluded_n10_product_feedback_count", "changed",
                )
            },
            "recovery_terminal_reconciliation": recovery_reconciliation,
            "historical_l3_recovery_reconciliation": {
                "changed": len(l3_recovered),
                "closed_incident_keys": sorted(l3_recovered),
                "proof": "fresh exact Matrix health only; no routing mutation",
            },
            "final_verdict": "PASS" if not rejected else "STOP_SAFE",
            "forbidden_effects": {
                "candidate_created": False, "packet_created": False, "lease_created": False,
                "runtime_apply": False, "routing_mutation": False, "user_movement": 0,
                "rollback_apply": False, "authority_change": False, "production_maturity_change": False,
            },
        }

    def _l3_incident_attempt_count(self, incident_key: str) -> int:
        incidents = self.l3_runtime_state.get("incidents") if isinstance(self.l3_runtime_state.get("incidents"), dict) else {}
        incident = incidents.get(incident_key) if isinstance(incidents.get(incident_key), dict) else {}
        return len([
            row
            for row in (incident.get("attempts") or [])
            if isinstance(row, dict) and self._l3_attempt_consumed_retry_budget(row)
        ])

    @staticmethod
    def _l3_attempt_consumed_retry_budget(row: dict[str, Any]) -> bool:
        terminal_state = str(row.get("terminal_state") or "")
        terminal_outcome = str(row.get("terminal_outcome") or "")
        return bool_value(row.get("applied")) or terminal_state in {
            "APPLIED",
            "ROLLED_BACK",
            "ROLLBACK_FAILED",
            "VERIFY_FAILED",
            "FAILED",
        } or terminal_outcome in {
            "SUCCESS",
            "ROLLBACK_SUCCESS",
            "ROLLBACK_FAILURE",
            "APPLY_FAILURE",
            "VERIFY_FAILED",
        }

    @staticmethod
    def _l3_semantic_attempt_signature(
        moves: list[dict[str, Any]],
        *,
        incident_key: str,
    ) -> str:
        if not incident_key or not moves:
            return ""
        return sha256_json([
            {
                "user_ip": str(move.get("user_ip") or ""),
                "from": str(move.get("current_egress") or ""),
                "to": str(move.get("recommended_egress") or ""),
                "move_type": str(move.get("move_type") or ""),
                "incident_key": incident_key,
            }
            for move in moves
        ])

    def _l3_consumed_retry_attempts(
        self,
        *,
        incident_key: str,
        semantic_attempt_signature: str,
    ) -> list[dict[str, Any]]:
        if not incident_key or not semantic_attempt_signature:
            return []
        incidents = self.l3_runtime_state.get("incidents") if isinstance(self.l3_runtime_state.get("incidents"), dict) else {}
        incident = incidents.get(incident_key) if isinstance(incidents.get(incident_key), dict) else {}
        return [
            row
            for row in (incident.get("attempts") or [])
            if isinstance(row, dict)
            and self._l3_attempt_consumed_retry_budget(row)
            and str(row.get("semantic_attempt_signature") or "") == semantic_attempt_signature
        ]

    def _l3_retry_budget_exhausted_for_move(
        self,
        move: dict[str, Any],
        *,
        target: str,
        incident_source_context: dict[str, Any],
        retry_budget_per_incident: int,
    ) -> dict[str, Any]:
        incident_key = str(incident_source_context.get("incident_key") or "")
        incident_source = str(incident_source_context.get("incident_source") or "")
        if (
            not bool_value(incident_source_context.get("active"))
            or not incident_key
            or not incident_source
            or str(move.get("current_egress") or "") != incident_source
        ):
            return {"exhausted": False}
        candidate = dict(move)
        candidate["recommended_egress"] = target
        signature = self._l3_semantic_attempt_signature([candidate], incident_key=incident_key)
        consumed = self._l3_consumed_retry_attempts(
            incident_key=incident_key,
            semantic_attempt_signature=signature,
        )
        exhausted = bool(consumed) and len(consumed) >= max(0, retry_budget_per_incident)
        return {
            "exhausted": exhausted,
            "incident_key": incident_key,
            "incident_source": incident_source,
            "semantic_attempt_signature": signature,
            "consumed_attempts": len(consumed),
            "retry_budget_per_incident": max(0, retry_budget_per_incident),
            "user_ip": str(candidate.get("user_ip") or ""),
            "current_egress": str(candidate.get("current_egress") or ""),
            "recommended_egress": target,
        }

    def _l3_enabled_users_on_source(self, source: str, *, excluding_users: Optional[set[str]] = None) -> list[str]:
        excluded = excluding_users or set()
        return sorted(
            user.ip
            for user in self.users
            if user.enabled and str(user.current) == source and user.ip not in excluded
        )

    def _l3_required_service_failures_for_source(self, source: str, *, required_services: Optional[list[str]] = None) -> list[dict[str, Any]]:
        matrix_items = self.matrix.get("items") if isinstance(self.matrix.get("items"), dict) else {}
        item = matrix_items.get(source) if isinstance(matrix_items.get(source), dict) else {}
        services = item.get("services") if isinstance(item.get("services"), dict) else {}
        failures: list[dict[str, Any]] = []
        service_ids = normalize_service_ids(required_services or self._required_services())
        if not service_ids:
            service_ids = sorted(str(service) for service in services.keys() if str(service))
        for service in service_ids:
            row = services.get(service) if isinstance(services.get(service), dict) else {}
            status = str(row.get("status") or "").upper()
            truth_class = str(row.get("truth_class") or "")
            failure_samples = self._service_failure_count(row)
            bad_for_seconds = to_float(row.get("bad_for_seconds") or row.get("failed_for_seconds"))
            persistent = (
                truth_class == "PERSISTENT_FAIL"
                or failure_samples >= max(1, to_int(self.service_signal_policy.get("service_failure_persistence_samples"), 3))
                or bad_for_seconds >= max(1, to_int(self.service_signal_policy.get("service_failure_persistence_window_seconds"), 180))
            )
            failed = row.get("ok") is False or row.get("available") is False or status in {"DOWN", "FAIL", "ERROR", "NOT_STARTED"}
            # A source incident must be backed by a durable episode, not a
            # single reset/timeout observed by an otherwise fresh probe.
            if failed and persistent:
                failures.append({
                    "service": service,
                    "status": status or str(row.get("status") or ""),
                    "truth_class": "PERSISTENT_FAIL",
                    "failure_episode_id": str(row.get("failure_episode_id") or ""),
                    "failure_samples": failure_samples,
                    "bad_for_seconds": bad_for_seconds,
                    "observed_at": str(row.get("observed_at") or row.get("tested_at") or ""),
                    "probe_provenance": str(row.get("probe_provenance") or "SERVICE_PROBE_OBSERVED"),
                    "probe_classification": str(row.get("probe_classification") or "FAILURE"),
                    "source_object": "service-matrix.json:items[].services",
                })
        return failures

    def _l3_failed_source_scope(
        self,
        source: str,
        *,
        excluding_users: Optional[set[str]] = None,
        required_services: Optional[list[str]] = None,
    ) -> dict[str, Any]:
        egress = self.egress.get(source)
        affected_users = self._l3_enabled_users_on_source(source, excluding_users=excluding_users)
        severity = str((egress.severity if egress else "") or "").upper()
        diagnose_reason = str((egress.diagnose_reason if egress else "") or "")
        # A source that has just failed may already be marked ``down`` (or
        # have its enabled bit cleared) by the existing health owner. That
        # state is precisely what should trigger recovery for users assigned
        # while the source was healthy. Requiring ``enabled`` here discarded
        # the affected scope before the existing L3 consumer could evaluate
        # its fresh evidence. Administrative ``disabled`` and ``maintenance``
        # remain excluded unless a separate explicit certification owner
        # handles them.
        egress_state = str((egress.state if egress else "") or "").lower()
        enabled = bool(egress and egress.enabled and egress_state not in {"disabled", "down"})
        controlled_failure = self._controlled_certification_failure_context(source)
        channel_failed = bool(egress and severity == "FAIL" and affected_users)
        service_failures = self._l3_required_service_failures_for_source(source, required_services=required_services)
        service_failed = (
            bool(service_failures)
            and bool(affected_users)
            and egress_state not in {"disabled", "maintenance"}
        )
        controlled_channel_failed = bool_value(controlled_failure.get("confirmed"))
        return {
            "schema_version": "v7.l3-incident-source-scope.v1",
            "source": source,
            "enabled": enabled,
            "affected_users": affected_users,
            "affected_users_count": len(affected_users),
            "source_failed": channel_failed or service_failed or controlled_channel_failed,
            "current_channel_failure": channel_failed or controlled_channel_failed,
            "required_service_failure": service_failed,
            "diagnose_severity": severity,
            "diagnose_reason": diagnose_reason,
            "controlled_certification_failure": controlled_failure,
            "required_service_failures": service_failures,
            "owner": "tools/v7-users-autoswitch",
            "source_objects": [
                "l3-runtime-state.json:incidents[].failed_sources",
                "users.registry",
                "v7-state.json",
                "service-matrix.json",
            ],
        }

    def _l3_active_incident_source_context(self) -> dict[str, Any]:
        incidents = self.l3_runtime_state.get("incidents") if isinstance(self.l3_runtime_state.get("incidents"), dict) else {}
        active_statuses = {"OPEN", "READY_FOR_EXECUTION", "INCIDENT_OPEN_STOP_SAFE", "STOP_SAFE", "SUSPENDED"}
        candidates: list[dict[str, Any]] = []
        emergency_enabled = bool_value(self.emergency_failover_policy.get("enabled"))
        for incident_key, row in incidents.items():
            if not isinstance(row, dict):
                continue
            if str(row.get("authority_object") or "") != "EMERGENCY_FAILOVER_AUTONOMY":
                continue
            if str(row.get("status") or "") not in active_statuses:
                continue
            sources = [
                str(item)
                for item in (row.get("failed_sources") or ([row.get("incident_source")] if row.get("incident_source") else []))
                if str(item)
            ]
            for source in sorted(set(sources)):
                scope = self._l3_failed_source_scope(source, required_services=list(row.get("failed_required_services") or []))
                if not bool_value(scope.get("source_failed")):
                    continue
                candidates.append({
                    "incident_key": str(row.get("incident_key") or incident_key),
                    "incident_source": source,
                    "status": str(row.get("status") or ""),
                    "updated_at": str(row.get("updated_at") or ""),
                    "opened_at": str(row.get("opened_at") or ""),
                    "failed_required_services": list(row.get("failed_required_services") or []),
                    "scope": scope,
                    "producer": "tools/v7-users-autoswitch._l3_close_incident_and_update_capability",
                    "consumer": "tools/v7-users-autoswitch.plan",
                    "owner": "tools/v7-users-autoswitch",
                    "reason": "active_failed_source_incident",
                    "continuity_source": "persisted_incident",
                })
        if emergency_enabled:
            observed_sources = sorted({
                str(user.current)
                for user in self.users
                if user.enabled and str(user.current or "")
            })
            persisted_sources = {str(item.get("incident_source") or "") for item in candidates}
            for source in observed_sources:
                if source in persisted_sources:
                    continue
                scope = self._l3_failed_source_scope(source)
                if not bool_value(scope.get("source_failed")):
                    continue
                observed_at = now_iso()
                candidates.append({
                    "incident_key": "",
                    "incident_source": source,
                    "status": "OBSERVED",
                    "updated_at": observed_at,
                    "opened_at": observed_at,
                    "failed_required_services": [],
                    "scope": scope,
                    "producer": "tools/v7-users-autoswitch._l3_failed_source_scope",
                    "consumer": "tools/v7-users-autoswitch.plan",
                    "owner": "tools/v7-users-autoswitch",
                    "reason": "confirmed_failed_source_observation_with_affected_users",
                    "continuity_source": "confirmed_observation",
                })
        if not candidates:
            if not emergency_enabled:
                return {
                    "schema_version": "v7.l3-incident-source-continuity.v1",
                    "active": False,
                    "reason": "emergency_failover_autonomy_not_enabled",
                }
            return {
                "schema_version": "v7.l3-incident-source-continuity.v1",
                "active": False,
                "reason": "no_active_failed_source_incident",
            }
        candidates.sort(
            key=lambda item: (
                1 if bool_value((item.get("scope") or {}).get("current_channel_failure")) else 0,
                to_int((item.get("scope") or {}).get("affected_users_count"), 0),
                1 if bool_value((item.get("scope") or {}).get("required_service_failure")) else 0,
                1 if str(item.get("continuity_source") or "") == "persisted_incident" else 0,
                parse_ts(item.get("updated_at")) or 0,
                str(item.get("incident_source") or ""),
            ),
            reverse=True,
        )
        selected = candidates[0]
        return {
            "schema_version": "v7.l3-incident-source-continuity.v1",
            "active": True,
            "reason": str(selected.get("reason") or "active_failed_source_incident"),
            "incident_key": selected["incident_key"],
            "incident_source": selected["incident_source"],
            "incident_status": selected["status"],
            "failed_required_services": selected["failed_required_services"],
            "affected_users": list((selected.get("scope") or {}).get("affected_users") or []),
            "affected_users_count": to_int((selected.get("scope") or {}).get("affected_users_count"), 0),
            "scope": selected["scope"],
            "continuity_source": str(selected.get("continuity_source") or ""),
            "producer": selected["producer"],
            "consumer": selected["consumer"],
            "owner": selected["owner"],
        }

    def _l3_failed_source_cooldown_override_context(self, user_ip: str, current_egress: str) -> dict[str, Any]:
        context = self._l3_active_incident_source_context()
        requested_source = str(getattr(self.args, "source_egress", "") or "").strip()
        existing_scope = context.get("scope") if isinstance(context.get("scope"), dict) else {}
        if (
            requested_source
            and (
                not bool_value(context.get("active"))
                or str(context.get("incident_source") or "") != requested_source
                or not bool_value(existing_scope.get("source_failed"))
            )
        ):
            requested_scope = self._l3_failed_source_scope(requested_source)
            if bool_value(requested_scope.get("source_failed")):
                context = {
                    "schema_version": "v7.l3-incident-source-continuity.v1",
                    "active": True,
                    "reason": "requested_failed_source_scope",
                    "incident_key": "",
                    "incident_source": requested_source,
                    "incident_status": "OBSERVED",
                    "failed_required_services": list(requested_scope.get("required_service_failures") or []),
                    "affected_users": list(requested_scope.get("affected_users") or []),
                    "affected_users_count": to_int(requested_scope.get("affected_users_count"), 0),
                    "scope": requested_scope,
                    "continuity_source": "requested_source_egress",
                    "producer": "tools/v7-users-autoswitch._l3_failed_source_cooldown_override_context",
                    "consumer": "tools/v7-users-autoswitch._decision_for_user",
                    "owner": "tools/v7-users-autoswitch",
                }
        incident_source = str(context.get("incident_source") or "")
        affected_users = {str(item) for item in (context.get("affected_users") or []) if str(item)}
        scope = context.get("scope") if isinstance(context.get("scope"), dict) else {}
        continuity_source = str(context.get("continuity_source") or "")
        controlled_failure = scope.get("controlled_certification_failure") if isinstance(scope.get("controlled_certification_failure"), dict) else {}
        cooldown_override_source_allowed = (
            continuity_source in {"persisted_incident", "requested_source_egress"}
            or (continuity_source == "confirmed_observation" and bool_value(controlled_failure.get("confirmed")))
        )
        allowed = (
            bool_value(context.get("active"))
            and cooldown_override_source_allowed
            and bool_value(scope.get("source_failed"))
            and incident_source
            and str(current_egress or "") == incident_source
            and (not affected_users or str(user_ip or "") in affected_users)
        )
        if not allowed:
            return {
                "allowed": False,
                "reason": "not_active_failed_source_incident_user",
                "incident_source": incident_source,
            }
        return {
            "schema_version": "v7.l3-failed-source-cooldown-override.v1",
            "allowed": True,
            "reason": "active_failed_source_incident_evacuation",
            "incident_key": str(context.get("incident_key") or ""),
            "incident_source": incident_source,
            "user_ip": str(user_ip or ""),
            "scope_source_failed": bool_value(scope.get("source_failed")),
            "current_channel_failure": bool_value(scope.get("current_channel_failure")),
            "required_service_failure": bool_value(scope.get("required_service_failure")),
            "owner": "tools/v7-users-autoswitch",
            "producer": "tools/v7-users-autoswitch._l3_active_incident_source_context",
            "consumer": "tools/v7-users-autoswitch._decision_for_user/_emergency_failover_move_evidence",
        }

    def _l3_external_wake_events(self, *, late_window_seconds: int) -> list[dict[str, Any]]:
        rows: list[dict[str, Any]] = []
        paths = [
            self.event_dir / "l3-wake-events.jsonl",
            self.event_dir / "service-failure-events.jsonl",
            self.event_dir / "runtime-wake-events.jsonl",
        ]
        now = time.time()
        for path in paths:
            event_window = (
                read_service_failure_event_window(path, limit=200)
                if path.name == "service-failure-events.jsonl"
                else read_jsonl(path, tail_limit=200, tail_max_bytes=4_000_000)
            )
            for event in event_window:
                source = self._l3_normalized_wake_source(
                    event.get("wake_source")
                    or event.get("source")
                    or event.get("event_type")
                    or event.get("reason")
                )
                if not source:
                    continue
                ts_value = event.get("ts") or event.get("observed_at") or event.get("updated") or event.get("created_at")
                event_ts = parse_ts(ts_value)
                late = bool(event_ts and late_window_seconds > 0 and now - event_ts > late_window_seconds)
                channel = str(event.get("current_egress") or event.get("egress") or event.get("channel") or "")
                service = str(event.get("service") or event.get("required_service") or "")
                event_id = str(event.get("event_id") or event.get("id") or "")
                if not event_id:
                    event_id = sha256_json({
                        "source": source,
                        "channel": channel,
                        "service": service,
                        "ts": str(ts_value or ""),
                        "path": str(path.name),
                    })[:24]
                rows.append({
                    "event_id": event_id,
                    "wake_source": source,
                    "channel": channel,
                    "service": service,
                    "late": late,
                    "path": str(path),
                    "ts": str(ts_value or ""),
                    "consumed_by_runtime": False,
                })
        return rows

    def _authority_promotion_truth_check(self) -> dict[str, Any]:
        command = str(getattr(self.args, "authority_promotion_truth_check_command", "") or "v7-truth-check")
        result = {
            "command": command,
            "required": True,
            "returncode": None,
            "passed": False,
            "stdout_tail": "",
            "error": "",
        }
        try:
            proc = subprocess.run(
                [command, "--all", "--json"],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=30,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            result["error"] = str(exc)
            return result
        output = proc.stdout or ""
        result["returncode"] = proc.returncode
        result["stdout_tail"] = output[-2000:]
        parsed: Any = {}
        try:
            parsed = json.loads(output)
        except json.JSONDecodeError:
            parsed = {}
        json_text = json.dumps(parsed, ensure_ascii=False, sort_keys=True) if isinstance(parsed, dict) else output
        result["passed"] = proc.returncode == 0 and (
            "FULLY_ALIGNED" in output
            or '"PASS"' in json_text
            or '"pass"' in json_text.lower()
            or '"PASSED"' in json_text
        )
        if not result["passed"]:
            fallback = self._authority_promotion_runtime_fingerprint_check()
            result["runtime_fingerprint_fallback"] = fallback
            result["passed"] = bool(fallback.get("passed"))
        return result

    def _authority_promotion_runtime_fingerprint_check(self) -> dict[str, Any]:
        fingerprint_path = Path("/opt/v7/runtime-fingerprint.json")
        fingerprint = read_json(fingerprint_path, {})
        rows = fingerprint.get("critical_files") if isinstance(fingerprint, dict) else []
        target_path = "/usr/local/bin/v7-users-autoswitch"
        expected = ""
        if isinstance(rows, list):
            for row in rows:
                if isinstance(row, dict) and row.get("remote_path") == target_path:
                    expected = str(row.get("sha256") or "")
                    break
        actual = sha256_file(Path(target_path))
        passed = bool(
            expected
            and actual
            and expected == actual
            and str(fingerprint.get("commit") or "")
            and str(fingerprint.get("branch") or "")
        )
        return {
            "schema_version": "v7.authority-promotion-runtime-fingerprint-check.v1",
            "fingerprint_path": str(fingerprint_path),
            "branch": str(fingerprint.get("branch") or "") if isinstance(fingerprint, dict) else "",
            "commit": str(fingerprint.get("commit") or "") if isinstance(fingerprint, dict) else "",
            "target_path": target_path,
            "expected_sha256": expected,
            "actual_sha256": actual,
            "passed": passed,
            "truth_source": "existing_safe_deploy_runtime_fingerprint",
        }

    def _emergency_failover_authority_gate(
        self,
        selected: list[dict[str, Any]],
        restore_barrier: dict[str, Any],
        *,
        evidence_candidates: Optional[list[dict[str, Any]]] = None,
    ) -> tuple[list[dict[str, Any]], dict[str, Any]]:
        policy = dict(self.emergency_failover_policy)
        enabled = bool_value(policy.get("enabled"))
        gate: dict[str, Any] = {
            "schema_version": "v7.emergency-failover-autonomy-gate.v1",
            "enabled": enabled,
            "mode": "EMERGENCY_FAILOVER_AUTONOMY" if enabled else "DISABLED",
            "decision": "disabled",
            "ok": False,
            "blockers": [],
            "selected_moves_before_gate": len(selected),
            "selected_moves_after_gate": len(selected),
            "evidence_candidates_before_gate": len(evidence_candidates or selected),
            "max_users_per_run": to_int(policy.get("max_users_per_run"), 1),
            "max_users_per_channel": to_int(policy.get("max_users_per_channel"), 1),
            "require_fresh_evidence": bool_value(policy.get("require_fresh_evidence", True)),
            "require_restore_barrier": bool_value(policy.get("require_restore_barrier", True)),
            "require_rollback": bool_value(policy.get("require_rollback", True)),
            "require_verification": bool_value(policy.get("require_verification", True)),
            "retry_budget_per_incident": max(0, to_int(policy.get("retry_budget_per_incident"), 1)),
            "backoff_seconds": max(0, to_int(policy.get("backoff_seconds"), to_int(policy.get("cooldown_seconds"), 180))),
            "broad_automation_enabled": False,
        }
        approved_validation = restore_barrier.get("approved_plan_lock_validation") if isinstance(restore_barrier.get("approved_plan_lock_validation"), dict) else {}
        approved_envelope = self._approved_l3_production_validation_envelope(selected, restore_barrier, approved_validation)
        gate["approved_production_validation_envelope"] = approved_envelope
        context_moves = list(selected) if selected else list(evidence_candidates or [])
        incident_source_continuity = self._l3_active_incident_source_context()
        engineering_setup_scope = (
            self._exact_controlled_engineering_setup_scope(context_moves)
        )
        engineering_cleanup_scope = (
            self._exact_controlled_engineering_cleanup_scope(context_moves)
        )
        if engineering_setup_scope.get("ok") or engineering_cleanup_scope.get("ok"):
            incident_source_continuity = {
                "schema_version": "v7.l3-incident-source-continuity.v1",
                "active": False,
                "reason": (
                    "independent_exact_controlled_engineering_setup"
                    if engineering_setup_scope.get("ok")
                    else "independent_exact_controlled_engineering_cleanup"
                ),
                "incident_source": "",
                "ordinary_incident_ignored": True,
                "setup_scope": (
                    engineering_setup_scope
                    if engineering_setup_scope.get("ok")
                    else engineering_cleanup_scope
                ),
                "owner": "tools/v7-users-autoswitch",
            }
        requested_source = str(getattr(self.args, "source_egress", "") or "").strip()
        if (
            requested_source
            and bool_value(incident_source_continuity.get("active"))
            and str(incident_source_continuity.get("incident_source") or "") != requested_source
        ):
            requested_scope = self._l3_failed_source_scope(requested_source)
            if bool_value(requested_scope.get("source_failed")):
                incident_source_continuity = {
                    "schema_version": "v7.l3-incident-source-continuity.v1",
                    "active": True,
                    "reason": "requested_failed_source_scope",
                    "incident_key": "",
                    "incident_source": requested_source,
                    "incident_status": "OBSERVED",
                    "failed_required_services": list(requested_scope.get("required_service_failures") or []),
                    "affected_users": list(requested_scope.get("affected_users") or []),
                    "affected_users_count": to_int(requested_scope.get("affected_users_count"), 0),
                    "scope": requested_scope,
                    "continuity_source": "requested_source_egress",
                    "producer": "tools/v7-users-autoswitch._emergency_failover_authority_gate",
                    "consumer": "tools/v7-users-autoswitch._emergency_failover_authority_gate",
                    "owner": "tools/v7-users-autoswitch",
                    "overrode_incident_source": str(incident_source_continuity.get("incident_source") or ""),
                    "override_reason": "requested_source_egress_has_failed_source_scope",
                }
        gate["incident_source_continuity"] = incident_source_continuity
        runtime_axes = (
            policy.get("runtime_scope_axes")
            if isinstance(policy.get("runtime_scope_axes"), dict)
            else {}
        )
        scope = (
            incident_source_continuity.get("scope")
            if isinstance(incident_source_continuity.get("scope"), dict)
            else {}
        )
        controlled_failure = (
            scope.get("controlled_certification_failure")
            if isinstance(scope.get("controlled_certification_failure"), dict)
            else {}
        )
        availability_first_scope = (
            self._exact_availability_first_controlled_scope(context_moves)
        )
        context_source = str(incident_source_continuity.get("incident_source") or "")
        if availability_first_scope.get("ok"):
            context_source = str(
                (availability_first_scope.get("sources") or [""])[0]
            )
        controlled_members = []
        for move in context_moves:
            user_ip = str(move.get("user_ip") or "")
            source = str(move.get("current_egress") or "")
            proof = self._controlled_certification_failure_context(source, user_ip=user_ip)
            controlled_members.append({
                "user_ip": user_ip,
                "source": source,
                "confirmed": bool_value(proof.get("confirmed")),
                "certification_user_in_scope": bool_value(proof.get("certification_user_in_scope")),
            })
        exact_controlled_context = bool(
            availability_first_scope.get("ok")
            or (
                context_moves
                and context_source
                and bool_value(controlled_failure.get("confirmed"))
                and all(
                    row["confirmed"]
                    and row["certification_user_in_scope"]
                    and row["source"] == context_source
                    for row in controlled_members
                )
            )
        )
        ordinary_runtime_max = max(
            0,
            to_int(
                runtime_axes.get("ordinary_production_runtime_max"),
                policy.get("max_users_per_run", 1),
            ),
        )
        controlled_runtime_max = max(
            0,
            to_int(
                runtime_axes.get("controlled_certification_runtime_max"),
                ordinary_runtime_max,
            ),
        )
        selected_runtime_max = (
            controlled_runtime_max if exact_controlled_context else ordinary_runtime_max
        )
        gate["runtime_scope"] = {
            "schema_version": "v7.service-failure-execution-context-proof.v1",
            "context": (
                "AVAILABILITY_FIRST_CONTROLLED_CERTIFICATION_CONTEXT"
                if availability_first_scope.get("ok")
                else "CONTROLLED_CERTIFICATION_CONTEXT"
                if exact_controlled_context
                else "ORDINARY_PRODUCTION_SERVICE_FAILURE"
            ),
            "exact_controlled_context": exact_controlled_context,
            "incident_source": context_source,
            "member_count": len(controlled_members),
            "member_scope_fingerprint": sha256_json(controlled_members),
            "raw_member_list_stored": False,
            "authority_approved_max": to_int(runtime_axes.get("authority_approved_max"), 0),
            "controlled_certification_runtime_max": controlled_runtime_max,
            "ordinary_production_runtime_max": ordinary_runtime_max,
            "selected_runtime_max": selected_runtime_max,
            "contract_rewritten": False,
            "authority_expanded": False,
            "availability_first_controlled_scope": (
                availability_first_scope
            ),
        }
        if not enabled:
            gate["wake"] = self._l3_wake_decision(policy, [])
            return selected, gate
        blockers: list[str] = []
        if (
            gate["require_restore_barrier"]
            and not bool_value(restore_barrier.get("failover_quarantine"))
            and not bool_value(approved_envelope.get("ok"))
        ):
            blockers.append("restore_barrier_required_for_emergency_failover")
        if gate["require_rollback"] and not bool_value(getattr(self.args, "rollback_on_verify_fail", False)):
            blockers.append("rollback_required_for_emergency_failover")
        if gate["require_verification"] and not bool_value(getattr(self.args, "verify", False)):
            blockers.append("verification_required_for_emergency_failover")

        eligible: list[dict[str, Any]] = []
        per_move: list[dict[str, Any]] = []
        selected_keys = {
            (
                str(move.get("user_ip") or ""),
                str(move.get("current_egress") or ""),
                str(move.get("recommended_egress") or ""),
                str(move.get("move_type") or ""),
            )
            for move in selected
        }
        # The action-class contract is an execution gate, not an observation
        # gate.  When it suppresses selected moves, retain the exact
        # pre-contract bounded shadow selection solely to derive a fresh L3
        # wake.  It cannot create a Candidate, Packet, lease or mutation: only
        # rows that still survive the contract gate may enter `eligible`.
        evidence_source = list(selected) if selected else list(evidence_candidates or [])
        incident_source = str(incident_source_continuity.get("incident_source") or "")
        for move in evidence_source:
            if (
                not availability_first_scope.get("ok")
                and bool_value(incident_source_continuity.get("active"))
                and str(move.get("current_egress") or "") != incident_source
            ):
                blockers.append("incident_source_selected_move_mismatch")
            if availability_first_scope.get("ok"):
                evidence = {
                    "schema_version": (
                        "v7.availability-first-controlled-move-evidence.v1"
                    ),
                    "ok": True,
                    "blockers": [],
                    "user_ip": str(move.get("user_ip") or ""),
                    "current_egress": str(
                        move.get("current_egress") or ""
                    ),
                    "recommended_egress": str(
                        move.get("recommended_egress") or ""
                    ),
                    "event_provenance": "CONTROLLED_CERTIFICATION",
                    "natural_production_credit": False,
                    "authority_source": (
                        "ACTIVE_STANDING_AVAILABILITY_FIRST_POLICY"
                    ),
                }
            else:
                evidence = self._emergency_failover_move_evidence(move)
            per_move.append(evidence)
            move_key = (
                str(move.get("user_ip") or ""),
                str(move.get("current_egress") or ""),
                str(move.get("recommended_egress") or ""),
                str(move.get("move_type") or ""),
            )
            if evidence.get("ok") and move_key in selected_keys:
                eligible.append(move)
            else:
                blockers.extend(str(reason) for reason in evidence.get("blockers") or [])

        max_run = min(
            selected_runtime_max,
            max(0, to_int(policy.get("max_users_per_run"), selected_runtime_max or 1)),
        )
        max_channel = min(
            selected_runtime_max,
            max(0, to_int(policy.get("max_users_per_channel"), max_run or 1)),
        )
        if exact_controlled_context:
            # The global policy is intentionally narrowed to the ordinary
            # floor.  Only this exact member/source proof may consume the
            # separately projected controlled-certification ceiling.
            max_run = controlled_runtime_max
            max_channel = controlled_runtime_max
        if bool_value(approved_envelope.get("ok")):
            approved_run_limit = max(0, min(
                to_int(approved_envelope.get("selected_move_count"), len(eligible)),
                to_int(approved_envelope.get("clearance_max_selected_moves"), len(eligible)),
                to_int(approved_envelope.get("authorized_l3_budget"), len(eligible)),
            ))
            approved_target_counts: dict[str, int] = {}
            for move in selected:
                target = str(move.get("recommended_egress") or "")
                if target:
                    approved_target_counts[target] = approved_target_counts.get(target, 0) + 1
            if approved_run_limit > 0:
                max_run = approved_run_limit
            if approved_target_counts:
                max_channel = max(approved_target_counts.values())
        per_target_counts: dict[str, int] = {}
        bounded: list[dict[str, Any]] = []
        for move in eligible:
            if len(bounded) >= max_run:
                break
            target = str(move.get("recommended_egress") or "")
            count = per_target_counts.get(target, 0)
            if count >= max_channel:
                blockers.append("emergency_target_channel_limit_reached")
                continue
            row = dict(move)
            row["execution_mode"] = "emergency_failover"
            row.setdefault("reason", []).append("emergency_failover_autonomy_authorized")
            bounded.append(row)
            per_target_counts[target] = count + 1

        if not selected:
            blockers.append("no_selected_moves_for_emergency_failover")
        if selected and not bounded and not blockers:
            blockers.append("no_emergency_eligible_failover_moves")
        if selected and gate["retry_budget_per_incident"] < 1:
            blockers.append("l3_retry_budget_exhausted")

        wake = (
            {
                "schema_version": "v7.l3-wake-decision.v1",
                "accepted": True,
                "blockers": [],
                "reason": (
                    "availability_first_standing_policy_packet_consumption"
                ),
                "event_provenance": "CONTROLLED_CERTIFICATION",
                "natural_production_credit": False,
            }
            if availability_first_scope.get("ok")
            else self._l3_wake_decision(policy, per_move)
        )
        if not wake.get("accepted"):
            blockers.extend(str(reason) for reason in wake.get("blockers") or [])
        failed_sources = sorted({
            str(row.get("current_egress") or "")
            for row in per_move
            if row.get("current_failures")
        })
        channel_failed_sources = sorted({
            str(((row.get("current_channel_failure") or {}).get("channel")) or row.get("current_egress") or "")
            for row in per_move
            if bool_value((row.get("current_channel_failure") or {}).get("confirmed"))
        })
        failed_sources = sorted(set(failed_sources) | set(channel_failed_sources))
        failed_services = sorted({
            str(item.get("service") or "")
            for row in per_move
            for item in (row.get("current_failures") or [])
            if item.get("service")
        })
        incident_services = failed_services or (["current_channel_failure"] if channel_failed_sources else [])
        generation = str((self.generation or {}).get("planner_generation_id") or "")
        incident_key = ""
        previous_attempts = 0
        semantic_attempt_signature = ""
        if failed_sources and incident_services:
            if (
                bool_value(incident_source_continuity.get("active"))
                and incident_source in failed_sources
                and str(incident_source_continuity.get("incident_key") or "")
            ):
                incident_key = str(incident_source_continuity.get("incident_key") or "")
                gate["incident_source_continuity"] = {
                    **incident_source_continuity,
                    "incident_key_reused": True,
                    "incident_key_reuse_reason": "active_failed_source_incident_continuation",
                }
            else:
                incident_key = self._l3_incident_key(
                    source_channels=failed_sources,
                    services=incident_services,
                    authority=str(gate.get("mode") or "EMERGENCY_FAILOVER_AUTONOMY"),
                    generation=generation,
                )["key"]
            previous_attempts = self._l3_incident_attempt_count(incident_key)
            if bounded:
                semantic_attempt_signature = self._l3_semantic_attempt_signature(bounded, incident_key=incident_key)
            duplicate_consumed_attempts = self._l3_consumed_retry_attempts(
                incident_key=incident_key,
                semantic_attempt_signature=semantic_attempt_signature,
            )
            if duplicate_consumed_attempts:
                blockers.append("duplicate_apply_attempt")
                if len(duplicate_consumed_attempts) >= gate["retry_budget_per_incident"]:
                    blockers.append("l3_retry_budget_exhausted")
        gate["move_evidence"] = per_move
        gate["move_evidence_source"] = (
            "selected_moves" if selected else "pre_contract_shadow_selection_read_only"
        )
        gate["wake"] = wake
        gate["incident_key"] = incident_key
        gate["previous_attempts"] = previous_attempts
        gate["semantic_attempt_signature"] = semantic_attempt_signature
        gate["failed_sources"] = failed_sources
        gate["failed_required_services"] = failed_services
        gate["effective_max_users_per_run"] = max_run
        gate["effective_max_users_per_channel"] = max_channel
        gate["blockers"] = sorted(set(blockers))
        gate["ok"] = bool(bounded) and not gate["blockers"]
        gate["selected_moves_after_gate"] = len(bounded) if gate["ok"] else 0
        if (
            gate["ok"]
            and bool_value(approved_envelope.get("ok"))
            and availability_first_scope.get("ok")
        ):
            gate["decision"] = (
                "authorize_availability_first_controlled_certification_envelope"
            )
            gate["authority_source"] = (
                "active_standing_availability_first_policy"
            )
            gate["production_validation_only"] = True
            gate["autonomy_certified"] = False
            gate["event_provenance"] = "CONTROLLED_CERTIFICATION"
            gate["natural_production_credit"] = False
        elif gate["ok"] and bool_value(approved_envelope.get("ok")):
            gate["decision"] = (
                "authorize_governed_production_validation_envelope"
                if len(bounded) > 1
                else "authorize_one_user_production_validation_envelope"
            )
            gate["authority_source"] = "current_approved_emergency_envelope"
            gate["production_validation_only"] = True
            gate["autonomy_certified"] = False
        else:
            gate["decision"] = "authorize_bounded_emergency_failover" if gate["ok"] else "block_emergency_failover"
            gate["authority_source"] = "certified_emergency_failover_policy" if gate["ok"] else ""
            gate["production_validation_only"] = False
            gate["autonomy_certified"] = bool(gate["ok"])
        return bounded if gate["ok"] else [], gate

    def _approved_l3_production_validation_envelope(
        self,
        selected: list[dict[str, Any]],
        restore_barrier: dict[str, Any],
        approved_lock: dict[str, Any],
    ) -> dict[str, Any]:
        authorized_budget = max(1, to_int(self.authority_budget_policy.get("current_allowed_user_budget"), 1))
        selected_count = len(selected)
        approved_count = to_int(approved_lock.get("selected_move_count"), selected_count)
        clearance_max = to_int(restore_barrier.get("clearance_max_selected_moves"), authorized_budget)
        expected: list[dict[str, Any]] = [
            {
                "condition": "l3_production_validation_mode",
                "expected": True,
                "actual": bool_value(getattr(self.args, "emergency_failover_autonomy", False))
                and bool_value(getattr(self.args, "apply", False)),
                "owner": "tools/v7-governed-canary-dry-run-cycle",
                "applies_to_l3_production_validation": True,
            },
            {
                "condition": "selected_moves_within_authorized_l3_budget",
                "expected": True,
                "actual": 1 <= selected_count <= authorized_budget,
                "owner": "tools/v7-users-autoswitch",
                "applies_to_l3_production_validation": True,
                "authorized_l3_budget": authorized_budget,
            },
            {
                "condition": "approved_plan_lock_valid",
                "expected": True,
                "actual": bool_value(approved_lock.get("ok")),
                "owner": "tools/v7-users-autoswitch._approved_plan_lock_validation",
                "applies_to_l3_production_validation": True,
            },
            {
                "condition": "restore_barrier_clearance_valid",
                "expected": True,
                "actual": bool_value(restore_barrier.get("cleared"))
                and str(restore_barrier.get("clearance_guard_reason") or "") in {
                    "restore_barrier_clearance_budget_and_generation_ok",
                    "restore_barrier_clearance_preview_packet_identity_match",
                    "restore_barrier_clearance_generation_match_source_bundle_lease",
                    "restore_barrier_clearance_budget_ok",
                },
                "owner": "admin_core/operator_execution.py",
                "applies_to_l3_production_validation": True,
            },
            {
                "condition": "selected_move_hash_matches",
                "expected": True,
                "actual": bool(selected)
                and str(approved_lock.get("selected_move_hash") or "")
                == str(restore_barrier.get("clearance_selected_moves_hash") or approved_lock.get("selected_move_hash") or ""),
                "owner": "admin_core/operator_execution.py",
                "applies_to_l3_production_validation": True,
            },
            {
                "condition": "verify_enabled",
                "expected": True,
                "actual": bool_value(getattr(self.args, "verify", False)),
                "owner": "tools/v7-users-autoswitch",
                "applies_to_l3_production_validation": True,
            },
            {
                "condition": "rollback_on_verify_fail_enabled",
                "expected": True,
                "actual": bool_value(getattr(self.args, "rollback_on_verify_fail", False)),
                "owner": "tools/v7-users-autoswitch",
                "applies_to_l3_production_validation": True,
            },
            {
                "condition": "approved_batch_scope_within_authorized_l3_budget",
                "expected": True,
                "actual": selected_count >= 1
                and approved_count == selected_count
                and selected_count <= clearance_max
                and clearance_max <= authorized_budget,
                "owner": "admin_core/operator_execution.py",
                "applies_to_l3_production_validation": True,
                "authorized_l3_budget": authorized_budget,
            },
        ]
        selected_users = [str(move.get("user_ip") or "") for move in selected]
        selected_targets = sorted({str(move.get("recommended_egress") or "") for move in selected if move.get("recommended_egress")})
        allowed_users = [str(item) for item in (restore_barrier.get("allowed_users") or approved_lock.get("selected_users") or [])]
        allowed_targets = sorted(str(item) for item in (restore_barrier.get("allowed_targets") or approved_lock.get("selected_targets") or []))
        expected.append({
            "condition": "user_and_target_scope_match",
            "expected": True,
            "actual": bool(selected) and sorted(selected_users) == sorted(allowed_users) and selected_targets == allowed_targets,
            "owner": "tools/v7-users-autoswitch._approved_plan_lock_validation",
            "applies_to_l3_production_validation": True,
        })
        failed = [row for row in expected if row["actual"] != row["expected"]]
        return {
            "schema_version": "v7.l3-production-validation-envelope-gate.v1",
            "ok": not failed,
            "conditions": expected,
            "failed_conditions": [str(row["condition"]) for row in failed],
            "authority_source": "current_approved_emergency_envelope" if not failed else "",
            "production_validation_only": True,
            "broad_automation_enabled": False,
            "autonomy_certified": False,
        }

    def _emergency_failover_move_evidence(self, move: dict[str, Any]) -> dict[str, Any]:
        blockers: list[str] = []
        user_ip = str(move.get("user_ip") or "")
        reasons = [str(reason) for reason in (move.get("reason") or [])]
        if str(move.get("move_type") or "") != "failover":
            blockers.append("emergency_allows_failover_only")
        if "current_egress_not_eligible" not in reasons:
            blockers.append("current_egress_not_eligible_required")

        current_id = str(move.get("current_egress") or "")
        target_id = str(move.get("recommended_egress") or "")
        candidates = move.get("candidates") if isinstance(move.get("candidates"), list) else []
        current = next((row for row in candidates if str(row.get("egress") or "") == current_id), {})
        target = next((row for row in candidates if str(row.get("egress") or "") == target_id), {})
        current_channel_failure = self._current_channel_failure_evidence(current, user_ip=user_ip)
        if not bool_value(current_channel_failure.get("confirmed")) and current_id:
            controlled_current_failure = self._controlled_certification_failure_context(current_id, user_ip=user_ip)
            if bool_value(controlled_current_failure.get("confirmed")):
                current_channel_failure = controlled_current_failure
        current_channel_failure_confirmed = bool_value(current_channel_failure.get("confirmed"))
        if current and bool_value(current.get("eligible")) and not current_channel_failure_confirmed:
            blockers.append("current_candidate_still_eligible")
        if not target or not bool_value(target.get("eligible")):
            blockers.append("safe_target_required")
        target_load = target.get("load") if isinstance(target.get("load"), dict) else {}
        if str(target_load.get("status") or "OK") in {"HARD_FULL", "FAILOVER_FULL"}:
            blockers.append("target_load_gate_failed")

        required_services = normalize_service_ids(move.get("important_services") or [])
        current_service = current.get("service_suitability") if isinstance(current.get("service_suitability"), dict) else {}
        target_service = target.get("service_suitability") if isinstance(target.get("service_suitability"), dict) else {}
        current_failures: list[dict[str, Any]] = []
        per_service = current_service.get("per_service") if isinstance(current_service.get("per_service"), dict) else {}
        for service in required_services:
            row = per_service.get(service) if isinstance(per_service.get(service), dict) else {}
            status = str(row.get("status") or "").upper()
            truth_class = str(row.get("truth_class") or "")
            if (
                row.get("available") is False
                or truth_class == "PERSISTENT_FAIL"
                or status in {"DOWN", "FAIL", "ERROR", "NOT_STARTED"}
            ):
                current_failures.append(row)
        if not current_failures and not current_channel_failure_confirmed:
            blockers.append("required_service_failure_required")
        if bool_value(self.emergency_failover_policy.get("require_fresh_evidence", True)):
            stale_failures = [
                row for row in current_failures
                if str(((row.get("freshness") or {}).get("state") or "")) not in {"FRESH", "AGING"}
            ]
            if stale_failures and not current_channel_failure_confirmed:
                blockers.append("fresh_service_failure_evidence_required")
            freshness_state = str(((current_channel_failure.get("freshness") or {}).get("state") or ""))
            if current_channel_failure and freshness_state not in {"FRESH", "AGING"}:
                blockers.append("fresh_channel_failure_evidence_required")
        if target_service.get("required_missing") or target_service.get("required_low"):
            blockers.append("target_required_services_not_ready")
        cooldown = max(0, to_int(self.emergency_failover_policy.get("cooldown_seconds"), 180))
        cooldown_remaining = 0
        cooldown_override = self._l3_failed_source_cooldown_override_context(user_ip, current_id)
        last = self.last_switch.get(user_ip)
        if cooldown > 0 and last:
            age = max(0.0, time.time() - last)
            if age < cooldown:
                cooldown_remaining = int(cooldown - age)
                if not bool_value(cooldown_override.get("allowed")):
                    blockers.append("emergency_failover_cooldown_active")

        return {
            "user_ip": user_ip,
            "current_egress": current_id,
            "recommended_egress": target_id,
            "ok": not blockers,
            "blockers": sorted(set(blockers)),
            "cooldown_remaining_seconds": cooldown_remaining,
            "cooldown_override": cooldown_override if bool_value(cooldown_override.get("allowed")) else {},
            "current_channel_failure": current_channel_failure,
            "current_failures": [
                {
                    "service": row.get("service"),
                    "status": row.get("status"),
                    "truth_class": row.get("truth_class"),
                    "freshness": row.get("freshness"),
                }
                for row in current_failures
            ],
        }

    def _ordinary_service_failure_execution_eligibility(
        self,
        plan: dict[str, Any],
    ) -> dict[str, Any]:
        """Validate one Matrix-confirmed ordinary failure before apply.

        Ordinary service-failure recovery is not an emergency-authority
        transaction, so it must not be forced through the emergency incident
        readiness gate.  This narrow owner check retains the independent
        mutable checks needed by the existing route writer: one ordinary live
        identity, unchanged failed source, eligible target, fresh failure and
        target service evidence, and no certification identity.
        """
        selected = [
            move for move in (plan.get("selected_moves") or [])
            if isinstance(move, dict)
        ]
        operation = plan.get("operation") if isinstance(plan.get("operation"), dict) else {}
        blockers: list[str] = []
        if not bool_value(getattr(self.args, "ordinary_service_failure_context", False)):
            blockers.append("ordinary_service_failure_context_required")
        if len(selected) != 1:
            blockers.append("ordinary_service_failure_requires_exactly_one_move")
        if not str(operation.get("selected_move_hash") or ""):
            blockers.append("selected_move_hash_missing")
        checked_moves: list[dict[str, Any]] = []
        live_users = {
            user.ip: user
            for user in self._load_runtime_registry_users()
        }
        live_egress = self._load_egress()
        for move in selected:
            user_ip = str(move.get("user_ip") or "")
            source_id = str(move.get("current_egress") or "")
            target_id = str(move.get("recommended_egress") or "")
            move_blockers: list[str] = []
            user = live_users.get(user_ip)
            source = live_egress.get(source_id)
            target = live_egress.get(target_id)
            if not user or not user.enabled:
                move_blockers.append("user_not_live_or_disabled")
            elif bool_value((user.raw or {}).get("certification_user")):
                move_blockers.append("certification_identity_not_allowed")
            elif user.current != source_id:
                move_blockers.append("source_user_state_changed_before_apply")
            if not source:
                move_blockers.append("source_channel_missing_before_apply")
            if not target or not target.enabled or str(target.state).lower() in {"disabled", "down"}:
                move_blockers.append("target_not_eligible_before_apply")
            if source_id == target_id:
                move_blockers.append("source_target_same_before_apply")
            evidence = self._ordinary_service_failure_move_evidence(move)
            move_blockers.extend(str(item) for item in (evidence.get("blockers") or []))
            checked_moves.append({
                "user_ip": user_ip,
                "source": source_id,
                "target": target_id,
                "blockers": sorted(set(move_blockers)),
                "current_channel_failure": evidence.get("current_channel_failure") or {},
                "target_service": evidence.get("current_failures") or [],
            })
            blockers.extend(move_blockers)
        return {
            "schema_version": "v7.ordinary-service-failure-execution-eligibility.v1",
            "active": True,
            "ok": not blockers,
            "decision": "EXECUTE_ORDINARY_SERVICE_FAILURE" if not blockers else "STOP_SAFE",
            "blockers": sorted(set(blockers)),
            "checked_moves": checked_moves,
            "owner": "tools/v7-users-autoswitch existing service-failure consumer",
            "runtime_mutation": False,
        }

    def _ordinary_service_failure_move_evidence(
        self,
        move: dict[str, Any],
    ) -> dict[str, Any]:
        """Apply the existing live Matrix evidence gates to one failed source."""
        blockers: list[str] = []
        user_ip = str(move.get("user_ip") or "")
        current_id = str(move.get("current_egress") or "")
        target_id = str(move.get("recommended_egress") or "")
        candidates = move.get("candidates") if isinstance(move.get("candidates"), list) else []
        current = next((row for row in candidates if str(row.get("egress") or "") == current_id), {})
        target = next((row for row in candidates if str(row.get("egress") or "") == target_id), {})
        current_failure = self._current_channel_failure_evidence(current, user_ip=user_ip)
        if not bool_value(current_failure.get("confirmed")) and current_id:
            controlled_failure = self._controlled_certification_failure_context(current_id, user_ip=user_ip)
            if bool_value(controlled_failure.get("confirmed")):
                current_failure = controlled_failure
        # A profile's explicitly selected services are the ordinary recovery
        # contract. Ranking may inspect additional best-effort services, but
        # an independently confirmed persistent failure of one required
        # service is enough to recover that profile. It must not be promoted
        # into a claim that the whole channel has failed.
        required_services = normalize_service_ids(
            move.get("profile_required_services")
            if "profile_required_services" in move
            else move.get("important_services") or []
        )
        current_service = current.get("service_suitability") if isinstance(current.get("service_suitability"), dict) else {}
        target_service = target.get("service_suitability") if isinstance(target.get("service_suitability"), dict) else {}
        current_failures: list[dict[str, Any]] = []
        per_service = current_service.get("per_service") if isinstance(current_service.get("per_service"), dict) else {}
        for service in required_services:
            row = per_service.get(service) if isinstance(per_service.get(service), dict) else {}
            status = str(row.get("status") or "").upper()
            truth_class = str(row.get("truth_class") or "")
            if row.get("available") is False or truth_class == "PERSISTENT_FAIL" or status in {"DOWN", "FAIL", "ERROR", "NOT_STARTED"}:
                current_failures.append(row)
        fresh_profile_failure = any(
            str(row.get("truth_class") or "") == "PERSISTENT_FAIL"
            and str(((row.get("freshness") or {}).get("state") or "")) in {"FRESH", "AGING"}
            for row in current_failures
        )
        source_failure_confirmed = (
            bool_value(current_failure.get("confirmed"))
            or fresh_profile_failure
        )
        if not source_failure_confirmed:
            blockers.append("fresh_profile_or_channel_failure_evidence_required")
        if current and bool_value(current.get("eligible")) and not source_failure_confirmed:
            blockers.append("current_candidate_still_eligible")
        if not target or not bool_value(target.get("eligible")):
            blockers.append("safe_target_required")
        target_load = target.get("load") if isinstance(target.get("load"), dict) else {}
        if str(target_load.get("status") or "OK") in {"HARD_FULL", "FAILOVER_FULL"}:
            blockers.append("target_load_gate_failed")
        if not current_failures and not bool_value(current_failure.get("confirmed")):
            blockers.append("required_service_failure_required")
        stale_failures = [
            row for row in current_failures
            if str(((row.get("freshness") or {}).get("state") or "")) not in {"FRESH", "AGING"}
        ]
        if stale_failures and not bool_value(current_failure.get("confirmed")):
            blockers.append("fresh_service_failure_evidence_required")
        if target_service.get("required_missing") or target_service.get("required_low"):
            blockers.append("target_required_services_not_ready")
        return {
            "ok": not blockers,
            "blockers": sorted(set(blockers)),
            "current_channel_failure": current_failure,
            "profile_required_services": required_services,
            "profile_service_failure_confirmed": fresh_profile_failure,
            "current_failures": [
                {"service": row.get("service"), "status": row.get("status"), "truth_class": row.get("truth_class"), "freshness": row.get("freshness")}
                for row in current_failures
            ],
        }

    def _state_file_freshness(self) -> dict[str, Any]:
        max_age = max(1, to_int(self.quality_policy.get("metrics_fresh_seconds"), DEFAULT_QUALITY_POLICY["metrics_fresh_seconds"]))
        path = self.state_dir / "v7-state.json"
        try:
            mtime = path.stat().st_mtime
        except OSError:
            return {
                "state": "UNKNOWN",
                "age_seconds": None,
                "max_age_seconds": max_age,
                "path": str(path),
                "runtime_behavior": "fail_closed_if_required",
            }
        age = max(0.0, time.time() - mtime)
        return {
            "state": "FRESH" if age <= max_age else "STALE",
            "age_seconds": round(age, 3),
            "max_age_seconds": max_age,
            "path": str(path),
            "observed_at": datetime.fromtimestamp(mtime, timezone.utc).isoformat(),
            "runtime_behavior": "use_existing_observation" if age <= max_age else "fail_closed_if_required",
        }

    def _file_freshness(self, path: Path) -> dict[str, Any]:
        max_age = max(1, to_int(self.quality_policy.get("metrics_fresh_seconds"), DEFAULT_QUALITY_POLICY["metrics_fresh_seconds"]))
        try:
            mtime = path.stat().st_mtime
        except OSError:
            return {
                "state": "UNKNOWN",
                "age_seconds": None,
                "max_age_seconds": max_age,
                "path": str(path),
                "runtime_behavior": "fail_closed_if_required",
            }
        age = max(0.0, time.time() - mtime)
        return {
            "state": "FRESH" if age <= max_age else "STALE",
            "age_seconds": round(age, 3),
            "max_age_seconds": max_age,
            "path": str(path),
            "observed_at": datetime.fromtimestamp(mtime, timezone.utc).isoformat(),
            "runtime_behavior": "use_existing_production_registry" if age <= max_age else "fail_closed_if_required",
        }

    def _controlled_certification_failure_context(self, source: str, *, user_ip: str = "") -> dict[str, Any]:
        egress_rows = getattr(self, "egress", {})
        egress_rows = egress_rows if isinstance(egress_rows, dict) else {}
        egress = egress_rows.get(source)
        if not egress:
            return {"confirmed": False, "reason": "source_not_found"}
        registry = egress.raw.get("registry") if isinstance(egress.raw.get("registry"), dict) else {}
        controlled_source = bool_value(registry.get("controlled_certification_source"))
        egress_state = str(egress.state or "").lower()
        source_unavailable = (not egress.enabled) or egress_state in {"maintenance", "disabled", "quarantine", "down"}
        certification_users = sorted(
            user.ip
            for user in (getattr(self, "users", []) or [])
            if user.enabled
            and str(user.current) == source
            and bool_value(user.raw.get("certification_user"))
        )
        user_in_scope = (not user_ip) or user_ip in set(certification_users)
        freshness = self._file_freshness(self.state_dir / "egress.registry")
        confirmed = (
            controlled_source
            and source_unavailable
            and bool(certification_users)
            and user_in_scope
            and str(freshness.get("state") or "") in {"FRESH", "AGING"}
        )
        return {
            "schema_version": "v7.controlled-certification-current-channel-failure.v1",
            "confirmed": confirmed,
            "wake_source": "confirmed_current_channel_failure",
            "channel": source,
            "controlled_certification": controlled_source,
            "source_unavailable": source_unavailable,
            "egress_enabled": bool(egress.enabled),
            "egress_state": egress_state,
            "affected_user": user_ip,
            "certification_user_in_scope": user_in_scope,
            "affected_users_on_channel": len(certification_users),
            "certification_users": certification_users,
            "diagnose_reason": "controlled_certification_source_unavailable",
            "block_reason": f"egress_state_{egress_state}" if egress_state else "egress_disabled",
            "freshness": freshness,
            "producer": "tools/v7-users-autoswitch._controlled_certification_failure_context",
            "source_object": "egress.registry:controlled_certification_source + users.registry:certification_user + egress.registry enabled/state",
            "owner": "tools/v7-users-autoswitch",
            "authority_expanded": False,
            "runtime_apply_allowed_now": False,
        }

    def _current_channel_failure_evidence(self, current: dict[str, Any], *, user_ip: str) -> dict[str, Any]:
        if not isinstance(current, dict) or not current:
            return {}
        controlled = self._controlled_certification_failure_context(str(current.get("egress") or ""), user_ip=user_ip)
        if bool_value(controlled.get("confirmed")):
            return controlled
        severity = current.get("severity_classification") if isinstance(current.get("severity_classification"), dict) else {}
        reason = str(severity.get("reason") or "")
        hard_block = bool_value(severity.get("hard_block"))
        severity_value = str(severity.get("severity") or "").upper()
        channel_state = str(current.get("state") or "").lower()
        affected_users = to_int(current.get("users"), 0)
        freshness = self._state_file_freshness()
        hard_channel_reason = (
            reason == "interface_down_or_missing"
            or reason in CURRENT_CHANNEL_FAILURE_REASONS
            or (severity_value == "FAIL" and channel_state == "down")
        )

        # Matrix is the canonical health owner.  A healthy v7-health process
        # can refresh service-matrix.json while the legacy v7-state projection
        # remains old; requiring that stale projection here would hide the
        # exact clients whose channel has just failed.  Accept a channel-level
        # failure only when a fresh Matrix generation shows a clear majority
        # of service probes failing.  A single service failure remains a
        # service-specific degradation and cannot trigger whole-channel
        # failover.
        matrix_row = (
            (self.matrix.get("items") or {}).get(str(current.get("egress") or ""))
            if isinstance(self.matrix, dict)
            else {}
        )
        matrix_row = matrix_row if isinstance(matrix_row, dict) else {}
        matrix_services = matrix_row.get("services") if isinstance(matrix_row.get("services"), dict) else {}
        matrix_checked_at = str(matrix_row.get("checked_at") or matrix_row.get("updated") or "")
        matrix_age = -1.0
        if matrix_checked_at:
            try:
                matrix_age = max(0.0, time.time() - parse_ts(matrix_checked_at))
            except (TypeError, ValueError):
                matrix_age = -1.0
        matrix_fresh_limit = max(
            1,
            to_int(
                self.service_signal_policy.get("service_truth_fresh_seconds"),
                900,
            ),
        )
        matrix_fresh = bool(
            matrix_age >= 0.0
            and matrix_age <= max(1800, matrix_fresh_limit)
        )
        matrix_failed_services = [
            str(service_id)
            for service_id, service_row in matrix_services.items()
            if isinstance(service_row, dict)
            and (
                service_row.get("ok") is False
                or str(service_row.get("status") or "").upper()
                in {"FAIL", "DOWN", "ERROR"}
            )
        ]
        matrix_failure_rows = [
            row for row in matrix_services.values()
            if isinstance(row, dict)
            and (
                row.get("ok") is False
                or str(row.get("status") or "").upper()
                in {"FAIL", "DOWN", "ERROR"}
            )
        ]
        matrix_first_failed_ns = min(
            (
                to_int(row.get("first_failed_observation_monotonic_ns"), 0)
                for row in matrix_failure_rows
                if to_int(row.get("first_failed_observation_monotonic_ns"), 0) > 0
            ),
            default=0,
        )
        matrix_confirmed_failed_ns = max(
            (
                to_int(row.get("confirmed_hard_failure_monotonic_ns"), 0)
                for row in matrix_failure_rows
            ),
            default=0,
        )
        matrix_clock_domain = next(
            (
                str(row.get("monotonic_clock_domain") or "")
                for row in matrix_failure_rows
                if str(row.get("monotonic_clock_domain") or "")
            ),
            "",
        )
        matrix_total_services = len(matrix_services)
        matrix_failure_threshold = max(
            2,
            int(math.ceil(matrix_total_services * 0.5))
            if matrix_total_services
            else 2,
        )
        matrix_channel_failure = bool(
            matrix_fresh
            and affected_users > 0
            and matrix_total_services > 0
            and len(matrix_failed_services) >= matrix_failure_threshold
        )
        if matrix_channel_failure:
            return {
                "schema_version": "v7.confirmed-current-channel-failure-evidence.v1",
                "confirmed": True,
                "wake_source": "confirmed_current_channel_failure",
                "channel": str(current.get("egress") or ""),
                "affected_user": user_ip,
                "affected_users_on_channel": affected_users,
                "severity": "FAIL",
                "diagnose_reason": "service_matrix_majority_failure",
                "matrix_failed_services": matrix_failed_services,
                "matrix_failed_service_count": len(matrix_failed_services),
                "matrix_total_service_count": matrix_total_services,
                "matrix_failure_threshold": matrix_failure_threshold,
                "first_failed_observation_monotonic_ns": matrix_first_failed_ns,
                "confirmed_hard_failure_monotonic_ns": matrix_confirmed_failed_ns,
                "monotonic_clock_domain": matrix_clock_domain,
                "block_reason": "fresh_matrix_majority_channel_failure",
                "freshness": {
                    "state": "FRESH",
                    "age_seconds": round(matrix_age, 3),
                    "max_age_seconds": max(1800, matrix_fresh_limit),
                    "checked_at": matrix_checked_at,
                    "source": "service-matrix.json",
                },
                "producer": "tools/v7-users-autoswitch._current_channel_failure_evidence",
                "source_object": "service-matrix.json:current egress service failures + users.registry assignment",
                "owner": "tools/v7-service-matrix-test",
                "authority_expanded": False,
                "runtime_apply_allowed_now": False,
            }
        confirmed = (
            hard_block
            and severity_value == "FAIL"
            and hard_channel_reason
            and affected_users > 0
            and str(freshness.get("state") or "") in {"FRESH", "AGING"}
        )
        if not (hard_block or severity_value == "FAIL" or reason):
            return controlled if bool_value(controlled.get("confirmed")) else {}
        return {
            "schema_version": "v7.confirmed-current-channel-failure-evidence.v1",
            "confirmed": confirmed,
            "wake_source": "confirmed_current_channel_failure",
            "channel": str(current.get("egress") or ""),
            "affected_user": user_ip,
            "affected_users_on_channel": affected_users,
            "severity": severity_value,
            "diagnose_reason": reason,
            "block_reason": str(severity.get("block_reason") or ""),
            "freshness": freshness,
            "first_failed_observation_monotonic_ns": to_int(
                current.get("first_failed_observation_monotonic_ns"), 0
            ),
            "confirmed_hard_failure_monotonic_ns": to_int(
                current.get("confirmed_hard_failure_monotonic_ns"), 0
            ),
            "monotonic_clock_domain": str(
                current.get("monotonic_clock_domain") or ""
            ),
            "producer": "tools/v7-users-autoswitch._emergency_failover_move_evidence",
            "source_object": "v7-state.json:egress[].diagnose_severity/diagnose_reason + users.registry assignment",
            "owner": "tools/v7-users-autoswitch",
            "authority_expanded": False,
            "runtime_apply_allowed_now": False,
        }

    def _l3_normalized_wake_source(self, value: Any) -> str:
        raw = str(value or "").strip().lower().replace("-", "_").replace(" ", "_")
        aliases = {
            "service_failure": "confirmed_service_failure",
            "service_regression": "confirmed_service_failure",
            "current_channel_failure": "confirmed_current_channel_failure",
            "hard_failure": "confirmed_current_channel_failure",
            "channel_unavailable": "confirmed_current_channel_failure",
            "incident_resume": "verified_incident_resume",
            "runtime_resume": "recorded_runtime_resume",
            "poll": "blind_polling",
            "blind_poll": "blind_polling",
            "synthetic": "synthetic_wake",
            "optimization": "optimization_wake",
        }
        return aliases.get(raw, raw)

    def _l3_wake_decision(self, policy: dict[str, Any], move_evidence: list[dict[str, Any]]) -> dict[str, Any]:
        allowed = {
            self._l3_normalized_wake_source(item)
            for item in (policy.get("allowed_wake_sources") or [])
        } or set(DEFAULT_EMERGENCY_FAILOVER_AUTONOMY_POLICY["allowed_wake_sources"])
        rejected = {
            self._l3_normalized_wake_source(item)
            for item in (policy.get("rejected_wake_sources") or [])
        } or set(DEFAULT_EMERGENCY_FAILOVER_AUTONOMY_POLICY["rejected_wake_sources"])
        requested = self._l3_normalized_wake_source(policy.get("wake_source"))
        inferred: set[str] = set()
        observed_events: list[dict[str, Any]] = []
        failed_sources = sorted({
            str(row.get("current_egress") or "")
            for row in move_evidence
            if row.get("current_failures")
        })
        channel_failed_sources = sorted({
            str(((row.get("current_channel_failure") or {}).get("channel")) or row.get("current_egress") or "")
            for row in move_evidence
            if bool_value((row.get("current_channel_failure") or {}).get("confirmed"))
        })
        failed_sources = sorted(set(failed_sources) | set(channel_failed_sources))
        incident_source = failed_sources[0] if len(failed_sources) == 1 else ""
        failed_services = sorted({
            str(item.get("service") or "")
            for row in move_evidence
            for item in (row.get("current_failures") or [])
            if item.get("service")
        })
        if failed_sources and failed_services:
            inferred.update({"confirmed_service_failure", "confirmed_current_channel_failure"})
            observed_events.append({
                "event_id": sha256_json({
                    "wake_source": "confirmed_service_failure",
                    "failed_sources": failed_sources,
                    "failed_services": failed_services,
                    "generation": str((self.generation or {}).get("planner_generation_id") or ""),
                })[:24],
                "wake_source": "confirmed_service_failure",
                "channel": ",".join(failed_sources),
                "service": ",".join(failed_services),
                "late": False,
                "path": "inferred:service-matrix",
                "ts": now_iso(),
                "consumed_by_runtime": False,
            })
        if channel_failed_sources:
            inferred.add("confirmed_current_channel_failure")
            event_payload = {
                "wake_source": "confirmed_current_channel_failure",
                "failed_sources": channel_failed_sources,
                "generation": str((self.generation or {}).get("planner_generation_id") or ""),
                "failure_reasons": sorted({
                    str((row.get("current_channel_failure") or {}).get("diagnose_reason") or "")
                    for row in move_evidence
                    if bool_value((row.get("current_channel_failure") or {}).get("confirmed"))
                }),
            }
            observed_events.append({
                "event_id": sha256_json(event_payload)[:24],
                "wake_source": "confirmed_current_channel_failure",
                "channel": ",".join(channel_failed_sources),
                "service": "",
                "late": False,
                "path": "inferred:v7-state-current-channel-failure",
                "ts": now_iso(),
                "consumed_by_runtime": False,
            })
        observed_events.extend(
            self._l3_external_wake_events(
                late_window_seconds=max(0, to_int(policy.get("late_event_window_seconds"), 300))
            )
        )

        blockers: list[str] = []
        accepted_sources: list[str] = []
        if requested:
            if requested in rejected:
                blockers.append(f"rejected_wake_source_{requested}")
            elif requested not in allowed:
                blockers.append(f"unknown_l3_wake_source_{requested}")
            else:
                accepted_sources.append(requested)
        for event in observed_events:
            source = self._l3_normalized_wake_source(event.get("wake_source"))
            if bool_value(event.get("late")):
                continue
            if source in allowed and source not in rejected and source not in accepted_sources:
                accepted_sources.append(source)
        accepted_sources.extend(sorted(source for source in inferred if source in allowed and source not in accepted_sources))
        if not accepted_sources and not blockers:
            blockers.append("confirmed_l3_wake_required")
        accepted = bool(accepted_sources) and not blockers
        consumed_events = []
        for event in observed_events:
            source = self._l3_normalized_wake_source(event.get("wake_source"))
            consumed = accepted and source in accepted_sources and not bool_value(event.get("late"))
            row = dict(event)
            row["consumed_by_runtime"] = consumed
            consumed_events.append(row)
        return {
            "schema_version": "v7.l3-wake-decision.v1",
            "decision": "ACCEPT_WAKE" if accepted else "REJECT_WAKE",
            "accepted": accepted,
            "requested_wake_source": requested,
            "accepted_wake_sources": accepted_sources,
            "rejected_wake_sources": sorted(rejected),
            "allowed_wake_sources": sorted(allowed),
            "failed_sources": failed_sources,
            "failed_services": failed_services,
            "observed_events": consumed_events,
            "consumed_event_ids": [
                str(event.get("event_id") or "")
                for event in consumed_events
                if bool_value(event.get("consumed_by_runtime")) and str(event.get("event_id") or "")
            ],
            "late_event_ids": [
                str(event.get("event_id") or "")
                for event in consumed_events
                if bool_value(event.get("late")) and str(event.get("event_id") or "")
            ],
            "blockers": sorted(set(blockers)),
            "wake_may_grant_execution": False,
            "runtime_apply_allowed_now": accepted,
            "authority_expanded": False,
        }

    def _l3_incident_key(self, *, source_channels: list[str], services: list[str], authority: str, generation: str) -> dict[str, Any]:
        components = {
            "source_channels": sorted(str(item) for item in source_channels if str(item)),
            "failure_family": "CURRENT_CHANNEL_FAILED",
            "service_family": sorted(str(item) for item in services if str(item)),
            "authority_envelope": authority or "EMERGENCY_FAILOVER_AUTONOMY",
            "generation": generation,
        }
        return {
            "schema_version": "v7.l3-incident-key.v1",
            "key": sha256_json(components)[:24],
            "components": components,
        }

    def _l3_behavior_contracts(
        self,
        *,
        gate: dict[str, Any],
        incident_key: str,
        incident_state: str,
        selected: list[dict[str, Any]],
        move_evidence: list[dict[str, Any]],
        target_channels: list[str],
        affected_users: list[str],
    ) -> dict[str, Any]:
        policy = dict(self.emergency_failover_policy)
        retry_budget = max(0, to_int(policy.get("retry_budget_per_incident"), 1))
        backoff = max(0, to_int(policy.get("backoff_seconds"), to_int(policy.get("cooldown_seconds"), 180)))
        duplicate_window = max(0, to_int(policy.get("duplicate_event_window_seconds"), 300))
        late_window = max(0, to_int(policy.get("late_event_window_seconds"), 300))
        blockers = [str(item) for item in (gate.get("blockers") or [])]
        selected_count = len(selected)
        terminal = "READY" if bool_value(gate.get("ok")) else ("BUDGET_EXHAUSTED" if "l3_retry_budget_exhausted" in blockers else "STOP_SAFE")

        def row(
            behavior: str,
            *,
            purpose: str,
            trigger: str,
            decision: str,
            owner: str,
            stop_safe: list[str],
            learning: str,
            outcome: Optional[str] = None,
        ) -> dict[str, Any]:
            return {
                "behavior": behavior,
                "implementation_status": "EXISTS_EXTENDED",
                "purpose": purpose,
                "trigger": trigger,
                "decision": decision,
                "terminal_outcome": outcome or terminal,
                "existing_owner": owner,
                "stop_safe_conditions": stop_safe,
                "operator_visibility": True,
                "learning_impact": learning,
                "new_owner_created": False,
            }

        rows = [
            row(
                "Event Collapse",
                purpose="Collapse equivalent L3 wake signals into one incident key.",
                trigger="same failed source/service/authority/generation",
                decision="COLLAPSE_ON_INCIDENT_KEY",
                owner="tools/v7-users-autoswitch._l3_incident_key",
                stop_safe=["event_unmapped_to_generation", "authority_or_blast_radius_boundary_crossed"],
                learning="collapsed duplicate observations are evidence context, not extra outcomes",
            ),
            row(
                "Incident Merge",
                purpose="Attach equivalent events to the active incident instead of creating a duplicate incident.",
                trigger="matching incident key",
                decision="MERGE_BY_INCIDENT_KEY",
                owner="tools/v7-users-autoswitch._l3_incident_context",
                stop_safe=["merge_key_incomplete", "merge_crosses_authority_boundary"],
                learning="merged events enrich incident context",
            ),
            row(
                "Incident Split",
                purpose="Separate materially different source/service/authority/generation failures.",
                trigger="different incident key dimensions",
                decision="SPLIT_ON_MATERIAL_KEY_CHANGE",
                owner="tools/v7-users-autoswitch._l3_incident_key",
                stop_safe=["split_dimension_unknown", "generation_missing"],
                learning="split incidents preserve failure-family identity",
            ),
            row(
                "Retry Budget",
                purpose="Prevent repeated unsafe L3 attempts.",
                trigger="retry or replay after STOP_SAFE/failure/timeout",
                decision="ALLOW_ONE_ATTEMPT" if retry_budget >= 1 else "STOP_SAFE_BUDGET_EXHAUSTED",
                owner="tools/v7-users-autoswitch._emergency_failover_authority_gate",
                stop_safe=["l3_retry_budget_exhausted", "duplicate_apply_attempt"],
                learning="budget exhaustion is safety evidence, not success evidence",
                outcome="READY" if retry_budget >= 1 else "BUDGET_EXHAUSTED",
            ),
            row(
                "Backoff",
                purpose="Reuse cooldown as L3 backoff before another governed/autonomous attempt.",
                trigger="recent movement or retry consideration",
                decision=f"BACKOFF_SECONDS_{backoff}",
                owner="tools/v7-users-autoswitch._emergency_failover_move_evidence",
                stop_safe=["emergency_failover_cooldown_active"],
                learning="cooldown/backoff blocks are anti-flap evidence",
            ),
            row(
                "Target Lost Before Apply",
                purpose="Stop if the selected target disappears before commit/apply.",
                trigger="live target missing or disabled during final eligibility",
                decision="LIVE_TARGET_RECHECK",
                owner="tools/v7-users-autoswitch._l3_execution_eligibility",
                stop_safe=["target_lost_before_apply", "target_not_eligible_before_apply"],
                learning="target loss becomes runtime eligibility evidence",
            ),
            row(
                "Partial Success",
                purpose="Preserve mixed terminal results without hiding failure.",
                trigger="multiple selected moves have mixed terminal classifications",
                decision="CLASSIFY_PARTIAL_SUCCESS",
                owner="tools/v7-users-autoswitch.apply",
                stop_safe=["partial_apply_requires_terminal_classification"],
                learning="partial success does not become full success evidence",
                outcome="PARTIAL_SUCCESS",
            ),
            row(
                "Verification Timeout",
                purpose="Treat service verification timeout as non-success.",
                trigger="required service verification timeout",
                decision="ROLLBACK_OR_STOP_SAFE_ON_TIMEOUT",
                owner="tools/v7-users-autoswitch._verify_emergency_required_services",
                stop_safe=["required_service_verify_timeout"],
                learning="timeout becomes verification-quality evidence, not success evidence",
            ),
            row(
                "Unknown State Quarantine",
                purpose="Fail closed if incident state is not recognized as executable.",
                trigger="incident_state != READY_FOR_EXECUTION",
                decision="STOP_SAFE_UNKNOWN_OR_NONREADY_STATE",
                owner="tools/v7-users-autoswitch._l3_execution_eligibility",
                stop_safe=["l3_incident_not_ready"],
                learning="unknown state becomes workflow safety evidence",
                outcome="STOP_SAFE" if incident_state not in {"READY_FOR_EXECUTION", "NO_INCIDENT_DISABLED", "NO_INCIDENT_NO_EVIDENCE"} else terminal,
            ),
            row(
                "Recovery During Execution",
                purpose="Do not chase recovery mid-transaction; finish verify/rollback/closure.",
                trigger="source recovers after decision but before terminal closure",
                decision="KEEP_TRANSACTION_ATOMIC_UNTIL_TERMINAL_STATE",
                owner="tools/v7-users-autoswitch.apply",
                stop_safe=["live_validation_or_verification_fails"],
                learning="recovery during execution is recorded as incident context",
            ),
            row(
                "Recovery After Suspend",
                purpose="Require a new wake/resume decision after suspended L3 work.",
                trigger="incident resumes after STOP_SAFE/suspend",
                decision="REQUIRE_VERIFIED_INCIDENT_OR_RUNTIME_RESUME_WAKE",
                owner="tools/v7-users-autoswitch._l3_wake_decision",
                stop_safe=["confirmed_l3_wake_required"],
                learning="resume events are observations until execution occurs",
            ),
            row(
                "Late Event Handling",
                purpose="Prevent late/stale signals from starting unsafe execution.",
                trigger=f"event arrives outside {late_window}s L3 late-event window or stale generation",
                decision="REQUIRE_CURRENT_GENERATION",
                owner="tools/v7-users-autoswitch._l3_incident_key",
                stop_safe=["event_unmapped_to_generation", "generation_missing"],
                learning="late events are context evidence only",
            ),
            row(
                "Budget Exhaustion",
                purpose="Expose budget exhaustion as terminal safety state.",
                trigger="attempt budget exhausted",
                decision="STOP_SAFE_BUDGET_EXHAUSTED" if retry_budget < 1 else "BUDGET_AVAILABLE",
                owner="tools/v7-users-autoswitch._emergency_failover_authority_gate",
                stop_safe=["l3_retry_budget_exhausted"],
                learning="budget exhaustion never increases success or promotion evidence",
                outcome="BUDGET_EXHAUSTED" if retry_budget < 1 else terminal,
            ),
            row(
                "Duplicate Event Suppression",
                purpose="Prevent duplicate events/replays from causing duplicate apply.",
                trigger=f"same semantic event inside {duplicate_window}s duplicate-event window",
                decision="SUPPRESS_DUPLICATE_BY_INCIDENT_AND_SELECTED_MOVE_HASH",
                owner="tools/v7-users-autoswitch._l3_incident_context",
                stop_safe=["duplicate_apply_attempt", "selected_move_hash_mismatch"],
                learning="duplicates may complete closure but never add another outcome",
            ),
        ]
        return {
            "schema_version": "v7.l3-production-behavior-contracts.v1",
            "incident_key": incident_key,
            "incident_state": incident_state,
            "selected_count": selected_count,
            "affected_users": affected_users,
            "target_channels": target_channels,
            "retry_budget_per_incident": retry_budget,
            "backoff_seconds": backoff,
            "duplicate_event_window_seconds": duplicate_window,
            "late_event_window_seconds": late_window,
            "behaviors": rows,
            "all_required_behaviors_mapped": len(rows) == 14,
            "new_behavior_framework_created": False,
        }

    def _l3_operator_surface(self, incident: dict[str, Any], gate: dict[str, Any], selected: list[dict[str, Any]]) -> dict[str, Any]:
        behaviors = incident.get("production_behavior_contracts") if isinstance(incident.get("production_behavior_contracts"), dict) else {}
        target_channels = [str(move.get("recommended_egress") or "") for move in selected if str(move.get("recommended_egress") or "")]
        execution_state = "READY" if bool_value(gate.get("ok")) else ("DISABLED" if not bool_value(gate.get("enabled")) else "STOP_SAFE")
        return {
            "schema_version": "v7.l3-operator-surface.v1",
            "incident": str(incident.get("incident_key") or ""),
            "reason": "CURRENT_CHANNEL_FAILED",
            "failed_channel": list(incident.get("failed_sources") or []),
            "affected_users": list(incident.get("affected_users") or []),
            "selected_target": target_channels,
            "authority": str(incident.get("authority_object") or "EMERGENCY_FAILOVER_AUTONOMY"),
            "execution_state": execution_state,
            "verification": "REQUIRED",
            "rollback": "REQUIRED",
            "behavior_reason": "production_behavior_contracts_mapped",
            "terminal_outcome": str(incident.get("terminal_outcome") or ""),
            "next_action": "execute_l3_transaction_if_authorized" if bool_value(gate.get("ok")) else "STOP_SAFE",
            "behavior_contract_count": len(behaviors.get("behaviors") or []),
            "new_ui_framework_created": False,
        }

    def _l3_production_validation_ladder(self, incident: dict[str, Any], gate: dict[str, Any]) -> dict[str, Any]:
        gate_ready = bool_value(gate.get("ok")) and str(incident.get("incident_state") or "") == "READY_FOR_EXECUTION"
        levels = [
            ("DRY_RUN", 0),
            ("ONE_USER", 1),
            ("TWO_USERS", 2),
            ("FIVE_USERS", 5),
            ("TEN_USERS", 10),
            ("REMAINING_USERS", None),
        ]
        rows: list[dict[str, Any]] = []
        for index, (name, users) in enumerate(levels):
            rows.append({
                "level": name,
                "max_users": users,
                "status": "READY_FOR_VALIDATION" if index == 0 and gate_ready else ("WAITING_FOR_PREVIOUS_LEVEL" if index > 0 else "WAITING_FOR_READY_L3_TRANSACTION"),
                "requires_verification": True,
                "requires_rollback_proof": True,
                "requires_learning": True,
                "requires_engineering_report": True,
                "requires_omp_evidence": True,
                "runtime_apply_performed_by_ladder": False,
            })
        return {
            "schema_version": "v7.l3-production-validation-ladder.v1",
            "owner": "tools/v7-users-autoswitch",
            "levels": rows,
            "current_level": rows[0]["level"],
            "current_level_status": rows[0]["status"],
            "runtime_automation_enabled": False,
            "authority_expanded": False,
            "users_moved_by_read_model": 0,
            "new_validation_owner_created": False,
        }

    def _l3_certification_pipeline(self, incident: dict[str, Any], validation_ladder: dict[str, Any]) -> dict[str, Any]:
        checks = [
            ("tests", "PASS_REQUIRED"),
            ("behavior", "PASS_REQUIRED"),
            ("verification", "PASS_REQUIRED"),
            ("rollback", "PASS_REQUIRED"),
            ("production", "PASS_REQUIRED"),
            ("learning", "PASS_REQUIRED"),
            ("omp_certification", "PASS_REQUIRED"),
        ]
        rows = [
            {
                "check": name,
                "required": required,
                "status": "PENDING_PRODUCTION_CERTIFICATION",
            }
            for name, required in checks
        ]
        return {
            "schema_version": "v7.l3-certification-pipeline.v1",
            "owner": "tools/v7-users-autoswitch + OMP",
            "certification_state": "NOT_CERTIFIED_PENDING_PRODUCTION_VALIDATION",
            "checks": rows,
            "l3_certified": False,
            "requires_production_validation_ladder": validation_ladder.get("schema_version") == "v7.l3-production-validation-ladder.v1",
            "runtime_automation_enabled": False,
            "authority_expanded": False,
            "new_certification_owner_created": False,
        }

    def _l3_runtime_incident_record(
        self,
        *,
        incident_key: str,
        incident_state: str,
        key_components: dict[str, Any],
        gate: dict[str, Any],
        selected: list[dict[str, Any]],
        operation: dict[str, Any],
    ) -> dict[str, Any]:
        incidents = self.l3_runtime_state.get("incidents") if isinstance(self.l3_runtime_state.get("incidents"), dict) else {}
        existing = incidents.get(incident_key) if isinstance(incidents.get(incident_key), dict) else {}
        now = now_iso()
        same_key_exists = bool(existing)
        split_from = [
            key
            for key, row in incidents.items()
            if key != incident_key
            and isinstance(row, dict)
            and str(row.get("authority_object") or "") == "EMERGENCY_FAILOVER_AUTONOMY"
            and str(row.get("status") or "") in {"OPEN", "READY_FOR_EXECUTION", "STOP_SAFE", "SUSPENDED"}
            and set(row.get("failed_sources") or []).intersection(set(gate.get("failed_sources") or []))
        ]
        lifecycle_transition = "updated" if same_key_exists else ("split" if split_from else "opened")
        attempts = [row for row in (existing.get("attempts") or []) if isinstance(row, dict)]
        consumed_event_ids = [
            str(item)
            for item in (((gate.get("wake") or {}).get("consumed_event_ids") or []))
            if str(item)
        ]
        processed = set(str(item) for item in (self.l3_runtime_state.get("processed_event_ids") or []))
        collapsed_duplicates = [event_id for event_id in consumed_event_ids if event_id in processed]
        new_events = [event_id for event_id in consumed_event_ids if event_id not in processed]
        record_failed_sources = list(gate.get("failed_sources") or [])
        record_incident_source = str(record_failed_sources[0] if len(record_failed_sources) == 1 else "")
        return {
            "schema_version": "v7.l3-runtime-incident-record.v1",
            "incident_key": incident_key,
            "status": "READY_FOR_EXECUTION" if incident_state == "READY_FOR_EXECUTION" else ("STOP_SAFE" if incident_state == "INCIDENT_OPEN_STOP_SAFE" else incident_state),
            "incident_state": incident_state,
            "lifecycle_transition": lifecycle_transition,
            "opened_at": existing.get("opened_at") or now,
            "updated_at": now,
            "closed_at": existing.get("closed_at", ""),
            "authority_object": "EMERGENCY_FAILOVER_AUTONOMY",
            "key_components": key_components,
            "failed_sources": record_failed_sources,
            "incident_source": record_incident_source,
            "failed_required_services": list(gate.get("failed_required_services") or []),
            "selected_users": [str(move.get("user_ip") or "") for move in selected if str(move.get("user_ip") or "")],
            "target_channels": [str(move.get("recommended_egress") or "") for move in selected if str(move.get("recommended_egress") or "")],
            "operation_id": str(operation.get("operation_id") or ""),
            "selected_move_hash": str(operation.get("selected_move_hash") or ""),
            "semantic_attempt_signature": str(gate.get("semantic_attempt_signature") or ""),
            "attempts": attempts,
            "attempt_count": len(attempts),
            "retry_budget_per_incident": max(0, to_int(gate.get("retry_budget_per_incident"), 1)),
            "event_collapse": {
                "consumed_event_ids": consumed_event_ids,
                "new_event_ids": new_events,
                "collapsed_duplicate_event_ids": collapsed_duplicates,
                "consumed_by_runtime": bool(consumed_event_ids),
            },
            "incident_merge": {
                "merged": same_key_exists,
                "merge_key": incident_key if same_key_exists else "",
                "consumer": "tools/v7-users-autoswitch._l3_execution_eligibility",
            },
            "incident_split": {
                "split": bool(split_from),
                "split_from": split_from,
                "consumer": "tools/v7-users-autoswitch._l3_execution_eligibility",
            },
            "consumed": incident_state == "READY_FOR_EXECUTION",
            "consumer": "tools/v7-users-autoswitch.apply",
            "feeds_next_runtime_cycle": True,
        }

    def _l3_incident_context(
        self,
        gate: dict[str, Any],
        selected: list[dict[str, Any]],
        *,
        selected_hash: str,
        operation: dict[str, Any],
    ) -> dict[str, Any]:
        move_evidence = [row for row in (gate.get("move_evidence") or []) if isinstance(row, dict)]
        failed_sources = sorted({
            str(row.get("current_egress") or "")
            for row in move_evidence
            if row.get("current_failures")
        })
        channel_failed_sources = sorted({
            str(((row.get("current_channel_failure") or {}).get("channel")) or row.get("current_egress") or "")
            for row in move_evidence
            if bool_value((row.get("current_channel_failure") or {}).get("confirmed"))
        })
        failed_sources = sorted(set(failed_sources) | set(channel_failed_sources))
        incident_source = failed_sources[0] if len(failed_sources) == 1 else ""
        failed_services = sorted({
            str(item.get("service") or "")
            for row in move_evidence
            for item in (row.get("current_failures") or [])
            if item.get("service")
        })
        incident_services = failed_services or (["current_channel_failure"] if channel_failed_sources else [])
        failure_clock_rows = [
            row.get("current_channel_failure")
            for row in move_evidence
            if isinstance(row.get("current_channel_failure"), dict)
        ]
        first_failed_observation_ns = min(
            (
                to_int(row.get("first_failed_observation_monotonic_ns"), 0)
                for row in failure_clock_rows
                if to_int(row.get("first_failed_observation_monotonic_ns"), 0) > 0
            ),
            default=0,
        )
        confirmed_hard_failure_ns = max(
            (
                to_int(row.get("confirmed_hard_failure_monotonic_ns"), 0)
                for row in failure_clock_rows
            ),
            default=0,
        )
        monotonic_clock_domain = next(
            (
                str(row.get("monotonic_clock_domain") or "")
                for row in failure_clock_rows
                if str(row.get("monotonic_clock_domain") or "")
            ),
            "",
        )
        affected_users = sorted({
            str(row.get("user_ip") or "")
            for row in move_evidence
            if row.get("user_ip")
        })
        target_channels = sorted({
            str(move.get("recommended_egress") or "")
            for move in selected
            if str(move.get("recommended_egress") or "")
        })
        generation = str((self.generation or {}).get("planner_generation_id") or "")
        key = self._l3_incident_key(
            source_channels=failed_sources,
            services=incident_services,
            authority=str(gate.get("mode") or "EMERGENCY_FAILOVER_AUTONOMY"),
            generation=generation,
        )
        if str(gate.get("incident_key") or ""):
            key["key"] = str(gate.get("incident_key") or "")
        enabled = bool_value(gate.get("enabled"))
        if not enabled:
            state = "NO_INCIDENT_DISABLED"
        elif not move_evidence:
            state = "NO_INCIDENT_NO_EVIDENCE"
        elif bool_value(gate.get("ok")):
            state = "READY_FOR_EXECUTION"
        else:
            state = "INCIDENT_OPEN_STOP_SAFE"
        incident = {
            "schema_version": "v7.l3-incident-context.v1",
            "incident_state": state,
            "incident_key": key["key"],
            "incident_key_components": key["components"],
            "incident_generation": generation,
            "authority_object": "EMERGENCY_FAILOVER_AUTONOMY",
            "allowed_move": "FAILOVER",
            "allowed_reason": "CURRENT_CHANNEL_FAILED",
            "affected_users": affected_users,
            "failed_sources": failed_sources,
            "incident_source": incident_source,
            "incident_source_continuity": gate.get("incident_source_continuity", {}),
            "failed_required_services": failed_services,
            "first_failed_observation_monotonic_ns": first_failed_observation_ns,
            "confirmed_hard_failure_monotonic_ns": confirmed_hard_failure_ns,
            "monotonic_clock_domain": monotonic_clock_domain,
            "confirmed_current_channel_failures": [
                row.get("current_channel_failure")
                for row in move_evidence
                if bool_value((row.get("current_channel_failure") or {}).get("confirmed"))
            ],
            "target_channels": target_channels,
            "selected_move_hash": selected_hash,
            "operation_id": str(operation.get("operation_id") or ""),
            "event_collapse": {
                "enabled": True,
                "collapsed_event_count": len(move_evidence),
                "collapse_key": key["key"],
                "runtime_apply_allowed_now": False,
            },
            "incident_merge": {
                "same_key_merges": True,
                "merge_key": key["key"],
                "new_framework_created": False,
            },
            "incident_split": {
                "different_source_service_authority_or_generation_splits": True,
                "split_dimensions": ["source_channels", "service_family", "authority_envelope", "generation"],
                "new_framework_created": False,
            },
            "planner_consumption": {
                "planner_owner": "tools/v7-users-autoswitch",
                "affected_users": affected_users,
                "safe_target": target_channels[0] if len(target_channels) == 1 else "",
                "blocked_reason": ",".join(str(item) for item in (gate.get("blockers") or [])),
                "selected_move_hash": selected_hash,
                "runtime_replaced_planner": False,
            },
            "operator_visibility": {
                "show_incident": enabled and bool(move_evidence),
                "show_reason": "CURRENT_CHANNEL_FAILED",
                "show_blockers": list(gate.get("blockers") or []),
                "show_selected_users": affected_users,
                "show_target_channels": target_channels,
            },
            "terminal_outcome": "NOT_EXECUTED_PHASE1",
            "runtime_apply_allowed_now": False,
            "authority_expanded": False,
            "new_incident_framework_created": False,
        }
        runtime_record = self._l3_runtime_incident_record(
            incident_key=key["key"],
            incident_state=state,
            key_components=key["components"],
            gate=gate,
            selected=selected,
            operation=operation,
        )
        incident["runtime_lifecycle"] = runtime_record
        incident["opened"] = runtime_record["lifecycle_transition"] == "opened"
        incident["updated"] = runtime_record["lifecycle_transition"] == "updated"
        incident["merged"] = bool_value(runtime_record["incident_merge"].get("merged"))
        incident["split"] = bool_value(runtime_record["incident_split"].get("split"))
        incident["consumed"] = bool_value(runtime_record.get("consumed"))
        incident["production_behavior_contracts"] = self._l3_behavior_contracts(
            gate=gate,
            incident_key=key["key"],
            incident_state=state,
            selected=selected,
            move_evidence=move_evidence,
            target_channels=target_channels,
            affected_users=affected_users,
        )
        incident["operator_surface"] = self._l3_operator_surface(incident, gate, selected)
        incident["production_validation_ladder"] = self._l3_production_validation_ladder(incident, gate)
        incident["certification_pipeline"] = self._l3_certification_pipeline(incident, incident["production_validation_ladder"])
        return incident

    def _authority_promotion_feedback_paths(self) -> dict[str, list[Path]]:
        return {
            "outcome": [self.state_dir / "execution-events.jsonl"],
            "trust": [self.state_dir / "runtime-trust.jsonl"],
            "prediction": [self.state_dir / "execution-events.jsonl"],
            "recommendation": [
                self.state_dir / "proposal-records.jsonl",
                self.state_dir / "proposals.jsonl",
            ],
            "closure": [self.state_dir / "closure-records.jsonl"],
        }

    def _authority_feedback_records_for_operation(self, operation_id: str) -> dict[str, list[dict[str, Any]]]:
        paths = self._authority_promotion_feedback_paths()
        result: dict[str, list[dict[str, Any]]] = {}
        schema_markers = {
            "outcome": "execution-outcome",
            "trust": "execution-trust",
            "prediction": "execution-prediction",
            "recommendation": "execution-recommendation",
            "closure": "execution-feedback-closure",
        }
        for kind, path in paths.items():
            marker = schema_markers[kind]
            matches: list[dict[str, Any]] = []
            for item_path in path:
                for row in read_live_owner_history_window(item_path):
                    schema = str(row.get("schema_version") or "")
                    if marker not in schema:
                        continue
                    raw = json.dumps(row, ensure_ascii=False, sort_keys=True)
                    if operation_id not in raw:
                        continue
                    matches.append(row)
            result[kind] = matches
        return result

    def _authority_promotion_stability_window_seconds(self, target_class: str, records: dict[str, list[dict[str, Any]]]) -> int:
        policy = self.authority_budget_policy
        target_key = normalize_authority_class(target_class).lower()
        policy_keys = [
            f"{target_key}_stable_runtime_truth_window_observed_seconds",
            f"{target_key}_no_regression_window_observed_seconds",
            "authority_promotion_stability_window_observed_seconds",
            "stable_runtime_truth_window_observed_seconds",
            "no_regression_window_observed_seconds",
        ]
        values = [to_int(policy.get(key), 0) for key in policy_keys]
        row_keys = [
            "stability_window_seconds",
            "observed_stability_window_seconds",
            "runtime_truth_stability_window_seconds",
            "no_regression_window_seconds",
        ]
        created_ts_values: list[float] = []
        for kind_records in records.values():
            for row in kind_records:
                for key in row_keys:
                    values.append(to_int(row.get(key), 0))
                created_ts = parse_ts(row.get("created_at"))
                if created_ts > 0:
                    created_ts_values.append(created_ts)
        if created_ts_values:
            values.append(max(0, int(time.time() - max(created_ts_values))))
        return max(values) if values else 0

    def _pool_equivalence_distribution_review(self) -> dict[str, Any]:
        active = self._active_users()
        working_ids = {
            egress.id
            for egress in self.egress.values()
            if self._healthy_for_load(egress) and not egress.reserve_only
        }
        counts: dict[str, int] = {egress_id: 0 for egress_id in working_ids}
        for user in active:
            if user.current in working_ids:
                counts[user.current] = counts.get(user.current, 0) + 1
        active_counts = [count for count in counts.values() if count > 0]
        max_count = max(active_counts) if active_counts else 0
        min_count = min(active_counts) if active_counts else 0
        spread = max_count - min_count if active_counts else 0
        return {
            "schema_version": "v7.pool-equivalence-distribution-review.v1",
            "active_users": len(active),
            "pool_budget": AUTHORITY_CLASS_BUDGETS["POOL"],
            "working_channels": len(working_ids),
            "counts": {key: counts[key] for key in sorted(counts)},
            "active_working_channels": len(active_counts),
            "max_users_per_active_channel": max_count,
            "min_users_per_active_channel": min_count,
            "spread": spread,
            "balanced": len(active) >= AUTHORITY_CLASS_BUDGETS["POOL"]
            and len(active_counts) >= 2
            and spread <= 1,
        }

    def _pool_equivalence_planner_review(self) -> dict[str, Any]:
        active = self._active_users()
        decisions = [self._decision_for_user(user) for user in active]
        candidate_moves = [
            item
            for item in decisions
            if item.get("recommended_egress") and item.get("recommended_egress") != item.get("current_egress")
        ]
        snapshot_gate = self._intelligence_snapshot_gate(0)
        return {
            "schema_version": "v7.pool-equivalence-planner-review.v1",
            "active_users": len(active),
            "candidate_moves_total": len(candidate_moves),
            "rebalance_candidates": sum(1 for item in candidate_moves if item.get("move_type") == "rebalance"),
            "selected_moves": 0,
            "zero_rebalance_demand": len(candidate_moves) == 0,
            "snapshot_stop_required": bool_value(snapshot_gate.get("stop_required")),
            "snapshot_source_mismatch_families": list(snapshot_gate.get("source_mismatch_families") or []),
            "snapshot_gate": {
                "active": bool_value(snapshot_gate.get("active")),
                "stop_required": bool_value(snapshot_gate.get("stop_required")),
                "source_mismatch_families": list(snapshot_gate.get("source_mismatch_families") or []),
            },
        }

    def _pool_authority_equivalence_review(
        self,
        operation_reviews: list[dict[str, Any]],
        successful_runs: list[dict[str, Any]],
        required_window: int,
    ) -> dict[str, Any]:
        distribution = self._pool_equivalence_distribution_review()
        planner = self._pool_equivalence_planner_review()
        load = dict(self.dynamic_load)
        successful_large_reviews = [
            row
            for row in operation_reviews
            if to_int(row.get("users_count"), 0) >= AUTHORITY_PROMOTION_RULES["POOL"]["min_users_per_run"]
            and bool_value(row.get("successful"))
            and bool_value(row.get("closure_closed"))
            and not row.get("missing_feedback_types")
            and not bool_value(row.get("rollback_required"))
        ]
        blockers: list[str] = []
        if len(successful_large_reviews) < 1:
            blockers.append("pool_equivalence_requires_one_successful_large_batch_operation")
        if any(row.get("rollback_required") for row in operation_reviews):
            blockers.append("pool_equivalence_requires_clean_rollback_history")
        if max((to_int(row.get("stability_window_observed_seconds"), 0) for row in successful_large_reviews), default=0) < required_window:
            blockers.append("pool_equivalence_requires_3600s_large_stability_window")
        if to_int(distribution.get("active_users"), 0) < AUTHORITY_CLASS_BUDGETS["POOL"]:
            blockers.append("pool_equivalence_requires_25_planner_visible_users")
        if not bool_value(distribution.get("balanced")):
            blockers.append("pool_equivalence_requires_balanced_zero_move_pool")
        if str(load.get("status") or "").lower() != "ok":
            blockers.append("pool_equivalence_requires_load_status_ok")
        if to_int(distribution.get("active_working_channels"), 0) < 2:
            blockers.append("pool_equivalence_requires_at_least_two_active_working_channels")
        if not bool_value(planner.get("zero_rebalance_demand")):
            blockers.append("pool_equivalence_requires_zero_planner_candidate_moves")
        if bool_value(planner.get("snapshot_stop_required")):
            blockers.append("pool_equivalence_requires_clean_snapshot_gate")
        accepted = not blockers
        return {
            "schema_version": "v7.pool-promotion-equivalence-review.v1",
            "target_authority_class": "POOL",
            "rule": "one_successful_large_3600s_no_regression_25_users_balanced_zero_move_pool",
            "accepted": accepted,
            "blockers": blockers,
            "operator_approval_required": True,
            "new_governance_owner_created": False,
            "new_truth_source_created": False,
            "requirements": {
                "one_successful_large_batch": len(successful_large_reviews) >= 1,
                "required_stability_window_seconds": required_window,
                "observed_stability_window_seconds": max(
                    (to_int(row.get("stability_window_observed_seconds"), 0) for row in successful_large_reviews),
                    default=0,
                ),
                "active_users_at_least_pool_budget": to_int(distribution.get("active_users"), 0) >= AUTHORITY_CLASS_BUDGETS["POOL"],
                "balanced_pool": bool_value(distribution.get("balanced")),
                "load_status_ok": str(load.get("status") or "").lower() == "ok",
                "active_working_channels_at_least_two": to_int(distribution.get("active_working_channels"), 0) >= 2,
                "zero_planner_candidate_moves": bool_value(planner.get("zero_rebalance_demand")),
                "snapshot_gate_clean": not bool_value(planner.get("snapshot_stop_required")),
            },
            "distribution_review": distribution,
            "planner_review": planner,
            "load_review": {
                "status": load.get("status"),
                "active_users": load.get("active_users"),
                "healthy_channels": load.get("healthy_channels"),
                "working_channels": load.get("working_channels"),
                "avg_load": load.get("avg_load"),
                "soft_limit": load.get("soft_limit"),
                "hard_limit": load.get("hard_limit"),
                "failover_hard_limit": load.get("failover_hard_limit"),
            },
        }

    def _authority_promotion_evidence_review(self, operation_ids: list[str], target_class: str) -> dict[str, Any]:
        target = normalize_authority_class(target_class)
        rule = AUTHORITY_PROMOTION_RULES.get(target)
        if not rule:
            return {
                "schema_version": "v7.authority-promotion-evidence-review.v2",
                "target_authority_class": target,
                "operation_ids": operation_ids,
                "operation_reviews": [],
                "blockers": [f"unsupported_authority_promotion_target_{target.lower()}"],
                "evidence_valid": False,
            }
        required_feedback = tuple(rule["requires_feedback"])
        required_runs = int(rule["required_successful_runs"])
        min_users = int(rule["min_users_per_run"])
        required_window = int(rule.get("stability_window_seconds") or 0)
        operation_reviews = []
        for operation_id in operation_ids:
            records = self._authority_feedback_records_for_operation(operation_id)
            users: set[str] = set()
            feedback_ids: set[str] = set()
            statuses: set[str] = set()
            rollback_required = False
            for kind_records in records.values():
                for row in kind_records:
                    user = str(row.get("user") or "")
                    if user:
                        users.add(user)
                    feedback_id = str(row.get("feedback_id") or row.get("object_id") or "")
                    if feedback_id:
                        feedback_ids.add(feedback_id)
                    status = str(row.get("outcome_status") or row.get("closure_state") or "").lower()
                    if status:
                        statuses.add(status)
                    rollback_result = row.get("rollback_result")
                    if isinstance(rollback_result, dict) and bool_value(rollback_result.get("rollback_required")):
                        rollback_required = True
                    if bool_value(row.get("rollback_required")):
                        rollback_required = True
            missing = [kind for kind in required_feedback if not records.get(kind)]
            successful = (
                "success" in statuses
                and not {"failure", "rollback_required"}.intersection(statuses)
                and not rollback_required
            )
            closed = any(str(row.get("closure_state") or "").upper() == "CLOSED" for row in records.get("closure", []))
            users_count = len(users)
            stability_window_seconds = self._authority_promotion_stability_window_seconds(target, records)
            stability_window_satisfied = stability_window_seconds >= required_window
            operation_success_proven = (
                users_count >= min_users
                and successful
                and closed
                and not missing
                and stability_window_satisfied
            )
            operation_reviews.append(
                {
                    "operation_id": operation_id,
                    "feedback_record_counts": {kind: len(items) for kind, items in records.items()},
                    "feedback_ids": sorted(feedback_ids),
                    "users": sorted(users),
                    "users_count": users_count,
                    "statuses": sorted(statuses),
                    "missing_feedback_types": missing,
                    "rollback_required": rollback_required,
                    "successful": successful,
                    "closure_closed": closed,
                    "required_min_users": min_users,
                    "stability_window_required_seconds": required_window,
                    "stability_window_observed_seconds": stability_window_seconds,
                    "stability_window_satisfied": stability_window_satisfied,
                    "operation_success_proven": operation_success_proven,
                    f"{rule['run_label']}_success_proven": operation_success_proven,
                }
            )
        successful_runs = [row for row in operation_reviews if row["operation_success_proven"]]
        blockers = []
        if len(operation_ids) < required_runs:
            blockers.append(str(rule["count_blocker"]))
        if len(successful_runs) < required_runs:
            blockers.append(str(rule["failure_blocker"]))
        equivalence_review: Optional[dict[str, Any]] = None
        if target == "POOL" and blockers:
            equivalence_review = self._pool_authority_equivalence_review(operation_reviews, successful_runs, required_window)
            if equivalence_review.get("accepted"):
                blockers = []
        return {
            "schema_version": "v7.authority-promotion-evidence-review.v2",
            "target_authority_class": target,
            "source_authority_class": rule["from"],
            "required_successful_runs": required_runs,
            f"required_successful_{rule['run_label']}_runs": required_runs,
            "min_users_per_successful_run": min_users,
            "requires_feedback": list(required_feedback),
            "requires_stability_window": bool(rule.get("requires_stability_window")),
            "required_stability_window_seconds": required_window,
            "operation_ids": operation_ids,
            "operation_reviews": operation_reviews,
            "successful_runs": len(successful_runs),
            f"successful_{rule['run_label']}_runs": len(successful_runs),
            "blockers": blockers,
            **({"equivalence_review": equivalence_review, "equivalence_accepted": bool(equivalence_review.get("accepted"))} if equivalence_review is not None else {}),
            "evidence_valid": not blockers,
        }

    def promote_authority(self, target_class: str) -> dict[str, Any]:
        target = normalize_authority_class(target_class)
        operation_ids = []
        for value in getattr(self.args, "authority_promotion_operation_id", []) or []:
            operation_ids.extend(split_csv(value))
        operation_ids = list(dict.fromkeys(operation_ids))
        before_effective = dict(self.authority_budget_policy)
        before_raw = dict((self.policy or {}).get("authority_budget") or {})
        current = normalize_authority_class(before_effective.get("authority_class"))
        certified = normalize_authority_class(before_effective.get("certified_authority_class"))
        current_for_transition = canonical_authority_class_for_promotion(
            current,
            before_effective.get("current_allowed_user_budget"),
        )
        certified_for_transition = canonical_authority_class_for_promotion(
            certified,
            before_effective.get("current_allowed_user_budget"),
        )
        expected_next = AUTHORITY_CLASS_NEXT.get(current_for_transition, current_for_transition)
        result: dict[str, Any] = {
            "schema_version": "v7.authority-promotion-action.v1",
            "action": "authority_promotion",
            "component": "tools/v7-users-autoswitch",
            "target_authority_class": target,
            "before": {
                "raw": before_raw,
                "effective": before_effective,
                "policy_hash": sha256_file(Path(self.args.policy_file)),
            },
            "operation_ids": operation_ids,
            "users_moved": 0,
            "routing_mutation_performed": False,
            "autoswitch_apply_run": False,
            "status": "DENIED",
            "blockers": [],
        }
        control = self._execution_control_decision(
            mutation_kind="forward",
            action_class="AUTHORITY_PROMOTION",
            expected_generation=str(getattr(self.args, "approved_breaker_generation", "") or ""),
            operation_id="authority-promotion",
        )
        result["execution_control"] = control
        if not control.get("allowed_forward_mutation"):
            result["blockers"].append("autonomous_execution_control_denied")
        if current_for_transition != current or certified_for_transition != certified:
            result["legacy_authority_class_alias"] = {
                "raw_authority_class": current,
                "raw_certified_authority_class": certified,
                "canonical_authority_class": current_for_transition,
                "canonical_certified_authority_class": certified_for_transition,
                "reason": "legacy_pool_25_maps_to_canonical_large_batch_for_forward_promotion",
            }
        if getattr(self.args, "confirm_authority_promotion", "") != "PROMOTE_AUTHORITY_APPROVED":
            result["blockers"].append("missing_explicit_authority_promotion_confirmation")
        if target != expected_next or target == current_for_transition:
            result["blockers"].append(f"invalid_target_authority_transition_{current_for_transition}_to_{target}")
        if current_for_transition != certified_for_transition:
            result["blockers"].append("runtime_authority_not_equal_to_certified_authority")
        rule = AUTHORITY_PROMOTION_RULES.get(target)
        result["promotion_rule"] = rule or {}
        if not rule:
            result["blockers"].append(f"unsupported_authority_promotion_target_{target.lower()}")
        elif current_for_transition != rule["from"]:
            result["blockers"].append(f"invalid_rule_source_authority_{current_for_transition}_for_{target}")
        elif target != "POOL" and len(operation_ids) < int(rule["required_successful_runs"]):
            result["blockers"].append(str(rule["count_blocker"]))

        truth = self._authority_promotion_truth_check()
        result["truth_check"] = truth
        if not truth.get("passed"):
            result["blockers"].append("runtime_truth_check_failed")

        evidence = self._authority_promotion_evidence_review(operation_ids, target)
        result["evidence_review"] = evidence
        if not evidence.get("evidence_valid"):
            for blocker in evidence.get("blockers") or [str(rule["failure_blocker"]) if rule else "authority_evidence_validation_failed"]:
                if blocker not in result["blockers"]:
                    result["blockers"].append(str(blocker))

        audit_available = shutil.which("v7-audit-log") is not None
        result["audit_command_available"] = audit_available
        if not audit_available:
            result["blockers"].append("v7_audit_log_unavailable")

        if result["blockers"]:
            return result

        policy_path = Path(self.args.policy_file)
        if not policy_path.is_file():
            result["blockers"].append("policy_file_missing")
            return result

        raw_policy = read_json(policy_path, {})
        if not isinstance(raw_policy, dict):
            result["blockers"].append("policy_file_not_json_object")
            return result
        promoted_at = now_iso()
        backup_path = policy_path.with_name(f"{policy_path.name}.backup-authority-promotion-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}")
        after_authority = dict(raw_policy.get("authority_budget") or {})
        after_authority.update(
            {
                "enabled": True,
                "authority_class": target,
                "prepared_authority_class": target,
                "certified_authority_class": target,
                "authority_lifecycle_state": "PROMOTED",
                "current_allowed_user_budget": authority_class_budget(target, to_int(after_authority.get("current_allowed_user_budget"), 0)),
                "next_authority_class": AUTHORITY_CLASS_NEXT.get(target, target),
                "next_allowed_user_budget": authority_class_budget(AUTHORITY_CLASS_NEXT.get(target, target), authority_class_budget(target, 0)),
                "evidence_floor": rule["evidence_floor"],
                "promoted_at": promoted_at,
                "promoted_by": "tools/v7-users-autoswitch",
                "promotion_action": rule["promotion_action"],
                "promotion_evidence": {
                    "operation_ids": operation_ids,
                    "successful_runs": evidence.get("successful_runs"),
                    f"successful_{rule['run_label']}_runs": evidence.get(f"successful_{rule['run_label']}_runs"),
                    "required_successful_runs": evidence.get("required_successful_runs"),
                    "required_stability_window_seconds": evidence.get("required_stability_window_seconds"),
                    "equivalence_accepted": bool(evidence.get("equivalence_accepted")),
                    "equivalence_review": evidence.get("equivalence_review") or {},
                    "feedback_ids": sorted(
                        {
                            feedback_id
                            for review in evidence.get("operation_reviews", [])
                            for feedback_id in review.get("feedback_ids", [])
                        }
                    ),
                },
            }
        )
        raw_policy["authority_budget"] = after_authority
        try:
            shutil.copy2(policy_path, backup_path)
            write_json_atomic(policy_path, raw_policy)
        except OSError as exc:
            result["blockers"].append(f"policy_write_failed:{exc}")
            return result

        audit = {
            "action": "authority_promotion",
            "component": "autoswitch",
            "object_type": "policy",
            "object_id": "authority_budget",
            "result": "OK",
            "metadata": {
                "from_authority_class": current,
                "to_authority_class": target,
                "from_allowed_user_budget": before_effective.get("current_allowed_user_budget"),
                "to_allowed_user_budget": authority_class_budget(target, 0),
                "operation_ids": ",".join(operation_ids),
                "backup_path": str(backup_path),
                "policy_hash_before": result["before"]["policy_hash"],
                "promotion_action": rule["promotion_action"],
                "program": "PROGRAM_UNIFIED_AUTHORITY_PROMOTION_OWNER_AND_FUTURE_LADDER_GOVERNANCE",
            },
            "emitted": False,
            "status": "ready_to_emit",
        }
        audit = self._emit_terminal_audit(audit)
        if not audit.get("emitted"):
            try:
                shutil.copy2(backup_path, policy_path)
            except OSError:
                pass
            result["audit"] = audit
            result["status"] = "DENIED_AUDIT_FAILED_ROLLED_BACK"
            result["blockers"].append("authority_promotion_audit_failed")
            return result

        after_effective = AutoswitchPlanner(
            argparse.Namespace(**{**vars(self.args), "pre_planner_refresh": "off"})
        ).authority_budget_policy
        result["backup_path"] = str(backup_path)
        result["audit"] = audit
        result["after"] = {
            "raw": after_authority,
            "effective": after_effective,
            "policy_hash": sha256_file(policy_path),
        }
        result["authority_promoted"] = True
        result["status"] = "PROMOTED"
        return result

