def consume_passive_events_only(args: argparse.Namespace) -> dict[str, Any]:
    """Run the existing passive consumer without constructing the Planner path.

    AutoswitchPlanner.__init__ owns additional observation and optional refresh
    behaviors needed by the planner.  A Matrix lifecycle consumer must not enter
    those behaviors merely to close a capture-only event.  This deliberately
    constructs only the existing passive-event owner state required by
    _consume_passive_production_events().
    """
    forbidden_flags: list[str] = []
    for name in (
        "apply",
        "emergency_failover_autonomy",
        "controlled_verifier_contention",
        "allow_pre_planner_refresh_with_apply",
    ):
        if bool_value(getattr(args, name, False)):
            forbidden_flags.append(name)
    for name in (
        "approved_packet_id",
        "approved_operation_id",
        "approved_selected_move_hash",
        "approved_authority_generation",
        "approved_breaker_generation",
        "approved_source_bundle_hash",
        "approved_snapshot_bundle_hash",
        "generate_rollback_packet_from_result",
        "rollback_packet",
        "promote_authority_to",
    ):
        if str(getattr(args, name, "") or "").strip():
            forbidden_flags.append(name)
    if str(getattr(args, "pre_planner_refresh", "off") or "off") != "off":
        forbidden_flags.append("pre_planner_refresh")
    forbidden_effects = {
        "planner_execution": False,
        "candidate_created": False,
        "packet_created": False,
        "lease_created": False,
        "runtime_apply": False,
        "routing_mutation": False,
        "user_movement": False,
        "rollback_apply": False,
        "authority_change": False,
        "production_maturity_change": False,
        "l7_credit": False,
        "natural_l8_credit": False,
    }
    if forbidden_flags:
        return {
            "schema_version": "v7.passive-event-consumer-entrypoint.v1",
            "status": "STOP_SAFE_FORBIDDEN_FLAGS",
            "ok": False,
            "mode": "PASSIVE_EVENTS_ONLY",
            "blockers": [f"passive_consumer_forbids_{name}" for name in sorted(set(forbidden_flags))],
            "forbidden_effects": forbidden_effects,
        }

    planner = object.__new__(AutoswitchPlanner)
    planner.args = args
    planner.state_dir = Path(args.state_dir)
    planner.event_dir = Path(args.event_dir)
    planner.l3_runtime_state_file = planner.state_dir / "l3-runtime-state.json"
    planner.l3_runtime_state = planner._load_l3_runtime_state()
    planner.policy = read_json(Path(args.policy_file), {})
    planner.org_policy = read_json(Path(args.org_policy_file), {})
    planner.service_signal_policy = planner._service_signal_policy()
    result = planner._consume_passive_production_events()
    return {
        "schema_version": "v7.passive-event-consumer-entrypoint.v1",
        "status": "PASS",
        "ok": True,
        "mode": "PASSIVE_EVENTS_ONLY",
        "consumer": "tools/v7-users-autoswitch._consume_passive_production_events",
        "result": result,
        "forbidden_effects": forbidden_effects,
    }


def consume_service_failure_automation_only(args: argparse.Namespace) -> dict[str, Any]:
    """Run only the existing planner's read-only incident advisory path."""
    forbidden = [
        name for name in ("apply", "emergency_failover_autonomy", "controlled_verifier_contention")
        if bool_value(getattr(args, name, False))
    ]
    if forbidden:
        return {
            "schema_version": "v7.service-failure-automation-entrypoint.v1",
            "status": "STOP_SAFE_FORBIDDEN_FLAGS",
            "ok": False,
            "blockers": [f"automation_advisory_forbids_{name}" for name in forbidden],
        }
    planner = AutoswitchPlanner(args)
    plan = planner.plan()
    result = planner.materialize_service_failure_automation_advisory(plan)
    return {
        "schema_version": "v7.service-failure-automation-entrypoint.v1",
        "status": "PASS",
        "ok": True,
        "mode": "INCIDENT_ADVISORY_AND_SHADOW_ONLY",
        "consumer": "tools/v7-users-autoswitch.materialize_service_failure_automation_advisory",
        "result": result,
        "forbidden_effects": {
            "runtime_apply": False,
            "routing_mutation": False,
            "user_movement": 0,
            "packet_created": False,
            "lease_created": False,
            "authority_change": False,
            "production_maturity_change": False,
        },
    }


def main() -> int:
    args = build_arg_parser().parse_args()
    if args.consume_passive_events_only:
        result = consume_passive_events_only(args)
        print(json.dumps(result, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=False))
        return 0 if result.get("status") == "PASS" else 2
    if args.consume_service_failure_automation_only:
        result = consume_service_failure_automation_only(args)
        print(json.dumps(result, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=False))
        return 0 if result.get("status") == "PASS" else 2
    planner = AutoswitchPlanner(args)
    if args.promote_authority_to:
        result = planner.promote_authority(args.promote_authority_to)
        print(json.dumps(result, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=False))
        return 0 if result.get("status") == "PROMOTED" else 1
    if args.generate_rollback_packet_from_result:
        output = Path(args.rollback_packet_output) if args.rollback_packet_output else Path(args.generate_rollback_packet_from_result).with_suffix(".rollback-packet.json")
        result = planner.write_rollback_packet_from_result(Path(args.generate_rollback_packet_from_result), output)
        print(json.dumps(result, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=False))
        return 1 if result.get("validation_errors") else 0
    if args.rollback_packet:
        result = planner.execute_rollback_packet(Path(args.rollback_packet))
        print(json.dumps(result, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=False))
        state = (result.get("operation") or {}).get("terminal_state")
        return 0 if state in {"ROLLBACK_DRY_RUN", "ROLLBACK_COMPLETED"} else 1
    plan = planner.plan()
    plan["apply_result"] = planner.apply(plan)
    planner.finalize_operation(plan)
    print(json.dumps(plan, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
