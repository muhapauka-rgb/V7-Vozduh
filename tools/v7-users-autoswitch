        best_pool_rows = self._snapshot_items("best-available-pool")
        best_pool_by_user = {
            str(row.get("user") or ""): row
            for row in best_pool_rows
            if isinstance(row, dict) and row.get("user")
        }
        prediction = self._first_snapshot_item("prediction-summaries")
        prediction_advice = {
            "schema_version": "ri5.prediction-advice.v1",
            "mode": "snapshot_backed_prediction_advice",
            "available": bool(prediction),
            "prediction_enabled": bool(prediction.get("prediction_enabled")) if isinstance(prediction, dict) else False,
            "channel_forecast_count": len(prediction.get("channel_forecasts") or []) if isinstance(prediction, dict) else 0,
            "service_forecast_count": len(prediction.get("service_forecasts") or []) if isinstance(prediction, dict) else 0,
            "risk_forecast": prediction.get("risk_forecast", {}) if isinstance(prediction, dict) else {},
            "trust_forecast": prediction.get("trust_forecast", {}) if isinstance(prediction, dict) else {},
            "planner_decision_owner": "tools/v7-users-autoswitch",
            "execution_authority": "none",
            "selected_moves_write_authority": "none",
            "runtime_forecasting_performed": False,
        }
        trust_evolution = self._first_snapshot_item("trust-evolution-summaries")
        confidence_summary = trust_evolution.get("confidence_summary") if isinstance(trust_evolution.get("confidence_summary"), dict) else {}
        autonomy_readiness = trust_evolution.get("autonomy_readiness") if isinstance(trust_evolution.get("autonomy_readiness"), dict) else {}
        trust_evolution_advice = {
            "schema_version": "ri6.trust-evolution-advice.v1",
            "mode": "snapshot_backed_trust_evolution_advice",
            "available": bool(trust_evolution),
            "overall_confidence": to_float(trust_evolution.get("overall_confidence"), 0.0) if isinstance(trust_evolution, dict) else 0.0,
            "decision_confidence": to_float(confidence_summary.get("decision_confidence"), 0.0),
            "prediction_confidence": to_float(confidence_summary.get("prediction_confidence"), 0.0),
            "service_confidence": to_float(confidence_summary.get("service_confidence"), 0.0),
            "suitability_confidence": to_float(confidence_summary.get("suitability_confidence"), 0.0),
            "rollback_confidence": to_float(confidence_summary.get("rollback_confidence"), 0.0),
            "blast_radius_confidence": to_float(confidence_summary.get("blast_radius_confidence"), 0.0),
            "autonomy_readiness": autonomy_readiness.get("current_level", "NOT_READY"),
            "autonomy_enabled": False,
            "automatic_user_movement_enabled": False,
            "planner_decision_owner": "tools/v7-users-autoswitch",
            "execution_authority": "none",
            "selected_moves_write_authority": "none",
            "runtime_trust_training_performed": False,
        }
        result_confidences = [
            to_float(row.get("confidence"), 0.0)
            for row in (gate.get("results") or {}).values()
            if isinstance(row, dict) and row.get("exists")
        ]
        influenced = [
            candidate
            for decision in decisions
            for candidate in (decision.get("candidates") or [])
            if isinstance(candidate, dict)
            and candidate.get("eligible")
            and "routing_intelligence" in (candidate.get("score_parts") or {})
        ]
        try:
            from admin_core.routing_brain import routing_brain_map
            brain_map = routing_brain_map()
        except Exception:
            brain_map = {}
        return {
            "schema_version": "ri2.routing-brain-advisory.v1",
            "mode": "snapshot_backed_planner_advisory_context",
