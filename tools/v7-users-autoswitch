def ct_m0f_target_diagnostic_subprocess(
    args: argparse.Namespace,
) -> dict[str, Any]:
    """Read the existing target owner in a short-lived process.

    The one-user VLESS selector and the target owner each legitimately need a
    broad read-only inventory.  Keeping both Python heaps resident is not a
    policy requirement and can exceed the Runtime envelope.  A child process
    preserves the exact existing diagnostic and returns only its already
    compact JSON projection; it does not create a daemon, cache, owner or
    mutation path.
    """
    command = [
        sys.argv[0],
        "--state-dir", str(args.state_dir),
        "--event-dir", str(args.event_dir),
        "--policy-file", str(args.policy_file),
        "--org-policy-file", str(args.org_policy_file),
        "--quality-summary-file", str(args.quality_summary_file),
        "--intelligence-snapshot-root", str(args.intelligence_snapshot_root),
        "--safety-file", str(args.safety_file),
        "--load-summary-file", str(args.load_summary_file),
        "--restore-barrier-file", str(args.restore_barrier_file),
        "--egress-drafts-dir", str(args.egress_drafts_dir),
        "--action-class-audit-store", str(args.action_class_audit_store),
        "--controlled-target-selection-diagnostic",
    ]
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            timeout=120,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "targets": [], "selection": {},
            "preflight_error": f"target_diagnostic_subprocess:{exc}",
        }
    try:
        result = json.loads(proc.stdout or "{}")
    except json.JSONDecodeError:
        result = {}
    if not isinstance(result, dict):
        result = {}
    if not result:
        return {
            "targets": [], "selection": {},
            "preflight_error": (
                "target_diagnostic_subprocess_invalid_output:"
                f"rc={proc.returncode}"
            ),
        }
    return result


def ct_m0f_precomputed_target_diagnostic_from_file(
    path_value: str,
) -> dict[str, Any]:
    path = Path(str(path_value or ""))
    if not path.is_file():
        return {
            "targets": [], "selection": {},
            "preflight_error": "exact_precomputed_target_diagnostic_required",
        }
    result = read_json(path, {})
    if not isinstance(result, dict):
        return {
            "targets": [], "selection": {},
            "preflight_error": "precomputed_target_diagnostic_invalid",
        }
    return result


