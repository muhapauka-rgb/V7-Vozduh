    def _snapshot_candidate_advisory_scores(self, user: User, services: list[str], route_class: str) -> dict[str, Any]:
        gate = self._intelligence_snapshot_gate()
        if not gate.get("active"):
            return {}
        if gate.get("stop_required"):
            return {
                "schema_version": "ri3.candidate-advisory-scores.v1",
                "mode": "snapshot_backed_planner_ranking_advice_stopped",
                "planner_influence_active": False,
                "planner_decision_owner": "tools/v7-users-autoswitch",
                "execution_authority": "none",
                "selected_moves_write_authority": "none",
                "candidate_scores": {},
                "route_class": route_class,
                "snapshot_gate": gate,
                "unavailable_reason": "intelligence_snapshot_stop_required",
            }
        suitability_scores = self._snapshot_user_candidate_suitability_map(user.ip)
        if suitability_scores:
            candidates: dict[str, dict[str, Any]] = {}
            for egress_id in sorted(self.egress):
                row = suitability_scores.get(egress_id) or {}
                advisory_score = to_float(row.get("suitability_score"), 50.0)
                score_part = round(max(-100.0, min(100.0, to_float(row.get("score_part"), (advisory_score - 50.0) * 2.0))), 3)
                candidates[egress_id] = {
                    "schema_version": "ri4.candidate-suitability-score.v1",
                    "target": egress_id,
                    "score_part": score_part,
                    "advisory_score": advisory_score,
                    "suitability_score": advisory_score,
                    "recommendation": row.get("recommendation", "neutral"),
                    "confidence": to_float(row.get("confidence"), 0.0),
                    "source": "intelligence_snapshot:candidate-suitability-summary",
                    "route_class": route_class,
                    "required_services": normalize_service_ids(services),
                    "reason_breakdown": row.get("reason_breakdown", {}),
                    "explainability": list(row.get("explainability") or []) + [
                        "planner_may_use_score_part_only_after_candidate_is_eligible",
                    ],
                    "authority": {
                        "routing_intelligence": "advice_only",
                        "candidate_creation": "forbidden",
                        "hard_gate_override": "forbidden",
                        "governance_authority": "none",
                        "runtime_execution_authority": "none",
                    },
                }
            return {
                "schema_version": "ri4.candidate-suitability-advice.v1",
                "mode": "snapshot_backed_candidate_suitability_advice",
                "planner_influence_active": True,
                "planner_decision_owner": "tools/v7-users-autoswitch",
                "execution_authority": "none",
                "selected_moves_write_authority": "none",
                "candidate_scores": candidates,
                "route_class": route_class,
                "snapshot_gate": gate,
                "user_id": user.ip,
            }
        channel_scores = self._snapshot_channel_score_map()
        candidates: dict[str, dict[str, Any]] = {}
        for egress_id in sorted(self.egress):
            row = channel_scores.get(egress_id) or {}
            advisory_score = to_float(row.get("aggregate_score"), 50.0)
            score_part = round(max(-100.0, min(100.0, (advisory_score - 50.0) * 2.0)), 3)
            if score_part >= 25:
                recommendation = "prefer"
            elif score_part <= -25:
                recommendation = "deprioritize"
            else:
                recommendation = "neutral"
            candidates[egress_id] = {
                "schema_version": "ri3.candidate-advisory-score.v1",
                "target": egress_id,
                "score_part": score_part,
                "advisory_score": advisory_score,
                "recommendation": recommendation,
                "confidence": to_float(row.get("confidence"), 0.0),
                "source": "intelligence_snapshot:channel-service-scores",
                "route_class": route_class,
                "required_services": normalize_service_ids(services),
                "explainability": [
                    f"snapshot_verdict:{row.get('verdict', 'UNKNOWN')}",
                    f"snapshot_confidence:{to_float(row.get('confidence'), 0.0):.3f}",
                ],
                "authority": {
                    "routing_intelligence": "advice_only",
                    "candidate_creation": "forbidden",
                    "hard_gate_override": "forbidden",
                    "governance_authority": "none",
                    "runtime_execution_authority": "none",
                },
            }
        return {
            "schema_version": "ri3.candidate-advisory-scores.v1",
            "mode": "snapshot_backed_planner_ranking_advice",
            "planner_influence_active": True,
            "planner_decision_owner": "tools/v7-users-autoswitch",
            "execution_authority": "none",
            "selected_moves_write_authority": "none",
            "candidate_scores": candidates,
            "route_class": route_class,
            "snapshot_gate": gate,
            "user_id": user.ip,
        }

    def _routing_intelligence_scores_for_user(self, user: User, services: list[str], route_class: str) -> dict[str, Any]:
        key = (user.ip, route_class, tuple(normalize_service_ids(services)), tuple(sorted(self.egress.keys())))
        if key in self._routing_intelligence_cache:
            return self._routing_intelligence_cache[key]
        snapshot_scores = self._snapshot_candidate_advisory_scores(user, services, route_class)
        if snapshot_scores:
            self._routing_intelligence_cache[key] = snapshot_scores
            return snapshot_scores
        try:
            from admin_core.routing_brain import RoutingBrain
        except Exception as exc:
            result = {
                "schema_version": "ri3.candidate-advisory-scores.v1",
                "mode": "planner_ranking_advice_unavailable",
                "planner_influence_active": False,
                "planner_decision_owner": "tools/v7-users-autoswitch",
                "execution_authority": "none",
                "selected_moves_write_authority": "none",
                "candidate_scores": {},
                "unavailable_reason": f"routing_brain_import_unavailable:{exc.__class__.__name__}",
            }
            self._routing_intelligence_cache[key] = result
            return result
        brain = RoutingBrain(
            service_matrix=self.matrix,
            quality_summary=self.quality_summary,
            service_preferences=self.service_prefs,
            audit_records=self._recent_audit_records(),
        )
        result = brain.candidate_advisory_scores(
            total_users=len(self._active_users()),
            affected_users=len(self._active_users()),
            required_services=services,
            user_id=user.ip,
            candidate_targets=sorted(self.egress.keys()),
        )
        result["route_class"] = route_class
        self._routing_intelligence_cache[key] = result
        return result

    def _routing_intelligence_candidate_advice(self, user: User, egress: Egress, services: list[str], route_class: str) -> dict[str, Any]:
        scores = self._routing_intelligence_scores_for_user(user, services, route_class)
        row = ((scores.get("candidate_scores") or {}).get(egress.id) or {})
        if not row:
            return {
                "schema_version": "ri3.candidate-advisory-score.v1",
                "target": egress.id,
                "score_part": 0.0,
                "advisory_score": 0.0,
                "recommendation": "neutral",
                "planner_influence_active": False,
                "explainability": ["routing_intelligence_candidate_score_missing"],
                "authority": {
                    "routing_intelligence": "advice_only",
                    "candidate_creation": "forbidden",
                    "hard_gate_override": "forbidden",
                    "governance_authority": "none",
