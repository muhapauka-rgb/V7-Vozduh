        and str(row.get("target_id") or "")
        == controlled_substrate_target_id
    ), {})
    controlled_substrate_target_ready = bool(
        pinned_target_projection.get("full_live_admission")
    )
    cooldown = policy_scope.get("cooldown") if isinstance(policy_scope.get("cooldown"), dict) else {}
    result = {
        "schema_version": "v7.standing-delegated-policy-runtime-status.v1",
        "status": "PASS" if validation.get("ok") else "STOP_SAFE_INVALID_STANDING_POLICY",
        "ok": bool(validation.get("ok")),
        "owner": "existing /etc/v7/policy.json + admin_core/operator_execution.py append-only audit",
        "contract_id": str(contract.get("contract_id") or ""),
        "contract_hash": str(contract.get("contract_hash") or ""),
        "contract_status": str(contract.get("status") or ""),
        "issuing_owner": str(contract.get("issuing_owner") or ""),
        "active_program": str(contract.get("active_program") or ""),
        "issued_at": str(contract.get("issued_at") or ""),
        "expires_at": str(contract.get("expires_at") or ""),
        "policy_scope_hash": str(contract.get("policy_scope_hash") or ""),
        "policy_profile": str(policy_scope.get("policy_profile") or ""),
        "authority_decision": str(decision.get("decision") or ""),
        "authority_decision_id": str(decision.get("decision_id") or ""),
        "authority_request_id": str(decision.get("request_id") or ""),
        "authority_request_hash": str(decision.get("request_hash") or ""),
        # These are the effective, redacted runtime bounds of the existing
        # policy owner.  Historical certification budgets deliberately never
        # appear here: consumers must not infer a current grant from them.
        "action_class": ",".join(sorted(str(item) for item in (policy_scope.get("allowed_action_classes") or []) if str(item))),
        "max_users_per_action": int(policy_scope.get("max_users_per_action") or 0),
        "max_concurrent_transactions": int(policy_scope.get("max_concurrent_transactions") or 0),
        "runtime_scope_axes": runtime_axes,
        "authority_approved_max": int(runtime_axes["authority_approved_max"]),
        "controlled_certification_runtime_max": int(
            runtime_axes["controlled_certification_runtime_max"]
        ),
        "ordinary_production_runtime_max": int(
            runtime_axes["ordinary_production_runtime_max"]
        ),
        "controlled_production_proven_max": int(
            runtime_axes["controlled_production_proven_max"]
        ),
        "controlled_certification_campaign_status": (
            controlled_campaign_status
        ),
        "availability_first_campaign_status": (
            availability_campaign_status
        ),
        "controlled_campaign_target_selection": (
            target_selection_diagnostic
        ),
        "controlled_source_topology": source_topology_diagnostic,
        "ordinary_production_proven_max": int(
            runtime_axes["ordinary_production_proven_max"]
        ),
        "allowed_failure_families": sorted(str(item) for item in (policy_scope.get("allowed_failure_types") or []) if str(item)),
