def consume_passive_events_only(args: argparse.Namespace) -> dict[str, Any]:
    """Run the existing passive consumer without constructing the Planner path.

    AutoswitchPlanner.__init__ owns additional observation and optional refresh
    behaviors needed by the planner.  A Matrix lifecycle consumer must not enter
    those behaviors merely to close a capture-only event.  This deliberately
    constructs only the existing passive-event owner state required by
    _consume_passive_production_events().
    """
    forbidden_flags: list[str] = []
    for name in (
        "apply",
        "emergency_failover_autonomy",
        "controlled_verifier_contention",
        "allow_pre_planner_refresh_with_apply",
    ):
        if bool_value(getattr(args, name, False)):
            forbidden_flags.append(name)
    for name in (
        "approved_packet_id",
        "approved_operation_id",
        "approved_selected_move_hash",
        "approved_authority_generation",
        "approved_breaker_generation",
        "approved_source_bundle_hash",
        "approved_snapshot_bundle_hash",
        "generate_rollback_packet_from_result",
        "rollback_packet",
        "promote_authority_to",
    ):
        if str(getattr(args, name, "") or "").strip():
            forbidden_flags.append(name)
    if str(getattr(args, "pre_planner_refresh", "off") or "off") != "off":
        forbidden_flags.append("pre_planner_refresh")
    forbidden_effects = {
        "planner_execution": False,
        "candidate_created": False,
        "packet_created": False,
        "lease_created": False,
        "runtime_apply": False,
        "routing_mutation": False,
        "user_movement": False,
        "rollback_apply": False,
        "authority_change": False,
        "production_maturity_change": False,
        "l7_credit": False,
        "natural_l8_credit": False,
    }
    if forbidden_flags:
        return {
            "schema_version": "v7.passive-event-consumer-entrypoint.v1",
            "status": "STOP_SAFE_FORBIDDEN_FLAGS",
