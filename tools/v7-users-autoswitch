                "rollback_failures": to_int(feedback.get("rollback_failures"), 0),
                "safe_to_restore_eligibility": bool_value(recovery.get("safe_to_restore_eligibility")),
                "operator_review_required": bool_value(recovery.get("operator_review_required")),
            },
            "soft_adjustment": soft_adjustment,
            "advisory_score": round(max(0.0, min(100.0, trust_score + soft_adjustment)), 3),
            "recommended_action": self._ctr_recommended_action_for_state(state),
            "blocked_actions": self._ctr_blocked_actions_for_state(state),
            "planner_score_applied": False,
            "hard_gate_applied": False,
            "target_suppression_applied": False,
            "authority": {
                "planner_decision_owner": "tools/v7-users-autoswitch",
                "governance_authority": "none",
                "runtime_execution_authority": "none",
                "selected_moves_write_authority": "none",
            },
        }

    def _snapshot_user_candidate_suitability_map(self, user_id: str) -> dict[str, dict[str, Any]]:
        rows: dict[str, dict[str, Any]] = {}
        for item in self._snapshot_items("candidate-suitability-summary"):
            if str(item.get("user") or "") != str(user_id):
                continue
            for candidate in item.get("candidates") or []:
                if not isinstance(candidate, dict):
                    continue
                channel = str(candidate.get("channel") or "").strip()
                if channel:
                    rows[channel] = candidate
            break
        return rows

    def _first_snapshot_item(self, family: str) -> dict[str, Any]:
