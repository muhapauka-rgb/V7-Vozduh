            },
            "verification_supported": verification_supported,
            "rollback_containment_supported": rollback_containment_supported,
            "correlation_domain": str(
                registry.get("correlation_domain")
                or registry.get("expected_ip")
                or f"{registry.get('protocol', '')}:{registry.get('interface', '')}"
            ),
            "current_stage_feasible": current_stage_feasible,
            "campaign_completion_feasible": campaign_completion_feasible,
            "planner_score": round(float(candidate.score), 3),
            "planner_blockers": sorted(set(candidate.blocked)),
            "exclusion_reasons": sorted(set(exclusion_reasons)),
            "owner_lineage": {
                "inventory": "egress.registry",
