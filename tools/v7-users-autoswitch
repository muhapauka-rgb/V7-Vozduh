        }
        row["semantic_fingerprint"] = shared_target_semantic_fingerprint(row)
        rows.append(row)

    ranked = sorted(
        (row for row in rows if row.get("controlled_rebind_eligible")),
        key=lambda row: (
            not bool(row.get("current_stage_feasible")),
            not bool(row.get("campaign_completion_feasible")),
            -to_float((row.get("quality") or {}).get("current_stability"), 0.0),
            -to_int(
                (row.get("capacity") or {}).get("free_capacity_after_reserve"),
                0,
            ),
            -to_float(row.get("planner_score"), 0.0),
