            "planner_influence_active": not bool(gate.get("stop_required")),
            "snapshot_gate": gate,
            "routing_brain_map": brain_map,
            "candidate_ranking_influence": {
                "mode": "bounded_score_part_for_eligible_candidates_from_snapshots",
                "eligible_candidates_with_ri_score_part": len(influenced),
                "can_create_candidates": False,
                "can_bypass_hard_gates": False,
                "can_bypass_reservation": False,
                "can_bypass_governance": False,
                "can_execute_runtime": False,
            },
            "best_available_pool_advice": {
                "schema_version": "ri4.best-available-pool-advice.v1",
                "mode": "snapshot_backed_ranked_acceptable_pool",
                "users_with_pool": len(best_pool_by_user),
                "pools": best_pool_by_user,
                "single_best_channel_authority": "none",
                "planner_decision_owner": "tools/v7-users-autoswitch",
                "execution_authority": "none",
                "selected_moves_write_authority": "none",
            },
            "ctr_advisory": {
                "schema_version": "v7.ctr.runtime-advisory-summary.v1",
                "mode": "trust_evolution_channel_recovery_advisory_only",
                "source": "trust-evolution-summaries.channel_trust_recovery",
                "candidate_count": len(ctr_candidates),
                "state_counts": ctr_state_counts,
                "review_required_candidates": ctr_review_required,
                "pool_soft_influence": "dry_run_score_simulation_only",
                "simulated_score_candidates": ctr_simulated_scores,
                "simulated_ranking_changes": ctr_simulated_ranking_changes,
                "simulated_value_detected": ctr_simulated_ranking_changes > 0,
                "planner_score_applied": False,
                "hard_gate_applied": False,
                "target_suppression_applied": False,
                "planner_decision_owner": "tools/v7-users-autoswitch",
                "execution_authority": "none",
                "selected_moves_write_authority": "none",
            },
            "prediction_advice": prediction_advice,
            "trust_evolution_advice": trust_evolution_advice,
            "planner_decision_owner": "tools/v7-users-autoswitch",
            "execution_authority": "none",
            "selected_moves_write_authority": "none",
        }

    def _routing_brain_advisory(self, decisions: list[dict[str, Any]], active_count: int, affected_count: int) -> dict[str, Any]:
        snapshot_advisory = self._snapshot_routing_brain_advisory(decisions)
        if snapshot_advisory:
            return snapshot_advisory
        candidate_targets = sorted(
            {
                str(candidate.get("egress") or "")
                for decision in decisions
                for candidate in decision.get("candidates", [])
                if candidate.get("egress")
            }
        )
        try:
            from admin_core.routing_brain import RoutingBrain, routing_brain_map
        except Exception as exc:
            return {
                "schema_version": "ri2.routing-brain-advisory.v1",
                "mode": "planner_advisory_context",
                "intelligence_present": False,
                "intelligence_confidence": 0.0,
                "service_history_score": 0.0,
                "weighted_service_score": 0.0,
                "execution_trust_score": 0.0,
                "recommended_blast_radius": 0,
                "intelligence_used_for_explanation": False,
                "planner_decision_owner": "tools/v7-users-autoswitch",
                "execution_authority": "none",
                "selected_moves_write_authority": "none",
                "unavailable_reason": f"routing_brain_import_unavailable:{exc.__class__.__name__}",
            }
        brain = RoutingBrain(
            service_matrix=self.matrix,
            quality_summary=self.quality_summary,
            service_preferences=self.service_prefs,
            audit_records=self._recent_audit_records(),
        )
        advisory = brain.advisory_context(
            total_users=active_count,
            affected_users=affected_count,
            required_services=self._required_services(),
            candidate_targets=candidate_targets,
        )
        advisory["routing_brain_map"] = routing_brain_map()
        advisory["planner_influence_active"] = True
        influenced = [
            candidate
            for decision in decisions
            for candidate in (decision.get("candidates") or [])
            if isinstance(candidate, dict)
            and candidate.get("eligible")
            and "routing_intelligence" in (candidate.get("score_parts") or {})
        ]
        advisory["candidate_ranking_influence"] = {
            "mode": "bounded_score_part_for_eligible_candidates",
            "eligible_candidates_with_ri_score_part": len(influenced),
            "can_create_candidates": False,
            "can_bypass_hard_gates": False,
            "can_bypass_reservation": False,
            "can_bypass_governance": False,
            "can_execute_runtime": False,
        }
        advisory["planner_decision_owner"] = "tools/v7-users-autoswitch"
        advisory["execution_authority"] = "none"
        advisory["selected_moves_write_authority"] = "none"
        return advisory

    def _ctr_candidate_shadow_row(self, candidate: dict[str, Any]) -> dict[str, Any]:
        simulation = candidate.get("ctr_score_simulation") if isinstance(candidate.get("ctr_score_simulation"), dict) else {}
        ctr = candidate.get("ctr_advisory") if isinstance(candidate.get("ctr_advisory"), dict) else {}
