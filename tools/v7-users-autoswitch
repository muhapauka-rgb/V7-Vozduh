    for index, row in enumerate(ranked, start=1):
        row["safety_rank"] = index
    selected = next((
        row for row in ranked if row.get("current_stage_feasible")
    ), {})
    pinned = next((
        row for row in rows
        if str(row.get("target_id") or "") == pinned_target_id
    ), {})
    exact_target_authority = bool(pinned_target_id)
    if pinned.get("full_live_admission"):
