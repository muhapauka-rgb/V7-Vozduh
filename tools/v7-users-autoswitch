def classify_shared_target_availability(
    *,
    target_id: str,
    source_id: str,
    health_ok: bool,
    capacity_owner_reconciled: bool,
    free_capacity_after_reserve: int,
    verification_supported: bool,
    rollback_containment_supported: bool,
    quality_fresh: bool,
    stability_inputs: dict[str, float],
    current_avg_mbps: float,
    current_min_mbps: float,
    normal_quality_blockers: list[str],
    non_quality_blockers: list[str],
) -> dict[str, Any]:
    """Classify a shared target without turning a soft SLO miss into zero capacity.

    This is deliberately a read-only *technical* admission projection.  It
    cannot admit execution: Authority, Packet/lease and all live execution
    gates remain separate existing owners.  A degraded result is capped at one
    certification identity until a real Outcome proves a larger safe bound.
    """
    hard_reasons: list[str] = []
    if target_id == source_id:
        hard_reasons.append("source_cannot_be_its_own_target")
    if not health_ok:
        hard_reasons.append("service_reachability_or_baseline_failed")
    if not capacity_owner_reconciled:
        hard_reasons.append("capacity_owner_not_reconciled")
    if free_capacity_after_reserve <= 0:
        hard_reasons.append("hard_capacity_or_ordinary_reserve_exhausted")
    if not verification_supported:
        hard_reasons.append("verification_contract_not_supported")
    if not rollback_containment_supported:
        hard_reasons.append("rollback_or_containment_contract_not_supported")
    if not quality_fresh:
        hard_reasons.append("quality_windows_stale_or_missing")
    hard_reasons.extend(sorted(set(non_quality_blockers)))

    positive_windows = [
        name for name, value in stability_inputs.items()
        if to_float(value, -1.0) > 0.0
    ]
    positive_throughput = (
        to_float(current_avg_mbps, 0.0) > 0.0
        and to_float(current_min_mbps, 0.0) > 0.0
    )
    if hard_reasons:
        state = "HARD_INELIGIBLE"
        technical_safe_capacity = 0
        emergency_reason = "hard_gate_failed"
    elif not normal_quality_blockers:
        state = "HEALTHY"
        technical_safe_capacity = max(0, int(free_capacity_after_reserve))
        emergency_reason = "normal_floor_passed"
    elif positive_throughput and len(positive_windows) >= 2:
        state = "DEGRADED_USABLE"
        technical_safe_capacity = min(1, max(0, int(free_capacity_after_reserve)))
        emergency_reason = "normal_floor_missed_but_fresh_sustained_positive_measurement"
    elif positive_throughput and "current" in positive_windows:
        state = "LAST_RESORT_USABLE"
        technical_safe_capacity = min(1, max(0, int(free_capacity_after_reserve)))
        emergency_reason = "only_current_positive_measurement; exact_last_resort_policy_required"
    else:
        # This is intentionally not labelled HARD_INELIGIBLE: no hard routing
        # defect was proven.  It is insufficient evidence for an emergency
        # allocation and must be re-evaluated by the existing Matrix owner.
        state = "DEGRADED_OBSERVATION_INSUFFICIENT"
        technical_safe_capacity = 0
        emergency_reason = "positive_quality_evidence_insufficient"

    return {
        "schema_version": "v7.shared-target-availability-classification.v1",
        "state": state,
        "normal_admission": state == "HEALTHY",
        "emergency_admission_candidate": state in {
            "DEGRADED_USABLE", "LAST_RESORT_USABLE",
        },
        "execution_admission": False,
        "technical_safe_additional_capacity": technical_safe_capacity,
        "quality_safe_increment": technical_safe_capacity,
        "hard_reasons": sorted(set(hard_reasons)),
        "normal_quality_blockers": sorted(set(normal_quality_blockers)),
        "positive_stability_windows": sorted(positive_windows),
        "positive_throughput": positive_throughput,
        "emergency_reason": emergency_reason,
        "policy_boundary": (
            "NONE"
            if state == "HEALTHY" else
            "EXACT_DEGRADED_SHARED_TARGET_ACTION_CLASS_CONTRACT_REQUIRED"
            if state == "DEGRADED_USABLE" else
            "EXACT_LAST_RESORT_SHARED_TARGET_ACTION_CLASS_CONTRACT_REQUIRED"
            if state == "LAST_RESORT_USABLE" else
            "NO_EXECUTION_ADMISSION"
        ),
    }


def shared_target_stage_allocations(
    *,
    rows: list[dict[str, Any]],
    stages: list[int],
    inventory_fingerprint: str,
    excluded_target_ids: Optional[set[str]] = None,
) -> dict[str, Any]:
    """Allocate only technically usable shared destinations for read-only planning.

    ``excluded_target_ids`` is deliberately a projection input rather than a
    policy exception.  The live controlled source must never be selected as a
    destination merely because an older campaign binding named another source.
    """
    excluded = {str(value) for value in (excluded_target_ids or set()) if value}
    ranked = sorted(
        (
            row for row in rows
            if (
                row.get("shared_target_technically_eligible")
                and str(row.get("target_id") or "") not in excluded
            )
        ),
        key=lambda row: (
            {"HEALTHY": 0, "DEGRADED_USABLE": 1, "LAST_RESORT_USABLE": 2}.get(
                str((row.get("shared_target_availability") or {}).get(
                    "state"
                ) or ""),
                3,
            ),
            -to_int(
                (row.get("capacity") or {}).get(
                    "availability_first_proven_additional_scope"
                ),
                0,
            ),
            -to_int(
                (row.get("capacity") or {}).get(
                    "planning_safe_additional_capacity"
                ),
                0,
            ),
            -to_float((row.get("quality") or {}).get("current_stability"), 0.0),
            -to_int(
                (row.get("capacity") or {}).get(
                    "target_safe_additional_capacity"
                ),
                0,
            ),
            -to_float(row.get("planner_score"), 0.0),
            str(row.get("target_id") or ""),
        ),
    )
    allocations: dict[str, dict[str, Any]] = {}
    for requested_stage in sorted({int(value) for value in stages if int(value) > 0}):
        remaining = requested_stage
        used_domains: set[str] = set()
        allocation: list[dict[str, Any]] = []
        for row in ranked:
            domain = str(row.get("correlation_domain") or "")
            if not domain or domain in used_domains:
                continue
            available = max(0, to_int(
                (row.get("capacity") or {}).get(
                    "planning_safe_additional_capacity"
                ),
                to_int(
                    (row.get("capacity") or {}).get(
                        "target_safe_additional_capacity"
                    ),
                    0,
                ),
            ))
            assigned = min(remaining, available)
            if assigned <= 0:
                continue
            allocation.append({
                "target_id": str(row.get("target_id") or ""),
                "correlation_domain": domain,
                "allocated_users": assigned,
                "capacity_reservation": assigned,
                "capacity_reservation_semantics": (
                    "SERIALIZED_PACKET_LEASE_RESERVATION_WITH_FRESH_"
                    "PRE_APPLY_REVALIDATION"
                ),
                "capacity_bounds_fingerprint": sha256_json(
                    (row.get("capacity") or {}).get("capacity_bounds") or {}
                ),
                "ordinary_users_unchanged": int(
                    (row.get("capacity") or {}).get("ordinary_users") or 0
                ),
                "availability_classification": str(
                    (row.get("shared_target_availability") or {}).get(
                        "state"
                    ) or ""
                ),
                "availability_policy_boundary": str(
                    (row.get("shared_target_availability") or {}).get(
                        "policy_boundary"
                    ) or ""
                ),
                "target_fault_injection": "FORBIDDEN",
                "target_fingerprint": str(row.get("semantic_fingerprint") or ""),
            })
            used_domains.add(domain)
            remaining -= assigned
            if remaining == 0:
                break
        allocations[str(requested_stage)] = {
            "requested_scope": requested_stage,
            "allocated_scope": requested_stage - remaining,
            "feasible": remaining == 0 and bool(allocation),
            "immutable_allocation_projection": allocation,
            "allocation_fingerprint": sha256_json({
                "inventory_fingerprint": inventory_fingerprint,
                "stage": requested_stage,
                "excluded_target_ids": sorted(excluded),
                "allocation": allocation,
            }) if remaining == 0 and allocation else "",
        }
    return {
        "ranked_target_ids": [str(row.get("target_id") or "") for row in ranked],
        "excluded_target_ids": sorted(excluded),
        "eligible_target_count": len(ranked),
        "stage_allocations": allocations,
    }


def availability_first_target_growth_trial_projection(
    *,
    rows: list[dict[str, Any]],
    campaign: dict[str, Any],
    inventory_fingerprint: str,
    excluded_target_ids: Optional[set[str]] = None,
) -> dict[str, Any]:
    """Select one exact target-bound predecessor when the next stage is short.

    A degraded target's real production-proven bound grows independently from
    the aggregate campaign ladder.  Without this predecessor the aggregate
    next stage can become circular: it needs a larger target bound, while that
    bound can only be learned by a smaller real controlled trial.  This is a
    read-only projection over the same Matrix, capacity, policy and audit
    owners; it is not a second campaign or evidence registry.
    """
    excluded = {str(value) for value in (excluded_target_ids or set()) if value}
    next_stage = to_int(campaign.get("next_stage"), 0)
    candidates: list[dict[str, Any]] = []
    for row in rows:
        target_id = str(row.get("target_id") or "")
        capacity = row.get("capacity")
        capacity = capacity if isinstance(capacity, dict) else {}
        availability = row.get("shared_target_availability")
        availability = (
            availability if isinstance(availability, dict) else {}
        )
        proven = max(
            0,
            to_int(
                (campaign.get("target_proven_bounds") or {}).get(target_id),
                to_int(
                    capacity.get(
                        "availability_first_proven_additional_scope"
                    ),
                    0,
                ),
            ),
        )
        trial_scope = to_int(
            capacity.get("availability_first_next_trial_scope"),
            0,
        )
        safe_scope = to_int(
            capacity.get("target_safe_additional_capacity"),
            0,
        )
        if (
            not target_id
            or target_id in excluded
            or not row.get("shared_target_technically_eligible")
            or availability.get("state")
            not in {"DEGRADED_USABLE", "LAST_RESORT_USABLE"}
            or trial_scope not in operator_execution.AVAILABILITY_FIRST_LADDER
            or trial_scope <= proven
            or trial_scope >= next_stage
            or safe_scope < trial_scope
        ):
            continue
        allocation = {
            "target_id": target_id,
            "correlation_domain": str(row.get("correlation_domain") or ""),
            "allocated_users": trial_scope,
            "capacity_reservation": trial_scope,
            "capacity_reservation_semantics": (
                "SERIALIZED_PACKET_LEASE_RESERVATION_WITH_FRESH_"
                "PRE_APPLY_REVALIDATION"
            ),
            "capacity_bounds_fingerprint": sha256_json(
                capacity.get("capacity_bounds") or {}
            ),
            "ordinary_users_unchanged": int(
                capacity.get("ordinary_users") or 0
            ),
            "availability_classification": str(
                availability.get("state") or ""
            ),
            "availability_policy_boundary": str(
                availability.get("policy_boundary") or ""
            ),
            "target_fault_injection": "FORBIDDEN",
            "target_fingerprint": str(row.get("semantic_fingerprint") or ""),
        }
        fingerprint = sha256_json({
            "standing_policy_contract_id": str(
                campaign.get("standing_policy_contract_id") or ""
            ),
            "campaign_next_stage": next_stage,
            "inventory_fingerprint": inventory_fingerprint,
            "target_proven_bound": proven,
            "trial_scope": trial_scope,
            "allocation": allocation,
        })
        candidates.append({
            "schema_version": (
                "v7.availability-first-target-bound-trial.v1"
            ),
            "status": "TARGET_BOUND_TRIAL_READY",
            "ok": True,
            "feasible": True,
            "campaign_next_stage": next_stage,
            "target_id": target_id,
            "proven_scope": proven,
            "trial_scope": trial_scope,
            "allocated_scope": trial_scope,
            "immutable_allocation_projection": [allocation],
            "allocation_fingerprint": fingerprint,
            "ordinary_user_effect": "FORBIDDEN",
            "target_fault_injection": "FORBIDDEN",
            "production_credit_class": (
                "TARGET_BOUND_ONLY_NOT_CAMPAIGN_STAGE"
            ),
        })
    if not candidates:
        return {
            "schema_version": "v7.availability-first-target-bound-trial.v1",
            "status": "NOT_REQUIRED_OR_NOT_FEASIBLE",
            "ok": True,
            "feasible": False,
            "campaign_next_stage": next_stage,
        }
    return max(
        candidates,
        key=lambda item: (
            int(item.get("trial_scope") or 0),
            str(item.get("target_id") or ""),
        ),
    )


def shared_target_semantic_fingerprint(row: dict[str, Any]) -> str:
    """Fingerprint target truth without wall-clock-only read metadata.

    ``quality.age_seconds`` changes between the Matrix admission read and the
    executor's immediate revalidation even when every owner-backed snapshot is
    identical.  Fresh/stale status and the owner's ``updated`` timestamp are
    material and remain bound; the derived display age is not.
    """
    semantic = {
        key: copy.deepcopy(value)
        for key, value in row.items()
        if key not in {"semantic_fingerprint"}
    }
    quality = (
        semantic.get("quality")
        if isinstance(semantic.get("quality"), dict)
        else {}
    )
    quality.pop("age_seconds", None)
    return sha256_json(semantic)


def availability_first_standing_policy_semantic_coverage_gate(
    *,
    standing_validation: dict[str, Any],
    policy_contract: dict[str, Any],
    availability_scope: dict[str, Any],
    stage: int,
    allocation: dict[str, Any],
) -> dict[str, Any]:
    """Compare one shared-target effect with the active standing envelope.

    This is a compact, read-only consumer of the existing policy, Planner and
    capacity owners.  It deliberately does not issue Authority, create a
    Candidate/Packet/lease, or turn an allocation into execution.  Its purpose
    is to prevent a label-only shared-target boundary from being projected as
    a new Authority request when the current standing contract already covers
    the exact certification-only effect.
    """
    contract = policy_contract if isinstance(policy_contract, dict) else {}
    scope = availability_scope if isinstance(availability_scope, dict) else {}
    allocation = allocation if isinstance(allocation, dict) else {}
    rows = [
        row for row in (allocation.get("immutable_allocation_projection") or [])
        if isinstance(row, dict)
    ]
    target_classes = sorted({
        str(row.get("availability_classification") or "")
        for row in rows
        if str(row.get("availability_classification") or "")
    })
    actions = (
        ["ASSIGN_CERTIFICATION_COHORT_TO_SHARED_TARGET_SET"]
        if len(rows) > 1 else ["ASSIGN_CERTIFICATION_COHORT_TO_SHARED_TARGET"]
        if len(rows) == 1 else []
    )
    effect = {
        "action_class": operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS,
        "actions": actions,
        "identity_class": "CERTIFICATION_ONLY",
        "total_mission_cohort": int(stage or 0),
        "batch_size": 1,
        "max_concurrent_transactions": 1,
        "target_classifications": target_classes,
        "ordinary_route_delta": 0,
        "ordinary_assignment_delta": 0,
        "ordinary_fault_injection_delta": 0,
        "target_fault_injection": False,
        "external_resource_creation": False,
        "credential_mutation": False,
        "hard_limit_mutation": False,
        "self_expansion": False,
        "verification": "PER_USER_PER_TARGET_AGGREGATE",
        "rollback_containment": "TARGET_LOCAL_REQUIRED",
        "natural_l8_credit": False,
    }
    mismatches: list[str] = []
    if not standing_validation.get("ok"):
        mismatches.extend(
            "standing_contract:" + str(error)
            for error in (standing_validation.get("errors") or [])
        )
    policy = (
        standing_validation.get("policy")
        if isinstance(standing_validation.get("policy"), dict)
        else {}
    )
    if policy.get("policy_profile") != operator_execution.AVAILABILITY_FIRST_STANDING_POLICY_PROFILE:
        mismatches.append("policy_profile")
    if (
        operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
        not in set(policy.get("allowed_action_classes") or [])
    ):
        mismatches.append("action_class")
    allowed_actions = set(scope.get("allowed_actions") or [])
    if not actions or any(action not in allowed_actions for action in actions):
        mismatches.append("allowed_actions")
    if scope.get("certification_identities_only") is not True:
        mismatches.append("certification_identities_only")
    if int(stage or 0) < 1 or int(stage or 0) > to_int(
        scope.get("max_users_per_transaction"), 0,
    ):
        mismatches.append("max_users_per_transaction")
    if to_int(scope.get("max_concurrent_transactions"), 0) < 1:
        mismatches.append("max_concurrent_transactions")
    if int(stage or 0) not in set(
        to_int(item, 0) for item in (scope.get("ladder") or [])
    ):
        mismatches.append("ladder")
    allowed_classes = set(scope.get("allowed_target_classifications") or [])
    if not target_classes or any(value not in allowed_classes for value in target_classes):
        mismatches.append("allowed_target_classifications")
    required_fences = {
        "ordinary_identity_delta": 0,
        "ordinary_route_delta": 0,
        "ordinary_assignment_mutation_allowed": False,
        "ordinary_reclassification_allowed": False,
        "shared_target_fault_injection_allowed": False,
        "shared_target_restart_allowed": False,
        "hard_limit_modification_allowed": False,
        "private_credential_mutation_allowed": False,
        "external_resource_creation_allowed": False,
        "authority_self_expansion_allowed": False,
        "immutable_allocation_required": True,
        "fresh_inventory_required": True,
        "fresh_candidate_required": True,
        "fresh_packet_or_packet_set_required": True,
        "fresh_lease_required": True,
        "restore_barrier_before_apply_required": True,
        "per_user_verification_required": True,
        "per_target_verification_required": True,
        "aggregate_verification_required": True,
        "ordinary_user_quality_verification_required": True,
        "cohort_circuit_breaker_required": True,
        "partial_target_containment_required": True,
        "rollback_or_redistribution_required": True,
        "baseline_reset_between_stages_required": True,
        "capacity_double_counting_forbidden": True,
        "source_target_collision_forbidden": True,
    }
    for name, expected in required_fences.items():
        if scope.get(name) != expected:
            mismatches.append(name)
    mismatches = sorted(set(mismatches))
    covered = not mismatches
    structural_binding_gap = any(
        value.startswith("standing_contract:")
        for value in mismatches
    )
    dimensions = [
        "action_class", "allowed_actions", "identity_class",
        "total_mission_cohort", "batch_size", "concurrency",
        "target_classifications", "ordinary_user_fences",
        "fault_injection_fence", "verification", "rollback_containment",
        "freshness", "self_expansion", "natural_l8_credit",
    ]
    return {
        "schema_version": "v7.standing-policy-semantic-coverage-gate.v1",
        "status": (
            "AUTO_ADMITTED_BY_EXISTING_STANDING_POLICY"
            if covered else "GENUINE_AUTHORITY_EXPANSION_REQUIRED"
            if not structural_binding_gap else "ENGINEERING_BINDING_GAP"
        ),
        "ok": covered,
        "contract_id": str(contract.get("contract_id") or ""),
        "contract_hash": str(contract.get("contract_hash") or ""),
        "normalized_effect": effect,
        "matched_dimensions": dimensions if covered else [],
        "mismatched_dimensions": mismatches,
        "forbidden_effects": {
            "policy_write": False,
            "authority_issuance": False,
            "candidate_created": False,
            "packet_created": False,
            "lease_created": False,
            "runtime_apply": False,
            "routing_mutation": False,
            "user_movement": 0,
            "rollback_apply": False,
            "authority_expansion": False,
            "production_maturity_change": False,
        },
    }


def controlled_campaign_target_selection_diagnostic(
    args: argparse.Namespace,
) -> dict[str, Any]:
    """Project target discovery/ranking through the existing Planner owners.

    The projection is intentionally ephemeral.  Matrix, registry, quality,
    assignment, load, policy and Authority audit remain the durable owners;
    this function exposes only a compact generation, fingerprints, decisions
    and lineage.  It never creates a Candidate, Packet, lease or execution
    artifact.
    """
    forbidden = [
        name for name in (
            "apply",
            "controlled_verifier_contention",
            "allow_pre_planner_refresh_with_apply",
        )
        if bool_value(getattr(args, name, False))
    ]
    forbidden.extend(
        name for name in (
            "approved_packet_id",
            "approved_operation_id",
            "approved_selected_move_hash",
            "approved_authority_generation",
            "approved_breaker_generation",
            "approved_source_bundle_hash",
            "approved_snapshot_bundle_hash",
            "generate_rollback_packet_from_result",
            "rollback_packet",
            "promote_authority_to",
        )
        if str(getattr(args, name, "") or "").strip()
    )
    if str(getattr(args, "pre_planner_refresh", "off") or "off") != "off":
        forbidden.append("pre_planner_refresh")
    forbidden_effects = {
        "inventory_store_created": False,
        "candidate_created": False,
        "packet_created": False,
        "lease_created": False,
        "restore_barrier_write": False,
        "runtime_apply": False,
        "routing_mutation": False,
        "user_movement": 0,
        "rollback_apply": False,
        "authority_expansion": False,
        "production_maturity_change": False,
    }
    if forbidden:
        return {
            "schema_version": "v7.controlled-campaign-target-selection-diagnostic.v1",
            "status": "STOP_SAFE_FORBIDDEN_FLAGS",
            "ok": False,
            "blockers": [
                f"controlled_target_diagnostic_forbids_{name}"
                for name in sorted(set(forbidden))
            ],
            "forbidden_effects": forbidden_effects,
        }

    policy_root = read_json(Path(args.policy_file), {})
    policy_contract = (
        policy_root.get("delegated_autonomy_policy")
        if isinstance(policy_root, dict)
        and isinstance(policy_root.get("delegated_autonomy_policy"), dict)
        else {}
    )
    audit_records = operator_execution.read_live_execution_lineage_records(
        Path(args.action_class_audit_store)
    )
    standing_validation = (
        operator_execution.validate_standing_delegated_operational_policy(
            policy_contract,
            audit_records=audit_records,
        )
    )
    standing_policy = (
        standing_validation.get("policy")
        if isinstance(standing_validation.get("policy"), dict)
        else {}
    )
    availability_scope = (
        (standing_policy.get("action_class_scopes") or {}).get(
            operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
        )
        if isinstance(standing_policy.get("action_class_scopes"), dict)
        else {}
    )
    availability_scope = (
        availability_scope if isinstance(availability_scope, dict) else {}
    )
    availability_authority_active = bool(
        standing_validation.get("ok")
        and standing_policy.get("policy_profile")
        == operator_execution.AVAILABILITY_FIRST_STANDING_POLICY_PROFILE
        and operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
        in set(standing_policy.get("allowed_action_classes") or [])
    )
    availability_authority_max = (
        max(
            0,
            to_int(
                availability_scope.get("max_users_per_transaction"),
                0,
            ),
        )
        if availability_authority_active else 0
    )
    availability_campaign = (
        operator_execution.availability_first_campaign_stage_status(
            audit_records,
            contract=policy_contract,
        )
        if availability_authority_active
        else {
            "schema_version": (
                "v7.availability-first-campaign-stage-status.v1"
            ),
            "status": "POLICY_NOT_ACTIVE",
            "ok": True,
            "stages": list(operator_execution.AVAILABILITY_FIRST_LADDER),
            "completed_stages": [],
            "production_proven_max": 0,
            "next_stage": 1,
            "completed": False,
            "receipt_ids": [],
            "blockers": [],
        }
    )
    availability_current_stage = max(
        0,
        to_int(availability_campaign.get("next_stage"), 0),
    )
    authority = (
        operator_execution.controlled_certification_substrate_authority_status(
            audit_records,
        )
    )
    request = (
        authority.get("request")
        if isinstance(authority.get("request"), dict)
        else {}
    )
    scope = (
        request.get("scope")
        if isinstance(request.get("scope"), dict)
        else {}
    )
    campaign = operator_execution.controlled_certification_campaign_stage_status(
        audit_records,
        request_id=str(authority.get("request_id") or ""),
        request_hash=str(authority.get("request_hash") or ""),
    )
    source_id = str(scope.get("source_id") or "")
    pinned_target_id = str(scope.get("controlled_target_id") or "")
    stages = [
        int(value)
        for value in (campaign.get("stages") or scope.get("campaign_stages") or [])
        if to_int(value, 0) > 0
    ]
    current_stage = max(
        0,
        to_int(campaign.get("next_stage"), 0)
        or min(stages or [5]),
    )
    remaining_stages = [
        stage for stage in stages
        if stage not in set(int(value) for value in (campaign.get("completed_stages") or []))
    ]
    completion_stage = max(remaining_stages or stages or [current_stage or 0])

    diagnostic_args = argparse.Namespace(**vars(args))
    diagnostic_args.apply = False
    diagnostic_args.mode = ""
    diagnostic_args.pre_planner_refresh = "off"
    diagnostic_args.emergency_failover_autonomy = True
    diagnostic_args.controlled_certification_campaign_request_id = str(
        authority.get("request_id") or ""
    )
    diagnostic_args.controlled_certification_campaign_request_hash = str(
        authority.get("request_hash") or ""
    )
    diagnostic_args.controlled_certification_campaign_target = pinned_target_id
    diagnostic_args.source_egress = source_id
    diagnostic_args.target_egress = pinned_target_id
    planner = AutoswitchPlanner(diagnostic_args)

    source_users = sorted(
        (
            user for user in planner.users
            if user.enabled and user.current == source_id
        ),
        key=lambda user: user.ip,
    )
    representative = next((
        user for user in source_users
        if bool_value(user.raw.get("certification_user"))
    ), None)
    if representative is None:
        representative = source_users[0] if source_users else User(
            ip="10.7.255.254",
            current=source_id,
            enabled=True,
            group=str(planner.org_policy.get("default_group") or "default"),
            raw={"certification_user": "1", "diagnostic_only": "1"},
        )
    important_services = planner._important_services(representative)
    route_class = planner._route_class_for_services(important_services)
    registry_rows = parse_registry(Path(args.state_dir) / "egress.registry")
    registry_by_id = {
        str(row.get("id") or ""): row
        for row in registry_rows
        if str(row.get("id") or "")
    }
    assignment_rows = [
        row for row in parse_registry(Path(args.state_dir) / "users.registry")
        if bool_value(row.get("enabled", "1"))
    ]
    matrix = read_json(Path(args.state_dir) / "service-matrix.json", {})
    matrix_updated = str(matrix.get("updated") or "")
    quality = read_json(Path(args.quality_summary_file), {})
    quality_items = (
        quality.get("items")
        if isinstance(quality.get("items"), dict)
        else quality if isinstance(quality, dict) else {}
    )
    policy_min_stability = to_float(
        planner.quality_policy.get("min_stability"),
        DEFAULT_QUALITY_POLICY["min_stability"],
    )
    required_reserve = max(
        0,
        to_int(
            planner.load_policy.get(
                "controlled_certification_required_reserve_users"
            ),
            1,
        ),
    )
    authority_status = str(authority.get("status") or "NONE")
    authority_expiry = str(authority.get("expires_at") or "")
    authority_unexpired = bool(
        authority_status == "APPROVED"
        and (not authority_expiry or parse_ts(authority_expiry) > time.time())
    )

    rows: list[dict[str, Any]] = []
    for target_id, egress in sorted(planner.egress.items()):
        registry = registry_by_id.get(target_id, {})
        target_assignments = [
            row for row in assignment_rows
            if str(row.get("current") or "") == target_id
        ]
        certification_users = sum(
            1 for row in target_assignments
            if bool_value(row.get("certification_user"))
        )
        ordinary_users = len(target_assignments) - certification_users
        baseline = controlled_certification_source_health_status(
            Path(args.state_dir),
            target_id,
        )
        candidate = planner._candidate(
            representative,
            egress,
            important_services,
            route_class,
            purpose="failover",
        )
        candidate_json = planner._candidate_json(candidate)
        load = planner._load_limits_for_egress(egress)
        hard_limit = max(0, to_int(load.get("hard_limit"), 0))
        free_capacity = max(
            0,
            hard_limit - int(egress.users) - required_reserve,
        )
        controlled_only_contract = bool(
            str(registry.get("role") or "").upper() == "EXECUTION_ONLY"
            and bool_value(registry.get("execution_reserved"))
            and bool_value(registry.get("canary_reserved"))
            and str(registry.get("reservation_owner") or "")
            == "operator_execution_governance"
            and not bool_value(registry.get("autoswitch_allowed"))
            and not bool_value(registry.get("rebalance_allowed"))
            and str(
                registry.get("production_assignment_allowed") or ""
            ).lower() in {"0", "false", "no"}
        )
        exact_authority_target = bool(
            target_id == pinned_target_id and authority_unexpired
        )
        quality_windows = (
            quality_items.get(target_id, {}).get("windows", {})
            if isinstance(quality_items.get(target_id), dict)
            else {}
        )
        quality_updated = str(
            (quality_items.get(target_id) or {}).get("updated")
            or (quality.get("updated") if isinstance(quality, dict) else "")
            or ""
        )
        quality_age_seconds = (
            max(0.0, time.time() - parse_ts(quality_updated))
            if quality_updated else -1.0
        )
        quality_fresh = bool(
            quality_updated
            and quality_age_seconds
            <= CONTROLLED_CERTIFICATION_BASELINE_MAX_AGE_SECONDS
        )
        stability_inputs = {
            "current": round(egress.stability, 6),
            "5m": round(
                to_float((quality_windows.get("5m") or {}).get("stability"), -1.0),
                6,
            ),
            "1h": round(
                to_float((quality_windows.get("1h") or {}).get("stability"), -1.0),
                6,
            ),
        }
        explicit_stability_blockers = [
            f"{window}_stability_missing_or_below_floor"
            for window, value in stability_inputs.items()
            if value < policy_min_stability
        ]
        if not quality_fresh:
            explicit_stability_blockers.append("quality_windows_stale_or_missing")
        quality_blockers = sorted({
            reason for reason in candidate.blocked
            if reason in {
                "avg_mbps_below_floor",
                "min_mbps_below_floor",
                "stability_below_floor",
            }
        }.union(explicit_stability_blockers))
        # Keep the Planner's normal quality floor separate from hard target
        # ineligibility.  Availability-first deliberately allows a fresh,
        # reachable target with sustained positive measurements to enter the
        # bounded DEGRADED_USABLE/LAST_RESORT_USABLE path.  Feeding the same
        # quality reason into both inputs would silently turn every soft SLO
        # miss back into a hard failure.
        non_controlled_blockers = sorted({
            reason for reason in candidate.blocked
            if reason not in {
                "manual_only",
                "reserve_only",
                "canary_reserved_production_assignment_blocked",
            }
            and reason not in set(quality_blockers)
        })
        # ``controlled_certification_source_health_status`` is intentionally
        # stricter than an ordinary destination: it proves the source is safe
        # to deliberately fail and later restore.  Applying it unchanged to a
        # non-destructive shared destination turns profile-irrelevant service
        # failures into a false hard exclusion.  The existing Planner already
        # owns profile-aware target reachability in ``candidate.blocked``.
        shared_target_reachability_ok = bool(
            baseline.get("service_count") and not non_controlled_blockers
        )
        shared_target_availability = classify_shared_target_availability(
            target_id=target_id,
            source_id=source_id,
            health_ok=shared_target_reachability_ok,
            capacity_owner_reconciled=bool(
                load.get("capacity_owner_reconciled")
            ),
            free_capacity_after_reserve=free_capacity,
            verification_supported=bool(
                baseline.get("service_count") and egress.interface
            ),
            rollback_containment_supported=bool(egress.interface),
            quality_fresh=quality_fresh,
            stability_inputs=stability_inputs,
            current_avg_mbps=egress.avg_mbps,
            current_min_mbps=egress.min_mbps,
            normal_quality_blockers=quality_blockers,
            non_quality_blockers=non_controlled_blockers,
        )
        availability_state = str(
            shared_target_availability.get("state") or ""
        )
        target_proven_bound = max(
            0,
            to_int(
                (
                    availability_campaign.get("target_proven_bounds")
                    or {}
                ).get(target_id),
                0,
            ),
        )
        next_trial_bound = next(
            (
                stage
                for stage in operator_execution.AVAILABILITY_FIRST_LADDER
                if stage > target_proven_bound
            ),
            target_proven_bound,
        )
        if availability_state == "HEALTHY":
            planning_safe_increment = int(
                shared_target_availability.get(
                    "technical_safe_additional_capacity"
                )
                or 0
            )
        elif availability_state in {
            "DEGRADED_USABLE",
            "LAST_RESORT_USABLE",
        }:
            planning_safe_increment = min(
                free_capacity,
                max(1, next_trial_bound),
            )
        else:
            planning_safe_increment = 0
        capacity_bound_values = {
            "hard_capacity_remaining": free_capacity,
            "ordinary_protection_margin": free_capacity,
            "throughput_safe_increment": planning_safe_increment,
            "quality_safe_increment": planning_safe_increment,
            "verification_safe_increment": (
                free_capacity
                if baseline.get("service_count") and egress.interface
                else 0
            ),
            "rollback_containment_safe_increment": (
                free_capacity if egress.interface else 0
            ),
            "authority_safe_increment": availability_authority_max,
            "runtime_safe_increment": availability_authority_max,
        }
        capacity_bound_owners = {
            "hard_capacity_remaining": str(
                load.get("capacity_owner") or ""
            ),
            "ordinary_protection_margin": str(
                load.get("capacity_owner") or ""
            ),
            "throughput_safe_increment": str(args.quality_summary_file),
            "quality_safe_increment": str(args.quality_summary_file),
            "verification_safe_increment": (
                "existing Matrix/service verification owner"
            ),
            "rollback_containment_safe_increment": (
                "existing governed rollback/containment owner"
            ),
            "authority_safe_increment": (
                "admin_core/operator_execution.py standing policy owner"
            ),
            "runtime_safe_increment": (
                "tools/v7-users-autoswitch governed execution owner"
            ),
        }
        capacity_bounds = {
            name: {
                "value": int(value),
                "owner": capacity_bound_owners[name],
                "fresh": bool(
                    quality_fresh
                    if name in {
                        "throughput_safe_increment",
                        "quality_safe_increment",
                    }
                    else standing_validation.get("ok")
                    if name in {
                        "authority_safe_increment",
                        "runtime_safe_increment",
                    }
                    else True
                ),
                "reason": (
                    "standing availability-first envelope active"
                    if name in {
                        "authority_safe_increment",
                        "runtime_safe_increment",
                    } and availability_authority_active
                    else "standing availability-first envelope absent"
                    if name in {
                        "authority_safe_increment",
                        "runtime_safe_increment",
                    }
                    else str(
                        shared_target_availability.get("emergency_reason")
                        or "owner-backed current bound"
                    )
                ),
                "fingerprint": sha256_json({
                    "target_id": target_id,
                    "name": name,
                    "value": int(value),
                    "owner": capacity_bound_owners[name],
                    "matrix_updated": matrix_updated,
                    "quality_updated": quality_updated,
                    "policy_scope_hash": str(
                        policy_contract.get("policy_scope_hash") or ""
                    ),
                }),
            }
            for name, value in capacity_bound_values.items()
        }
        executable_safe_increment = min(
            int(item["value"]) for item in capacity_bounds.values()
        )
        measurement_semantics = {
            "protocol": str(registry.get("protocol") or ""),
            "handshake_signal": (
                "NOT_APPLICABLE"
                if str(registry.get("protocol") or "").lower()
                in {"vless", "openvpn"}
                else "APPLICABLE"
            ),
            "quality_fail_rate_role": "ADVISORY_ONLY",
            "service_reachability_role": "HARD_GATE",
            "current_5m_1h_stability_role": "HARD_GATE",
            "valid": True,
        }
        verification_supported = bool(
            baseline.get("service_count") and egress.interface
        )
        rollback_containment_supported = bool(egress.interface)
        controlled_rebind_eligible = bool(
            target_id != source_id
            and controlled_only_contract
            and ordinary_users == 0
            and baseline.get("ok")
            and not quality_blockers
            and not non_controlled_blockers
            and load.get("capacity_owner_reconciled")
            and free_capacity > 0
            and verification_supported
            and rollback_containment_supported
        )
        # A controlled source needs exclusive ownership because its failure is
        # deliberately materialised. A destination does not: it may carry
        # ordinary users when health, reserve and verification are good. This
        # remains a read-only capacity projection, never an execution grant.
        shared_target_technically_eligible = bool(
            shared_target_availability.get("technical_safe_additional_capacity")
            and not shared_target_availability.get("hard_reasons")
        )
        shared_target_policy_scope_status = (
            "CURRENT_EXECUTION_ONLY_TARGET_CONTRACT_SUFFICIENT"
            if (
                controlled_only_contract
                and ordinary_users == 0
                and shared_target_availability.get("state") == "HEALTHY"
            )
            else str(shared_target_availability.get("policy_boundary") or "")
            if shared_target_technically_eligible
            and shared_target_availability.get("state") != "HEALTHY"
            else "EXACT_SHARED_PRODUCTION_TARGET_ACTION_CLASS_CONTRACT_REQUIRED"
            if shared_target_technically_eligible
            else "NOT_ELIGIBLE_FOR_SHARED_TARGET_CONTRACT"
        )
        current_stage_feasible = bool(
            controlled_rebind_eligible
            and free_capacity >= current_stage > 0
        )
        campaign_completion_feasible = bool(
            controlled_rebind_eligible
            and free_capacity >= completion_stage > 0
        )
        full_live_admission = bool(
            exact_authority_target
            and current_stage_feasible
        )
        exclusion_reasons: list[str] = []
        if target_id == source_id:
            exclusion_reasons.append("source_cannot_be_its_own_target")
        if not controlled_only_contract:
            exclusion_reasons.append(
                "controlled_assignment_permission_or_isolation_contract_missing"
            )
        if ordinary_users:
            exclusion_reasons.append(
                "ordinary_user_occupancy_forbidden_by_current_campaign"
            )
        if not baseline.get("ok"):
            exclusion_reasons.append(
                str(baseline.get("status") or "target_baseline_invalid")
            )
        if not shared_target_technically_eligible:
            exclusion_reasons.extend(quality_blockers)
            exclusion_reasons.extend(non_controlled_blockers)
            exclusion_reasons.extend(
                shared_target_availability.get("hard_reasons") or []
            )
        if not load.get("capacity_owner_reconciled"):
            exclusion_reasons.extend(load.get("capacity_owner_errors") or [])
        if not verification_supported:
            exclusion_reasons.append("verification_contract_not_supported")
        if not rollback_containment_supported:
            exclusion_reasons.append(
                "rollback_or_containment_contract_not_supported"
            )
        if current_stage and free_capacity < current_stage:
            exclusion_reasons.append("current_stage_capacity_or_reserve_insufficient")
        row = {
            "target_id": target_id,
            "protocol": str(registry.get("protocol") or ""),
            "family": str(registry.get("protocol") or ""),
            "interface": str(registry.get("interface") or ""),
            "role": str(registry.get("role") or egress.role),
            "reservation_owner": str(registry.get("reservation_owner") or ""),
            "current_authority_exact_target": exact_authority_target,
            "controlled_only_contract": controlled_only_contract,
            "ordinary_planner_eligible": bool(candidate.eligible),
            "controlled_rebind_eligible": controlled_rebind_eligible,
            "shared_target_technically_eligible": shared_target_technically_eligible,
            "shared_target_policy_scope_status": shared_target_policy_scope_status,
            "shared_target_availability": shared_target_availability,
            "shared_target_safety_contract": {
                "ordinary_assignment_delta": 0,
                "ordinary_route_delta": 0,
                "target_fault_injection": "FORBIDDEN",
                "ordinary_slo_and_reserve_owner": str(load.get("capacity_owner") or ""),
                "fresh_per_transaction_revalidation": True,
                "aggregate_cohort_verification_required": True,
                "rollback_or_certified_no_rollback_required": True,
            },
            "full_live_admission": full_live_admission,
            "health": {
                "status": str(baseline.get("status") or ""),
                "ok": shared_target_reachability_ok,
                "source_baseline_ok": bool(baseline.get("ok")),
                "destination_health_owner": (
                    "existing Planner profile-aware service suitability"
                ),
                "service_count": int(baseline.get("service_count") or 0),
                "reachable_service_count": int(
                    baseline.get("reachable_service_count") or 0
                ),
                "hard_failure_count": int(
                    baseline.get("hard_failure_count") or 0
                ),
                "observation_fingerprint": str(
                    baseline.get("observation_fingerprint") or ""
                ),
            },
            "quality": {
                "current_avg_mbps": round(egress.avg_mbps, 3),
                "current_min_mbps": round(egress.min_mbps, 3),
                "current_stability": round(egress.stability, 6),
                "stability_floor": policy_min_stability,
                "required_stability_inputs": stability_inputs,
                "window_5m": quality_windows.get("5m") or {},
                "window_1h": quality_windows.get("1h") or {},
                "updated": quality_updated,
                "age_seconds": (
                    round(quality_age_seconds, 3)
                    if quality_age_seconds >= 0 else None
                ),
                "fresh": quality_fresh,
                "decision": candidate_json.get("quality_decision") or {},
                "blockers": quality_blockers,
            },
            "measurement_semantics": measurement_semantics,
            "capacity": {
                **load,
                "current_assigned_users": int(egress.users),
                "ordinary_users": ordinary_users,
                "certification_users": certification_users,
                "required_reserve": required_reserve,
                "free_capacity_after_reserve": free_capacity,
                "hard_capacity_remaining": free_capacity,
                "ordinary_user_protected_margin": free_capacity,
                "throughput_safe_increment": planning_safe_increment,
                "quality_safe_increment": planning_safe_increment,
                "verification_safe_increment": (
                    free_capacity if verification_supported else 0
                ),
                "rollback_containment_safe_increment": (
                    free_capacity if rollback_containment_supported else 0
                ),
                "authority_safe_increment": availability_authority_max,
