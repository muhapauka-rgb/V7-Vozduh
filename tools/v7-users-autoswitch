    def _intelligence_snapshot_source_mismatches(self, family: str, payload: dict[str, Any]) -> list[str]:
        if not isinstance(payload, dict):
            return []
        hashes = payload.get("source_hashes")
        if not isinstance(hashes, dict):
            return []
        expected_by_key: dict[str, str] = {}
        if family in {"service-scores", "channel-service-scores"}:
            expected_by_key = {
                "service_matrix": sha256_json(self.matrix or {}),
                "quality_summary": sha256_json(self.quality_summary or {}),
                "service_preferences": sha256_json(self.service_prefs or {}),
            }
        mismatches: list[str] = []
        for key, expected in expected_by_key.items():
            actual = str(hashes.get(key) or "")
            if actual and expected and actual != expected:
                mismatches.append(f"source_hash_mismatch:{family}:{key}")
        return mismatches

    def _intelligence_snapshot_gate(self, selected_before_gate: int = 0) -> dict[str, Any]:
        gate = dict(self.intelligence_snapshots)
        refresh = dict(self.pre_planner_refresh)
        refresh_stop = bool_value(refresh.get("stop_required"))
        if refresh.get("enabled"):
            gate["pre_planner_refresh"] = refresh
        if getattr(self, "service_matrix_lock", None):
            gate["service_matrix_lock"] = dict(self.service_matrix_lock)
        if refresh_stop:
            gate["active"] = True
            gate["stop_required"] = True
            gate["unavailable_reason"] = str(refresh.get("state") or "pre_planner_refresh_failed")
            stop_families = set(gate.get("stop_families") or [])
            stop_families.add("pre-planner-refresh")
            gate["stop_families"] = sorted(stop_families)
        gate["selected_moves_before_gate"] = selected_before_gate
        gate["selected_moves_suppressed"] = bool(gate.get("active") and gate.get("stop_required") and selected_before_gate > 0)
        gate["runtime_behavior_changed"] = False
        gate["governance_behavior_changed"] = False
        gate["execution_behavior_changed"] = False
        gate["hard_gate_override"] = "forbidden"
        gate["reservation_override"] = "forbidden"
        return gate

    def _apply_source_bundle_lease_to_intelligence_gate(
        self,
        gate: dict[str, Any],
        restore_barrier: dict[str, Any],
        approved_plan_lock: dict[str, Any],
    ) -> dict[str, Any]:
        materiality = self._approved_plan_lock_snapshot_gate_materiality(gate, restore_barrier, approved_plan_lock)

        def allow_non_material_source_mismatch() -> dict[str, Any]:
            leased = dict(gate)
            leased.update(materiality)
            leased["snapshot_gate_decision"] = "allow_approved_plan_lock_non_material_source_mismatch"
            leased["stop_required_before_approved_plan_lock"] = True
            leased["stop_required"] = False
            leased["runtime_behavior"] = "ALLOW_APPROVED_PLAN_LOCK_NON_MATERIAL_SOURCE_MISMATCH"
            leased["selected_moves_suppressed"] = False
            leased["selected_moves_after_gate"] = int(gate.get("selected_moves_before_gate") or 0)
            leased["approved_plan_lock_consumed"] = True
            leased["hard_gate_override"] = "approved_plan_lock_non_material_source_mismatch"
            leased["read_only_without_apply"] = not bool_value(getattr(self.args, "apply", False))
            leased["execution_behavior_changed"] = False
            leased["governance_behavior_changed"] = False
            leased["runtime_behavior_changed"] = False
            return leased

        def can_allow_non_material_source_mismatch() -> bool:
            return (
                materiality.get("snapshot_gate_decision") == "evaluate_source_bundle_lease"
                and bool_value(getattr(self.args, "apply", False))
                and not bool_value(materiality.get("snapshot_gate_material_change"))
                and not materiality.get("snapshot_gate_changed_fields")
            )

        if not approved_plan_lock.get("ok"):
            if bool_value(gate.get("active")) and bool_value(gate.get("stop_required")):
                gate.update(materiality)
            return gate
        if not bool_value(gate.get("active")) or not bool_value(gate.get("stop_required")):
            gate.update(materiality)
            return gate
        if not bool_value(restore_barrier.get("clearance_generation_ok")):
            gate.update(materiality)
            return gate
        if materiality.get("snapshot_gate_material_change"):
            gate.update(materiality)
            return gate
        if materiality.get("snapshot_gate_decision") == "allow_approved_plan_lock_non_material_snapshot_drift":
            leased = dict(gate)
            leased.update(materiality)
            leased["stop_required_before_approved_plan_lock"] = True
            leased["stop_required"] = False
            leased["runtime_behavior"] = "ALLOW_APPROVED_PLAN_LOCK_NON_MATERIAL_SNAPSHOT_DRIFT"
            leased["selected_moves_suppressed"] = False
            leased["selected_moves_after_gate"] = int(gate.get("selected_moves_before_gate") or 0)
            leased["approved_plan_lock_consumed"] = True
            leased["hard_gate_override"] = "approved_plan_lock_non_material_snapshot_drift"
            leased["read_only_without_apply"] = not bool_value(getattr(self.args, "apply", False))
            leased["execution_behavior_changed"] = False
            leased["governance_behavior_changed"] = False
            leased["runtime_behavior_changed"] = False
            return leased
        lease = restore_barrier.get("source_bundle_lease") or {}
        if (
            materiality.get("snapshot_gate_decision") == "evaluate_source_bundle_lease"
            and not isinstance(lease, dict)
        ):
            lease = {}
        if can_allow_non_material_source_mismatch() and not bool_value(lease.get("ok")):
            return allow_non_material_source_mismatch()
        if not isinstance(lease, dict) or not bool_value(lease.get("ok")):
            gate.update(materiality)
            return gate
        allowed_drift = {str(item) for item in (lease.get("allowed_source_drift") or [])}
        changed_keys = {str(item) for item in (lease.get("changed_source_keys") or [])}
        if not allowed_drift or not changed_keys.issubset(allowed_drift):
            if can_allow_non_material_source_mismatch():
                return allow_non_material_source_mismatch()
            gate.update(materiality)
            return gate

        results = gate.get("results") if isinstance(gate.get("results"), dict) else {}
        stop_families = [str(item) for item in (gate.get("stop_families") or [])]
        if not stop_families:
            return gate

        accepted_errors: list[str] = []
        for family in stop_families:
            payload = results.get(family) if isinstance(results, dict) else {}
            if not isinstance(payload, dict):
                if can_allow_non_material_source_mismatch():
                    return allow_non_material_source_mismatch()
                return gate
            errors = [str(item) for item in (payload.get("validation_errors") or [])]
            if not errors:
                if can_allow_non_material_source_mismatch():
                    return allow_non_material_source_mismatch()
                return gate
            for error in errors:
                match = re.fullmatch(r"source_hash_mismatch:[^:]+:([^:]+)", error)
                if not match or match.group(1) not in allowed_drift:
                    if can_allow_non_material_source_mismatch():
                        return allow_non_material_source_mismatch()
                    return gate
                accepted_errors.append(error)

        leased = dict(gate)
        leased.update(materiality)
        leased["stop_required_before_source_bundle_lease"] = True
        leased["stop_required"] = False
        leased["runtime_behavior"] = "ALLOW_APPROVED_SOURCE_BUNDLE_LEASE"
        leased["selected_moves_suppressed"] = False
        leased["selected_moves_after_gate"] = int(gate.get("selected_moves_before_gate") or 0)
        leased["source_bundle_lease_used"] = True
        leased["source_bundle_lease_scope"] = "approved_plan_lock_apply" if bool_value(getattr(self.args, "apply", False)) else "approved_plan_lock_readiness_recheck"
        leased["source_bundle_lease_allowed_drift"] = sorted(allowed_drift)
        leased["source_bundle_lease_changed_keys"] = sorted(changed_keys)
        leased["source_bundle_lease_accepted_errors"] = sorted(set(accepted_errors))
        leased["hard_gate_override"] = "approved_source_bundle_lease_for_locked_apply" if bool_value(getattr(self.args, "apply", False)) else "approved_source_bundle_lease_for_locked_readiness_recheck"
        leased["read_only_without_apply"] = not bool_value(getattr(self.args, "apply", False))
        leased["execution_behavior_changed"] = False
        leased["governance_behavior_changed"] = False
        leased["runtime_behavior_changed"] = False
        return leased

    def _approved_plan_lock_snapshot_gate_materiality(
        self,
        gate: dict[str, Any],
        restore_barrier: dict[str, Any],
        approved_plan_lock: dict[str, Any],
    ) -> dict[str, Any]:
        changed_fields: list[str] = []
        source = "approved_plan_lock_snapshot_gate"
        if not bool_value(gate.get("active")):
            return {
                "snapshot_gate_source": source,
                "snapshot_gate_decision": "snapshot_gate_inactive",
                "snapshot_gate_changed_fields": [],
                "snapshot_gate_material_change": False,
                "approved_plan_lock_consumed": bool_value(approved_plan_lock.get("ok")),
            }
        if not bool_value(gate.get("stop_required")):
            return {
                "snapshot_gate_source": source,
                "snapshot_gate_decision": "snapshot_gate_pass",
                "snapshot_gate_changed_fields": [],
                "snapshot_gate_material_change": False,
                "approved_plan_lock_consumed": bool_value(approved_plan_lock.get("ok")),
            }
        if not bool_value(approved_plan_lock.get("ok")):
            changed_fields.extend(approved_plan_lock.get("reasons") or [approved_plan_lock.get("reason") or "approved_plan_lock_invalid"])
        if not bool_value(restore_barrier.get("clearance_generation_ok")):
            changed_fields.append(str(restore_barrier.get("clearance_guard_reason") or restore_barrier.get("clearance_generation_reason") or "restore_barrier_clearance_invalid"))

        material_source_keys = {"users_registry", "egress_registry", "service_preferences", "policy", "authority_policy", "rollback_readiness", "verification_prerequisites"}
        source_mismatch_families = list(gate.get("source_mismatch_families") or [])
        results = gate.get("results") if isinstance(gate.get("results"), dict) else {}
        for family in source_mismatch_families:
            payload = results.get(family) if isinstance(results, dict) else {}
            if not isinstance(payload, dict):
                changed_fields.append(f"snapshot_source_mismatch:{family}:unknown")
                continue
            for error in payload.get("validation_errors") or []:
                text = str(error)
                match = re.fullmatch(r"source_hash_mismatch:[^:]+:([^:]+)", text)
                if match and match.group(1) in material_source_keys:
                    changed_fields.append(text)
                elif not match and "source_hash_mismatch" in text:
                    changed_fields.append(text)
                elif not match:
                    changed_fields.append(text)

        has_source_mismatch = bool(source_mismatch_families)
        snapshot_stop_without_material_source = bool_value(gate.get("stop_required")) and not changed_fields and not has_source_mismatch
        material = bool(changed_fields)
        if material:
            decision = "block_material_snapshot_change"
        elif snapshot_stop_without_material_source:
            decision = "allow_approved_plan_lock_non_material_snapshot_drift"
        elif has_source_mismatch:
            decision = "evaluate_source_bundle_lease"
        else:
            decision = "snapshot_gate_pass"
        return {
            "snapshot_gate_source": source,
            "snapshot_gate_decision": decision,
            "snapshot_gate_changed_fields": sorted(set(str(item) for item in changed_fields if item)),
            "snapshot_gate_material_change": material,
            "approved_plan_lock_consumed": bool_value(approved_plan_lock.get("ok")) and not material,
        }

    def _load_safety(self) -> dict[str, Any]:
        safety = read_json(self.safety_file, {})
        if not isinstance(safety, dict):
            safety = {}
        safety.setdefault("schema_version", 1)
        safety.setdefault("users", {})
        safety.setdefault("egress", {})
        return self._compact_safety(safety)

    def _compact_safety(self, safety: dict[str, Any]) -> dict[str, Any]:
        now = time.time()
        for ip, row in list((safety.get("users") or {}).items()):
            if not isinstance(row, dict):
                safety["users"].pop(ip, None)
                continue
            recent = [item for item in (row.get("recent_switches") or []) if now - parse_ts(item.get("ts")) <= 86400]
            row["recent_switches"] = recent[-10:]
            row["switches_1h"] = sum(1 for item in recent if now - parse_ts(item.get("ts")) <= 3600)
            row["switches_24h"] = len(recent)
            row["last_targets"] = [item.get("to") for item in recent[-3:] if item.get("to")]
            blocked = row.get("blocked_targets") if isinstance(row.get("blocked_targets"), dict) else {}
            row["blocked_targets"] = {target: until for target, until in blocked.items() if parse_ts(until) > now}
            if row.get("penalty_until") and parse_ts(row.get("penalty_until")) <= now:
                row["penalty_until"] = None
        for egress_id, row in list((safety.get("egress") or {}).items()):
            if not isinstance(row, dict):
                safety["egress"].pop(egress_id, None)
                continue
            incoming = [item for item in (row.get("incoming") or []) if now - parse_ts(item.get("ts")) <= 3600]
            failed_all = [item for item in (row.get("failed_verifications") or []) if now - parse_ts(item.get("ts")) <= 3600]
            failed = [
                item for item in failed_all
                if str(item.get("verification_scope") or "") == "selected_user_route_check"
                and str(item.get("verification_expected_egress") or "") == str(egress_id)
            ]
            row["incoming"] = incoming[-200:]
            row["failed_verifications"] = failed_all[-50:]
            row["incoming_1h"] = len(incoming)
            row["failed_verifications_1h"] = len(failed)
            row["failed_verifications_1h_unattributed"] = len(failed_all) - len(failed)
            if row.get("quarantine_until") and failed and parse_ts(row.get("quarantine_until")) > now:
                row["quarantine_reason"] = "selected_user_route_verification_failed"
            if row.get("quarantine_until") and parse_ts(row.get("quarantine_until")) <= now:
                row["quarantine_until"] = None
            elif row.get("quarantine_until") and not failed:
                row["quarantine_until"] = None
                row["quarantine_clear_reason"] = "unattributed_route_verification_not_counted"
        safety["updated"] = now_iso()
        return safety

    def _active_users(self) -> list[User]:
        return [user for user in self.users if user.enabled]

    def _quality_ok_for_load(self, egress: Egress) -> bool:
        min_avg = to_float(self.quality_policy.get("min_avg_mbps"), 15.0)
        min_floor = to_float(self.quality_policy.get("min_floor_mbps"), 10.0)
        min_stability = to_float(self.quality_policy.get("min_stability"), 0.45)
        hist = self._quality_window(egress.id, "1h")
        hist_avg = to_float(hist.get("avg_mbps"), 0.0)
        hist_min = to_float(hist.get("min_mbps"), 0.0)
        hist_stability = to_float(hist.get("stability"), 0.0)
        severity = self._severity_classification(egress)
        contextual_exception = (
            severity.get("category") == "protocol_diagnostic_limited_suspect"
            and hist_avg >= to_float(self.service_quality_policy.get("quality_exception_min_1h_avg_mbps"), min_avg)
            and hist_min >= to_float(self.service_quality_policy.get("quality_exception_min_1h_floor_mbps"), min_floor)
            and max(egress.stability, hist_stability) >= to_float(self.service_quality_policy.get("quality_exception_min_stability"), 0.15)
        )
        if egress.avg_mbps < min_avg and (not hist or hist_avg < min_avg):
            return False
        if egress.min_mbps < min_floor and (not hist or hist_min < min_floor):
            return False
        if egress.stability and egress.stability < min_stability and (not contextual_exception) and (not hist or hist_stability < min_stability):
            return False
        return True

    def _healthy_for_load(self, egress: Egress) -> bool:
        if not egress.enabled:
            return False
        if egress.state in ("maintenance", "disabled", "quarantine"):
            return False
        if egress.manual_only:
            return False
        if egress.canary_reserved:
            return False
        if egress.health_code and egress.health_code != "200":
            return False
        if self._severity_classification(egress).get("hard_block"):
            return False
        if self._telegram_candidate_state(egress.id).get("hard_blocked"):
            return False
        return self._quality_ok_for_load(egress)

    def _dynamic_load_summary(self) -> dict[str, Any]:
        active_users = len(self._active_users())
        all_healthy = [egress for egress in self.egress.values() if self._healthy_for_load(egress)]
        working_pool = [egress for egress in all_healthy if not egress.reserve_only]
        healthy_channels = len(working_pool)
        reserve_only_channels = len([egress for egress in all_healthy if egress.reserve_only])
        dead_channels = len(self.egress) - len(all_healthy)
        mode = str(self.load_policy.get("mode") or "static").lower()

        if mode == "dynamic":
            reserve_ratio = max(0.0, min(0.8, to_float(self.load_policy.get("reserve_ratio"), 0.15)))
            if healthy_channels > 1:
                reserve_channels = min(healthy_channels - 1, max(1, int(math.ceil(healthy_channels * reserve_ratio))))
            else:
                reserve_channels = 0
            working_channels = max(1, healthy_channels - reserve_channels)
            avg_load = active_users / working_channels if working_channels else float(active_users)
            soft_limit = int(math.ceil(avg_load * to_float(self.load_policy.get("soft_multiplier"), 1.15)))
            hard_limit = int(math.ceil(avg_load * to_float(self.load_policy.get("hard_multiplier"), 1.45)))
            failover_hard_limit = int(math.ceil(avg_load * to_float(self.load_policy.get("failover_hard_multiplier"), 2.0)))
            soft_limit = max(to_int(self.load_policy.get("min_soft_limit"), 5), soft_limit)
            hard_limit = max(to_int(self.load_policy.get("min_hard_limit"), 10), hard_limit, soft_limit)
            max_hard = to_int(self.load_policy.get("max_hard_limit"), 80)
            if max_hard > 0:
                hard_limit = min(max_hard, hard_limit)
                hard_limit = max(soft_limit, hard_limit)
            failover_hard_limit = max(failover_hard_limit, hard_limit)
        else:
            reserve_ratio = 0.0
            reserve_channels = 0
            working_channels = max(1, healthy_channels)
            avg_load = active_users / working_channels if working_channels else float(active_users)
            soft_limit = to_int(self.load_policy.get("soft_limit"), 15)
            hard_limit = max(soft_limit, to_int(self.load_policy.get("hard_limit"), 30))
            failover_hard_limit = max(hard_limit, to_int(self.load_policy.get("failover_hard_limit"), hard_limit * 2))

        summary = {
            "mode": "dynamic" if mode == "dynamic" else "static",
            "active_users": active_users,
            "total_channels": len(self.egress),
            "healthy_channels": healthy_channels,
            "reserve_only_channels": reserve_only_channels,
            "degraded_or_dead_channels": dead_channels,
            "reserve_ratio": round(reserve_ratio, 3),
            "reserve_channels": reserve_channels,
            "working_channels": working_channels,
            "avg_load": round(avg_load, 3),
            "soft_limit": soft_limit,
            "hard_limit": hard_limit,
            "failover_hard_limit": failover_hard_limit,
            "per_egress": {
                egress_id: self._load_limits_for_egress(egress, {
                    "soft_limit": soft_limit,
                    "hard_limit": hard_limit,
                    "failover_hard_limit": failover_hard_limit,
                })
                for egress_id, egress in sorted(self.egress.items())
            },
        }
        summary["status"] = self._capacity_status(summary)
        return summary

    def _capacity_status(self, summary: dict[str, Any]) -> str:
        per_egress = summary.get("per_egress") if isinstance(summary.get("per_egress"), dict) else {}
        statuses = {str(row.get("status") or "UNKNOWN") for row in per_egress.values() if isinstance(row, dict)}
        if "FAILOVER_FULL" in statuses:
            return "overloaded"
        if "HARD_FULL" in statuses:
            return "full"
        if "SOFT_FULL" in statuses:
            return "high"
        if to_int(summary.get("healthy_channels"), 0) <= 1 and to_int(summary.get("active_users"), 0) > 0:
            return "warm"
        return "ok"

    def _persist_dynamic_load_summary(self) -> None:
        if not self.args.load_summary_file:
            return
        payload = {
            "schema_version": 1,
            "updated": now_iso(),
            "source": "v7-users-autoswitch",
            "authority": "capacity_signal",
            "operator_status": self.dynamic_load.get("status", "unknown"),
            "semantics": {
                "ok": "capacity within soft limits",
                "warm": "limited healthy pool, monitor before broad movement",
                "high": "one or more egress reached soft limit",
                "full": "one or more egress reached hard limit",
                "overloaded": "one or more egress reached failover hard limit",
            },
            "summary": self.dynamic_load,
        }
        try:
            write_json_atomic(Path(self.args.load_summary_file), payload)
        except OSError:
            return

    def _load_limits_for_egress(self, egress: Egress, base: Optional[dict[str, Any]] = None) -> dict[str, Any]:
        base = base or self.dynamic_load
        base_soft = to_int(base.get("soft_limit"), 15)
        base_hard = to_int(base.get("hard_limit"), 30)
        base_failover = to_int(base.get("failover_hard_limit"), max(base_hard, 60))
        soft_limit = base_soft
        hard_limit = base_hard
        failover_hard_limit = base_failover
        if egress.capacity_users > 0:
            soft_limit = min(soft_limit, egress.capacity_users)
            hard_limit = min(hard_limit, egress.capacity_users)
            multiplier = to_float(self.load_policy.get("failover_capacity_multiplier"), 1.25)
            failover_hard_limit = min(failover_hard_limit, max(hard_limit, int(math.ceil(egress.capacity_users * multiplier))))
        hard_limit = max(1, hard_limit)
        soft_limit = max(1, min(soft_limit, hard_limit))
        failover_hard_limit = max(hard_limit, failover_hard_limit)
        status = "OK"
        if egress.users >= failover_hard_limit:
            status = "FAILOVER_FULL"
        elif egress.users >= hard_limit:
            status = "HARD_FULL"
        elif egress.users >= soft_limit:
            status = "SOFT_FULL"
        return {
            "users": egress.users,
            "soft_limit": soft_limit,
            "hard_limit": hard_limit,
            "failover_hard_limit": failover_hard_limit,
            "capacity_users": egress.capacity_users,
            "status": status,
        }

    def _load_users(self) -> list[User]:
        state_users = self.state.get("users")
        registry_rows = parse_registry(self.state_dir / "users.registry")
        registry_by_ip = {str(row.get("ip", "")): row for row in registry_rows if row.get("ip")}
        if isinstance(state_users, list):
            state_ips = {str(row.get("ip", "")) for row in state_users if isinstance(row, dict)}
            rows = list(state_users) + [
                row for row in registry_rows
                if str(row.get("ip", "")) and str(row.get("ip", "")) not in state_ips
            ]
        else:
            rows = registry_rows
        org_users = self._org_user_map()
        users: list[User] = []
        for row in rows:
            ip = str(row.get("ip", ""))
            if not SAFE_IP_RE.match(ip):
                continue
            registry_row = registry_by_ip.get(ip, {})
            raw = {**registry_row, **row}
            group = str(raw.get("group") or raw.get("org") or raw.get("organization") or org_users.get(ip) or self.org_policy.get("default_group") or "default")
            users.append(User(
                ip=ip,
                current=str(raw.get("current", "")),
                table=str(raw.get("table", "")),
                enabled=str(raw.get("enabled", "1")) == "1",
                group=group,
                raw=raw,
            ))
        return users

    def _load_runtime_registry_users(self) -> list[User]:
        """Read exact mutable user assignment truth without snapshot overlay."""
        org_users = self._org_user_map()
        users: list[User] = []
        for row in parse_registry(self.state_dir / "users.registry"):
            ip = str(row.get("ip", ""))
            if not SAFE_IP_RE.match(ip):
                continue
            group = str(
                row.get("group")
                or row.get("org")
                or row.get("organization")
                or org_users.get(ip)
                or self.org_policy.get("default_group")
                or "default"
            )
            users.append(User(
                ip=ip,
                current=str(row.get("current", "")),
                table=str(row.get("table", "")),
                enabled=str(row.get("enabled", "1")) == "1",
                group=group,
                raw=dict(row),
            ))
        return users

    def _load_operational_egress_states(self) -> dict[str, str]:
        """Read dynamic egress state from the existing lifecycle owner."""
        states: dict[str, str] = {}
        path = self.state_dir / "egress-flags.state"
        try:
            lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
        except FileNotFoundError:
            return states
        for line in lines:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            if not key.endswith("_state"):
                continue
            egress_id = key[:-len("_state")].strip()
            state = value.strip().lower()
            if egress_id and state in {"enabled", "maintenance", "disabled", "down"}:
                states[egress_id] = state
        return states

    def _org_user_map(self) -> dict[str, str]:
        mapping: dict[str, str] = {}
        explicit = self.org_policy.get("user_groups") or {}
        if isinstance(explicit, dict):
            mapping.update({str(ip): str(group) for ip, group in explicit.items()})
        for group_name, group in (self.org_policy.get("groups") or {}).items():
            for ip in split_csv((group or {}).get("users", [])):
                mapping[ip] = str(group_name)
        return mapping

    def _load_egress(self) -> dict[str, Egress]:
        registry_rows = parse_registry(self.state_dir / "egress.registry")
        operational_states = self._load_operational_egress_states()
        state_egress = self.state.get("egress") if isinstance(self.state.get("egress"), dict) else {}
        ids = sorted({str(row.get("id", "")) for row in registry_rows if row.get("id")} | set(state_egress.keys()))
        meta_all = self.org_policy.get("egress") or {}
        result: dict[str, Egress] = {}
        for egress_id in ids:
            reg = next((row for row in registry_rows if row.get("id") == egress_id), {})
            live = state_egress.get(egress_id) or {}
            meta = meta_all.get(egress_id) or {}
            speed_item = (self.speed.get("items") or {}).get(egress_id) or {}
            avg_mbps = to_float(live.get("avg_mbps"), to_float(speed_item.get("server_v7_mbps")))
            min_mbps = to_float(live.get("min_mbps"), to_float(speed_item.get("server_v7_min_mbps"), avg_mbps))
            roles = split_csv(meta.get("roles") or meta.get("role") or reg.get("roles") or reg.get("role") or "GLOBAL_FAST")
            capacity = to_int(meta.get("capacity_users") or reg.get("capacity_users") or reg.get("capacity") or 0)
            result[egress_id] = Egress(
                id=egress_id,
                interface=str(meta.get("interface") or reg.get("interface") or live.get("interface") or ""),
                enabled=str(reg.get("enabled", meta.get("enabled", "1"))) == "1" and not bool_value(meta.get("disabled")),
                state=str(operational_states.get(egress_id) or meta.get("state") or reg.get("state") or "enabled"),
                role=roles[0] if roles else "GLOBAL_FAST",
                roles=roles or ["GLOBAL_FAST"],
                priority=to_int(meta.get("priority") or reg.get("priority") or 50, 50),
                weight=to_float(meta.get("weight") or reg.get("weight") or 100.0, 100.0),
                capacity_users=capacity,
                reserve_only=bool_value(meta.get("reserve_only") or reg.get("reserve_only")),
                manual_only=bool_value(meta.get("manual_only") or reg.get("manual_only")),
                canary_reserved=bool_value(meta.get("canary_reserved") or reg.get("canary_reserved")),
                exclusive_group=str(meta.get("exclusive_group") or reg.get("exclusive_group") or ""),
                groups=split_csv(meta.get("groups") or reg.get("groups") or ""),
                users=to_int(live.get("users")),
                avg_mbps=avg_mbps,
                min_mbps=min_mbps,
                client_mbps=self._client_mbps_for_egress(egress_id),
                stability=to_float(live.get("stability"), to_float(speed_item.get("stability"))),
                health_code=str(live.get("code") or speed_item.get("code") or ""),
                severity=str(live.get("diagnose_severity") or speed_item.get("severity") or ""),
                diagnose_reason=str(live.get("diagnose_reason") or ""),
                load_status=str(live.get("load_status") or ""),
                raw={"registry": reg, "state": live, "meta": meta, "speed": speed_item},
            )
        return result

    def _sync_egress_user_counts(self) -> None:
        counts: dict[str, int] = {egress_id: 0 for egress_id in self.egress}
        for user in self.users:
            if user.enabled and user.current:
                counts[user.current] = counts.get(user.current, 0) + 1
        for egress_id, egress in self.egress.items():
            egress.users = counts.get(egress_id, 0)

    def _load_reconnect_state(self) -> dict[str, Any]:
        state = read_json(self.reconnect_state_file, {})
        if not isinstance(state, dict):
