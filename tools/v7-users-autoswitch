def controlled_campaign_execution_target_admission(
    args: argparse.Namespace,
) -> dict[str, Any]:
    """Validate one exact controlled-only target without changing Planner law."""
    request_id = str(
        getattr(args, "controlled_certification_campaign_request_id", "") or ""
    )
    request_hash = str(
        getattr(args, "controlled_certification_campaign_request_hash", "") or ""
    )
    target = str(
        getattr(args, "controlled_certification_campaign_target", "") or ""
    )
    if not request_id and not request_hash and not target:
        return {"ok": False, "active": False, "blockers": ["not_requested"]}
    blockers: list[str] = []
    status = operator_execution.controlled_certification_substrate_authority_status(
        operator_execution.read_live_execution_lineage_records(
            Path(args.action_class_audit_store)
        )
    )
    request = (
        status.get("request")
        if isinstance(status.get("request"), dict)
        else {}
    )
    scope = (
        request.get("scope")
        if isinstance(request.get("scope"), dict)
        else {}
    )
    target_contract = (
        request.get("controlled_target_contract")
        if isinstance(request.get("controlled_target_contract"), dict)
        else {}
    )
    if status.get("status") != "APPROVED":
        blockers.append("controlled_campaign_authority_not_approved")
    if str(status.get("request_id") or "") != request_id:
        blockers.append("controlled_campaign_request_id_mismatch")
    if str(status.get("request_hash") or "") != request_hash:
        blockers.append("controlled_campaign_request_hash_mismatch")
    if str(scope.get("controlled_target_id") or "") != target:
        blockers.append("controlled_campaign_target_mismatch")
    if (
        scope.get("controlled_target_admission_class")
        != "EXECUTION_ONLY_CONTROLLED_CERTIFICATION_TARGET"
    ):
        blockers.append("controlled_campaign_target_class_not_admitted")
    if str(target_contract.get("target_id") or "") != target:
        blockers.append("controlled_campaign_target_contract_mismatch")
    if target_contract.get("ordinary_production_assignment_allowed") is not False:
        blockers.append("controlled_campaign_ordinary_target_eligibility_forbidden")
    if target_contract.get("certification_only_assignment_allowed") is not True:
        blockers.append("controlled_campaign_certification_target_not_admitted")
    if str(getattr(args, "target_egress", "") or "") != target:
        blockers.append("controlled_campaign_planner_target_not_exact")
    if str(getattr(args, "source_egress", "") or "") != str(
        scope.get("source_id") or ""
    ):
        blockers.append("controlled_campaign_planner_source_not_exact")
    if not bool_value(getattr(args, "emergency_failover_autonomy", False)):
        blockers.append("controlled_campaign_emergency_path_required")
    egress_rows = [
        row for row in parse_registry(Path(args.state_dir) / "egress.registry")
        if str(row.get("id") or "") == target
    ]
    users_on_target = [
        row for row in parse_registry(Path(args.state_dir) / "users.registry")
        if str(row.get("current") or "") == target
        and bool_value(row.get("enabled", "1"))
    ]
    target_row = egress_rows[0] if len(egress_rows) == 1 else {}
    if len(egress_rows) != 1:
        blockers.append("controlled_campaign_target_not_unique")
    if users_on_target:
        blockers.append("controlled_campaign_target_not_empty_at_fresh_gate")
    if (
        str(target_row.get("role") or "").upper() != "EXECUTION_ONLY"
        or not bool_value(target_row.get("execution_reserved"))
        or not bool_value(target_row.get("canary_reserved"))
        or str(target_row.get("reservation_owner") or "")
        != "operator_execution_governance"
        or bool_value(target_row.get("autoswitch_allowed"))
        or bool_value(target_row.get("rebalance_allowed"))
        or str(target_row.get("production_assignment_allowed") or "").lower()
        not in {"0", "false", "no"}
    ):
        blockers.append("controlled_campaign_target_live_contract_changed")
    return {
        "ok": not blockers,
        "active": True,
        "blockers": sorted(set(blockers)),
        "request_id": request_id,
        "request_hash": request_hash,
        "source_id": str(scope.get("source_id") or ""),
        "target_id": target,
        "ordinary_production_eligible": False,
        "controlled_certification_only": True,
    }


class AutoswitchPlanner:
    def __init__(self, args: argparse.Namespace):
        self._performance_runtime_started_ns = time.monotonic_ns()
        self._performance_runtime_usage_before = resource.getrusage(
            resource.RUSAGE_SELF
        )
        self._performance_runtime_load_before = self._load_average_snapshot()
        self._performance_runtime_process_count_before = self._process_count_snapshot()
        self._prepared_decision_diagnostic: dict[str, Any] = {}
        constructor_started_ns = time.monotonic_ns()
        self.args = args
        self._performance_spans: list[dict[str, Any]] = []
        self.controlled_campaign_target_admission = (
            controlled_campaign_execution_target_admission(args)
        )
        self.operation_started_at = now_iso()
        self.state_dir = Path(args.state_dir)
        lock_started_ns = time.monotonic_ns()
        # Snapshot refresh derives a separate atomic snapshot and never writes
        # service-matrix.json.  Its existing source-hash/retry contract is the
        # concurrency guard for those reads.  Holding the Matrix *writer* lock
        # across snapshot construction and later planning used to delay the
        # fast failure writer for tens of seconds, even though this planner
        # was not a Matrix writer.  Matrix writers keep their own lock.
        self.service_matrix_lock_fd = None
        self.service_matrix_lock = {
            "schema": "v7.service-matrix-lifecycle-lock.v1",
            "enabled": False,
            "acquired": False,
            "path": str(self.state_dir / "service-matrix.lock"),
            "scope": "not_required_for_snapshot_only_planner",
            "owner": "tools/v7-users-autoswitch",
            "decision": "snapshot_source_consistency_owner_handles_concurrent_matrix_writes",
            "runtime_behavior_changed": False,
            "governance_behavior_changed": False,
            "execution_behavior_changed": False,
            "users_moved": False,
        }
        self._record_performance_span(
            "matrix_writer_lock_scope_classification",
            lock_started_ns,
            owner="tools/v7-users-autoswitch + v7-intelligence-snapshot-refresh",
            status="PASS",
            details={
                "matrix_writer_lock_held": False,
                "freshness_guard": "existing source-hash/retry snapshot contract",
            },
        )
        owner_reads_started_ns = time.monotonic_ns()
        self.event_dir = Path(args.event_dir)
        self.l3_runtime_state_file = self.state_dir / "l3-runtime-state.json"
        self.l3_capability_state_file = self.state_dir / "l3-capability-state.json"
        self.l3_runtime_state = self._load_l3_runtime_state()
        self._l3_runtime_state_file_identity = (
            self._runtime_file_identity(self.l3_runtime_state_file)
        )
        self.state = read_json(self.state_dir / "v7-state.json", {})
        self.policy = read_json(Path(args.policy_file), {})
        self.org_policy = read_json(Path(args.org_policy_file), {})
        standing_reuse = getattr(
            args, "_standing_policy_lineage_reuse", {},
        )
        standing_reuse = (
            standing_reuse if isinstance(standing_reuse, dict) else {}
        )
        current_standing_contract = (
            (self.policy or {}).get("delegated_autonomy_policy")
            if isinstance(
                (self.policy or {}).get("delegated_autonomy_policy"), dict,
            )
            else {}
        )
        reused_records = standing_reuse.get("records")
        reused_contract = standing_reuse.get("contract")
        current_standing_contract_hash = sha256_json(
            current_standing_contract
        )
        # The Matrix hands this exact compact policy object and its lineage to
        # the in-process governed Planner.  Require an exact current-policy
        # match before reuse; all older callers retain the former hash-only
        # compatibility condition.  A mismatch never trusts the handoff and
        # continues with the existing fresh append-only owner read.
        matrix_contract_reuse_matches = (
            isinstance(reused_contract, dict)
            and str(standing_reuse.get("contract_hash") or "")
            == sha256_json(reused_contract)
            and sha256_json(reused_contract)
            == current_standing_contract_hash
        )
        legacy_contract_reuse_matches = (
            str(standing_reuse.get("contract_hash") or "")
            == current_standing_contract_hash
        )
        self._standing_policy_lineage_reuse_diagnostic = {
            "handoff_present": bool(standing_reuse),
            "records_present": isinstance(reused_records, list),
            "compact_contract_present": isinstance(reused_contract, dict),
            "matrix_contract_reuse_matches": matrix_contract_reuse_matches,
            "legacy_contract_reuse_matches": legacy_contract_reuse_matches,
            "handoff_contract_hash": str(
                standing_reuse.get("contract_hash") or ""
            ),
            "current_contract_hash": current_standing_contract_hash,
        }
        self._standing_policy_audit_records_cache: Optional[
            list[dict[str, Any]]
        ] = (
            # Matrix has just read this append-only lineage in the same
            # governed process and no consumer mutates those record bodies.
            # A deep copy of the complete rotated history was therefore pure
            # post-T0 reconstruction cost (and, at scale, the dominant one).
            # Reuse the append-only owner result directly: neither consumer
            # mutates it, and policy/hash mismatch still falls back to a
            # fresh owner read below.
            reused_records
            if isinstance(reused_records, list)
            and (
                matrix_contract_reuse_matches
                or legacy_contract_reuse_matches
            )
            else None
        )
        self.quality_summary = read_json(Path(args.quality_summary_file), {"items": {}})
        self.safety_file = Path(args.safety_file)
        self.safety_state = self._load_safety()
        self.speed = read_json(self.state_dir / "egress-speed.json", {"items": {}})
        self.client_speed = read_json(self.state_dir / "client-speed.json", {"users": {}})
        self.matrix = read_json(self.state_dir / "service-matrix.json", {"items": {}})
        self.telegram_sentinel = read_json(Path(args.telegram_sentinel_file), {"items": {}})
        self.vless_activity = read_json(Path(args.vless_activity_file), {})
        self.restore_barrier_file = Path(args.restore_barrier_file)
        self.restore_barrier = self._restore_barrier_status()
        self.generation = self._generation_status()
        self.service_prefs = read_json(self.state_dir / "service-preferences.json", {})
        self._record_performance_span(
            "live_owner_discovery_and_projection_reads",
            owner_reads_started_ns,
            owner="existing state/policy/Matrix/restore-barrier owners",
        )
        self.intelligence_snapshot_root = Path(args.intelligence_snapshot_root)
        refresh_started_ns = time.monotonic_ns()
        self.pre_planner_refresh = self._run_pre_planner_refresh()
        self._reload_intelligence_sources_after_pre_planner_refresh()
        self._retry_pre_planner_refresh_after_source_reload()
        self.intelligence_snapshots = self._load_intelligence_snapshots()
        self._record_performance_span(
            "pre_planner_refresh_and_snapshot_reads",
            refresh_started_ns,
            owner="existing v7-intelligence-snapshot-refresh + snapshot owners",
            status="STOP_SAFE" if self.pre_planner_refresh.get("stop_required") else "PASS",
        )
        self._snapshot_items_cache: dict[str, list[dict[str, Any]]] = {}
        registry_started_ns = time.monotonic_ns()
        exact_incident_identity_scope = bool(
            str(getattr(args, "user", "") or "").strip()
            and str(getattr(args, "source_egress", "") or "").strip()
            and to_int(getattr(args, "max_selected_moves", 0), 0) == 1
            and (
                bool_value(
                    getattr(args, "emergency_failover_autonomy", False)
                )
                or bool_value(
                    getattr(args, "controlled_engineering_setup", False)
                )
                or bool_value(
                    getattr(args, "controlled_engineering_cleanup", False)
                )
            )
        )
        # The exact one-user failure transaction is entered after Matrix has
        # already bound a current source and identity.  ``v7-state.json`` is a
        # diagnostic projection and may legitimately lag a preceding Polygon
        # or production assignment; overlaying it on ``users.registry`` can
        # therefore erase the exact current Candidate before Packet creation.
        # Reuse the canonical mutable registry directly for this already
        # bounded incident scope, matching the existing pre-apply verifier.
        # Broad planning retains its historical snapshot-overlay semantics.
        self.users = (
            self._load_runtime_registry_users()
            if exact_incident_identity_scope
            else self._load_users()
        )
        self.egress = self._load_egress()
        self._sync_egress_user_counts()
        self._record_performance_span(
            "registry_and_live_inventory_reads",
            registry_started_ns,
            owner="users.registry + egress.registry",
            details={
                "exact_incident_identity_scope": (
                    exact_incident_identity_scope
                ),
                "user_assignment_owner": (
                    "users.registry"
                    if exact_incident_identity_scope
                    else "v7-state projection with registry completion"
                ),
            },
        )
        policy_resolution_started_ns = time.monotonic_ns()
        # This records the *current* post-T0 construction work one owner at a
        # time.  It is diagnostic only: the same policy and inventory
        # functions still run in the same order and their values remain the
        # sole inputs to Candidate/Packet/Lease/Barrier/Apply.  The split is
        # required to distinguish mandatory mutable gates from removable
        # reconstruction overhead in the one-user prepared-decision lane.
        def resolve_initialization_stage(label: str, resolver: Any) -> Any:
            started_ns = time.monotonic_ns()
            value = resolver()
            self._record_performance_span(
                label,
                started_ns,
                owner="tools/v7-users-autoswitch.AutoswitchPlanner",
            )
            return value

        self.switch_policy = resolve_initialization_stage(
            "policy_switch_resolution", self._switch_policy,
        )
        self.authority_budget_policy = resolve_initialization_stage(
            "policy_authority_budget_and_lineage_validation",
            self._authority_budget_policy,
        )
        self.quality_policy = resolve_initialization_stage(
            "policy_quality_resolution", self._quality_policy,
        )
        self.load_policy = resolve_initialization_stage(
            "policy_load_resolution", self._load_policy,
        )
        self.reconnect_policy = resolve_initialization_stage(
            "policy_reconnect_resolution", self._reconnect_policy,
        )
        self.safety_policy = resolve_initialization_stage(
            "policy_safety_resolution", self._safety_policy,
        )
        self.service_signal_policy = resolve_initialization_stage(
            "policy_service_signal_resolution", self._service_signal_policy,
        )
        self.emergency_failover_policy = resolve_initialization_stage(
            "policy_emergency_failover_and_lineage_validation",
            self._emergency_failover_policy,
        )
        self.service_quality_policy = resolve_initialization_stage(
            "policy_service_quality_resolution", self._service_quality_policy,
        )
        self.best_available_pool_policy = resolve_initialization_stage(
            "policy_best_available_pool_resolution",
            self._best_available_pool_policy,
        )
        self.last_switch = resolve_initialization_stage(
            "switch_history_resolution", self._last_switches,
        )
        self.group_usage = resolve_initialization_stage(
            "group_usage_resolution", self._group_usage,
        )
        self.dynamic_load = resolve_initialization_stage(
            "dynamic_load_reconstruction", self._dynamic_load_summary,
        )
        self.reconnect_state_file = Path(args.reconnect_state_file)
        self.reconnect_state = resolve_initialization_stage(
            "reconnect_state_read", self._load_reconnect_state,
        )
        self.reconnect_events = resolve_initialization_stage(
            "reconnect_event_reconstruction", self._observe_reconnect_events,
        )
        self._routing_intelligence_cache: dict[tuple[Any, ...], dict[str, Any]] = {}
        self._active_execution_control: dict[str, Any] = {}
        self._record_performance_span(
            "policy_capacity_quality_resolution",
            policy_resolution_started_ns,
            owner="tools/v7-users-autoswitch existing policy owners",
        )
        self._record_performance_span(
            "planner_initialization_total",
            constructor_started_ns,
            owner="tools/v7-users-autoswitch.AutoswitchPlanner",
        )

    def _record_performance_span(
        self,
        stage: str,
        started_ns: int,
        *,
        owner: str,
        status: str = "PASS",
        parent: str = "governed_transaction",
        critical_path: bool = True,
        details: Optional[dict[str, Any]] = None,
    ) -> dict[str, Any]:
        completed_ns = time.monotonic_ns()
        row = {
            "stage": stage,
            "parent": parent,
            "owner": owner,
            "clock_source": "time.monotonic_ns",
            "started_monotonic_ns": int(started_ns),
            "completed_monotonic_ns": int(completed_ns),
            "duration_ms": round(max(0, completed_ns - started_ns) / 1_000_000.0, 3),
            "status": status,
            "critical_path": bool(critical_path),
        }
        if details:
            row["details"] = details
        self._performance_spans.append(row)
        return row

    @staticmethod
    def _load_average_snapshot() -> Optional[list[float]]:
        try:
            return [round(float(value), 3) for value in os.getloadavg()]
        except (AttributeError, OSError, ValueError):
            return None

    @staticmethod
    def _process_count_snapshot() -> Optional[int]:
        # Linux production exposes /proc; a missing procfs is explicitly
        # unknown rather than silently substituted with a host-wide guess.
        try:
            return sum(1 for name in os.listdir("/proc") if str(name).isdigit())
        except (OSError, ValueError):
            return None

    def _standing_policy_audit_records(self) -> list[dict[str, Any]]:
        """Read the active standing decision and its newer lineage once.

        Several policy resolvers validate the same immutable standing
        contract.  Re-reading and deep-copying every rotated audit segment in
        each resolver adds latency but no independent evidence.  The exact
        decision id is the bounded stop condition; append/rotation freshness
        remains owned by the underlying lineage reader for each process.
        """
        if self._standing_policy_audit_records_cache is None:
            contract = (
                (self.policy or {}).get("delegated_autonomy_policy")
                if isinstance(
                    (self.policy or {}).get("delegated_autonomy_policy"),
                    dict,
                )
                else {}
            )
            decision = (
                contract.get("authority_decision")
                if isinstance(contract.get("authority_decision"), dict)
                else {}
            )
            self._standing_policy_audit_records_cache = (
                operator_execution.read_live_execution_lineage_records(
                    Path(getattr(
                        self.args,
                        "action_class_audit_store",
                        str(
                            operator_execution
                            .DEFAULT_PRODUCTION_OPERATOR_EXECUTION_AUDIT_STORE
                        ),
                    )),
                    required_decision_ids=tuple(filter(None, [
                        str(decision.get("decision_id") or "")
                    ])),
                )
            )
        return self._standing_policy_audit_records_cache

    def revalidate_committed_apply_plan(
        self,
        apply_args: argparse.Namespace,
        *,
        committed_plan: Optional[dict[str, Any]] = None,
    ) -> dict[str, Any]:
        """Revalidate one Packet-locked move without selecting it again.

        The governed caller has already used this exact owner to select the
        Candidate, then materialized the immutable Packet, lease and restore
        barrier. Rebuilding or rescoring the Candidate after that point is both
        redundant and semantically wrong: the executor is explicitly forbidden
        to reselect users or targets. Reuse the immutable committed plan while
        reloading every mutable execution owner and independently validating
        the approved lock, registry assignment, Matrix, target, snapshots,
        policy lineage and control gates. A missing committed plan or any
        changed identity fails closed instead of falling back to broad
        planning.
        """
        started_ns = time.monotonic_ns()
        current_policy = read_json(Path(apply_args.policy_file), {})
        current_org_policy = read_json(Path(apply_args.org_policy_file), {})
        if sha256_json(current_policy) != sha256_json(self.policy):
            raise RuntimeError("committed_apply_policy_generation_changed")
        if sha256_json(current_org_policy) != sha256_json(self.org_policy):
            raise RuntimeError("committed_apply_org_policy_generation_changed")

        self.args = apply_args
        self.operation_started_at = now_iso()
        self.event_dir = Path(apply_args.event_dir)
        self.state_dir = Path(apply_args.state_dir)
        self.intelligence_snapshot_root = Path(
            apply_args.intelligence_snapshot_root
        )
        self.restore_barrier_file = Path(apply_args.restore_barrier_file)
        self.safety_file = Path(apply_args.safety_file)
        self.l3_runtime_state_file = self.state_dir / "l3-runtime-state.json"
        self.l3_capability_state_file = (
            self.state_dir / "l3-capability-state.json"
        )

        exact_packet_locked_incident = bool(
            bool_value(
                getattr(
                    apply_args, "ct_m0f_kernel_cutover_validation", False,
                )
            )
            and bool_value(getattr(apply_args, "apply", False))
            and str(getattr(apply_args, "approved_packet_id", "") or "")
            and str(
                getattr(apply_args, "approved_execution_lease_id", "") or ""
            )
            and str(
                getattr(apply_args, "approved_selected_move_hash", "") or ""
            )
            and str(getattr(apply_args, "user", "") or "")
            and str(getattr(apply_args, "source_egress", "") or "")
            and str(getattr(apply_args, "target_egress", "") or "")
            and to_int(
                getattr(apply_args, "max_selected_moves", 0), 0,
            ) == 1
        )

        current_l3_identity = self._runtime_file_identity(
            self.l3_runtime_state_file
        )
        l3_runtime_state_reused = bool(
            current_l3_identity
            == getattr(self, "_l3_runtime_state_file_identity", ())
            and isinstance(getattr(self, "l3_runtime_state", None), dict)
        )
        if not l3_runtime_state_reused:
            self.l3_runtime_state = self._load_l3_runtime_state()
        self._l3_runtime_state_file_identity = current_l3_identity
        if not exact_packet_locked_incident:
            self.state = read_json(self.state_dir / "v7-state.json", {})
        self.quality_summary = read_json(
            Path(apply_args.quality_summary_file), {"items": {}}
        )
        self.speed = read_json(
            self.state_dir / "egress-speed.json", {"items": {}}
        )
        self.client_speed = read_json(
            self.state_dir / "client-speed.json", {"users": {}}
        )
        self.matrix = read_json(
            self.state_dir / "service-matrix.json", {"items": {}}
        )
        if not exact_packet_locked_incident:
            self.telegram_sentinel = read_json(
                Path(apply_args.telegram_sentinel_file), {"items": {}}
            )
            self.vless_activity = read_json(
                Path(apply_args.vless_activity_file), {}
            )
        self.service_prefs = read_json(
            self.state_dir / "service-preferences.json", {}
        )
        self.safety_state = self._load_safety()
        self.restore_barrier = self._restore_barrier_status()
        self.generation = self._generation_status()
        if not exact_packet_locked_incident:
            self.pre_planner_refresh = self._run_pre_planner_refresh()
            if self.pre_planner_refresh.get("stop_required"):
                raise RuntimeError(
                    "committed_apply_snapshot_refresh_stop_safe"
                )
        self.intelligence_snapshots = self._load_intelligence_snapshots()
        self._snapshot_items_cache = {}

        # Exact incident execution is already identity-bound by Matrix and
        # Packet.  The mutable registry is the assignment owner; the broad
        # diagnostic v7-state projection must not overwrite it.
        self.users = self._load_runtime_registry_users()
        self.egress = self._load_egress()
        self._sync_egress_user_counts()
        if not exact_packet_locked_incident:
            self.last_switch = self._last_switches()
            self.group_usage = self._group_usage()
            self.dynamic_load = self._dynamic_load_summary()
            self.reconnect_state_file = Path(apply_args.reconnect_state_file)
            self.reconnect_state = self._load_reconnect_state()
            self.reconnect_events = self._observe_reconnect_events()
        self._routing_intelligence_cache = {}
        self._active_execution_control = {}
        self._n10_execution_control_window = {}
        self.controlled_campaign_target_admission = (
            controlled_campaign_execution_target_admission(apply_args)
        )

        # A Matrix-bound exact Packet cannot change its standing contract.
        # Its immutable Authority decision was already validated by Matrix
        # and the Planner constructor in this same process. Re-reading the
        # rotated append-only audit after Packet creation adds no revocation
        # signal (revocation changes the policy contract) and delays apply.
        # Broader/non-packet paths retain the fresh lineage read.
        if not exact_packet_locked_incident:
            self._standing_policy_audit_records_cache = None
        self.switch_policy = self._switch_policy()
        self.authority_budget_policy = self._authority_budget_policy()
        self.emergency_failover_policy = self._emergency_failover_policy()
        self._record_performance_span(
            "committed_apply_mutable_owner_revalidation",
            started_ns,
            owner=(
                "existing Matrix/registry/policy/snapshot/Packet-barrier "
                "owners"
            ),
            details={
                "new_planner_instance_created": False,
                "candidate_reused": True,
                "candidate_reselected": False,
                "mutable_execution_inputs_reloaded": True,
                "unchanged_l3_runtime_state_reused": (
                    l3_runtime_state_reused
                ),
                "l3_runtime_state_source_identity_checked": True,
                "policy_generation_equal": True,
                "exact_packet_locked_incident": (
                    exact_packet_locked_incident
                ),
                "post_packet_candidate_ranking_recomputed": False,
                "non_execution_diagnostic_sources_reloaded": (
                    not exact_packet_locked_incident
                ),
            },
        )
        if not isinstance(committed_plan, dict) or not committed_plan:
            raise RuntimeError("committed_apply_plan_missing")

        plan = copy.deepcopy(committed_plan)
        plan["apply_requested"] = True
        plan["target_egress"] = str(apply_args.target_egress or "")
        plan["source_egress"] = str(
            getattr(apply_args, "source_egress", "") or ""
        )
        safety = (
            plan.get("safety")
            if isinstance(plan.get("safety"), dict)
            else {}
        )
        restore_barrier = dict(self.restore_barrier)
        approved_plan_lock = self._approved_plan_lock_validation(
            restore_barrier
        )
        restore_barrier["approved_plan_lock_validation"] = (
            approved_plan_lock
        )
        if approved_plan_lock.get("ok") and (
            approved_plan_lock.get("selected_move_hash_source")
            == "approved_preview_packet"
        ):
            restore_barrier["approved_preview_identity_consumed"] = True

        selected_count = int(
            approved_plan_lock.get("selected_move_count") or 0
        )
        if (
            approved_plan_lock.get("ok")
            and bool_value(restore_barrier.get("expired"))
            and bool_value(restore_barrier.get("cleared"))
            and restore_barrier.get("clearance_max_selected_moves")
            is not None
        ):
            locked_moves = [
                copy.deepcopy(move)
                for move in (
                    approved_plan_lock.get("selected_moves") or []
                )
                if isinstance(move, dict)
            ]
            locked_hash = str(
                approved_plan_lock.get("selected_move_hash") or ""
            )
            restore_barrier.update(
                self._restore_clearance_generation_check(
                    restore_barrier,
                    locked_moves,
                    locked_hash,
                )
            )
        snapshot_gate = self._intelligence_snapshot_gate(selected_count)
        snapshot_gate = self._apply_source_bundle_lease_to_intelligence_gate(
            snapshot_gate,
            restore_barrier,
            approved_plan_lock,
        )
        if bool_value(snapshot_gate.get("stop_required")):
            restore_barrier[
                "approved_plan_lock_selected_moves_blocked"
            ] = True
            restore_barrier["approved_plan_lock_blocker"] = (
                "approved_plan_lock_snapshot_gate_stop_required"
            )

        safety["restore_barrier"] = restore_barrier
        safety["intelligence_snapshots"] = snapshot_gate
        diagnostics = (
            safety.get("selected_moves_diagnostics")
            if isinstance(
                safety.get("selected_moves_diagnostics"), dict
            )
            else {}
        )
        diagnostics.update({
            "source": "approved_preview_packet_lock",
            "approved_plan_lock_present": bool_value(
                approved_plan_lock.get("present")
            ),
            "approved_plan_lock_ok": bool_value(
                approved_plan_lock.get("ok")
            ),
            "approved_plan_lock_hash_source": str(
                approved_plan_lock.get("selected_move_hash_source") or ""
            ),
            "planner_recomputed_after_approval": False,
            "candidate_reselected_after_approval": False,
        })
        safety["selected_moves_diagnostics"] = diagnostics
        plan["safety"] = safety

        # Never leave the pre-Packet rows executable. The existing approved
        # lock consumer below rehydrates only the exact immutable Packet rows
        # after all current identity checks have passed.
        plan["selected_moves"] = []
        summary = (
            plan.get("summary")
            if isinstance(plan.get("summary"), dict)
            else {}
        )
        summary["selected_moves"] = 0
        summary["selected_move_count"] = 0
        plan["summary"] = summary
        committed_moves = (
            self._committed_selected_moves_from_approved_plan_lock(plan)
            if approved_plan_lock.get("ok")
            and not bool_value(snapshot_gate.get("stop_required"))
            else []
        )
        if committed_moves:
            plan["selected_moves"] = committed_moves
            summary["selected_moves"] = len(committed_moves)
            summary["selected_move_count"] = len(committed_moves)
        return plan

    def performance_timeline(self) -> dict[str, Any]:
        usage_after = resource.getrusage(resource.RUSAGE_SELF)
        load_after = self._load_average_snapshot()
        process_count_after = self._process_count_snapshot()
        started_ns = int(getattr(self, "_performance_runtime_started_ns", 0) or 0)
        wall_ms = (
            round(max(0, time.monotonic_ns() - started_ns) / 1_000_000.0, 3)
            if started_ns else None
        )
        usage_before = getattr(self, "_performance_runtime_usage_before", None)
        cpu_ms = None
        rss_kb = None
        if usage_before is not None:
            cpu_ms = round(
                max(
                    0.0,
                    (float(usage_after.ru_utime) + float(usage_after.ru_stime))
                    - (float(usage_before.ru_utime) + float(usage_before.ru_stime)),
                )
                * 1000.0,
                3,
            )
        try:
            rss_kb = int(getattr(usage_after, "ru_maxrss", 0) or 0)
        except (TypeError, ValueError):
            rss_kb = None
        return {
            "schema_version": "v7.governed-transaction-nested-timing.v1",
            "clock_source": "time.monotonic_ns",
            "owner": "tools/v7-users-autoswitch",
            "spans": list(self._performance_spans),
            "runtime_observation": {
                "wall_ms": wall_ms,
                "process_cpu_ms": cpu_ms,
                "load_average_start": getattr(self, "_performance_runtime_load_before", None),
                "load_average_end": load_after,
                "peak_rss_kb": rss_kb,
                "process_count_start": getattr(self, "_performance_runtime_process_count_before", None),
                "process_count_end": process_count_after,
                "lock_wait_ms": "UNKNOWN; existing lock owner exposes no per-run wait counter",
                "bytes_read": "UNKNOWN; existing owner exposes no per-run byte counter",
                "files_read": "UNKNOWN; existing owner exposes no per-run file counter",
                "subprocess_count": "UNKNOWN; no per-run subprocess counter in current owner",
            },
            "prepared_decision_diagnostic": copy.deepcopy(
                getattr(self, "_prepared_decision_diagnostic", {})
            ),
        }

    def _exact_controlled_verifier_scope(self, selected_moves: list[dict[str, Any]]) -> dict[str, Any]:
        requested_user = str(getattr(self.args, "user", "") or "").strip()
        requested_source = str(getattr(self.args, "source_egress", "") or "").strip()
        requested_target = str(getattr(self.args, "target_egress", "") or "").strip()
        reasons: list[str] = []
        if not bool_value(getattr(self.args, "controlled_verifier_contention", False)):
            reasons.append("controlled_verifier_contention_not_requested")
        if not bool_value(getattr(self.args, "emergency_failover_autonomy", False)):
            reasons.append("controlled_verifier_requires_emergency_failover")
        if to_int(getattr(self.args, "max_selected_moves", 0), 0) != 1:
            reasons.append("controlled_verifier_max_users_must_be_one")
        if len(selected_moves) != 1:
            reasons.append("controlled_verifier_exact_move_required")
        move = selected_moves[0] if len(selected_moves) == 1 else {}
        if requested_user != str(move.get("user_ip") or ""):
            reasons.append("controlled_verifier_user_scope_mismatch")
        if requested_source != str(move.get("current_egress") or ""):
            reasons.append("controlled_verifier_source_scope_mismatch")
        if requested_target != str(move.get("recommended_egress") or ""):
            reasons.append("controlled_verifier_target_scope_mismatch")
        required_bindings = (
            "approved_packet_id",
            "approved_operation_id",
            "approved_selected_move_hash",
            "approved_authority_generation",
            "approved_breaker_generation",
            "approved_source_bundle_hash",
            "approved_snapshot_bundle_hash",
        )
        for field in required_bindings:
            if not str(getattr(self.args, field, "") or ""):
                reasons.append(f"controlled_verifier_{field}_missing")
        # The exact controlled verifier must use the mutable runtime registry
        # directly.  self.state is a diagnostic snapshot and can legitimately
        # lag a just-completed certification setup; merging it through
        # _load_users() would let stale snapshot fields override current owner
        # truth during the final pre-apply gate.
        fresh_users = {row.ip: row for row in self._load_runtime_registry_users()}
        fresh_egress = self._load_egress()
        user = fresh_users.get(requested_user)
        source = fresh_egress.get(requested_source)
        target = fresh_egress.get(requested_target)
        if user is None or not user.enabled:
            reasons.append("controlled_verifier_user_missing_or_disabled")
        else:
            raw_user = next((row for row in parse_registry(self.state_dir / "users.registry") if str(row.get("ip") or "") == requested_user), {})
            # This scope is evaluated only after the bounded forward apply has
            # been acknowledged.  The immutable move still proves the original
            # source, while fresh runtime truth must now place the user on the
            # approved forward target.  Requiring the pre-apply source here
            # makes every valid forward apply fail its own verifier setup.
            if str(user.current) != requested_target:
                reasons.append("controlled_verifier_user_not_on_forward_target")
            if str(raw_user.get("certification_user") or "").lower() not in {"1", "true", "yes"}:
                reasons.append("controlled_verifier_user_not_certification_user")
        raw_source = next((row for row in parse_registry(self.state_dir / "egress.registry") if str(row.get("id") or "") == requested_source), {})
        if source is None:
            reasons.append("controlled_verifier_source_missing")
        else:
            if str(raw_source.get("controlled_certification_source") or "").lower() not in {"1", "true", "yes"}:
                reasons.append("controlled_verifier_source_not_certification_source")
            if source.enabled or str(source.state).lower() not in {"maintenance", "disabled", "down"}:
                reasons.append("controlled_verifier_source_not_deliberately_unavailable")
        if target is None or not target.enabled:
            reasons.append("controlled_verifier_target_not_enabled")
        return {
            "schema_version": "v7.controlled-verifier-scope.v1",
            "ok": not reasons,
            "reasons": sorted(set(reasons)),
            "user": requested_user,
            "source": requested_source,
            "target": requested_target,
            "fresh_user_source": str(user.current) if user is not None else "",
            "fresh_user_egress": str(user.current) if user is not None else "",
            "source_enabled": bool(source.enabled) if source is not None else None,
            "source_state": str(source.state) if source is not None else "",
        }

    def _exact_controlled_engineering_setup_scope(
        self,
        selected_moves: list[dict[str, Any]],
    ) -> dict[str, Any]:
        """Prove the existing one-user Polygon setup independently of L3.

        A historical ordinary L3 incident must not rewrite the source of an
        explicitly Packet-bound engineering setup.  This exception is
        intentionally narrower than the setup caller itself: it requires one
        registry-marked certification identity, an empty reserved
        EXECUTION_ONLY target, every immutable execution binding, and zero
        ordinary users on that target.  It grants no emergency authority and
        is never inferred for an ordinary Planner action.
        """
        requested = bool_value(
            getattr(self.args, "controlled_engineering_setup", False)
        )
        requested_user = str(getattr(self.args, "user", "") or "").strip()
        requested_source = str(
            getattr(self.args, "source_egress", "") or ""
        ).strip()
        requested_target = str(
            getattr(self.args, "target_egress", "") or ""
        ).strip()
        reasons: list[str] = []
        if not requested:
            return {
                "schema_version": "v7.controlled-engineering-setup-scope.v1",
                "ok": False,
                "reasons": ["controlled_engineering_setup_not_requested"],
                "user": requested_user,
                "source": requested_source,
                "target": requested_target,
                "ordinary_user_delta": 0,
                "authority_expanded": False,
            }
        if to_int(getattr(self.args, "max_selected_moves", 0), 0) != 1:
            reasons.append("controlled_engineering_setup_max_users_not_one")
        if len(selected_moves) != 1:
            reasons.append("controlled_engineering_setup_exact_move_required")
        move = selected_moves[0] if len(selected_moves) == 1 else {}
        if requested_user != str(move.get("user_ip") or ""):
            reasons.append("controlled_engineering_setup_user_mismatch")
        if requested_source != str(move.get("current_egress") or ""):
            reasons.append("controlled_engineering_setup_source_mismatch")
        if requested_target != str(move.get("recommended_egress") or ""):
            reasons.append("controlled_engineering_setup_target_mismatch")
        if not requested_source or not requested_target or requested_source == requested_target:
            reasons.append("controlled_engineering_setup_source_target_invalid")
        for field in (
            "approved_packet_id", "approved_operation_id",
            "approved_execution_lease_id", "approved_selected_move_hash",
            "approved_authority_generation", "approved_breaker_generation",
            "approved_source_bundle_hash", "approved_snapshot_bundle_hash",
        ):
            if not str(getattr(self.args, field, "") or ""):
                reasons.append(f"controlled_engineering_setup_{field}_missing")

        users = parse_registry(self.state_dir / "users.registry")
        egress_rows = parse_registry(self.state_dir / "egress.registry")
        user = next(
            (row for row in users if str(row.get("ip") or "") == requested_user),
            {},
        )
        target = next(
            (row for row in egress_rows if str(row.get("id") or "") == requested_target),
            {},
        )
        if (
            not user
            or not bool_value(user.get("enabled", "1"))
            or str(user.get("current") or "") != requested_source
            or not bool_value(user.get("certification_user"))
        ):
            reasons.append("controlled_engineering_setup_user_not_exact")
        target_users = [
            row for row in users
            if bool_value(row.get("enabled", "1"))
            and str(row.get("current") or "") == requested_target
        ]
        if target_users:
            reasons.append("controlled_engineering_setup_target_not_empty")
        if (
            not target
            or not bool_value(target.get("enabled", "1"))
            or str(target.get("state") or "enabled").lower()
            in {"disabled", "maintenance", "down"}
            or str(target.get("role") or "").upper() != "EXECUTION_ONLY"
            or not bool_value(target.get("controlled_certification_source"))
            or not bool_value(target.get("execution_reserved"))
            or not bool_value(target.get("canary_reserved"))
            or str(target.get("reservation_owner") or "")
            != "operator_execution_governance"
            or str(target.get("production_assignment_allowed") or "").lower()
            not in {"0", "false", "no"}
        ):
            reasons.append("controlled_engineering_setup_target_contract_invalid")
        return {
            "schema_version": "v7.controlled-engineering-setup-scope.v1",
            "ok": not reasons,
            "reasons": sorted(set(reasons)),
            "user": requested_user,
            "source": requested_source,
            "target": requested_target,
            "ordinary_user_delta": 0,
            "authority_expanded": False,
        }

    def _exact_controlled_engineering_cleanup_scope(
        self,
        selected_moves: list[dict[str, Any]],
    ) -> dict[str, Any]:
        """Prove an exact one-user return from a controlled source to baseline.

        This is the bounded counterpart of controlled engineering setup.  It
        is accepted only for the registry-marked certification identity that
        is currently on the reserved controlled source named by an immutable
        Packet.  It never admits an ordinary client, reselection, a new
        destination, or a broad incident bypass; the target remains subject
        to the regular enabled/route/service verification after Apply.
        """
        requested = bool_value(
            getattr(self.args, "controlled_engineering_cleanup", False)
        )
        requested_user = str(getattr(self.args, "user", "") or "").strip()
        requested_source = str(
            getattr(self.args, "source_egress", "") or ""
        ).strip()
        requested_target = str(
            getattr(self.args, "target_egress", "") or ""
        ).strip()
        reasons: list[str] = []
        if not requested:
            return {
                "schema_version": "v7.controlled-engineering-cleanup-scope.v1",
                "ok": False,
                "reasons": ["controlled_engineering_cleanup_not_requested"],
                "user": requested_user,
                "source": requested_source,
                "target": requested_target,
                "ordinary_user_delta": 0,
                "authority_expanded": False,
            }
        if to_int(getattr(self.args, "max_selected_moves", 0), 0) != 1:
            reasons.append("controlled_engineering_cleanup_max_users_not_one")
        if len(selected_moves) != 1:
            reasons.append("controlled_engineering_cleanup_exact_move_required")
        move = selected_moves[0] if len(selected_moves) == 1 else {}
        if requested_user != str(move.get("user_ip") or ""):
            reasons.append("controlled_engineering_cleanup_user_mismatch")
        if requested_source != str(move.get("current_egress") or ""):
            reasons.append("controlled_engineering_cleanup_source_mismatch")
        if requested_target != str(move.get("recommended_egress") or ""):
            reasons.append("controlled_engineering_cleanup_target_mismatch")
        if not requested_source or not requested_target or requested_source == requested_target:
            reasons.append("controlled_engineering_cleanup_source_target_invalid")
        for field in (
            "approved_packet_id", "approved_operation_id",
            "approved_execution_lease_id", "approved_selected_move_hash",
            "approved_authority_generation", "approved_breaker_generation",
            "approved_source_bundle_hash", "approved_snapshot_bundle_hash",
        ):
            if not str(getattr(self.args, field, "") or ""):
                reasons.append(f"controlled_engineering_cleanup_{field}_missing")
        users = parse_registry(self.state_dir / "users.registry")
        egress_rows = parse_registry(self.state_dir / "egress.registry")
        user = next(
            (row for row in users if str(row.get("ip") or "") == requested_user),
            {},
        )
        source = next(
            (row for row in egress_rows if str(row.get("id") or "") == requested_source),
            {},
        )
        target = next(
            (row for row in egress_rows if str(row.get("id") or "") == requested_target),
            {},
        )
        if (
            not user
            or not bool_value(user.get("enabled", "1"))
            or str(user.get("current") or "") != requested_source
            or not bool_value(user.get("certification_user"))
        ):
            reasons.append("controlled_engineering_cleanup_user_not_exact")
        if (
            not source
            or not bool_value(source.get("enabled", "1"))
            or str(source.get("state") or "enabled").lower()
            in {"disabled", "maintenance", "down"}
            or not bool_value(source.get("controlled_certification_source"))
            or not bool_value(source.get("execution_reserved"))
            or not bool_value(source.get("canary_reserved"))
            or str(source.get("reservation_owner") or "")
            != "operator_execution_governance"
        ):
            reasons.append("controlled_engineering_cleanup_source_contract_invalid")
        if (
            not target
            or not bool_value(target.get("enabled", "1"))
            or str(target.get("state") or "enabled").lower()
            in {"disabled", "maintenance", "down"}
        ):
            reasons.append("controlled_engineering_cleanup_target_not_ready")
        return {
            "schema_version": "v7.controlled-engineering-cleanup-scope.v1",
            "ok": not reasons,
            "reasons": sorted(set(reasons)),
            "user": requested_user,
            "source": requested_source,
            "target": requested_target,
            "ordinary_user_delta": 0,
            "authority_expanded": False,
        }

    def _exact_availability_first_controlled_scope(
        self,
        selected_moves: list[dict[str, Any]],
    ) -> dict[str, Any]:
        """Consume the existing availability-first semantic binding.

        Availability-first certification deliberately moves certification
        identities from a healthy controlled source to an independently
        selected shared target.  It is therefore neither an ordinary
        production incident nor the older deliberately unavailable-source
        verifier.  The exact standing Authority contract, immutable allocation
        binding and live registry facts must all agree before this context may
        bypass incident-source continuity.
        """
        moves = [
            move for move in selected_moves
            if isinstance(move, dict)
        ]
        if not moves or not any(
            isinstance(
                move.get("availability_first_controlled_assignment"),
                dict,
            )
            for move in moves
        ):
            return {
                "schema_version": (
                    "v7.availability-first-controlled-scope.v1"
                ),
                "ok": False,
                "reasons": [
                    "availability_first_semantic_binding_missing"
                ],
                "event_provenance": "",
                "natural_production_credit": False,
                "ordinary_user_effect": "FORBIDDEN",
                "authority_expanded": False,
                "new_owner_created": False,
            }
        reasons: list[str] = []
        standing_contract = (
            (self.policy or {}).get("delegated_autonomy_policy")
            if isinstance((self.policy or {}).get("delegated_autonomy_policy"), dict)
            else {}
        )
        audit_store = Path(getattr(
            self.args,
            "action_class_audit_store",
            str(operator_execution.DEFAULT_PRODUCTION_OPERATOR_EXECUTION_AUDIT_STORE),
        ))
        standing_validation = (
            operator_execution.validate_standing_delegated_operational_policy(
                standing_contract,
                audit_records=self._standing_policy_audit_records(),
            )
            if standing_contract
            else {
                "ok": False,
                "errors": ["standing_delegated_policy_missing"],
                "policy": {},
            }
        )
        standing_scope = (
            standing_validation.get("policy")
            if isinstance(standing_validation.get("policy"), dict)
            else {}
        )
        action_scopes = (
            standing_scope.get("action_class_scopes")
            if isinstance(standing_scope.get("action_class_scopes"), dict)
            else {}
        )
        availability_scope = (
            action_scopes.get(
                operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
            )
            if isinstance(
                action_scopes.get(
                    operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
                ),
                dict,
            )
            else {}
        )
        if standing_validation.get("ok") is not True:
            reasons.extend(
                str(value)
                for value in (
                    standing_validation.get("errors")
                    or ["availability_first_standing_policy_invalid"]
                )
                if str(value)
            )
        if (
            standing_scope.get("policy_profile")
            != operator_execution.AVAILABILITY_FIRST_STANDING_POLICY_PROFILE
        ):
            reasons.append("availability_first_policy_profile_not_active")
        if (
            operator_execution.AVAILABILITY_FIRST_DELEGATED_ACTION_CLASS
            not in set(standing_scope.get("allowed_action_classes") or [])
        ):
            reasons.append("availability_first_action_class_not_active")
        if availability_scope.get("certification_identities_only") is not True:
            reasons.append("availability_first_certification_identity_fence_missing")
        max_users = to_int(
            availability_scope.get("max_users_per_transaction"),
            0,
        )
        if not moves:
            reasons.append("availability_first_exact_move_missing")
        if max_users < 1 or len(moves) > max_users:
            reasons.append("availability_first_scope_above_contract_ceiling")

        requested_user = str(getattr(self.args, "user", "") or "").strip()
        requested_source = str(
            getattr(self.args, "source_egress", "") or ""
        ).strip()
        requested_target = str(
            getattr(self.args, "target_egress", "") or ""
        ).strip()
        registry_rows = [
            row for row in parse_registry(self.state_dir / "users.registry")
            if isinstance(row, dict)
        ]
        users_by_ip = {
            str(row.get("ip") or ""): row for row in registry_rows
        }
        egress_rows = {
            str(row.get("id") or ""): row
            for row in parse_registry(self.state_dir / "egress.registry")
            if isinstance(row, dict)
        }
        allocation_fingerprints: set[str] = set()
        sources: set[str] = set()
        targets: set[str] = set()
        baseline_reset_sources: set[str] = set()
        users: list[str] = []
        member_proof: list[dict[str, Any]] = []
        for move in moves:
            user_ip = str(move.get("user_ip") or "")
            source = str(move.get("current_egress") or "")
            target = str(move.get("recommended_egress") or "")
            binding = (
                move.get("availability_first_controlled_assignment")
                if isinstance(
                    move.get("availability_first_controlled_assignment"),
                    dict,
                )
                else {}
            )
            user_row = users_by_ip.get(user_ip) or {}
            source_row = egress_rows.get(source) or {}
            target_obj = self.egress.get(target)
            fingerprint = str(
                binding.get("allocation_fingerprint") or ""
            )
            baseline_reset = binding.get("baseline_reset") is True
            if baseline_reset:
                baseline_reset_sources.add(source)
            allocation_fingerprints.add(fingerprint)
            sources.add(source)
            targets.add(target)
            users.append(user_ip)
            if binding.get("schema_version") != (
                "v7.availability-first-controlled-selection.v1"
            ):
                reasons.append(
                    f"availability_first_binding_schema_invalid:{user_ip}"
                )
            if binding.get("event_provenance") != "CONTROLLED_CERTIFICATION":
                reasons.append(
                    f"availability_first_provenance_invalid:{user_ip}"
                )
            if binding.get("natural_production_credit") is not False:
                reasons.append(
                    f"availability_first_natural_credit_invalid:{user_ip}"
                )
            if binding.get("ordinary_user") is not False:
                reasons.append(
                    f"availability_first_ordinary_user_fence_invalid:{user_ip}"
                )
            if (
                str(binding.get("source") or "") != source
                or str(binding.get("target") or "") != target
            ):
                reasons.append(
                    f"availability_first_source_target_binding_mismatch:{user_ip}"
                )
            if len(fingerprint) != 64:
                reasons.append(
                    f"availability_first_allocation_fingerprint_invalid:{user_ip}"
                )
            if not user_row or not bool_value(user_row.get("enabled")):
                reasons.append(
                    f"availability_first_user_missing_or_disabled:{user_ip}"
                )
            if str(user_row.get("current") or "") != source:
                reasons.append(
                    f"availability_first_user_source_mismatch:{user_ip}"
                )
            if not bool_value(user_row.get("certification_user")):
                reasons.append(
                    f"availability_first_user_not_certification_identity:{user_ip}"
                )
            controlled_row = (
                egress_rows.get(target) or {}
                if baseline_reset
                else source_row
            )
            if not bool_value(
                controlled_row.get("controlled_certification_source")
            ):
                reasons.append(
                    (
                        "availability_first_reset_baseline_not_controlled:"
                        if baseline_reset
                        else "availability_first_source_not_controlled:"
                    )
                    + (target if baseline_reset else source)
                )
            if baseline_reset and str(
                binding.get("controlled_baseline_source") or ""
            ) != target:
                reasons.append(
                    f"availability_first_reset_baseline_binding_mismatch:{user_ip}"
                )
            if source == target:
                reasons.append(
                    f"availability_first_source_target_collision:{user_ip}"
                )
            if target_obj is None or not target_obj.enabled:
                reasons.append(
                    f"availability_first_target_not_enabled:{target}"
                )
            member_proof.append({
                "user_ip": user_ip,
                "source": source,
                "target": target,
                "certification_user": bool_value(
                    user_row.get("certification_user")
                ),
                "source_controlled": bool_value(
                    controlled_row.get("controlled_certification_source")
                ),
                "baseline_reset": baseline_reset,
                "binding_fingerprint": fingerprint,
            })

        if len(allocation_fingerprints) != 1:
            reasons.append(
                "availability_first_allocation_fingerprint_not_uniform"
            )
        if len(sources) != 1:
            reasons.append("availability_first_source_not_exact")
        if requested_user and users != [requested_user]:
            reasons.append("availability_first_requested_user_mismatch")
        if requested_source and sources != {requested_source}:
            reasons.append("availability_first_requested_source_mismatch")
        if requested_target and targets != {requested_target}:
            reasons.append("availability_first_requested_target_mismatch")
        for source in sources:
            if source in baseline_reset_sources:
                # A reset removes one certification identity from the shared
                # execution target. Ordinary occupants on that shared channel
                # are not in the Packet scope and must not make the exact
                # return-to-controlled-baseline transaction impossible.
                continue
            ordinary_on_source = [
                str(row.get("ip") or "")
                for row in registry_rows
                if str(row.get("current") or "") == source
                and bool_value(row.get("enabled"))
                and not bool_value(row.get("certification_user"))
            ]
            if ordinary_on_source:
                reasons.append(
                    "availability_first_controlled_source_contains_ordinary_users"
                )

        return {
            "schema_version": "v7.availability-first-controlled-scope.v1",
            "ok": not reasons,
            "reasons": sorted(set(reasons)),
            "standing_policy_contract_id": str(
                standing_contract.get("contract_id") or ""
            ),
            "standing_policy_contract_hash": str(
                standing_contract.get("contract_hash") or ""
            ),
            "policy_profile": str(
                standing_scope.get("policy_profile") or ""
            ),
            "users": users,
            "sources": sorted(sources),
            "targets": sorted(targets),
            "allocation_fingerprint": (
                next(iter(allocation_fingerprints))
                if len(allocation_fingerprints) == 1
                else ""
            ),
            "member_scope_fingerprint": sha256_json(member_proof),
            "event_provenance": "CONTROLLED_CERTIFICATION",
            "natural_production_credit": False,
            "ordinary_user_effect": "FORBIDDEN",
            "authority_expanded": False,
            "new_owner_created": False,
        }

    def _exact_ct_m0f_standing_reset_scope(
        self,
        selected_moves: list[dict[str, Any]],
    ) -> dict[str, Any]:
        """Validate the recovery half of one already reserved CT-M0F sample."""
        reservation_id = str(
            getattr(self.args, "ct_m0f_standing_reset_reservation_id", "")
            or ""
        )
        base = {
            "schema_version": "v7.ct-m0f-standing-reset-scope.v1",
            "ok": False,
            "reservation_id": reservation_id,
            "event_provenance": "CONTROLLED_CERTIFICATION",
            "natural_production_credit": False,
            "ordinary_user_effect": "FORBIDDEN",
            "authority_expanded": False,
            "new_owner_created": False,
        }
        if not reservation_id:
            return {**base, "reasons": ["ct_m0f_standing_reset_binding_missing"]}
        audit_store = Path(getattr(
            self.args,
            "action_class_audit_store",
            str(operator_execution.DEFAULT_PRODUCTION_OPERATOR_EXECUTION_AUDIT_STORE),
        ))
        sample = operator_execution.ct_m0f_standing_validation_sample_from_audit(
            reservation_id,
            audit_store=audit_store,
        )
        reservation = (
            sample.get("reservation")
            if isinstance(sample.get("reservation"), dict)
            else {}
        )
        contract = (
            (self.policy or {}).get(
                operator_execution.CT_M0F_STANDING_VALIDATION_POLICY_KEY,
                {},
            )
            if isinstance(self.policy, dict)
            else {}
        )
        contract_validation = (
            operator_execution.validate_ct_m0f_standing_validation_policy(
                contract,
                # Use the same rotated-family lineage reader as the outer
                # CT-M0F reset owner. Reading only the current audit segment
                # loses the standing-policy admission after rotation and can
                # incorrectly bind an exact baseline reset to another open
                # source incident.
                audit_records=operator_execution.read_live_execution_lineage_records(
                    audit_store,
                    required_decision_ids=(str(
                        (contract.get("authority_decision") or {}).get(
                            "decision_id"
                        ) or ""
                    ),),
                    required_checkpoint_fingerprint=str(
                        reservation.get("implementation_fingerprint") or ""
                    ),
                ),
            )
        )
        reasons = list(contract_validation.get("errors") or [])
        if not sample.get("ok"):
            reasons.extend(sample.get("errors") or ["ct_m0f_sample_lineage_invalid"])
        terminal_residue_reconciliation = bool(sample.get("terminal"))
        moves = [row for row in selected_moves if isinstance(row, dict)]
        if len(moves) != 1:
            reasons.append("ct_m0f_reset_requires_exactly_one_move")
        move = moves[0] if len(moves) == 1 else {}
        expected = {
            "user_ip": str(reservation.get("user") or ""),
            "current_egress": str(reservation.get("target") or ""),
            "recommended_egress": str(reservation.get("source") or ""),
        }
        for field, value in expected.items():
            if not value or str(move.get(field) or "") != value:
                reasons.append(f"ct_m0f_reset_{field}_mismatch")
        if str(reservation.get("contract_id") or "") != str(
            contract.get("contract_id") or ""
        ):
            reasons.append("ct_m0f_reset_contract_id_mismatch")
        if str(reservation.get("contract_hash") or "") != str(
            contract.get("contract_hash") or ""
        ):
            reasons.append("ct_m0f_reset_contract_hash_mismatch")
        user = next(
            (
                row for row in parse_registry(self.state_dir / "users.registry")
                if str(row.get("ip") or "") == expected["user_ip"]
            ),
            {},
        )
        if str(user.get("current") or "") != expected["current_egress"]:
            reasons.append("ct_m0f_reset_current_route_changed")
        if str(user.get("certification_user") or "").lower() not in {
            "1", "true", "yes",
        }:
            reasons.append("ct_m0f_reset_certification_identity_required")
        return {
            **base,
            "ok": not reasons,
            "reasons": sorted(set(reasons)),
            "user": expected["user_ip"],
            "source": expected["current_egress"],
            "target": expected["recommended_egress"],
            "contract_id": str(contract.get("contract_id") or ""),
            # A terminal closes evidence admission, not the mandatory return
            # of a certification identity to its recorded baseline.  The
            # exact reservation/user/source/target and current-route checks
            # above keep this cleanup narrower than an ordinary USER_SWITCH.
            "terminal_residue_reconciliation": (
                terminal_residue_reconciliation
            ),
        }

    def _activate_controlled_verifier_contention(self, move: dict[str, Any], operation_id: str) -> dict[str, Any]:
        scope = self._exact_controlled_verifier_scope([move])
        source = str(move.get("current_egress") or "")
        safe_operation = re.sub(r"[^A-Za-z0-9_.-]", "_", str(operation_id or "controlled"))[:80]
        marker = self.state_dir / f"controlled-verifier-lock-{safe_operation}.json"
        output = self.state_dir / f"controlled-verifier-refresh-{safe_operation}.log"
        try:
            marker.unlink(missing_ok=True)
        except OSError:
            pass
        if not scope.get("ok"):
            restore = subprocess.run(
                ["v7-egress-set-state", source, "enabled", "--apply"],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=180,
            ) if source else subprocess.CompletedProcess([], 2, stdout="missing source\n")
            return {
                "schema_version": "v7.controlled-verifier-contention.v1",
                "ok": False,
                "status": "STOP_SAFE_SCOPE_INVALID",
                "scope": scope,
                "source_restore_rc": restore.returncode,
                "source_restore_output": (restore.stdout or "")[-2000:],
            }
        handle = output.open("w", encoding="utf-8")
        try:
            proc = subprocess.Popen(
                [
                    "v7-service-matrix-refresh-all",
                    "--state-dir", str(self.state_dir),
                    "--event-dir", str(self.event_dir),
                    "--summary-file", str(self.state_dir / f"controlled-verifier-summary-{safe_operation}.json"),
                    "--lock-timeout-sec", "5",
                    "--lock-acquired-marker", str(marker),
                ],
                stdout=handle,
                stderr=subprocess.STDOUT,
                text=True,
                start_new_session=True,
            )
        except OSError as exc:
            handle.close()
            restore = subprocess.run(
                ["v7-egress-set-state", source, "enabled", "--apply"],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=180,
            )
            return {
                "schema_version": "v7.controlled-verifier-contention.v1",
                "ok": False,
                "status": "STOP_SAFE_LIFECYCLE_START_FAILED",
                "scope": scope,
                "error": f"{type(exc).__name__}:{exc}",
                "source_restore_rc": restore.returncode,
                "source_restore_output": (restore.stdout or "")[-2000:],
                "direct_rollback_invoked": False,
                "runtime_automation_enabled": False,
            }
        marker_payload: dict[str, Any] = {}
        deadline = time.time() + 12
        while time.time() < deadline:
            marker_payload = read_json(marker, {})
            if (
                marker_payload.get("owner") == "tools/v7-service-matrix-refresh-all"
                and to_int(marker_payload.get("pid"), 0) == proc.pid
            ):
                break
            if proc.poll() is not None:
                break
            time.sleep(0.05)
        handle.close()
        acquired = (
            marker_payload.get("owner") == "tools/v7-service-matrix-refresh-all"
            and to_int(marker_payload.get("pid"), 0) == proc.pid
        )
        if not acquired and proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait(timeout=5)
        restore = subprocess.run(
            ["v7-egress-set-state", source, "enabled", "--apply"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=180,
        )
        return {
            "schema_version": "v7.controlled-verifier-contention.v1",
            "ok": bool(acquired and restore.returncode == 0),
            "status": "ACTIVE" if acquired and restore.returncode == 0 else "STOP_SAFE_ACTIVATION_FAILED",
            "scope": scope,
            "refresh_pid": proc.pid,
            "refresh_running": proc.poll() is None,
            "lock_marker": marker_payload,
            "lock_marker_path": str(marker),
            "refresh_output_path": str(output),
            "source_restore_rc": restore.returncode,
            "source_restore_output": (restore.stdout or "")[-2000:],
            "direct_rollback_invoked": False,
            "runtime_automation_enabled": False,
        }

    def _execution_action_class(self, move_type: str = "") -> str:
        text = str(move_type or "").lower()
        # The controlled setup and terminal cleanup paths run inside the
        # one-operation window emitted by the governed canary owner.  That
        # window is deliberately classified as ``USER_SWITCH``: it permits
        # one exact engineering identity to be bound or returned, not a new
        # emergency-failover admission.  Keep the writer-side re-read in that
        # same class.  The narrow setup/cleanup scope checks below still
        # require one registry-marked certification identity and immutable
        # approved bindings; this is not a general user-switch admission.
        if (
            bool_value(getattr(self.args, "controlled_engineering_setup", False))
            or bool_value(
                getattr(self.args, "controlled_engineering_cleanup", False)
            )
        ):
            return "USER_SWITCH"
        if "recover" in text or "reconnect" in text:
            return "RECOVERY_ADMISSION"
        if "rebalance" in text:
            return "BOUNDED_REBALANCE"
        if "degrad" in text:
            return "DEGRADATION_MOVEMENT"
        if "failover" in text or bool_value(getattr(self.args, "emergency_failover_autonomy", False)):
            return "EMERGENCY_FAILOVER"
        return "USER_SWITCH"

    def bind_routing_core_certification(self, plan: dict[str, Any]) -> dict[str, Any]:
        """Fence one exact Core decision to the existing effect writer.

        This is the RESET-M6 migration adapter.  It creates no writer, store,
        process or Authority owner: the Core remains pure, while ``apply``
        retains all existing packet, lease, rollback and verification gates.
        """
        selected = [row for row in (plan.get("selected_moves") or []) if isinstance(row, dict)]
        requested_user = str(getattr(self.args, "user", "") or "")
        requested_source = str(getattr(self.args, "source_egress", "") or "")
        requested_target = str(getattr(self.args, "target_egress", "") or "")
        blockers: list[str] = []
        if len(selected) != 1:
            blockers.append("core_certification_requires_exactly_one_selected_move")
        if not requested_user or not requested_source or not requested_target:
            blockers.append("core_certification_exact_user_source_target_required")
        if to_int(getattr(self.args, "max_selected_moves", 0), 0) != 1:
            blockers.append("core_certification_max_selected_moves_must_equal_one")
        move = selected[0] if len(selected) == 1 else {}
        if move and (
            str(move.get("user_ip") or "") != requested_user
            or str(move.get("current_egress") or "") != requested_source
            or str(move.get("recommended_egress") or "") != requested_target
        ):
            blockers.append("core_certification_selected_move_scope_mismatch")
        target = self.egress.get(requested_target)
        if target is None:
            blockers.append("core_certification_target_missing")
        operation = plan.get("operation") if isinstance(plan.get("operation"), dict) else {}
        envelope = ((plan.get("safety") or {}).get("atomic_execution_envelope") or {})
        if not str(operation.get("operation_id") or "") or not str(envelope.get("envelope_id") or ""):
            blockers.append("core_certification_operation_fence_missing")
        if blockers:
            result = {
                "schema_version": "v7.routing-core-certification-binding.v1",
                "status": "STOP_SAFE",
                "blockers": sorted(set(blockers)),
                "runtime_mutation": False,
                "writer_changed": False,
            }
            plan.setdefault("safety", {})["routing_core_certification"] = result
            return result
        authority_gate = ((plan.get("safety") or {}).get("authority_budget_gate") or {})
        raw_policy = getattr(self, "policy", {}) or {}
        raw_budget = raw_policy.get("authority_budget")
        raw_budget = raw_budget if isinstance(raw_budget, dict) else {}
        action_contract = (
            runtime_authority_contract_status(
                raw_budget,
                prepared_class=str(authority_gate.get("prepared_authority_class") or "CANARY"),
                certified_class=str(authority_gate.get("certified_authority_class") or "CANARY"),
                standing_policy_contract={},
                authority_audit_records=[],
            )
            if isinstance(raw_budget.get("current_action_class_contract"), dict)
            else (authority_gate.get("current_action_class_contract") or {})
        )
        authority_generation = str(action_contract.get("contract_id") or "")
        contract_program = str(action_contract.get("active_program") or "")
        strict_contract = ((action_contract.get("provenance") or {}).get("strict_provenance_contract") is True)
        if (
            not authority_generation
            or contract_program != "V7_SYSTEM_RESET_AND_ROUTING_CORE_MIGRATION_PROGRAM_V1"
            or not strict_contract
        ):
            result = {
                "schema_version": "v7.routing-core-certification-binding.v1",
                "status": "STOP_SAFE",
                "blockers": ["core_certification_exact_reset_owner_contract_required"],
                "runtime_mutation": False,
                "writer_changed": False,
            }
            plan.setdefault("safety", {})["routing_core_certification"] = result
            return result
        observed_at = datetime.now(timezone.utc)
        core_envelope = {
            "schema": routing_core.CORE_INPUT_SCHEMA,
            "generation": str(operation.get("planner_generation_id") or envelope.get("generation_id") or ""),
            "observed_at": observed_at.isoformat(),
            "max_age_ms": 5000,
            "scope": {"source": requested_source, "users": [requested_user]},
            "assignments": {requested_user: requested_source},
            "targets": {
                requested_target: {
                    "healthy": bool(target.enabled and str(target.state).lower() != "disabled"),
                    "capacity": max(int(target.capacity_users or 0), int(target.users) + 1),
                    "assigned": int(target.users),
                }
            },
            "policy": {
                "generation": str(operation.get("planner_generation_id") or "planner-policy"),
                "allowed_targets": [requested_target],
                "capacity_reserve": 0,
            },
            "authority": {
                "generation": authority_generation,
                "permitted_users": [requested_user],
                "max_users": 1,
            },
            "operation": {
                "id": str(operation.get("operation_id") or ""),
                "lease_id": str(envelope.get("envelope_id") or ""),
                "fencing_token": str(envelope.get("envelope_hash") or ""),
                "idempotency_key": str(operation.get("operation_id") or ""),
            },
        }
        try:
            core_result = routing_core.run_shadow(core_envelope, now=observed_at)
        except routing_core.RoutingCoreContractError as exc:
            result = {
                "schema_version": "v7.routing-core-certification-binding.v1",
                "status": "STOP_SAFE",
                "blockers": [exc.status],
                "runtime_mutation": False,
                "writer_changed": False,
            }
            plan.setdefault("safety", {})["routing_core_certification"] = result
            return result
        core_moves = core_result.get("decision", {}).get("moves", [])
        expected = [{"user": requested_user, "source": requested_source, "target": requested_target}]
        status = (
            "CORE_DECISION_BOUND_TO_EXISTING_WRITER"
            if core_result.get("decision", {}).get("decision") == "PLAN_READY" and core_moves == expected
            else "STOP_SAFE"
        )
        result = {
            "schema_version": "v7.routing-core-certification-binding.v1",
            "status": status,
            "decision_fingerprint": str(core_result.get("decision_fingerprint") or ""),
            "selected_move_hash": str(operation.get("selected_move_hash") or ""),
            "operation_id": str(operation.get("operation_id") or ""),
            "atomic_execution_envelope_id": str(envelope.get("envelope_id") or ""),
            "effect_writer": "tools/v7-users-autoswitch.apply",
            "runtime_mutation": False,
            "writer_changed": False,
            "blockers": [] if status != "STOP_SAFE" else ["core_decision_does_not_match_exact_certification_move"],
        }
        plan.setdefault("safety", {})["routing_core_certification"] = result
        operation["routing_core_decision_fingerprint"] = result["decision_fingerprint"]
        return result

