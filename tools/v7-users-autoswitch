def write_json_atomic(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def read_jsonl(path: Path) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except FileNotFoundError:
        return rows
    except OSError:
        return rows
    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(row, dict):
            rows.append(row)
    return rows


def append_jsonl(path: Path, rows: list[dict[str, Any]]) -> None:
    if not rows:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fh:
        for row in rows:
            fh.write(json.dumps(row, ensure_ascii=False, sort_keys=False) + "\n")


def acquire_service_matrix_lock(state_dir: Path, timeout_sec: int, *, enabled: bool) -> tuple[Optional[int], dict[str, Any]]:
    status: dict[str, Any] = {
        "schema": "v7.service-matrix-lifecycle-lock.v1",
        "enabled": bool(enabled),
        "acquired": False,
        "path": str(state_dir / "service-matrix.lock"),
        "scope": "planner_snapshot_packet_lifecycle",
        "owner": "tools/v7-users-autoswitch",
        "runtime_behavior_changed": False,
        "governance_behavior_changed": False,
        "execution_behavior_changed": False,
        "users_moved": False,
    }
    if not enabled:
        status["decision"] = "lock_not_required"
        return None, status
    lock_path = state_dir / "service-matrix.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600)
    started = time.time()
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            _SERVICE_MATRIX_LOCKS_HELD_BY_PROCESS.add(str(lock_path))
            status.update({
                "acquired": True,
                "decision": "service_matrix_writer_serialized_for_planner_lifecycle",
                "waited_sec": round(time.time() - started, 3),
                "timeout_sec": max(1, timeout_sec),
            })
            return fd, status
        except BlockingIOError:
            if str(lock_path) in _SERVICE_MATRIX_LOCKS_HELD_BY_PROCESS:
                os.close(fd)
                status.update({
                    "acquired": True,
                    "reentrant_same_process": True,
                    "decision": "service_matrix_writer_serialized_for_planner_lifecycle",
                    "waited_sec": round(time.time() - started, 3),
                    "timeout_sec": max(1, timeout_sec),
                })
                return None, status
            if time.time() - started >= max(1, timeout_sec):
                os.close(fd)
                status.update({
                    "acquired": False,
                    "decision": "service_matrix_lock_timeout",
                    "waited_sec": round(time.time() - started, 3),
                    "timeout_sec": max(1, timeout_sec),
                    "blocked_actions": ["selected_moves", "apply", "operator_visible_promotion"],
                })
                return None, status
            time.sleep(0.25)


def service_failure_causal_integrity_status(state_dir: Path) -> dict[str, Any]:
    """Validate the existing compact incident owner without mutating it.

    This is a read-only projection of ``l3-runtime-state.json``.  It creates no
    incident or successor; it gives policy/CPS consumers exact invalid-state
    names instead of allowing an incomplete causal record to look executable.
    """
    state_path = Path(state_dir) / "l3-runtime-state.json"
    state = read_json(state_path, {})
    incidents = state.get("incidents") if isinstance(state.get("incidents"), dict) else {}
    if not state_path.exists():
        return {
            "schema_version": "v7.service-failure-causal-integrity-status.v1",
            "status": "NOT_AVAILABLE",
            "final_verdict": "NOT_APPLICABLE",
            "state_path": str(state_path),
            "incident_count": 0,
            "open_incident_count": 0,
            "invalid_states": [],
            "read_only": True,
        }

    invalid_states: set[str] = set()
    open_incidents = 0
    checked_incidents = 0
    open_incident_projections: list[dict[str, Any]] = []
    for record in incidents.values():
        if not isinstance(record, dict):
            continue
        if str(record.get("authority_object") or "") != "PASSIVE_SERVICE_FAILURE_CAPTURE":
            continue
        checked_incidents += 1
        closed = str(record.get("incident_state") or "") == "INTENT_CLOSED"
        if not closed:
            open_incidents += 1
            next_consumer = str(record.get("next_required_consumer") or "")
            reentry = str(record.get("reentry_condition") or "")
            if not next_consumer:
                invalid_states.add("INVALID_OPEN_INCIDENT_NO_SUCCESSOR")
            if not reentry:
                invalid_states.add("CAUSAL_LINEAGE_BROKEN")
            if bool(record.get("durable_successor_published")) and not next_consumer:
                invalid_states.add("DURABLE_SUCCESSOR_WITHOUT_CONSUMER")
            if str(record.get("attempt_terminal") or "") not in {
                "", "SUCCESS", "ROLLBACK_SUCCESS", "RECOVERY_OBSERVED_NO_ACTION",
                "EPISODE_EXPIRED_NO_ACTION",
            } and not next_consumer:
                invalid_states.add("NONTERMINAL_RESULT_WITHOUT_DURABLE_SUCCESSOR")

        scope = (
            record.get("current_source_scope")
            if isinstance(record.get("current_source_scope"), dict)
            else (record.get("scope_accounting") if isinstance(record.get("scope_accounting"), dict) else {})
        )
        if scope:
            affected = to_int(scope.get("affected_scope_count"), -1)
            protected = to_int(scope.get("protected_scope_count"), -1)
            unresolved = to_int(scope.get("unresolved_scope_count"), -1)
            excluded = to_int(scope.get("explicitly_excluded_or_recovered_scope_count"), -1)
            if min(affected, protected, unresolved, excluded) < 0 or affected != protected + unresolved + excluded:
                invalid_states.add("INCIDENT_SCOPE_ACCOUNTING_BROKEN")

        cumulative = (
            record.get("incident_cumulative_scope")
            if isinstance(record.get("incident_cumulative_scope"), dict) else {}
        )
        entries = cumulative.get("entries") if isinstance(cumulative.get("entries"), list) else []
        pointers = {
            str(item) for item in (cumulative.get("lineage_pointers") or []) if str(item)
        }
        entry_pointers = {
            str(item.get("feedback_id") or "")
            for item in entries if isinstance(item, dict) and str(item.get("feedback_id") or "")
        }
        consumed_feedback = {
            str(item) for item in (record.get("execution_feedback_ids") or []) if str(item)
        }
        if pointers != entry_pointers or not consumed_feedback.issubset(pointers):
            invalid_states.add("CURRENT_SCOPE_REPLACES_CUMULATIVE_HISTORY")
        last_feedback = str(record.get("last_execution_feedback_id") or "")
        if last_feedback and (
            last_feedback not in pointers
            or not scope
            or str(scope.get("status") or "") == "INCIDENT_SCOPE_ACCOUNTING_BROKEN"
        ):
            invalid_states.add("SUCCESSFUL_ATTEMPT_WITHOUT_SCOPE_UPDATE")
        if cumulative and scope:
            cumulative_fingerprint = str(cumulative.get("current_source_scope_fingerprint") or "")
            current_fingerprint = str(scope.get("affected_scope_fingerprint") or "")
            if cumulative_fingerprint and current_fingerprint and cumulative_fingerprint != current_fingerprint:
                invalid_states.add("CURRENT_SCOPE_REPLACES_CUMULATIVE_HISTORY")
        if not closed:
            lineage = record.get("causal_lineage") if isinstance(record.get("causal_lineage"), dict) else {}
            open_incident_projections.append({
                "incident_id": str(record.get("incident_id") or ""),
                "incident_generation": str(record.get("incident_generation") or record.get("generation") or ""),
                "source_channel": str(record.get("channel") or record.get("source_channel") or ""),
                "incident_state": str(record.get("incident_state") or ""),
                "affected_scope_count": max(0, to_int(scope.get("affected_scope_count"), 0)),
                "protected_scope_count": max(0, to_int(scope.get("protected_scope_count"), 0)),
                "unresolved_scope_count": max(0, to_int(scope.get("unresolved_scope_count"), 0)),
                "explicitly_excluded_or_recovered_scope_count": max(
                    0, to_int(scope.get("explicitly_excluded_or_recovered_scope_count"), 0)
                ),
                "affected_scope_fingerprint": str(scope.get("affected_scope_fingerprint") or ""),
                "protected_scope_fingerprint": str(scope.get("protected_scope_fingerprint") or ""),
                "unresolved_scope_fingerprint": str(scope.get("unresolved_scope_fingerprint") or ""),
                "explicitly_excluded_or_recovered_scope_fingerprint": str(
                    scope.get("explicitly_excluded_or_recovered_scope_fingerprint") or ""
                ),
                "packet_bound_success_count": max(0, to_int(cumulative.get("packet_bound_success_count"), 0)),
                "cumulative_lineage_count": len(entries),
                "last_execution_feedback_id": str(record.get("last_execution_feedback_id") or ""),
                "last_outcome_id": str(record.get("outcome_id") or ""),
                "last_learning_id": str(record.get("learning_id") or lineage.get("learning_id") or ""),
                "last_packet_id": str(record.get("packet_id") or lineage.get("packet_id") or ""),
                "next_required_consumer": str(record.get("next_required_consumer") or ""),
                "reentry_condition": str(record.get("reentry_condition") or ""),
                "last_observed_at": str(record.get("last_observed_at") or ""),
                "raw_user_list_stored": False,
            })

    return {
        "schema_version": "v7.service-failure-causal-integrity-status.v1",
        "status": "PASS" if not invalid_states else "STOP_SAFE",
        "final_verdict": "PASS" if not invalid_states else "STOP_SAFE",
        "state_path": str(state_path),
        "incident_count": checked_incidents,
        "open_incident_count": open_incidents,
        "open_incident_projections": sorted(
            open_incident_projections,
            key=lambda item: (
                str(item.get("source_channel") or ""),
                str(item.get("incident_id") or ""),
                str(item.get("incident_generation") or ""),
            ),
        ),
        "invalid_states": sorted(invalid_states),
        "read_only": True,
        "forbidden_effects": {
            "candidate_created": False,
            "packet_created": False,
            "lease_created": False,
            "runtime_apply": False,
            "routing_mutation": False,
            "user_movement": 0,
            "rollback_apply": False,
            "authority_change": False,
            "production_maturity_change": False,
        },
    }


