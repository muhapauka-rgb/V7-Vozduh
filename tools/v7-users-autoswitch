def consume_passive_events_only(args: argparse.Namespace) -> dict[str, Any]:
    """Run the existing passive consumer without constructing the Planner path.

    AutoswitchPlanner.__init__ owns additional observation and optional refresh
    behaviors needed by the planner.  A Matrix lifecycle consumer must not enter
    those behaviors merely to close a capture-only event.  This deliberately
    constructs only the existing passive-event owner state required by
    _consume_passive_production_events().
    """
    forbidden_flags: list[str] = []
    for name in (
        "apply",
        "emergency_failover_autonomy",
        "controlled_verifier_contention",
        "allow_pre_planner_refresh_with_apply",
    ):
        if bool_value(getattr(args, name, False)):
            forbidden_flags.append(name)
    for name in (
        "approved_packet_id",
        "approved_operation_id",
        "approved_selected_move_hash",
        "approved_authority_generation",
        "approved_breaker_generation",
        "approved_source_bundle_hash",
        "approved_snapshot_bundle_hash",
        "generate_rollback_packet_from_result",
        "rollback_packet",
        "promote_authority_to",
    ):
        if str(getattr(args, name, "") or "").strip():
            forbidden_flags.append(name)
    if str(getattr(args, "pre_planner_refresh", "off") or "off") != "off":
        forbidden_flags.append("pre_planner_refresh")
    forbidden_effects = {
        "planner_execution": False,
        "candidate_created": False,
        "packet_created": False,
        "lease_created": False,
        "runtime_apply": False,
        "routing_mutation": False,
        "user_movement": False,
        "rollback_apply": False,
        "authority_change": False,
        "production_maturity_change": False,
        "l7_credit": False,
        "natural_l8_credit": False,
    }
    if forbidden_flags:
        return {
            "schema_version": "v7.passive-event-consumer-entrypoint.v1",
            "status": "STOP_SAFE_FORBIDDEN_FLAGS",
            "ok": False,
            "mode": "PASSIVE_EVENTS_ONLY",
            "blockers": [f"passive_consumer_forbids_{name}" for name in sorted(set(forbidden_flags))],
            "forbidden_effects": forbidden_effects,
        }

    spans: list[dict[str, Any]] = []

    def record_passive_span(stage: str, started_ns: int) -> None:
        spans.append({
            "stage": stage,
            "owner": "tools/v7-users-autoswitch.consume_passive_events_only",
            "clock_source": "time.monotonic_ns",
            "duration_ms": round((time.monotonic_ns() - started_ns) / 1_000_000.0, 3),
            "runtime_mutation_performed": False,
        })

    planner = object.__new__(AutoswitchPlanner)
    planner.args = args
    planner.state_dir = Path(args.state_dir)
    planner.event_dir = Path(args.event_dir)
    planner.l3_runtime_state_file = planner.state_dir / "l3-runtime-state.json"
    # The passive entrypoint intentionally skips the full Planner constructor,
    # but its existing L3 reconciliation owner still evaluates the current
    # emergency-policy projection.  Initialise the same immutable inputs that
    # ``__init__`` would provide; this is not a second policy source and does
    # not grant execution authority.
    planner._standing_policy_audit_records_cache = None
    planner._standing_policy_lineage_reuse_diagnostic = {}
    planner._passive_performance_recorder = record_passive_span
    l3_load_started_ns = time.monotonic_ns()
    planner.l3_runtime_state = planner._load_l3_runtime_state()
    record_passive_span("passive_l3_current_state_load", l3_load_started_ns)
    policy_load_started_ns = time.monotonic_ns()
    planner.policy = read_json(Path(args.policy_file), {})
    planner.org_policy = read_json(Path(args.org_policy_file), {})
    planner.service_signal_policy = planner._service_signal_policy()
    planner.emergency_failover_policy = planner._emergency_failover_policy()
    record_passive_span("passive_policy_and_signal_inputs", policy_load_started_ns)
    consumption_started_ns = time.monotonic_ns()
    result = planner._consume_passive_production_events()
    record_passive_span("passive_exact_once_event_consumption", consumption_started_ns)
    return {
        "schema_version": "v7.passive-event-consumer-entrypoint.v1",
        "status": "PASS",
        "ok": True,
        "mode": "PASSIVE_EVENTS_ONLY",
        "consumer": "tools/v7-users-autoswitch._consume_passive_production_events",
        "result": result,
        "performance_timeline": {
            "schema_version": "v7.passive-event-consumer-timing.v1",
            "spans": spans,
        },
        "forbidden_effects": forbidden_effects,
    }


def consume_service_failure_automation_only(args: argparse.Namespace) -> dict[str, Any]:
    """Run only the existing planner's read-only incident advisory path."""
    forbidden = [
        name for name in ("apply", "emergency_failover_autonomy", "controlled_verifier_contention")
        if bool_value(getattr(args, name, False))
    ]
    if forbidden:
        return {
            "schema_version": "v7.service-failure-automation-entrypoint.v1",
            "status": "STOP_SAFE_FORBIDDEN_FLAGS",
            "ok": False,
            "blockers": [f"automation_advisory_forbids_{name}" for name in forbidden],
        }
    planner = AutoswitchPlanner(args)
    bounded_closure_reconciliation_started_ns = time.monotonic_ns()
    bounded_closure_reconciliation = planner.reconcile_bounded_cohort_closure_obligations()
    planner._record_performance_span(
        "advisory_bounded_closure_reconciliation",
        bounded_closure_reconciliation_started_ns,
        owner="tools/v7-users-autoswitch.reconcile_bounded_cohort_closure_obligations",
        parent="service_failure_advisory",
    )
    # ``plan()`` does not consume the preceding reconciliation result: it
    # holds the constructor's L3 snapshot and writes only its separate
    # capacity summary.  The advisory materializer must still reconcile *after*
    # planning before it reloads current scope, then once again after its
    # durable write.  Do not pay the same ~12-second execution-history scan a
    # third time before planning; surface the authoritative post-plan result
    # under the established response field for existing observers.
    plan_started_ns = time.monotonic_ns()
    plan = planner.plan()
    planner._record_performance_span(
        "advisory_plan_and_decision_construction",
        plan_started_ns,
        owner="tools/v7-users-autoswitch.AutoswitchPlanner.plan",
        parent="service_failure_advisory",
    )
    prepared_projection_started_ns = time.monotonic_ns()
    ordinary_users = [
        row for row in parse_registry(Path(args.state_dir) / "users.registry")
        if str(row.get("ip") or "") and not bool_value(row.get("certification_user"))
    ]
    ordinary_user_ips = {str(row.get("ip") or "") for row in ordinary_users}
    ordinary_user_assignments = {
        str(row.get("ip") or ""): str(row.get("current") or "")
        for row in ordinary_users
    }
    prepared_class_decisions = build_prepared_class_decision_projection(
        plan,
        ordinary_user_ips=ordinary_user_ips,
        ordinary_user_assignments=ordinary_user_assignments,
    )
    prepared_freshness = validate_prepared_class_decision_projection(
        prepared_class_decisions,
        prepared_class_decisions.get("invalidators") or {},
    )
    planner._record_performance_span(
        "advisory_prepared_decision_projection_and_validation",
        prepared_projection_started_ns,
        owner="existing prepared-class decision owner",
        parent="service_failure_advisory",
    )
    matrix_comparative_preflight = {
        "status": "NOT_REQUESTED", "ok": True,
        "routing_mutation_performed": False, "users_moved": 0,
    }
    if bool_value(getattr(args, "matrix_comparative_preflight", False)):
        selection = matrix_comparative_probe_selection(plan, prepared_freshness)
        comparison_started_ns = time.monotonic_ns()
        matrix_comparative_preflight = run_matrix_comparative_preflight(selection, args)
        planner._record_performance_span(
            "advisory_existing_matrix_subset_full_comparison",
            comparison_started_ns,
            owner="tools/v7-service-matrix-refresh-all",
            parent="service_failure_advisory",
            status="PASS" if matrix_comparative_preflight.get("ok") else "STOP_SAFE",
        )
    result = planner.materialize_service_failure_automation_advisory(plan)
    execution_outcome_reconciliation = (
        result.get("pre_obligation_scope_reconciliation")
        if isinstance(result, dict)
        and isinstance(result.get("pre_obligation_scope_reconciliation"), dict)
        else {}
    )
    return {
        "schema_version": "v7.service-failure-automation-entrypoint.v1",
        "status": "PASS",
        "ok": True,
        "mode": "INCIDENT_ADVISORY_AND_SHADOW_ONLY",
        "consumer": "tools/v7-users-autoswitch.materialize_service_failure_automation_advisory",
        "result": result,
        "prepared_class_decisions": prepared_class_decisions,
        "prepared_class_decision_freshness": prepared_freshness,
        "matrix_comparative_preflight": matrix_comparative_preflight,
        "execution_outcome_reconciliation": execution_outcome_reconciliation,
        "bounded_closure_reconciliation": bounded_closure_reconciliation,
        "performance_timeline": planner.performance_timeline(),
        "forbidden_effects": {
            "runtime_apply": False,
            "routing_mutation": False,
            "user_movement": 0,
            "packet_created": False,
            "lease_created": False,
            "authority_change": False,
            "production_maturity_change": False,
