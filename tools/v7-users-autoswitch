            "state": state,
            "reason": str(row.get("lifecycle_reason") or ""),
            "recovery_state": str(recovery.get("state") or ""),
            "recovery_path": (
                "normal_monitoring"
                if state == "TRUSTED"
                else "observe_successful_outcomes_then_restore_watch_or_trusted"
                if state in {"NEW", "WATCH", "RECOVERING"}
                else "fix_service_or_quality_issue_then_collect_recovery_evidence"
