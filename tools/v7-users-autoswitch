def controlled_campaign_execution_target_admission(
    args: argparse.Namespace,
) -> dict[str, Any]:
    """Validate one exact controlled-only target without changing Planner law."""
    request_id = str(
        getattr(args, "controlled_certification_campaign_request_id", "") or ""
    )
    request_hash = str(
        getattr(args, "controlled_certification_campaign_request_hash", "") or ""
    )
    target = str(
        getattr(args, "controlled_certification_campaign_target", "") or ""
    )
    if not request_id and not request_hash and not target:
        return {"ok": False, "active": False, "blockers": ["not_requested"]}
    blockers: list[str] = []
    status = operator_execution.controlled_certification_substrate_authority_status(
        operator_execution.read_live_execution_lineage_records(
            Path(args.action_class_audit_store)
        )
    )
    request = (
        status.get("request")
        if isinstance(status.get("request"), dict)
        else {}
    )
    scope = (
        request.get("scope")
        if isinstance(request.get("scope"), dict)
        else {}
    )
    target_contract = (
        request.get("controlled_target_contract")
        if isinstance(request.get("controlled_target_contract"), dict)
        else {}
    )
    if status.get("status") != "APPROVED":
        blockers.append("controlled_campaign_authority_not_approved")
    if str(status.get("request_id") or "") != request_id:
        blockers.append("controlled_campaign_request_id_mismatch")
    if str(status.get("request_hash") or "") != request_hash:
        blockers.append("controlled_campaign_request_hash_mismatch")
    if str(scope.get("controlled_target_id") or "") != target:
        blockers.append("controlled_campaign_target_mismatch")
    if (
        scope.get("controlled_target_admission_class")
        != "EXECUTION_ONLY_CONTROLLED_CERTIFICATION_TARGET"
    ):
        blockers.append("controlled_campaign_target_class_not_admitted")
    if str(target_contract.get("target_id") or "") != target:
        blockers.append("controlled_campaign_target_contract_mismatch")
    if target_contract.get("ordinary_production_assignment_allowed") is not False:
        blockers.append("controlled_campaign_ordinary_target_eligibility_forbidden")
    if target_contract.get("certification_only_assignment_allowed") is not True:
        blockers.append("controlled_campaign_certification_target_not_admitted")
    if str(getattr(args, "target_egress", "") or "") != target:
        blockers.append("controlled_campaign_planner_target_not_exact")
    if str(getattr(args, "source_egress", "") or "") != str(
        scope.get("source_id") or ""
    ):
        blockers.append("controlled_campaign_planner_source_not_exact")
    if not bool_value(getattr(args, "emergency_failover_autonomy", False)):
        blockers.append("controlled_campaign_emergency_path_required")
    egress_rows = [
        row for row in parse_registry(Path(args.state_dir) / "egress.registry")
        if str(row.get("id") or "") == target
    ]
    users_on_target = [
        row for row in parse_registry(Path(args.state_dir) / "users.registry")
        if str(row.get("current") or "") == target
        and bool_value(row.get("enabled", "1"))
    ]
    target_row = egress_rows[0] if len(egress_rows) == 1 else {}
    if len(egress_rows) != 1:
        blockers.append("controlled_campaign_target_not_unique")
    if users_on_target:
        blockers.append("controlled_campaign_target_not_empty_at_fresh_gate")
    if (
        str(target_row.get("role") or "").upper() != "EXECUTION_ONLY"
        or not bool_value(target_row.get("execution_reserved"))
        or not bool_value(target_row.get("canary_reserved"))
        or str(target_row.get("reservation_owner") or "")
        != "operator_execution_governance"
        or bool_value(target_row.get("autoswitch_allowed"))
        or bool_value(target_row.get("rebalance_allowed"))
        or str(target_row.get("production_assignment_allowed") or "").lower()
        not in {"0", "false", "no"}
    ):
        blockers.append("controlled_campaign_target_live_contract_changed")
    return {
        "ok": not blockers,
        "active": True,
        "blockers": sorted(set(blockers)),
        "request_id": request_id,
        "request_hash": request_hash,
        "source_id": str(scope.get("source_id") or ""),
        "target_id": target,
        "ordinary_production_eligible": False,
        "controlled_certification_only": True,
    }


class AutoswitchPlanner:
    def __init__(self, args: argparse.Namespace):
        self.args = args
        self.controlled_campaign_target_admission = (
            controlled_campaign_execution_target_admission(args)
        )
        self.operation_started_at = now_iso()
