        return {
            "schema_version": "v7.l3-certification-pipeline.v1",
            "owner": "tools/v7-users-autoswitch + OMP",
            "certification_state": "NOT_CERTIFIED_PENDING_PRODUCTION_VALIDATION",
            "checks": rows,
            "l3_certified": False,
            "requires_production_validation_ladder": validation_ladder.get("schema_version") == "v7.l3-production-validation-ladder.v1",
            "runtime_automation_enabled": False,
            "authority_expanded": False,
            "new_certification_owner_created": False,
        }

    def _l3_runtime_incident_record(
        self,
        *,
        incident_key: str,
        incident_state: str,
        key_components: dict[str, Any],
        gate: dict[str, Any],
        selected: list[dict[str, Any]],
        operation: dict[str, Any],
    ) -> dict[str, Any]:
        incidents = self.l3_runtime_state.get("incidents") if isinstance(self.l3_runtime_state.get("incidents"), dict) else {}
        existing = incidents.get(incident_key) if isinstance(incidents.get(incident_key), dict) else {}
        now = now_iso()
        same_key_exists = bool(existing)
        split_from = [
            key
            for key, row in incidents.items()
            if key != incident_key
            and isinstance(row, dict)
            and str(row.get("authority_object") or "") == "EMERGENCY_FAILOVER_AUTONOMY"
            and str(row.get("status") or "") in {"OPEN", "READY_FOR_EXECUTION", "STOP_SAFE", "SUSPENDED"}
            and set(row.get("failed_sources") or []).intersection(set(gate.get("failed_sources") or []))
        ]
        lifecycle_transition = "updated" if same_key_exists else ("split" if split_from else "opened")
        attempts = [row for row in (existing.get("attempts") or []) if isinstance(row, dict)]
        consumed_event_ids = [
            str(item)
            for item in (((gate.get("wake") or {}).get("consumed_event_ids") or []))
            if str(item)
        ]
        processed = set(str(item) for item in (self.l3_runtime_state.get("processed_event_ids") or []))
        collapsed_duplicates = [event_id for event_id in consumed_event_ids if event_id in processed]
        new_events = [event_id for event_id in consumed_event_ids if event_id not in processed]
        record_failed_sources = list(gate.get("failed_sources") or [])
        record_incident_source = str(record_failed_sources[0] if len(record_failed_sources) == 1 else "")
        return {
            "schema_version": "v7.l3-runtime-incident-record.v1",
            "incident_key": incident_key,
            "status": "READY_FOR_EXECUTION" if incident_state == "READY_FOR_EXECUTION" else ("STOP_SAFE" if incident_state == "INCIDENT_OPEN_STOP_SAFE" else incident_state),
            "incident_state": incident_state,
            "lifecycle_transition": lifecycle_transition,
            "opened_at": existing.get("opened_at") or now,
            "updated_at": now,
            "closed_at": existing.get("closed_at", ""),
            "authority_object": "EMERGENCY_FAILOVER_AUTONOMY",
            "key_components": key_components,
            "failed_sources": record_failed_sources,
            "incident_source": record_incident_source,
            "failed_required_services": list(gate.get("failed_required_services") or []),
            "selected_users": [str(move.get("user_ip") or "") for move in selected if str(move.get("user_ip") or "")],
            "target_channels": [str(move.get("recommended_egress") or "") for move in selected if str(move.get("recommended_egress") or "")],
            "operation_id": str(operation.get("operation_id") or ""),
            "selected_move_hash": str(operation.get("selected_move_hash") or ""),
            "semantic_attempt_signature": str(gate.get("semantic_attempt_signature") or ""),
            "attempts": attempts,
            "attempt_count": len(attempts),
            "retry_budget_per_incident": max(0, to_int(gate.get("retry_budget_per_incident"), 1)),
            "event_collapse": {
