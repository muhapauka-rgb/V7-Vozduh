    def _l3_production_validation_ladder(self, incident: dict[str, Any], gate: dict[str, Any]) -> dict[str, Any]:
        gate_ready = bool_value(gate.get("ok")) and str(incident.get("incident_state") or "") == "READY_FOR_EXECUTION"
        levels = [
            ("DRY_RUN", 0),
            ("ONE_USER", 1),
            ("TWO_USERS", 2),
            ("FIVE_USERS", 5),
            ("TEN_USERS", 10),
            ("REMAINING_USERS", None),
        ]
        rows: list[dict[str, Any]] = []
        for index, (name, users) in enumerate(levels):
            rows.append({
                "level": name,
                "max_users": users,
                "status": "READY_FOR_VALIDATION" if index == 0 and gate_ready else ("WAITING_FOR_PREVIOUS_LEVEL" if index > 0 else "WAITING_FOR_READY_L3_TRANSACTION"),
                "requires_verification": True,
                "requires_rollback_proof": True,
                "requires_learning": True,
                "requires_engineering_report": True,
                "requires_omp_evidence": True,
                "runtime_apply_performed_by_ladder": False,
            })
        return {
            "schema_version": "v7.l3-production-validation-ladder.v1",
            "owner": "tools/v7-users-autoswitch",
            "levels": rows,
            "current_level": rows[0]["level"],
            "current_level_status": rows[0]["status"],
            "runtime_automation_enabled": False,
            "authority_expanded": False,
            "users_moved_by_read_model": 0,
            "new_validation_owner_created": False,
        }

    def _l3_certification_pipeline(self, incident: dict[str, Any], validation_ladder: dict[str, Any]) -> dict[str, Any]:
        checks = [
            ("tests", "PASS_REQUIRED"),
            ("behavior", "PASS_REQUIRED"),
            ("verification", "PASS_REQUIRED"),
            ("rollback", "PASS_REQUIRED"),
            ("production", "PASS_REQUIRED"),
            ("learning", "PASS_REQUIRED"),
