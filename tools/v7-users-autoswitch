def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def read_json(path: Path, default: Any) -> Any:
    try:
        with path.open("r", encoding="utf-8") as fh:
            return json.load(fh)
    except FileNotFoundError:
        return default
    except json.JSONDecodeError:
        return default
    except OSError:
        return default


def normalize_authority_class(value: Any) -> str:
    name = str(value or "CANARY").strip().upper()
    return name if name in AUTHORITY_CLASS_RANK else "CANARY"


def authority_class_budget(value: Any, default: int = 1) -> int:
    authority_class = normalize_authority_class(value)
    if authority_class in AUTHORITY_CLASS_BUDGETS:
        return AUTHORITY_CLASS_BUDGETS[authority_class]
    return max(0, to_int(default, 0))


def normalize_authority_lifecycle_state(value: Any) -> str:
    name = str(value or "").strip().upper()
    return name if name in AUTHORITY_LIFECYCLE_STATES else ""


def min_authority_class(*classes: str) -> str:
    normalized = [normalize_authority_class(item) for item in classes if item]
    if not normalized:
        return "CANARY"
    return min(normalized, key=lambda item: AUTHORITY_CLASS_RANK[item])


def canonical_authority_class_for_promotion(value: Any, budget: Any = None) -> str:
    authority_class = normalize_authority_class(value)
    if authority_class == "POOL" and to_int(budget, AUTHORITY_CLASS_BUDGETS["POOL"]) <= AUTHORITY_CLASS_BUDGETS["LARGE_BATCH"]:
        return "LARGE_BATCH"
    return authority_class


def sha256_file(path: Path) -> str:
    try:
        h = hashlib.sha256()
        with path.open("rb") as fh:
            for chunk in iter(lambda: fh.read(1024 * 1024), b""):
                h.update(chunk)
        return h.hexdigest()
    except OSError:
        return ""


def sha256_json(payload: Any) -> str:
    encoded = json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def build_service_failure_adaptive_cohort_contract(
    movable: list[dict[str, Any]],
    *,
    incident_required_scope: int,
    generic_certified_scope: int,
    adapter_compatible_scope: int,
    authority_safe_scope: int,
    runtime_safe_scope: int,
    verification_safe_scope: int,
    rollback_containment_safe_scope: int,
    circuit_breaker_safe_scope: int,
    request_safe_scope: int,
    measured_at: str,
    expires_at: str = "",
) -> dict[str, Any]:
    """Project one exact Service Failure cohort through existing safety owners.

    This is a bounded projection, not a Planner or an Authority decision.  The
    input rows have already been selected by the existing Planner and carry its
    projected per-target capacity decisions.  The helper makes every numeric
    bound and the exact selected set explicit so downstream OMP/Matrix owners
    cannot silently turn a policy maximum into the actual cohort size.
    """
    unique: list[dict[str, Any]] = []
    seen_users: set[str] = set()
    exclusions: list[dict[str, str]] = []
    for row in movable:
        user = str(row.get("user_ip") or "")
        source = str(row.get("current_egress") or "")
        target = str(row.get("recommended_egress") or "")
        if not user or not source or not target or source == target:
            exclusions.append({"user_ip": user, "reason": "invalid_or_non_movement_row"})
            continue
        if user in seen_users:
            exclusions.append({"user_ip": user, "reason": "duplicate_user_identity"})
            continue
        seen_users.add(user)
        unique.append(dict(row))

    capacity_safe: list[dict[str, Any]] = []
    target_loads: dict[str, dict[str, Any]] = {}
    for row in unique:
        user = str(row.get("user_ip") or "")
        target = str(row.get("recommended_egress") or "")
        decision = row.get("capacity_decision")
        decision = decision if isinstance(decision, dict) else {}
        projected = decision.get("projected_load")
        projected = projected if isinstance(projected, dict) else {}
        hard_limit = max(0, to_int(projected.get("hard_limit"), 0))
        projected_users = max(0, to_int(projected.get("users"), 0))
        user_payload = row.get("user") if isinstance(row.get("user"), dict) else {}
        load_weight = max(1, to_int(
            row.get("capacity_weight")
            or row.get("load_weight")
            or user_payload.get("capacity_weight")
            or 1,
            1,
        ))
        reserve = max(0, to_int(
            projected.get("required_reserve")
            or projected.get("reserve_users")
            or 0,
            0,
        ))
        if hard_limit <= 0:
            exclusions.append({"user_ip": user, "reason": "capacity_bound_unknown"})
            continue
        target_state = target_loads.setdefault(target, {
            "capacity_limit": hard_limit,
            "required_reserve": reserve,
            "current_load": max(0, projected_users - 1),
            "selected_load": 0,
            "selected_users": [],
            "unit": "CAPACITY_WEIGHT_UNIT",
        })
        target_state["capacity_limit"] = min(
            int(target_state["capacity_limit"]), hard_limit,
        )
        target_state["required_reserve"] = max(
            int(target_state["required_reserve"]), reserve,
        )
        available_after_reserve = max(
            0,
            int(target_state["capacity_limit"])
            - int(target_state["required_reserve"])
            - int(target_state["current_load"]),
        )
        if int(target_state["selected_load"]) + load_weight > available_after_reserve:
            exclusions.append({"user_ip": user, "reason": "target_capacity_or_reserve_limit"})
            continue
        target_state["selected_load"] = int(target_state["selected_load"]) + load_weight
        target_state["selected_users"].append(user)
        capacity_safe.append({**row, "capacity_weight": load_weight})

    bounds_spec = {
        "incident_required_scope": (
            max(0, int(incident_required_scope)),
            "existing Service Failure incident scope owner",
            "current unresolved protection intent",
        ),
        "eligible_source_scope": (
            len(unique),
            "existing autoswitch Planner",
            "unique current-source users with a different eligible target",
        ),
        "generic_certified_scope": (
            max(0, int(generic_certified_scope)),
            "existing generic movement certification owner",
            "engineering-certified generic primitive ceiling",
        ),
        "adapter_compatible_scope": (
            max(0, int(adapter_compatible_scope)),
            "existing Service Failure adapter owner",
            "scenario bridge engineering-compatible ceiling",
        ),
        "capacity_safe_scope": (
            len(capacity_safe),
            "existing target capacity and reserve owner",
            "exact Planner rows within current per-target capacity",
        ),
        "authority_safe_scope": (
            max(0, int(authority_safe_scope)),
            operator_execution.CURRENT_ACTION_CLASS_CONTRACT_ISSUING_OWNER,
            "current independently issued Authority maximum",
        ),
        "runtime_safe_scope": (
            max(0, int(runtime_safe_scope)),
            "tools/v7-users-autoswitch._emergency_failover_policy",
            "current Runtime-enabled transaction maximum",
        ),
        "verification_safe_scope": (
            max(0, int(verification_safe_scope)),
            "existing per-user and aggregate verification owner",
            "currently qualified verification ceiling",
        ),
        "rollback_containment_safe_scope": (
            max(0, int(rollback_containment_safe_scope)),
            "existing rollback and containment owner",
            "currently qualified rollback/containment ceiling",
        ),
        "circuit_breaker_safe_scope": (
            max(0, int(circuit_breaker_safe_scope)),
            "tools/v7-users-autoswitch.apply",
            "stop-after-first-non-success cohort circuit breaker ceiling",
        ),
        "request_safe_scope": (
            max(0, int(request_safe_scope)),
            "existing Matrix/controlled-production caller",
            "exact current caller request ceiling",
        ),
    }
    bounds: dict[str, dict[str, Any]] = {}
    for name, (value, owner, reason) in bounds_spec.items():
        semantic = {"name": name, "owner": owner, "value": value, "reason": reason}
        bounds[name] = {
            **semantic,
            "fingerprint": sha256_json(semantic),
            "measured_at": measured_at,
            "expires_at": expires_at,
            "freshness": "CURRENT_GENERATION",
        }
    mandatory_values = [int(row["value"]) for row in bounds.values()]
    effective_limit = min(mandatory_values) if mandatory_values else 0
    selected = capacity_safe[:effective_limit] if effective_limit > 0 else []
    shadow_bound_names = [
        name for name in bounds
        if name != "authority_safe_scope"
    ]
    shadow_values = [int(bounds[name]["value"]) for name in shadow_bound_names]
    shadow_limit = min(shadow_values) if shadow_values else 0
    shadow_selected = capacity_safe[:shadow_limit] if shadow_limit > 0 else []
    cohort_semantic = [{
        "user_ip": str(row.get("user_ip") or ""),
        "source": str(row.get("current_egress") or ""),
        "target": str(row.get("recommended_egress") or ""),
        "capacity_weight": int(row.get("capacity_weight") or 1),
    } for row in selected]
    cohort_fingerprint = sha256_json({"members": cohort_semantic})
    limiting_bounds = sorted(
        name for name, row in bounds.items()
        if int(row["value"]) == effective_limit
    )
    return {
        "schema_version": "v7.service-failure-adaptive-cohort-contract.v1",
        "owner": "tools/v7-users-autoswitch",
        "planner_owner_reused": True,
