def in_process_client_speed_module() -> Any:
    """Load the existing exact-client probe owner once on the hot path.

    The owner, inputs and output contract remain ``v7-client-speed-api``.
    Reusing its Python module avoids a second interpreter and duplicate import
    of the already-loaded execution contracts after route visibility.
    """
    global _IN_PROCESS_CLIENT_SPEED_MODULE
    if _IN_PROCESS_CLIENT_SPEED_MODULE is not None:
        return _IN_PROCESS_CLIENT_SPEED_MODULE
    path = Path(
        shutil.which("v7-client-speed-api")
        or Path(__file__).resolve().with_name("v7-client-speed-api")
    )
    loader = importlib.machinery.SourceFileLoader(
        "v7_client_speed_runtime_owner", str(path)
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError("exact_client_probe_owner_spec_unavailable")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    _IN_PROCESS_CLIENT_SPEED_MODULE = module
    return module


def prepared_selection_planner_generation(
    stable_inputs: dict[str, Any],
) -> str:
    """Fingerprint only inputs that can change prepared target selection.

    The exact egress registry remains part of the normal Planner generation
    and every execution packet. The incident hot path has a narrower law: an
    operational ``enabled`` flip of the failed source must not invalidate the
    already selected targets. Target enabled state is rechecked live by the
    Matrix consumer before admission.
    """
    return sha256_json({
        "users_registry": str(stable_inputs.get("users_registry") or ""),
        "prepared_target_topology": str(
            stable_inputs.get("prepared_target_topology")
            or stable_inputs.get("egress_registry")
            or ""
        ),
        "service_preferences": str(
            stable_inputs.get("service_preferences") or ""
        ),
        "policy": str(stable_inputs.get("policy") or ""),
        "org_policy": str(stable_inputs.get("org_policy") or ""),
    })


