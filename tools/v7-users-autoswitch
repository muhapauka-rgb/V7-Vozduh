    def _ctr_candidate_shadow_row(self, candidate: dict[str, Any]) -> dict[str, Any]:
        simulation = candidate.get("ctr_score_simulation") if isinstance(candidate.get("ctr_score_simulation"), dict) else {}
        ctr = candidate.get("ctr_advisory") if isinstance(candidate.get("ctr_advisory"), dict) else {}
        return {
            "channel": str(candidate.get("egress") or ""),
            "eligible": bool_value(candidate.get("eligible")),
            "score": to_float(candidate.get("score"), 0.0),
            "ctr_state": str(simulation.get("ctr_state") or ctr.get("state") or "UNKNOWN").upper(),
            "soft_adjustment": to_float(simulation.get("ctr_soft_adjustment"), ctr.get("soft_adjustment", 0.0)),
            "simulated_score": to_float(simulation.get("simulated_score"), candidate.get("score", 0.0)),
            "rank_before": to_int(simulation.get("old_position"), 0),
            "rank_after": to_int(simulation.get("new_position"), 0),
            "delta": to_int(simulation.get("ranking_delta"), 0),
            "service_impact": simulation.get("service_impact") if isinstance(simulation.get("service_impact"), dict) else {},
            "capacity_impact": simulation.get("capacity_impact") if isinstance(simulation.get("capacity_impact"), dict) else {},
            "trust_impact": simulation.get("trust_impact") if isinstance(simulation.get("trust_impact"), dict) else {},
            "recovery_impact": simulation.get("recovery_impact") if isinstance(simulation.get("recovery_impact"), dict) else {},
            "best_available_pool": bool_value(candidate.get("best_available_pool")),
        }

    def _ctr_quality_delta(self, current: dict[str, Any], simulated: dict[str, Any]) -> dict[str, Any]:
        current_service = to_float((current.get("service_impact") or {}).get("aggregate_score"), 0.0)
        simulated_service = to_float((simulated.get("service_impact") or {}).get("aggregate_score"), 0.0)
        current_capacity = to_float((current.get("capacity_impact") or {}).get("capacity_score"), 0.0)
        simulated_capacity = to_float((simulated.get("capacity_impact") or {}).get("capacity_score"), 0.0)
        current_trust = to_float((current.get("trust_impact") or {}).get("trust_score"), 0.0)
        simulated_trust = to_float((simulated.get("trust_impact") or {}).get("trust_score"), 0.0)
        state_weight = {
            "TRUSTED": 3,
            "WATCH": 2,
            "NEW": 1,
            "RECOVERING": 0,
            "DEGRADED": -1,
            "QUARANTINED": -2,
            "UNKNOWN": 0,
        }
        current_state = state_weight.get(str(current.get("ctr_state") or "UNKNOWN").upper(), 0)
        simulated_state = state_weight.get(str(simulated.get("ctr_state") or "UNKNOWN").upper(), 0)
        service_delta = simulated_service - current_service
        capacity_delta = simulated_capacity - current_capacity
        trust_delta = simulated_trust - current_trust
        recovery_delta = simulated_state - current_state
        improvements = sum(1 for value in (service_delta, capacity_delta, trust_delta, recovery_delta) if value > 0)
        regressions = sum(1 for value in (service_delta, capacity_delta, trust_delta, recovery_delta) if value < 0)
        if improvements > regressions:
            verdict = "improved"
        elif regressions > improvements:
            verdict = "worsened"
        else:
            verdict = "neutral"
        return {
            "service_delta": round(service_delta, 3),
            "capacity_delta": round(capacity_delta, 3),
            "trust_delta": round(trust_delta, 3),
            "recovery_delta": recovery_delta,
            "verdict": verdict,
        }

    def _ctr_service_aware_delta(self, current: dict[str, Any], simulated: dict[str, Any]) -> dict[str, Any]:
        services = ["telegram", "youtube", "instagram", "chatgpt", "google"]
        current_service = to_float((current.get("service_impact") or {}).get("aggregate_score"), 0.0)
        simulated_service = to_float((simulated.get("service_impact") or {}).get("aggregate_score"), 0.0)
        verdict = "no_effect"
        if simulated_service > current_service:
            verdict = "improved_service_suitability"
        elif simulated_service < current_service:
            verdict = "reduced_service_suitability"
        return {
            service: {
                "verdict": verdict,
                "current_aggregate_score": round(current_service, 3),
                "simulated_aggregate_score": round(simulated_service, 3),
            }
            for service in services
        }

    def _ctr_shadow_comparison(self, decisions: list[dict[str, Any]]) -> dict[str, Any]:
        cycles: list[dict[str, Any]] = []
        stats = {
            "total_planner_cycles": len(decisions),
            "cycles_with_ranking_change": 0,
            "cycles_without_ranking_change": 0,
            "top_candidate_changes": 0,
            "top3_changes": 0,
            "pool_order_changes": 0,
            "pool_membership_changes": 0,
            "service_improvements": 0,
            "service_regressions": 0,
            "decision_quality_improvements": 0,
            "decision_quality_regressions": 0,
            "neutral_outcomes": 0,
        }
        state_analysis: dict[str, dict[str, int]] = {
            state: {"candidates": 0, "promoted": 0, "demoted": 0, "unchanged": 0}
            for state in ("TRUSTED", "WATCH", "NEW", "RECOVERING", "DEGRADED", "QUARANTINED", "UNKNOWN")
        }
        for decision in decisions:
            rows = [
                self._ctr_candidate_shadow_row(candidate)
                for candidate in (decision.get("candidates") or [])
                if isinstance(candidate, dict)
            ]
            current_ranking = sorted(rows, key=lambda row: (not row["eligible"], row["rank_before"] or 999999, -row["score"], row["channel"]))
            simulated_ranking = sorted(rows, key=lambda row: (not row["eligible"], row["rank_after"] or 999999, -row["simulated_score"], row["channel"]))
            current_channels = [row["channel"] for row in current_ranking]
            simulated_channels = [row["channel"] for row in simulated_ranking]
            current_top = current_ranking[0] if current_ranking else {}
            simulated_top = simulated_ranking[0] if simulated_ranking else {}
            current_top3 = current_channels[:3]
            simulated_top3 = simulated_channels[:3]
            current_pool = [row["channel"] for row in current_ranking if row.get("best_available_pool")]
            simulated_pool = [row["channel"] for row in simulated_ranking if row.get("best_available_pool")]
            ranking_changed = current_channels != simulated_channels
            top_changed = (current_top.get("channel") or "") != (simulated_top.get("channel") or "")
            top3_changed = current_top3 != simulated_top3
            pool_order_changed = current_pool != simulated_pool
            if ranking_changed:
                stats["cycles_with_ranking_change"] += 1
            else:
                stats["cycles_without_ranking_change"] += 1
            if top_changed:
                stats["top_candidate_changes"] += 1
            if top3_changed:
                stats["top3_changes"] += 1
            if pool_order_changed:
                stats["pool_order_changes"] += 1
            quality = {"verdict": "neutral"}
            service_aware = {}
            if top_changed and current_top and simulated_top:
                quality = self._ctr_quality_delta(current_top, simulated_top)
                service_aware = self._ctr_service_aware_delta(current_top, simulated_top)
            verdict = str(quality.get("verdict") or "neutral")
            if verdict == "improved":
                stats["decision_quality_improvements"] += 1
            elif verdict == "worsened":
                stats["decision_quality_regressions"] += 1
            else:
                stats["neutral_outcomes"] += 1
            service_verdicts = {
                str(item.get("verdict") or "no_effect")
                for item in service_aware.values()
                if isinstance(item, dict)
            }
            if "improved_service_suitability" in service_verdicts:
                stats["service_improvements"] += 1
            if "reduced_service_suitability" in service_verdicts:
                stats["service_regressions"] += 1
            for row in rows:
                state = row["ctr_state"] if row["ctr_state"] in state_analysis else "UNKNOWN"
                state_analysis[state]["candidates"] += 1
                if row["delta"] > 0:
                    state_analysis[state]["promoted"] += 1
                elif row["delta"] < 0:
                    state_analysis[state]["demoted"] += 1
                else:
                    state_analysis[state]["unchanged"] += 1
            cycles.append({
                "user_ip": str(decision.get("user_ip") or ""),
                "winner_without_ctr": current_top.get("channel", ""),
                "winner_with_ctr": simulated_top.get("channel", ""),
                "same_winner": not top_changed,
                "different_top3": top3_changed,
                "different_pool_order": pool_order_changed,
                "current_ranking": current_ranking,
                "ctr_simulated_ranking": simulated_ranking,
                "quality_delta": quality,
                "service_aware_validation": service_aware,
            })
        if stats["decision_quality_regressions"] > stats["decision_quality_improvements"]:
            influence = "HARMFUL"
            final_verdict = "CTR_NEGATIVE_VALUE"
        elif stats["decision_quality_improvements"] > 0 and stats["decision_quality_regressions"] == 0:
            influence = "USEFUL"
            final_verdict = "CTR_POSITIVE_VALUE"
        elif stats["cycles_with_ranking_change"] > 0:
            influence = "NEUTRAL"
            final_verdict = "CTR_MIXED_VALUE"
        else:
            influence = "NEUTRAL"
            final_verdict = "CTR_NO_MEANINGFUL_VALUE"
        readiness = {
            "soft_score_application": "NEEDS_MORE_DATA",
            "shadow_scoring": "READY",
            "planner_influence": "NOT_READY",
            "pool_influence": "NEEDS_MORE_DATA",
            "governance_influence": "READY",
        }
        if final_verdict == "CTR_POSITIVE_VALUE":
            readiness["soft_score_application"] = "NEEDS_MORE_DATA"
            readiness["pool_influence"] = "NEEDS_MORE_DATA"
        elif final_verdict == "CTR_NEGATIVE_VALUE":
            readiness["soft_score_application"] = "NOT_READY"
            readiness["pool_influence"] = "NOT_READY"
        return {
            "schema_version": "v7.ctr.shadow-comparison.v1",
            "mode": "dry_run_shadow_comparison_only",
            "cycles": cycles,
            "statistics": stats,
            "state_analysis": state_analysis,
            "ctr_influence_quality": influence,
            "readiness_review": readiness,
            "no_bypass": {
                "selected_moves_changed": False,
                "planner_ranking_changed": False,
                "runtime_behavior_changed": False,
                "routing_changed": False,
                "governance_authority_changed": False,
                "packet_authority_changed": False,
            },
            "final_verdict": final_verdict,
        }

    def plan(self) -> dict[str, Any]:
        enabled = bool_value(self.switch_policy.get("autoswitch_enabled"))
        target_egress = str(self.args.target_egress or "").strip()
        source_egress = str(getattr(self.args, "source_egress", "") or "").strip()
        active_product_contract = (
            self.authority_budget_policy.get("current_action_class_contract")
            if isinstance(self.authority_budget_policy.get("current_action_class_contract"), dict)
            else {}
        )
        active_product_class = str(active_product_contract.get("action_class") or "").upper()
        active_product_scope = active_product_contract.get("scope") if isinstance(active_product_contract.get("scope"), dict) else {}
        active_product_subject = active_product_contract.get("subject") if isinstance(active_product_contract.get("subject"), dict) else {}
        n10_small_cohort_context = (
            bool(active_product_contract.get("valid"))
            and active_product_class == operator_execution.N10_SMALL_COHORT_ACTION_CLASS
            and not target_egress
            and not source_egress
            and str(active_product_scope.get("target_selection") or "") == operator_execution.N10_FRESH_PLANNER_TARGET_SELECTION
        )
        n10_small_cohort_users = sorted({
            str(item).strip() for item in (active_product_subject.get("user_ips") or []) if str(item).strip()
        })
        if n10_small_cohort_context:
            source_egress = str(active_product_scope.get("source_egress") or "")
        requested_max_selected_moves = to_int(
            getattr(self.args, "max_selected_moves", 0), 0
        )
        # Read-only decomposition of the existing prepared-decision surface.
        # This does not change selection or admission; it records whether the
        # current Matrix-owned projection could have been reused at T0.
        prepared_lookup_started_ns = time.monotonic_ns()
        prepared_reuse = reuse_current_prepared_class_projection(self.args)
        prepared_lookup_completed_ns = time.monotonic_ns()
        prepared_status = str(
            prepared_reuse.get("status") or "PREPARED_CLASS_PROJECTION_UNKNOWN"
        )
        prepared_blockers = list(prepared_reuse.get("blockers") or [])
        self._prepared_decision_diagnostic = {
            "status": prepared_status,
            "lookup": "FOUND" if prepared_reuse.get("ok") else "MISS_OR_STALE",
            "prepared_target_count": len(
                ((prepared_reuse.get("prepared_class_decisions") or {}).get("hot_target_set") or {}).get("contracts") or []
            ),
            "invalidators": copy.deepcopy(
                (prepared_reuse.get("prepared_class_decisions") or {}).get("invalidators") or {}
            ),
            "blockers": prepared_blockers,
            "world_model_rebuilt": bool(prepared_reuse.get("world_model_rebuilt")),
            "runtime_behavior_changed": False,
        }
        prepared_handoff = {}
        # A one-user governed incident already names its exact source and
        # target.  Reuse the fresh Matrix-owned prepared projection directly
        # for that narrow lane; an absent or stale projection still falls
        # back to the unchanged full Planner below.
        prepared_handoff_requested = bool(
            str(getattr(self.args, "prepared_decision_handoff_file", "") or "")
            or (
                bool_value(getattr(self.args, "governed_candidate_only", False))
                and bool_value(getattr(self.args, "emergency_failover_autonomy", False))
                and bool(source_egress and target_egress and self.args.user)
                and requested_max_selected_moves == 1
            )
        )
        if prepared_handoff_requested:
            prepared_handoff = prepared_decision_handoff_for_scope(
                state_dir=Path(self.args.state_dir),
                policy_file=Path(self.args.policy_file),
                org_policy_file=Path(self.args.org_policy_file),
                safety_file=Path(self.args.safety_file),
                source=source_egress,
                target=target_egress,
            )
        self._prepared_decision_diagnostic["governed_handoff"] = copy.deepcopy(
            prepared_handoff
        )
        self._record_performance_span(
            "prepared_decision_lookup",
            prepared_lookup_started_ns,
            owner="existing Matrix/Planner prepared decision projection",
            critical_path=True,
            details={"result": self._prepared_decision_diagnostic["lookup"]},
        )
        self._record_performance_span(
            "prepared_generation_validation",
            prepared_lookup_completed_ns,
            owner="existing prepared decision freshness consumer",
            critical_path=True,
            status="PASS" if prepared_reuse.get("ok") else "STOP_SAFE",
            details={
                "status": prepared_status,
                "invalidator_count": len(
                    self._prepared_decision_diagnostic["invalidators"]
                ),
                "blockers": prepared_blockers,
            },
        )
        active = self._active_users()
        # A bounded source-specific failover must not score every unrelated
        # customer before it can construct the first eligible Candidate.  The
        # source, user and requested cap are existing planner inputs; applying
        # them before decision construction preserves target selection and all
        # Packet/lease/barrier gates while keeping unrelated cohorts out of
        # the Runtime hot path.
        if source_egress:
            active = [
                user for user in active
                if str(user.current or "") == source_egress
            ]
        if self.args.user:
            active = [user for user in active if user.ip == self.args.user]
        if n10_small_cohort_context:
            active = [user for user in active if user.ip in set(n10_small_cohort_users)]
        if source_egress and requested_max_selected_moves > 0:
            active = active[:requested_max_selected_moves]
        scope_started_ns = time.monotonic_ns()
        self._record_performance_span(
            "current_scope_validation",
            scope_started_ns,
            owner="existing source/user scope and incident binding owner",
            critical_path=True,
            details={"active_scope_count": len(active)},
        )
        prepared_execution = self._prepared_incident_execution_context(
            prepared_handoff,
        )
        self._prepared_decision_diagnostic["execution"] = copy.deepcopy(
            prepared_execution
        )
        candidate_started_ns = time.monotonic_ns()
        decisions = [
            (
                self._prepared_incident_decision_for_user(user, prepared_execution)
                if prepared_execution.get("ok")
                else self._decision_for_user(user)
            )
            for user in active
        ]
        self._record_performance_span(
            "candidate_eligibility_and_target_freshness",
            candidate_started_ns,
            owner="tools/v7-users-autoswitch.AutoswitchPlanner._decision_for_user",
            critical_path=True,
            details={
                "decision_count": len(decisions),
                "prepared_decision_reused": bool(prepared_execution.get("ok")),
                "classification": (
                    "BOUNDED_PREPARED_TARGET_EXECUTION_VALIDATION"
                    if prepared_execution.get("ok")
                    else "CURRENT_FULL_DECISION_CONSTRUCTION"
                ),
            },
        )
        selection_source = decisions
        if source_egress:
            selection_source = [
                item for item in selection_source
                if item.get("current_egress") == source_egress
            ]
        if target_egress:
            selection_source = [
                item for item in selection_source
                if item.get("recommended_egress") == target_egress and item.get("current_egress") != target_egress
            ]
        incident_source_continuity = self._l3_active_incident_source_context()
        current_action_contract = (
            self.authority_budget_policy.get("current_action_class_contract")
            if isinstance(self.authority_budget_policy.get("current_action_class_contract"), dict)
            else {}
        )
        n10_ordinary_like_context = (
            bool(current_action_contract.get("valid"))
            and str(current_action_contract.get("action_class") or "").upper()
            in {
                operator_execution.N10_ORDINARY_LIKE_SINGLE_DEVICE_ACTION_CLASS,
                operator_execution.N10_SMALL_COHORT_ACTION_CLASS,
            }
            and not str((current_action_contract.get("scope") or {}).get("target_egress") or "")
            and str((current_action_contract.get("scope") or {}).get("target_selection") or "")
            == operator_execution.N10_FRESH_PLANNER_TARGET_SELECTION
            and (
                (
                    str(current_action_contract.get("action_class") or "").upper()
                    == operator_execution.N10_SMALL_COHORT_ACTION_CLASS
                    and set(n10_small_cohort_users) == {
                        str(user.ip) for user in active
                    }
                )
                or (
                    str((current_action_contract.get("subject") or {}).get("user_ip") or "")
                    == str(getattr(self.args, "user", "") or "")
                )
            )
        )
        if (
            source_egress
            and bool_value(incident_source_continuity.get("active"))
            and str(incident_source_continuity.get("incident_source") or "") != source_egress
        ):
            requested_scope = self._l3_failed_source_scope(source_egress)
            if bool_value(requested_scope.get("source_failed")):
                incident_source_continuity = {
                    "schema_version": "v7.l3-incident-source-continuity.v1",
                    "active": True,
                    "reason": "requested_failed_source_scope",
                    "incident_key": "",
                    "incident_source": source_egress,
                    "incident_status": "OBSERVED",
                    "failed_required_services": list(requested_scope.get("required_service_failures") or []),
                    "affected_users": list(requested_scope.get("affected_users") or []),
                    "affected_users_count": to_int(requested_scope.get("affected_users_count"), 0),
                    "scope": requested_scope,
                    "continuity_source": "requested_source_egress",
                    "producer": "tools/v7-users-autoswitch.plan",
                    "consumer": "tools/v7-users-autoswitch.plan",
                    "owner": "tools/v7-users-autoswitch",
                    "overrode_incident_source": str(incident_source_continuity.get("incident_source") or ""),
                    "override_reason": "requested_source_egress_has_failed_source_scope",
                }
        if n10_ordinary_like_context:
            contract_scope = current_action_contract.get("scope") or {}
            contract_subject = current_action_contract.get("subject") or {}
            before_filter = len(selection_source)
            allowed_product_users = (
                set(n10_small_cohort_users)
                if str(current_action_contract.get("action_class") or "").upper()
                == operator_execution.N10_SMALL_COHORT_ACTION_CLASS
                else {str(contract_subject.get("user_ip") or "")}
            )
            selection_source = [
                item for item in selection_source
                if str(item.get("user_ip") or "") in allowed_product_users
                and str(item.get("current_egress") or "") == str(contract_scope.get("source_egress") or "")
                and str(item.get("recommended_egress") or "")
                and str(item.get("recommended_egress") or "") != str(item.get("current_egress") or "")
            ]
            incident_source_continuity = {
                **incident_source_continuity,
                "ordinary_like_coexistence": {
                    "active": True,
                    "action_class": str(current_action_contract.get("action_class") or ""),
                    "contract_id": str(current_action_contract.get("contract_id") or ""),
                    "selection_before_scope": before_filter,
                    "selection_after_scope": len(selection_source),
                    "law": "unrelated_active_incident_retained; exact_product_contract_uses_same_planner_and_apply_serialization",
                },
            }
        elif bool_value(incident_source_continuity.get("active")):
            incident_source = str(incident_source_continuity.get("incident_source") or "")
            affected_users = set(str(item) for item in (incident_source_continuity.get("affected_users") or []) if str(item))
            before_filter = len(selection_source)
            selection_source = [
                item for item in selection_source
                if str(item.get("current_egress") or "") == incident_source
                and (not affected_users or str(item.get("user_ip") or "") in affected_users)
            ]
            incident_source_continuity = {
                **incident_source_continuity,
                "selection_filter_applied": True,
                "selected_candidates_before_filter": before_filter,
                "selected_candidates_after_filter": len(selection_source),
                "filter_condition": "selected_move.current_egress == incident_source",
                "consumer": "tools/v7-users-autoswitch.plan",
            }
        affected_candidate_moves = sum(
            1 for item in selection_source
            if item.get("recommended_egress") and item.get("recommended_egress") != item.get("current_egress")
        )
        policy_capacity_started_ns = time.monotonic_ns()
        selected = self._select_moves(selection_source, incident_source_context=incident_source_continuity) if enabled else []
        self._record_performance_span(
            "policy_authority_and_capacity_validation",
            policy_capacity_started_ns,
            owner="existing policy/Authority/capacity owners",
            critical_path=True,
            details={
                "selected_before_authority": len(selected),
                "enabled": enabled,
                "classification": "CURRENT_SYNCHRONOUS_VALIDATION",
            },
        )
        selected_after_policy_count = len(selected)
        max_selected_moves = requested_max_selected_moves
        blast_radius_cap_applied = False
        if max_selected_moves > 0 and len(selected) > max_selected_moves:
            selected = selected[:max_selected_moves]
            blast_radius_cap_applied = True
        selected_after_request_cap_count = len(selected)
        pre_contract_selected = list(selected)
        selected, authority_budget_gate = self._authority_budget_gate(selected)
        n10_small_cohort_convergence = {}
        if n10_small_cohort_context:
            selected_users = sorted(str(move.get("user_ip") or "") for move in selected)
            selected_targets = sorted({
                str(move.get("recommended_egress") or "")
                for move in selected if str(move.get("recommended_egress") or "")
            })
            expected_users = sorted(n10_small_cohort_users)
            exact_one_target = selected_users == expected_users and len(selected_targets) == 1
            n10_small_cohort_convergence = {
                "required_members": expected_users,
                "selected_members": selected_users,
                "selected_targets": selected_targets,
                "ok": exact_one_target,
                "law": "all_exact_members_one_fresh_existing_planner_target_or_stop_safe",
            }
            if not exact_one_target:
                selected = []
                authority_budget_gate = {
                    **authority_budget_gate,
                    "valid": False,
                    "blockers": sorted(set((authority_budget_gate.get("blockers") or []) + ["n10_small_cohort_exact_members_or_single_target_missing"])),
                }
        authority_cap_applied = bool(authority_budget_gate.get("authority_cap_applied"))
        effective_cap_inputs = [
            affected_candidate_moves,
            selected_after_policy_count,
            selected_after_request_cap_count,
            to_int(authority_budget_gate.get("current_allowed_user_budget"), 1),
        ]
        if max_selected_moves > 0:
            effective_cap_inputs.append(max_selected_moves)
        effective_blast_radius = min(effective_cap_inputs) if effective_cap_inputs else 0
        if authority_cap_applied:
            blast_radius_scope = "bounded_by_authority_budget"
        elif max_selected_moves > 0 and affected_candidate_moves < max_selected_moves:
            blast_radius_scope = "bounded_by_affected_candidates"
        elif selected_after_policy_count < affected_candidate_moves:
            blast_radius_scope = "bounded_by_policy_or_capacity"
        elif max_selected_moves > 0:
            blast_radius_scope = "bounded_by_request"
        else:
            blast_radius_scope = "bounded_by_policy"
        restore_barrier = dict(self.restore_barrier)
        if n10_small_cohort_convergence:
            restore_barrier["n10_small_cohort_target_convergence"] = n10_small_cohort_convergence
        selected_moves_source = "planner_selection" if selected else "planner_no_selection"
        selected_before_restore_barrier = [
            {
                "user_ip": str(move.get("user_ip") or ""),
                "current_egress": str(move.get("current_egress") or ""),
                "recommended_egress": str(move.get("recommended_egress") or ""),
                "move_type": str(move.get("move_type") or ""),
            }
            for move in selected
        ]
        approved_plan_lock = self._approved_plan_lock_validation(restore_barrier)
        approved_identity_hash = ""
        # A completed, expired clearance is a one-use binding for its own
        # Packet.  It must never become a global, permanent prohibition on a
        # later ordinary product action.  N10 does not inherit that clearance:
        # it has its own exact one-user Authority contract and must obtain a
        # new Packet/Lease/Barrier before Apply.  Keep the historical lock in
        # the diagnostic surface, but let the existing Planner produce the
        # fresh Candidate needed by the existing Packet owner.
        # A completed clearance is scoped to the transaction that created it.
        # When the current ordinary service-failure incident is different from
        # that expired lock, let the existing Planner build a fresh packet;
        # never reuse or mutate the historical lock.
        expired_foreign_clearance_reconciliation = False
        expired_foreign_clearance_details: dict[str, Any] = {}
        ordinary_service_failure_context = (
            not n10_ordinary_like_context
            and (
                bool_value(getattr(self.args, "ordinary_service_failure_context", False))
                or not bool_value(getattr(self.args, "emergency_failover_autonomy", False))
            )
            and bool_value(incident_source_continuity.get("active"))
            and any(
                str(move.get("current_egress") or "")
                == str(incident_source_continuity.get("incident_source") or "")
                and str(move.get("recommended_egress") or "")
                and str(move.get("recommended_egress") or "")
                != str(move.get("current_egress") or "")
                for move in selected_before_restore_barrier
            )
        )
        if (
            (n10_ordinary_like_context or ordinary_service_failure_context)
            and bool_value(restore_barrier.get("expired"))
            and bool_value(restore_barrier.get("cleared"))
            and approved_plan_lock.get("present")
            and not approved_plan_lock.get("ok")
        ):
            locked_users = {
                str(item)
                for item in (approved_plan_lock.get("selected_users") or [])
                if str(item)
            }
            current_users = {
                str(item.get("user_ip") or "")
                for item in selected_before_restore_barrier
                if str(item.get("user_ip") or "")
            }
            current_source = str(incident_source_continuity.get("incident_source") or "")
            current_targets = {
                str(item.get("recommended_egress") or "")
                for item in selected_before_restore_barrier
                if str(item.get("recommended_egress") or "")
            }
            # An expired Packet clearance never remains a current decision for
            # N10.  That includes a previous, incomplete N10 attempt for the
            # same identity: the fresh one-use Authority contract below must
            # produce a new Candidate and then a new Packet/Lease/Barrier.
            # Keeping the old same-user lock as a hard planning gate would
            # turn its TTL into a permanent self-deadlock, while treating it
            # as an Apply exemption would be unsafe.  The latter is never
            # allowed: this branch is candidate-only and the fresh packet
            # barrier still rechecks every mutable source before Apply.
            lock_source = str(
                approved_plan_lock.get("source_egress")
                or approved_plan_lock.get("incident_source")
                or ""
            )
            lock_targets = {
                str(item.get("recommended_egress") or "")
                for item in (approved_plan_lock.get("selected_moves") or [])
                if str(item.get("recommended_egress") or "")
            }
            lock_is_foreign = (
                locked_users != current_users
                or (lock_source and current_source and lock_source != current_source)
                or (lock_targets and current_targets and lock_targets != current_targets)
            )
            # For N10 the expired lock is always a prior one-use transaction;
            # ordinary production may ignore it only when the live incident
            # proves a different user/source/target scope.
            if locked_users and (n10_ordinary_like_context or lock_is_foreign):
                relation = (
                    "same_identity"
                    if locked_users == current_users
                    else "different_identity"
                )
                expired_foreign_clearance_reconciliation = True
                scope_label = (
                    "n10" if n10_ordinary_like_context else "ordinary_service_failure"
                )
                expired_foreign_clearance_details = {
                    "expired_foreign_clearance_reconciled": True,
                    "expired_foreign_clearance_scope": scope_label,
                    "expired_foreign_clearance_reason": (
                        "expired_packet_lock_not_current_transaction_scope"
                    ),
                    "expired_clearance_identity_relation": relation,
                    "expired_clearance_current_users": sorted(current_users),
                    "expired_clearance_current_source": current_source,
                    "expired_clearance_current_targets": sorted(current_targets),
                    "expired_clearance_lock_source": lock_source,
                    "expired_clearance_lock_targets": sorted(lock_targets),
                    "expired_clearance_required_next_owner": (
                        "existing operator-execution Packet/Lease/Barrier owner"
                    ),
                    "expired_foreign_lock_users": sorted(locked_users),
                }
                if n10_ordinary_like_context:
                    # Preserve the established N10 diagnostic contract for
                    # existing consumers while sharing the safer generic
                    # reconciliation path.
                    expired_foreign_clearance_details.update({
                        "n10_foreign_expired_clearance_ignored": True,
                        "n10_foreign_expired_clearance_reason": (
                            "expired_packet_lock_not_current_n10_transaction"
                        ),
                        "n10_expired_clearance_identity_relation": relation,
                        "n10_required_next_owner": (
                            "existing operator-execution Packet/Lease/Barrier owner"
                        ),
                        "n10_foreign_lock_users": sorted(locked_users),
                    })
                # The historical lock remains visible in the diagnostic
                # surface; it is not a current decision and cannot replace a
                # fresh target selected from the live incident.
                approved_plan_lock = {
                    "present": False,
                    "ok": False,
                    "reason": "expired_foreign_clearance_reconciled",
                }
        if approved_plan_lock.get("present"):
            restore_barrier["approved_plan_lock_validation"] = approved_plan_lock
            if approved_plan_lock.get("ok"):
                selected = self._merge_locked_moves_with_live_decisions(approved_plan_lock["selected_moves"], decisions)
                selected_moves_source = "approved_plan_lock"
                if approved_plan_lock.get("selected_move_hash_source") == "approved_preview_packet":
                    approved_identity_hash = str(approved_plan_lock.get("selected_move_hash") or "")
                    restore_barrier["approved_preview_identity_consumed"] = True
                    selected_moves_source = "approved_preview_packet_lock"
                selected_before_restore_barrier = list(selected)
                selected_after_policy_count = len(selected)
                selected_after_request_cap_count = len(selected)
                authority_budget_gate = {
                    **authority_budget_gate,
                    "approved_plan_lock_used": True,
                    "approved_plan_lock_scope": "apply" if bool_value(getattr(self.args, "apply", False)) else "readiness_recheck",
                    "selected_moves_after_gate": len(selected),
                }
                effective_blast_radius = len(selected)
                blast_radius_scope = "approved_plan_lock_apply" if bool_value(getattr(self.args, "apply", False)) else "approved_plan_lock_readiness_recheck"
            else:
                if bool_value(getattr(self.args, "apply", False)):
                    selected = []
                    restore_barrier["clearance_guard_reason"] = str(
                        approved_plan_lock.get("reason") or "approved_plan_lock_invalid"
                    )
                else:
                    restore_barrier["approved_plan_lock_ignored_for_fresh_planning"] = True
                    restore_barrier["approved_plan_lock_ignore_reason"] = str(
                        approved_plan_lock.get("reason") or "approved_plan_lock_invalid"
                    )
        selected_hash = self._selected_moves_hash(selected)
        if approved_identity_hash and selected:
            selected_hash = approved_identity_hash
        if (
            bool_value(restore_barrier.get("expired"))
            and bool_value(restore_barrier.get("cleared"))
            and restore_barrier.get("clearance_max_selected_moves") is not None
            and not expired_foreign_clearance_reconciliation
        ):
            clearance_max_selected_moves = to_int(restore_barrier.get("clearance_max_selected_moves"), 0)
            restore_barrier["clearance_selected_moves_before_guard"] = len(selected)
            restore_barrier["clearance_selected_moves_hash"] = selected_hash
            restore_barrier["approved_candidate_moves_before_guard"] = selected_before_restore_barrier
            restore_barrier["clearance_budget_exceeded"] = len(selected) > clearance_max_selected_moves
            if restore_barrier["clearance_budget_exceeded"]:
                restore_barrier["clearance_guard_reason"] = "restore_barrier_clearance_selected_moves_exceed_budget"
                selected = []
            elif clearance_max_selected_moves > 0:
                generation_check = self._restore_clearance_generation_check(restore_barrier, selected, selected_hash)
                restore_barrier.update(generation_check)
                if not generation_check.get("clearance_generation_ok"):
                    restore_barrier["clearance_guard_reason"] = generation_check["clearance_generation_reason"]
                    selected = []
                else:
                    restore_barrier["clearance_guard_reason"] = "restore_barrier_clearance_budget_and_generation_ok"
            else:
                restore_barrier["clearance_guard_reason"] = "restore_barrier_clearance_budget_ok"
        intelligence_snapshot_gate = self._intelligence_snapshot_gate(len(selected))
        if expired_foreign_clearance_reconciliation:
            # The old lock is neither a current source of truth nor a valid
            # source-bundle lease for this new identity.  The live Planner has
            # already read the current owners, and N10 cannot apply until a
            # fresh Packet/Lease/Barrier plus the one-use contract recheck.
            # Thus the stale lock may not suppress the Candidate that the
            # existing Packet owner needs to construct that new transaction.
            # This is candidate-only deferral, never an Apply exemption.
            if (
                bool_value(intelligence_snapshot_gate.get("active"))
                and bool_value(intelligence_snapshot_gate.get("stop_required"))
            ):
                intelligence_snapshot_gate.update({
                    "stop_required_before_n10_packet_recheck": True,
                    "stop_required": False,
                    "selected_moves_suppressed": False,
                    "selected_moves_after_gate": len(selected),
                    "snapshot_gate_source": "expired_foreign_clearance_reconciliation",
                    "snapshot_gate_decision": (
                        "defer_to_fresh_packet_lease_barrier_recheck"
                    ),
                    "snapshot_gate_changed_fields": [
                        "foreign_expired_packet_clearance"
                    ],
                    "snapshot_gate_material_change": False,
                    "expired_foreign_clearance_candidate_only_deferral": True,
                    "apply_exemption": False,
                })
        elif (
            ordinary_service_failure_context
            and selected
            and bool_value(intelligence_snapshot_gate.get("active"))
            and bool_value(intelligence_snapshot_gate.get("stop_required"))
        ):
            # Intelligence/trust/prediction snapshots are advisory for a
            # current ordinary service failure.  Matrix has already proved the
            # failed source and the target's required services; the existing
            # Authority and Packet/Lease/Barrier owners still validate every
            # mutable execution fact before Apply.  Let them receive a fresh
            # candidate instead of making an unrelated stale advisory read
            # strand a user.  This is deliberately candidate-only and never
            # makes the stale snapshot an Apply exemption.
            intelligence_snapshot_gate.update({
                "stop_required_before_ordinary_service_failure_packet_recheck": True,
                "stop_required": False,
                "selected_moves_suppressed": False,
                "selected_moves_after_gate": len(selected),
                "snapshot_gate_source": "ordinary_service_failure_candidate_only_deferral",
                "snapshot_gate_decision": "defer_advisory_snapshot_to_current_governed_rechecks",
                "ordinary_service_failure_candidate_only_deferral": True,
                "apply_exemption": False,
                "mandatory_current_owners": [
                    "Matrix",
                    "Authority",
                    "Candidate/Packet/Lease/Barrier",
                    "existing route writer",
                    "required-service S11 verifier",
                ],
            })
        else:
            intelligence_snapshot_gate = (
                self._apply_source_bundle_lease_to_intelligence_gate(
                    intelligence_snapshot_gate,
                    restore_barrier,
                    approved_plan_lock,
                )
            )
        if bool_value(intelligence_snapshot_gate.get("active")) and bool_value(intelligence_snapshot_gate.get("stop_required")):
            if approved_plan_lock.get("present"):
                restore_barrier["approved_plan_lock_selected_moves_blocked"] = True
                restore_barrier["approved_plan_lock_blocker"] = "approved_plan_lock_snapshot_gate_stop_required"
                restore_barrier["approved_plan_lock_selected_moves_before_block"] = len(selected)
                restore_barrier["approved_plan_lock_selected_moves_source"] = selected_moves_source
