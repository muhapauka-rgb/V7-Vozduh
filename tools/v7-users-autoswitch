            "service_preferences": sha256_json(self.service_prefs or {}),
        }
        retry_changed_keys = sorted(key for key in after_retry_reload if before_retry_reload.get(key) != after_retry_reload.get(key))
        retry["source_reload_after_retry"] = {
            "schema": "v7.pre-planner-source-reload-after-retry.v1",
            "condition": "post_source_reload_refresh_success",
            "decision": "reload_sources_after_post_source_reload_refresh",
            "action": "reload_service_matrix_quality_summary_service_preferences",
