    def _operation_context(self, selected_hash: str, selected_count: int) -> dict[str, Any]:
        planner_generation_id = str(self.generation.get("planner_generation_id") or "")
        payload = {
            "operation_owner": "tools/v7-users-autoswitch",
            "operation_type": "runtime_autoswitch",
            "operation_started_at": self.operation_started_at,
            "planner_generation_id": planner_generation_id,
            "selected_move_hash": selected_hash,
            "selected_move_count": selected_count,
            "runtime_snapshot_hash": self._runtime_snapshot_hash(selected_hash),
        }
        payload["operation_id"] = "runtime_autoswitch_" + sha256_json(payload)[:24]
        return payload

    def _merge_locked_moves_with_live_decisions(
        self,
        locked_moves: list[dict[str, Any]],
        decisions: list[dict[str, Any]],
    ) -> list[dict[str, Any]]:
        merged: list[dict[str, Any]] = []
        for move in locked_moves:
            row = dict(move)
            exact_match = next(
                (
                    decision
                    for decision in decisions
                    if str(decision.get("user_ip") or "") == str(move.get("user_ip") or "")
                    and str(decision.get("current_egress") or "") == str(move.get("current_egress") or "")
                    and str(decision.get("recommended_egress") or "") == str(move.get("recommended_egress") or "")
                    and str(decision.get("move_type") or "") == str(move.get("move_type") or "")
                ),
                {},
            )
            source_match = exact_match or next(
                (
                    decision
                    for decision in decisions
                    if str(decision.get("user_ip") or "") == str(move.get("user_ip") or "")
                    and str(decision.get("current_egress") or "") == str(move.get("current_egress") or "")
                ),
                {},
            )
            if source_match:
                for key in SELECTED_MOVE_SEMANTIC_FIELDS:
                    if key in source_match:
                        row[key] = copy.deepcopy(source_match[key])
                row["live_decision_consumed_for_approved_lock"] = True
                row["live_decision_match_scope"] = "exact_move" if exact_match else "user_source"
            else:
                row["live_decision_consumed_for_approved_lock"] = False
            merged.append(row)
        return merged

    def _runtime_snapshot_hash(self, selected_hash: str) -> str:
        return sha256_json({
            "users_registry_hash": sha256_file(self.state_dir / "users.registry"),
            "egress_registry_hash": sha256_file(self.state_dir / "egress.registry"),
            "selected_move_hash": selected_hash,
        })

    def _committed_apply_identity_validation(
        self,
        restore_barrier: dict[str, Any],
        *,
        selected_hash: str = "",
        selected_moves: Optional[list[dict[str, Any]]] = None,
    ) -> dict[str, Any]:
        lock = restore_barrier.get("approved_plan_lock") or {}
        lock = lock if isinstance(lock, dict) else {}
        moves = selected_moves
        if moves is None:
            moves = []
            for raw in lock.get("selected_moves") or []:
                if not isinstance(raw, dict):
                    continue
                moves.append({
                    "user_ip": str(raw.get("user_ip") or ""),
                    "current_egress": str(raw.get("current_egress") or raw.get("from") or ""),
                    "recommended_egress": str(raw.get("recommended_egress") or raw.get("to") or ""),
                    "move_type": str(raw.get("move_type") or ""),
                })
        requested = {
            "packet_id": str(getattr(self.args, "approved_packet_id", "") or "").strip(),
            "operation_id": str(getattr(self.args, "approved_operation_id", "") or "").strip(),
            "selected_move_hash": str(getattr(self.args, "approved_selected_move_hash", "") or "").strip(),
            "authority_generation": str(getattr(self.args, "approved_authority_generation", "") or "").strip(),
        }
        requested = {key: value for key, value in requested.items() if value}
        if not requested:
            return {"requested": False, "ok": True, "reasons": []}

        users = sorted({str(move.get("user_ip") or "") for move in moves if str(move.get("user_ip") or "")})
        sources = sorted({str(move.get("current_egress") or "") for move in moves if str(move.get("current_egress") or "")})
        targets = sorted({str(move.get("recommended_egress") or "") for move in moves if str(move.get("recommended_egress") or "")})
        actual = {
            "packet_id": [
                str(lock.get("packet_id") or ""),
                str(restore_barrier.get("packet_id") or ""),
            ],
            "operation_id": [
                str(lock.get("operation_id") or ""),
                str(restore_barrier.get("operation_id") or ""),
            ],
            "selected_move_hash": [
                str(lock.get("selected_move_hash") or ""),
                str(restore_barrier.get("approved_selected_moves_hash") or ""),
                str(selected_hash or ""),
            ],
            "authority_generation": [
                str(lock.get("authority_generation") or ""),
                str(restore_barrier.get("clearance_generation_id") or ""),
                str(restore_barrier.get("approved_generation_id") or ""),
            ],
        }
        reasons: list[str] = []
        for key, value in requested.items():
            if value not in {item for item in actual.get(key, []) if item}:
                reasons.append(f"approved_plan_lock_committed_{key}_mismatch")

        requested_user = str(getattr(self.args, "user", "") or "").strip()
        requested_source = str(getattr(self.args, "source_egress", "") or "").strip()
        requested_target = str(getattr(self.args, "target_egress", "") or "").strip()
        if requested_user and users != [requested_user]:
            reasons.append("approved_plan_lock_user_scope_mismatch")
        if requested_source and sources != [requested_source]:
            reasons.append("approved_plan_lock_source_scope_mismatch")
        if requested_target and targets != [requested_target]:
            reasons.append("approved_plan_lock_target_scope_mismatch")

        return {
            "requested": True,
            "ok": not reasons,
            "reason": "committed_apply_identity_valid" if not reasons else "committed_apply_identity_mismatch",
            "reasons": sorted(set(reasons)),
            "requested_identity": requested,
            "actual_identity": {
                key: [item for item in values if item]
                for key, values in actual.items()
            },
            "selected_users": users,
            "selected_sources": sources,
            "selected_targets": targets,
        }

    def _approved_plan_lock_validation(self, restore_barrier: dict[str, Any]) -> dict[str, Any]:
        lock = restore_barrier.get("approved_plan_lock") or {}
        if not isinstance(lock, dict) or not lock:
            return {"present": False, "ok": False, "reason": "approved_plan_lock_missing"}
        selected = []
        for raw in lock.get("selected_moves") or []:
            if not isinstance(raw, dict):
                continue
            move = {
                "user_ip": str(raw.get("user_ip") or ""),
                "current_egress": str(raw.get("current_egress") or raw.get("from") or ""),
                "recommended_egress": str(raw.get("recommended_egress") or raw.get("to") or ""),
                "move_type": str(raw.get("move_type") or "failover"),
            }
            for key in SELECTED_MOVE_SEMANTIC_FIELDS:
                if key in raw:
                    move[key] = copy.deepcopy(raw.get(key))
            selected.append(move)
        selected = [move for move in selected if move["user_ip"] and move["current_egress"] and move["recommended_egress"]]
        structural_selected_hash = self._selected_moves_hash(selected)
        approved_identity_mode = str(lock.get("identity_source") or "") == "approved_preview_packet"
        approved_selected_hash = str(lock.get("selected_move_hash") or "")
        selected_hash = approved_selected_hash if approved_identity_mode and approved_selected_hash else structural_selected_hash
        approved_snapshot_hash = str(lock.get("snapshot_bundle_hash") or "")
        barrier_snapshot_hash = str(restore_barrier.get("approved_snapshot_bundle_hash") or "")
        allowed_users = [str(item) for item in (lock.get("allowed_users") or restore_barrier.get("allowed_users") or [])]
        allowed_targets = [str(item) for item in (lock.get("allowed_targets") or restore_barrier.get("allowed_targets") or [])]
        locked_users = [move["user_ip"] for move in selected]
        locked_targets = sorted({move["recommended_egress"] for move in selected})
        expected_count = to_int(
            lock.get("selected_move_count"),
            to_int(restore_barrier.get("clearance_expected_selected_moves"), 0),
        )
        requested_target = str(getattr(self.args, "target_egress", "") or "").strip()
        requested_user = str(getattr(self.args, "user", "") or "").strip()
        requested_source = str(getattr(self.args, "source_egress", "") or "").strip()
        reasons: list[str] = []
        if lock.get("schema_version") != "v7.approved-plan-lock.v1":
            reasons.append("approved_plan_lock_schema_invalid")
        if not selected:
            reasons.append("approved_plan_lock_selected_moves_missing")
        if expected_count != len(selected):
            reasons.append("approved_plan_lock_selected_count_mismatch")
        if not approved_identity_mode and str(lock.get("selected_move_hash") or "") != selected_hash:
            reasons.append("approved_plan_lock_selected_hash_mismatch")
        if not approved_snapshot_hash:
            reasons.append("approved_plan_lock_snapshot_missing")
        if approved_snapshot_hash and barrier_snapshot_hash and approved_snapshot_hash != barrier_snapshot_hash:
            reasons.append("approved_plan_lock_snapshot_mismatch")
        if allowed_users and sorted(allowed_users) != sorted(locked_users):
            reasons.append("approved_plan_lock_allowed_users_mismatch")
        if allowed_targets and sorted(allowed_targets) != locked_targets:
            reasons.append("approved_plan_lock_allowed_targets_mismatch")
        locked_sources = sorted({move["current_egress"] for move in selected})
        if requested_user and locked_users != [requested_user]:
            reasons.append("approved_plan_lock_user_scope_mismatch")
        if requested_source and locked_sources != [requested_source]:
            reasons.append("approved_plan_lock_source_scope_mismatch")
        if requested_target and locked_targets != [requested_target]:
            reasons.append("approved_plan_lock_target_scope_mismatch")
        controlled_verifier_scope = self._exact_controlled_verifier_scope(selected)
        availability_first_scope = (
            self._exact_availability_first_controlled_scope(selected)
        )
        incident_source_continuity = self._l3_active_incident_source_context()
        incident_source = str(incident_source_continuity.get("incident_source") or "")
        if (
            bool_value(incident_source_continuity.get("active"))
            and locked_sources != [incident_source]
            and not controlled_verifier_scope.get("ok")
            and not availability_first_scope.get("ok")
        ):
            reasons.append("approved_plan_lock_incident_source_mismatch")
        committed_identity = self._committed_apply_identity_validation(
            restore_barrier,
            selected_hash=selected_hash,
            selected_moves=selected,
        )
        if committed_identity.get("requested") and not committed_identity.get("ok"):
            reasons.extend(committed_identity.get("reasons") or [])
        if to_int(restore_barrier.get("clearance_max_selected_moves"), 0) < len(selected):
            reasons.append("approved_plan_lock_exceeds_clearance_budget")
        expires_at = str(lock.get("expires_at") or restore_barrier.get("clearance_expires_at") or "")
        if expires_at and parse_ts(expires_at) <= time.time():
            reasons.append("approved_plan_lock_expired")
        # Approved execution identity is checked against the mutable registry,
        # not the lagging diagnostic snapshot used by ordinary planning.
        users_by_ip = {user.ip: user for user in self._load_runtime_registry_users()}
        for move in selected:
            user = users_by_ip.get(move["user_ip"])
            if user is None:
                reasons.append("approved_plan_lock_user_missing")
                continue
            if not user.enabled:
                reasons.append("approved_plan_lock_user_disabled")
            if str(user.current) != move["current_egress"]:
                reasons.append("approved_plan_lock_user_source_mismatch")
        for target in locked_targets:
            egress = self.egress.get(target)
            if egress is None:
                reasons.append("approved_plan_lock_target_missing")
            elif not egress.enabled or str(egress.state).lower() in {"disabled", "down"}:
                reasons.append("approved_plan_lock_target_disabled")
        if str(lock.get("executor_may_reselect")).lower() in {"true", "1", "yes"}:
            reasons.append("approved_plan_lock_reselection_not_allowed")
        if str(lock.get("executor_may_replace_users")).lower() in {"true", "1", "yes"}:
            reasons.append("approved_plan_lock_user_replacement_not_allowed")
        if str(lock.get("executor_may_replace_targets")).lower() in {"true", "1", "yes"}:
            reasons.append("approved_plan_lock_target_replacement_not_allowed")
        if reasons:
            return {
                "present": True,
                "ok": False,
                "reason": "approved_plan_lock_invalid",
                "reasons": sorted(set(reasons)),
                "selected_move_hash": selected_hash,
                "structural_selected_move_hash": structural_selected_hash,
                "selected_move_hash_source": "approved_preview_packet" if approved_identity_mode else "selected_moves",
                "approved_selected_move_hash": str(lock.get("selected_move_hash") or ""),
                "approved_snapshot_bundle_hash": approved_snapshot_hash,
                "expected_snapshot_bundle_hash": barrier_snapshot_hash,
                "selected_users": locked_users,
                "selected_sources": locked_sources,
                "selected_targets": locked_targets,
                "committed_apply_identity": committed_identity,
                "incident_source_continuity": incident_source_continuity,
                "controlled_verifier_scope": controlled_verifier_scope,
                "availability_first_controlled_scope": (
                    availability_first_scope
                ),
            }
        return {
            "present": True,
            "ok": True,
            "reason": "approved_plan_lock_valid",
            "lock_id": str(lock.get("lock_id") or ""),
            "lock_hash": str(lock.get("lock_hash") or ""),
            "selected_move_hash": selected_hash,
            "structural_selected_move_hash": structural_selected_hash,
            "selected_move_hash_source": "approved_preview_packet" if approved_identity_mode else "selected_moves",
            "selected_move_count": len(selected),
            "approved_snapshot_bundle_hash": approved_snapshot_hash,
            "expected_snapshot_bundle_hash": barrier_snapshot_hash,
            "selected_users": locked_users,
            "selected_sources": locked_sources,
            "selected_targets": locked_targets,
            "selected_moves": selected,
            "committed_apply_identity": committed_identity,
            "incident_source_continuity": incident_source_continuity,
            "availability_first_controlled_scope": (
                availability_first_scope
            ),
        }

    def _committed_selected_moves_from_approved_plan_lock(self, plan: dict[str, Any]) -> list[dict[str, Any]]:
        safety = plan.get("safety") if isinstance(plan.get("safety"), dict) else {}
        barrier = safety.get("restore_barrier") if isinstance(safety.get("restore_barrier"), dict) else {}
        approved_lock = barrier.get("approved_plan_lock_validation") if isinstance(barrier.get("approved_plan_lock_validation"), dict) else {}
        if not approved_lock.get("present") or not bool_value(approved_lock.get("ok")):
            return []
        snapshot_gate = safety.get("intelligence_snapshots") if isinstance(safety.get("intelligence_snapshots"), dict) else {}
        if (
            bool_value(snapshot_gate.get("stop_required"))
            or bool_value(snapshot_gate.get("snapshot_gate_material_change"))
            or str(snapshot_gate.get("snapshot_gate_decision") or "") == "block_material_snapshot_change"
        ):
            return []
        selected = [copy.deepcopy(move) for move in (approved_lock.get("selected_moves") or []) if isinstance(move, dict)]
        if not selected:
            return []
        operation = plan.get("operation") if isinstance(plan.get("operation"), dict) else {}
        approved_hash = str(approved_lock.get("selected_move_hash") or "")
        operation_hash = str(operation.get("selected_move_hash") or "")
        operation_count = to_int(operation.get("selected_move_count"), 0)
        if operation_hash and operation_count and approved_hash and operation_hash != approved_hash:
            return []
        if operation_count and operation_count != len(selected):
            return []
        if approved_hash:
            operation["selected_move_hash"] = approved_hash
        operation["selected_move_count"] = len(selected)
        envelope = safety.get("atomic_execution_envelope") if isinstance(safety.get("atomic_execution_envelope"), dict) else {}
        approved_source_hashes = barrier.get("approved_source_hashes") if isinstance(barrier.get("approved_source_hashes"), dict) else {}
        if envelope:
            if approved_hash:
                envelope["selected_move_hash"] = approved_hash
                envelope["runtime_snapshot_hash"] = sha256_json({
                    "users_registry_hash": str(approved_source_hashes.get("users_registry") or ""),
                    "egress_registry_hash": str(approved_source_hashes.get("egress_registry") or ""),
                    "selected_move_hash": approved_hash,
                })
            envelope["selected_move_count"] = len(selected)
            if approved_source_hashes:
                envelope["source_bundle_hash"] = str(barrier.get("approved_source_bundle_hash") or sha256_json(approved_source_hashes))
                envelope.setdefault("source_bundle", {})["source_hashes"] = copy.deepcopy(approved_source_hashes)
            if barrier.get("approved_snapshot_bundle_hash"):
                envelope["snapshot_bundle_hash"] = str(barrier.get("approved_snapshot_bundle_hash") or "")
        for index, move in enumerate(selected):
            move.setdefault("selected_move_index", index)
            move.setdefault("operation_id", str(operation.get("operation_id") or ""))
            move.setdefault("selected_move_hash", str(operation.get("selected_move_hash") or ""))
            move.setdefault("execution_mode", "emergency_failover")
        safety["committed_selected_moves_rehydration"] = {
            "active": True,
            "source": "approved_plan_lock",
            "reason": "valid_approved_plan_lock_committed_selected_moves",
            "selected_move_count": len(selected),
            "selected_move_hash": approved_hash,
            "operation_identity_restored": True,
            "atomic_envelope_selected_identity_restored": bool(envelope),
            "owner": "tools/v7-users-autoswitch.apply",
            "new_execution_path_created": False,
        }
        return selected

    def _runtime_source_hashes(self, *, from_disk: bool = False) -> dict[str, str]:
        matrix = read_json(self.state_dir / "service-matrix.json", {"items": {}}) if from_disk else (self.matrix or {})
        quality_summary = read_json(Path(self.args.quality_summary_file), {"items": {}}) if from_disk else (self.quality_summary or {})
        service_prefs = read_json(self.state_dir / "service-preferences.json", {}) if from_disk else (self.service_prefs or {})
        return {
            "service_matrix": sha256_json(matrix or {}),
            "quality_summary": sha256_json(quality_summary or {}),
            "service_preferences": sha256_json(service_prefs or {}),
            "users_registry": sha256_file(self.state_dir / "users.registry"),
            "egress_registry": sha256_file(self.state_dir / "egress.registry"),
        }

    def _operation_scoped_source_binding(self, plan: dict[str, Any]) -> dict[str, Any]:
        selected = [
            row for row in (plan.get("selected_moves") or [])
            if isinstance(row, dict)
        ]
        if not selected:
            return {
                "schema_version": operation_scoped_binding.SCHEMA_VERSION,
                "status": "STOP_SAFE",
                "reason": "operation_scoped_binding_selected_moves_missing",
            }
        if len(selected) == 1:
            return operation_scoped_binding.read_binding(
                state_dir=self.state_dir,
                snapshot_root=self.intelligence_snapshot_root,
                selected=selected[0],
            )
        return operation_scoped_binding.read_cohort_binding(
            state_dir=self.state_dir,
            snapshot_root=self.intelligence_snapshot_root,
            selected_moves=selected,
        )

    def _snapshot_source_bundle(self) -> dict[str, Any]:
        results = (self.intelligence_snapshots or {}).get("results") or {}
        bundle: dict[str, Any] = {}
        for family in sorted(RUNTIME_INTELLIGENCE_SNAPSHOT_FAMILIES):
            result = results.get(family) or {}
            bundle[family] = {
                "source_hashes": result.get("source_hashes") or {},
                "freshness_state": result.get("freshness_state", ""),
                "runtime_behavior": result.get("runtime_behavior", ""),
                "stop_required": bool_value(result.get("stop_required")),
                "validation_ok": bool_value(result.get("validation_ok")),
            }
        return bundle

    def _atomicity_state(
        self,
        condition: str,
        *,
        trigger: str,
        evidence_path: str = "plan.safety.atomic_execution_envelope",
        mismatches: Optional[list[str]] = None,
    ) -> dict[str, Any]:
        matrix = {
            "ENVELOPE_VALID": {
                "decision": "continue_governed_execution_path",
                "action": "allow_existing_planner_packet_barrier_apply_validation",
                "blocked_actions": [],
                "next_state": "APPLY_VALIDATION",
            },
            "ENVELOPE_STALE": {
                "decision": "stop_execution",
                "action": "suppress_selected_moves_before_apply",
                "blocked_actions": ["user_movement", "autoswitch_apply", "authority_promotion"],
                "next_state": "STOPPED_STALE_ENVELOPE",
            },
            "ENVELOPE_MISMATCH": {
                "decision": "stop_execution",
                "action": "suppress_selected_moves_before_apply",
                "blocked_actions": ["user_movement", "autoswitch_apply", "authority_promotion"],
                "next_state": "STOPPED_ENVELOPE_MISMATCH",
            },
            "ENVELOPE_EXPIRED": {
                "decision": "stop_execution",
                "action": "require_fresh_approval_packet_and_restore_barrier",
                "blocked_actions": ["user_movement", "autoswitch_apply", "authority_promotion"],
                "next_state": "WAIT_FOR_FRESH_PACKET",
            },
            "SOURCE_CHANGED": {
                "decision": "stop_execution",
                "action": "refresh_replan_and_reapprove_before_apply",
                "blocked_actions": ["user_movement", "autoswitch_apply", "authority_promotion"],
                "next_state": "WAIT_FOR_ATOMIC_REPLAN",
            },
            "SOURCE_BUNDLE_LEASE_VALID": {
                "decision": "continue_governed_execution_path",
                "action": "allow_approved_source_bundle_lease_for_semantically_stable_drift",
                "blocked_actions": [],
                "next_state": "APPLY_VALIDATION",
            },
            "BARRIER_STALE": {
                "decision": "stop_execution",
                "action": "require_restore_barrier_clearance_refresh",
                "blocked_actions": ["user_movement", "autoswitch_apply", "authority_promotion"],
                "next_state": "WAIT_FOR_RESTORE_BARRIER",
            },
            "PACKET_STALE": {
                "decision": "stop_execution",
                "action": "require_fresh_approval_packet",
                "blocked_actions": ["user_movement", "autoswitch_apply", "authority_promotion"],
                "next_state": "WAIT_FOR_APPROVAL_PACKET",
            },
        }
        row = dict(matrix.get(condition) or matrix["ENVELOPE_MISMATCH"])
        return {
            "condition": condition,
            "decision": row["decision"],
            "action": row["action"],
            "executor": "tools/v7-users-autoswitch",
            "trigger": trigger,
            "written_evidence": evidence_path,
            "blocked_actions": row["blocked_actions"],
            "next_state": row["next_state"],
            "mismatches": sorted(set(mismatches or [])),
        }

    def _atomic_execution_envelope(
        self,
        selected_hash: str,
        selected_count: int,
        *,
        trigger: str = "planner_selected_moves_ready",
    ) -> dict[str, Any]:
        source_hashes = self._runtime_source_hashes()
        snapshot_bundle = self._snapshot_source_bundle()
        source_bundle_hash = sha256_json(source_hashes)
        snapshot_bundle_hash = sha256_json(snapshot_bundle)
        runtime_snapshot_hash = self._runtime_snapshot_hash(selected_hash)
        snapshot_gate = self.intelligence_snapshots or {}
        condition = "ENVELOPE_VALID"
        mismatches: list[str] = []
        if bool_value(snapshot_gate.get("stop_required")):
            mismatches = list(snapshot_gate.get("source_mismatch_families") or snapshot_gate.get("stop_families") or [])
            condition = "SOURCE_CHANGED" if snapshot_gate.get("source_mismatch_families") else "ENVELOPE_STALE"
        payload = {
            "planner_generation_id": str(self.generation.get("planner_generation_id") or ""),
            "selected_move_hash": selected_hash,
            "selected_move_count": selected_count,
            "runtime_snapshot_hash": runtime_snapshot_hash,
            "source_bundle_hash": source_bundle_hash,
            "snapshot_bundle_hash": snapshot_bundle_hash,
        }
        envelope_hash = sha256_json(payload)
        return {
            "schema_version": "v7.atomic-execution-envelope.v1",
            "envelope_id": "aee_" + envelope_hash[:24],
            "envelope_hash": envelope_hash,
            "generation_id": payload["planner_generation_id"],
            "selected_move_hash": selected_hash,
            "selected_move_count": selected_count,
            "runtime_snapshot_hash": runtime_snapshot_hash,
            "source_bundle_hash": source_bundle_hash,
            "snapshot_bundle_hash": snapshot_bundle_hash,
            "source_bundle": {
                "source_hashes": source_hashes,
                "hash": source_bundle_hash,
            },
            "snapshot_bundle": {
                "families": snapshot_bundle,
                "hash": snapshot_bundle_hash,
                "stop_required": bool_value(snapshot_gate.get("stop_required")),
                "stop_families": list(snapshot_gate.get("stop_families") or []),
                "source_mismatch_families": list(snapshot_gate.get("source_mismatch_families") or []),
            },
            "state": self._atomicity_state(condition, trigger=trigger, mismatches=mismatches),
            "authority": {
                "planner_decision_owner": "tools/v7-users-autoswitch",
                "approval_packet_owner": "admin_core/operator_execution.py",
                "restore_barrier_owner": "admin_core/operator_execution.py",
                "apply_validation_owner": "tools/v7-users-autoswitch",
                "execution_authority": "existing_governed_apply_only",
                "new_truth_source_created": False,
            },
        }

    def _validate_atomic_execution_envelope(self, plan: dict[str, Any]) -> dict[str, Any]:
        operation = plan.get("operation") or {}
        envelope = ((plan.get("safety") or {}).get("atomic_execution_envelope") or {})
        selected_hash = str(operation.get("selected_move_hash") or "")
        selected_count = to_int(operation.get("selected_move_count"), 0)
        if selected_count <= 0:
            return {
                "ok": True,
                "state": self._atomicity_state("ENVELOPE_VALID", trigger="apply_validation_no_selected_moves"),
                "reason": "no_selected_moves",
            }
        if not envelope:
            return {
                "ok": False,
                "state": self._atomicity_state("ENVELOPE_MISMATCH", trigger="apply_validation", mismatches=["atomic_execution_envelope_missing"]),
                "reason": "atomic_execution_envelope_missing",
            }
        mismatches: list[str] = []
        approved_source_hashes = ((envelope.get("source_bundle") or {}).get("source_hashes") or {})
        operation_scoped = set(approved_source_hashes) == set(operation_scoped_binding.SOURCE_KEYS)
        operation_binding = self._operation_scoped_source_binding(plan) if operation_scoped else {}
        current_source_hashes = (
            operation_binding.get("source_hashes") or {}
            if operation_scoped
            else self._runtime_source_hashes(from_disk=True)
        )
        current_source_bundle_hash = sha256_json(current_source_hashes)
        # Packet materialization binds an operation-scoped runtime snapshot to
        # the normalized source identities, not to the raw registry bytes.
        # Validate like-for-like here.  Raw/non-operation-scoped envelopes keep
        # the original byte-level registry hash below, while the source bundle
        # comparison independently remains fail-closed for semantic drift.
        current_runtime_snapshot_hash = (
            sha256_json({
                "users_registry_hash": str(current_source_hashes.get("users_registry") or ""),
                "egress_registry_hash": str(current_source_hashes.get("egress_registry") or ""),
                "selected_move_hash": selected_hash,
            })
            if operation_scoped
            else self._runtime_snapshot_hash(selected_hash)
        )
        if envelope.get("source_bundle_hash") != current_source_bundle_hash:
            mismatches.append("source_bundle_hash")
        if operation_scoped and operation_binding.get("status") != "BOUND":
            mismatches.append("mixed_generation_source_binding")
        if envelope.get("runtime_snapshot_hash") != current_runtime_snapshot_hash:
            mismatches.append("runtime_snapshot_hash")
        if envelope.get("selected_move_hash") != selected_hash:
            mismatches.append("selected_move_hash")
        if to_int(envelope.get("selected_move_count"), -1) != selected_count:
            mismatches.append("selected_move_count")
        if not mismatches:
            return {
                "ok": True,
                "state": self._atomicity_state("ENVELOPE_VALID", trigger="apply_validation"),
                "current_source_bundle_hash": current_source_bundle_hash,
                "current_runtime_snapshot_hash": current_runtime_snapshot_hash,
                "operation_scoped_binding": operation_binding if operation_scoped else {},
            }
        condition = "SOURCE_CHANGED" if "source_bundle_hash" in mismatches else "ENVELOPE_MISMATCH"
        lease = self._source_bundle_stability_lease_validation(
            plan,
            envelope,
            current_source_hashes,
            current_source_bundle_hash,
            current_runtime_snapshot_hash,
            mismatches,
            selected_count,
        )
        if lease.get("ok"):
            return lease
        return {
            "ok": False,
            "state": self._atomicity_state(condition, trigger="apply_validation", mismatches=mismatches),
            "reason": f"atomic_execution_envelope_{condition.lower()}",
            "current_source_bundle_hash": current_source_bundle_hash,
            "approved_source_bundle_hash": envelope.get("source_bundle_hash", ""),
            "current_source_hashes": current_source_hashes,
            "approved_source_hashes": ((envelope.get("source_bundle") or {}).get("source_hashes") or {}),
            "current_runtime_snapshot_hash": current_runtime_snapshot_hash,
            "approved_runtime_snapshot_hash": envelope.get("runtime_snapshot_hash", ""),
            "operation_scoped_binding": operation_binding if operation_scoped else {},
        }

    def _source_bundle_stability_lease_validation(
        self,
        plan: dict[str, Any],
        envelope: dict[str, Any],
        current_source_hashes: dict[str, str],
        current_source_bundle_hash: str,
        current_runtime_snapshot_hash: str,
        mismatches: list[str],
        selected_count: int,
    ) -> dict[str, Any]:
        safety = plan.get("safety") or {}
        barrier = safety.get("restore_barrier") or {}
        snapshot_gate = safety.get("intelligence_snapshots") or {}
        refresh = (snapshot_gate.get("pre_planner_refresh") or self.pre_planner_refresh or {})
        barrier_lease = barrier.get("source_bundle_lease") if isinstance(barrier.get("source_bundle_lease"), dict) else {}
        restore_barrier_prevalidated_lease = (
            bool_value(barrier_lease.get("ok"))
            and str(barrier.get("clearance_generation_reason") or "") == "restore_barrier_clearance_generation_match_source_bundle_lease"
        )
        prevalidated_lease_ok = bool_value(barrier_lease.get("ok")) and (
            bool_value(snapshot_gate.get("source_bundle_lease_used"))
            or restore_barrier_prevalidated_lease
        )
        approved_source_hashes = ((envelope.get("source_bundle") or {}).get("source_hashes") or {})
        changed_keys = sorted(
            key for key, approved in approved_source_hashes.items()
            if current_source_hashes.get(key) != approved
        )
        lease_scope = self._source_bundle_lease_scope(
            changed_keys,
            approved_source_hashes,
            current_source_hashes,
            selected_count=selected_count,
            selected_hash=str((plan.get("operation") or {}).get("selected_move_hash") or ""),
            approved_selected_hash=str(barrier.get("approved_selected_moves_hash") or ""),
            approved_count=to_int(barrier.get("clearance_expected_selected_moves"), selected_count),
            approved_plan_lock=barrier.get("approved_plan_lock_validation") or {},
        )
        selected_moves = plan.get("selected_moves") or []
        selected_users = sorted(str(move.get("user_ip") or "") for move in selected_moves)
        selected_targets = sorted({str(move.get("recommended_egress") or "") for move in selected_moves})
        allowed_users = sorted(str(item) for item in (barrier.get("allowed_users") or []))
        allowed_targets = sorted(str(item) for item in (barrier.get("allowed_targets") or []))
        reasons: list[str] = []
        if set(approved_source_hashes) == set(operation_scoped_binding.SOURCE_KEYS):
            reasons.append("operation_scoped_binding_requires_exact_semantic_revalidation")
        if sorted(mismatches) != ["source_bundle_hash"]:
            reasons.append("source_bundle_lease_requires_source_bundle_only_mismatch")
        if not lease_scope.get("ok"):
            reasons.append(str(lease_scope.get("reason") or "source_bundle_lease_decision_signature_unstable"))
        if current_runtime_snapshot_hash != envelope.get("runtime_snapshot_hash"):
            reasons.append("source_bundle_lease_runtime_snapshot_changed")
        if not bool_value(getattr(self.args, "apply", False)):
            reasons.append("source_bundle_lease_requires_apply")
        if not bool_value(barrier.get("expired")) or not bool_value(barrier.get("cleared")):
            reasons.append("source_bundle_lease_requires_cleared_restore_barrier")
        if bool_value(barrier.get("post_ttl_blocking")):
            reasons.append("source_bundle_lease_restore_barrier_post_ttl_blocking")
        if not bool_value(barrier.get("clearance_generation_ok")):
            reasons.append(str(barrier.get("clearance_guard_reason") or barrier.get("clearance_generation_reason") or "source_bundle_lease_requires_generation_clearance"))
        clearance_max = to_int(barrier.get("clearance_max_selected_moves"), 0)
        if clearance_max <= 0 or selected_count > clearance_max:
            reasons.append("source_bundle_lease_selected_moves_exceed_clearance_budget")
        if allowed_users:
            unapproved_users = [user for user in selected_users if user not in allowed_users]
            if unapproved_users:
                reasons.append("source_bundle_lease_unapproved_users")
        if allowed_targets:
            unapproved_targets = [target for target in selected_targets if target not in allowed_targets]
            if unapproved_targets:
                reasons.append("source_bundle_lease_unapproved_targets")
        if bool_value(snapshot_gate.get("stop_required")):
            reasons.append("source_bundle_lease_snapshot_gate_stop_required")
        if snapshot_gate.get("source_mismatch_families") and not prevalidated_lease_ok:
            reasons.append("source_bundle_lease_snapshot_source_mismatch")
        if (refresh.get("mode") != "write" or refresh.get("state") != "REFRESH_SUCCESS") and not prevalidated_lease_ok:
            reasons.append("source_bundle_lease_requires_pre_planner_refresh_success")
        refresh_result = refresh.get("refresh_result") or {}
        if refresh_result and not bool_value(refresh_result.get("source_stable")) and not prevalidated_lease_ok:
            reasons.append("source_bundle_lease_refresh_source_not_stable")
        clearance_expires_at = str(
            barrier.get("clearance_expires_at")
            or barrier.get("generation_clearance_expires_at")
            or ""
        )
        if clearance_expires_at and parse_ts(clearance_expires_at) <= time.time():
            reasons.append("source_bundle_lease_generation_clearance_expired")
        if reasons:
            return {
                "ok": False,
                "reason": "source_bundle_stability_lease_invalid",
                "lease_reasons": sorted(set(reasons)),
                "changed_source_keys": changed_keys,
                "decision_signature": lease_scope.get("decision_signature") or {},
            }
        return {
            "ok": True,
            "state": self._atomicity_state(
                "SOURCE_BUNDLE_LEASE_VALID",
                trigger="apply_validation_source_bundle_lease",
                mismatches=mismatches,
            ),
            "reason": str(lease_scope.get("reason") or "approved_source_bundle_lease_for_semantic_decision_stable_drift"),
            "source_bundle_stability_lease_used": True,
            "prevalidated_restore_barrier_lease_used": prevalidated_lease_ok,
            "allowed_source_drift": lease_scope.get("allowed_source_drift") or ["service_matrix"],
            "changed_source_keys": changed_keys,
            "current_source_bundle_hash": current_source_bundle_hash,
            "approved_source_bundle_hash": envelope.get("source_bundle_hash", ""),
            "current_source_hashes": current_source_hashes,
            "approved_source_hashes": approved_source_hashes,
            "current_runtime_snapshot_hash": current_runtime_snapshot_hash,
            "approved_runtime_snapshot_hash": envelope.get("runtime_snapshot_hash", ""),
            "decision_signature": lease_scope.get("decision_signature") or {},
            "restore_barrier_clearance": {
                "clearance_generation_ok": bool_value(barrier.get("clearance_generation_ok")),
                "clearance_max_selected_moves": clearance_max,
                "allowed_users": allowed_users,
                "allowed_targets": allowed_targets,
                "clearance_expires_at": clearance_expires_at,
            },
        }

    def _l3_execution_eligibility(self, plan: dict[str, Any]) -> dict[str, Any]:
        summary = plan.get("summary") if isinstance(plan.get("summary"), dict) else {}
        safety = plan.get("safety") if isinstance(plan.get("safety"), dict) else {}
        gate = safety.get("emergency_failover_autonomy") if isinstance(safety.get("emergency_failover_autonomy"), dict) else {}
        active = str(summary.get("execution_mode") or "") == "emergency_failover" or bool_value(gate.get("enabled"))
        if not active:
            return {"schema_version": "v7.l3-execution-eligibility.v1", "active": False, "ok": True, "blockers": []}

        operation = plan.get("operation") if isinstance(plan.get("operation"), dict) else {}
        selected = [move for move in (plan.get("selected_moves") or []) if isinstance(move, dict)]
        availability_first_scope = (
            self._exact_availability_first_controlled_scope(selected)
        )
        wake = safety.get("l3_wake") if isinstance(safety.get("l3_wake"), dict) else {}
        incident = safety.get("l3_incident") if isinstance(safety.get("l3_incident"), dict) else {}
        selected_hash = str(operation.get("selected_move_hash") or "")
        operation_id = str(operation.get("operation_id") or "")
        restore_barrier = safety.get("restore_barrier") if isinstance(safety.get("restore_barrier"), dict) else {}
        approved_lock = restore_barrier.get("approved_plan_lock_validation") if isinstance(restore_barrier.get("approved_plan_lock_validation"), dict) else {}
        clearance_max_selected_moves = to_int(restore_barrier.get("clearance_max_selected_moves"), 0)
        approved_selected_count = to_int(approved_lock.get("selected_move_count"), 0)
        approved_batch_scope = (
            bool_value(approved_lock.get("ok"))
            and clearance_max_selected_moves > 0
            and approved_selected_count > 0
        )
        approved_validation_envelope = gate.get("approved_production_validation_envelope") if isinstance(gate.get("approved_production_validation_envelope"), dict) else {}
        approved_validation_scope = approved_batch_scope and bool_value(approved_validation_envelope.get("ok"))
        max_allowed_selected = clearance_max_selected_moves if approved_batch_scope else 1
        live_users = {user.ip: user for user in self._load_users()}
        live_egress = self._load_egress()
        blockers: list[str] = []
        checked_moves: list[dict[str, Any]] = []

        if not bool_value(gate.get("ok")) and not approved_validation_scope:
            blockers.append("l3_authority_gate_not_authorized")
        if wake and not bool_value(wake.get("accepted")):
            blockers.append("l3_wake_not_accepted")
        if incident and str(incident.get("incident_state") or "") != "READY_FOR_EXECUTION" and not approved_validation_scope:
            blockers.append("l3_incident_not_ready")
        if len(selected) < 1:
            blockers.append("l3_requires_selected_move")
        elif len(selected) > max_allowed_selected:
            blockers.append("l3_selected_moves_exceed_approved_scope" if approved_batch_scope else "l3_requires_exactly_one_selected_move")
        if approved_batch_scope and len(selected) != approved_selected_count:
            blockers.append("l3_selected_move_count_mismatch")
        if not selected_hash:
            blockers.append("selected_move_hash_missing")
        if not operation_id:
            blockers.append("operation_id_missing")

        for move in selected:
            user_ip = str(move.get("user_ip") or "")
            current_id = str(move.get("current_egress") or "")
            target_id = str(move.get("recommended_egress") or "")
            move_blockers: list[str] = []
            user = live_users.get(user_ip)
            target = live_egress.get(target_id)
            source = live_egress.get(current_id)
            if str(move.get("execution_mode") or "") != "emergency_failover":
                move_blockers.append("l3_execution_mode_not_emergency_failover")
            if str(move.get("move_type") or "") != "failover":
                move_blockers.append("l3_allows_failover_only")
            if str(move.get("operation_id") or "") != operation_id:
                move_blockers.append("operation_id_mismatch")
            if str(move.get("selected_move_hash") or "") != selected_hash:
                move_blockers.append("selected_move_hash_mismatch")
            if not user or not user.enabled:
                move_blockers.append("user_not_live_or_disabled")
            elif user.current != current_id:
                move_blockers.append("source_user_state_changed_before_apply")
            if not source:
                move_blockers.append("source_channel_missing_before_apply")
            if not target:
                move_blockers.append("target_lost_before_apply")
            elif not target.enabled or str(target.state).lower() in {"disabled", "down"}:
                move_blockers.append("target_not_eligible_before_apply")
            if current_id and target_id and current_id == target_id:
                move_blockers.append("source_target_same_before_apply")
            if availability_first_scope.get("ok"):
                live_evidence = {
                    "schema_version": (
                        "v7.availability-first-live-execution-evidence.v1"
                    ),
                    "ok": True,
                    "blockers": [],
                    "event_provenance": "CONTROLLED_CERTIFICATION",
                    "natural_production_credit": False,
                    "source_failure_required": False,
                    "authority_source": (
                        "ACTIVE_STANDING_AVAILABILITY_FIRST_POLICY"
                    ),
                }
            else:
                live_evidence = self._emergency_failover_move_evidence(
                    move
                )
            if "required_service_failure_required" in (live_evidence.get("blockers") or []):
                move_blockers.append("source_recovered_before_apply")
            if "target_required_services_not_ready" in (live_evidence.get("blockers") or []):
                move_blockers.append("target_services_not_ready_before_apply")
            if "fresh_service_failure_evidence_required" in (live_evidence.get("blockers") or []):
                move_blockers.append("source_failure_evidence_not_fresh_before_apply")
            checked_moves.append({
                "user_ip": user_ip,
                "current_egress": current_id,
                "recommended_egress": target_id,
                "blockers": sorted(set(move_blockers)),
                "live_evidence_blockers": list(live_evidence.get("blockers") or []),
            })
            blockers.extend(move_blockers)

        ok = not blockers
        return {
            "schema_version": "v7.l3-execution-eligibility.v1",
            "active": True,
            "ok": ok,
            "decision": "EXECUTE" if ok else "STOP_SAFE",
            "blockers": sorted(set(blockers)),
            "checked_moves": checked_moves,
            "operation_id": operation_id,
            "selected_move_hash": selected_hash,
            "authority_generation": str(operation.get("planner_generation_id") or ""),
            "restore_generation": str(restore_barrier.get("clearance_generation_id") or restore_barrier.get("approved_generation_id") or ""),
            "approved_batch_scope": approved_batch_scope,
            "max_allowed_selected_moves": max_allowed_selected,
            "approved_selected_move_count": approved_selected_count,
            "availability_first_controlled_scope": (
                availability_first_scope
            ),
            "packet_identity_preserved": True,
            "lease_identity_preserved": True,
            "new_execution_path_created": False,
        }

    def _selected_moves_hash(self, selected: list[dict[str, Any]]) -> str:
        normalized = [
            {
                "user_ip": str(move.get("user_ip") or ""),
                "from": str(move.get("current_egress") or ""),
                "to": str(move.get("recommended_egress") or ""),
                "move_type": str(move.get("move_type") or ""),
            }
            for move in selected
        ]
        return sha256_json(normalized)

    def generate_rollback_packet_from_result(self, forward_result: dict[str, Any]) -> dict[str, Any]:
        operation = forward_result.get("operation") or {}
        apply_result = forward_result.get("apply_result") or {}
        results = apply_result.get("results") or []
        errors: list[str] = []
        if operation.get("terminal_state") != "APPLIED":
            errors.append("source_operation_not_applied")
        if not apply_result.get("applied"):
            errors.append("source_apply_result_missing")
        selected_hash = str(operation.get("selected_move_hash") or "")
        source_operation_id = str(operation.get("operation_id") or "")
        items: list[dict[str, Any]] = []
        for row in results:
            user_ip = str(row.get("user_ip") or "")
            rollback_target = str(row.get("from") or "")
            forward_target = str(row.get("to") or "")
            if row.get("rc") != 0:
                errors.append("source_move_not_successful")
                continue
            if row.get("rollback_attempted") or row.get("rollback_rc") is not None:
                errors.append("source_operation_already_rolled_back")
                continue
            if not SAFE_IP_RE.match(user_ip) or not rollback_target or not forward_target:
                errors.append("rollback_item_incomplete")
                continue
            items.append({
                "user_ip": user_ip,
                "rollback_target": rollback_target,
                "forward_target": forward_target,
                "source_operation_id": source_operation_id,
                "selected_move_hash": selected_hash,
                "selected_move_index": to_int(row.get("selected_move_index"), len(items)),
                "move_type": "rollback",
            })
        if not source_operation_id:
            errors.append("source_operation_id_missing")
        if not selected_hash:
            errors.append("selected_move_hash_missing")
        if not items:
            errors.append("rollback_items_missing")
        payload = {
            "schema_version": ROLLBACK_PACKET_SCHEMA,
            "created_at": now_iso(),
            "rollback_owner": "tools/v7-users-autoswitch",
            "source_operation": {
                "operation_id": source_operation_id,
                "operation_owner": operation.get("operation_owner", ""),
                "operation_type": operation.get("operation_type", ""),
                "planner_generation_id": operation.get("planner_generation_id", ""),
                "selected_move_hash": selected_hash,
                "selected_move_count": operation.get("selected_move_count", 0),
                "runtime_snapshot_hash": operation.get("runtime_snapshot_hash", ""),
                "terminal_state": operation.get("terminal_state", ""),
                "terminal_reason": operation.get("terminal_reason", ""),
            },
            "constraints": {
                "max_rollback_users": len(items),
                "allowed_users": [item["user_ip"] for item in items],
                "allowed_targets": sorted({item["rollback_target"] for item in items}),
                "autoswitch_apply_required": True,
                "planner_override_allowed": False,
                "policy_override_allowed": False,
                "routing_mutation_allowed": False,
            },
            "items": items,
        }
        payload["rollback_packet_id"] = "rbpkt_" + sha256_json({
            "source_operation": payload["source_operation"],
            "items": items,
        })[:24]
        return {
            "schema_version": ROLLBACK_PACKET_SCHEMA,
            "mode": "generate_rollback_packet",
            "execution_allowed_now": False,
            "validation_errors": sorted(set(errors)),
            "packet": payload,
        }

    def write_rollback_packet_from_result(self, forward_result_path: Path, output_path: Path) -> dict[str, Any]:
        forward_result = read_json(forward_result_path, {})
        result = self.generate_rollback_packet_from_result(forward_result if isinstance(forward_result, dict) else {})
        if not result.get("validation_errors"):
            write_json_atomic(output_path, result["packet"])
            result["packet_path"] = str(output_path)
        return result

    def _validate_rollback_packet(self, packet: dict[str, Any]) -> list[str]:
        errors: list[str] = []
        if packet.get("schema_version") != ROLLBACK_PACKET_SCHEMA:
            errors.append("schema_version_invalid")
        if packet.get("rollback_owner") != "tools/v7-users-autoswitch":
            errors.append("rollback_owner_invalid")
        source = packet.get("source_operation") or {}
        source_operation_id = str(source.get("operation_id") or "")
        selected_hash = str(source.get("selected_move_hash") or "")
        if not source_operation_id:
            errors.append("source_operation_id_missing")
        if not selected_hash:
            errors.append("selected_move_hash_missing")
        items = packet.get("items") or []
        constraints = packet.get("constraints") or {}
        max_users = to_int(constraints.get("max_rollback_users"), 0)
        if not items:
            errors.append("rollback_items_missing")
        if max_users <= 0 or len(items) > max_users:
            errors.append("rollback_budget_invalid")
        user_state = {user.ip: user.current for user in self.users}
        for item in items:
            user_ip = str(item.get("user_ip") or "")
            rollback_target = str(item.get("rollback_target") or "")
            forward_target = str(item.get("forward_target") or "")
            if not SAFE_IP_RE.match(user_ip):
                errors.append("rollback_user_invalid")
            if item.get("source_operation_id") != source_operation_id:
                errors.append("rollback_source_operation_mismatch")
            if item.get("selected_move_hash") != selected_hash:
                errors.append("rollback_selected_move_hash_mismatch")
            if user_ip not in user_state:
                errors.append("rollback_user_missing")
            elif user_state[user_ip] != forward_target:
                errors.append("rollback_user_not_on_forward_target")
            if rollback_target not in self.egress:
                errors.append("rollback_target_missing")
            if forward_target not in self.egress:
                errors.append("forward_target_missing")
        return sorted(set(errors))

    def execute_rollback_packet(self, packet_path: Path) -> dict[str, Any]:
        packet = read_json(packet_path, {})
        if not isinstance(packet, dict):
            packet = {}
        source = packet.get("source_operation") or {}
        items = packet.get("items") or []
        errors = self._validate_rollback_packet(packet)
        created_at = now_iso()
        operation_payload = {
            "operation_owner": "tools/v7-users-autoswitch",
            "operation_type": "runtime_autoswitch_rollback",
            "operation_started_at": created_at,
            "source_operation_id": source.get("operation_id", ""),
            "selected_move_hash": source.get("selected_move_hash", ""),
            "rollback_packet_id": packet.get("rollback_packet_id", ""),
            "rollback_count": len(items),
        }
        operation_payload["operation_id"] = "runtime_rollback_" + sha256_json(operation_payload)[:24]
        control = self._execution_control_decision(
            mutation_kind="rollback",
            action_class="USER_SWITCH",
            expected_generation=str(getattr(self.args, "approved_breaker_generation", "") or ""),
            rollback_certified=not errors,
            operation_id=str(source.get("operation_id") or ""),
        )
        if not control.get("rollback_only_allowed"):
            errors.append("autonomous_execution_control_rollback_denied")
        operation_payload["execution_control"] = control
        results: list[dict[str, Any]] = []
        if errors:
            operation_payload.update({
                "terminal_state": "ROLLBACK_DENIED",
                "terminal_reason": "rollback_packet_invalid",
            })
            rollback_result = {"applied": False, "reason": "rollback_packet_invalid", "errors": errors}
        elif not self.args.apply:
            operation_payload.update({
                "terminal_state": "ROLLBACK_DRY_RUN",
                "terminal_reason": "rollback_packet_valid",
            })
            rollback_result = {"applied": False, "reason": "dry_run", "results": []}
        else:
            rollback_control_denied = False
            for item in items:
                item_control = self._execution_control_decision(
                    mutation_kind="rollback",
                    action_class="USER_SWITCH",
                    expected_generation=str(control.get("generation") or ""),
                    rollback_certified=True,
                    operation_id=str(source.get("operation_id") or ""),
                )
                if not item_control.get("rollback_only_allowed"):
                    operation_payload.update({"terminal_state": "ROLLBACK_DENIED", "terminal_reason": "execution_control_changed"})
                    rollback_control_denied = True
                    break
                self._active_execution_control = item_control
                ip = str(item.get("user_ip") or "")
                forward_target = str(item.get("forward_target") or "")
                rollback_target = str(item.get("rollback_target") or "")
                proc = self._run_switch(ip, rollback_target, "rollback")
                row = {
                    "user_ip": ip,
                    "from": forward_target,
                    "to": rollback_target,
                    "move_type": "rollback",
                    "operation_id": operation_payload["operation_id"],
                    "source_operation_id": source.get("operation_id", ""),
                    "selected_move_hash": source.get("selected_move_hash", ""),
                    "selected_move_index": item.get("selected_move_index"),
                    "rc": proc.returncode,
                    "output": proc.stdout[-4000:],
                    "rollback_attempted": True,
                    "rollback_rc": proc.returncode,
                    "rollback_output": proc.stdout[-4000:],
                    "rollback_result": "OK" if proc.returncode == 0 else "FAIL",
                    "rollback_verdict": "ROLLBACK_COMPLETED" if proc.returncode == 0 else "ROLLBACK_FAILED",
                }
                if proc.returncode == 0 and self.args.verify:
                    verify = self._verify_routes()
                    row["verify_rc"] = verify.returncode
                    row["verify_output"] = verify.stdout[-4000:]
                results.append(row)
            self._update_safety_after_apply(results)
            if rollback_control_denied:
                terminal_state = "ROLLBACK_DENIED"
                terminal_reason = "execution_control_changed"
            elif any(row.get("rc") != 0 for row in results):
                terminal_state = "ROLLBACK_FAILED"
                terminal_reason = "rollback_switch_command_failed"
            elif any(row.get("verify_rc") not in (None, 0) for row in results):
                terminal_state = "ROLLBACK_VERIFY_FAILED"
                terminal_reason = "rollback_route_verify_failed"
            else:
                terminal_state = "ROLLBACK_COMPLETED"
                terminal_reason = "operation_scoped_rollback_completed"
            operation_payload.update({
                "terminal_state": terminal_state,
                "terminal_reason": terminal_reason,
                "rollback_verdict": terminal_state,
            })
            rollback_result = {"applied": bool(results), "results": results}
        audit = self._rollback_audit_reference(operation_payload, packet, rollback_result)
        if self.args.apply:
            audit = self._emit_terminal_audit(audit)
        closure = self._closure_target(operation_payload, audit)
        return {
            "schema_version": 1,
            "mode": "rollback",
            "apply_requested": bool(self.args.apply),
            "packet_path": str(packet_path),
            "rollback_packet": packet,
            "operation": operation_payload,
            "rollback_result": rollback_result,
            "audit": audit,
            "closure_target": closure,
        }

    def _restore_clearance_generation_check(
        self,
        restore_barrier: dict[str, Any],
        selected: list[dict[str, Any]],
        selected_hash: str,
    ) -> dict[str, Any]:
        current_generation = str(self.generation.get("planner_generation_id") or "")
        approved_generation = str(
            restore_barrier.get("clearance_generation_id")
            or restore_barrier.get("approved_generation_id")
            or restore_barrier.get("planner_generation_id")
            or restore_barrier.get("selected_moves_generation")
            or ""
        )
        approved_hash = str(
            restore_barrier.get("approved_selected_moves_hash")
            or ""
        )
        approved_envelope_id = str(restore_barrier.get("approved_atomic_execution_envelope_id") or "")
        approved_envelope_hash = str(restore_barrier.get("approved_atomic_execution_envelope_hash") or "")
        approved_source_bundle_hash = str(restore_barrier.get("approved_source_bundle_hash") or "")
        approved_snapshot_bundle_hash = str(restore_barrier.get("approved_snapshot_bundle_hash") or "")
        approved_source_hashes = restore_barrier.get("approved_source_hashes") or {}
        expected_count = None
        if "clearance_expected_selected_moves" in restore_barrier:
            expected_count = to_int(restore_barrier.get("clearance_expected_selected_moves"), 0)
        elif "approved_selected_moves_count" in restore_barrier:
            expected_count = to_int(restore_barrier.get("approved_selected_moves_count"), 0)
        expires_at = str(
            restore_barrier.get("generation_clearance_expires_at")
            or restore_barrier.get("clearance_expires_at")
            or ""
        )
        token = str(restore_barrier.get("generation_token") or "")
        if not token:
            return {
                "clearance_generation_ok": False,
                "clearance_generation_reason": "restore_barrier_clearance_generation_token_missing",
                "current_generation_id": current_generation,
                "approved_generation_id": approved_generation,
            }
        if expires_at and parse_ts(expires_at) <= time.time():
            return {
                "clearance_generation_ok": False,
                "clearance_generation_reason": "restore_barrier_clearance_generation_expired",
                "current_generation_id": current_generation,
                "approved_generation_id": approved_generation,
                "clearance_expires_at": expires_at,
            }
        if not approved_generation or approved_generation != current_generation:
            approved_lock = restore_barrier.get("approved_plan_lock_validation") or {}
            preview_identity_lock = (
                bool_value(approved_lock.get("ok"))
                and str(approved_lock.get("selected_move_hash_source") or "") == "approved_preview_packet"
            )
            if not preview_identity_lock:
                return {
                    "clearance_generation_ok": False,
                    "clearance_generation_reason": "restore_barrier_clearance_generation_mismatch",
                    "current_generation_id": current_generation,
                    "approved_generation_id": approved_generation,
                }
        if approved_hash and approved_hash != selected_hash:
            return {
                "clearance_generation_ok": False,
                "clearance_generation_reason": "restore_barrier_clearance_selected_moves_hash_mismatch",
                "current_generation_id": current_generation,
                "approved_generation_id": approved_generation,
                "approved_selected_moves_hash": approved_hash,
                "current_selected_moves_hash": selected_hash,
            }
        if expected_count is not None and expected_count != len(selected):
            return {
                "clearance_generation_ok": False,
                "clearance_generation_reason": "restore_barrier_clearance_selected_moves_count_mismatch",
                "current_generation_id": current_generation,
                "approved_generation_id": approved_generation,
                "approved_selected_moves_count": expected_count,
                "current_selected_moves_count": len(selected),
            }
        approved_lock = restore_barrier.get("approved_plan_lock_validation") or {}
        preview_identity_lock = (
            bool_value(approved_lock.get("ok"))
            and str(approved_lock.get("selected_move_hash_source") or "") == "approved_preview_packet"
        )
        if preview_identity_lock:
            return {
                "clearance_generation_ok": True,
                "clearance_generation_reason": "restore_barrier_clearance_preview_packet_identity_match",
                "current_generation_id": current_generation,
                "approved_generation_id": approved_generation,
                "current_selected_moves_hash": selected_hash,
                "approved_selected_moves_hash": approved_hash or selected_hash,
                "current_selected_moves_count": len(selected),
                "approved_selected_moves_count": expected_count if expected_count is not None else len(selected),
                "approved_plan_lock_identity_source": "approved_preview_packet",
            }
        operation_scoped = (
            isinstance(approved_source_hashes, dict)
            and set(approved_source_hashes) == set(operation_scoped_binding.SOURCE_KEYS)
        )
        if operation_scoped:
            if not selected:
                return {
                    "clearance_generation_ok": False,
                    "clearance_generation_reason": "restore_barrier_operation_scoped_binding_selected_moves_missing",
                    "current_selected_moves_count": 0,
                }
            if len(selected) == 1:
                binding = operation_scoped_binding.read_binding(
                    state_dir=self.state_dir,
                    snapshot_root=self.intelligence_snapshot_root,
                    selected=selected[0],
                )
            else:
                binding = operation_scoped_binding.read_cohort_binding(
                    state_dir=self.state_dir,
                    snapshot_root=self.intelligence_snapshot_root,
                    selected_moves=selected,
                )
            binding_reasons = []
            if binding.get("status") != "BOUND":
                binding_reasons.append("operation_scoped_binding_not_bound")
            if dict(binding.get("source_hashes") or {}) != dict(approved_source_hashes):
                binding_reasons.append("operation_scoped_source_hashes_mismatch")
            if str(binding.get("source_bundle_hash") or "") != approved_source_bundle_hash:
                binding_reasons.append("operation_scoped_source_bundle_hash_mismatch")
            if str(binding.get("snapshot_bundle_hash") or "") != approved_snapshot_bundle_hash:
                binding_reasons.append("operation_scoped_snapshot_bundle_hash_mismatch")
            if binding_reasons:
                return {
                    "clearance_generation_ok": False,
                    "clearance_generation_reason": "restore_barrier_operation_scoped_binding_mismatch",
                    "operation_scoped_binding_reasons": binding_reasons,
                    "operation_scoped_binding": binding,
                }
            return {
                "clearance_generation_ok": True,
                "clearance_generation_reason": "restore_barrier_clearance_operation_scoped_binding_match",
                "current_generation_id": current_generation,
                "approved_generation_id": approved_generation,
                "current_selected_moves_hash": selected_hash,
                "approved_selected_moves_hash": approved_hash or selected_hash,
                "current_selected_moves_count": len(selected),
                "approved_selected_moves_count": expected_count if expected_count is not None else len(selected),
                "approved_atomic_execution_envelope_id": approved_envelope_id,
                "approved_atomic_execution_envelope_hash": approved_envelope_hash,
                "operation_scoped_binding": binding,
            }
        current_envelope = self._atomic_execution_envelope(
            selected_hash,
            len(selected),
            trigger="restore_barrier_generation_clearance_check",
        )
        envelope_source_lease = self._restore_barrier_source_bundle_lease(
            restore_barrier,
            current_envelope,
        )
        if (
            approved_envelope_id
            and approved_envelope_id != current_envelope.get("envelope_id")
            and not envelope_source_lease.get("ok")
        ):
            return {
                "clearance_generation_ok": False,
                "clearance_generation_reason": "restore_barrier_clearance_atomic_envelope_id_mismatch",
                "current_generation_id": current_generation,
                "approved_generation_id": approved_generation,
                "approved_atomic_execution_envelope_id": approved_envelope_id,
                "current_atomic_execution_envelope_id": current_envelope.get("envelope_id", ""),
                "source_bundle_lease": envelope_source_lease,
            }
        if (
            approved_envelope_hash
            and approved_envelope_hash != current_envelope.get("envelope_hash")
            and not envelope_source_lease.get("ok")
        ):
            return {
                "clearance_generation_ok": False,
                "clearance_generation_reason": "restore_barrier_clearance_atomic_envelope_hash_mismatch",
                "current_generation_id": current_generation,
                "approved_generation_id": approved_generation,
                "approved_atomic_execution_envelope_hash": approved_envelope_hash,
                "current_atomic_execution_envelope_hash": current_envelope.get("envelope_hash", ""),
                "source_bundle_lease": envelope_source_lease,
            }
        if (
            approved_source_bundle_hash
            and approved_source_bundle_hash != current_envelope.get("source_bundle_hash")
            and not envelope_source_lease.get("ok")
        ):
            return {
                "clearance_generation_ok": False,
                "clearance_generation_reason": "restore_barrier_clearance_source_bundle_hash_mismatch",
                "current_generation_id": current_generation,
                "approved_generation_id": approved_generation,
                "approved_source_bundle_hash": approved_source_bundle_hash,
                "current_source_bundle_hash": current_envelope.get("source_bundle_hash", ""),
                "source_bundle_lease": envelope_source_lease,
            }
        reason = "restore_barrier_clearance_generation_match"
        if envelope_source_lease.get("ok"):
            reason = "restore_barrier_clearance_generation_match_source_bundle_lease"
        return {
            "clearance_generation_ok": True,
            "clearance_generation_reason": reason,
            "current_generation_id": current_generation,
            "approved_generation_id": approved_generation,
            "current_selected_moves_hash": selected_hash,
            "approved_selected_moves_hash": approved_hash or selected_hash,
            "current_selected_moves_count": len(selected),
            "approved_selected_moves_count": expected_count if expected_count is not None else len(selected),
            "current_atomic_execution_envelope_id": current_envelope.get("envelope_id", ""),
            "approved_atomic_execution_envelope_id": approved_envelope_id or current_envelope.get("envelope_id", ""),
            "current_atomic_execution_envelope_hash": current_envelope.get("envelope_hash", ""),
            "approved_atomic_execution_envelope_hash": approved_envelope_hash or current_envelope.get("envelope_hash", ""),
            "current_source_bundle_hash": current_envelope.get("source_bundle_hash", ""),
            "approved_source_bundle_hash": approved_source_bundle_hash or current_envelope.get("source_bundle_hash", ""),
            "source_bundle_lease": envelope_source_lease,
        }

    def _restore_barrier_source_bundle_lease(
        self,
        restore_barrier: dict[str, Any],
        current_envelope: dict[str, Any],
    ) -> dict[str, Any]:
        approved_hashes = restore_barrier.get("approved_source_hashes") or {}
        if not isinstance(approved_hashes, dict) or not approved_hashes:
            return {"ok": False, "reason": "approved_source_hashes_missing"}
        current_hashes = ((current_envelope.get("source_bundle") or {}).get("source_hashes") or {})
        changed_keys = sorted(
            str(key) for key, approved in approved_hashes.items()
            if str(current_hashes.get(key) or "") != str(approved or "")
        )
        expected_count = to_int(restore_barrier.get("clearance_expected_selected_moves"), to_int(current_envelope.get("selected_move_count"), 0))
        lease_scope = self._source_bundle_lease_scope(
            changed_keys,
            approved_hashes,
            current_hashes,
            selected_count=to_int(current_envelope.get("selected_move_count"), 0),
            selected_hash=str(current_envelope.get("selected_move_hash") or ""),
            approved_selected_hash=str(restore_barrier.get("approved_selected_moves_hash") or ""),
            approved_count=expected_count,
            approved_plan_lock=restore_barrier.get("approved_plan_lock_validation") or {},
        )
        if lease_scope.get("ok"):
            return {
                "ok": True,
                "reason": lease_scope.get("reason"),
                "allowed_source_drift": lease_scope.get("allowed_source_drift") or ["service_matrix"],
                "changed_source_keys": changed_keys,
                "approved_source_hashes": approved_hashes,
                "current_source_hashes": current_hashes,
                "decision_signature": lease_scope.get("decision_signature") or {},
            }
        return {
            "ok": False,
            "reason": lease_scope.get("reason") or "restore_barrier_source_bundle_lease_hard_source_changed",
            "reasons": lease_scope.get("reasons") or [],
            "changed_source_keys": changed_keys,
            "approved_source_hashes": approved_hashes,
            "current_source_hashes": current_hashes,
            "decision_signature": lease_scope.get("decision_signature") or {},
        }

    def _source_bundle_lease_scope(
        self,
        changed_keys: list[str],
        approved_hashes: dict[str, str],
        current_hashes: dict[str, str],
        *,
        selected_count: int,
        selected_hash: str,
        approved_selected_hash: str,
        approved_count: int,
        approved_plan_lock: dict[str, Any],
    ) -> dict[str, Any]:
        allowed_semantic_drift = {"quality_summary", "service_matrix"}
        strict_keys = {"egress_registry", "service_preferences", "users_registry"}
        changed = {str(key) for key in changed_keys}
        decision_signature = {
            "schema_version": "v7.source-bundle-decision-signature.v1",
            "selected_move_hash": selected_hash,
            "approved_selected_move_hash": approved_selected_hash,
            "selected_move_count": selected_count,
            "approved_selected_move_count": approved_count,
            "selected_users": list(approved_plan_lock.get("selected_users") or []),
            "selected_targets": list(approved_plan_lock.get("selected_targets") or []),
            "strict_source_hashes": {
                key: str(current_hashes.get(key) or "")
                for key in sorted(strict_keys)
            },
            "approved_strict_source_hashes": {
                key: str(approved_hashes.get(key) or "")
                for key in sorted(strict_keys)
            },
        }
        if not changed:
            return {
                "ok": True,
                "reason": "restore_barrier_source_bundle_lease_hard_sources_stable",
                "allowed_source_drift": ["service_matrix"],
                "decision_signature": decision_signature,
            }
        if changed == {"service_matrix"}:
            return {
                "ok": True,
                "reason": "restore_barrier_source_bundle_lease_service_matrix_only",
                "allowed_source_drift": ["service_matrix"],
                "decision_signature": decision_signature,
            }
        reasons: list[str] = []
        if not changed.issubset(allowed_semantic_drift):
            reasons.append("source_bundle_lease_disallowed_source_changed")
        if strict_keys & changed:
            reasons.append("source_bundle_lease_strict_source_changed")
        if selected_hash != approved_selected_hash:
            reasons.append("source_bundle_lease_selected_hash_changed")
        if selected_count != approved_count:
            reasons.append("source_bundle_lease_selected_count_changed")
        if not bool_value(approved_plan_lock.get("ok")):
            reasons.append("source_bundle_lease_requires_valid_approved_plan_lock")
        if reasons:
            return {
                "ok": False,
                "reason": "restore_barrier_source_bundle_lease_decision_signature_unstable",
                "reasons": sorted(set(reasons)),
                "allowed_source_drift": sorted(allowed_semantic_drift),
                "decision_signature": decision_signature,
            }
        return {
            "ok": True,
            "reason": "restore_barrier_source_bundle_lease_semantic_decision_stable",
            "allowed_source_drift": sorted(allowed_semantic_drift),
            "decision_signature": decision_signature,
        }

    def _org_isolation_summary(self) -> dict[str, Any]:
        groups: dict[str, Any] = {}
        for user in self.users:
            if not user.enabled:
                continue
            row = groups.setdefault(user.group, {"users": 0, "current_egress": {}, "policy": self._group_policy(user.group)})
            row["users"] += 1
            row["current_egress"][user.current] = row["current_egress"].get(user.current, 0) + 1
        return {"groups": groups, "egress_group_usage": {k: sorted(v) for k, v in self.group_usage.items()}}

    def _decision_for_user(self, user: User) -> dict[str, Any]:
        important = self._important_services(user)
        route_class = self.args.route_class or self._route_class_for_services(important)
        candidates = [self._candidate(user, egress, important, route_class, purpose="planned") for egress in self.egress.values()]
        candidates.sort(key=lambda c: (c.eligible, c.score), reverse=True)
        self._mark_best_available_pool(candidates)
        self._attach_ctr_score_simulation(candidates)
        current = self._candidate(user, self.egress[user.current], important, route_class, purpose="current") if user.current in self.egress else None
        best = next((c for c in candidates if c.eligible), None)
        action = "keep"
        reason: list[str] = []
        recommended = user.current
        recommended_score = current.score if current else None
        move_type = "none"

        cooldown_ok, cooldown_reason = self._cooldown_ok(user)
        if cooldown_reason:
            reason.append(cooldown_reason)
        frozen, freeze_reason = self._user_frozen(user)
        if freeze_reason:
            reason.append(freeze_reason)
        l3_cooldown_override = self._l3_failed_source_cooldown_override_context(user.ip, user.current)
        l3_failover_cooldown_ok = cooldown_ok or bool_value(l3_cooldown_override.get("allowed"))

        if current and current.egress.canary_reserved and current.eligible:
            reason.append("canary_reserved_current_hold_requires_separate_drain_approval")
        elif not current or not current.eligible:
            service_signal_restore_gate = (
                current
                and self._service_signal_only_block(current)
                and bool_value(self.service_signal_policy.get("restore_stage"))
                and not bool_value(self.service_signal_policy.get("apply_restore_approved"))
            )
            if service_signal_restore_gate:
                reason.append("restore_stage_service_signal_failover_requires_approval")
            else:
                failover_candidates = [self._candidate(user, egress, important, route_class, purpose="failover") for egress in self.egress.values()]
                failover_candidates.sort(key=lambda c: (c.eligible, c.score), reverse=True)
                self._mark_best_available_pool(failover_candidates)
                best_failover = next((c for c in failover_candidates if c.eligible), None)
                if best_failover and best_failover.egress.id != user.current and l3_failover_cooldown_ok:
                    action = "switch"
                    move_type = "failover"
                    recommended = best_failover.egress.id
                    recommended_score = best_failover.score
                    reason.append("current_egress_not_eligible")
                    if not cooldown_ok and bool_value(l3_cooldown_override.get("allowed")):
                        reason.append("l3_failed_source_cooldown_override")
                    if current and bool_value(self.restore_barrier.get("failover_quarantine")):
                        if bool_value(self.restore_barrier.get("post_ttl_blocking")):
                            reason.append("restore_barrier_post_ttl_execution_blocked")
                        else:
                            reason.append("restore_barrier_execution_blocked")
                else:
                    reason.append("no_eligible_failover_target")
        elif user.ip in self.reconnect_events:
            alternative = self._best_alternative(user, candidates, current, purpose="reconnect_rotation")
            if alternative and cooldown_ok and not frozen:
                action = "switch"
                move_type = "reconnect_rotation"
                recommended = alternative.egress.id
                recommended_score = alternative.score
                reason.append("client_reconnect_requested_egress_rotation")
            elif alternative and not cooldown_ok:
                reason.append("reconnect_rotation_blocked_by_cooldown")
            elif alternative and frozen:
                reason.append("reconnect_rotation_blocked_by_user_freeze")
            else:
                reason.append("reconnect_rotation_no_alternative")
        elif best and best.egress.id != user.current:
            if self._beats_current(best, current) and cooldown_ok and not frozen:
                action = "switch"
                move_type = "planned"
                recommended = best.egress.id
                recommended_score = best.score
                reason.append("candidate_score_beats_current")
            elif bool_value(self.load_policy.get("rebalance_enabled", True)) and self._rebalance_needed(current, best) and cooldown_ok and not frozen:
                action = "switch"
                move_type = "rebalance"
                recommended = best.egress.id
                recommended_score = best.score
                reason.append("load_rebalance_even_distribution")
            elif bool_value(self.load_policy.get("rebalance_enabled", True)) and self._rebalance_needed(current, best) and not cooldown_ok:
                reason.append("rebalance_blocked_by_cooldown")
            elif bool_value(self.load_policy.get("rebalance_enabled", True)) and self._rebalance_needed(current, best) and frozen:
                reason.append("rebalance_blocked_by_user_freeze")
            else:
                reason.append("sticky_keep_current")
        elif bool_value(self.load_policy.get("rebalance_enabled", True)):
            alternative = self._best_alternative(user, candidates, current, purpose="rebalance")
            if alternative and self._rebalance_needed(current, alternative) and cooldown_ok and not frozen:
                action = "switch"
                move_type = "rebalance"
                recommended = alternative.egress.id
                recommended_score = alternative.score
                reason.append("load_rebalance_even_distribution")
            elif alternative and self._rebalance_needed(current, alternative) and not cooldown_ok:
                reason.append("rebalance_blocked_by_cooldown")
            elif alternative and self._rebalance_needed(current, alternative) and frozen:
                reason.append("rebalance_blocked_by_user_freeze")
            else:
                reason.append("current_is_best")
        else:
            reason.append("current_is_best")

        return {
            "user_ip": user.ip,
            "group": user.group,
            "route_class": route_class,
            "important_services": important,
            "current_egress": user.current,
            "recommended_egress": recommended,
            "action": action,
            "move_type": move_type,
            "reason": reason,
            "current_score": round(current.score, 2) if current else None,
            "recommended_score": round(recommended_score, 2) if recommended_score is not None else None,
            "candidates": [self._candidate_json(c) for c in candidates],
            "explanation": self._explanation(user, recommended, action, move_type, current, candidates, reason),
        }

    def _ctr_simulated_score(self, candidate: Candidate) -> float:
        ctr = candidate.ctr_advisory or {}
        return candidate.score + to_float(ctr.get("soft_adjustment"), 0.0)

    def _attach_ctr_score_simulation(self, candidates: list[Candidate]) -> None:
        if not candidates:
            return
        current_positions = {id(candidate): index for index, candidate in enumerate(candidates, start=1)}
        simulated_ranking = sorted(
            candidates,
            key=lambda c: (0 if c.eligible else 1, -self._ctr_simulated_score(c), c.egress.id),
        )
        simulated_positions = {id(candidate): index for index, candidate in enumerate(simulated_ranking, start=1)}
        for candidate in candidates:
            ctr = candidate.ctr_advisory or {}
            state = str(ctr.get("state") or "UNKNOWN").upper()
            adjustment = to_float(ctr.get("soft_adjustment"), 0.0)
            old_position = current_positions.get(id(candidate), 0)
            new_position = simulated_positions.get(id(candidate), old_position)
            ranking_delta = old_position - new_position
            service = candidate.service_suitability or {}
            recovery = ctr.get("recovery") if isinstance(ctr.get("recovery"), dict) else {}
            candidate.ctr_score_simulation = {
                "schema_version": "v7.ctr.dry-run-score-simulation.v1",
                "mode": "dry_run_simulation_only",
                "existing_score": round(candidate.score, 3),
                "ctr_soft_adjustment": round(adjustment, 3),
                "simulated_score": round(candidate.score + adjustment, 3),
                "score_delta": round(adjustment, 3),
                "old_position": old_position,
                "new_position": new_position,
                "ranking_delta": ranking_delta,
                "ctr_state": state,
                "reason": f"ctr_state_{state.lower()}_soft_adjustment_simulated",
                "why_changed": ctr.get("reason") or "channel_trust_recovery_advisory",
                "service_impact": {
                    "aggregate_score": service.get("aggregate_score"),
                    "required_missing": service.get("required_missing", []),
                    "required_low": service.get("required_low", []),
                    "ctr_current_service_score": ctr.get("current_service_score"),
                },
                "capacity_impact": candidate.capacity_decision,
                "trust_impact": {
                    "trust_score": ctr.get("trust_score"),
                    "advisory_score": ctr.get("advisory_score"),
                    "confidence": ctr.get("confidence"),
                },
                "recovery_impact": {
                    "recovery_state": recovery.get("state") or ctr.get("recovery_state"),
                    "recovery_path": ctr.get("recovery_path"),
                    "recommended_action": ctr.get("recommended_action"),
                    "blocked_actions": ctr.get("blocked_actions", []),
                },
                "planner_score_applied": False,
                "planner_ranking_changed": False,
                "selected_moves_changed": False,
                "runtime_behavior_changed": False,
                "simulation_authority": "none",
            }

    def _best_alternative(self, user: User, candidates: list[Candidate], current: Candidate, purpose: str) -> Optional[Candidate]:
        alternatives = [c for c in candidates if c.eligible and c.egress.id != user.current]
        if not alternatives:
            return None
        if purpose == "reconnect_rotation":
            return sorted(alternatives, key=lambda c: (self._load_limits_for_egress(c.egress).get("users", 0), c.egress.priority, -c.score, self._stable_pair_rank(user.ip, c.egress.id)))[0]
        if purpose == "rebalance":
            ratio = to_float(self.load_policy.get("rebalance_min_target_score_ratio"), 0.75)
            current_score = max(1.0, self._score_without_sticky(current))
            viable = [c for c in alternatives if self._score_without_sticky(c) >= current_score * ratio]
            if not viable:
                return None
            return sorted(viable, key=lambda c: (self._load_limits_for_egress(c.egress).get("users", 0), -c.score, self._stable_pair_rank(user.ip, c.egress.id)))[0]
        return max(alternatives, key=lambda c: c.score)

    def _stable_pair_rank(self, user_ip: str, egress_id: str) -> int:
        text = f"{user_ip}|{egress_id}"
        return int(hashlib.sha1(text.encode("utf-8")).hexdigest()[:8], 16)

    def _score_without_sticky(self, candidate: Candidate) -> float:
        if not candidate:
            return 0.0
        if candidate.score_parts:
            return sum(value for key, value in candidate.score_parts.items() if key != "sticky")
        return candidate.score

    def _capacity_decision(self, egress: Egress, projected_users: Optional[int] = None) -> dict[str, Any]:
        limits = self._load_limits_for_egress(egress)
        users = egress.users if projected_users is None else max(0, projected_users)
        soft_limit = max(1, to_int(limits.get("soft_limit"), 1))
        hard_limit = max(1, to_int(limits.get("hard_limit"), 1))
        projected_load = {
            "users": users,
            "soft_limit": soft_limit,
            "hard_limit": hard_limit,
            "status": limits.get("status", "UNKNOWN"),
        }
        hard_ratio = min(users / hard_limit, 1.0)
        soft_ratio = min(users / soft_limit, 1.5)
        capacity_score = max(0.0, 100.0 * (1.0 - hard_ratio))
        load_penalty = max(0.0, (soft_ratio - 1.0) * 60.0)
        if users >= hard_limit:
            reason = "hard_capacity_full"
        elif users >= soft_limit:
            reason = "soft_capacity_full"
        elif users == 0:
            reason = "empty_capacity_available"
        else:
            reason = "capacity_available"
        return {
            "capacity_score": round(capacity_score, 3),
            "load_penalty": round(load_penalty, 3),
            "projected_load": projected_load,
            "capacity_decision": reason,
            "distribution_reason": "capacity_breaks_ties_only_after_service_suitability",
        }

    def _mark_best_available_pool(self, candidates: list[Candidate]) -> None:
        if not bool_value(self.best_available_pool_policy.get("enabled", True)):
            for candidate in candidates:
                candidate.pool_cutoff_reason = "best_available_pool_disabled"
            return
        eligible = [candidate for candidate in candidates if candidate.eligible]
        if not eligible:
            return
        leader = max(eligible, key=lambda c: self._score_without_sticky(c))
        leader_score = max(1.0, self._score_without_sticky(leader))
        top_n = max(1, to_int(self.best_available_pool_policy.get("top_n"), 3))
        max_gap = max(0.0, min(1.0, to_float(self.best_available_pool_policy.get("max_score_gap_pct"), 0.15)))
        min_service = to_float(self.best_available_pool_policy.get("min_service_suitability"), 50.0)
        ranked = sorted(eligible, key=lambda c: (-self._score_without_sticky(c), self._load_limits_for_egress(c.egress).get("users", 0), c.egress.id))
        for index, candidate in enumerate(ranked, start=1):
            score = self._score_without_sticky(candidate)
            service_score = to_float((candidate.service_suitability or {}).get("aggregate_score"), 0.0)
            within_gap = score >= leader_score * (1.0 - max_gap)
            within_top = index <= top_n
            if service_score < min_service:
                candidate.pool_cutoff_reason = "service_suitability_below_pool_floor"
                continue
            if not within_gap:
                candidate.pool_cutoff_reason = "score_gap_below_best_available_pool"
                continue
            if not within_top:
                candidate.pool_cutoff_reason = "outside_best_available_pool_top_n"
                continue
            candidate.best_available_pool = True
            candidate.pool_rank = index
            candidate.pool_reason = "best_available_pool_member"
            candidate.reasons.append(f"best_available_pool_rank_{index}")

    def _rebalance_needed(self, current: Candidate, target: Candidate) -> bool:
        if not current or not target:
            return False
        current_load = self._load_limits_for_egress(current.egress)
        target_load = self._load_limits_for_egress(target.egress)
        current_users = to_int(current_load.get("users"), current.egress.users)
        target_users = to_int(target_load.get("users"), target.egress.users)
        min_gap = max(1, to_int(self.load_policy.get("rebalance_min_gap_users"), 2))
        if current_users - target_users < min_gap:
            return False
        if current_users >= to_int(current_load.get("soft_limit"), 1):
            return True
        return current_users - target_users >= (min_gap + 1)

    def _route_class_for_services(self, services: list[str]) -> str:
        if any(s in services for s in ("youtube", "instagram", "spotify", "soundcloud")):
            return "VIDEO_OPTIMIZED"
        if any(s in services for s in ("telegram", "whatsapp", "apple")):
            return "GLOBAL_STABLE"
        if any(s in services for s in ("gosuslugi", "esia", "nalog", "alfa_bank", "tbank", "sber")):
            return "TRUSTED_RU_SENSITIVE"
        return "GLOBAL_FAST"

    def _candidate(self, user: User, egress: Egress, services: list[str], route_class: str, purpose: str = "planned") -> Candidate:
        c = Candidate(egress=egress, eligible=True)
        c.severity_classification = self._severity_classification(egress)
        c.service_suitability = self._service_suitability(egress, services, route_class)
        c.routing_intelligence = self._routing_intelligence_candidate_advice(user, egress, services, route_class)
        c.ctr_advisory = self._ctr_advisory_for_egress(egress.id)
        self._gate_basic(c, purpose)
        self._gate_reservation(user, c, purpose)
        self._gate_org(user, c)
        self._gate_quality(c)
        self._gate_service(c, services, route_class, purpose)
        self._gate_load(c, purpose)
        self._gate_safety(user, c, purpose)
        c.capacity_decision = self._capacity_decision(egress)
        if not c.eligible:
            return c
        c.score_parts = self._score_parts(user, egress, services, route_class, c.routing_intelligence)
        c.score = sum(c.score_parts.values())
        return c

    def _block(self, candidate: Candidate, reason: str) -> None:
        candidate.eligible = False
        candidate.blocked.append(reason)

    def _gate_basic(self, candidate: Candidate, purpose: str) -> None:
        egress = candidate.egress
        controlled_target = (
            self.controlled_campaign_target_admission.get("ok")
            and egress.id
            == self.controlled_campaign_target_admission.get("target_id")
        )
        if not egress.enabled:
            self._block(candidate, "egress_disabled")
        if egress.state in ("maintenance", "disabled", "quarantine"):
            self._block(candidate, f"egress_state_{egress.state}")
        if egress.manual_only and not controlled_target:
            self._block(candidate, "manual_only")
        if egress.health_code and egress.health_code != "200":
            self._block(candidate, f"health_code_{egress.health_code}")
        severity = candidate.severity_classification or self._severity_classification(egress)
        if severity.get("hard_block"):
            self._block(candidate, str(severity.get("block_reason") or f"severity_{egress.severity}"))
        elif severity.get("category") == "protocol_diagnostic_limited_suspect":
            candidate.reasons.append("severity_protocol_diagnostic_limited_suspect")
        if str(self.load_policy.get("mode") or "static").lower() != "dynamic":
            if egress.load_status == "HARD_FULL" and purpose == "planned" and not self.args.allow_hard_full:
                self._block(candidate, "hard_full")
        if egress.reserve_only and purpose == "planned" and not controlled_target:
            self._block(candidate, "reserve_only")
        if controlled_target:
            candidate.reasons.append(
                "execution_only_target_admitted_by_exact_controlled_campaign"
            )

    def _gate_reservation(self, user: User, candidate: Candidate, purpose: str) -> None:
        egress = candidate.egress
        if not egress.canary_reserved:
            return
        if purpose == "current" and user.current == egress.id:
            candidate.reasons.append("canary_reserved_current_requires_separate_drain_approval")
            return
        if (
            self.controlled_campaign_target_admission.get("ok")
            and egress.id
            == self.controlled_campaign_target_admission.get("target_id")
        ):
            candidate.reasons.append(
                "canary_reserved_controlled_certification_target"
            )
            return
        self._block(candidate, "canary_reserved_production_assignment_blocked")

    def _gate_load(self, candidate: Candidate, purpose: str) -> None:
        if purpose == "current" or self.args.allow_hard_full:
            return
        limits = self._load_limits_for_egress(candidate.egress)
        if purpose == "failover":
            if candidate.egress.users >= to_int(limits.get("failover_hard_limit"), 1):
                self._block(candidate, "failover_full")
        elif candidate.egress.users >= to_int(limits.get("hard_limit"), 1):
            self._block(candidate, "planned_hard_full")

    def _gate_safety(self, user: User, candidate: Candidate, purpose: str) -> None:
        if purpose == "current":
            return
        egress_id = candidate.egress.id
        egress_safety = self._egress_safety(egress_id)
        if egress_safety.get("quarantine_until") and parse_ts(egress_safety.get("quarantine_until")) > time.time():
            self._block(candidate, "egress_safety_quarantine")
        if to_int(egress_safety.get("failed_verifications_1h")) >= to_int(self.safety_policy.get("egress_quarantine_failed_verifications_1h"), 2):
            self._block(candidate, "egress_failed_verifications_limit")
        if self._blocked_target_for_user(user, egress_id):
            self._block(candidate, "target_blocked_for_user")
        if self._pair_reversal_blocked_for_user(user, egress_id):
            self._block(candidate, "pair_reversal_stability_window")

    def _gate_org(self, user: User, candidate: Candidate) -> None:
        egress = candidate.egress
        group_policy = self._group_policy(user.group)
        allowed = split_csv(group_policy.get("allowed_egress"))
        preferred = split_csv(group_policy.get("preferred_egress"))
        excluded = split_csv(group_policy.get("excluded_egress"))
        isolation = str(group_policy.get("isolation") or self.org_policy.get("default_isolation") or "shared")

        if allowed and not glob_contains(allowed, egress.id):
            self._block(candidate, "not_in_group_allowed_pool")
        if excluded and glob_contains(excluded, egress.id):
            self._block(candidate, "excluded_by_group_policy")
        if egress.exclusive_group and egress.exclusive_group != user.group:
            self._block(candidate, f"exclusive_to_{egress.exclusive_group}")
        if egress.groups and user.group not in egress.groups:
            self._block(candidate, "not_in_egress_group_acl")
        other_groups = self.group_usage.get(egress.id, set()) - {user.group}
        if isolation == "exclusive" and other_groups:
            self._block(candidate, "egress_in_use_by_other_group")
        if preferred and glob_contains(preferred, egress.id):
            candidate.reasons.append("group_preferred")

    def _gate_quality(self, candidate: Candidate) -> None:
        egress = candidate.egress
        min_avg = to_float(self.quality_policy.get("min_avg_mbps"), 15.0)
        min_floor = to_float(self.quality_policy.get("min_floor_mbps"), 10.0)
        min_stability = to_float(self.quality_policy.get("min_stability"), 0.45)
        hist = self._quality_window(egress.id, "1h")
        hist_avg = to_float(hist.get("avg_mbps"), 0.0)
        hist_min = to_float(hist.get("min_mbps"), 0.0)
        hist_stability = to_float(hist.get("stability"), 0.0)
        service = candidate.service_suitability or {}
        severity = candidate.severity_classification or {}
        protocol_limited = severity.get("category") == "protocol_diagnostic_limited_suspect"
        service_ok = (
            to_float(service.get("aggregate_score")) >= to_float(self.service_quality_policy.get("min_required_service_score"), 50.0)
            and not service.get("required_missing")
            and not service.get("required_low")
        )
        evidence_exception = (
            protocol_limited
            and service_ok
            and egress.health_code == "200"
            and hist_avg >= to_float(self.service_quality_policy.get("quality_exception_min_1h_avg_mbps"), min_avg)
            and hist_min >= to_float(self.service_quality_policy.get("quality_exception_min_1h_floor_mbps"), min_floor)
            and max(egress.stability, hist_stability) >= to_float(self.service_quality_policy.get("quality_exception_min_stability"), 0.15)
        )
        decision = {
            "min_avg_mbps": min_avg,
            "min_floor_mbps": min_floor,
            "min_stability": min_stability,
            "hist_1h_avg_mbps": hist_avg,
            "hist_1h_min_mbps": hist_min,
            "hist_1h_stability": hist_stability,
            "evidence_backed_exception": evidence_exception,
            "service_aggregate_score": service.get("aggregate_score"),
        }
        if egress.avg_mbps < min_avg:
            if hist and hist_avg >= min_avg:
                candidate.reasons.append("avg_mbps_below_floor_but_1h_avg_ok")
            else:
                self._block(candidate, "avg_mbps_below_floor")
        if egress.min_mbps < min_floor:
            if evidence_exception or (hist and hist_min >= min_floor and service_ok):
                candidate.reasons.append("min_mbps_below_floor_contextual_warning")
            else:
                self._block(candidate, "min_mbps_below_floor")
        if egress.stability and egress.stability < min_stability:
            if evidence_exception:
                candidate.reasons.append("stability_below_floor_contextual_warning")
            elif hist and hist_stability >= min_stability:
                candidate.reasons.append("stability_below_floor_but_1h_stability_ok")
            else:
                self._block(candidate, "stability_below_floor")
        if evidence_exception:
            candidate.reasons.append("quality_floor_overridden_by_service_evidence")
        candidate.quality_decision = decision
        if hist and to_float(hist.get("fail_rate")) >= 0.75:
            candidate.reasons.append("quality_history_fail_rate_high_advisory")

    def _telegram_sentinel_row(self, egress_id: str) -> dict[str, Any]:
        return ((self.telegram_sentinel.get("items") or {}).get(egress_id) or {})

    def _telegram_candidate_state(self, egress_id: str) -> dict[str, Any]:
        sentinel = self._telegram_sentinel_row(egress_id)
        matrix_row = self._matrix_services(egress_id).get("telegram") or {}
        status = str(
            sentinel.get("matrix_status")
            or sentinel.get("status")
            or matrix_row.get("status")
            or ""
        ).upper()
        blocked = sentinel.get("blocked") is True or telegram_status_is_hard(status)
        if matrix_row.get("ok") is False and status in ("", "FAIL", "ERROR"):
            status = "DOWN"
            blocked = True
        degraded = status in TELEGRAM_SOFT_STATUSES or (sentinel.get("bad_now") is True and not blocked)
        ok = not blocked and (status == "OK" or matrix_row.get("ok") is True or degraded)
        reason = str(sentinel.get("reason") or matrix_row.get("reason") or "")
        return {
            "required": True,
            "status": status or "UNKNOWN",
            "ok": ok,
            "hard_blocked": blocked,
            "degraded": degraded,
            "bad_now": bool(sentinel.get("bad_now")),
            "bad_for_seconds": to_float(sentinel.get("bad_for_seconds") or matrix_row.get("bad_for_seconds")),
            "score": to_float(sentinel.get("score") or matrix_row.get("score")),
            "reason": reason,
            "source": "sentinel" if sentinel else ("matrix" if matrix_row else "none"),
        }

    def _gate_service(self, candidate: Candidate, services: list[str], route_class: str, purpose: str) -> None:
        if route_class == "TRUSTED_RU_SENSITIVE" and not bool_value(candidate.egress.raw["meta"].get("trusted_ru")):
            self._block(candidate, "trusted_ru_required")
        suitability = candidate.service_suitability or {}
        for service in suitability.get("required_missing") or []:
            self._block(candidate, f"service_{service}_evidence_unknown")
        for service in suitability.get("required_low") or []:
            candidate.reasons.append(f"service_{service}_suitability_low")
        matrix_services = self._matrix_services(candidate.egress.id)
        per_service = suitability.get("per_service") or {}
        failed_services: list[dict[str, Any]] = []
        for service in services:
            if service == "telegram":
                telegram = self._telegram_candidate_state(candidate.egress.id)
                if telegram.get("hard_blocked"):
                    self._block(candidate, f"telegram_required_{str(telegram.get('status')).lower()}")
                elif telegram.get("degraded"):
                    candidate.reasons.append(f"telegram_{str(telegram.get('status')).lower()}")
                elif telegram.get("ok"):
                    candidate.reasons.append("service_telegram_ok")
                else:
                    candidate.reasons.append("telegram_not_measured")
                    if service in self._explicit_required_services():
                        self._block(candidate, "service_telegram_evidence_unknown")
                continue
            row = matrix_services.get(service)
            item = per_service.get(service) or self._service_suitability_for_row(
                service,
                row or {},
                service in self._explicit_required_services(),
                True,
            )
            truth_class = str(item.get("truth_class") or "")
            if truth_class == "HEALTHY":
                candidate.reasons.append(f"service_{service}_ok")
            elif truth_class == "PROBE_METHODOLOGY_ISSUE":
                candidate.reasons.append(f"service_{service}_probe_methodology_issue")
                candidate.reasons.append("service_signal_PROBE_METHODOLOGY_VISIBLE")
            elif truth_class == "STALE_SERVICE_TRUTH":
                candidate.reasons.append(f"service_{service}_truth_stale")
                if item.get("blocked_action"):
                    self._block(candidate, str(item.get("blocked_action")))
            elif truth_class in {"TRANSIENT_FAIL", "PERSISTENT_FAIL"}:
                failed_services.append(dict(item))
            elif service in self._explicit_required_services():
                self._block(candidate, f"service_{service}_evidence_unknown")
        self._gate_service_failures(candidate, failed_services)
        fitness = self._route_class_fitness(candidate.egress.id, route_class)
        if fitness == "FAIL":
            route_truth_classes = {
                str((per_service.get(service) or {}).get("truth_class") or "")
                for service in normalize_service_ids(services)
                if service != "telegram"
            }
            hard_route_fail = bool(route_truth_classes & {"PERSISTENT_FAIL", "STALE_SERVICE_TRUTH"})
            if hard_route_fail:
                self._block(candidate, f"route_class_{route_class}_failed")
            else:
                candidate.reasons.append(f"route_class_{route_class}_failed_nonpersistent_service_truth")
                candidate.reasons.append("service_signal_ROUTE_FAIL_REVALIDATION_REQUIRED")
        elif fitness:
            candidate.reasons.append(f"route_class_{route_class}_{fitness.lower()}")

    def _service_failure_count(self, row: dict[str, Any]) -> int:
        return max(
            1,
            to_int(row.get("failure_samples")),
            to_int(row.get("failed_samples")),
            to_int(row.get("consecutive_failures")),
            to_int(row.get("failures")),
        )

    def _service_failure_persistent(self, row: dict[str, Any], count: int) -> bool:
        threshold = max(1, to_int(self.service_signal_policy.get("service_failure_persistence_samples"), 3))
        window = max(1, to_int(self.service_signal_policy.get("service_failure_persistence_window_seconds"), 180))
        bad_for = to_float(row.get("bad_for_seconds") or row.get("failed_for_seconds"))
        return count >= threshold or bad_for >= window

    def _gate_service_failures(self, candidate: Candidate, failures: list[dict[str, Any]]) -> None:
        if not failures:
            return
        min_critical = max(1, to_int(self.service_signal_policy.get("service_failure_min_critical_count"), 2))
        persistent = [item for item in failures if item.get("truth_class") == "PERSISTENT_FAIL"]
        transient = [item for item in failures if item.get("truth_class") == "TRANSIENT_FAIL"]
        legacy_unknown_critical = [item for item in transient if item.get("critical_unknown_truth")]
        if len(legacy_unknown_critical) >= min_critical:
            candidate.reasons.append("service_signal_CONDITIONAL_INELIGIBLE")
            candidate.reasons.append("service_signal_UNKNOWN_TRUTH_FAIL_CLOSED")
            self._block(candidate, "service_multiple_critical_failed")
            return
        if persistent:
            candidate.reasons.append("service_signal_CONDITIONAL_INELIGIBLE")
            for item in persistent:
                service = str(item.get("service") or "")
                self._block(candidate, f"service_{service}_persistent_failed")
            return
        if len(transient) >= min_critical:
            candidate.reasons.append("service_signal_TRANSIENT_REVALIDATION_REQUIRED")
            candidate.reasons.append("service_multiple_transient_failed_degraded")
        for item in transient:
            service = str(item.get("service") or "")
            count = to_int(item.get("failure_count"), 1)
            candidate.reasons.append(f"service_{service}_transient_fail")
            candidate.reasons.append(f"service_{service}_degraded")
            candidate.reasons.append(f"service_{service}_failed_samples_{count}")
        candidate.reasons.append("service_signal_DEGRADED_SERVICE")

    def _service_signal_only_block(self, candidate: Candidate) -> bool:
        if not candidate.blocked:
            return False
        service_reasons = {"service_multiple_critical_failed"}
        return all(
            reason.startswith("service_")
            or reason.startswith("telegram_required_")
            or reason in service_reasons
            for reason in candidate.blocked
        )

    def _score_parts(
        self,
        user: User,
        egress: Egress,
        services: list[str],
        route_class: str,
        routing_intelligence: Optional[dict[str, Any]] = None,
    ) -> dict[str, float]:
        max_avg = max((e.avg_mbps for e in self.egress.values()), default=1.0) or 1.0
        max_min = max((e.min_mbps for e in self.egress.values()), default=1.0) or 1.0
        max_client = max((e.client_mbps for e in self.egress.values()), default=1.0) or 1.0
        suitability = self._service_suitability(egress, services, route_class)
        service_score, latency_score = self._service_scores(egress, services, route_class, suitability)
        telegram_score = 0.0
        if "telegram" in services:
            telegram = self._telegram_candidate_state(egress.id)
            if telegram.get("degraded"):
                telegram_score -= 120.0
                telegram_score += max(0.0, min(to_float(telegram.get("score")), 79.0)) * 0.5
            elif telegram.get("ok"):
                telegram_score += 40.0
            elif telegram.get("source") == "none":
                telegram_score -= 20.0
        limits = self._load_limits_for_egress(egress)
        hard_limit = max(1, to_int(limits.get("hard_limit"), 1))
        capacity_decision = self._capacity_decision(egress)
        load_score = max(0.0, 80.0 * (1.0 - min(egress.users / hard_limit, 1.0)))
        quality_window = self._quality_window(egress.id, "1h")
        quality_score = max(0.0, 80.0 * (1.0 - min(to_float(quality_window.get("fail_rate")), 1.0)))
        quality_score += min(max(to_float(quality_window.get("stability"), egress.stability), 0.0), 1.0) * 60.0
        trend = str((self._quality_history(egress.id).get("score") or {}).get("trend") or "")
        if trend == "degrading":
            quality_score -= 40.0
        elif trend == "improving":
            quality_score += 20.0
        group_policy = self._group_policy(user.group)
        preferred = split_csv(group_policy.get("preferred_egress"))
        parts = {
            "health": 1000.0,
            "service": service_score,
            "telegram_required": telegram_score,
            "speed": ((egress.avg_mbps / max_avg) * 120.0) + ((egress.min_mbps / max_min) * 60.0) + ((egress.client_mbps / max_client) * 20.0 if max_client else 0.0),
            "stability": min(max(egress.stability, 0.0), 1.0) * 150.0,
            "latency": latency_score,
            "load": load_score,
            "capacity": to_float(capacity_decision.get("capacity_score"), 0.0),
            "quality_history": quality_score,
            "priority": max(0.0, 100.0 - float(egress.priority)),
            "weight": egress.weight,
            "sticky": 50.0 if egress.id == user.current else 0.0,
            "org_preference": 60.0 if preferred and glob_contains(preferred, egress.id) else 0.0,
            "reserve_penalty": -100.0 if egress.reserve_only else 0.0,
        }
        ri = routing_intelligence or {}
        if bool_value(ri.get("planner_influence_active")):
            parts["routing_intelligence"] = to_float(ri.get("score_part"), 0.0)
        return parts

    def _service_scores(self, egress: Egress, services: list[str], route_class: str, suitability: Optional[dict[str, Any]] = None) -> tuple[float, float]:
        suitability = suitability or self._service_suitability(egress, services, route_class)
        matrix_services = self._matrix_services(egress.id)
        wanted = services or list(matrix_services.keys())
        if not wanted:
            fitness = self._route_class_fitness(egress.id, route_class)
            return (220.0 if fitness == "OK" else 120.0 if fitness == "WARN" else 0.0, 50.0)
        latencies: list[float] = []
        for service in wanted:
            row = matrix_services.get(service)
            if not row:
                continue
            first_byte = to_float(row.get("first_byte_sec"), 0.0)
            if first_byte > 0:
                latencies.append(first_byte)
        service_score = to_float(suitability.get("aggregate_score"), 0.0) * 3.0
        if not (suitability.get("per_service") or {}):
            service_score = 0.0
        per_service = suitability.get("per_service") or {}
        failed_count = sum(
            1
            for service in wanted
            if service != "telegram"
            and str((per_service.get(service) or {}).get("truth_class") or "") in {
                "TRANSIENT_FAIL",
                "PERSISTENT_FAIL",
                "STALE_SERVICE_TRUTH",
            }
        )
        service_score -= failed_count * to_float(self.service_signal_policy.get("per_service_penalty_weight"), 80.0)
        avg_latency = sum(latencies) / len(latencies) if latencies else 1.0
        latency_score = max(0.0, 100.0 * (1.0 - min(avg_latency, 2.0) / 2.0))
        return service_score, latency_score

    def _cooldown_ok(self, user: User) -> tuple[bool, str]:
        cooldown = to_int(self.switch_policy.get("cooldown_seconds"), 180)
        last = self.last_switch.get(user.ip)
        if not last:
            return True, ""
        age = time.time() - last
        if age < cooldown:
            return False, f"cooldown_active_{int(cooldown - age)}s"
        return True, ""

    def _beats_current(self, best: Candidate, current: Candidate) -> bool:
        improvement_pct = to_float(self.switch_policy.get("min_score_improvement_pct"), 0.20)
        min_delta = to_float(self.switch_policy.get("min_score_delta"), 50.0)
        return best.score >= current.score * (1.0 + improvement_pct) and (best.score - current.score) >= min_delta

    def _explanation(self, user: User, recommended: str, action: str, move_type: str, current: Optional[Candidate], candidates: list[Candidate], reasons: list[str]) -> dict[str, Any]:
        chosen = next((c for c in candidates if c.egress.id == recommended), None)
        if not chosen and current and current.egress.id == recommended:
            chosen = current
        why: list[str] = []
        if chosen:
            load = self._load_limits_for_egress(chosen.egress)
            why.append(f"load {load.get('users')}/{load.get('hard_limit')} status {load.get('status')}")
            why.append(f"speed avg {round(chosen.egress.avg_mbps, 2)} Mbps min {round(chosen.egress.min_mbps, 2)} Mbps")
            why.append(f"stability {round(chosen.egress.stability, 3)}")
            quality_score = (self._quality_history(chosen.egress.id).get("score") or {})
            if quality_score:
                why.append(f"quality trend {quality_score.get('trend', 'unknown')} score {quality_score.get('current', 0)}")
            if chosen.reasons:
                why.extend(chosen.reasons[:4])
            ri = chosen.routing_intelligence or {}
            if ri:
                why.append(
                    "routing intelligence "
                    f"{ri.get('recommendation', 'neutral')} "
                    f"score_part {round(to_float(ri.get('score_part')), 2)} "
                    f"risk {round(to_float(ri.get('degradation_risk_score')), 2)}"
                )
            ctr = chosen.ctr_advisory or {}
            if ctr:
                why.append(
                    "ctr advisory "
                    f"{ctr.get('state', 'UNKNOWN')} "
                    f"action {ctr.get('recommended_action', 'observe')} "
                    f"soft_adjustment {round(to_float(ctr.get('soft_adjustment')), 2)} "
                    "score_not_applied"
                )
            if user.group:
                why.append(f"group {user.group} allowed")
        if action == "keep":
            why.append("sticky/current route kept")
        elif move_type == "failover":
            why.append("current egress is not eligible, using failover gate")
        elif move_type == "planned":
            why.append("candidate score beats current by policy threshold")

        rejected = []
        for candidate in candidates:
            if candidate.egress.id == recommended:
                continue
            if candidate.blocked:
                rejected.append({"egress": candidate.egress.id, "reason": ", ".join(candidate.blocked[:4])})
            elif candidate.score > 0:
                rejected.append({"egress": candidate.egress.id, "reason": f"score {round(candidate.score, 2)} below chosen/current"})
            if len(rejected) >= 8:
                break

        score_gap = 0.0
        if chosen and current:
            score_gap = chosen.score - current.score
        confidence = "low"
        if action == "keep":
            confidence = "high" if "current_is_best" in reasons else "medium"
        elif score_gap >= 250 or move_type == "failover":
            confidence = "high"
        elif score_gap >= 80:
            confidence = "medium"

        return {
            "chosen": recommended,
            "action": action,
            "move_type": move_type,
            "confidence": confidence,
            "why": why,
            "rejected": rejected,
            "safety": {
                "user": self._user_safety(user.ip),
                "frozen": self._user_frozen(user)[0],
            },
        }

