    def _select_moves(
        self,
        decisions: list[dict[str, Any]],
        *,
        incident_source_context: Optional[dict[str, Any]] = None,
    ) -> list[dict[str, Any]]:
        failover_limit = to_int(self.switch_policy.get("autoswitch_max_failover_per_run"), 25)
        requested_max_selected_moves = to_int(getattr(self.args, "max_selected_moves", 0), 0)
        incident_source_context = incident_source_context or {}
        if (
            bool_value(incident_source_context.get("active"))
            and requested_max_selected_moves > failover_limit
        ):
            authority_budget = max(
                0,
                to_int(self.authority_budget_policy.get("current_allowed_user_budget"), failover_limit),
            )
            governed_failover_limit = min(requested_max_selected_moves, authority_budget)
            if governed_failover_limit > failover_limit:
                incident_source_context["failover_limit_raised_by_governed_authority"] = True
                incident_source_context["base_failover_limit"] = failover_limit
                incident_source_context["governed_failover_limit"] = governed_failover_limit
                incident_source_context["requested_max_selected_moves"] = requested_max_selected_moves
                incident_source_context["authority_allowed_user_budget"] = authority_budget
                incident_source_context["failover_limit_raise_reason"] = "active_incident_governed_authority_budget"
                failover_limit = governed_failover_limit
        if bool_value(self.service_signal_policy.get("restore_stage")):
            failover_limit = min(
                failover_limit,
                max(0, to_int(self.service_signal_policy.get("max_failover_per_restore_stage"), 1)),
            )
        reconnect_limit = to_int(self.switch_policy.get("autoswitch_max_reconnect_per_run"), 10)
        planned_limit = to_int(self.switch_policy.get("autoswitch_max_planned_per_run"), 1)
        rebalance_limit = to_int(self.load_policy.get("rebalance_max_moves_per_run"), 3)
        selected: list[dict[str, Any]] = []
        failovers = [d for d in decisions if d.get("action") == "switch" and d.get("move_type") == "failover"]
        reconnect = [d for d in decisions if d.get("action") == "switch" and d.get("move_type") == "reconnect_rotation"]
        rebalance = [d for d in decisions if d.get("action") == "switch" and d.get("move_type") == "rebalance"]
        planned = [d for d in decisions if d.get("action") == "switch" and d.get("move_type") == "planned"]
        projected = {egress_id: egress.users for egress_id, egress in self.egress.items()}
        selected.extend(self._pick_projected_moves(
            failovers,
            failover_limit,
            projected,
            allow_over_soft=True,
            incident_source_context=incident_source_context,
        ))
        selected.extend(self._pick_projected_moves(reconnect, reconnect_limit, projected, allow_over_soft=False))
        selected.extend(self._pick_projected_moves(rebalance, rebalance_limit, projected, allow_over_soft=False))
        selected.extend(self._pick_projected_moves(planned, planned_limit, projected, allow_over_soft=False))
        return selected

    def _pick_projected_moves(
        self,
        moves: list[dict[str, Any]],
        limit: int,
        projected: dict[str, int],
        allow_over_soft: bool,
        *,
        incident_source_context: Optional[dict[str, Any]] = None,
    ) -> list[dict[str, Any]]:
        picked: list[dict[str, Any]] = []
        incident_source_context = incident_source_context or {}
        retry_budget = max(0, to_int(self.emergency_failover_policy.get("retry_budget_per_incident"), 1))
        ranked = sorted(
            moves,
            key=lambda d: (
                projected.get(str(d.get("recommended_egress") or ""), 0),
                -(to_float(d.get("recommended_score"), 0.0) - to_float(d.get("current_score"), 0.0)),
            ),
        )
        for move in ranked:
            if len(picked) >= max(0, limit):
                break
            source = str(move.get("current_egress") or "")
            target = self._projected_target_for_move(move, projected, allow_over_soft)
            if not target or target == source or target not in self.egress:
                continue
            retry_state = self._l3_retry_budget_exhausted_for_move(
                move,
                target=target,
                incident_source_context=incident_source_context,
                retry_budget_per_incident=retry_budget,
            )
            if bool_value(retry_state.get("exhausted")):
                incident_source_context.setdefault("retry_exhausted_attempts_excluded", []).append(retry_state)
                incident_source_context["retry_filter_applied"] = True
                continue
            limits = self._load_limits_for_egress(self.egress[target])
            soft_limit = to_int(limits.get("soft_limit"), 1)
            hard_limit = to_int(limits.get("hard_limit"), 1)
            projected_target = projected.get(target, self.egress[target].users)
            if not allow_over_soft and projected_target >= soft_limit:
                continue
            if projected_target >= hard_limit:
                continue
            original_target = str(move.get("recommended_egress") or "")
            move = dict(move)
            move["recommended_egress"] = target
            explanation = move.get("explanation")
            if isinstance(explanation, dict):
                explanation = dict(explanation)
                explanation["chosen"] = target
                move["explanation"] = explanation
            if target != original_target:
                move.setdefault("reason", []).append("projected_load_target_adjusted")
            projected_decision = self._capacity_decision(self.egress[target], projected_target + 1)
            move["capacity_decision"] = projected_decision
            move["projected_load"] = projected_decision.get("projected_load", {})
            picked.append(move)
            projected[target] = projected_target + 1
            if source:
                projected[source] = max(0, projected.get(source, 0) - 1)
        return picked

    def _projected_target_for_move(self, move: dict[str, Any], projected: dict[str, int], allow_over_soft: bool) -> str:
        source = str(move.get("current_egress") or "")
        requested_target = str(self.args.target_egress or "").strip()
        if requested_target:
            return requested_target if requested_target != source else ""
        raw_candidates = move.get("candidates") if isinstance(move.get("candidates"), list) else []
        candidates = [
            row for row in raw_candidates
            if isinstance(row, dict) and row.get("eligible") and str(row.get("egress") or "") and str(row.get("egress") or "") != source
        ]
        pool_candidates = [row for row in candidates if row.get("best_available_pool")]
        if pool_candidates:
            candidates = pool_candidates
        if not candidates:
            target = str(move.get("recommended_egress") or "")
            return target if target != source else ""
        ranked = sorted(
            candidates,
            key=lambda row: (
                projected.get(str(row.get("egress") or ""), 0),
                -to_float(row.get("score"), 0.0),
                str(row.get("egress") or ""),
            ),
        )
        for row in ranked:
            target = str(row.get("egress") or "")
            if target not in self.egress:
                continue
            limits = self._load_limits_for_egress(self.egress[target])
            soft_limit = to_int(limits.get("soft_limit"), 1)
            hard_limit = to_int(limits.get("hard_limit"), 1)
            projected_target = projected.get(target, self.egress[target].users)
            if not allow_over_soft and projected_target >= soft_limit:
                continue
            if projected_target >= hard_limit:
                continue
            return target
        return ""

    def apply(self, plan: dict[str, Any]) -> dict[str, Any]:
        mode = str(plan.get("mode") or "observe")
        operation = plan.get("operation") or {}
        operation_id = str(operation.get("operation_id") or "")
        control_operation_id = str(getattr(self.args, "approved_operation_id", "") or operation_id)
        selected_hash = str(operation.get("selected_move_hash") or "")
        if not self.args.apply:
            return {"applied": False, "reason": "dry_run"}
        if not plan.get("enabled", True):
            return {"applied": False, "reason": "autoswitch_disabled_by_policy"}
        if mode == "observe":
            return {"applied": False, "reason": "mode_observe_blocks_apply"}
        if not plan.get("selected_moves"):
            committed_moves = self._committed_selected_moves_from_approved_plan_lock(plan)
            if committed_moves:
                plan["selected_moves"] = committed_moves
                plan.setdefault("summary", {})["selected_moves"] = len(committed_moves)
                operation = plan.get("operation") or {}
                selected_hash = str(operation.get("selected_move_hash") or "")
            else:
                safety = plan.get("safety") or {}
                barrier = safety.get("restore_barrier") or {}
                approved_lock = barrier.get("approved_plan_lock_validation") or {}
                diagnostics = safety.get("selected_moves_diagnostics") or {}
                if approved_lock.get("present"):
                    approved_lock_reason = str(approved_lock.get("reason") or "")
                    if bool_value(approved_lock.get("ok")):
                        approved_lock_reason = ""
                    reason = str(
                        approved_lock_reason
                        or barrier.get("approved_plan_lock_blocker")
                        or barrier.get("clearance_guard_reason")
                        or "approved_plan_lock_selected_moves_missing"
                    )
                    return {
                        "applied": False,
                        "reason": "approved_plan_lock_selected_moves_missing",
                        "unsafe_blocker": reason,
                        "selected_moves_diagnostics": diagnostics,
                        "approved_plan_lock_validation": approved_lock,
                    }
                return {"applied": False, "reason": "no_selected_moves"}
        entry_control = self._execution_control_decision(
            mutation_kind="forward",
            action_class=self._execution_action_class((plan.get("selected_moves") or [{}])[0].get("move_type", "")),
            expected_generation=str(getattr(self.args, "approved_breaker_generation", "") or ""),
            operation_id=control_operation_id,
            selected_move_hash=selected_hash,
            source_bundle_hash=str(getattr(self.args, "approved_source_bundle_hash", "") or ""),
            snapshot_bundle_hash=str(getattr(self.args, "approved_snapshot_bundle_hash", "") or ""),
            max_users=max(0, to_int(getattr(self.args, "max_selected_moves", 0), 0)),
        )
        plan.setdefault("safety", {})["autonomous_execution_control"] = entry_control
        if not entry_control.get("allowed_forward_mutation"):
            return {"applied": False, "reason": "autonomous_execution_control_stop_safe", "execution_control": entry_control}
        envelope = (plan.get("safety") or {}).get("atomic_execution_envelope") or {}
        approved_binding_mismatches = []
        operation_binding: dict[str, Any] = {}
        if entry_control.get("scope") == "operation":
            operation_binding = self._operation_scoped_source_binding(plan)
            if str(getattr(self.args, "approved_selected_move_hash", "") or "") != selected_hash:
                approved_binding_mismatches.append("selected_move_hash")
            if operation_binding.get("status") != "BOUND":
                approved_binding_mismatches.append("operation_scoped_binding")
            if str(getattr(self.args, "approved_source_bundle_hash", "") or "") != str(operation_binding.get("source_bundle_hash") or ""):
                approved_binding_mismatches.append("source_bundle_hash")
            if str(getattr(self.args, "approved_snapshot_bundle_hash", "") or "") != str(operation_binding.get("snapshot_bundle_hash") or ""):
                approved_binding_mismatches.append("snapshot_bundle_hash")
        if approved_binding_mismatches:
            return {
                "applied": False,
                "reason": "approved_controlled_window_binding_mismatch",
                "binding_mismatches": approved_binding_mismatches,
                "operation_scoped_binding": operation_binding,
                "execution_control": entry_control,
            }
        atomic_validation = self._validate_atomic_execution_envelope(plan)
        plan.setdefault("safety", {})["atomic_execution_envelope_validation"] = atomic_validation
        if not atomic_validation.get("ok"):
            return {
                "applied": False,
                "reason": str(atomic_validation.get("reason") or "atomic_execution_envelope_invalid"),
                "atomic_execution_envelope_validation": atomic_validation,
            }

        results: list[dict[str, Any]] = []
        summary = plan.get("summary") if isinstance(plan.get("summary"), dict) else {}
        safety = plan.get("safety") if isinstance(plan.get("safety"), dict) else {}
        incident = safety.get("l3_incident") if isinstance(safety.get("l3_incident"), dict) else {}
        autonomy = safety.get("emergency_failover_autonomy") if isinstance(safety.get("emergency_failover_autonomy"), dict) else {}
        summary_emergency_mode = str(summary.get("execution_mode") or "") == "emergency_failover"
        committed_emergency_moves = any(
            str(move.get("execution_mode") or "") == "emergency_failover"
            for move in (plan.get("selected_moves") or [])
            if isinstance(move, dict)
        )
        l3_context_active = (
            str(incident.get("authority_object") or "") == "EMERGENCY_FAILOVER_AUTONOMY"
            or str(incident.get("incident_state") or "") in {"READY_FOR_EXECUTION", "OPEN", "ACTIVE"}
            or (bool_value(autonomy.get("enabled")) and bool_value(autonomy.get("ok")))
        )
        emergency_mode = summary_emergency_mode or (committed_emergency_moves and l3_context_active)
        l3_eligibility = self._l3_execution_eligibility(plan)
        if l3_eligibility.get("active"):
            plan.setdefault("safety", {})["l3_execution_eligibility"] = l3_eligibility
            incident = plan.setdefault("safety", {}).get("l3_incident")
            if isinstance(incident, dict):
                incident["runtime_apply_allowed_now"] = bool_value(l3_eligibility.get("ok"))
                incident["terminal_outcome"] = "EXECUTION_ELIGIBLE" if bool_value(l3_eligibility.get("ok")) else "STOP_SAFE"
                surface = incident.get("operator_surface")
                if isinstance(surface, dict):
                    surface["execution_state"] = "EXECUTION_ELIGIBLE" if bool_value(l3_eligibility.get("ok")) else "STOP_SAFE"
                    surface["terminal_outcome"] = incident["terminal_outcome"]
                    surface["next_action"] = "apply_then_verify" if bool_value(l3_eligibility.get("ok")) else "STOP_SAFE"
        if not l3_eligibility.get("ok", True):
            return {
                "applied": False,
                "reason": "l3_execution_eligibility_stop_safe",
                "unsafe_blocker": ",".join(str(item) for item in (l3_eligibility.get("blockers") or [])),
                "l3_execution_eligibility": l3_eligibility,
            }
        action_contract = ((safety.get("authority_budget_gate") or {}).get("current_action_class_contract") or {})
        strict_contract = ((action_contract.get("provenance") or {}).get("strict_provenance_contract") is True)
        if strict_contract:
            selected_for_contract = list(plan.get("selected_moves") or [])
            if len(selected_for_contract) != 1:
                return {
                    "applied": False,
                    "reason": "current_action_class_contract_exact_one_user_consumption_required",
                    "selected_move_count": len(selected_for_contract),
                }
            move = selected_for_contract[0]
            try:
                consumption_result = operator_execution.consume_current_action_class_contract_to_policy(
                    Path(self.args.policy_file),
                    contract_id=str(action_contract.get("contract_id") or ""),
                    contract_hash=str(action_contract.get("contract_hash") or ""),
                    subject={"user_ip": str(move.get("user_ip") or "")},
                    scope={
                        "source_egress": str(move.get("current_egress") or ""),
                        "target_egress": str(move.get("recommended_egress") or ""),
                    },
                    source_generation=action_class_contract_source_generation(plan, move),
                    operation_id=operation_id,
                    audit_store=getattr(self.args, "action_class_audit_store", ""),
                    actor_id="tools/v7-users-autoswitch",
                )
            except operator_execution.PacketError as exc:
                return {
                    "applied": False,
                    "reason": "current_action_class_contract_consumption_stop_safe",
                    "unsafe_blocker": str(exc),
                }
            self.policy = consumption_result["policy"]
            plan.setdefault("safety", {})["current_action_class_contract_consumption"] = {
                "owner": operator_execution.CURRENT_ACTION_CLASS_CONTRACT_ISSUING_OWNER,
                "state": consumption_result["consumption"].get("state"),
                "consumption_id": consumption_result["consumption"].get("consumption_id"),
                "runtime_apply_started_after_consumption": True,
            }
        cohort_circuit_breaker = {
            "owner": "tools/v7-users-autoswitch.apply",
            "policy": "stop_remaining_forward_mutations_after_first_non_success",
            "tripped": False,
            "trigger_user": "",
            "trigger_terminal": "",
            "remaining_not_attempted": 0,
        }
        selected_moves = list(plan["selected_moves"])
        bounded_checkpoint_enabled = len(selected_moves) > 1
        bounded_checkpoint: dict[str, Any] = {}
        if bounded_checkpoint_enabled:
            operation_id_for_checkpoint = str(
                (plan.get("operation") or {}).get("operation_id") or ""
            )
            state_before = self._load_l3_runtime_state()
            prior_checkpoint = (
                (state_before.get("bounded_cohort_transactions") or {}).get(
                    operation_id_for_checkpoint,
                )
                if isinstance(state_before.get("bounded_cohort_transactions"), dict)
                else {}
            )
            prior_checkpoint = prior_checkpoint if isinstance(prior_checkpoint, dict) else {}
            if prior_checkpoint:
                return {
                    "applied": False,
                    "reason": "bounded_cohort_restart_recovery_checkpoint_requires_causal_closure",
                    "bounded_cohort_transaction": prior_checkpoint,
                    "remaining_forward_mutations_stopped": True,
                    "packet_reuse_for_new_transaction": "FORBIDDEN",
                }
            bounded_checkpoint = self._bounded_cohort_checkpoint(
                plan,
                selected_moves,
                results=[],
                terminal_state="IN_PROGRESS",
                terminal_reason="before_first_member_mutation",
            )
            if not bounded_checkpoint.get("ok"):
                return {
                    "applied": False,
                    "reason": str(
                        bounded_checkpoint.get("reason")
                        or "bounded_cohort_checkpoint_initialization_failed"
                    ),
                    "bounded_cohort_transaction": bounded_checkpoint.get("checkpoint") or {},
                    "remaining_forward_mutations_stopped": True,
                }
        for move_index, move in enumerate(selected_moves):
            item_control = self._execution_control_decision(
                mutation_kind="forward",
                action_class=self._execution_action_class(move.get("move_type", "")),
                expected_generation=str(entry_control.get("generation") or ""),
                operation_id=control_operation_id,
                selected_move_hash=selected_hash,
                source_bundle_hash=str(getattr(self.args, "approved_source_bundle_hash", "") or ""),
                snapshot_bundle_hash=str(getattr(self.args, "approved_snapshot_bundle_hash", "") or ""),
                max_users=max(0, to_int(getattr(self.args, "max_selected_moves", 0), 0)),
            )
            if not item_control.get("allowed_forward_mutation"):
                if bounded_checkpoint_enabled:
                    bounded_checkpoint = self._bounded_cohort_checkpoint(
                        plan,
                        selected_moves,
                        results=results,
                        terminal_state="STOP_SAFE",
                        terminal_reason="autonomous_execution_control_changed_during_batch",
                    )
                return {
                    "applied": bool(results),
                    "reason": "autonomous_execution_control_changed_during_batch",
                    "results": results,
                    "execution_control": item_control,
                    "remaining_forward_mutations_stopped": True,
                    "bounded_cohort_transaction": bounded_checkpoint.get("checkpoint") or {},
                }
            self._active_execution_control = item_control
            ip = move["user_ip"]
            target = move["recommended_egress"]
            current = move["current_egress"]
            proc = self._run_switch(ip, target, move.get("move_type", "planned"))
            row = {
                "user_ip": ip,
                "from": current,
                "to": target,
                "move_type": move.get("move_type"),
                "operation_id": operation_id,
                "selected_move_hash": selected_hash,
                "selected_move_index": move.get("selected_move_index"),
                "rc": proc.returncode,
                "output": proc.stdout[-4000:],
                "rollback_attempted": False,
                "terminal_outcome_classification": "APPLY_FAILURE" if proc.returncode != 0 else "APPLY_COMPLETED_PENDING_VERIFICATION",
            }
            if proc.returncode == 0 and self.args.verify:
                verify = self._verify_routes_for_apply(ip if emergency_mode else "", target if emergency_mode else "")
                row["verify_rc"] = verify.returncode
                row["verify_output"] = verify.stdout[-4000:]
                row["route_verification_scope"] = "selected_user" if emergency_mode else "global"
                if emergency_mode:
                    row["route_verification_expected_egress"] = target
                service_verify = None
                if verify.returncode == 0 and emergency_mode:
                    controlled_condition = None
                    if bool_value(getattr(self.args, "controlled_verifier_contention", False)):
                        controlled_condition = self._activate_controlled_verifier_contention(move, operation_id)
                        row["controlled_verifier_condition"] = controlled_condition
                    # The normal verifier remains the sole rollback trigger.  A
                    # failed condition activation must never be converted into
                    # an artificial verifier failure merely to manufacture the
                    # desired rollback terminal.
                    if controlled_condition is not None and not controlled_condition.get("ok"):
                        service_verify = subprocess.CompletedProcess(
                            ["v7-service-matrix-test"],
                            0,
                            stdout="controlled verifier condition not activated; induced failure suppressed\n",
                        )
                    else:
                        service_verify = self._verify_emergency_required_services(move)
                    row["service_verify_rc"] = service_verify.returncode
                    row["service_verify_output"] = service_verify.stdout[-4000:]
                verification_failed = verify.returncode != 0 or (service_verify is not None and service_verify.returncode != 0)
                if verification_failed and self.args.rollback_on_verify_fail:
                    row["verification_failure_reason"] = "route_verify_failed"
                    if service_verify is not None and service_verify.returncode != 0:
                        row["verification_failure_reason"] = "required_service_verify_failed"
                        if "timeout" in str(service_verify.stdout or "").lower():
                            row["verification_failure_reason"] = "required_service_verify_timeout"
                    row["rollback_attempted"] = True
                    rollback_control = self._execution_control_decision(
                        mutation_kind="rollback",
                        action_class=self._execution_action_class(move.get("move_type", "")),
                        expected_generation=str(item_control.get("generation") or ""),
                        rollback_certified=True,
                        operation_id=operation_id,
                    )
                    if not rollback_control.get("rollback_only_allowed"):
                        row["rollback_rc"] = 2
                        row["rollback_result"] = "DENIED"
                        row["rollback_verdict"] = "ROLLBACK_DENIED"
                        row["terminal_outcome_classification"] = "ROLLBACK_DENIED"
                        results.append(row)
                        if bounded_checkpoint_enabled:
                            bounded_checkpoint = self._bounded_cohort_checkpoint(
                                plan,
                                selected_moves,
                                results=results,
                                terminal_state="IN_PROGRESS",
                                terminal_reason="member_terminal_recorded",
                            )
                        if len(selected_moves) > 1:
                            cohort_circuit_breaker.update({
                                "tripped": True,
                                "trigger_user": str(row.get("user_ip") or ""),
                                "trigger_terminal": "ROLLBACK_DENIED",
                                "remaining_not_attempted": max(0, len(selected_moves) - move_index - 1),
                            })
                            break
                        continue
                    self._active_execution_control = rollback_control
                    rollback = self._run_switch(ip, current, "rollback")
                    row["rollback_rc"] = rollback.returncode
                    row["rollback_output"] = rollback.stdout[-4000:]
                    row["rollback_result"] = "OK" if rollback.returncode == 0 else "FAIL"
                    row["rollback_verdict"] = "ROLLBACK_COMPLETED" if rollback.returncode == 0 else "ROLLBACK_FAILED"
                    row["terminal_outcome_classification"] = "ROLLBACK_SUCCESS" if rollback.returncode == 0 else "ROLLBACK_FAILURE"
                elif verification_failed:
                    row["terminal_outcome_classification"] = "VERIFY_FAILED"
                else:
                    row["terminal_outcome_classification"] = "SUCCESS"
            results.append(row)
            if bounded_checkpoint_enabled:
                bounded_checkpoint = self._bounded_cohort_checkpoint(
                    plan,
                    selected_moves,
                    results=results,
                    terminal_state="IN_PROGRESS",
                    terminal_reason="member_terminal_recorded",
                )
            if len(selected_moves) > 1 and row.get("terminal_outcome_classification") != "SUCCESS":
                cohort_circuit_breaker.update({
                    "tripped": True,
                    "trigger_user": str(row.get("user_ip") or ""),
                    "trigger_terminal": str(row.get("terminal_outcome_classification") or ""),
                    "remaining_not_attempted": max(0, len(selected_moves) - move_index - 1),
                })
                break
        if bounded_checkpoint_enabled:
            cohort_success = (
                len(results) == len(selected_moves)
                and all(
                    str(row.get("terminal_outcome_classification") or "") == "SUCCESS"
                    for row in results
                )
            )
            bounded_checkpoint = self._bounded_cohort_checkpoint(
                plan,
                selected_moves,
                results=results,
                terminal_state="SUCCESS" if cohort_success else "CONTAINED_STOP_SAFE",
                terminal_reason=(
                    "all_members_verified"
                    if cohort_success
                    else "circuit_breaker_or_member_non_success"
                ),
            )
        self._update_safety_after_apply(results)
        plan.setdefault("safety", {})["cohort_circuit_breaker"] = cohort_circuit_breaker
        if emergency_mode:
            incident = plan.setdefault("safety", {}).get("l3_incident")
            if isinstance(incident, dict):
                classifications = sorted({str(row.get("terminal_outcome_classification") or "") for row in results if row.get("terminal_outcome_classification")})
                incident["terminal_outcome"] = classifications[0] if len(classifications) == 1 else "PARTIAL_SUCCESS"
                surface = incident.get("operator_surface")
                if isinstance(surface, dict):
                    surface["execution_state"] = "TERMINAL"
                    surface["terminal_outcome"] = incident["terminal_outcome"]
                    surface["verification"] = "PASS" if incident["terminal_outcome"] == "SUCCESS" else "NON_SUCCESS"
                    surface["rollback"] = "COMPLETED" if incident["terminal_outcome"] == "ROLLBACK_SUCCESS" else ("FAILED" if incident["terminal_outcome"] == "ROLLBACK_FAILURE" else surface.get("rollback", "REQUIRED"))
                    surface["next_action"] = "close_outcome_and_report"
        return {
            "applied": True,
            "results": results,
            "safety_file": str(self.safety_file),
            "l3_execution_eligibility": l3_eligibility if l3_eligibility.get("active") else {},
            "cohort_circuit_breaker": cohort_circuit_breaker,
            "remaining_forward_mutations_stopped": cohort_circuit_breaker["tripped"],
            "bounded_cohort_transaction": bounded_checkpoint.get("checkpoint") or {},
        }

    def finalize_operation(self, plan: dict[str, Any]) -> dict[str, Any]:
        operation = plan.setdefault("operation", {})
        terminal = self._terminal_verdict(plan)
        operation.update(terminal)
        rollback = self._rollback_verdict(plan)
        if rollback:
            operation["rollback_verdict"] = rollback.get("rollback_verdict", "")
        audit = self._terminal_audit_reference(plan, rollback)
        if self.args.apply:
            audit = self._emit_terminal_audit(audit)
        plan["audit"] = audit
        plan["closure_target"] = self._closure_target(operation, audit)
        plan["passive_production_event_consumption"] = self._consume_passive_production_events()
        plan["l3_learning_closure"] = self._l3_materialize_learning_closure(plan)
        return plan

    def _consume_passive_production_events(self) -> dict[str, Any]:
        """Consume capture-only external events without entering the apply path.

        The service-matrix owner remains the producer.  This existing runtime
        owner only records the Situation -> STOP_SAFE no-action terminal and
        its replay/learning projection. Persistent unattributed service episodes
        are captured as natural-event candidates, never as natural-L8 credit.
        No Candidate, Packet, lease, routing mutation, Authority or L7/L8
        credit can result from this passive step.
        """
        path = self.event_dir / "service-failure-events.jsonl"
        source_rows = read_jsonl(path)[-2000:]
        persistence_samples = max(1, to_int(self.service_signal_policy.get("service_failure_persistence_samples"), 3))
        persistence_window = max(1, to_int(self.service_signal_policy.get("service_failure_persistence_window_seconds"), 180))
        event_by_id: dict[str, dict[str, Any]] = {}
        for row in source_rows:
            event_id = str(row.get("event_id") or "")
            provenance = str(row.get("event_provenance") or row.get("provenance") or "")
            evidence_class = str(row.get("evidence_class") or "")
            operator_event = provenance == "OPERATOR_INDUCED"
            source_incident_id = str(row.get("source_incident_id") or "")
            # A recovery/expiry record without its parent incident is useful
            # immutable diagnostics, but cannot legitimately own a compact
            # incident or an OMP successor.  Do not turn it into a synthetic
            # incident keyed by its event ID.
            recovery_event = (
                evidence_class == "PROBE_OBSERVED_RECOVERY_EVENT"
                and bool(source_incident_id)
            )
            expiry_event = (
                evidence_class == "PROBE_OBSERVED_EPISODE_EXPIRY"
                and bool(source_incident_id)
            )
            persistent_failure = (
                provenance == "EXTERNAL_UNATTRIBUTED"
                and evidence_class == "PROBE_OBSERVED_PRODUCTION_EVENT"
                and (
                    to_int(row.get("failure_samples"), 0) >= persistence_samples
                    or to_float(row.get("bad_for_seconds")) >= persistence_window
                )
            )
            if bool_value(row.get("capture_only")) and event_id and (
                operator_event or recovery_event or expiry_event or persistent_failure
            ):
                # Legacy producers could append the same deterministic event
                # more than once. The existing immutable event owner remains
                # untouched; the consumer canonicalizes by registry-owned ID.
                event_by_id[event_id] = row
        events = list(event_by_id.values())
        if not events:
            return {"active": False, "reason": "no_passive_capture_event", "records": {}}
        state = self._load_l3_runtime_state()
        consumed = state.setdefault("passive_event_consumptions", {})
        if not isinstance(consumed, dict):
            consumed = {}
            state["passive_event_consumptions"] = consumed
        new_events = [row for row in events if str(row["event_id"]) not in consumed]
        if not new_events:
            # A Matrix cycle can consume its passive observation before it
            # performs a bounded governed action.  The action's immutable
            # Outcome is then newer than the passive event but there is no
            # second event for this consumer to discover.  Reconcile that
            # existing packet-bound Outcome before the idempotent return so a
            # continuing incident cannot lose its causal successor merely
            # because event consumption is (correctly) exact-once.
            #
            # This is compact-state reconciliation only.  It cannot enter the
            # planner, create Candidate/Packet/lease, or cause Runtime apply.
            scope_reconciliation = self.reconcile_service_failure_execution_outcomes()
            return {
                "active": True,
                "reason": "already_consumed_idempotent",
                "event_ids": sorted(event_by_id),
                "records": {"outcome": 0, "decision_trace": 0, "learning": 0, "closure": 0},
                "scope_reconciliation": scope_reconciliation,
            }
        now = now_iso()
        outcome_rows: list[dict[str, Any]] = []
        decision_rows: list[dict[str, Any]] = []
        trust_rows: list[dict[str, Any]] = []
        closure_rows: list[dict[str, Any]] = []
        grouped: dict[str, list[dict[str, Any]]] = {}
        for event in new_events:
            group_id = str(event.get("source_incident_id") or event.get("event_id") or "")
            grouped.setdefault(group_id, []).append(event)
        omp_frontiers: list[dict[str, Any]] = []
        for group_id, group_events in sorted(grouped.items()):
            # A source incident may contain a terminal expiry/recovery and a
            # later revalidation in the same consumption batch.  Terminal
            # state belongs to the newest owner-backed observation, never to
            # an arbitrary event-id sort or to the mere presence of an older
            # expiry.  Otherwise an active, newly revalidated failure becomes
            # invisible and cannot reach the existing OMP successor.
            def event_order(item: dict[str, Any]) -> tuple[float, str]:
                observed = str(
                    item.get("observed_at")
                    or item.get("recovered_at")
                    or item.get("created_at")
                    or ""
                )
                return (parse_ts(observed), str(item.get("event_id") or ""))

            ordered_group_events = sorted(group_events, key=event_order)
            event = ordered_group_events[-1]
            source_event_ids = sorted(str(item["event_id"]) for item in group_events)
            event_id = group_id
            provenance_contract = passive_event_provenance_classification(event)
            operator_induced = provenance_contract["observation_provenance"] == "OPERATOR_INDUCED"
            latest_evidence_class = str(event.get("evidence_class") or "")
            recovery_observed = latest_evidence_class == "PROBE_OBSERVED_RECOVERY_EVENT"
            expiry_observed = latest_evidence_class == "PROBE_OBSERVED_EPISODE_EXPIRY"
            event_provenance = str(provenance_contract["observation_provenance"])
            evidence_class = (
                str(provenance_contract["evidence_class"])
                if operator_induced else
                (
                    "PASSIVE_RECOVERY_OBSERVATION" if recovery_observed
                    else "PASSIVE_EPISODE_EXPIRY_OBSERVATION" if expiry_observed
                    else "NATURAL_PRODUCTION_CANDIDATE"
                )
            )
            decision = (
                "NO_ACTION_EXTERNAL_OPERATOR_INDUCED_EVENT"
                if operator_induced else
                (
                    "NO_ACTION_RECOVERY_OBSERVATION_CONSUMED" if recovery_observed
                    else "NO_ACTION_EPISODE_EXPIRY_CONSUMED" if expiry_observed
                    else
                    "NO_ACTION_NATURAL_EVENT_PENDING_PROVENANCE_AND_LEGAL_OUTCOME"
                )
            )
            closure_reason = (
                "operator-induced external event consumed without execution"
                if operator_induced else (
                    "passive recovery consumed and linked to the original source incident" if recovery_observed
                    else "episode expiry consumed and linked to the original source incident" if expiry_observed
                    else
                    "persistent external service incident captured; natural provenance and legal outcome remain required"
                )
            )
            source_hashes = {
                str(key): str(value)
                for item in group_events
                for key, value in (
                    item.get("source_hashes") if isinstance(item.get("source_hashes"), dict) else {}
                ).items()
            }
            terminal = (
                "RECOVERY_OBSERVED_NO_ACTION" if recovery_observed
                else "EPISODE_EXPIRED_NO_ACTION" if expiry_observed
                else "STOP_SAFE_NO_ACTION"
            )
            situation_id = "situation_" + sha256_json({"source_incident_id": group_id, "source_event_ids": source_event_ids, "source_hashes": source_hashes})[:24]
            decision_trace_id = "decision_" + sha256_json({"source_incident_id": group_id, "terminal": terminal})[:24]
            learning_id = "learn_" + sha256_json({"event_id": event_id, "decision_trace_id": decision_trace_id})[:24]
            replay_fingerprint = "replay_" + sha256_json({
                "event_id": event_id, "situation_id": situation_id, "decision_trace_id": decision_trace_id,
                "expected": terminal, "actual": terminal,
            })[:24]
            base = {
                "event_id": event_id,
                "source_incident_id": group_id,
                "source_event_ids": source_event_ids,
                "event_provenance": event_provenance,
                "provenance_reconciliation": provenance_contract,
                "evidence_class": evidence_class,
                "source_event_path": str(path),
                "source_files": list(event.get("source_files") or []),
                "source_hashes": source_hashes,
                "channel": str(event.get("channel") or ""),
                "service": str(event.get("service") or ""),
                "services": sorted({
                    str(item.get("service") or "")
                    for item in group_events if str(item.get("service") or "")
                }),
                "failure_families": sorted({
                    str(item.get("failure_family") or "")
                    for item in group_events if str(item.get("failure_family") or "")
                }),
                "egress_identity_generation": str(event.get("egress_identity_generation") or ""),
                "failure_episode_id": str(event.get("failure_episode_id") or ""),
                "failure_episode_ids": sorted({
                    str(item.get("failure_episode_id") or "")
                    for item in group_events if str(item.get("failure_episode_id") or "")
                }),
                "failure_samples": to_int(event.get("failure_samples"), 0),
                "affected_users": list(event.get("affected_users") or []),
                "source_scope": (
                    dict(event.get("source_scope") or {})
                    if isinstance(event.get("source_scope"), dict) else {}
                ),
                "observed_at": str(event.get("observed_at") or ""),
                "terminal_resolution": {
                    "owner": "tools/v7-users-autoswitch._consume_passive_production_events",
                    "basis": "LATEST_OWNER_BACKED_EVENT_IN_SOURCE_INCIDENT",
                    "latest_event_id": str(event.get("event_id") or ""),
                    "latest_event_observed_at": str(event.get("observed_at") or event.get("recovered_at") or event.get("created_at") or ""),
                    "latest_evidence_class": latest_evidence_class,
                    "superseded_terminal_event_ids": [
                        str(item.get("event_id") or "")
                        for item in ordered_group_events[:-1]
                        if str(item.get("evidence_class") or "") in {
                            "PROBE_OBSERVED_RECOVERY_EVENT",
                            "PROBE_OBSERVED_EPISODE_EXPIRY",
                        }
                    ],
                },
                "situation_id": situation_id,
                "decision_trace_id": decision_trace_id,
                "learning_record_id": learning_id,
                "terminal_outcome_classification": terminal,
                "expected_terminal": terminal,
                "deterministic_replay_fingerprint": replay_fingerprint,
                "replay_verdict": "NO_DRIFT",
                "candidate_created": False,
                "packet_created": False,
                "lease_created": False,
                "execution_performed": False,
                "rollback_applicable": False,
                "natural_production_credit": False,
                "l7_credit": False,
                "synthetic_evidence_created": False,
                "runtime_mutation_performed": False,
                "routing_mutation_performed": False,
                "users_moved": 0,
                "apply_executed": False,
            }
            projection = self._materialize_passive_incident_projection(
                state,
                base,
                terminal=terminal,
                recovery_observed=recovery_observed,
                expiry_observed=expiry_observed,
            )
            base["incident_key"] = str(projection.get("incident_key") or "")
            decision_rows.append({
                "schema_version": "v7.passive-production-event-decision-trace.v1",
                **base,
                "created_at": now,
                "classification": "STOP_SAFE",
                "decision": decision,
                "reason": "no current authority or packet may be reused; passive event capture is not execution authority",
                "consumer": "tools/v7-users-autoswitch._consume_passive_production_events",
            })
            outcome_rows.append({
                "schema_version": "v7.passive-production-event-outcome.v1",
                **base,
                "created_at": now,
                "outcome_status": terminal.lower(),
                "verification": {"source_snapshot_bound": bool(source_hashes), "execution_absent": True, "rollback": "NOT_APPLICABLE"},
                "temporal_observations": {
                    "initial": not recovery_observed,
                    "recovery_observed": recovery_observed,
                    "recovered_at": str(event.get("recovered_at") or ""),
                    "expiry_observed": expiry_observed,
                    "expired_at": str(event.get("expired_at") or ""),
                    "state": (
                        "RECOVERED" if recovery_observed
                        else "EXPIRED" if expiry_observed
                        else "PENDING_PASSIVE_RECOVERY_OBSERVATION"
                    ),
                },
                "learning": {"learning_record_id": learning_id, "consumed": True, "scope": "OBSERVATION_ONLY_NO_TRUST_OR_AUTHORITY_CHANGE"},
            })
            trust_rows.append({
                "schema_version": "v7.passive-production-event-learning.v1",
                **base,
                "created_at": now,
                "learning_record_id": learning_id,
                "delta": 0.0,
                "scope": "OBSERVATION_ONLY_NO_TRUST_OR_AUTHORITY_CHANGE",
            })
            closure_rows.append({
                "schema_version": "v7.passive-production-event-closure.v1",
                **base,
                "created_at": now,
                "object_type": "passive_production_event",
                "object_id": event_id,
                "closure_state": (
                    "RECOVERED" if recovery_observed
                    else "EXPIRED" if expiry_observed
                    else "CAPTURED_STOP_SAFE"
                ),
                "closure_reason": closure_reason,
                "learning_record_id": learning_id,
            })
            for source_event_id in source_event_ids:
                consumed[source_event_id] = {
                    "consumed_at": now,
                    "source_incident_id": group_id,
                    "situation_id": situation_id,
                    "decision_trace_id": decision_trace_id,
                    "learning_record_id": learning_id,
                    "terminal": terminal,
                    "replay_fingerprint": replay_fingerprint,
                }
            omp_frontiers.append({
                "frontier_id": (
                    "V7_SERVICE_FAILURE_RECOVERY_RECONCILIATION" if recovery_observed
                    else "V7_SERVICE_FAILURE_EPISODE_EXPIRY_RECONCILIATION" if expiry_observed
                    else
                    "V7_SERVICE_FAILURE_INCIDENT_RECONCILIATION"
                ),
                "source_incident_id": group_id,
                "channel": str(event.get("channel") or ""),
                "failure_families": list(base["failure_families"]),
                "action_class": (
                    "recovery admission and anti-flap" if recovery_observed
                    else "episode expiry and new-generation reconciliation" if expiry_observed
                    else
                    "service failure attribution and safe response"
                ),
                "owner": "OMP_EXISTING_PRODUCT_ENGINEERING_FRONTIER",
                "execution_authority_granted": False,
            })
        append_jsonl(self.state_dir / "execution-events.jsonl", decision_rows + outcome_rows)
        append_jsonl(self.state_dir / "runtime-trust.jsonl", trust_rows)
        append_jsonl(self.state_dir / "closure-records.jsonl", closure_rows)
        self._write_l3_runtime_state(state)
        # A passive observation may carry an older Matrix source snapshot.
        # Before handing it to any downstream consumer, restore the compact
        # current-source projection from the existing live-route owner.  This
        # is read-model reconciliation only; it cannot make an action.
        scope_reconciliation = self.reconcile_service_failure_execution_outcomes()
        return {
            "active": True,
            "reason": "consumed",
            "event_ids": sorted(str(row["event_id"]) for row in new_events),
            "source_incident_ids": sorted(grouped),
            "records": {"outcome": len(outcome_rows), "decision_trace": len(decision_rows), "learning": len(trust_rows), "closure": len(closure_rows)},
            "omp_frontiers": omp_frontiers,
            "execution_forbidden": True,
            "natural_production_credit": False,
            "l7_credit": False,
            "natural_event_candidates_captured": sum(
                1
                for rows in grouped.values()
                if any(
                    str(row.get("event_provenance") or row.get("provenance") or "") == "EXTERNAL_UNATTRIBUTED"
                    and str(row.get("evidence_class") or "") == "PROBE_OBSERVED_PRODUCTION_EVENT"
                    for row in rows
                )
            ),
            "recovery_incidents_consumed": sum(
                1
                for rows in grouped.values()
                if any(
                    str(row.get("evidence_class") or "") == "PROBE_OBSERVED_RECOVERY_EVENT"
                    for row in rows
                )
            ),
            "scope_reconciliation": scope_reconciliation,
        }

    @staticmethod
    def _service_failure_automation_obligation_id(row: dict[str, Any]) -> str:
        return "sfaob_" + sha256_json({
            "source_incident_id": str(row.get("source_incident_id") or row.get("object_id") or ""),
            "situation_id": str(row.get("situation_id") or ""),
            "decision_trace_id": str(row.get("decision_trace_id") or ""),
            "terminal": str(row.get("terminal_outcome_classification") or row.get("closure_state") or ""),
            "provenance": str(row.get("event_provenance") or ""),
        })[:24]

    @staticmethod
    def _service_failure_stop_safe_classification(
        closure: dict[str, Any],
        decisions: list[dict[str, Any]],
    ) -> tuple[str, str, str]:
        if not all(str(closure.get(key) or "") for key in ("source_incident_id", "situation_id", "decision_trace_id")):
            return (
                "STOP_SAFE_DATA_OR_EVIDENCE_GAP",
                "passive terminal lacks the immutable Situation, incident or Decision Trace identity",
                "V7_SERVICE_FAILURE_AUTOMATION_CAPTURE_BINDING_REPAIR",
            )
        closure_state = str(closure.get("closure_state") or "").upper()
        terminal = str(closure.get("terminal_outcome_classification") or "").upper()
        provenance = str(closure.get("event_provenance") or "").upper()
        if provenance == "OPERATOR_INDUCED":
            return (
                "STOP_SAFE_EXTERNAL_OWNER_REQUIRED",
                "external operator provenance is not execution authority",
                "EXTERNAL_OWNER_BOUNDARY",
            )
        if closure_state in {"RECOVERED", "EXPIRED"} or terminal.startswith(("RECOVERY", "EPISODE_EXPIRED")):
            return (
                "CORRECT_SAFE_TERMINAL",
                "recovery or expiry is already a legal no-action terminal",
                "NONE",
            )
        movable = [
            row for row in decisions
            if str(row.get("recommended_egress") or "")
            and str(row.get("recommended_egress") or "") != str(row.get("current_egress") or "")
        ]
        if not movable:
            return (
                "STOP_SAFE_NO_SAFE_TARGET",
                "existing planner found no safe target for the failed source",
                "NONE",
            )
        return (
            "STOP_SAFE_AUTHORITY_REQUIRED",
            "a safe planner target exists but passive capture does not grant current execution authority",
            "V7_SERVICE_FAILURE_AUTOMATION_AUTHORITY_RECONCILIATION",
        )

    def _standing_delegated_policy_status(self) -> dict[str, Any]:
        """Read the existing standing-policy owner without treating it as a Packet grant.

        The advisory/OMP lane must distinguish an expired legacy one-use
        contract from an active owner-issued standing contract.  It still
        cannot create a Candidate, Packet, lease or runtime action: the
        bounded executor revalidates the fresh event and every live gate.
        """
        policy_root = getattr(self, "policy", {})
        policy_root = policy_root if isinstance(policy_root, dict) else {}
        contract = policy_root.get("delegated_autonomy_policy")
        contract = contract if isinstance(contract, dict) else {}
        args = getattr(self, "args", None)
        audit_store = Path(getattr(
            args,
            "action_class_audit_store",
            str(operator_execution.DEFAULT_PRODUCTION_OPERATOR_EXECUTION_AUDIT_STORE),
        ))
        validation = operator_execution.validate_standing_delegated_operational_policy(
            contract,
            audit_records=operator_execution.read_live_execution_lineage_records(
                audit_store
            ),
        )
        runtime_axes = operator_execution.standing_delegated_policy_runtime_axes(
            validation.get("contract") or contract
        )
        return {
            "valid": bool(validation.get("ok")),
            "blockers": list(validation.get("errors") or []),
            "contract_id": str(contract.get("contract_id") or ""),
            "contract_hash": str(contract.get("contract_hash") or ""),
            "expires_at": str(contract.get("expires_at") or ""),
            "policy_scope_hash": str(contract.get("policy_scope_hash") or ""),
            "runtime_scope_axes": runtime_axes,
            "truth_source": "existing_delegated_autonomy_policy_and_operator_execution_audit",
            "runtime_mutation_performed": False,
        }

    def reconcile_service_failure_shadow_outcomes(self) -> dict[str, Any]:
        """Attach only exact, owner-backed execution outcomes to shadow rows."""
        shadow_path = self.state_dir / "shadow-autonomy-decisions.jsonl"
        history = read_jsonl(shadow_path)
        executions = read_jsonl(self.state_dir / "execution-events.jsonl")
        existing = {
            (str(row.get("decision_id") or ""), str(row.get("outcome_id") or ""))
            for row in history
            if str(row.get("record_type") or "") == shadow_autonomy.OUTCOME_COMPARISON_RECORD_TYPE
        }
        appended: list[dict[str, Any]] = []
        for decision in history:
            if str(decision.get("record_type") or "") != shadow_autonomy.DECISION_RECORD_TYPE:
                continue
            source_incident_id = str(decision.get("source_incident_id") or "")
            if not source_incident_id:
                continue
            for outcome in executions:
                if str(outcome.get("source_incident_id") or "") != source_incident_id:
                    continue
                actually_executed = (
                    outcome.get("apply_executed") is True
                    or outcome.get("execution_performed") is True
                    or bool(outcome.get("operation_id"))
                )
                if not actually_executed:
                    continue
                outcome_id = str(outcome.get("outcome_id") or outcome.get("execution_id") or outcome.get("object_id") or outcome.get("operation_id") or "")
                decision_id = str(decision.get("decision_id") or "")
                if not outcome_id or (decision_id, outcome_id) in existing:
                    continue
                verification = outcome.get("verification_result") if isinstance(outcome.get("verification_result"), dict) else {}
                projected = {
                    **outcome,
                    "outcome_id": outcome_id,
                    "apply_executed": True,
                    "execution_performed": True,
                    "verification_passed": verification.get("success") is True,
                    "owner": "existing execution outcome owner",
                }
                appended.append(shadow_autonomy.observed_outcome_comparison_record(decision, projected))
        if appended:
            append_jsonl(shadow_path, appended)
        return {
            "active": bool(appended),
            "observed_outcome_comparisons_added": len(appended),
            "reason": "exact_owner_backed_outcomes_reconciled" if appended else "no_exact_execution_outcome_available",
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
        }

    def materialize_service_failure_automation_advisory(self, plan: dict[str, Any]) -> dict[str, Any]:
        """Turn existing passive terminals into one bounded OMP-ready obligation.

        This is deliberately advisory-only.  It reuses closure-records, the
        existing planner and the existing Shadow Autonomy JSONL; it neither
        creates a Candidate/Packet/lease nor enters the apply path.
        """
        closure_path = self.state_dir / "closure-records.jsonl"
        shadow_path = self.state_dir / "shadow-autonomy-decisions.jsonl"
        outcome_reconciliation = self.reconcile_service_failure_shadow_outcomes()
        # Refresh the existing current-source denominator before choosing one
        # bounded successor.  A later zero-user incident must not starve an
        # older still-open incident that actually has users on its failed
        # source.  This is selection only; the normal authority/action gates
        # remain downstream and unchanged.
        pre_obligation_scope_reconciliation = self.reconcile_service_failure_execution_outcomes()
        pre_obligation_state = self._load_l3_runtime_state()
        pre_obligation_incidents = pre_obligation_state.get("incidents") if isinstance(pre_obligation_state.get("incidents"), dict) else {}
        closures = read_jsonl(closure_path)
        existing = {
            str(row.get("automation_obligation_id") or "")
            for row in closures
            if str(row.get("object_type") or "") == "service_failure_automation_obligation"
        }
        passive = [
            row for row in closures
            if str(row.get("object_type") or "") == "passive_production_event"
        ]
        candidates = []
        correct_terminals_skipped = 0
        for row in passive:
            terminal = str(row.get("terminal_outcome_classification") or "").upper()
            if terminal.startswith(("RECOVERY", "EPISODE_EXPIRED")):
                # These terminals are already consumed as no-action evidence.
                # They must never outrank a newer open revalidation merely
                # because they were appended later in the same batch.
                correct_terminals_skipped += 1
                continue
            obligation_id = self._service_failure_automation_obligation_id(row)
            if obligation_id and obligation_id not in existing:
                candidate_incident_key = str(row.get("incident_key") or self._passive_incident_projection_key(
                    str(row.get("source_incident_id") or row.get("object_id") or "")
                ))
                candidate_incident = pre_obligation_incidents.get(candidate_incident_key) if isinstance(pre_obligation_incidents.get(candidate_incident_key), dict) else {}
                candidate_scope = (
                    candidate_incident.get("current_source_scope")
                    if isinstance(candidate_incident.get("current_source_scope"), dict)
                    else (candidate_incident.get("scope_accounting") if isinstance(candidate_incident.get("scope_accounting"), dict) else {})
                )
                if not candidate_scope and isinstance(row.get("source_scope"), dict):
                    candidate_scope = row.get("source_scope") or {}
                candidate_scope_count = max(0, to_int(candidate_scope.get("affected_scope_count"), len(list(row.get("affected_users") or []))))
                candidates.append((
                    int(candidate_scope_count > 0),
                    candidate_scope_count,
                    str(row.get("observed_at") or row.get("created_at") or ""),
                    obligation_id,
                    row,
                ))
        if not candidates:
            return {
                "schema_version": "v7.service-failure-automation-advisory.v1",
                "active": False,
                "reason": "no_open_unmaterialized_passive_terminal",
                "correct_terminals_skipped": correct_terminals_skipped,
                "outcome_reconciliation": outcome_reconciliation,
                "forbidden_effects": {"runtime_apply": False, "routing_mutation": False, "user_movement": 0, "authority_change": False},
            }
        _has_live_scope, _scope_count, _observed, obligation_id, closure = sorted(
            candidates,
            key=lambda row: (row[0], row[1], row[2], row[3]),
            reverse=True,
        )[0]
        source = str(closure.get("channel") or "")
        # The passive terminal is an immutable observation, not the live
        # source denominator.  Before materializing an OMP obligation, reuse
        # the existing execution-outcome reconciler and L3 incident record so
        # the obligation carries the same current scope as CPS.  This prevents
        # a historical closure with an empty compact user list from silently
        # producing an ``affected_users_count=0`` successor for an open
        # incident.  No route, Packet, lease, or policy is touched here.
        pre_obligation_incident_key = str(closure.get("incident_key") or self._passive_incident_projection_key(
            str(closure.get("source_incident_id") or closure.get("object_id") or "")
        ))
        pre_obligation_incident = pre_obligation_incidents.get(pre_obligation_incident_key) if isinstance(pre_obligation_incidents.get(pre_obligation_incident_key), dict) else {}
        current_source_scope = (
            pre_obligation_incident.get("current_source_scope")
            if isinstance(pre_obligation_incident.get("current_source_scope"), dict)
            else (pre_obligation_incident.get("scope_accounting") if isinstance(pre_obligation_incident.get("scope_accounting"), dict) else {})
        )
        decisions = [
            row for row in (plan.get("decisions") or [])
            if not source or str(row.get("current_egress") or "") == source
        ]
        classification, reason, product_frontier = self._service_failure_stop_safe_classification(closure, decisions)
        movable = [
            row for row in decisions
            if str(row.get("recommended_egress") or "")
            and str(row.get("recommended_egress") or "") != str(row.get("current_egress") or "")
        ]
        authority_policy = getattr(self, "authority_budget_policy", {})
        authority_safe_cohort = max(0, to_int(
            authority_policy.get("current_allowed_user_budget") if isinstance(authority_policy, dict) else 0,
            0,
        ))
        now = now_iso()
        affected = list(closure.get("affected_users") or [])
        current_affected_count = max(0, to_int(current_source_scope.get("affected_scope_count"), len(affected)))
        current_affected_fingerprint = str(current_source_scope.get("affected_scope_fingerprint") or "")
        unresolved_count = max(
            0,
            to_int(current_source_scope.get("unresolved_scope_count"), current_affected_count),
        )
        emergency_policy = getattr(self, "emergency_failover_policy", {})
        emergency_policy = emergency_policy if isinstance(emergency_policy, dict) else {}
        runtime_axes = (
            emergency_policy.get("runtime_scope_axes")
            if isinstance(emergency_policy.get("runtime_scope_axes"), dict)
            else {}
        )
        controlled_source_context = self._controlled_certification_failure_context(source)
        current_tier = max(
            0,
            to_int(
                runtime_axes.get("controlled_certification_runtime_max")
                if bool_value(controlled_source_context.get("confirmed"))
                else runtime_axes.get("ordinary_production_runtime_max"),
                emergency_policy.get("max_users_per_run", 1),
            ),
        )
        standing_policy = self._standing_delegated_policy_status()
        standing_policy_active = bool(standing_policy.get("valid"))
        standing_expiry = str(standing_policy.get("expires_at") or "")
        request_safe_scope = current_tier
        adaptive_cohort = build_service_failure_adaptive_cohort_contract(
            movable,
            incident_required_scope=unresolved_count,
            generic_certified_scope=operator_execution.GENERIC_MOVEMENT_ENGINEERING_CERTIFIED_MAX_USERS,
            adapter_compatible_scope=operator_execution.SERVICE_FAILURE_ADAPTER_ENGINEERING_MAX_USERS,
            authority_safe_scope=authority_safe_cohort,
            runtime_safe_scope=current_tier,
            verification_safe_scope=operator_execution.SERVICE_FAILURE_ADAPTER_ENGINEERING_MAX_USERS,
            rollback_containment_safe_scope=operator_execution.SERVICE_FAILURE_ADAPTER_ENGINEERING_MAX_USERS,
            circuit_breaker_safe_scope=operator_execution.SERVICE_FAILURE_ADAPTER_ENGINEERING_MAX_USERS,
            request_safe_scope=request_safe_scope,
            measured_at=now,
            expires_at=standing_expiry,
        )
        chosen = list(adaptive_cohort.get("bounded_shadow_moves") or [])
        target_capacity_snapshot = {
            str(row.get("recommended_egress") or ""): row.get("capacity_decision")
            for row in chosen if str(row.get("recommended_egress") or "")
        }
        safety = plan.get("safety") if isinstance(plan.get("safety"), dict) else {}
        action_boundary = safety.get("action_class_execution_boundary") if isinstance(safety.get("action_class_execution_boundary"), dict) else {
            "schema_version": "v7.service-failure-action-class-execution-boundary.v1",
            "status": "STOP_SAFE_ACTION_CLASS_BOUNDARY_NOT_EVALUATED",
            "execution_authorized": False,
            "candidate_created": False,
            "packet_created": False,
            "lease_created": False,
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
            "authority_expanded": False,
        }
        if standing_policy_active and classification == "STOP_SAFE_AUTHORITY_REQUIRED":
            classification = "STOP_SAFE_FRESH_EVENT_REVALIDATION_REQUIRED"
            reason = (
                "the exact standing delegated policy is active; the existing "
                "bounded executor must wait for and revalidate a fresh matching "
                "service-failure event before any action"
            )
            product_frontier = "V7_SERVICE_FAILURE_AUTOMATION_FRESH_EVENT_REVALIDATION"
            action_boundary = {
                **action_boundary,
                "status": "STANDING_DELEGATED_POLICY_ACTIVE_FRESH_EVENT_REVALIDATION_REQUIRED",
                "blockers": [],
                "standing_delegated_policy": standing_policy,
                "next_required_objects": [
                    "fresh_matching_service_failure_event",
                    "fresh_candidate",
                    "packet",
                    "lease",
                    "verification",
                    "rollback",
                ],
                "execution_authorized": False,
                "candidate_created": False,
                "packet_created": False,
                "lease_created": False,
                "runtime_mutation_performed": False,
                "routing_mutation_performed": False,
                "users_moved": 0,
            }
        obligation = {
            "schema_version": "v7.service-failure-automation-obligation.v1",
            "object_type": "service_failure_automation_obligation",
            "object_id": obligation_id,
            "automation_obligation_id": obligation_id,
            "closure_state": "READY_FOR_OMP_CONSUMPTION",
            "created_at": now,
            "source_incident_id": str(closure.get("source_incident_id") or closure.get("object_id") or ""),
            "incident_key": str(closure.get("incident_key") or self._passive_incident_projection_key(
                str(closure.get("source_incident_id") or closure.get("object_id") or "")
            )),
            "situation_id": str(closure.get("situation_id") or ""),
            "decision_trace_id": str(closure.get("decision_trace_id") or ""),
            "event_provenance": str(closure.get("event_provenance") or "UNKNOWN"),
            "evidence_class": str(closure.get("evidence_class") or "UNKNOWN_EVENT"),
            "channel": source,
            "failure_families": list(closure.get("failure_families") or []),
            "affected_users_count": current_affected_count,
            "aggregate_impact_users": current_affected_count,
            "current_source_scope": {
                "affected_scope_count": current_affected_count,
                "affected_scope_fingerprint": current_affected_fingerprint,
                "protected_scope_count": max(0, to_int(current_source_scope.get("protected_scope_count"), 0)),
                "unresolved_scope_count": unresolved_count,
                "explicitly_excluded_or_recovered_scope_count": max(0, to_int(current_source_scope.get("explicitly_excluded_or_recovered_scope_count"), 0)),
                "raw_user_list_stored": False,
            },
            "bounded_recommendation_users": len(chosen),
            "current_certified_blast_radius_tier": current_tier,
            "runtime_scope_context": (
                "CONTROLLED_CERTIFICATION_CONTEXT"
                if bool_value(controlled_source_context.get("confirmed"))
                else "ORDINARY_PRODUCTION_SERVICE_FAILURE"
            ),
            "requested_blast_radius_tier": min(current_affected_count, max(1, current_tier)),
            "smallest_necessary_cohort": min(unresolved_count, len(movable)),
            "maximum_capacity_safe_cohort": int(
                ((adaptive_cohort.get("bounds") or {}).get("capacity_safe_scope") or {}).get("value") or 0
            ),
            "current_authority_safe_cohort": authority_safe_cohort,
            "effective_cohort": int(adaptive_cohort.get("effective_cohort") or 0),
            "effective_cohort_load": int(adaptive_cohort.get("effective_cohort_load") or 0),
            "effective_cohort_fingerprint": str(adaptive_cohort.get("cohort_fingerprint") or ""),
            "adaptive_cohort_contract": adaptive_cohort,
            "target_capacity_snapshot": target_capacity_snapshot,
            "next_tier_blocking_evidence_cell": "current action-class authority and real outcome coverage",
            "stop_safe_classification": classification,
            "classification_reason": reason,
            "last_responsible_link": "passive STOP_SAFE terminal -> incident-bound planner advisory -> existing OMP consumer",
            "responsibility_owner": "tools/v7-users-autoswitch",
            "product_evolution_frontier": product_frontier,
            "incident_frontier": "V7_SERVICE_FAILURE_AUTOMATION_INCIDENT_RECONCILIATION",
            "authority_reconciliation": (
                "STANDING_DELEGATED_POLICY_ACTIVE_REVALIDATE_FRESH_EVENT_BEFORE_ANY_MOVE"
                if standing_policy_active else
                "CURRENT_CPS_GOVERNED_ONLY_REQUIRED_BEFORE_ANY_MOVE"
            ),
            "action_class_execution_boundary": action_boundary,
            "shadow_allowed_action_status": str(action_boundary.get("status") or "STOP_SAFE_ACTION_CLASS_BOUNDARY_NOT_EVALUATED"),
            "candidate_created": False,
            "packet_created": False,
            "lease_created": False,
            "runtime_mutation_performed": False,
            "routing_mutation_performed": False,
            "users_moved": 0,
            "apply_executed": False,
            "authority_expanded": False,
            "production_maturity_changed": False,
        }
        shadow_rows = read_jsonl(shadow_path)
        shadow_ids = {str(row.get("decision_id") or "") for row in shadow_rows}
        shadow_record: dict[str, Any] = {}
        if chosen:
            selected = chosen[0]
            shadow_record = shadow_autonomy.shadow_decision_record({
                "user": str(selected.get("user_ip") or ""),
                "current_channel": str(selected.get("current_egress") or source),
                "recommended_channel": str(selected.get("recommended_egress") or ""),
                "recommendation": "move_recommended",
                "reasons": list(selected.get("reason") or []) + [classification],
                "trust": to_float(selected.get("trust"), 0.0),
                "risk": to_float(selected.get("risk"), 0.0),
                "prediction": selected.get("prediction") if isinstance(selected.get("prediction"), dict) else {},
                "blockers": [classification, "CPS_AUTHORITY_RECONCILIATION_REQUIRED"],
            }, now=now)
            shadow_record["decision_id"] = "shadow_" + sha256_json({
                "automation_obligation_id": obligation_id,
                "user": shadow_record.get("user"),
                "source": shadow_record.get("current_channel"),
                "target": shadow_record.get("recommended_target"),
            })[:24]
            shadow_record.update({
                "source_incident_id": obligation["source_incident_id"],
                "automation_obligation_id": obligation_id,
                "situation_id": obligation["situation_id"],
                "decision_trace_id": obligation["decision_trace_id"],
                "aggregate_impact_users": current_affected_count,
                "bounded_recommendation_users": 1,
                "execution_allowed_now": False,
                "allowed_action_status": obligation["shadow_allowed_action_status"],
                "action_class_execution_boundary": action_boundary,
                "runtime_mutation_performed": False,
                "users_moved": 0,
                "apply_executed": False,
                "autonomy_enabled": False,
            })
        append_jsonl(closure_path, [obligation])
        if shadow_record and str(shadow_record.get("decision_id") or "") not in shadow_ids:
            append_jsonl(shadow_path, [shadow_record])
        state = self._load_l3_runtime_state()
        projection = self._materialize_passive_incident_projection(
            state,
            closure,
            terminal=str(closure.get("terminal_outcome_classification") or "STOP_SAFE_NO_ACTION"),
            recovery_observed=str(closure.get("terminal_outcome_classification") or "") == "RECOVERY_OBSERVED_NO_ACTION",
            expiry_observed=str(closure.get("terminal_outcome_classification") or "") == "EPISODE_EXPIRED_NO_ACTION",
        )
        obligations = state.setdefault("service_failure_automation_obligations", {})
        if not isinstance(obligations, dict):
            obligations = {}
            state["service_failure_automation_obligations"] = obligations
        obligations[obligation_id] = {
            "status": "READY_FOR_OMP_CONSUMPTION",
            "source_incident_id": obligation["source_incident_id"],
            "classification": classification,
            "updated_at": now,
        }
        incident_key = str(projection.get("incident_key") or obligation.get("incident_key") or "")
        incidents = state.setdefault("incidents", {})
        incident_record = incidents.get(incident_key) if isinstance(incidents, dict) and isinstance(incidents.get(incident_key), dict) else {}
        if incident_record:
            incident_record["obligation_id"] = obligation_id
            incident_record["causal_lineage"] = {
                **(incident_record.get("causal_lineage") if isinstance(incident_record.get("causal_lineage"), dict) else {}),
                "obligation_id": obligation_id,
                "action_opportunity_id": str(incident_record.get("action_opportunity_id") or ""),
            }
            if str(incident_record.get("incident_state") or "") != "INTENT_CLOSED":
                incident_record["next_required_consumer"] = "tools/v7_sync_lib.consume_service_failure_automation_frontier"
                incident_record["reentry_condition"] = "existing OMP consumer consumes the exact ready obligation under closure-records.lock"
            incident_record["updated_at"] = now
            incidents[incident_key] = incident_record
        self._write_l3_runtime_state(state)
        # This advisory writes an obligation after planning.  Reconcile once
        # more so a stale passive closure cannot overwrite the current source
        # generation between the pre-plan reconciliation and the consumer.
        final_scope_reconciliation = self.reconcile_service_failure_execution_outcomes()
        return {
            "schema_version": "v7.service-failure-automation-advisory.v1",
            "active": True,
            "obligation": obligation,
            "shadow_decision_id": str(shadow_record.get("decision_id") or ""),
            "outcome_reconciliation": outcome_reconciliation,
            "pre_obligation_scope_reconciliation": pre_obligation_scope_reconciliation,
            "final_scope_reconciliation": final_scope_reconciliation,
            "next_output": obligation["incident_frontier"] if product_frontier == "NONE" else product_frontier,
            "forbidden_effects": {"runtime_apply": False, "routing_mutation": False, "user_movement": 0, "authority_change": False, "production_maturity_change": False},
        }

    def _l3_materialize_learning_closure(self, plan: dict[str, Any]) -> dict[str, Any]:
        safety = plan.get("safety") if isinstance(plan.get("safety"), dict) else {}
        incident = safety.get("l3_incident") if isinstance(safety.get("l3_incident"), dict) else {}
        l3_eligibility = safety.get("l3_execution_eligibility") if isinstance(safety.get("l3_execution_eligibility"), dict) else {}
        if not incident or str(incident.get("authority_object") or "") != "EMERGENCY_FAILOVER_AUTONOMY":
            return {"active": False, "reason": "not_l3"}
        operation = plan.get("operation") if isinstance(plan.get("operation"), dict) else {}
        operation_id = str(operation.get("operation_id") or "")
        if not operation_id:
            return {"active": True, "materialized": False, "reason": "operation_id_missing"}
        existing = self._authority_feedback_records_for_operation(operation_id)
        if all(existing.get(kind) for kind in ("outcome", "trust", "prediction", "recommendation", "closure")):
            self._l3_close_incident_and_update_capability(plan, already_materialized=True)
            return {"active": True, "materialized": False, "reason": "already_materialized"}

        apply_result = plan.get("apply_result") if isinstance(plan.get("apply_result"), dict) else {}
        results = [row for row in (apply_result.get("results") or []) if isinstance(row, dict)]
        if results:
            rows_for_feedback = results
        else:
            rows_for_feedback = [{
                "user_ip": ",".join(str(user) for user in (incident.get("affected_users") or []) if str(user)),
                "from": ",".join(str(item) for item in (incident.get("failed_sources") or []) if str(item)),
                "to": ",".join(str(item) for item in (incident.get("target_channels") or []) if str(item)),
                "terminal_outcome_classification": "NO_EXECUTION",
                "rollback_attempted": False,
            }]

        now = now_iso()
        terminal_state = str(operation.get("terminal_state") or "")
        terminal_reason = str(operation.get("terminal_reason") or "")
        incident_key = str(incident.get("incident_key") or "")
        selected_hash = str(operation.get("selected_move_hash") or incident.get("selected_move_hash") or "")
        outcome_rows: list[dict[str, Any]] = []
        prediction_rows: list[dict[str, Any]] = []
        trust_rows: list[dict[str, Any]] = []
        recommendation_rows: list[dict[str, Any]] = []
        closure_rows: list[dict[str, Any]] = []

        for index, row in enumerate(rows_for_feedback):
            classification = str(row.get("terminal_outcome_classification") or terminal_state or "NO_EXECUTION")
            if classification == "SUCCESS":
                outcome_status = "success"
                trust_delta = 1.0
                recommendation_delta = 1.0
            elif classification in {"ROLLBACK_SUCCESS", "ROLLBACK_FAILURE"}:
                outcome_status = "rollback_required"
                trust_delta = -0.5 if classification == "ROLLBACK_SUCCESS" else -1.0
                recommendation_delta = -0.7
            elif classification == "NO_EXECUTION":
                outcome_status = "no_execution"
                trust_delta = 0.0
                recommendation_delta = 0.0
            else:
                outcome_status = "failure"
                trust_delta = -1.0
                recommendation_delta = -1.0
            user = str(row.get("user_ip") or "")
            feedback_id = sha256_json({
                "operation_id": operation_id,
                "incident_key": incident_key,
                "index": index,
                "classification": classification,
                "user": user,
            })[:24]
            base = {
                "feedback_id": feedback_id,
                "operation_id": operation_id,
                "created_at": now,
                "user": user,
                "source": str(row.get("from") or ""),
                "target": str(row.get("to") or ""),
                "l3_incident_key": incident_key,
                "selected_move_hash": selected_hash,
                "terminal_state": terminal_state,
                "terminal_reason": terminal_reason,
                "terminal_outcome_classification": classification,
                "capability": "L3_EMERGENCY_AUTONOMOUS_FAILOVER",
                "runtime_cycle": "Wake->Observation->Planner->Authority->Eligibility->Execution->Verification->RollbackOrSuccess->Learning->Evidence->OMP->CapabilityState->NextRuntimeCycle",
            }
            outcome_rows.append({
                "schema_version": "v7.execution-outcome-feedback.v1",
                **base,
                "outcome_status": outcome_status,
                "verification_result": {
                    "operation_id": operation_id,
                    "success": classification == "SUCCESS",
                    "verify_rc": row.get("verify_rc"),
                    "service_verify_rc": row.get("service_verify_rc"),
                },
                "rollback_result": {
                    "rollback_required": classification in {"ROLLBACK_SUCCESS", "ROLLBACK_FAILURE"},
                    "rollback_verdict": row.get("rollback_verdict", ""),
                    "rollback_rc": row.get("rollback_rc"),
                },
            })
            prediction_rows.append({
                "schema_version": "v7.execution-prediction-feedback.v1",
                **base,
                "outcome_status": outcome_status,
                "prediction_expected": 1.0 if classification == "SUCCESS" else 0.0,
                "prediction_actual": 1.0 if classification == "SUCCESS" else 0.0,
                "delta": 1.0 if classification == "SUCCESS" else -1.0 if outcome_status == "failure" else 0.0,
            })
            trust_rows.append({
                "schema_version": "v7.execution-trust-feedback.v1",
                **base,
                "outcome_status": outcome_status,
                "subject": str(row.get("to") or ""),
                "delta": trust_delta,
                "reason": classification.lower(),
            })
            recommendation_rows.append({
                "schema_version": "v7.execution-recommendation-feedback.v1",
                **base,
                "outcome_status": outcome_status,
                "recommendation_hash": selected_hash,
                "delta": recommendation_delta,
                "outcome": outcome_status,
            })
            closure_rows.append({
                "schema_version": "v7.execution-feedback-closure.v1",
                **base,
                "outcome_status": outcome_status,
                "object_type": "execution_feedback",
                "object_id": feedback_id,
                "closure_state": "CLOSED",
                "closure_reason": f"l3 terminal feedback materialized: {classification}",
            })

        if not existing.get("outcome") or not existing.get("prediction"):
            append_jsonl(self.state_dir / "execution-events.jsonl", outcome_rows + prediction_rows)
        if not existing.get("trust"):
            append_jsonl(self.state_dir / "runtime-trust.jsonl", trust_rows)
        if not existing.get("recommendation"):
            append_jsonl(self.state_dir / "proposal-records.jsonl", recommendation_rows)
        if not existing.get("closure"):
            append_jsonl(self.state_dir / "closure-records.jsonl", closure_rows)
        capability = self._l3_close_incident_and_update_capability(plan, already_materialized=False)
        result = {
            "active": True,
            "materialized": True,
            "operation_id": operation_id,
            "incident_key": incident_key,
            "records": {
                "outcome": len(outcome_rows),
                "prediction": len(prediction_rows),
                "trust": len(trust_rows),
                "recommendation": len(recommendation_rows),
                "closure": len(closure_rows),
            },
            "evidence_paths": {
                key: [str(path) for path in paths]
                for key, paths in self._authority_promotion_feedback_paths().items()
            },
            "capability_state": capability,
            "eligibility_consumed": bool_value(l3_eligibility.get("active")),
        }
        closure = self._l3_execution_closure_verification(plan, result, capability)
        result["execution_closure_verification"] = closure
        plan.setdefault("safety", {})["l3_execution_closure_verification"] = closure
        return result

    def _l3_execution_closure_verification(
        self,
        plan: dict[str, Any],
        learning_closure: dict[str, Any],
        capability: dict[str, Any],
    ) -> dict[str, Any]:
        safety = plan.get("safety") if isinstance(plan.get("safety"), dict) else {}
        summary = plan.get("summary") if isinstance(plan.get("summary"), dict) else {}
        operation = plan.get("operation") if isinstance(plan.get("operation"), dict) else {}
        apply_result = plan.get("apply_result") if isinstance(plan.get("apply_result"), dict) else {}
        incident = safety.get("l3_incident") if isinstance(safety.get("l3_incident"), dict) else {}
        wake = safety.get("l3_wake") if isinstance(safety.get("l3_wake"), dict) else {}
        gate = safety.get("emergency_failover_autonomy") if isinstance(safety.get("emergency_failover_autonomy"), dict) else {}
        eligibility = safety.get("l3_execution_eligibility") if isinstance(safety.get("l3_execution_eligibility"), dict) else {}
        selected = [row for row in (plan.get("selected_moves") or []) if isinstance(row, dict)]
        results = [row for row in (apply_result.get("results") or []) if isinstance(row, dict)]
        records = learning_closure.get("records") if isinstance(learning_closure.get("records"), dict) else {}
        terminal = str(incident.get("terminal_outcome") or operation.get("terminal_state") or "")

        def status(ok: bool) -> str:
            return "PASS" if ok else "FAIL"

        def row(
            stage: str,
            *,
            output_produced: bool,
            consumer: str,
            consumed: bool,
            behavior_changed: bool,
            next_output: str,
            next_output_produced: bool,
        ) -> dict[str, Any]:
            failure_reasons: list[str] = []
            if not output_produced:
                failure_reasons.append("OUTPUT_NOT_PRODUCED")
            if not consumer:
                failure_reasons.append("ORPHAN_OUTPUT")
            if consumer and not consumed:
                failure_reasons.append("OUTPUT_NOT_CONSUMED")
            if consumed and not behavior_changed:
                failure_reasons.append("NO_BEHAVIOR_CHANGE")
            if behavior_changed and not next_output_produced:
                failure_reasons.append("NEXT_OUTPUT_NOT_PRODUCED")
            return {
                "stage": stage,
                "output_produced": status(output_produced),
                "consumer": consumer or "MISSING",
                "output_consumed": status(consumed),
                "consumption_verified": status(output_produced and bool(consumer) and consumed),
                "behavior_changed": status(behavior_changed),
                "next_output": next_output,
                "next_output_produced": status(next_output_produced),
                "failure_reasons": failure_reasons,
            }

        wake_consumed = bool_value(wake.get("accepted")) and bool(wake.get("consumed_event_ids"))
        incident_ready = str(incident.get("incident_state") or "") == "READY_FOR_EXECUTION"
        planner_hash_ok = bool(selected) and str(incident.get("selected_move_hash") or "") == str(operation.get("selected_move_hash") or "")
        authority_ok = bool_value(gate.get("ok")) and str(gate.get("decision") or "") == "authorize_bounded_emergency_failover"
        eligibility_ok = bool_value(eligibility.get("active")) and str(eligibility.get("decision") or "") in {"EXECUTE", "STOP_SAFE"}
        execution_ran_or_stopped = bool_value(apply_result.get("applied")) or str(apply_result.get("reason") or "") == "l3_execution_eligibility_stop_safe"
        verification_present = any(row.get("verify_rc") is not None for row in results)
        service_verification_present = any(row.get("service_verify_rc") is not None for row in results)
        rollback_or_success = terminal in {"SUCCESS", "ROLLBACK_SUCCESS", "ROLLBACK_FAILURE", "STOP_SAFE"}
        learning_materialized = bool_value(learning_closure.get("materialized")) or str(learning_closure.get("reason") or "") == "already_materialized"
        evidence_materialized = all(to_int(records.get(key), 0) > 0 for key in ("outcome", "prediction", "trust", "recommendation", "closure")) or str(learning_closure.get("reason") or "") == "already_materialized"
        capability_consumable = bool_value(capability.get("omp_consumable")) and bool_value(capability.get("runtime_ready_for_next_incident"))

        chains = [
            row(
                "Wake",
                output_produced=bool(wake.get("decision")),
                consumer="Incident",
                consumed=wake_consumed,
                behavior_changed=incident_ready,
                next_output="Incident",
                next_output_produced=bool(incident.get("incident_key")),
            ),
            row(
                "Incident",
                output_produced=bool(incident.get("incident_key")),
                consumer="Planner/Authority/Eligibility",
                consumed=incident_ready and bool_value(incident.get("consumed")),
                behavior_changed=planner_hash_ok,
                next_output="Planner selected move",
                next_output_produced=bool(selected),
            ),
            row(
                "Planner",
                output_produced=bool(selected),
                consumer="Authority",
                consumed=bool_value((incident.get("planner_consumption") or {}).get("runtime_replaced_planner")) is False and planner_hash_ok,
                behavior_changed=authority_ok,
                next_output="Authority decision",
                next_output_produced=bool(gate.get("decision")),
            ),
            row(
                "Authority",
                output_produced=bool(gate.get("decision")),
                consumer="Eligibility",
                consumed=bool_value(eligibility.get("active")),
                behavior_changed=eligibility_ok,
                next_output="Eligibility decision",
                next_output_produced=bool(eligibility.get("decision")),
            ),
            row(
                "Eligibility",
                output_produced=bool(eligibility.get("decision")),
                consumer="Execution",
                consumed=execution_ran_or_stopped,
                behavior_changed=str(eligibility.get("decision") or "") == "EXECUTE" and bool_value(apply_result.get("applied")),
                next_output="Execution result",
                next_output_produced=bool(results),
            ),
            row(
                "Execution",
                output_produced=bool(results),
                consumer="Verification",
                consumed=verification_present,
                behavior_changed=verification_present,
                next_output="Verification result",
                next_output_produced=verification_present or service_verification_present,
            ),
            row(
                "Verification",
                output_produced=verification_present or service_verification_present,
                consumer="Rollback or Success",
                consumed=rollback_or_success,
                behavior_changed=rollback_or_success,
                next_output="Terminal outcome",
                next_output_produced=bool(terminal),
            ),
            row(
                "Rollback or Success",
                output_produced=bool(terminal),
                consumer="Learning",
                consumed=learning_materialized,
                behavior_changed=learning_materialized,
                next_output="Learning records",
                next_output_produced=learning_materialized,
            ),
            row(
                "Learning",
                output_produced=learning_materialized,
                consumer="Evidence",
                consumed=evidence_materialized,
                behavior_changed=evidence_materialized,
                next_output="Evidence records",
                next_output_produced=evidence_materialized,
            ),
            row(
                "Evidence",
                output_produced=evidence_materialized,
                consumer="Capability State",
                consumed=bool(capability.get("state")),
                behavior_changed=bool_value(capability.get("validated")) or bool_value(capability.get("production_proven")),
                next_output="Capability state",
                next_output_produced=bool(capability.get("state")),
            ),
            row(
                "Capability State",
                output_produced=bool(capability.get("state")),
                consumer="OMP",
                consumed=bool_value(capability.get("omp_consumable")),
                behavior_changed=capability_consumable,
                next_output="OMP next runtime cycle signal",
                next_output_produced=bool_value(capability.get("runtime_ready_for_next_incident")),
            ),
            row(
                "OMP",
                output_produced=bool_value(capability.get("omp_consumable")),
                consumer="Next Runtime Cycle",
                consumed=bool_value(capability.get("runtime_ready_for_next_incident")),
                behavior_changed=bool_value(capability.get("runtime_ready_for_next_incident")),
                next_output="Runtime ready for next incident",
                next_output_produced=bool_value(capability.get("runtime_ready_for_next_incident")),
            ),
            row(
                "Next Runtime Cycle",
                output_produced=bool_value(capability.get("runtime_ready_for_next_incident")),
                consumer="Legal Terminal Consumer",
                consumed=bool_value(capability.get("runtime_ready_for_next_incident")),
                behavior_changed=bool_value(capability.get("runtime_ready_for_next_incident")),
                next_output="Runtime Ready For Next Cycle",
                next_output_produced=bool_value(capability.get("runtime_ready_for_next_incident")),
            ),
        ]
        broken = [
            {
                "stage": item["stage"],
                "failure_reasons": list(item.get("failure_reasons") or []),
            }
            for item in chains
            if item.get("failure_reasons")
        ]
        complete = not broken
        return {
            "schema_version": "v7.l3-execution-closure-verification.v1",
            "capability": "L3_EMERGENCY_AUTONOMOUS_FAILOVER",
            "source_owner": "tools/v7-users-autoswitch",
            "terminal_consumer": "Runtime Ready For Next Cycle",
            "terminal_consumer_verified": complete,
            "ready_for_safe_deploy": complete,
            "behavior_chain_status": "COMPLETE" if complete else "BROKEN",
            "summary_execution_mode": str(summary.get("execution_mode") or ""),
            "operation_id": str(operation.get("operation_id") or ""),
            "terminal_outcome": terminal,
            "chains": chains,
            "broken_chains": broken,
            "new_owner_created": False,
            "new_runtime_path_created": False,
            "new_lifecycle_created": False,
        }

    def _l3_close_incident_and_update_capability(self, plan: dict[str, Any], *, already_materialized: bool) -> dict[str, Any]:
        safety = plan.get("safety") if isinstance(plan.get("safety"), dict) else {}
        incident = safety.get("l3_incident") if isinstance(safety.get("l3_incident"), dict) else {}
        runtime_record = incident.get("runtime_lifecycle") if isinstance(incident.get("runtime_lifecycle"), dict) else {}
        operation = plan.get("operation") if isinstance(plan.get("operation"), dict) else {}
        apply_result = plan.get("apply_result") if isinstance(plan.get("apply_result"), dict) else {}
        operation_id = str(operation.get("operation_id") or "")
        incident_key = str(incident.get("incident_key") or runtime_record.get("incident_key") or "")
        if not incident_key:
            return {"state": "IMPLEMENTED", "updated": False, "reason": "incident_key_missing"}

        state = self._load_l3_runtime_state()
        incidents = state.setdefault("incidents", {})
        existing = incidents.get(incident_key) if isinstance(incidents.get(incident_key), dict) else {}
        record = {**existing, **runtime_record}
        record.setdefault("schema_version", "v7.l3-runtime-incident-record.v1")
        record["incident_key"] = incident_key
        record["updated_at"] = now_iso()
        record.setdefault("opened_at", now_iso())
        terminal = str(incident.get("terminal_outcome") or operation.get("terminal_state") or "UNKNOWN")
        terminal_state = str(operation.get("terminal_state") or "")
        terminal_reason = str(operation.get("terminal_reason") or "")
        applied = bool_value(apply_result.get("applied"))
        closed = terminal in {"SUCCESS", "ROLLBACK_SUCCESS", "ROLLBACK_FAILURE", "APPLY_FAILURE", "VERIFY_FAILED"} or terminal_state in {"APPLIED", "ROLLED_BACK", "ROLLBACK_FAILED", "FAILED", "VERIFY_FAILED"}
        suspended = terminal == "STOP_SAFE" or terminal_state == "DENIED"
        successful_moves = {
            str(row.get("user_ip") or "")
            for row in (apply_result.get("results") or [])
            if isinstance(row, dict)
            and str(row.get("terminal_outcome_classification") or "") == "SUCCESS"
            and str(row.get("from") or "") in set(str(item) for item in (record.get("failed_sources") or []) if str(item))
        }
        continuation_scopes = [
            self._l3_failed_source_scope(
                str(source),
                excluding_users=successful_moves,
                required_services=list(record.get("failed_required_services") or []),
            )
            for source in (record.get("failed_sources") or [])
            if str(source)
        ]
        active_continuations = [
            scope for scope in continuation_scopes
            if bool_value(scope.get("source_failed")) and to_int(scope.get("affected_users_count"), 0) > 0
        ]
        success_terminal = terminal == "SUCCESS" or terminal_state == "APPLIED"
        keep_open_for_remaining_users = closed and success_terminal and bool(active_continuations)
        record["incident_source_continuity"] = {
            "schema_version": "v7.l3-incident-source-continuity.v1",
            "active": bool(active_continuations),
            "kept_open": keep_open_for_remaining_users,
            "reason": "remaining_enabled_users_on_failed_incident_source" if keep_open_for_remaining_users else "terminal_closure_allowed",
            "successful_users_excluded": sorted(successful_moves),
            "scopes": continuation_scopes,
            "owner": "tools/v7-users-autoswitch._l3_close_incident_and_update_capability",
        }
        if keep_open_for_remaining_users:
            closed = False
            suspended = False
        record["status"] = "CLOSED" if closed else ("SUSPENDED" if suspended else "OPEN")
        if closed:
            record["closed_at"] = now_iso()
        elif keep_open_for_remaining_users:
            record["closed_at"] = ""
        record["terminal_outcome"] = terminal
        record["terminal_state"] = terminal_state
        record["terminal_reason"] = terminal_reason
        attempts = [row for row in (record.get("attempts") or []) if isinstance(row, dict)]
        if operation_id and not any(str(row.get("operation_id") or "") == operation_id for row in attempts):
            attempts.append({
                "operation_id": operation_id,
                "selected_move_hash": str(operation.get("selected_move_hash") or incident.get("selected_move_hash") or ""),
                "semantic_attempt_signature": str(runtime_record.get("semantic_attempt_signature") or ""),
                "terminal_outcome": terminal,
                "terminal_state": terminal_state,
                "applied": applied,
                "recorded_at": now_iso(),
                "already_materialized": already_materialized,
            })
        record["attempts"] = attempts[-50:]
        record["attempt_count"] = len(record["attempts"])
        record["consumed"] = True
        record["feeds_next_runtime_cycle"] = True
        incidents[incident_key] = record

        processed = set(str(item) for item in (state.get("processed_event_ids") or []))
        processed.update(str(item) for item in (((safety.get("l3_wake") or {}).get("consumed_event_ids") or [])) if str(item))
        state["processed_event_ids"] = sorted(processed)[-500:]

        rows = [row for row in read_jsonl(self.state_dir / "execution-events.jsonl") if "execution-" in str(row.get("schema_version") or "")]
        outcome_rows = [row for row in rows if "execution-outcome" in str(row.get("schema_version") or "")]
        success_count = sum(1 for row in outcome_rows if str(row.get("outcome_status") or "") == "success")
        rollback_count = sum(1 for row in outcome_rows if str(row.get("outcome_status") or "") == "rollback_required")
        failure_count = sum(1 for row in outcome_rows if str(row.get("outcome_status") or "") in {"failure", "no_execution"})
        closure_count = len([row for row in read_jsonl(self.state_dir / "closure-records.jsonl") if "execution-feedback-closure" in str(row.get("schema_version") or "")])
        capability_state = "IMPLEMENTED"
        if outcome_rows:
            capability_state = "VALIDATED"
        if success_count or rollback_count:
            capability_state = "PRODUCTION_PROVEN"
        if success_count and closure_count:
            capability_state = "CERTIFIED"
        if capability_state == "CERTIFIED" and bool_value(self.emergency_failover_policy.get("enabled")):
            capability_state = "ACTIVE_CAPABILITY"
        capability = {
            "schema_version": "v7.l3-capability-state.v1",
            "capability": "L3_EMERGENCY_AUTONOMOUS_FAILOVER",
            "state": capability_state,
            "implemented": True,
            "validated": bool(outcome_rows),
            "production_proven": bool(success_count or rollback_count),
            "certified": bool(success_count and closure_count),
            "active_capability": capability_state == "ACTIVE_CAPABILITY",
            "success_outcomes": success_count,
            "rollback_outcomes": rollback_count,
            "failure_or_no_execution_outcomes": failure_count,
            "closure_records": closure_count,
            "last_operation_id": operation_id,
            "last_incident_key": incident_key,
            "runtime_ready_for_next_incident": True,
            "omp_consumable": True,
            "updated": now_iso(),
        }
        state["capability"] = capability
        self._write_l3_runtime_state(state)
        write_json_atomic(self.l3_capability_state_file, capability)
        return capability

    def _terminal_verdict(self, plan: dict[str, Any]) -> dict[str, str]:
        apply_result = plan.get("apply_result") or {}
        if not apply_result.get("applied"):
            reason = str(apply_result.get("reason") or "not_applied")
            if reason == "dry_run":
                state = "DRY_RUN"
                reason = self._dry_run_terminal_reason(plan)
            elif reason == "no_selected_moves":
                state = "NOOP"
            else:
                state = "DENIED"
            return {"terminal_state": state, "terminal_reason": reason}
        results = apply_result.get("results") or []
        if any(row.get("rollback_rc") is not None for row in results):
            if all(row.get("rollback_rc") in (None, 0) for row in results):
                return {"terminal_state": "ROLLED_BACK", "terminal_reason": "verification_failed_rollback_completed"}
            return {"terminal_state": "ROLLBACK_FAILED", "terminal_reason": "verification_failed_rollback_failed"}
        if any(row.get("verify_rc") not in (None, 0) for row in results):
            return {"terminal_state": "VERIFY_FAILED", "terminal_reason": "route_verify_failed"}
        if any(row.get("rc") != 0 for row in results):
            if any(row.get("rc") == 0 for row in results):
                return {"terminal_state": "PARTIAL_SUCCESS", "terminal_reason": "partial_apply_failure"}
            return {"terminal_state": "FAILED", "terminal_reason": "switch_command_failed"}
        return {"terminal_state": "APPLIED", "terminal_reason": "selected_moves_applied"}

    def _dry_run_terminal_reason(self, plan: dict[str, Any]) -> str:
        if plan.get("selected_moves"):
            return "dry_run_selected_moves_available"
        snapshot_gate = (plan.get("safety") or {}).get("intelligence_snapshots") or {}
        if bool_value(snapshot_gate.get("active")) and bool_value(snapshot_gate.get("stop_required")):
            return "dry_run_intelligence_snapshot_stop_required"
        barrier = (plan.get("safety") or {}).get("restore_barrier") or {}
        if bool_value(barrier.get("active")):
            return "dry_run_restore_barrier_active"
        if bool_value(barrier.get("post_ttl_blocking")):
            return "dry_run_restore_barrier_post_ttl_blocking"
        for key in ("clearance_guard_reason", "clearance_generation_reason"):
            value = str(barrier.get(key) or "")
            if value:
                return f"dry_run_{value}"
        barrier_reason = str(barrier.get("reason") or "")
        if barrier_reason:
            return f"dry_run_restore_barrier_{barrier_reason}"
        for decision in plan.get("decisions") or []:
            for reason in decision.get("reason") or []:
                if str(reason).startswith(("restore_", "no_eligible_", "current_egress_")):
                    return f"dry_run_{reason}"
        return "dry_run_no_selected_moves"

    def _rollback_verdict(self, plan: dict[str, Any]) -> dict[str, Any]:
        rows = [
            row for row in ((plan.get("apply_result") or {}).get("results") or [])
            if row.get("rollback_attempted") or row.get("rollback_rc") is not None
        ]
        if not rows:
            return {}
        failed = [row for row in rows if row.get("rollback_rc") not in (0, None)]
        return {
            "rollback_attempted": True,
            "rollback_result": "FAIL" if failed else "OK",
            "rollback_verdict": "ROLLBACK_FAILED" if failed else "ROLLBACK_COMPLETED",
            "rollback_rows": len(rows),
        }

    def _restore_barrier_status_label(self, plan: dict[str, Any]) -> str:
        barrier = (plan.get("safety") or {}).get("restore_barrier") or {}
        if bool_value(barrier.get("active")):
            return "active"
        if bool_value(barrier.get("post_ttl_blocking")):
            return "post_ttl_blocking"
        if barrier.get("clearance_guard_reason"):
            return str(barrier.get("clearance_guard_reason"))
        if bool_value(barrier.get("expired")) and bool_value(barrier.get("cleared")):
            return "expired_cleared"
        return "settled"

    def _terminal_audit_reference(self, plan: dict[str, Any], rollback: dict[str, Any]) -> dict[str, Any]:
        operation = plan.get("operation") or {}
        metadata = {
            "operation_id": operation.get("operation_id", ""),
            "operation_owner": operation.get("operation_owner", ""),
            "operation_type": operation.get("operation_type", ""),
            "planner_generation_id": operation.get("planner_generation_id", ""),
            "selected_move_hash": operation.get("selected_move_hash", ""),
            "selected_move_count": operation.get("selected_move_count", 0),
            "runtime_snapshot_hash": operation.get("runtime_snapshot_hash", ""),
            "terminal_state": operation.get("terminal_state", ""),
            "terminal_reason": operation.get("terminal_reason", ""),
            "restore_barrier_status": self._restore_barrier_status_label(plan),
            "rollback_verdict": rollback.get("rollback_verdict", ""),
            "apply_requested": bool(plan.get("apply_requested")),
            "mode": plan.get("mode", ""),
            "target_egress": plan.get("target_egress", ""),
        }
        return {
            "action": "runtime_operation_terminal",
            "component": "autoswitch",
            "object_type": "runtime_operation",
            "object_id": operation.get("operation_id", ""),
            "result": operation.get("terminal_state", ""),
            "metadata": metadata,
            "emitted": False,
            "status": "ready_not_emitted_dry_run" if not self.args.apply else "ready_to_emit",
        }

    def _rollback_audit_reference(
        self,
        operation: dict[str, Any],
        packet: dict[str, Any],
        rollback_result: dict[str, Any],
    ) -> dict[str, Any]:
        source = packet.get("source_operation") or {}
        metadata = {
            "operation_id": operation.get("operation_id", ""),
            "operation_owner": operation.get("operation_owner", ""),
            "operation_type": operation.get("operation_type", ""),
            "source_operation_id": operation.get("source_operation_id", ""),
            "rollback_packet_id": packet.get("rollback_packet_id", ""),
            "selected_move_hash": operation.get("selected_move_hash", ""),
            "selected_move_count": source.get("selected_move_count", 0),
            "terminal_state": operation.get("terminal_state", ""),
            "terminal_reason": operation.get("terminal_reason", ""),
            "rollback_verdict": operation.get("rollback_verdict", operation.get("terminal_state", "")),
            "rollback_rows": len((rollback_result.get("results") or [])),
            "apply_requested": bool(self.args.apply),
            "mode": "rollback",
        }
        return {
            "action": "runtime_operation_terminal",
            "component": "autoswitch",
            "object_type": "runtime_rollback",
            "object_id": operation.get("operation_id", ""),
            "result": operation.get("terminal_state", ""),
            "metadata": metadata,
            "emitted": False,
            "status": "ready_not_emitted_dry_run" if not self.args.apply else "ready_to_emit",
        }

    def _emit_terminal_audit(self, audit: dict[str, Any]) -> dict[str, Any]:
        metadata = audit.get("metadata") or {}
        args = [
            f"object_type={audit.get('object_type', '')}",
            f"object_id={audit.get('object_id', '')}",
            f"result={audit.get('result', '')}",
        ]
        args.extend(f"{key}={value}" for key, value in metadata.items() if value not in (None, ""))
        try:
            proc = subprocess.run(
                ["v7-audit-log", audit["action"], audit["component"], f"operation_id={audit.get('object_id', '')}", *args],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=10,
            )
            audit["emitted"] = proc.returncode == 0
            audit["status"] = "emitted" if proc.returncode == 0 else "emit_failed"
            audit["output"] = proc.stdout[-1000:]
        except (OSError, subprocess.TimeoutExpired) as exc:
            audit["emitted"] = False
            audit["status"] = "emit_failed"
            audit["error"] = str(exc)
        return audit

    def _closure_target(self, operation: dict[str, Any], audit: dict[str, Any]) -> dict[str, Any]:
        return {
            "object_type": "runtime",
            "object_id": operation.get("operation_id", ""),
            "closure_owner": "admin/v7-admin-api",
            "observability_owner": "admin_core/operator_observability.py",
            "closure_state": "OPEN" if not audit.get("emitted") else "VERIFIED_READY",
            "closure_blocker": "" if audit.get("emitted") else "audit_missing",
        }

    def _future_iso(self, seconds: int) -> str:
        return datetime.fromtimestamp(time.time() + max(0, seconds), timezone.utc).isoformat()

    def _update_safety_after_apply(self, results: list[dict[str, Any]]) -> None:
        changed = False
        safety = self._compact_safety(self.safety_state)
        users = safety.setdefault("users", {})
        egress_rows = safety.setdefault("egress", {})
        for result in results:
            if result.get("rc") != 0:
                continue
            ts = now_iso()
            ip = str(result.get("user_ip") or "")
            target = str(result.get("to") or "")
            source = str(result.get("from") or "")
            move_type = str(result.get("move_type") or "")
            if not ip or not target:
                continue
            row = users.setdefault(ip, {})
            recent = row.setdefault("recent_switches", [])
            recent.append({"ts": ts, "from": source, "to": target, "move_type": move_type})
            row["recent_switches"] = recent[-10:]
            row["last_switch_at"] = ts
            targets = [item.get("to") for item in row["recent_switches"][-3:] if item.get("to")]
            row["last_targets"] = targets
            if len(targets) >= 3 and targets[-1] == targets[-3] and targets[-2]:
                blocked = row.setdefault("blocked_targets", {})
                blocked[str(targets[-2])] = self._future_iso(to_int(self.safety_policy.get("target_block_seconds"), 1800))

            recent_1h = [item for item in row["recent_switches"] if time.time() - parse_ts(item.get("ts")) <= 3600]
            recent_24h = [item for item in row["recent_switches"] if time.time() - parse_ts(item.get("ts")) <= 86400]
            row["switches_1h"] = len(recent_1h)
            row["switches_24h"] = len(recent_24h)
            if row["switches_24h"] >= to_int(self.safety_policy.get("user_freeze_switches_24h"), 5):
                row["penalty_until"] = self._future_iso(to_int(self.safety_policy.get("user_freeze_24h_seconds"), 21600))
            elif row["switches_1h"] >= to_int(self.safety_policy.get("user_freeze_switches_1h"), 2):
                row["penalty_until"] = self._future_iso(to_int(self.safety_policy.get("user_freeze_1h_seconds"), 3600))

            target_row = egress_rows.setdefault(target, {})
            incoming = target_row.setdefault("incoming", [])
            incoming.append({"ts": ts, "user_ip": ip, "move_type": move_type})
            target_row["incoming"] = incoming[-200:]
            reconnect_user = (self.reconnect_state.get("users") or {}).get(ip)
            if isinstance(reconnect_user, dict):
                reconnect_user["current_egress"] = target
                reconnect_user["last_rotation_epoch"] = int(time.time())
                reconnect_user["last_rotation_at"] = ts

            if result.get("verify_rc") not in (None, 0):
                failed = target_row.setdefault("failed_verifications", [])
                verification_scope = "selected_user_route_check" if str(result.get("route_verification_scope") or "") == "selected_user" else "global_route_check"
                failure_record = {
                    "ts": ts,
                    "user_ip": ip,
                    "verify_rc": result.get("verify_rc"),
                    "verification_scope": verification_scope,
                    "verification_failure_reason": str(result.get("verification_failure_reason") or ""),
                }
                if result.get("route_verification_expected_egress"):
                    failure_record["verification_expected_egress"] = str(result.get("route_verification_expected_egress") or "")
                failed.append(failure_record)
                target_row["failed_verifications"] = failed[-50:]
                scoped_failures = [
                    item for item in target_row["failed_verifications"]
                    if time.time() - parse_ts(item.get("ts")) <= 3600
                    and str(item.get("verification_scope") or "") == "selected_user_route_check"
                    and str(item.get("verification_expected_egress") or "") == target
                ]
                if len(scoped_failures) >= to_int(self.safety_policy.get("egress_quarantine_failed_verifications_1h"), 2):
                    target_row["quarantine_until"] = self._future_iso(to_int(self.safety_policy.get("egress_quarantine_seconds"), 3600))
                    target_row["quarantine_reason"] = "selected_user_route_verification_failed"
            changed = True
        if changed:
            safety = self._compact_safety(safety)
            write_json_atomic(self.safety_file, safety)
            self.safety_state = safety
            if isinstance(self.reconnect_state, dict):
                self.reconnect_state["updated"] = now_iso()
                write_json_atomic(self.reconnect_state_file, self.reconnect_state)

    def _run_switch(self, ip: str, egress: str, reason: str) -> subprocess.CompletedProcess[str]:
        control = dict(self._active_execution_control or {})
        mutation_kind = "rollback" if reason == "rollback" else "forward"
        live = self._execution_control_decision(
            mutation_kind=mutation_kind,
            action_class=str(control.get("action_class") or self._execution_action_class(reason)),
            expected_generation=str(control.get("generation") or ""),
            rollback_certified=mutation_kind == "rollback" and bool(control.get("rollback_only_allowed")),
            operation_id=str(control.get("operation_id") or ""),
            selected_move_hash=str(control.get("selected_move_hash") or ""),
            source_bundle_hash=str(control.get("source_bundle_hash") or ""),
            snapshot_bundle_hash=str(control.get("snapshot_bundle_hash") or ""),
            max_users=to_int(control.get("max_users"), 0),
        )
        if not live.get("allowed"):
            return subprocess.CompletedProcess(["v7-user-switch", ip, egress], 2, stdout="STOP_SAFE: autonomous execution control denied\n")
        env = os.environ.copy()
        env["V7_SWITCH_REASON"] = f"autoswitch_{reason}"
        env["V7_EXECUTION_CONTROL_GENERATION"] = str(live.get("generation") or "")
        env["V7_EXECUTION_MUTATION_KIND"] = mutation_kind
        env["V7_EXECUTION_OPERATION_ID"] = str(live.get("operation_id") or "")
        env["V7_EXECUTION_ACTION_CLASS"] = str(live.get("action_class") or "")
        env["V7_EXECUTION_SELECTED_MOVE_HASH"] = str(live.get("selected_move_hash") or "")
        env["V7_EXECUTION_SOURCE_BUNDLE_HASH"] = str(live.get("source_bundle_hash") or "")
        env["V7_EXECUTION_SNAPSHOT_BUNDLE_HASH"] = str(live.get("snapshot_bundle_hash") or "")
        env["V7_EXECUTION_MAX_USERS"] = str(live.get("max_users") or "")
        env["V7_EXECUTION_ROLLBACK_CERTIFIED"] = "1" if live.get("rollback_only_allowed") else "0"
        return subprocess.run(
            ["v7-user-switch", ip, egress],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=30,
            env=env,
        )

    def _verify_routes(self, user_ip: str = "", expected_egress: str = "") -> subprocess.CompletedProcess[str]:
        if user_ip:
            return self._verify_user_route(user_ip, expected_egress)
        return subprocess.run(
            ["v7-user-route-check"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=20,
        )

    def _verify_routes_for_apply(self, user_ip: str = "", expected_egress: str = "") -> subprocess.CompletedProcess[str]:
        if not user_ip:
            return self._verify_routes()
        try:
            return self._verify_routes(user_ip, expected_egress)  # type: ignore[misc]
        except TypeError:
            return self._verify_routes()

    def _verify_user_route(self, user_ip: str, expected_egress: str = "") -> subprocess.CompletedProcess[str]:
        argv = ["v7-users-autoswitch", "--verify-user-route", user_ip]
        lines = ["===== V7 SCOPED USER ROUTE REALITY CHECK =====", now_iso(), f"user_ip={user_ip}"]
        if not SAFE_IP_RE.match(user_ip):
            lines.append(f"FAIL: unsafe user ip: {user_ip}")
            return subprocess.CompletedProcess(argv, 1, stdout="\n".join(lines) + "\n")
        users = {user.ip: user for user in self._load_users()}
        user = users.get(user_ip)
        if not user or not user.enabled:
            lines.append(f"FAIL: user={user_ip} not found or disabled")
            return subprocess.CompletedProcess(argv, 1, stdout="\n".join(lines) + "\n")
        expected_id = str(expected_egress or user.current)
        egress = self._load_egress().get(expected_id)
        if not egress or not egress.interface:
            lines.append(f"FAIL: user={user_ip} unknown egress={expected_id}")
            return subprocess.CompletedProcess(argv, 1, stdout="\n".join(lines) + "\n")
        assign_path = self.state_dir / f"user-{user_ip}.assign"
        assign_egress = ""
        try:
            for raw in assign_path.read_text(encoding="utf-8").splitlines():
                if raw.startswith("egress="):
                    assign_egress = raw.split("=", 1)[1].strip()
                    break
        except OSError:
            assign_egress = "missing"
        lines.append(f"USER={user.ip} TABLE={user.table} REGISTRY_EGRESS={user.current} ASSIGN_EGRESS={assign_egress or 'missing'} EXPECTED_EGRESS={expected_id} EXPECTED_DEV={egress.interface}")
        if assign_egress and assign_egress != "missing" and assign_egress != user.current:
            lines.append(f"WARN: user={user.ip} registry/assign mismatch registry={user.current} assign={assign_egress}")
        else:
            lines.append(f"OK: user={user.ip} registry matches assignment")
        route_rc = 0
        try:
            table_route = subprocess.run(
                ["ip", "route", "show", "table", str(user.table)],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=10,
            )
            route_get = subprocess.run(
                ["ip", "route", "get", "8.8.8.8", "from", user.ip, "iif", "wg0"],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=10,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            lines.append(f"FAIL: route verification command failed: {exc}")
            return subprocess.CompletedProcess(argv, 1, stdout="\n".join(lines) + "\n")
        lines.append(f"table_route={table_route.stdout.strip()}")
        if f"default dev {egress.interface}" in table_route.stdout:
            lines.append(f"OK: user={user.ip} table={user.table} default dev {egress.interface}")
        else:
            route_rc = 1
            lines.append(f"FAIL: user={user.ip} table={user.table} does not default to {egress.interface}")
        lines.append(f"route_get={route_get.stdout.strip()}")
        if f"dev {egress.interface}" in route_get.stdout:
            lines.append(f"OK: user={user.ip} route_get uses {egress.interface}")
        elif "dev ens3" in route_get.stdout:
            route_rc = 1
            lines.append(f"FAIL: user={user.ip} route_get leaks to public ens3")
        else:
            route_rc = 1
            lines.append(f"FAIL: user={user.ip} route_get unexpected")
        lines.append("V7_SCOPED_USER_ROUTE_CHECK=" + ("OK" if route_rc == 0 else "FAIL"))
        return subprocess.CompletedProcess(argv, route_rc, stdout="\n".join(lines) + "\n")

    def _verify_emergency_required_services(self, move: dict[str, Any]) -> subprocess.CompletedProcess[str]:
        target = str(move.get("recommended_egress") or "")
        services = normalize_service_ids(move.get("important_services") or [])
        if not target or not services:
            return subprocess.CompletedProcess(["v7-service-matrix-test"], 1, stdout="missing target or services\n")
        timeout_sec = max(1, min(to_int(self.emergency_failover_policy.get("service_verify_timeout_seconds"), 5), 30))
        lock_timeout_sec = max(1, to_int(getattr(self.args, "service_matrix_lock_timeout_sec", DEFAULT_SERVICE_MATRIX_LOCK_TIMEOUT_SECONDS), DEFAULT_SERVICE_MATRIX_LOCK_TIMEOUT_SECONDS))
        command_timeout_sec = timeout_sec + lock_timeout_sec + 5
        outputs: list[str] = []
        for service in services:
            try:
                proc = subprocess.run(
                    [
                        "v7-service-matrix-test",
                        target,
                        service,
                        "--timeout",
                        str(timeout_sec),
                        "--state-dir",
                        str(self.state_dir),
                        "--lock-timeout-sec",
                        str(lock_timeout_sec),
                    ],
                    text=True,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    check=False,
                    timeout=command_timeout_sec,
                )
            except (OSError, subprocess.TimeoutExpired) as exc:
                return subprocess.CompletedProcess(["v7-service-matrix-test"], 1, stdout=f"service verify error: {exc}\n")
            outputs.append(proc.stdout or "")
            if proc.returncode != 0:
                return subprocess.CompletedProcess(proc.args, proc.returncode, stdout="".join(outputs))
        return subprocess.CompletedProcess(["v7-service-matrix-test"], 0, stdout="".join(outputs) or "service verify ok\n")


