    def _l3_close_incident_and_update_capability(self, plan: dict[str, Any], *, already_materialized: bool) -> dict[str, Any]:
        safety = plan.get("safety") if isinstance(plan.get("safety"), dict) else {}
        incident = safety.get("l3_incident") if isinstance(safety.get("l3_incident"), dict) else {}
        runtime_record = incident.get("runtime_lifecycle") if isinstance(incident.get("runtime_lifecycle"), dict) else {}
        operation = plan.get("operation") if isinstance(plan.get("operation"), dict) else {}
        apply_result = plan.get("apply_result") if isinstance(plan.get("apply_result"), dict) else {}
        operation_id = str(operation.get("operation_id") or "")
        incident_key = str(incident.get("incident_key") or runtime_record.get("incident_key") or "")
        if not incident_key:
            return {"state": "IMPLEMENTED", "updated": False, "reason": "incident_key_missing"}

        state = self._load_l3_runtime_state()
        incidents = state.setdefault("incidents", {})
        existing = incidents.get(incident_key) if isinstance(incidents.get(incident_key), dict) else {}
        record = {**existing, **runtime_record}
        record.setdefault("schema_version", "v7.l3-runtime-incident-record.v1")
        record["incident_key"] = incident_key
        record["updated_at"] = now_iso()
        record.setdefault("opened_at", now_iso())
        terminal = str(incident.get("terminal_outcome") or operation.get("terminal_state") or "UNKNOWN")
        terminal_state = str(operation.get("terminal_state") or "")
        terminal_reason = str(operation.get("terminal_reason") or "")
        applied = bool_value(apply_result.get("applied"))
        closed = terminal in {"SUCCESS", "ROLLBACK_SUCCESS", "ROLLBACK_FAILURE", "APPLY_FAILURE", "VERIFY_FAILED"} or terminal_state in {"APPLIED", "ROLLED_BACK", "ROLLBACK_FAILED", "FAILED", "VERIFY_FAILED"}
        suspended = terminal == "STOP_SAFE" or terminal_state == "DENIED"
        successful_moves = {
            str(row.get("user_ip") or "")
            for row in (apply_result.get("results") or [])
            if isinstance(row, dict)
            and str(row.get("terminal_outcome_classification") or "") == "SUCCESS"
            and str(row.get("from") or "") in set(str(item) for item in (record.get("failed_sources") or []) if str(item))
        }
        continuation_scopes = [
            self._l3_failed_source_scope(
                str(source),
                excluding_users=successful_moves,
                required_services=list(record.get("failed_required_services") or []),
            )
            for source in (record.get("failed_sources") or [])
            if str(source)
        ]
        active_continuations = [
            scope for scope in continuation_scopes
            if bool_value(scope.get("source_failed")) and to_int(scope.get("affected_users_count"), 0) > 0
        ]
        success_terminal = terminal == "SUCCESS" or terminal_state == "APPLIED"
        keep_open_for_remaining_users = closed and success_terminal and bool(active_continuations)
        record["incident_source_continuity"] = {
            "schema_version": "v7.l3-incident-source-continuity.v1",
            "active": bool(active_continuations),
            "kept_open": keep_open_for_remaining_users,
            "reason": "remaining_enabled_users_on_failed_incident_source" if keep_open_for_remaining_users else "terminal_closure_allowed",
            "successful_users_excluded": sorted(successful_moves),
            "scopes": continuation_scopes,
            "owner": "tools/v7-users-autoswitch._l3_close_incident_and_update_capability",
        }
        if keep_open_for_remaining_users:
            closed = False
            suspended = False
        record["status"] = "CLOSED" if closed else ("SUSPENDED" if suspended else "OPEN")
        if closed:
            record["closed_at"] = now_iso()
        elif keep_open_for_remaining_users:
            record["closed_at"] = ""
        record["terminal_outcome"] = terminal
        record["terminal_state"] = terminal_state
        record["terminal_reason"] = terminal_reason
        attempts = [row for row in (record.get("attempts") or []) if isinstance(row, dict)]
        if operation_id and not any(str(row.get("operation_id") or "") == operation_id for row in attempts):
            attempts.append({
                "operation_id": operation_id,
                "selected_move_hash": str(operation.get("selected_move_hash") or incident.get("selected_move_hash") or ""),
                "semantic_attempt_signature": str(runtime_record.get("semantic_attempt_signature") or ""),
                "terminal_outcome": terminal,
                "terminal_state": terminal_state,
                "applied": applied,
                "recorded_at": now_iso(),
                "already_materialized": already_materialized,
            })
        record["attempts"] = attempts[-50:]
        record["attempt_count"] = len(record["attempts"])
        record["consumed"] = True
        record["feeds_next_runtime_cycle"] = True
        incidents[incident_key] = record

        processed = set(str(item) for item in (state.get("processed_event_ids") or []))
        processed.update(str(item) for item in (((safety.get("l3_wake") or {}).get("consumed_event_ids") or [])) if str(item))
        state["processed_event_ids"] = sorted(processed)[-500:]

        rows = [row for row in read_jsonl(self.state_dir / "execution-events.jsonl") if "execution-" in str(row.get("schema_version") or "")]
        outcome_rows = [row for row in rows if "execution-outcome" in str(row.get("schema_version") or "")]
        success_count = sum(1 for row in outcome_rows if str(row.get("outcome_status") or "") == "success")
        rollback_count = sum(1 for row in outcome_rows if str(row.get("outcome_status") or "") == "rollback_required")
        failure_count = sum(1 for row in outcome_rows if str(row.get("outcome_status") or "") in {"failure", "no_execution"})
        closure_count = len([row for row in read_jsonl(self.state_dir / "closure-records.jsonl") if "execution-feedback-closure" in str(row.get("schema_version") or "")])
        capability_state = "IMPLEMENTED"
        if outcome_rows:
            capability_state = "VALIDATED"
        if success_count or rollback_count:
            capability_state = "PRODUCTION_PROVEN"
        if success_count and closure_count:
            capability_state = "CERTIFIED"
        if capability_state == "CERTIFIED" and bool_value(self.emergency_failover_policy.get("enabled")):
            capability_state = "ACTIVE_CAPABILITY"
        capability = {
            "schema_version": "v7.l3-capability-state.v1",
            "capability": "L3_EMERGENCY_AUTONOMOUS_FAILOVER",
            "state": capability_state,
            "implemented": True,
            "validated": bool(outcome_rows),
            "production_proven": bool(success_count or rollback_count),
            "certified": bool(success_count and closure_count),
            "active_capability": capability_state == "ACTIVE_CAPABILITY",
            "success_outcomes": success_count,
            "rollback_outcomes": rollback_count,
            "failure_or_no_execution_outcomes": failure_count,
            "closure_records": closure_count,
            "last_operation_id": operation_id,
            "last_incident_key": incident_key,
            "runtime_ready_for_next_incident": True,
            "omp_consumable": True,
            "updated": now_iso(),
        }
        state["capability"] = capability
        self._write_l3_runtime_state(state)
        write_json_atomic(self.l3_capability_state_file, capability)
        return capability

    def _terminal_verdict(self, plan: dict[str, Any]) -> dict[str, str]:
        apply_result = plan.get("apply_result") or {}
        if not apply_result.get("applied"):
            reason = str(apply_result.get("reason") or "not_applied")
            if reason == "dry_run":
                state = "DRY_RUN"
                reason = self._dry_run_terminal_reason(plan)
            elif reason == "no_selected_moves":
                state = "NOOP"
            else:
                state = "DENIED"
            return {"terminal_state": state, "terminal_reason": reason}
        results = apply_result.get("results") or []
        if any(row.get("rollback_rc") is not None for row in results):
            if all(row.get("rollback_rc") in (None, 0) for row in results):
                return {"terminal_state": "ROLLED_BACK", "terminal_reason": "verification_failed_rollback_completed"}
            return {"terminal_state": "ROLLBACK_FAILED", "terminal_reason": "verification_failed_rollback_failed"}
        if any(row.get("verify_rc") not in (None, 0) for row in results):
            return {"terminal_state": "VERIFY_FAILED", "terminal_reason": "route_verify_failed"}
        if any(row.get("rc") != 0 for row in results):
            if any(row.get("rc") == 0 for row in results):
                return {"terminal_state": "PARTIAL_SUCCESS", "terminal_reason": "partial_apply_failure"}
            return {"terminal_state": "FAILED", "terminal_reason": "switch_command_failed"}
        return {"terminal_state": "APPLIED", "terminal_reason": "selected_moves_applied"}

    def _dry_run_terminal_reason(self, plan: dict[str, Any]) -> str:
        if plan.get("selected_moves"):
            return "dry_run_selected_moves_available"
        snapshot_gate = (plan.get("safety") or {}).get("intelligence_snapshots") or {}
        if bool_value(snapshot_gate.get("active")) and bool_value(snapshot_gate.get("stop_required")):
            return "dry_run_intelligence_snapshot_stop_required"
        barrier = (plan.get("safety") or {}).get("restore_barrier") or {}
        if bool_value(barrier.get("active")):
            return "dry_run_restore_barrier_active"
        if bool_value(barrier.get("post_ttl_blocking")):
            return "dry_run_restore_barrier_post_ttl_blocking"
        for key in ("clearance_guard_reason", "clearance_generation_reason"):
            value = str(barrier.get(key) or "")
            if value:
                return f"dry_run_{value}"
        barrier_reason = str(barrier.get("reason") or "")
        if barrier_reason:
            return f"dry_run_restore_barrier_{barrier_reason}"
        for decision in plan.get("decisions") or []:
            for reason in decision.get("reason") or []:
                if str(reason).startswith(("restore_", "no_eligible_", "current_egress_")):
                    return f"dry_run_{reason}"
        return "dry_run_no_selected_moves"

    def _rollback_verdict(self, plan: dict[str, Any]) -> dict[str, Any]:
        rows = [
            row for row in ((plan.get("apply_result") or {}).get("results") or [])
            if row.get("rollback_attempted") or row.get("rollback_rc") is not None
        ]
        if not rows:
            return {}
        failed = [row for row in rows if row.get("rollback_rc") not in (0, None)]
        return {
            "rollback_attempted": True,
            "rollback_result": "FAIL" if failed else "OK",
            "rollback_verdict": "ROLLBACK_FAILED" if failed else "ROLLBACK_COMPLETED",
            "rollback_rows": len(rows),
        }

    def _restore_barrier_status_label(self, plan: dict[str, Any]) -> str:
        barrier = (plan.get("safety") or {}).get("restore_barrier") or {}
        if bool_value(barrier.get("active")):
            return "active"
        if bool_value(barrier.get("post_ttl_blocking")):
            return "post_ttl_blocking"
        if barrier.get("clearance_guard_reason"):
            return str(barrier.get("clearance_guard_reason"))
        if bool_value(barrier.get("expired")) and bool_value(barrier.get("cleared")):
            return "expired_cleared"
        return "settled"

