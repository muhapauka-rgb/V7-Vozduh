def parse_kv_line(line: str) -> dict[str, str]:
    row: dict[str, str] = {}
    for part in line.split():
        if "=" not in part:
            continue
        key, value = part.split("=", 1)
        row[key.strip()] = value.strip()
    return row


def parse_registry(path: Path) -> list[dict[str, str]]:
    rows: list[dict[str, str]] = []
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except FileNotFoundError:
        return rows
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        row = parse_kv_line(line)
        if row:
            rows.append(row)
    return rows


def to_float(value: Any, default: float = 0.0) -> float:
    try:
        if value is None or value == "":
            return default
        return float(value)
    except (TypeError, ValueError):
        return default


def to_int(value: Any, default: int = 0) -> int:
    try:
        if value is None or value == "":
            return default
        return int(float(value))
    except (TypeError, ValueError):
        return default


def bool_value(value: Any) -> bool:
    return str(value).strip().lower() in ("1", "true", "yes", "on", "enabled")


def split_csv(value: Any) -> list[str]:
    if isinstance(value, list):
        return [str(v).strip() for v in value if str(v).strip()]
    return [part.strip() for part in str(value or "").split(",") if part.strip()]


def normalize_service_ids(values: Any) -> list[str]:
    result: list[str] = []
    for item in split_csv(values):
        value = str(item or "").strip().lower()
        if value and value not in result:
            result.append(value)
    return result


def user_priority_services_from_pref(row: Any) -> list[str]:
    if isinstance(row, dict) and "services" in row:
        services = normalize_service_ids(row.get("services") or [])
        if int(row.get("schema_version") or 0) < 2 and services == ["telegram"]:
            return list(DEFAULT_USER_PRIORITY_SERVICES)
        return services
    return list(DEFAULT_USER_PRIORITY_SERVICES)


def telegram_status_is_hard(status: str) -> bool:
    value = str(status or "").upper()
    return value in TELEGRAM_HARD_STATUSES or value.startswith("TELEGRAM_DOWN_")


def merge_defaults(data: dict[str, Any], defaults: dict[str, Any]) -> dict[str, Any]:
    result = dict(defaults)
    for key, value in (data or {}).items():
        if isinstance(value, dict) and isinstance(result.get(key), dict):
            result[key] = merge_defaults(value, result[key])
        else:
            result[key] = value
    return result


def glob_contains(patterns: list[str], value: str) -> bool:
    return any(fnmatch.fnmatchcase(value, pattern) for pattern in patterns)


def parse_ts(value: Any) -> float:
    try:
        return datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp()
    except Exception:
        return 0.0


def runtime_authority_contract_status(
    policy: dict[str, Any],
    *,
    prepared_class: str,
    certified_class: str,
) -> dict[str, Any]:
    """Bind a broad runtime budget to a fresh, explicitly scoped policy contract.

    Historical promotion evidence is useful for analysis, but is not an
    executable grant forever.  The existing policy owner must keep an active
    action-class contract alongside any authority above CANARY; absence or
    expiry is deliberately a zero-budget terminal before a plan can reach the
    restore-barrier or apply path.
    """
    broad_authority = max(
        AUTHORITY_CLASS_RANK[prepared_class],
        AUTHORITY_CLASS_RANK[certified_class],
    ) > AUTHORITY_CLASS_RANK["CANARY"]
    contract = policy.get("current_action_class_contract")
    contract = dict(contract) if isinstance(contract, dict) else {}
    required = broad_authority
    now = datetime.now(timezone.utc).timestamp()
    expires_at = str(contract.get("expires_at") or "")
    max_users = max(0, to_int(contract.get("max_users"), 0))
    scope = contract.get("scope") if isinstance(contract.get("scope"), dict) else {}
    required_gates = contract.get("required_gates") if isinstance(contract.get("required_gates"), dict) else {}
    stop_conditions = contract.get("stop_conditions") if isinstance(contract.get("stop_conditions"), list) else []
    allowed_class = normalize_authority_class(
        contract.get("max_authority_class") or contract.get("authority_class") or "CANARY"
    )
    action_class = str(contract.get("action_class") or "").strip().upper()
    schema_ok = str(contract.get("schema_version") or "") == "v7.current-action-class-contract.v1"
    scope_ok = bool(str(contract.get("contract_id") or "")) and bool(str(contract.get("active_program") or ""))
    action_ok = action_class in {"GOVERNED_ONLY", "EMERGENCY_FAILOVER"}
    expiry_ok = parse_ts(expires_at) > now
    class_ok = AUTHORITY_CLASS_RANK[allowed_class] >= AUTHORITY_CLASS_RANK[certified_class]
    budget_ok = max_users > 0
    action_scope_ok = bool(str(scope.get("source_egress") or "")) and bool(str(scope.get("target_egress") or ""))
    gate_contract_ok = (
        bool_value(required_gates.get("fresh_evidence_required"))
        and bool_value(required_gates.get("verification_required"))
        and bool_value(required_gates.get("rollback_required"))
        and bool_value(required_gates.get("anti_flap_required"))
        and "cooldown_seconds" in required_gates
        and to_int(required_gates.get("cooldown_seconds"), -1) >= 0
    )
    stop_conditions_ok = bool([item for item in stop_conditions if str(item).strip()])
    valid = (not required) or (
        schema_ok and scope_ok and action_ok and expiry_ok and class_ok and budget_ok
        and action_scope_ok and gate_contract_ok and stop_conditions_ok
    )
    blockers: list[str] = []
    if required and not schema_ok:
        blockers.append("current_action_class_contract_missing_or_schema_invalid")
    if required and schema_ok and not scope_ok:
        blockers.append("current_action_class_contract_scope_missing")
    if required and schema_ok and not action_ok:
        blockers.append("current_action_class_contract_action_class_invalid")
    if required and schema_ok and not expiry_ok:
        blockers.append("current_action_class_contract_expired_or_missing")
    if required and schema_ok and not class_ok:
        blockers.append("current_action_class_contract_below_certified_authority")
    if required and schema_ok and not budget_ok:
        blockers.append("current_action_class_contract_zero_budget")
    if required and schema_ok and not action_scope_ok:
        blockers.append("current_action_class_contract_source_target_scope_missing")
    if required and schema_ok and not gate_contract_ok:
        blockers.append("current_action_class_contract_required_gates_missing")
    if required and schema_ok and not stop_conditions_ok:
        blockers.append("current_action_class_contract_stop_conditions_missing")
    return {
        "schema_version": "v7.current-action-class-contract-gate.v1",
        "required": required,
        "valid": valid,
        "contract_id": str(contract.get("contract_id") or ""),
        "active_program": str(contract.get("active_program") or ""),
        "action_class": action_class,
        "max_authority_class": allowed_class,
        "max_users": max_users,
        "expires_at": expires_at,
        "scope": {
            "source_egress": str(scope.get("source_egress") or ""),
            "target_egress": str(scope.get("target_egress") or ""),
        },
        "required_gates": {
            "fresh_evidence_required": bool_value(required_gates.get("fresh_evidence_required")),
            "verification_required": bool_value(required_gates.get("verification_required")),
            "rollback_required": bool_value(required_gates.get("rollback_required")),
            "anti_flap_required": bool_value(required_gates.get("anti_flap_required")),
            "cooldown_seconds": to_int(required_gates.get("cooldown_seconds"), -1),
        },
        "stop_conditions": [str(item) for item in stop_conditions if str(item).strip()],
        "blockers": blockers,
        "truth_source": "existing_policy_current_action_class_contract",
        "new_truth_sources_created": False,
    }


def write_json_atomic(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def read_jsonl(path: Path) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except FileNotFoundError:
        return rows
    except OSError:
        return rows
    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(row, dict):
            rows.append(row)
    return rows


def append_jsonl(path: Path, rows: list[dict[str, Any]]) -> None:
    if not rows:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fh:
        for row in rows:
            fh.write(json.dumps(row, ensure_ascii=False, sort_keys=False) + "\n")


def acquire_service_matrix_lock(state_dir: Path, timeout_sec: int, *, enabled: bool) -> tuple[Optional[int], dict[str, Any]]:
    status: dict[str, Any] = {
        "schema": "v7.service-matrix-lifecycle-lock.v1",
        "enabled": bool(enabled),
        "acquired": False,
        "path": str(state_dir / "service-matrix.lock"),
        "scope": "planner_snapshot_packet_lifecycle",
        "owner": "tools/v7-users-autoswitch",
        "runtime_behavior_changed": False,
        "governance_behavior_changed": False,
        "execution_behavior_changed": False,
        "users_moved": False,
    }
    if not enabled:
        status["decision"] = "lock_not_required"
        return None, status
    lock_path = state_dir / "service-matrix.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600)
    started = time.time()
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            _SERVICE_MATRIX_LOCKS_HELD_BY_PROCESS.add(str(lock_path))
            status.update({
                "acquired": True,
                "decision": "service_matrix_writer_serialized_for_planner_lifecycle",
                "waited_sec": round(time.time() - started, 3),
                "timeout_sec": max(1, timeout_sec),
            })
            return fd, status
        except BlockingIOError:
            if str(lock_path) in _SERVICE_MATRIX_LOCKS_HELD_BY_PROCESS:
                os.close(fd)
                status.update({
                    "acquired": True,
                    "reentrant_same_process": True,
                    "decision": "service_matrix_writer_serialized_for_planner_lifecycle",
                    "waited_sec": round(time.time() - started, 3),
                    "timeout_sec": max(1, timeout_sec),
                })
                return None, status
            if time.time() - started >= max(1, timeout_sec):
                os.close(fd)
                status.update({
                    "acquired": False,
                    "decision": "service_matrix_lock_timeout",
                    "waited_sec": round(time.time() - started, 3),
                    "timeout_sec": max(1, timeout_sec),
                    "blocked_actions": ["selected_moves", "apply", "operator_visible_promotion"],
                })
                return None, status
            time.sleep(0.25)


