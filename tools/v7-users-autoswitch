    def _retry_pre_planner_refresh_after_source_reload(self) -> None:
        refresh = self.pre_planner_refresh if isinstance(self.pre_planner_refresh, dict) else {}
        source_reload = refresh.get("source_reload") if isinstance(refresh.get("source_reload"), dict) else {}
        changed_keys = list(source_reload.get("changed_keys") or [])
        if refresh.get("mode") != "write" or refresh.get("state") != "REFRESH_SUCCESS" or not changed_keys:
            return

        retry = self._run_pre_planner_refresh()
        retry["trigger"] = "post_source_reload_refresh_gate"
        retry["source_reload_parent_changed_keys"] = changed_keys
        retry["source_reload_retry_reason"] = "source_changed_after_initial_snapshot_refresh"
        refresh["post_source_reload_refresh"] = retry

        if retry.get("state") != "REFRESH_SUCCESS" or retry.get("stop_required"):
            refresh.update({
                "state": "POST_SOURCE_RELOAD_REFRESH_FAILED",
                "decision": "freshness_unknown_after_source_reload",
                "stop_required": True,
                "blocked_actions": ["selected_moves", "apply", "operator_visible_promotion"],
